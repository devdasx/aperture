        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산 세부 정보의 모든 필터와 정렬 선택이 지워져요. 계속할까요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai išvalo kiekvieną turto informacijos filtro ir rūšiavimo pasirinkimą. Tęsti?"
