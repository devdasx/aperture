        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) க்கான எந்த உள்ளீடும் சரிபார்க்கப்படவில்லை. பின்னால் தட்டி ஒவ்வொரு முகவரி அல்லது விசையையும் சரிபார்க்கவும்."
          }
