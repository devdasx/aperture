        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovovacia fráza je dvanásť alebo dvadsaťštyri bežných anglických slov. Spolu tvoria semienko, z ktorého bola vaša peňaženka vygenerovaná."
          }
