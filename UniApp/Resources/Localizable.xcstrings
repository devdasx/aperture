    "Couldn't save your wallet. Tap Retry.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ محفظتك. اضغط على «إعادة المحاولة»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ওয়ালেট সংরক্ষণ করা যায়নি। আবার চেষ্টায় ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut desar la teva cartera. Toca Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši peněženku se nepodařilo uložit. Klepněte na „Zkusit znovu“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din wallet kunne ikke gemmes. Tryk på Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet konnte nicht gespeichert werden. Tippe auf „Erneut versuchen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποθήκευση του πορτοφολιού σας. Πατήστε «Δοκιμή ξανά»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save your wallet. Tap Retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar tu cartera. Toca Reintentar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمی‌توان کیف پول شما را ذخیره کرد. روی تلاش مجدد ضربه بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lompakkoasi ei voitu tallentaa. Napauta Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer votre portefeuille. Touchez Réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשמור את הארנק שלך. יש להקיש על «ניסיון נוסף»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वॉलेट सहेजा नहीं जा सका। फिर से कोशिश पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš novčanik nije bilo moguće spremiti. Dodirnite Pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tárcád nem sikerült elmenteni. Koppints az „Újra” gombra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan dompet Anda. Ketuk Coba Lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il suo wallet. Tocchi Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットを保存できませんでした。「再試行」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑을 저장하지 못했어요. 다시 시도를 탭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre lommeboken. Trykk på Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon je wallet niet opslaan. Tik op Opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać portfela. Dotknij Ponów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar sua carteira. Toque em Tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut salva portofelul. Atinge „Reîncearcă”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить кошелёк. Коснитесь «Повторить»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vašu peňaženku sa nepodarilo uložiť. Klepnite na Skúsiť znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše denarnice ni bilo mogoče shraniti. Tapnite Poskusi znova."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш новчаник није било могуће сачувати. Тапните Покушај поново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att spara plånboken. Tryck på Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกกระเป๋าเงินของคุณไม่ได้ แตะลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdanınız kaydedilemedi. Yeniden Dene’ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти ваш гаманець. Торкніться «Повторити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được ví của bạn. Hãy chạm Thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存你的钱包。请点按「重试」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存你的錢包。請點一下「重試」。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا والیٹ محفوظ نہیں ہو سکا۔ دوبارہ کوشش پر تھپتھپائیں۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашият портфейл не можа да бъде запазен. Докоснете Повторен опит."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu rahakotti ei õnnestunud salvestada. Puuduta Proovi uuesti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko išsaugoti jūsų piniginės. Bakstelėkite Bandyti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās saglabāt jūsu maku. Pieskarieties Mēģināt vēlreiz."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gat ekki vistað veskið þitt. Pikkaðu á Reyna aftur."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan dompet anda. Ketik Cuba Semula."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-save ang iyong wallet. I-tap ang Subukan Ulit."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuwezekana kuhifadhi pochi yako. Gusa Jaribu Tena."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon nie jou beursie stoor nie. Tik Probeer Weer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வாலெட்டைச் சேமிக்க முடியவில்லை. மீண்டும் முயற்சி என்பதைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వాలెట్‌ను సేవ్ చేయలేకపోయింది. మళ్లీ ప్రయత్నించు నొక్కండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാലറ്റ് സംരക്ഷിക്കാനായില്ല. വീണ്ടും ശ്രമിക്കാൻ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे वॉलेट जतन करता आले नाही. पुन्हा प्रयत्न टॅप करा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਵਾਲਿਟ ਸੰਭਾਲਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ। ਮੁੜ ਕੋਸ਼ਿਸ਼ ਟੈਪ ਕਰੋ।"
          }
        }
      }
    },
