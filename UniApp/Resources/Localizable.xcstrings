    "Type a URL to navigate, or any search term to search the web.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik 'n URL om te navigeer, of enige soekterm om die web te deursoek."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب عنوان URL للانتقال، أو أي مصطلح للبحث في الويب."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете URL за навигация или дума за търсене в мрежата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেভিগেট করতে একটি URL টাইপ করুন, অথবা ওয়েবে খুঁজতে যেকোনো অনুসন্ধান শব্দ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu un URL per navegar, o qualsevol terme per cercar a la web."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte URL pro otevření nebo libovolný výraz pro hledání na webu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en URL for at gå til den, eller et søgeord for at søge på nettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine URL ein, um sie zu öffnen, oder einen Suchbegriff, um das Web zu durchsuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε ένα URL για πλοήγηση ή έναν όρο αναζήτησης για αναζήτηση στον ιστό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a URL to navigate, or any search term to search the web."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una URL para navegar o un término para buscar en la web."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta URL navigeerimiseks või mis tahes otsingusõna veebi otsimiseks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک URL برای رفتن، یا هر عبارت جستجویی برای جستجو در وب تایپ کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita URL siirtyäksesi sivulle tai hakusana etsiäksesi verkosta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-type ng URL para mag-navigate, o anumang search term para maghanap sa web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une URL pour naviguer, ou un terme pour effectuer une recherche sur le web."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להקליד כתובת URL לניווט, או מונח כלשהו לחיפוש ברשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेविगेट करने के लिए URL टाइप करें, या वेब पर खोजने के लिए कोई भी सर्च टर्म।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upišite URL za navigaciju ili pojam za pretragu weba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj be egy URL-t a megnyitáshoz, vagy bármilyen kifejezést a webes kereséshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik URL untuk membuka, atau istilah pencarian apa pun untuk mencari di web."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sláðu inn vefslóð til að fara þangað, eða hvaða leitarorð sem er til að leita á vefnum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digiti un URL per navigare, oppure un termine qualsiasi per cercare sul web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL を入力して開くか、検索語を入力して Web を検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동하려면 URL을, 웹을 검색하려면 검색어를 입력하세요."
          }
        },
        "lt": {
          "stringUnit": {
