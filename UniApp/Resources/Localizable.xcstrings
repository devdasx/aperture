        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Importujte iba peňaženku, ktorá je vaša."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvozite samo denarnico, ki je vaša."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Увозите само новчаник који је ваш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera bara en plånbok som tillhör dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingiza tu pochi ambayo ni yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுடைய வாலட்டை மட்டுமே இறக்குமதி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీది అయిన వాలెట్‌ను మాత్రమే దిగుమతి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าเฉพาะกระเป๋าที่เป็นของคุณเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca size ait olan bir cüzdanı içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортуйте лише той гаманець, який належить вам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف وہی والیٹ درآمد کریں جو آپ کا اپنا ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhập một ví là của chính bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只导入属于你自己的钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只匯入屬於你自己的錢包。"
          }
        }
      }
    },
    "Only send %@ on the %@ network to this address. Sending any other token, or using a different network, may result in permanent loss.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل %@ فقط عبر شبكة %@ إلى هذا العنوان. قد يؤدي إرسال أي رمز آخر أو استخدام شبكة مختلفة إلى فقدان دائم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঠিকানায় শুধুমাত্র %@ নেটওয়ার্কে %@ পাঠান। অন্য কোনও টোকেন পাঠানো বা ভিন্ন নেটওয়ার্ক ব্যবহার করলে স্থায়ী ক্ষতি হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envieu només %@ a la xarxa %@ a aquesta adreça. Enviar qualsevol altre token, o utilitzar una xarxa diferent, pot provocar una pèrdua permanent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tuto adresu posílejte pouze %@ v síti %@. Odeslání jakéhokoli jiného tokenu nebo použití jiné sítě může vést k trvalé ztrátě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send kun %@ på %@-netværket til denne adresse. Hvis du sender en anden token eller bruger et andet netværk, kan det medføre permanent tab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie ausschließlich %@ im %@-Netzwerk an diese Adresse. Das Senden anderer Token oder die Verwendung eines anderen Netzwerks kann zu einem dauerhaften Verlust führen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε σε αυτή τη διεύθυνση μόνο %@ στο δίκτυο %@. Η αποστολή οποιουδήποτε άλλου token ή η χρήση διαφορετικού δικτύου μπορεί να οδηγήσει σε μόνιμη απώλεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only send %@ on the %@ network to this address. Sending any other token, or using a different network, may result in permanent loss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíe únicamente %@ en la red %@ a esta dirección. Enviar cualquier otro token o usar una red diferente puede provocar la pérdida permanente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä tähän osoitteeseen vain %@ %@-verkossa. Muiden tokenien lähettäminen tai eri verkon käyttäminen voi johtaa pysyvään menetykseen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלח לכתובת זו רק %@ ברשת %@. שליחת טוקן אחר או שימוש ברשת שונה עלולה לגרום לאובדן בלתי הפיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पते पर केवल %@ नेटवर्क पर %@ भेजें। कोई अन्य टोकन भेजने या भिन्न नेटवर्क का उपयोग करने से स्थायी हानि हो सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovu adresu šaljite samo %@ na mreži %@. Slanje bilo kojeg drugog tokena ili korištenje druge mreže može dovesti do trajnog gubitka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erre a címre kizárólag %@ tokent küldjön a %@ hálózaton. Bármilyen más token küldése vagy más hálózat használata végleges veszteséget okozhat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスには %@ ネットワーク上の %@ のみを送信してください。他のトークンを送信したり、別のネットワークを使用したりすると、永久的な損失につながる可能性があります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send kun %@ på %@-nettverket til denne adressen. Å sende et annet token eller bruke et annet nettverk kan føre til permanent tap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie apenas %@ na rede %@ para este endereço. Enviar qualquer outro token, ou usar uma rede diferente, pode resultar em perda permanente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiteți la această adresă doar %@ în rețeaua %@. Trimiterea oricărui alt token sau folosirea unei rețele diferite poate duce la pierdere permanentă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте на этот адрес только %@ в сети %@. Отправка любого другого токена или использование другой сети может привести к безвозвратной потере."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na túto adresu posielajte iba %@ v sieti %@. Odoslanie iného tokenu alebo použitie inej siete môže viesť k trvalej strate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ta naslov pošljite samo %@ v omrežju %@. Pošiljanje katerega koli drugega žetona ali uporaba drugega omrežja lahko privede do trajne izgube."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "На ову адресу шаљите само %@ на мрежи %@. Слање било ког другог токена или коришћење друге мреже може довести до трајног губитка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka endast %@ på %@-nätverket till denna adress. Att skicka någon annan token, eller använda ett annat nätverk, kan leda till permanent förlust."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилайте на цю адресу лише %@ у мережі %@. Надсилання будь-якого іншого токена або використання іншої мережі може призвести до безповоротної втрати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅将 %@ 通过 %@ 网络发送到此地址。发送任何其他代币或使用不同的网络可能导致永久损失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅將 %@ 透過 %@ 網路傳送至此地址。傳送其他代幣或使用其他網路可能導致永久損失。"
          }
        }
      }
    },
