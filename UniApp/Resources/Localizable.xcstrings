          "stringUnit": {
            "state": "translated",
            "value": "ఏ UTXOలను ఖర్చు చేయాలో ఎంచుకోండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏതൊക്കെ UTXO ചെലവഴിക്കണമെന്ന് തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणते UTXO खर्च करायचे ते निवडा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੋ ਕਿ ਕਿਹੜੇ UTXO ਖ਼ਰਚ ਕਰਨੇ ਹਨ।"
          }
        }
      }
    },
