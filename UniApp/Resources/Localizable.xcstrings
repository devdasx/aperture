        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Aperture کا کوئی سرور نہیں ہے جو آپ کے بٹوے، بیلنس، لین دین یا پتوں کو محفوظ کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture không có máy chủ nào lưu trữ ví, số dư, giao dịch hoặc địa chỉ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 没有任何服务器存储你的钱包、余额、交易或地址。"
