    "Paste the key for your \\(chain.displayName) account. Aperture checks the format before deriving any address, and the key never leaves this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak die sleutel vir jou \\(chain.displayName)-rekening. Aperture kontroleer die formaat voordat enige adres afgelei word, en die sleutel verlaat nooit hierdie iPhone nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق مفتاح حساب \\(chain.displayName) الخاص بك. تتحقق Aperture من التنسيق قبل اشتقاق أي عنوان، ولن يغادر المفتاح هذا الـ iPhone أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете ключа за акаунта си в \\(chain.displayName). Aperture проверява формата преди да извлече адрес, а ключът никога не напуска този iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার \\(chain.displayName) অ্যাকাউন্টের কী পেস্ট করুন। Aperture কোনো ঠিকানা তৈরি করার আগে ফরম্যাট পরীক্ষা করে, এবং কী কখনও এই iPhone থেকে বের হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enganxa la clau del teu compte de \\(chain.displayName). Aperture comprova el format abans de derivar qualsevol adreça, i la clau no surt mai d’aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte klíč pro váš účet \\(chain.displayName). Aperture před odvozením jakékoli adresy zkontroluje formát a klíč nikdy neopustí tento iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt nøglen til din \\(chain.displayName)-konto. Aperture tjekker formatet, inden en adresse udledes, og nøglen forlader aldrig denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den Schlüssel für dein \\(chain.displayName)-Konto ein. Aperture prüft das Format, bevor eine Adresse abgeleitet wird, und der Schlüssel verlässt dieses iPhone nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικόλλησε το κλειδί του λογαριασμού σου στο \\(chain.displayName). Η Aperture ελέγχει τη μορφή πριν δημιουργήσει οποιαδήποτε διεύθυνση, και το κλειδί δεν φεύγει ποτέ από αυτό το iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the key for your \\(chain.displayName) account. Aperture checks the format before deriving any address, and the key never leaves this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega la clave de tu cuenta de \\(chain.displayName). Aperture comprueba el formato antes de derivar cualquier dirección, y la clave nunca sale de este iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleebi oma \\(chain.displayName) konto võti. Aperture kontrollib enne aadressi tuletamist vormingut ja võti ei lahku kunagi sellest iPhone'ist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید حساب \\(chain.displayName) خود را جای‌گذاری کنید. Aperture قبل از استخراج هر نشانی، قالب را بررسی می‌کند و کلید هرگز این iPhone را ترک نمی‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä \\(chain.displayName)-tilisi avain. Aperture tarkistaa muodon ennen osoitteen johtamista, eikä avain koskaan poistu tästä iPhonesta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-paste ang key para sa iyong \\(chain.displayName) account. Tinitingnan ng Aperture ang format bago kumuha ng anumang address, at hindi umaalis sa iPhone na ito ang key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez la clé de votre compte \\(chain.displayName). Aperture vérifie le format avant de dériver une adresse, et la clé ne quitte jamais cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק את המפתח של חשבון \\(chain.displayName) שלך. Aperture בודקת את הפורמט לפני יצירת כתובת כלשהי, והמפתח אף פעם לא יוצא מה-iPhone הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने \\(chain.displayName) खाते की कुंजी चिपकाएँ। Aperture कोई पता बनाने से पहले प्रारूप की जाँच करता है, और कुंजी कभी इस iPhone से बाहर नहीं जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepi ključ za svoj \\(chain.displayName) račun. Aperture provjerava format prije izvođenja bilo koje adrese, a ključ nikada ne napušta ovaj iPhone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illeszd be a \\(chain.displayName)-fiókod kulcsát. Az Aperture cím származtatása előtt ellenőrzi a formátumot, és a kulcs sosem hagyja el ezt az iPhone-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempelkan kunci untuk akun \\(chain.displayName) Anda. Aperture memeriksa formatnya sebelum menurunkan alamat apa pun, dan kunci tidak pernah meninggalkan iPhone ini."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu inn lykilinn fyrir \\(chain.displayName)-reikninginn þinn. Aperture athugar sniðið áður en nokkurt vistfang er leitt af, og lykillinn yfirgefur aldrei þennan iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla la chiave del tuo account \\(chain.displayName). Aperture controlla il formato prima di derivare qualsiasi indirizzo e la chiave non lascia mai questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) アカウントの鍵を貼り付けてください。Aperture はアドレスを導出する前に形式を確認し、鍵がこの iPhone から出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) 계정의 키를 붙여 넣으세요. Aperture는 주소를 도출하기 전에 형식을 확인하며, 키는 이 iPhone을 떠나지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijuokite savo \\(chain.displayName) paskyros raktą. Aperture patikrina formatą prieš išvesdama bet kokį adresą, o raktas niekada nepalieka šio iPhone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielīmējiet sava \\(chain.displayName) konta atslēgu. Aperture pārbauda formātu pirms jebkuras adreses atvasināšanas, un atslēga nekad neatstāj šo iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ \\(chain.displayName) അക്കൗണ്ടിന്റെ കീ ഒട്ടിക്കുക. ഏതെങ്കിലും വിലാസം ഉരുത്തിരിക്കുന്നതിന് മുമ്പ് Aperture ഫോർമാറ്റ് പരിശോധിക്കുന്നു, കീ ഒരിക്കലും ഈ iPhone വിട്ടുപോകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या \\(chain.displayName) खात्याची की पेस्ट करा. कोणताही पत्ता तयार करण्यापूर्वी Aperture फॉरमॅट तपासतो, आणि की कधीही या iPhone वरून बाहेर जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal kunci untuk akaun \\(chain.displayName) anda. Aperture menyemak formatnya sebelum menerbitkan sebarang alamat, dan kunci tidak pernah meninggalkan iPhone ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn nøkkelen for \\(chain.displayName)-kontoen din. Aperture sjekker formatet før noen adresse utledes, og nøkkelen forlater aldri denne iPhone-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak de sleutel voor je \\(chain.displayName)-account. Aperture controleert het formaat voordat een adres wordt afgeleid, en de sleutel verlaat deze iPhone nooit."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ \\(chain.displayName) ਖਾਤੇ ਦੀ ਕੁੰਜੀ ਪੇਸਟ ਕਰੋ। ਕੋਈ ਵੀ ਪਤਾ ਕੱਢਣ ਤੋਂ ਪਹਿਲਾਂ Aperture ਫਾਰਮੈਟ ਦੀ ਜਾਂਚ ਕਰਦਾ ਹੈ, ਅਤੇ ਕੁੰਜੀ ਕਦੇ ਵੀ ਇਸ iPhone ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦੀ।"
