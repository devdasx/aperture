        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi số lượng từ sẽ tạo ra một cụm từ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改单词数量将生成新的短语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改字數會產生新的短語。"
          }
        }
      }
    },
    "Check the original phrase you wrote down — this word may be from a different wordlist.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyk na die oorspronklike frase wat jy neergeskryf het — hierdie woord kan uit 'n ander woordelys kom."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع العبارة الأصلية التي دوّنتها — قد تكون هذه الكلمة من قائمة كلمات مختلفة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери оригиналната фраза, която си записал — тази дума може да е от друг списък с думи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে মূল বাক্যাংশটি লিখেছিলেন তা যাচাই করুন — এই শব্দটি ভিন্ন শব্দ-তালিকার হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
