    "Not in your address book — save as a contact after sending.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie in jou adresboek nie — stoor as 'n kontak ná stuur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس في دفتر عناوينك — احفظه كجهة اتصال بعد الإرسال."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е в адресната ви книга — запазете като контакт след изпращане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ঠিকানা বইয়ে নেই — পাঠানোর পরে একটি পরিচিতি হিসেবে সংরক্ষণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No és a la teva llibreta d'adreces: desa-la com a contacte després d'enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není ve vašem adresáři — po odeslání uložte jako kontakt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke i din adressebog — gem som en kontakt efter afsendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht in deinem Adressbuch – nach dem Senden als Kontakt speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει στο βιβλίο διευθύνσεών σας — αποθηκεύστε ως επαφή μετά την αποστολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not in your address book — save as a contact after sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está en tu libreta de direcciones: guárdalo como contacto después de enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole teie aadressiraamatus — salvestage pärast saatmist kontaktina."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در دفترچه‌ی نشانی‌های شما نیست — پس از ارسال به‌عنوان مخاطب ذخیره کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei osoitekirjassasi — tallenna yhteystiedoksi lähettämisen jälkeen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala sa iyong address book — i-save bilang contact pagkatapos magpadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absent de votre carnet d'adresses — enregistrez comme contact après l'envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא בספר הכתובות שלך — שמור כאיש קשר לאחר השליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पता पुस्तिका में नहीं — भेजने के बाद संपर्क के रूप में सहेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije u vašem adresaru — spremite kao kontakt nakon slanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs a címjegyzékedben — küldés után mentsd el névjegyként."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada di buku alamat Anda — simpan sebagai kontak setelah mengirim."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki í heimilisfangaskránni þinni — vistaðu sem tengilið eftir sendingu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è nella tua rubrica — salvalo come contatto dopo l'invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス帳にありません — 送金後に連絡先として保存してください。"
