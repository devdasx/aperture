    "Add crypto to get started — receive or transfer it from another wallet.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg kripto by om te begin — ontvang of dra dit oor vanaf 'n ander beursie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عملات مشفّرة للبدء — استلمها أو حوّلها من محفظة أخرى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете крипто, за да започнете — получете го или го прехвърлете от друг портфейл."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে ক্রিপ্টো যোগ করুন — অন্য ওয়ালেট থেকে গ্রহণ করুন বা স্থানান্তর করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix cripto per començar: rep-la o transfereix-la des d'una altra cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte přidáním kryptoměny — přijměte ji nebo převeďte z jiné peněženky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj krypto for at komme i gang — modtag eller overfør det fra en anden tegnebog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Krypto hinzu, um zu starten – empfange es oder übertrage es aus einem anderen Wallet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε κρυπτονομίσματα για να ξεκινήσετε — λάβετέ τα ή μεταφέρετέ τα από άλλο πορτοφόλι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add crypto to get started — receive or transfer it from another wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade cripto para empezar: recíbela o transfiérela desde otra cartera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alustamiseks lisage krüpto — võtke see vastu või kandke üle teisest rahakotist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع رمزارز اضافه کنید — آن را دریافت کنید یا از کیف پول دیگری منتقل کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita lisäämällä kryptoa — vastaanota tai siirrä se toisesta lompakosta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng crypto para magsimula — tumanggap o ilipat ito mula sa ibang wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des cryptos pour commencer — recevez-les ou transférez-les depuis un autre portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף קריפטו כדי להתחיל — קבל או העבר אותו מארנק אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए क्रिप्टो जोड़ें — इसे किसी अन्य वॉलेट से प्राप्त करें या ट्रांसफ़र करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte kriptovalutu za početak — primite je ili prenesite iz drugog novčanika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá kriptót az induláshoz — fogadd vagy utald át egy másik tárcából."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kripto untuk memulai — terima atau transfer dari dompet lain."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu við rafmynt til að byrja — taktu á móti henni eða fluttu hana úr öðru veski."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi cripto per iniziare — ricevile o trasferiscile da un altro wallet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号資産を追加して始めましょう。別のウォレットから受け取るか送金してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 암호화폐를 추가하세요 — 받거나 다른 지갑에서 이체하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite kriptovaliutos, kad pradėtumėte – gaukite ją arba perveskite iš kitos piniginės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet kriptovalūtu, lai sāktu — saņemiet vai pārvietojiet to no cita maka."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരംഭിക്കാൻ ക്രിപ്റ്റോ ചേർക്കുക — മറ്റൊരു വാലറ്റിൽ നിന്ന് സ്വീകരിക്കുകയോ കൈമാറുകയോ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरू करण्यासाठी क्रिप्टो जोडा — ते दुसऱ्या वॉलेटमधून प्राप्त करा किंवा हस्तांतरित करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah kripto untuk bermula — terima atau pindahkannya daripada dompet lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til krypto for å komme i gang — motta eller overfør det fra en annen lommebok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg crypto toe om te beginnen — ontvang het of zet het over vanuit een andere wallet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਕ੍ਰਿਪਟੋ ਸ਼ਾਮਲ ਕਰੋ — ਇਸਨੂੰ ਕਿਸੇ ਹੋਰ ਵਾਲਿਟ ਤੋਂ ਪ੍ਰਾਪਤ ਕਰੋ ਜਾਂ ਟ੍ਰਾਂਸਫਰ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj kryptowalutę, aby zacząć — odbierz ją lub przenieś z innego portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione cripto para começar — receba ou transfira de outra carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă cripto pentru a începe — primește sau transferă din alt portofel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте криптовалюту, чтобы начать, — получите или переведите её из другого кошелька."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte kryptomenu na začiatok — prijmite ju alebo preneste z inej peňaženky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte kriptovaluto za začetek — prejmite jo ali prenesite iz druge denarnice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte kriptovalute za početak — primite ih ili prenesite iz drugog novčanika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till krypto för att komma igång — ta emot eller överför det från en annan plånbok."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza crypto ili kuanza — ipokee au uihamishe kutoka kwenye wallet nyingine."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்க கிரிப்டோவைச் சேர்க்கவும் — மற்றொரு வாலட்டிலிருந்து பெறவும் அல்லது மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభించడానికి క్రిప్టోను జోడించండి — మరొక వాలెట్ నుండి స్వీకరించండి లేదా బదిలీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคริปโทเพื่อเริ่มต้น — รับหรือโอนจากกระเป๋าเงินอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için kripto ekleyin — başka bir cüzdandan alın veya aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте криптовалюту, щоб почати — отримайте її або перекажіть з іншого гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنے کے لیے کرپٹو شامل کریں — اسے وصول کریں یا کسی دوسرے والیٹ سے منتقل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tiền mã hóa để bắt đầu — nhận hoặc chuyển từ một ví khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加加密货币即可开始——从其他钱包接收或转入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入加密貨幣即可開始——從其他錢包接收或轉入。"
          }
        }
      }
    },
