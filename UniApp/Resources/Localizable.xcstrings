        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6 अंकों का PIN चुनें। आप इसका उपयोग Aperture को अनलॉक करने और लेन-देन की पुष्टि करने के लिए करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite šesteroznamenkasti PIN. Koristit ćete ga za otključavanje Aperturea i potvrđivanje transakcija."
          }
        },
        "hu": {
          "stringUnit": {
