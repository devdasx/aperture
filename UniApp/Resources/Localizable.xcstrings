        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgesaai na die %@-netwerk. Bevestiging kan 'n oomblik neem — jy kan hierdie skerm veilig verlaat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ நெட்வொர்க்கிற்கு அனுப்பப்பட்டது. உறுதிப்படுத்த சிறிது நேரம் ஆகலாம் — இந்தத் திரையை நீங்கள் பாதுகாப்பாக விட்டுச் செல்லலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ నెట్‌వర్క్‌కు ప్రసారం చేయబడింది. నిర్ధారణకు కొంత సమయం పట్టవచ్చు — మీరు ఈ స్క్రీన్‌ను సురక్షితంగా వదిలివేయవచ్చు."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ നെറ്റ്‌വർക്കിലേക്ക് പ്രക്ഷേപണം ചെയ്തു. സ്ഥിരീകരണത്തിന് അൽപ്പസമയം എടുത്തേക്കാം — നിങ്ങൾക്ക് ഈ സ്ക്രീൻ സുരക്ഷിതമായി വിട്ടുപോകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ नेटवर्कवर प्रसारित केले. पुष्टी होण्यास थोडा वेळ लागू शकतो — तुम्ही ही स्क्रीन सुरक्षितपणे सोडू शकता."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਨੈੱਟਵਰਕ ਉੱਤੇ ਪ੍ਰਸਾਰਿਤ ਕੀਤਾ ਗਿਆ। ਪੁਸ਼ਟੀ ਹੋਣ ਵਿੱਚ ਕੁਝ ਪਲ ਲੱਗ ਸਕਦੇ ਹਨ — ਤੁਸੀਂ ਇਸ ਸਕ੍ਰੀਨ ਨੂੰ ਸੁਰੱਖਿਅਤ ਢੰਗ ਨਾਲ ਛੱਡ ਸਕਦੇ ਹੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
