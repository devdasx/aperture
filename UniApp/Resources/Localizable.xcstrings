        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mạng đã ẩn vẫn được hỗ trợ — chỉ chế độ xem của tài sản này bị ảnh hưởng."
          }
        },
        "zh-Hans": {
