        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏عنوان الاستلام سلسلة نصية تُعرّف أحد حساباتك على شبكة محددة. مشاركته تسمح لشخص ما بإرسال أموال إلى ذلك الحساب."
