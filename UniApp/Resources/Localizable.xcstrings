        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av oppføringene ble validert for \\(chain.displayName). Trykk tilbake og kontroller hver adresse eller nøkkel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen van de vermeldingen is gevalideerd voor \\(chain.displayName). Tik terug en controleer elk adres of sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
