    "Generated on-device. Stored on-device. Aperture has no copy.": {
      "comment": "Slide 3 body.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Op die toestel geskep. Op die toestel gestoor. Aperture het geen afskrif nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُولَّد على الجهاز. يُخزَّن على الجهاز. ولا توجد لدى Aperture أي نسخة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Генерирана на устройството. Съхранена на устройството. Aperture няма копие."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসেই তৈরি। ডিভাইসেই সংরক্ষিত। Aperture-এর কাছে কোনো কপি নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Generada al dispositiu. Desada al dispositiu. Aperture no en té cap còpia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořeno v zařízení. Uloženo v zařízení. Aperture nemá kopii."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereret på enheden. Gemt på enheden. Aperture har ingen kopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät erzeugt. Auf dem Gerät gespeichert. Aperture besitzt keine Kopie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήθηκε στη συσκευή. Αποθηκεύεται στη συσκευή. Το Aperture δεν έχει αντίγραφο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated on-device. Stored on-device. Aperture has no copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generadas en el dispositivo. Guardadas en el dispositivo. Aperture no tiene copia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loodud seadmes. Salvestatud seadmes. Aperture'il pole koopiat."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی دستگاه ساخته می‌شوند. روی دستگاه ذخیره می‌شوند. Aperture هیچ نسخه‌ای ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luotu laitteella. Tallennettu laitteelle. Aperturella ei ole kopiota."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binuo sa device. Iniimbak sa device. Walang kopya ang Aperture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générées sur l’appareil. Conservées sur l’appareil. Aperture n’en a aucune copie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נוצר במכשיר. נשמר במכשיר. ל-Aperture אין עותק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर ही बनाया गया। डिवाइस पर ही रखा गया। Aperture के पास कोई प्रति नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Generirano na uređaju. Pohranjeno na uređaju. Aperture nema kopiju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eszközön generálva. Eszközön tárolva. Az Aperture-nek nincs másolata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat di perangkat. Disimpan di perangkat. Aperture tidak menyimpan salinan apa pun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Búið til í tækinu. Geymt í tækinu. Aperture á ekkert afrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate sul dispositivo. Conservate sul dispositivo. Aperture non ne ha alcuna copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上で生成され、デバイス上に保存されます。Aperture は控えを持ちません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 생성하고, 기기에 보관합니다. Aperture는 사본을 갖지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukurta įrenginyje. Saugoma įrenginyje. „Aperture“ neturi kopijos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izveidots ierīcē. Glabājas ierīcē. Aperture nav kopijas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപകരണത്തിൽത്തന്നെ സൃഷ്ടിച്ചത്. ഉപകരണത്തിൽത്തന്നെ സംഭരിച്ചത്. Aperture-ന് പകർപ്പില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिव्हाइसवरच तयार. डिव्हाइसवरच साठवलेलं. Aperture कडे कोणतीही प्रत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijana pada peranti. Disimpan pada peranti. Aperture tidak mempunyai salinan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Generert på enheten. Lagret på enheten. Aperture har ingen kopi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangemaakt op het apparaat. Bewaard op het apparaat. Aperture heeft geen kopie."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡਿਵਾਈਸ ਉੱਤੇ ਹੀ ਬਣਾਇਆ। ਡਿਵਾਈਸ ਉੱਤੇ ਹੀ ਸਟੋਰ। Aperture ਕੋਲ ਕੋਈ ਕਾਪੀ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygenerowane na urządzeniu. Przechowywane na urządzeniu. Aperture nie ma żadnej kopii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Geradas no dispositivo. Guardadas no dispositivo. A Aperture não tem cópia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Generată pe dispozitiv. Stocată pe dispozitiv. Aperture nu are nicio copie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаётся на устройстве. Хранится на устройстве. У Aperture нет копии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vygenerované v zariadení. Uložené v zariadení. Aperture nemá kópiu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarjeno na napravi. Shranjeno na napravi. Aperture nima kopije."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Генерисано на уређају. Сачувано на уређају. Aperture нема копију."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapad på enheten. Lagrad på enheten. Aperture har ingen kopia."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imetengenezwa kifaani. Imehifadhiwa kifaani. Aperture haina nakala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதனத்திலேயே உருவாக்கப்பட்டது. சாதனத்திலேயே சேமிக்கப்பட்டது. Aperture-இடம் ஒரு நகலும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరికరంలోనే రూపొందించబడింది. పరికరంలోనే నిల్వ చేయబడింది. Aperture వద్ద కాపీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างบนอุปกรณ์ จัดเก็บบนอุปกรณ์ Aperture ไม่มีสำเนาใดเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazda oluşturulur. Cihazda saklanır. Aperture'ın bir kopyası yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створено на пристрої. Зберігається на пристрої. У Aperture немає копії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آلے پر بنایا گیا۔ آلے پر محفوظ۔ Aperture کے پاس کوئی نقل نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tạo trên thiết bị. Lưu trên thiết bị. Aperture không giữ bản sao nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上生成。在设备上保存。Aperture 没有副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在裝置上產生。在裝置上保存。Aperture 沒有副本。"
          }
        }
      }
