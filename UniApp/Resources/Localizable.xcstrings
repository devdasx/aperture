        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "6 അക്ക PIN തിരഞ്ഞെടുക്കുക. Aperture അൺലോക്ക് ചെയ്യാനും ഇടപാടുകൾ സ്ഥിരീകരിക്കാനും ഇത് ഉപയോഗിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
