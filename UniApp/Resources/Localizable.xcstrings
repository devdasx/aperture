    "Save your recovery phrase before you skip.": {
      "comment": "Skip-backup warning sheet title.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoor jou herstelfrase voordat jy oorslaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ عبارة الاسترداد قبل أن تتخطّى الخطوة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазете фразата си за възстановяване, преди да пропуснете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এড়িয়ে যাওয়ার আগে আপনার রিকভারি ফ্রেজ সংরক্ষণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa la teva frase de recuperació abans d’ometre el pas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si obnovovací frázi, než tento krok přeskočíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem din gendannelsessætning, før du springer over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern Sie Ihre Wiederherstellungsphrase, bevor Sie überspringen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε τη φράση ανάκτησης πριν παρακάμψετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your recovery phrase before you skip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu frase de recuperación antes de omitir este paso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta oma taastefraas enne, kui jätad selle vahele."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از رد کردن، عبارت بازیابی خود را ذخیره کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna palautuslause ennen kuin ohitat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-save ang iyong recovery phrase bago laktawan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre phrase de récupération avant de passer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את ביטוי השחזור לפני שתדלג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोड़ने से पहले अपना रिकवरी फ़्रेज़ सहेज लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremite frazu za oporavak prije nego što preskočite korak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentse el a helyreállítási kifejezést, mielőtt kihagyja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan frasa pemulihan Anda sebelum melewati langkah ini."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistaðu endurheimtarsetninguna áður en þú sleppir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvi la sua frase di ripristino prima di saltare questo passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップする前に、リカバリーフレーズを保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너뛰기 전에 복구 문구를 저장하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsaugokite atkūrimo frazę prieš praleisdami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saglabājiet savu atkopšanas frāzi, pirms to izlaižat."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒഴിവാക്കുന്നതിന് മുൻപ് നിങ്ങളുടെ വീണ്ടെടുക്കൽ വാക്യം സംരക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्किप करण्याआधी तुमची रिकव्हरी फ्रेज सेव्ह करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan frasa pemulihan anda sebelum melangkau."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre gjenopprettingsfrasen før du hopper over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla je herstelzin op voordat je deze stap overslaat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਛੱਡਣ ਤੋਂ ਪਹਿਲਾਂ ਆਪਣੀ ਰਿਕਵਰੀ ਫਰੇਜ਼ ਸੇਵ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
