    "You've never sent to this address before. Double-check every character — crypto transactions can't be reversed.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy het nog nooit voorheen na hierdie adres gestuur nie. Kontroleer elke karakter dubbel — kripto-transaksies kan nie omgekeer word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ترسل إلى هذا العنوان من قبل. تحقق من كل حرف مرتين — معاملات العملات المشفّرة لا يمكن عكسها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никога не сте изпращали на този адрес преди. Проверете внимателно всеки знак — крипто транзакциите не могат да бъдат отменени."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আগে কখনো এই ঠিকানায় পাঠাননি। প্রতিটি অক্ষর ভালো করে যাচাই করুন — ক্রিপ্টো লেনদেন বাতিল করা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai no havies enviat a aquesta adreça abans. Comprova bé cada caràcter: les transaccions de cripto no es poden revertir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tuto adresu jste ještě nikdy neodesílali. Pečlivě zkontrolujte každý znak — kryptotransakce nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har aldrig sendt til denne adresse før. Dobbelttjek hvert tegn — kryptotransaktioner kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch nie an diese Adresse gesendet. Prüfe jedes Zeichen genau – Krypto-Transaktionen können nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχετε στείλει ποτέ σε αυτή τη διεύθυνση στο παρελθόν. Ελέγξτε κάθε χαρακτήρα — οι συναλλαγές κρυπτονομισμάτων δεν μπορούν να αναιρεθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've never sent to this address before. Double-check every character — crypto transactions can't be reversed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca has enviado a esta dirección antes. Comprueba dos veces cada carácter: las transacciones cripto no se pueden revertir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pole sellele aadressile kunagi varem saatnud. Kontrollige iga märki hoolikalt — krüptotehinguid ei saa tagasi pöörata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما هرگز پیش‌تر به این نشانی ارسال نکرده‌اید. هر کاراکتر را دوباره بررسی کنید — تراکنش‌های رمزارز قابل بازگشت نیستند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole koskaan ennen lähettänyt tähän osoitteeseen. Tarkista jokainen merkki — kryptotapahtumia ei voi perua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ka pa kailanman nagpadala sa address na ito noon. I-double-check ang bawat karakter — hindi maibabalik ang mga crypto transaction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez jamais envoyé à cette adresse auparavant. Vérifiez bien chaque caractère — les transactions crypto ne peuvent pas être annulées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעולם לא שלחת לכתובת זו בעבר. בדוק שוב כל תו — לא ניתן לבטל עסקאות קריפטו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने पहले कभी इस पते पर नहीं भेजा है। हर अक्षर दोबारा जाँचें — क्रिप्टो ट्रांज़ैक्शन को उलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikad prije niste slali na ovu adresu. Dvaput provjerite svaki znak — kriptotransakcije se ne mogu poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erre a címre még sosem küldtél. Ellenőrizz kétszer minden karaktert — a kriptotranzakciók nem vonhatók vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum pernah mengirim ke alamat ini sebelumnya. Periksa kembali setiap karakter — transaksi kripto tidak dapat dibatalkan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hefur aldrei sent á þetta vistfang áður. Athugaðu hvern staf tvisvar — ekki er hægt að afturkalla rafmyntafærslur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai mai inviato a questo indirizzo prima. Ricontrolla ogni carattere — le transazioni cripto non possono essere annullate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスに送ったことはありません。すべての文字をよく確認してください — 暗号資産の取引は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 이 주소로 보낸 적이 없습니다. 모든 문자를 다시 한번 확인하세요 — 암호화폐 거래는 되돌릴 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į šį adresą dar niekada nesiuntėte. Patikrinkite kiekvieną simbolį – kriptovaliutos operacijų atšaukti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs nekad iepriekš neesat sūtījis uz šo adresi. Pārbaudiet katru rakstzīmi — kriptovalūtu transakcijas nevar atsaukt."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഈ വിലാസത്തിലേക്ക് മുമ്പ് ഒരിക്കലും അയച്ചിട്ടില്ല. ഓരോ പ്രതീകവും രണ്ടുതവണ പരിശോധിക്കുക — ക്രിപ്റ്റോ ഇടപാടുകൾ റിവേഴ്സ് ചെയ്യാനാവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही या पत्त्यावर याआधी कधीही पाठवले नाही. प्रत्येक अक्षर पुन्हा तपासा — क्रिप्टो व्यवहार परत करता येत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak pernah menghantar ke alamat ini sebelum ini. Semak semula setiap aksara — transaksi kripto tidak boleh diterbalikkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har aldri sendt til denne adressen før. Dobbeltsjekk hvert tegn — kryptotransaksjoner kan ikke reverseres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nooit eerder naar dit adres verzonden. Controleer elk teken goed — cryptotransacties kunnen niet worden teruggedraaid."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਇਸ ਪਤੇ 'ਤੇ ਪਹਿਲਾਂ ਕਦੇ ਨਹੀਂ ਭੇਜਿਆ। ਹਰ ਅੱਖਰ ਦੁਬਾਰਾ ਜਾਂਚੋ — ਕ੍ਰਿਪਟੋ ਲੈਣ-ਦੇਣ ਵਾਪਸ ਨਹੀਂ ਕੀਤੇ ਜਾ ਸਕਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy wcześniej nie wysyłałeś na ten adres. Sprawdź dokładnie każdy znak — transakcji kryptowalutowych nie da się cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você nunca enviou para este endereço antes. Confira cada caractere — transações de cripto não podem ser revertidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ai mai trimis niciodată la această adresă. Verifică de două ori fiecare caracter — tranzacțiile cripto nu pot fi anulate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы никогда раньше не отправляли на этот адрес. Перепроверьте каждый символ — криптотранзакции нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na túto adresu ste ešte nikdy neposlali. Dvakrát skontrolujte každý znak — kryptotransakcie sa nedajú vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ta naslov še nikoli niste poslali. Dvakrat preverite vsak znak — kriptotransakcij ni mogoče razveljaviti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikada ranije niste slali na ovu adresu. Dvaput proverite svaki znak — kripto transakcije se ne mogu poništiti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har aldrig skickat till denna adress tidigare. Dubbelkolla varje tecken — kryptotransaktioner kan inte ångras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hujawahi kutuma kwa anwani hii awali. Hakiki kila herufi mara mbili — miamala ya crypto haiwezi kutenguliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இந்த முகவரிக்கு முன்பு ஒருபோதும் அனுப்பவில்லை. ஒவ்வொரு எழுத்தையும் இருமுறை சரிபார்க்கவும் — கிரிப்டோ பரிவர்த்தனைகளைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఈ చిరునామాకు ఇంతకుముందు ఎప్పుడూ పంపలేదు. ప్రతి అక్షరాన్ని రెండుసార్లు తనిఖీ చేయండి — క్రిప్టో లావాదేవీలను తిరిగి మార్చలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณไม่เคยส่งไปยังที่อยู่นี้มาก่อน ตรวจสอบทุกตัวอักษรให้ดี — ธุรกรรมคริปโทไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adrese daha önce hiç göndermediniz. Her karakteri iki kez kontrol edin — kripto işlemleri geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ніколи раніше не надсилали на цю адресу. Перевірте кожен символ — криптотранзакції неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے اس ایڈریس پر پہلے کبھی نہیں بھیجا۔ ہر حرف کو دوبارہ چیک کریں — کرپٹو ٹرانزیکشنز واپس نہیں ہو سکتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa từng gửi tới địa chỉ này. Hãy kiểm tra kỹ từng ký tự — giao dịch tiền mã hóa không thể đảo ngược."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你以前从未发送到此地址。请仔细核对每一个字符——加密货币交易无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你以前從未傳送到此地址。請仔細核對每一個字元——加密貨幣交易無法復原。"
          }
        }
      }
    },
    "You've never sent to this address. For large amounts, try a small test send first — once it arrives, send the rest with one tap.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy het nog nooit na hierdie adres gestuur nie. Vir groot bedrae, probeer eers 'n klein toetsstuur — sodra dit aankom, stuur die res met een tik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ترسل إلى هذا العنوان من قبل. للمبالغ الكبيرة، جرّب إرسال مبلغ تجريبي صغير أولًا — وبمجرد وصوله، أرسل الباقي بنقرة واحدة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никога не сте изпращали на този адрес. За големи суми първо опитайте малко тестово изпращане — щом пристигне, изпратете останалото с едно докосване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কখনো এই ঠিকানায় পাঠাননি। বড় পরিমাণের জন্য প্রথমে একটি ছোট পরীক্ষামূলক পাঠানো চেষ্টা করুন — এটি পৌঁছালে, এক ট্যাপে বাকিটা পাঠান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai no has enviat a aquesta adreça. Per a imports grans, prova primer un enviament de prova petit: un cop arribi, envia la resta amb un sol toc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tuto adresu jste ještě nikdy neodesílali. U velkých částek nejprve zkuste malé zkušební odeslání — jakmile dorazí, pošlete zbytek jedním klepnutím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har aldrig sendt til denne adresse. For store beløb, prøv en lille testafsendelse først — når den ankommer, send resten med ét tryk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch nie an diese Adresse gesendet. Versuche bei großen Beträgen zuerst eine kleine Testsendung – sobald sie ankommt, sende den Rest mit einem Tipp."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχετε στείλει ποτέ σε αυτή τη διεύθυνση. Για μεγάλα ποσά, δοκιμάστε πρώτα μια μικρή δοκιμαστική αποστολή — μόλις φτάσει, στείλτε τα υπόλοιπα με ένα πάτημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've never sent to this address. For large amounts, try a small test send first — once it arrives, send the rest with one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca has enviado a esta dirección. Para importes grandes, prueba primero con un envío de prueba pequeño: cuando llegue, envía el resto con un toque."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pole sellele aadressile kunagi saatnud. Suurte summade puhul proovige esmalt väikest proovisaadetist — kui see saabub, saatke ülejäänu ühe puudutusega."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما هرگز به این نشانی ارسال نکرده‌اید. برای مبالغ زیاد، ابتدا یک ارسال آزمایشی کوچک انجام دهید — به‌محض رسیدن، بقیه را با یک ضربه ارسال کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole koskaan lähettänyt tähän osoitteeseen. Suurilla summilla kokeile ensin pientä testilähetystä — kun se on saapunut, lähetä loput yhdellä napautuksella."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ka pa kailanman nagpadala sa address na ito. Para sa malalaking halaga, subukan muna ang maliit na pansubok na pagpapadala — kapag dumating na ito, ipadala ang natira sa isang tap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez jamais envoyé à cette adresse. Pour les montants élevés, essayez d'abord un petit envoi test — une fois arrivé, envoyez le reste d'un seul toucher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעולם לא שלחת לכתובת זו. עבור סכומים גדולים, נסה תחילה שליחת בדיקה קטנה — לאחר שתגיע, שלח את השאר בהקשה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने पहले कभी इस पते पर नहीं भेजा है। बड़ी राशियों के लिए, पहले एक छोटा परीक्षण भेजकर देखें — जब वह पहुँच जाए, तो एक टैप में बाकी भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikad niste slali na ovu adresu. Za velike iznose prvo isprobajte malo probno slanje — kad stigne, pošaljite ostatak jednim dodirom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erre a címre még sosem küldtél. Nagy összegeknél először próbálj egy kis teszt­küldést — amint megérkezik, küldd a többit egyetlen koppintással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum pernah mengirim ke alamat ini. Untuk jumlah besar, coba kirim uji kecil terlebih dahulu — setelah tiba, kirim sisanya dengan satu ketukan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hefur aldrei sent á þetta vistfang. Fyrir stórar upphæðir, prófaðu litla prufusendingu fyrst — þegar hún berst, sendu afganginn með einu ýti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai mai inviato a questo indirizzo. Per importi elevati, prova prima un piccolo invio di prova — una volta arrivato, invia il resto con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスに送ったことはありません。大きな額の場合は、まず少額のテスト送金を試してください — 届いたら、残りをワンタップで送れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소로 보낸 적이 없습니다. 큰 금액의 경우 먼저 소액 테스트 전송을 해보세요 — 도착하면 나머지를 한 번의 탭으로 보내세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į šį adresą dar niekada nesiuntėte. Didelėms sumoms pirmiausia pabandykite nedidelį bandomąjį siuntimą – kai jis pasieks, likusią dalį išsiųskite vienu bakstelėjimu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs nekad neesat sūtījis uz šo adresi. Lielām summām vispirms izmēģiniet nelielu testa sūtījumu — tiklīdz tas pienāk, nosūtiet pārējo ar vienu pieskārienu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഈ വിലാസത്തിലേക്ക് ഒരിക്കലും അയച്ചിട്ടില്ല. വലിയ തുകകൾക്ക്, ആദ്യം ഒരു ചെറിയ ടെസ്റ്റ് അയയ്ക്കൽ ശ്രമിക്കുക — അത് എത്തിക്കഴിഞ്ഞാൽ, ബാക്കിയുള്ളത് ഒറ്റ ടാപ്പിൽ അയയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही या पत्त्यावर कधीही पाठवले नाही. मोठ्या रकमेसाठी, प्रथम लहान चाचणी पाठवून पहा — ते आल्यावर, एका टॅपने बाकीचे पाठवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak pernah menghantar ke alamat ini. Untuk amaun besar, cuba penghantaran ujian kecil dahulu — sebaik sahaja ia tiba, hantar selebihnya dengan satu ketikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har aldri sendt til denne adressen. For store beløp, prøv en liten testsending først — når den ankommer, send resten med ett trykk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nooit naar dit adres verzonden. Probeer bij grote bedragen eerst een kleine testverzending — zodra die aankomt, verstuur je de rest met één tik."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਇਸ ਪਤੇ 'ਤੇ ਕਦੇ ਨਹੀਂ ਭੇਜਿਆ। ਵੱਡੀਆਂ ਰਕਮਾਂ ਲਈ, ਪਹਿਲਾਂ ਇੱਕ ਛੋਟਾ ਟੈਸਟ ਭੇਜ ਕੇ ਦੇਖੋ — ਇੱਕ ਵਾਰ ਇਹ ਪਹੁੰਚ ਜਾਂਦਾ ਹੈ, ਤਾਂ ਬਾਕੀ ਇੱਕ ਟੈਪ ਨਾਲ ਭੇਜੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie wysyłałeś na ten adres. Przy dużych kwotach spróbuj najpierw małej wysyłki testowej — gdy dotrze, wyślij resztę jednym dotknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você nunca enviou para este endereço. Para valores altos, tente primeiro um pequeno envio de teste — quando chegar, envie o restante com um toque."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ai mai trimis niciodată la această adresă. Pentru sume mari, încearcă mai întâi o mică trimitere de test — odată ce ajunge, trimite restul cu o singură atingere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы никогда не отправляли на этот адрес. Для крупных сумм сначала попробуйте небольшую пробную отправку — когда она дойдёт, отправьте остальное одним касанием."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na túto adresu ste ešte nikdy neposlali. Pri veľkých sumách najprv vyskúšajte malé skúšobné odoslanie — keď dorazí, odošlite zvyšok jedným klepnutím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ta naslov še nikoli niste poslali. Pri velikih zneskih najprej poskusite z majhnim preizkusnim pošiljanjem — ko prispe, pošljite preostanek z enim tapom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikada niste slali na ovu adresu. Za velike iznose, prvo pokušajte malo probno slanje — kada stigne, pošaljite ostatak jednim dodirom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har aldrig skickat till denna adress. För stora belopp, prova en liten testsändning först — när den anländer, skicka resten med ett tryck."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hujawahi kutuma kwa anwani hii. Kwa viasi vikubwa, jaribu kutuma kiasi kidogo cha majaribio kwanza — kikifika, tuma kilichobaki kwa mguso mmoja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இந்த முகவரிக்கு ஒருபோதும் அனுப்பவில்லை. பெரிய தொகைகளுக்கு, முதலில் ஒரு சிறிய சோதனை அனுப்புதலை முயற்சிக்கவும் — அது வந்தவுடன், மீதியை ஒரே தட்டலில் அனுப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఈ చిరునామాకు ఎప్పుడూ పంపలేదు. పెద్ద మొత్తాల కోసం, మొదట చిన్న పరీక్ష పంపడాన్ని ప్రయత్నించండి — అది వచ్చిన తర్వాత, మిగిలినదాన్ని ఒక్క నొక్కుతో పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณไม่เคยส่งไปยังที่อยู่นี้ สำหรับจำนวนมาก ลองส่งทดสอบจำนวนเล็กน้อยก่อน — เมื่อถึงแล้ว ส่งที่เหลือด้วยการแตะครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adrese hiç göndermediniz. Büyük tutarlar için önce küçük bir test gönderimi deneyin — geldikten sonra gerisini tek dokunuşla gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ніколи не надсилали на цю адресу. Для великих сум спершу спробуйте невелике тестове надсилання — щойно воно надійде, надішліть решту одним торканням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے اس ایڈریس پر کبھی نہیں بھیجا۔ بڑی رقوم کے لیے پہلے ایک چھوٹا ٹیسٹ بھیجنا آزمائیں — جیسے ہی وہ پہنچ جائے، باقی ایک تھپتھپاہٹ سے بھیج دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa từng gửi tới địa chỉ này. Với các khoản lớn, hãy thử gửi thử một khoản nhỏ trước — khi nó đến nơi, gửi phần còn lại chỉ bằng một lần chạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你从未发送到此地址。对于大额，请先尝试一笔小额测试发送——到账后，一键发送其余部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你從未傳送到此地址。對於大額，請先嘗試一筆小額測試傳送——到帳後，一鍵傳送其餘部分。"
          }
        }
      }
    },
    "Your address": {
