    "All data lives on this iPhone. Aperture has no servers.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle data is op hierdie iPhone. Aperture het geen bedieners nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل البيانات تبقى على iPhone هذا. لا توجد لدى Aperture أي خوادم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички данни се намират на този iPhone. Aperture няма сървъри."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব ডেটা এই iPhone-এই থাকে। Aperture-এর কোনো সার্ভার নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes les dades viuen en aquest iPhone. Aperture no té servidors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veškerá data zůstávají na tomto iPhonu. Aperture nemá žádné servery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle data ligger på denne iPhone. Aperture har ingen servere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Daten verbleiben auf diesem iPhone. Aperture hat keine Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα δεδομένα παραμένουν σε αυτό το iPhone. Το Aperture δεν διαθέτει διακομιστές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data lives on this iPhone. Aperture has no servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los datos viven en este iPhone. Aperture no tiene servidores."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik andmed asuvad selles iPhone'is. Aperture'il ei ole servereid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ داده‌ها روی همین iPhone قرار دارند. Aperture هیچ سروری ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tiedot sijaitsevat tällä iPhonella. Aperturella ei ole palvelimia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa iPhone na ito ang lahat ng data. Walang server ang Aperture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données résident sur cet iPhone. Aperture n'a pas de serveurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הנתונים נשמרים ב-iPhone הזה. ל-Aperture אין שרתים."
          }
        },
        "hi": {
