        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tazama ufunguo wa faragha kwa kila mtandao ulio katika pochi hii — funguo za EVM, WIF za Bitcoin/Litecoin/Dogecoin, Solana na nyinginezo. Kila kimoja hudhibiti fedha katika anwani yake; usizishiriki kamwe."
          }
