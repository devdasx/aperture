            "value": "Copiat. Clipboardul se șterge în 60 de secunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировано. Буфер обмена очистится через 60 секунд."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopírované. Schránka sa za 60 sekúnd vymaže."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirano. Odložišče se izprazni čez 60 sekund."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирано. Бафер ће се очистити за 60 секунди."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierat. Urklipp rensas om 60 sekunder."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imenakiliwa. Ubao wa kunakili utafutwa baada ya sekunde 60."
          }
