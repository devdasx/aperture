        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne in konča se kot shranjeni naslov stika \\(match.savedName), vendar je sredina drugačna. Tako vas prevaranti zavedejo, da pošljete na napačno mesto."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
