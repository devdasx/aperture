        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán một hoặc nhiều địa chỉ, hoặc một khóa công khai mở rộng cho %@. Aperture chỉ đọc số dư và giao dịch — không thể gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
