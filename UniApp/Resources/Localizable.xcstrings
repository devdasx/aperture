            "value": "Ketik dua kali dan tahan untuk mengesahkan penghantaran"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-double-tap at pindutin nang matagal upang kumpirmahin ang pagpapadala"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa mara mbili na ushikilie ili kuthibitisha utumaji"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltik en hou om stuur te bevestig"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுப்புவதை உறுதிப்படுத்த இருமுறை தட்டிப் பிடிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పంపడాన్ని నిర్ధారించడానికి రెండుసార్లు నొక్కి పట్టుకోండి"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അയയ്ക്കൽ സ്ഥിരീകരിക്കാൻ രണ്ടുതവണ ടാപ്പ് ചെയ്ത് പിടിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठवण्याची पुष्टी करण्यासाठी दोनदा टॅप करून धरून ठेवा"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਭੇਜਣ ਦੀ ਪੁਸ਼ਟੀ ਕਰਨ ਲਈ ਦੋ ਵਾਰ ਟੈਪ ਕਰਕੇ ਫੜੀ ਰੱਖੋ"
          }
        }
      }
    },
