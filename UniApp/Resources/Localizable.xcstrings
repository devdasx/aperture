    "This can't be undone. Wallets you didn't back up will be lost.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan nie ongedaan gemaak word nie. Beursies wat jy nie gerugsteun het nie, sal verlore raak."
