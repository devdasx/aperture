        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിരക്ക് പരിമിതപ്പെടുത്തി — ഒരു നിമിഷത്തിന് ശേഷം വീണ്ടും ശ്രമിക്കുക"
