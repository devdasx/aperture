        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture وقتی این مدت در پس‌زمینه بگذرد قفل می‌شود. باز کردن مجدد به PIN یا Face ID نیاز دارد."
          }
        },
        "fi": {
