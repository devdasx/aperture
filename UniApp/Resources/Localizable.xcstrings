    "Changing word count generates a new phrase.": {
      "comment": "Recovery-phrase view footnote — consequence of switching word count.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om die woordtelling te verander, skep ʼn nuwe frase."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير عدد الكلمات يُنشئ عبارة جديدة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промяната на броя думи генерира нова фраза."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দসংখ্যা পরিবর্তন করলে একটি নতুন ফ্রেজ তৈরি হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar el nombre de paraules genera una frase nova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna počtu slov vygeneruje novou frázi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ændrer antallet af ord, oprettes en ny sætning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ändern der Wortanzahl erzeugt eine neue Phrase."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή του αριθμού λέξεων δημιουργεί νέα φράση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing word count generates a new phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el número de palabras genera una frase nueva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnade arvu muutmine loob uue fraasi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر تعداد کلمات یک عبارت جدید تولید می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
