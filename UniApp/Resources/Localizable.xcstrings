        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture va deriva conturi pe fiecare rețea acceptată din această frază. Poți ascunde mai târziu rețelele pe care nu le folosești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture создаст учётные записи на каждой поддерживаемой сети из этой фразы. Позже вы сможете скрыть сети, которыми не пользуетесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture odvodí z tejto frázy účty na každej podporovanej sieti. Neskôr môžeš skryť siete, ktoré nepoužívaš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bo iz te fraze izpeljal račune na vseh podprtih verigah. Verige, ki jih ne uporabljaš, lahko pozneje skriješ."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ће из ове фразе извести налоге на свакој подржаној мрежи. Касније можеш сакрити мреже које не користиш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture härleder konton på varje stödd kedja från denna fras. Du kan dölja kedjor du inte använder senare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture itatengeneza akaunti kwenye kila mnyororo unaotumika kutoka kwa kifungu hiki. Unaweza kuficha minyororo usiyotumia baadaye."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த சொற்றொடரிலிருந்து ஆதரிக்கப்படும் ஒவ்வொரு செயினிலும் Aperture கணக்குகளைப் பெறும். நீங்கள் பயன்படுத்தாத செயின்களை பின்னர் மறைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పదబంధం నుండి మద్దతు ఉన్న ప్రతి చైన్‌లో Aperture ఖాతాలను తీసుకువస్తుంది. మీరు ఉపయోగించని చైన్‌లను తర్వాత దాచవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture จะสร้างบัญชีบนทุกเชนที่รองรับจากวลีนี้ คุณสามารถซ่อนเชนที่ไม่ได้ใช้ในภายหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bu cümleden desteklenen her zincirde hesaplar türetecek. Kullanmadığın zincirleri daha sonra gizleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture створить облікові записи на кожному підтримуваному ланцюгу з цієї фрази. Ланцюги, якими ви не користуєтесь, можна приховати пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture اس فقرے سے ہر معاون چین پر اکاؤنٹس اخذ کرے گا۔ آپ بعد میں ان چینز کو چھپا سکتے ہیں جنہیں آپ استعمال نہیں کرتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture sẽ phát sinh tài khoản trên mọi chuỗi được hỗ trợ từ cụm từ này. Bạn có thể ẩn các chuỗi không dùng sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 将根据此助记词在每条支持的链上派生账户。你可以稍后隐藏不使用的链。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 會根據此助記詞在每條支援的鏈上衍生帳戶。你之後可以隱藏不使用的鏈。"
          }
        }
      }
    },
    "Aperture, Apple, your bank — no one needs your recovery phrase. Ever.": {
      "comment": "Create-wallet disclosure protection rule 3 detail.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, jou bank — niemand het jou herstelfrase nodig nie. Ooit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture وApple ومصرفك — لا أحد بحاجة إلى عبارة الاسترداد الخاصة بك. أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, вашата банка — никой не се нуждае от вашата фраза за възстановяване. Никога."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, আপনার ব্যাংক — কারও আপনার রিকভারি ফ্রেজের প্রয়োজন নেই। কখনও না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, el teu banc — ningú no necessita la teva frase de recuperació. Mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, vaše banka — nikdo vaši obnovovací frázi nepotřebuje. Nikdy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, din bank — ingen har brug for din gendannelsessætning. Aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, Ihre Bank — niemand braucht Ihre Wiederherstellungsphrase. Niemals."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, η τράπεζά σας — κανείς δεν χρειάζεται τη φράση ανάκτησής σας. Ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, your bank — no one needs your recovery phrase. Ever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, tu banco: nadie necesita tu frase de recuperación. Nunca."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, sinu pank — kellelgi pole sinu taastefraasi vaja. Mitte kunagi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture، Apple، بانک شما — هیچ‌کس به عبارت بازیابی شما نیاز ندارد. هرگز."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, pankkisi — kukaan ei tarvitse palautuslausettasi. Ei koskaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, ang iyong bangko — walang sinumang nangangailangan ng iyong recovery phrase. Kailanman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, votre banque — personne n’a besoin de votre phrase de récupération. Jamais."
