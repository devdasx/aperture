    "Proving you saved the phrase locks the wallet to you, not us.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Deur te bewys dat jy die frase gestoor het, koppel jy die beursie aan jou, nie aan ons nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إثبات أنك حفظت العبارة يربط المحفظة بك، وليس بنا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Доказването, че сте запазили фразата, обвързва портфейла с вас, а не с нас."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ফ্রেজ সংরক্ষণ করেছেন তা প্রমাণ করা ওয়ালেটটিকে আপনার সাথে আবদ্ধ করে, আমাদের সাথে নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostrar que has desat la frase vincula la cartera a tu, no a nosaltres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prokázáním, že jste frázi uložili, se peněženka uzamkne k vám, ne k nám."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bevise, du har gemt sætningen, knytter wallet til dig, ikke os."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indem du beweist, dass du die Phrase gespeichert hast, wird die Wallet an dich gebunden, nicht an uns."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απόδειξη ότι αποθηκεύσατε τη φράση κλειδώνει το πορτοφόλι σε εσάς, όχι σε εμάς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostrar que guardaste la frase vincula la cartera a ti, no a nosotros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõestus, et oled fraasi salvestanud, seob rahakoti sinuga, mitte meiega."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اثبات اینکه عبارت را ذخیره کرده‌اید، کیف پول را به شما قفل می‌کند، نه به ما."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen todistaminen, että tallensit lauseen, sitoo lompakon sinuun, ei meihin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa pagpapatunay na nai-save mo ang phrase, nakatali ang wallet sa iyo, hindi sa amin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prouver que vous avez sauvegardé la phrase lie le portefeuille à vous, pas à nous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוכחה שהביטוי נשמר על ידך נועלת את הארנק אליך, לא אלינו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह साबित करना कि आपने फ़्रेज़ सहेजा है, वॉलेट को आपसे जोड़ता है, हमसे नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokazivanje da ste spremili frazu veže novčanik za vas, ne za nas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Annak bizonyítása, hogy elmentetted a kifejezést, a tárcát hozzád köti, nem hozzánk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuktikan Anda menyimpan frasa mengunci dompet kepada Anda, bukan kami."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Að sanna að þú hafir vistað setninguna læsir veskinu við þig, ekki okkur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimostrare di aver salvato la frase lega il wallet a te, non a noi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズを保存したことを証明することで、ウォレットは私たちではなくあなたに紐付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문구를 저장했음을 증명함으로써 지갑이 우리가 아닌 당신에게 잠깁니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įrodydami, kad išsaugojote frazę, susiejate piniginę su savimi, o ne su mumis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apliecinot, ka esat saglabājis frāzi, jūs piesaistāt maku sev, nevis mums."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ വാക്യം സംരക്ഷിച്ചതായി തെളിയിക്കുന്നത് വാലറ്റിനെ നിങ്ങളിലേക്കാണ് ലോക്ക് ചെയ്യുന്നത്, ഞങ്ങളിലല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही फ्रेज सेव्ह केल्याचं सिद्ध केल्यानं वॉलेट तुमच्याशी जोडलं जातं, आमच्याशी नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuktikan anda telah menyimpan frasa mengunci dompet kepada anda, bukan kepada kami."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å bevise at du har lagret frasen, binder lommeboken til deg, ikke oss."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door te bewijzen dat je de zin hebt opgeslagen, koppel je de wallet aan jou, niet aan ons."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਾਬਤ ਕਰਨਾ ਕਿ ਤੁਸੀਂ ਫਰੇਜ਼ ਸੇਵ ਕੀਤੀ ਹੈ, ਵਾਲਿਟ ਨੂੰ ਤੁਹਾਡੇ ਨਾਲ ਜੋੜਦਾ ਹੈ, ਸਾਡੇ ਨਾਲ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udowodnienie, że zapisałeś frazę, przypisuje portfel Tobie, a nie nam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Provar que você salvou a frase vincula a carteira a você, não a nós."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Demonstrând că ai salvat fraza, portofelul este blocat la tine, nu la noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждение того, что вы сохранили фразу, привязывает кошелёк к вам, а не к нам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preukázanie, že ste si frázu uložili, viaže peňaženku na vás, nie na nás."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokazovanje, da ste frazo shranili, zaklene denarnico na vas, ne na nas."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Доказивање да сте сачували фразу везује новчаник за вас, не за нас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att bevisa att du sparat frasen låser plånboken till dig, inte oss."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuthibitisha umehifadhi kifungu hufunga pochi kwako, si kwetu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சொற்றொடரைச் சேமித்துள்ளீர்கள் என்பதை நிரூபிப்பதன் மூலம் பணப்பை உங்களுடன் கட்டப்படுகிறது, எங்களுடன் அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఫ్రేజ్‌ను సేవ్ చేశారని నిరూపించడంతో వాలెట్ మీకే లాక్ అవుతుంది, మాకు కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพิสูจน์ว่าคุณบันทึกวลีไว้แล้วจะล็อกกระเป๋าเงินไว้กับคุณ ไม่ใช่เรา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfadeyi kaydettiğinizi kanıtlamak, cüzdanı bize değil, size kilitler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердження того, що ви зберегли фразу, прив’язує гаманець до вас, а не до нас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ثابت کرنا کہ آپ نے فریز محفوظ کر لیا ہے، والٹ کو آپ سے جوڑتا ہے، ہم سے نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chứng minh bạn đã lưu cụm từ sẽ khóa ví về bạn, không phải chúng tôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证明你保存了短语,将钱包绑定到你,而不是我们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明你儲存了片語,將錢包綁定到你,而不是我們。"
          }
        }
      }
    },
