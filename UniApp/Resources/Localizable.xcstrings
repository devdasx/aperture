    "Enter the maximum price movement you'll accept. Lower is safer; higher fills more often.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer die maksimum prysbeweging in wat jy sal aanvaar. Laer is veiliger; hoër word meer dikwels gevul."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل أقصى حركة سعر تقبلها. الأقل أكثر أمانًا؛ والأعلى يُنفَّذ أكثر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете максималното ценово движение, което ще приемете. По-ниско е по-безопасно; по-високо се изпълнява по-често."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে সর্বোচ্চ মূল্য পরিবর্তন গ্রহণ করবেন তা লিখুন। কম হলে নিরাপদ; বেশি হলে আরও বেশিবার পূরণ হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el moviment de preu màxim que acceptaràs. Més baix és més segur; més alt s'executa més sovint."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte maximální pohyb ceny, který přijmete. Nižší je bezpečnější; vyšší se vyplní častěji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast den maksimale prisbevægelse, du accepterer. Lavere er sikrere; højere udfyldes oftere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die maximale Preisbewegung ein, die du akzeptierst. Niedriger ist sicherer; höher wird öfter ausgeführt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τη μέγιστη μεταβολή τιμής που αποδέχεστε. Το χαμηλότερο είναι ασφαλέστερο· το υψηλότερο εκτελείται συχνότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the maximum price movement you'll accept. Lower is safer; higher fills more often."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el movimiento de precio máximo que aceptarás. Más bajo es más seguro; más alto se completa con más frecuencia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestage maksimaalne hinnaliikumine, mida aktsepteerite. Madalam on turvalisem; kõrgem täitub sagedamini."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیشترین تغییر قیمتی را که می‌پذیرید وارد کنید. کمتر امن‌تر است؛ بیشتر دفعات بیشتری انجام می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä suurin hyväksymäsi hinnanmuutos. Pienempi on turvallisempi; suurempi toteutuu useammin."
