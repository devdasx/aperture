    "Some chains may import in watch-only mode until the per-chain signing audit completes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige kettings kan slegs in net-kyk-modus ingevoer word totdat die tekenoudit vir elke ketting voltooi is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تُستورد بعض السلاسل في وضع الاطّلاع فقط حتى يكتمل تدقيق التوقيع الخاص بكل سلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Някои вериги може да се внесат само в режим само за наблюдение, докато одитът на подписването за конкретната верига не приключи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি চেইনের জন্য সাইনিং অডিট সম্পন্ন না হওয়া পর্যন্ত কিছু চেইন কেবল-দৃষ্টি মোডে আমদানি হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunes cadenes es poden importar en mode només observació fins que es completi l'auditoria de signatura de cada cadena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé řetězce mohou být importovány pouze v režimu sledování, dokud nebude dokončen audit podepisování pro daný řetězec."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle kæder kan importeres i kun-observation-tilstand, indtil signaturrevisionen for den enkelte kæde er afsluttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Chains können im Nur-Beobachten-Modus importiert werden, bis das Signatur-Audit für die jeweilige Chain abgeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες αλυσίδες ίσως εισαχθούν σε λειτουργία μόνο παρακολούθησης μέχρι να ολοκληρωθεί ο έλεγχος υπογραφής για κάθε μία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas cadenas pueden importarse en modo solo lectura hasta que se complete la auditoría de firma de cada cadena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõned ahelad võivad importida ainult vaatlusrežiimis seni, kuni vastava ahela allkirjastamisaudit on lõppenud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی از زنجیره‌ها ممکن است تا پایان ممیزی امضای مربوط به هر زنجیره فقط در حالت فقط‌تماشا وارد شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkin ketjut saatetaan tuoda vain seurantatilassa, kunnes kunkin ketjun allekirjoitusauditointi on valmis."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring ma-import ang ilang chain sa watch-only mode hanggang sa makumpleto ang signing audit para sa bawat chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines chaînes peuvent être importées en mode lecture seule tant que l’audit de signature propre à chaque chaîne n’est pas terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהשרשרות עשויות להיות מיובאות במצב צפייה-בלבד עד להשלמת בדיקת חתימה לכל שרשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक प्रत्येक चेन का साइनिंग ऑडिट पूरा नहीं हो जाता, कुछ चेन केवल-दृष्टि मोड में आयात हो सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki se lanci mogu uvesti samo u načinu praćenja dok se ne dovrši revizija potpisivanja za pojedini lanac."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes láncok csak megfigyelő módban importálódhatnak, amíg az adott lánc aláírási auditja be nem fejeződik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa rantai mungkin diimpor dalam mode pantau-saja sampai audit penandatanganan untuk setiap rantai selesai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumar keðjur kunna að flytjast inn í aðeins-skoða ham þar til undirritunarúttekt fyrir hverja keðju er lokið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune catene possono essere importate solo in modalità sola osservazione fino al completamento dell’audit di firma per ciascuna catena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェーンごとの署名監査が完了するまで、いくつかのチェーンはウォッチオンリーモードでインポートされる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 체인의 서명 감사가 완료되기 전까지 일부 체인은 보기 전용 모드로만 가져올 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai kurios grandinės gali būti importuojamos tik stebėjimo režimu, kol bus baigtas atitinkamos grandinės pasirašymo auditas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dažas ķēdes var importēt tikai novērošanas režīmā, līdz tiek pabeigta parakstīšanas audits konkrētajai ķēdei."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ചെയിനിന്റെയും സൈനിംഗ് ഓഡിറ്റ് പൂർത്തിയാകുന്നതുവരെ ചില ചെയിനുകൾ watch-only മോഡിൽ ഇറക്കുമതി ചെയ്തേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति-साखळी स्वाक्षरी ऑडिट पूर्ण होईपर्यंत काही साखळ्या watch-only मोडमध्ये आयात होऊ शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah rantai mungkin diimport dalam mod pantau-sahaja sehingga audit penandatanganan untuk setiap rantai selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkelte kjeder kan importeres i kun-overvåkningsmodus inntil signeringsrevisjonen for hver kjede er fullført."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige chains kunnen alleen in alleen-bekijken-modus worden geïmporteerd totdat de signing-audit voor de betreffende chain is afgerond."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਤੀ-ਚੇਨ ਦਸਤਖਤੀ ਆਡਿਟ ਪੂਰਾ ਹੋਣ ਤੱਕ ਕੁਝ ਚੇਨਾਂ watch-only ਮੋਡ ਵਿੱਚ ਇੰਪੋਰਟ ਹੋ ਸਕਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre łańcuchy mogą zostać zaimportowane tylko w trybie obserwacji, dopóki nie zostanie zakończony audyt podpisywania dla danego łańcucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas redes podem ser importadas em modo somente observação até que a auditoria de assinatura de cada uma seja concluída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele lanțuri pot fi importate doar în mod observare până când se finalizează auditul de semnătură pentru fiecare lanț."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые сети могут импортироваться в режиме только для наблюдения, пока не будет завершён аудит подписи для каждой из них."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré reťaze sa môžu importovať iba v režime sledovania, kým sa nedokončí audit podpisovania pre danú reťaz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekatere verige je mogoče uvoziti samo v načinu opazovanja, dokler ni dokončan pregled podpisovanja za posamezno verigo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Неки ланци могу да се увезу само у режиму праћења док се не заврши ревизија потписивања за сваки ланац."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa kedjor kan importeras i läget endast bevakning tills signaturgranskningen för respektive kedja är klar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Baadhi ya minyororo inaweza kuingizwa katika hali ya kuangalia tu hadi ukaguzi wa kutia saini wa kila mnyororo ukamilike."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு சங்கிலிக்கான கையெழுத்து தணிக்கை முடியும் வரை சில சங்கிலிகள் பார்வைக்கு-மட்டுமே முறையில் இறக்குமதி செய்யப்படக்கூடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి చైన్‌కు సంతకం ఆడిట్ పూర్తయ్యే వరకు కొన్ని చైన్లు watch-only మోడ్‌లో దిగుమతి కావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางเชนอาจถูกนำเข้าในโหมดดูอย่างเดียวจนกว่าการตรวจสอบการลงนามของแต่ละเชนจะเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zincirin imzalama denetimi tamamlanana kadar bazı zincirler yalnızca-gözleme modunda içe aktarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі мережі можуть імпортуватися лише в режимі спостереження, доки не завершиться аудит підпису для кожної з них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک ہر چین کے لیے سائننگ آڈٹ مکمل نہیں ہوتا، کچھ چینز صرف-دیکھنے والے موڈ میں ہی درآمد ہو سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số chuỗi có thể được nhập ở chế độ chỉ theo dõi cho đến khi việc kiểm tra ký cho từng chuỗi hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每条链的签名审计完成之前,部分链可能只能以仅观察模式导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每條鏈的簽章稽核完成之前,部分鏈可能只能以僅檢視模式匯入。"
          }
        }
      }
    },
