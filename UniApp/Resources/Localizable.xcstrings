    "Aperture will derive accounts on every supported chain from this phrase. You can hide chains you don't use later.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture sal rekeninge op elke ondersteunde ketting van hierdie frase aflei. Jy kan kettings wat jy nie gebruik nie later versteek."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيشتق Aperture حسابات على كل سلسلة مدعومة من هذه العبارة. يمكنك إخفاء السلاسل التي لا تستخدمها لاحقاً."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ще извлече акаунти на всяка поддържана верига от тази фраза. По-късно можеш да скриеш веригите, които не използваш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture এই বাক্যাংশ থেকে প্রতিটি সমর্থিত চেইনে অ্যাকাউন্ট তৈরি করবে। আপনি পরে যেগুলি ব্যবহার করেন না সেগুলি লুকিয়ে রাখতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture derivarà comptes a cada xarxa compatible a partir d'aquesta frase. Pots amagar les xarxes que no facis servir més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture z této fráze odvodí účty na každém podporovaném řetězci. Řetězce, které nepoužíváte, můžete později skrýt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture afleder konti på hver understøttet kæde fra denne frase. Du kan skjule kæder, du ikke bruger, senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture leitet aus dieser Phrase Konten auf jeder unterstützten Chain ab. Du kannst Chains, die du nicht nutzt, später ausblenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Aperture θα δημιουργήσει λογαριασμούς σε κάθε υποστηριζόμενη αλυσίδα από αυτή τη φράση. Μπορείτε να αποκρύψετε αργότερα τις αλυσίδες που δεν χρησιμοποιείτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture derivará cuentas en cada red compatible a partir de esta frase. Puedes ocultar las redes que no uses más tarde."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture tuletab sellest fraasist kontosid igal toetatud ahelal. Hiljem võid peita ahelad, mida ei kasuta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture از این عبارت حساب‌هایی روی هر زنجیره پشتیبانی‌شده مشتق می‌کند. می‌توانید بعداً زنجیره‌هایی را که استفاده نمی‌کنید پنهان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture johtaa tästä lauseesta tilejä jokaiseen tuettuun ketjuun. Voit piilottaa myöhemmin ketjuja, joita et käytä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide-derive ng Aperture ang mga account sa bawat sinusuportahang chain mula sa phrase na ito. Maaari mong itago ang mga chain na hindi mo ginagamit sa ibang pagkakataon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dérivera des comptes sur chaque chaîne prise en charge à partir de cette phrase. Vous pouvez masquer plus tard les chaînes que vous n'utilisez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture יגזור חשבונות בכל שרשרת נתמכת מהביטוי הזה. תוכל להסתיר מאוחר יותר שרשראות שאינך משתמש בהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture इस वाक्यांश से प्रत्येक समर्थित चेन पर खाते बनाएगा। आप बाद में उन चेन को छिपा सकते हैं जिनका आप उपयोग नहीं करते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture će iz ove fraze izvesti račune na svakom podržanom lancu. Lance koje ne koristiš možeš kasnije sakriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture ebből a kifejezésből minden támogatott láncon származtat fiókokat. A nem használt láncokat később elrejtheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture akan menurunkan akun di setiap chain yang didukung dari frasa ini. Kamu bisa menyembunyikan chain yang tidak digunakan nanti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture mun leiða af reikninga á hverri studdri keðju út frá þessari setningu. Þú getur falið keðjur sem þú notar ekki síðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture deriverà account su ogni rete supportata a partire da questa frase. Potrai nascondere in seguito le reti che non usi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture はこのフレーズからサポートされているすべてのチェーンでアカウントを派生させます。使用しないチェーンは後で非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture는 이 문구로부터 지원되는 모든 체인에서 계정을 파생합니다. 사용하지 않는 체인은 나중에 숨길 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture iš šios frazės išves paskyras kiekvienoje palaikomoje grandinėje. Vėliau galėsi paslėpti grandines, kurių nenaudoji."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture no šīs frāzes atvasinās kontus katrā atbalstītajā ķēdē. Vēlāk vari paslēpt ķēdes, kuras neizmanto."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫ്രേസിൽ നിന്ന് പിന്തുണയ്ക്കുന്ന ഓരോ ചെയിനിലും Aperture അക്കൗണ്ടുകൾ ഉരുത്തിരിക്കും. നിങ്ങൾ ഉപയോഗിക്കാത്ത ചെയിനുകൾ പിന്നീട് മറയ്ക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या वाक्यांशावरून Aperture प्रत्येक समर्थित साखळीवर खाती तयार करेल. तुम्ही नंतर वापरत नसलेल्या साखळ्या लपवू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture akan menerbitkan akaun pada setiap rantai yang disokong daripada frasa ini. Anda boleh menyembunyikan rantai yang tidak digunakan kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture utleder kontoer på hver støttede kjede fra denne frasen. Du kan skjule kjeder du ikke bruker senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture leidt op basis van deze frase accounts af op elke ondersteunde chain. Chains die je niet gebruikt kun je later verbergen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ਇਸ ਵਾਕੰਸ਼ ਤੋਂ ਹਰ ਸਮਰਥਿਤ ਚੇਨ 'ਤੇ ਖਾਤੇ ਪ੍ਰਾਪਤ ਕਰੇਗਾ। ਤੁਸੀਂ ਬਾਅਦ ਵਿੱਚ ਉਹ ਚੇਨਾਂ ਛੁਪਾ ਸਕਦੇ ਹੋ ਜੋ ਤੁਸੀਂ ਨਹੀਂ ਵਰਤਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture utworzy konta na każdym obsługiwanym łańcuchu z tej frazy. Łańcuchy, których nie używasz, możesz później ukryć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Aperture derivará contas em cada rede suportada a partir desta frase. Você pode ocultar redes que não usa mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture va deriva conturi pe fiecare rețea acceptată din această frază. Poți ascunde mai târziu rețelele pe care nu le folosești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture создаст учётные записи на каждой поддерживаемой сети из этой фразы. Позже вы сможете скрыть сети, которыми не пользуетесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture odvodí z tejto frázy účty na každej podporovanej sieti. Neskôr môžeš skryť siete, ktoré nepoužívaš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bo iz te fraze izpeljal račune na vseh podprtih verigah. Verige, ki jih ne uporabljaš, lahko pozneje skriješ."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ће из ове фразе извести налоге на свакој подржаној мрежи. Касније можеш сакрити мреже које не користиш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture härleder konton på varje stödd kedja från denna fras. Du kan dölja kedjor du inte använder senare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture itatengeneza akaunti kwenye kila mnyororo unaotumika kutoka kwa kifungu hiki. Unaweza kuficha minyororo usiyotumia baadaye."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த சொற்றொடரிலிருந்து ஆதரிக்கப்படும் ஒவ்வொரு செயினிலும் Aperture கணக்குகளைப் பெறும். நீங்கள் பயன்படுத்தாத செயின்களை பின்னர் மறைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పదబంధం నుండి మద్దతు ఉన్న ప్రతి చైన్‌లో Aperture ఖాతాలను తీసుకువస్తుంది. మీరు ఉపయోగించని చైన్‌లను తర్వాత దాచవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture จะสร้างบัญชีบนทุกเชนที่รองรับจากวลีนี้ คุณสามารถซ่อนเชนที่ไม่ได้ใช้ในภายหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bu cümleden desteklenen her zincirde hesaplar türetecek. Kullanmadığın zincirleri daha sonra gizleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture створить облікові записи на кожному підтримуваному ланцюгу з цієї фрази. Ланцюги, якими ви не користуєтесь, можна приховати пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture اس فقرے سے ہر معاون چین پر اکاؤنٹس اخذ کرے گا۔ آپ بعد میں ان چینز کو چھپا سکتے ہیں جنہیں آپ استعمال نہیں کرتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture sẽ phát sinh tài khoản trên mọi chuỗi được hỗ trợ từ cụm từ này. Bạn có thể ẩn các chuỗi không dùng sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 将根据此助记词在每条支持的链上派生账户。你可以稍后隐藏不使用的链。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 會根據此助記詞在每條支援的鏈上衍生帳戶。你之後可以隱藏不使用的鏈。"
          }
        }
      }
    },
