          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de solicitudes alcanzado — inténtalo de nuevo en un momento"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päringutele on seatud piirang — proovi hetke pärast uuesti"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محدودیت نرخ — کمی بعد دوباره تلاش کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
