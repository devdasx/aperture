    "No accounts. No servers. Aperture lives on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen rekeninge. Geen bedieners. Aperture leef op jou iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا حسابات. بلا خوادم. Aperture يعيش على iPhone الخاص بك."
          }
        },
        "bg": {
          "stringUnit": {
