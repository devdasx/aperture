    "Does this look like the wallet you expected?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyk dit soos die beursie wat jy verwag het?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تبدو هذه هي المحفظة التي توقعتها؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ли изглежда като портфейла, който очакваше?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কি সেই ওয়ালেটের মতো দেখাচ্ছে যা আপনি আশা করেছিলেন?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et sembla aquesta la wallet que esperaves?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadá toto jako peněženka, kterou jste očekávali?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligner dette den wallet, du forventede?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieht das nach der Wallet aus, die du erwartet hast?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό μοιάζει με το πορτοφόλι που περιμένατε;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es esta la wallet que esperabas?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas see näeb välja nagu rahakott, mida ootasid?"
