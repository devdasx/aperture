    "A wallet whose recovery phrase you never wrote down cannot be recovered. There is no backup on a server — there is no server.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Beursie waarvan jy nooit die herstelfrase neergeskryf het nie, kan nie herstel word nie. Daar is geen rugsteun op 'n bediener nie — daar is geen bediener nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استرداد محفظة لم تدوّن عبارة استردادها مطلقًا. لا توجد نسخة احتياطية على خادم — لا يوجد خادم أصلًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Портфейл, чиято фраза за възстановяване никога не сте записали, не може да бъде възстановен. Няма резервно копие на сървър — няма сървър."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে ওয়ালেটের রিকভারি ফ্রেজ আপনি কখনো লিখে রাখেননি তা পুনরুদ্ধার করা যায় না। কোনো সার্ভারে ব্যাকআপ নেই — কোনো সার্ভারই নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cartera de la qual mai no vas anotar la frase de recuperació no es pot recuperar. No hi ha cap còpia de seguretat en un servidor: no hi ha cap servidor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peněženku, jejíž obnovovací frázi jste si nikdy nezapsali, nelze obnovit. Na serveru není žádná záloha — žádný server neexistuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tegnebog, hvis gendannelsessætning du aldrig skrev ned, kan ikke gendannes. Der er ingen sikkerhedskopi på en server — der er ingen server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wallet, dessen Wiederherstellungsphrase du nie aufgeschrieben hast, kann nicht wiederhergestellt werden. Es gibt kein Backup auf einem Server – es gibt keinen Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πορτοφόλι του οποίου τη φράση ανάκτησης δεν καταγράψατε ποτέ δεν μπορεί να ανακτηθεί. Δεν υπάρχει αντίγραφο ασφαλείας σε διακομιστή — δεν υπάρχει διακομιστής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wallet whose recovery phrase you never wrote down cannot be recovered. There is no backup on a server — there is no server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cartera cuya frase de recuperación nunca anotaste no se puede recuperar. No hay copia de seguridad en un servidor; no hay servidor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahakotti, mille taastefraasi te kunagi üles ei kirjutanud, ei saa taastada. Serveris pole varukoopiat — serverit pole olemas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پولی که عبارت بازیابی آن را هرگز یادداشت نکرده‌اید قابل بازیابی نیست. هیچ پشتیبانی روی سرور وجود ندارد — اصلاً سروری وجود ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lompakkoa, jonka palautuslausetta et koskaan kirjoittanut ylös, ei voi palauttaa. Palmikkokopiota ei ole palvelimella — palvelinta ei ole."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mababawi ang wallet na hindi mo isinulat ang recovery phrase. Walang backup sa isang server — walang server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portefeuille dont vous n'avez jamais noté la phrase de récupération ne peut pas être récupéré. Il n'y a pas de sauvegarde sur un serveur — il n'y a pas de serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארנק שלא רשמת את ביטוי השחזור שלו לא ניתן לשחזור. אין גיבוי בשרת — אין שרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस वॉलेट का रिकवरी फ़्रेज़ आपने कभी नहीं लिखा, उसे पुनर्प्राप्त नहीं किया जा सकता। किसी सर्वर पर कोई बैकअप नहीं है — कोई सर्वर ही नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novčanik čiju frazu za oporavak nikad niste zapisali ne može se oporaviti. Nema sigurnosne kopije na poslužitelju — nema poslužitelja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy tárca, amelynek helyreállítási kifejezését sosem írtad le, nem állítható helyre. Nincs biztonsági mentés egy szerveren — nincs szerver."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet yang frasa pemulihannya tidak pernah Anda catat tidak dapat dipulihkan. Tidak ada cadangan di server — tidak ada server."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki er hægt að endurheimta veski sem þú skrifaðir aldrei niður endurheimtarsetninguna fyrir. Það er ekkert afrit á þjóni — það er enginn þjónn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un wallet la cui frase di recupero non hai mai annotato non può essere recuperato. Non esiste un backup su un server — non esiste alcun server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを書き留めていないウォレットは復元できません。サーバー上にバックアップはなく、そもそもサーバーが存在しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 문구를 적어 두지 않은 지갑은 복구할 수 없습니다. 서버에 백업이 없습니다 — 서버 자체가 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Piniginė, kurios atkūrimo frazės niekada neužsirašėte, negali būti atkurta. Serveryje atsarginės kopijos nėra – serverio nėra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Maku, kura atkopšanas frāzi nekad neesat pierakstījis, nevar atkopt. Serverī nav dublējuma — servera nav."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഒരിക്കലും റിക്കവറി ഫ്രെയ്സ് എഴുതിവയ്ക്കാത്ത ഒരു വാലറ്റ് വീണ്ടെടുക്കാനാവില്ല. സെർവറിൽ ബാക്കപ്പില്ല — സെർവർ തന്നെയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्या वॉलेटचा रिकव्हरी फ्रेज तुम्ही कधीच लिहून ठेवला नाही तो परत मिळवता येत नाही. सर्व्हरवर कोणताही बॅकअप नाही — सर्व्हरच नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet yang frasa pemulihannya tidak pernah anda tuliskan tidak boleh dipulihkan. Tiada sandaran pada pelayan — tiada pelayan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lommebok der du aldri skrev ned gjenopprettingsfrasen, kan ikke gjenopprettes. Det finnes ingen sikkerhetskopi på en server — det finnes ingen server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een wallet waarvan je de herstelzin nooit hebt opgeschreven, kan niet worden hersteld. Er is geen back-up op een server — er is geen server."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਸ ਵਾਲਿਟ ਦਾ ਰਿਕਵਰੀ ਫ੍ਰੇਜ਼ ਤੁਸੀਂ ਕਦੇ ਨਹੀਂ ਲਿਖਿਆ, ਉਸਨੂੰ ਮੁੜ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ। ਸਰਵਰ 'ਤੇ ਕੋਈ ਬੈਕਅੱਪ ਨਹੀਂ ਹੈ — ਕੋਈ ਸਰਵਰ ਹੀ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfela, którego frazy odzyskiwania nigdy nie zapisałeś, nie da się odzyskać. Nie ma kopii zapasowej na serwerze — nie ma serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma carteira cuja frase de recuperação você nunca anotou não pode ser recuperada. Não há backup em um servidor — não existe servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portofel a cărui frază de recuperare nu ai notat-o niciodată nu poate fi recuperat. Nu există o copie de rezervă pe un server — nu există niciun server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелёк, чью фразу восстановления вы не записали, восстановить невозможно. На сервере нет резервной копии — сервера нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Peňaženku, ktorej obnovovaciu frázu ste si nikdy nezapísali, nemožno obnoviť. Na serveri nie je žiadna záloha — nie je žiadny server."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denarnice, katere obnovitvenega gesla niste nikoli zapisali, ni mogoče obnoviti. Na strežniku ni varnostne kopije — ni strežnika."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novčanik čiju frazu za oporavak nikada niste zapisali ne može se povratiti. Nema rezervne kopije na serveru — nema servera."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En plånbok vars återställningsfras du aldrig skrev ner kan inte återställas. Det finns ingen säkerhetskopia på en server — det finns ingen server."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet ambayo hujawahi kuandika kifungu chake cha urejeshaji haiwezi kurejeshwa. Hakuna nakala rudufu kwenye seva — hakuna seva."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்பு சொற்றொடரை நீங்கள் ஒருபோதும் எழுதி வைக்காத வாலட்டை மீட்டெடுக்க முடியாது. சேவையகத்தில் காப்புப்பிரதி இல்லை — சேவையகமே இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు రికవరీ పదబంధాన్ని ఎప్పుడూ వ్రాయని వాలెట్‌ను పునరుద్ధరించలేరు. సర్వర్‌లో బ్యాకప్ లేదు — సర్వరే లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าเงินที่คุณไม่เคยจดวลีกู้คืนไว้จะไม่สามารถกู้คืนได้ ไม่มีการสำรองข้อมูลบนเซิร์ฟเวอร์ — เพราะไม่มีเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma ifadesini hiç yazmadığınız bir cüzdan kurtarılamaz. Bir sunucuda yedek yoktur — sunucu yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець, фразу для відновлення якого ви ніколи не записували, відновити неможливо. Немає резервної копії на сервері — немає сервера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس والیٹ کا ریکوری فقرہ آپ نے کبھی نہیں لکھا، اسے بحال نہیں کیا جا سکتا۔ سرور پر کوئی بیک اپ نہیں ہے — کوئی سرور ہی نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ví mà bạn chưa từng ghi lại cụm từ khôi phục thì không thể khôi phục được. Không có bản sao lưu trên máy chủ — không hề có máy chủ nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你从未记下助记词的钱包无法恢复。服务器上没有备份——根本没有服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你從未記下助記詞的錢包無法復原。伺服器上沒有備份——根本沒有伺服器。"
          }
        }
      }
    },
    "A watch-only wallet shows you what an address owns and what it has done — without ever holding the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "’n Net-kyk-beursie wys jou wat ’n adres besit en wat dit gedoen het — sonder om ooit die sleutels te hou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفظة العرض فقط تُريك ما يملكه عنوان ما وما الذي قام به — دون أن تحتفظ بأي مفاتيح."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Портфейл само за наблюдение ви показва какво притежава даден адрес и какво е правил — без никога да съхранява ключовете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়াচ-অনলি ওয়ালেট আপনাকে দেখায় কোনো অ্যাড্রেসে কী আছে আর কী হয়েছে — কখনো কীগুলো না রেখেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cartera només de visualització et mostra el que posseeix una adreça i el que ha fet — sense tenir mai les claus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peněženka jen pro sledování ti ukazuje, co adresa vlastní a co dělala — aniž by kdy držela klíče."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kun-se-tegnebog viser dig, hvad en adresse ejer, og hvad den har gjort — uden nogensinde at holde nøglerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nur-Lese-Wallet zeigt dir, was einer Adresse gehört und was sie getan hat – ohne jemals die Schlüssel zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πορτοφόλι μόνο για παρακολούθηση σας δείχνει τι κατέχει μια διεύθυνση και τι έχει κάνει — χωρίς ποτέ να κρατά τα κλειδιά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cartera de solo lectura te muestra lo que posee una dirección y lo que ha hecho, sin custodiar nunca las claves."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult vaatlemiseks rahakott näitab teile, mis kuulub ühele aadressile ja mida see on teinud — ilma et see kunagi võtmeid endas hoiaks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول فقط‌تماشا به شما نشان می‌دهد یک آدرس چه چیزی در اختیار دارد و چه کارهایی انجام داده است — بدون اینکه هرگز کلیدها را نگه دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain-katselu-lompakko näyttää, mitä osoite omistaa ja mitä se on tehnyt — pitämättä koskaan avaimia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita sa iyo ng watch-only na wallet kung ano ang pag-aari ng isang address at kung ano ang ginawa nito — nang hindi kailanman hawak ang mga susi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portefeuille en lecture seule vous montre ce qu'une adresse possède et ce qu'elle a fait — sans jamais détenir les clés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארנק לצפייה בלבד מראה לך מה כתובת מחזיקה ומה היא עשתה — מבלי להחזיק אי פעם במפתחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉच-ओनली वॉलेट आपको दिखाता है कि किसी पते के पास क्या है और उसने क्या किया है — बिना कभी कुंजियाँ रखे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novčanik samo za pregled prikazuje vam što adresa posjeduje i što je radila — bez ikada držanja ključeva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csak megfigyelő tárca megmutatja, mi van egy cím birtokában és mit tett — anélkül, hogy valaha is birtokolná a kulcsokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet pantau-saja menunjukkan kepada Anda apa yang dimiliki sebuah alamat dan apa yang pernah dilakukannya — tanpa pernah menyimpan kuncinya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veski með aðeins-skoða sýnir þér hvað vistfang á og hvað það hefur gert — án þess að halda nokkurn tíma um lyklana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un wallet di sola visualizzazione ti mostra cosa possiede un indirizzo e cosa ha fatto — senza mai detenere le chiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧専用ウォレットは、あるアドレスが何を保有し、何をしてきたのかを見せてくれます——鍵を一切持つことなく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관전 전용 지갑은 키를 절대 보유하지 않으면서 어떤 주소가 무엇을 소유하고 어떤 작업을 했는지 보여줍니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik stebėjimo piniginė rodo, ką turi adresas ir ką jis atliko, niekada nelaikydama raktų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai novērošanas maks parāda, kas pieder adresei un ko tā ir darījusi, nekad neglabājot atslēgas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "watch-only വാലറ്റ് ഒരു വിലാസത്തിന് എന്താണ് ഉള്ളതെന്നും അത് എന്താണ് ചെയ്തിട്ടുള്ളതെന്നും നിങ്ങൾക്ക് കാണിക്കുന്നു — കീകൾ ഒരിക്കലും കൈവശം വയ്ക്കാതെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "watch-only वॉलेट तुम्हाला एका पत्त्याकडे काय आहे आणि त्याने काय केले आहे ते दाखवते — कीज् कधीही न ठेवता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet pantau-sahaja menunjukkan kepada anda apa yang dimiliki oleh sesuatu alamat dan apa yang telah dilakukannya — tanpa pernah menyimpan kunci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kun-vis-lommebok viser deg hva en adresse eier og hva den har gjort — uten noensinne å holde nøklene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een alleen-bekijken-wallet laat je zien wat een adres bezit en wat het heeft gedaan — zonder ooit de sleutels in handen te hebben."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼-ਵੇਖਣ ਵਾਲਾ ਵਾਲਿਟ ਤੁਹਾਨੂੰ ਦਿਖਾਉਂਦਾ ਹੈ ਕਿ ਇੱਕ ਪਤੇ ਕੋਲ ਕੀ ਹੈ ਅਤੇ ਉਸ ਨੇ ਕੀ ਕੀਤਾ ਹੈ — ਪਰ ਕਦੇ ਵੀ ਕੀਆਂ ਆਪਣੇ ਕੋਲ ਨਹੀਂ ਰੱਖਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel tylko do obserwacji pokazuje, co posiada dany adres i co już zrobił — nigdy nie przechowując kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma carteira somente-leitura mostra o que um endereço tem e o que ele fez — sem nunca guardar as chaves."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portofel doar pentru vizualizare îți arată ce deține o adresă și ce a făcut — fără să dețină vreodată cheile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелёк только для просмотра показывает, чем владеет адрес и что он делал, — не храня при этом никаких ключей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Peňaženka len na sledovanie ti ukazuje, čo adresa vlastní a čo robila — bez toho, aby kedy držala kľúče."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denarnica samo za ogled ti pokaže, kaj ima naslov in kaj je počel – ne da bi kdaj imela ključe."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Новчаник само за преглед ти показује шта адреса поседује и шта је чинила – а да никад не држи кључеве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En endast-läs-plånbok visar vad en adress äger och vad den har gjort — utan att någonsin hålla i nycklarna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi ya kuangalia tu inakuonyesha kile anwani inamiliki na kile imefanya — bila kushikilia funguo kamwe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "watch-only வாலட் ஒரு முகவரிக்கு என்ன சொந்தம், அது என்ன செய்திருக்கிறது என்பதைக் காட்டுகிறது — சாவிகளை வைத்திருக்காமலேயே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "watch-only వాలెట్ ఒక చిరునామా ఏమి కలిగి ఉందో మరియు ఏమి చేసిందో మీకు చూపిస్తుంది — కీలను ఎప్పుడూ ఉంచుకోకుండానే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าแบบดูอย่างเดียวจะแสดงสิ่งที่แอดเดรสถือครองและสิ่งที่แอดเดรสเคยทำ — โดยไม่เก็บคีย์ใด ๆ ไว้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca-izleme cüzdanı, anahtarları asla elinde tutmadan bir adresin nelere sahip olduğunu ve neler yaptığını size gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець «лише для перегляду» показує, що належить адресі і що вона робила — ніколи не зберігаючи ключів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف-دیکھنے والا والیٹ آپ کو دکھاتا ہے کہ ایک ایڈریس کے پاس کیا ہے اور اس نے کیا کیا ہے — کیز کو کبھی اپنے پاس رکھے بغیر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví chỉ để theo dõi cho bạn thấy một địa chỉ đang sở hữu gì và đã làm những gì — mà không bao giờ giữ các khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读钱包会告诉你某个地址拥有什么、做过什么——而无需持有任何密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀錢包會顯示某個位址擁有什麼、做過什麼——而不必持有任何金鑰。"
          }
        }
      }
    },
