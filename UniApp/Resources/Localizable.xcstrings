        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG മാത്രം \\u{00B7} മികച്ച ഫലങ്ങൾക്കായി ലളിതവും ഒറ്റ-ആകൃതിയും ആയി സൂക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त SVG \\u{00B7} सर्वोत्तम परिणामांसाठी ते साधे आणि एकल-आकाराचे ठेवा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ SVG \\u{00B7} ਵਧੀਆ ਨਤੀਜਿਆਂ ਲਈ ਇਸ ਨੂੰ ਸਧਾਰਨ ਅਤੇ ਇੱਕਲ-ਆਕਾਰ ਰੱਖੋ।"
          }
        }
      }
    },
