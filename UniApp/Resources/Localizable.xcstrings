        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque possède cette phrase peut prendre vos fonds. Aperture ne peut pas la récupérer à votre place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מי שיש לו את הביטוי הזה יכול לקחת את הכספים שלך. Aperture לא יכול לשחזר אותו עבורך."
