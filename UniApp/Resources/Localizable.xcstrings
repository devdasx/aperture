    "Does this look like the wallet you expected?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyk dit soos die beursie wat jy verwag het?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تبدو هذه هي المحفظة التي توقعتها؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ли изглежда като портфейла, който очакваше?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কি সেই ওয়ালেটের মতো দেখাচ্ছে যা আপনি আশা করেছিলেন?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et sembla aquesta la wallet que esperaves?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadá toto jako peněženka, kterou jste očekávali?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligner dette den wallet, du forventede?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieht das nach der Wallet aus, die du erwartet hast?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό μοιάζει με το πορτοφόλι που περιμένατε;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es esta la wallet que esperabas?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas see näeb välja nagu rahakott, mida ootasid?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیا این کیف‌پول همان است که انتظار داشتید؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko tämä lompakko, jota odotit?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukha ba itong wallet na inaasahan mo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Est-ce le portefeuille auquel vous vous attendiez ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם זה נראה כמו הארנק שציפית לו?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या यह वही वॉलेट है जिसकी आपने अपेक्षा की थी?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgleda li ovo kao novčanik koji si očekivao?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az a tárca, amelyre számítottál?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah ini terlihat seperti dompet yang kamu harapkan?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lítur þetta út eins og veskið sem þú bjóst við?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È questo il wallet che ti aspettavi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは期待していたウォレットですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 예상하신 지갑인가요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar tai atrodo kaip piniginė, kurios tikėjaisi?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai šis izskatās pēc maka, ko gaidīji?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ പ്രതീക്ഷിച്ച വാലറ്റ് പോലെ ഇത് കാണപ്പെടുന്നുണ്ടോ?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे तुम्ही अपेक्षित केलेल्या वॉलेटसारखे दिसते का?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah ini kelihatan seperti dompet yang anda jangkakan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser dette ut som lommeboken du forventet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijkt dit op de wallet die je verwachtte?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਇਹ ਉਹ ਵਾਲੇਟ ਜਾਪਦਾ ਹੈ ਜਿਸ ਦੀ ਤੁਸੀਂ ਉਮੀਦ ਕੀਤੀ ਸੀ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy to wygląda na portfel, którego się spodziewałeś?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a wallet que você esperava?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare acesta portofelul la care te așteptai?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это тот кошелёк, который вы ожидали?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyzerá to ako peňaženka, ktorú si očakával?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to denarnica, ki si jo pričakoval?"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Да ли ово изгледа као новчаник који си очекивао?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser detta ut som plånboken du förväntade dig?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Je, hii inaonekana kama pochi uliyotarajia?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது நீங்கள் எதிர்பார்த்த வாலெட்டாகத் தெரிகிறதா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మీరు ఆశించిన వాలెట్‌లా కనిపిస్తోందా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่ดูเหมือนกระเป๋าที่คุณคาดหวังไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, beklediğin cüzdana benziyor mu?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це гаманець, який ви очікували?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا یہ وہ والیٹ لگتا ہے جس کی آپ نے توقع کی تھی؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây có phải là ví bạn mong đợi không?"
