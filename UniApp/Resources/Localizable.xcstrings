    "There's no encrypted phrase stored for this wallet. If you saved it elsewhere, you're already its only copy.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Daar is geen geënkripteerde frase vir hierdie beursie gestoor nie. As jy dit elders bewaar het, is jy reeds die enigste kopie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عبارة مشفَّرة مخزَّنة لهذه المحفظة. إذا كنت قد حفظتها في مكان آخر، فأنت بالفعل النسخة الوحيدة منها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма съхранена шифрована фраза за този портфейл. Ако сте я записали другаде, вие вече сте единственото копие."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ওয়ালেটের জন্য কোনো এনক্রিপ্টেড ফ্রেজ সংরক্ষিত নেই। আপনি যদি এটি অন্য কোথাও সংরক্ষণ করে থাকেন, তবে আপনিই এর একমাত্র কপি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha cap frase xifrada emmagatzemada per a aquesta cartera. Si la vas guardar en un altre lloc, ja ets l'única còpia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tuto peněženku není uložena žádná šifrovaná fráze. Pokud jste si ji uložili jinde, jste již její jediná kopie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen krypteret frase gemt for denne wallet. Hvis du har gemt den et andet sted, er du allerede dens eneste kopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Wallet ist keine verschlüsselte Phrase gespeichert. Wenn Sie sie anderswo gesichert haben, sind Sie bereits die einzige Kopie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει αποθηκευτεί κρυπτογραφημένη φράση για αυτό το πορτοφόλι. Αν την έχετε αποθηκεύσει αλλού, είστε ήδη το μοναδικό αντίγραφο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no encrypted phrase stored for this wallet. If you saved it elsewhere, you're already its only copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna frase cifrada almacenada para esta billetera. Si la guardaste en otro lugar, ya eres su única copia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle rahakoti jaoks pole krüpteeritud fraasi salvestatud. Kui salvestasite selle mujale, olete juba ainus koopia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ عبارت رمزگذاری‌شده‌ای برای این کیف پول ذخیره نشده است. اگر آن را در جای دیگری ذخیره کرده‌اید، تنها نسخه شمایید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
