        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte i din adressbok — spara som en kontakt efter sändning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haipo kwenye kitabu chako cha anwani — ihifadhi kama mwasiliani baada ya kutuma."
