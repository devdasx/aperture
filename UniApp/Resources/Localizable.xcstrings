            "value": "Транзакциите, включващи %1$@ в %2$@, се появяват тук веднага щом бъдат потвърдени."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehingud, mis hõlmavad %1$@ võrgus %2$@, ilmuvad siia kohe, kui need kinnitatakse."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijos, susijusios su %1$@ tinkle %2$@, atsiranda čia, kai tik patvirtinamos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījumi, kas saistīti ar %1$@ tīklā %2$@, parādās šeit, tiklīdz tie tiek apstiprināti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Færslur sem varða %1$@ á %2$@ birtast hér um leið og þær staðfestast."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi yang melibatkan %1$@ pada %2$@ muncul di sini sebaik sahaja ia disahkan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumilitaw dito ang mga transaksyong kinasasangkutan ng %1$@ sa %2$@ sa sandaling makumpirma ang mga ito."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Miamala inayohusisha %1$@ kwenye %2$@ inaonekana hapa mara tu inapothibitishwa."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksies wat %1$@ op %2$@ behels, verskyn hier sodra hulle bevestig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இல் %1$@ சம்பந்தப்பட்ட பரிவர்த்தனைகள் உறுதியானவுடன் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ లో %1$@ సంబంధించిన లావాదేవీలు నిర్ధారించబడిన వెంటనే ఇక్కడ కనిపిస్తాయి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-ൽ %1$@ ഉൾപ്പെടുന്ന ഇടപാടുകൾ സ്ഥിരീകരിക്കുന്ന ഉടൻ ഇവിടെ ദൃശ്യമാകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ वर %1$@ समाविष्ट असलेले व्यवहार पुष्टी होताच येथे दिसतात."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ਉੱਤੇ %1$@ ਨਾਲ ਜੁੜੇ ਲੈਣ-ਦੇਣ ਜਿਵੇਂ ਹੀ ਉਹ ਪੁਸ਼ਟ ਹੁੰਦੇ ਹਨ ਇੱਥੇ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ।"
          }
        }
      }
    },
