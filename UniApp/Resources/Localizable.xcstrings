            "value": "कुछ स्वैप नहीं हुआ — आपका फ़ंड नहीं हटा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije zamijenjeno — vaša se sredstva nisu pomaknula."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem lett átváltva — a pénzed nem mozdult."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang ditukar — dana Anda tidak berpindah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engu var skipt — féð þitt hreyfðist ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato scambiato nulla — i tuoi fondi non si sono mossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何もスワップされていません — 資金は移動していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 스왑되지 않았습니다 — 자금이 이동하지 않았습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas nebuvo pakeista – jūsų lėšos nepajudėjo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas netika apmainīts — jūsu līdzekļi nepārvietojās."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും സ്വാപ്പ് ചെയ്തില്ല — നിങ്ങളുടെ ഫണ്ട് നീങ്ങിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही स्वॅप केले गेले नाही — तुमचा निधी हलला नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa ditukar — dana anda tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting ble byttet — midlene dine flyttet seg ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets gewisseld — je tegoed is niet verplaatst."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਸਵੈਪ ਨਹੀਂ ਕੀਤਾ ਗਿਆ — ਤੁਹਾਡੇ ਫੰਡ ਨਹੀਂ ਹਿੱਲੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie wymieniono — Twoje środki się nie ruszyły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi trocado — seus fundos não se moveram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu a fost schimbat — fondurile tale nu s-au mișcat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не обменяно — ваши средства остались на месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nebolo vymenené — vaše prostriedky sa nepohli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič ni bilo zamenjano — vaša sredstva se niso premaknila."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije zamenjeno — vaša sredstva se nisu pomerila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget byttes — dina medel flyttades inte."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kilichobadilishwa — fedha zako hazikuhama."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் ஸ்வாப் செய்யப்படவில்லை — உங்கள் நிதி நகரவில்லை."
          }
        },
        "te": {
