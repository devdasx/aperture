    },
    "The earlier recipients use your whole balance — nothing is left for this one.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vroeëre ontvangers gebruik jou hele balans — niks bly oor vir hierdie een nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم المستلمون السابقون كامل رصيدك — لم يبقَ شيء لهذا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По-ранните получатели използват целия ви баланс — за този не остава нищо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্বের প্রাপকরা আপনার পুরো ব্যালেন্স ব্যবহার করে — এটির জন্য কিছুই অবশিষ্ট নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els destinataris anteriors fan servir tot el teu saldo: no queda res per a aquest."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dřívější příjemci využijí celý váš zůstatek — na tohoto nezbývá nic."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De tidligere modtagere bruger hele din saldo — der er intet tilbage til denne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die früheren Empfänger nutzen dein gesamtes Guthaben – für diesen bleibt nichts übrig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προηγούμενοι παραλήπτες χρησιμοποιούν όλο το υπόλοιπό σας — δεν μένει τίποτα για αυτόν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The earlier recipients use your whole balance — nothing is left for this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los destinatarios anteriores usan todo tu saldo; no queda nada para este."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Varasemad saajad kasutavad kogu teie saldo — selle jaoks pole midagi alles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گیرندگان پیشین تمام موجودی شما را استفاده می‌کنند — چیزی برای این یکی باقی نمی‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiemmat vastaanottajat käyttävät koko saldosi — tälle ei jää mitään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ng mga naunang tatanggap ang buo mong balance — wala nang natitira para dito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les destinataires précédents utilisent tout votre solde — il ne reste rien pour celui-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנמענים הקודמים משתמשים בכל היתרה שלך — לא נשאר דבר עבור זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले के प्राप्तकर्ता आपका पूरा बैलेंस उपयोग करते हैं — इसके लिए कुछ नहीं बचा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raniji primatelji koriste cijelo vaše stanje — za ovoga ništa ne preostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korábbi címzettek felhasználják a teljes egyenleged — ennek nem marad semmi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerima sebelumnya menggunakan seluruh saldo Anda — tidak ada yang tersisa untuk yang satu ini."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyrri viðtakendurnir nota alla stöðuna þína — ekkert er eftir fyrir þennan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I destinatari precedenti usano tutto il tuo saldo — non rimane nulla per questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の受取人が残高をすべて使用するため、この受取人には何も残りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 받는 사람들이 전체 잔액을 사용하여 이 사람에게 남은 것이 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankstesni gavėjai išnaudoja visą jūsų balansą – šiam nieko nelieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepriekšējie saņēmēji izmanto visu jūsu bilanci — šim nekas neatliek."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നേരത്തെയുള്ള സ്വീകർത്താക്കൾ നിങ്ങളുടെ മുഴുവൻ ബാലൻസും ഉപയോഗിക്കുന്നു — ഇതിനായി ഒന്നും ശേഷിക്കുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आधीचे प्राप्तकर्ते तुमची संपूर्ण शिल्लक वापरतात — यासाठी काहीही उरले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerima terdahulu menggunakan keseluruhan baki anda — tiada apa-apa yang tinggal untuk yang ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De tidligere mottakerne bruker hele saldoen din — ingenting er igjen til denne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerdere ontvangers gebruiken je hele saldo — er blijft niets over voor deze."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਹਿਲੇ ਪ੍ਰਾਪਤਕਰਤਾ ਤੁਹਾਡੀ ਪੂਰੀ ਬਕਾਇਆ ਵਰਤਦੇ ਹਨ — ਇਸ ਲਈ ਕੁਝ ਨਹੀਂ ਬਚਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcześniejsi odbiorcy zużywają całe Twoje saldo — nic nie zostaje dla tego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os destinatários anteriores usam todo o seu saldo — não sobra nada para este."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatarii anteriori folosesc tot soldul tău — nu mai rămâne nimic pentru acesta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущие получатели используют весь ваш баланс — для этого ничего не осталось."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skorší príjemcovia využívajú celý váš zostatok — pre tohto nič nezostáva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejšnji prejemniki porabijo vse vaše stanje — za tega ne ostane nič."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raniji primaoci koriste celo vaše stanje — ništa nije preostalo za ovog."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De tidigare mottagarna använder hela ditt saldo — inget återstår för denna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wapokeaji wa awali wanatumia salio lako lote — hakuna kilichobaki kwa huyu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முந்தைய பெறுநர்கள் உங்கள் முழு இருப்பையும் பயன்படுத்துகிறார்கள் — இதற்கு எதுவும் மீதமில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మునుపటి స్వీకర్తలు మీ మొత్తం బ్యాలెన్స్‌ను ఉపయోగిస్తారు — దీని కోసం ఏమీ మిగలలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้รับก่อนหน้าใช้ยอดคงเหลือทั้งหมดของคุณ — ไม่เหลือสำหรับรายนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki alıcılar tüm bakiyenizi kullanıyor — bunun için hiçbir şey kalmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередні одержувачі використовують увесь ваш баланс — для цього нічого не залишилося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے والے وصول کنندگان آپ کا پورا بیلنس استعمال کر لیتے ہیں — اس کے لیے کچھ باقی نہیں بچتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những người nhận trước đó dùng hết số dư của bạn — không còn gì cho người này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的收款人已用掉你的全部余额——没有剩余可分配给此收款人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的收款人已用掉你的全部餘額——沒有剩餘可分配給此收款人。"
          }
        }
      }
    },
    "The key never leaves this iPhone. Aperture does not send it anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutel verlaat nooit hierdie iPhone nie. Aperture stuur dit nêrens nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغادر المفتاح هذا الـ iPhone أبداً. لا يرسله Aperture إلى أي مكان."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът никога не напуска този iPhone. Aperture не го изпраща никъде."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী কখনো এই iPhone ছেড়ে যায় না। Aperture এটিকে কোথাও পাঠায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La clau no surt mai d'aquest iPhone. Aperture no l'envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč nikdy neopustí tento iPhone. Aperture jej nikam neposílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøglen forlader aldrig denne iPhone. Aperture sender den ingen steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel verlässt dieses iPhone nie. Aperture sendet ihn nirgendwohin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί δεν φεύγει ποτέ από αυτό το iPhone. Το Aperture δεν το στέλνει πουθενά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave nunca sale de este iPhone. Aperture no la envía a ningún sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võti ei lahku sellest iPhone'ist kunagi. Aperture ei saada seda kuhugi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید هرگز این iPhone را ترک نمی‌کند. Aperture آن را به جایی ارسال نمی‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avain ei koskaan poistu tästä iPhonesta. Aperture ei lähetä sitä mihinkään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kailanman umaalis ang key sa iPhone na ito. Hindi ito ipinapadala ng Aperture kahit saan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé ne quitte jamais cet iPhone. Aperture ne l'envoie nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח לעולם לא יוצא מה‑iPhone הזה. Aperture לא שולח אותו לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी कभी इस iPhone से बाहर नहीं जाती। Aperture इसे कहीं नहीं भेजता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ nikad ne napušta ovaj iPhone. Aperture ga ne šalje nikamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcs soha nem hagyja el ezt az iPhone-t. Az Aperture sehova nem küldi el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tidak pernah meninggalkan iPhone ini. Aperture tidak mengirimnya ke mana pun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykillinn yfirgefur aldrei þennan iPhone. Aperture sendir hann ekki neitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave non esce mai da questo iPhone. Aperture non la invia da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこの iPhone から出ることはありません。Aperture はどこにも送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 iPhone을 떠나지 않습니다. Aperture는 어디로도 전송하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raktas niekada neišeina iš šio iPhone. Aperture jo niekur nesiunčia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atslēga nekad neatstāj šo iPhone. Aperture to nekur nesūta."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കീ ഒരിക്കലും ഈ iPhone-ൽ നിന്ന് പുറത്തുപോകില്ല. Aperture അത് എങ്ങും അയയ്ക്കുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "किल्ली कधीही या iPhone मधून बाहेर जात नाही. Aperture ती कुठेही पाठवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tidak pernah keluar dari iPhone ini. Aperture tidak menghantarnya ke mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelen forlater aldri denne iPhone-en. Aperture sender den ingen steder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel verlaat deze iPhone nooit. Aperture stuurt hem nergens heen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁੰਜੀ ਕਦੇ ਵੀ ਇਸ iPhone ਨੂੰ ਨਹੀਂ ਛੱਡਦੀ। Aperture ਇਸਨੂੰ ਕਿਤੇ ਨਹੀਂ ਭੇਜਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz nigdy nie opuszcza tego iPhone'a. Aperture nigdzie go nie wysyła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave nunca sai deste iPhone. O Aperture não a envia para lugar nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia nu părăsește niciodată acest iPhone. Aperture nu o trimite nicăieri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ никогда не покидает этот iPhone. Aperture никуда его не отправляет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč nikdy neopustí tento iPhone. Aperture ho nikam neposiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ nikoli ne zapusti tega iPhona. Aperture ga nikamor ne pošlje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Кључ никада не напушта овај iPhone. Aperture га не шаље нигде."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckeln lämnar aldrig denna iPhone. Aperture skickar den ingenstans."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufunguo haondoki kamwe kwenye iPhone hii. Aperture haitumi popote."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாவி ஒருபோதும் இந்த iPhone-ஐ விட்டு வெளியேறாது. Aperture அதை எங்கும் அனுப்பாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కీ ఈ iPhoneని ఎప్పుడూ వదిలి వెళ్ళదు. Aperture దానిని ఎక్కడికీ పంపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ไม่เคยออกจาก iPhone นี้ Aperture ไม่ส่งไปที่ไหนเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar bu iPhone'dan asla çıkmaz. Aperture hiçbir yere göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ ніколи не залишає цей iPhone. Aperture нікуди його не надсилає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید کبھی اس iPhone سے باہر نہیں جاتی۔ Aperture اسے کہیں نہیں بھیجتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa không bao giờ rời khỏi iPhone này. Aperture không gửi nó đi đâu cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥永远不会离开这台 iPhone。Aperture 不会将其发送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰永遠不會離開這台 iPhone。Aperture 不會將它傳送到任何地方。"
          }
        }
      }
    },
    "The local database couldn't be deleted. Nothing was removed — your wallets, seeds, and preferences are untouched. Try again.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die plaaslike databasis kon nie uitgevee word nie. Niks is verwyder nie — jou beursies, saadfrases en voorkeure is onaangeraak. Probeer weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف قاعدة البيانات المحلية. لم يُحذف شيء — محافظك ومفاتيح الاسترداد وتفضيلاتك سليمة. حاول مرة أخرى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Локалната база данни не можа да бъде изтрита. Нищо не беше премахнато — вашите портфейли, seed фрази и предпочитания остават непокътнати. Опитайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় ডেটাবেস মুছে ফেলা যায়নি। কিছুই সরানো হয়নি — আপনার ওয়ালেট, সিড এবং পছন্দ অক্ষত আছে। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut esborrar la base de dades local. No s’ha eliminat res: les teves carteres, llavors i preferències estan intactes. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní databázi se nepodařilo smazat. Nic nebylo odstraněno — vaše peněženky, seedy a předvolby zůstávají nedotčené. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale database kunne ikke slettes. Intet blev fjernet — dine wallets, seeds og indstillinger er urørte. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Datenbank konnte nicht gelöscht werden. Nichts wurde entfernt — deine Wallets, Seeds und Einstellungen sind unverändert. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η διαγραφή της τοπικής βάσης δεδομένων. Δεν αφαιρέθηκε τίποτα — τα πορτοφόλια, οι φράσεις seed και οι προτιμήσεις σας παραμένουν άθικτα. Δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar la base de datos local. No se ha eliminado nada: tus carteras, semillas y preferencias están intactas. Inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohalikku andmebaasi ei õnnestunud kustutada. Midagi ei eemaldatud — sinu rahakotid, seemnefraasid ja eelistused on puutumata. Proovi uuesti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمی‌توان پایگاه دادهٔ محلی را حذف کرد. چیزی حذف نشد — کیف پول‌ها، seedها و ترجیحات شما دست‌نخورده‌اند. دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallista tietokantaa ei voitu poistaa. Mitään ei poistettu — lompakkosi, siementen lauseet ja asetuksesi ovat ennallaan. Yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-delete ang lokal na database. Walang naalis — hindi nagalaw ang iyong mga wallet, seed, at kagustuhan. Subukan ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données locale n’a pas pu être supprimée. Rien n’a été retiré — vos portefeuilles, vos phrases et vos préférences sont intacts. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה למחוק את מסד הנתונים המקומי. שום דבר לא הוסר — הארנקים, ה־seeds וההעדפות שלך לא נגעו. אפשר לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय डेटाबेस नहीं हटाया जा सका। कुछ भी नहीं हटा — आपके वॉलेट, सीड और प्राथमिकताएँ ज्यों की त्यों हैं। फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalnu bazu nije bilo moguće obrisati. Ništa nije uklonjeno — vaši novčanici, seed fraze i postavke ostaju netaknuti. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi adatbázist nem sikerült törölni. Semmi nem lett eltávolítva — a tárcáid, seed-jeid és beállításaid érintetlenek. Próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Basis data lokal tidak dapat dihapus. Tidak ada yang dihapus — dompet, seed, dan preferensi Anda tetap utuh. Coba lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að eyða staðbundna gagnagrunninum. Engu var fjarlægt — veskin þín, sáðsetningar og kjörstillingar eru ósnert. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare il database locale. Nulla è stato rimosso — i suoi wallet, le sue seed e le sue preferenze sono intatti. Riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル・データベースを削除できませんでした。何も削除されておらず、ウォレット、シードフレーズ、設定はそのまま残っています。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터베이스를 삭제하지 못했어요. 제거된 것은 없어요 — 지갑, 시드, 설정은 그대로 남아 있어요. 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko ištrinti vietinės duomenų bazės. Niekas nebuvo pašalinta — jūsų piniginės, sėklos ir nuostatos liko nepaliestos. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietējo datubāzi neizdevās dzēst. Nekas netika noņemts — jūsu maki, sēklas frāzes un iestatījumi paliek neskarti. Mēģiniet vēlreiz."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോക്കൽ ഡാറ്റാബേസ് ഇല്ലാതാക്കാനായില്ല. ഒന്നും നീക്കം ചെയ്‌തിട്ടില്ല — നിങ്ങളുടെ വാലറ്റുകൾ, സീഡുകൾ, മുൻഗണനകൾ എന്നിവ അതേപടി നിലനിൽക്കുന്നു. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानिक डेटाबेस हटवता आला नाही. काहीही काढले गेले नाही — तुमची वॉलेट, सीड्स आणि प्राधान्ये अबाधित आहेत. पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pangkalan data setempat tidak dapat dipadamkan. Tiada apa-apa yang dialih keluar — dompet, benih dan keutamaan anda tidak tersentuh. Cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke slette den lokale databasen. Ingenting ble fjernet — lommebøkene, seed-frasene og preferansene dine er urørt. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale database kon niet worden verwijderd. Er is niets verwijderd — je wallets, seeds en voorkeuren blijven onaangetast. Probeer opnieuw."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਥਾਨਕ ਡਾਟਾਬੇਸ ਮਿਟਾਇਆ ਨਹੀਂ ਜਾ ਸਕਿਆ। ਕੁਝ ਵੀ ਹਟਾਇਆ ਨਹੀਂ ਗਿਆ — ਤੁਹਾਡੇ ਵਾਲਿਟ, ਸੀਡ ਅਤੇ ਪਸੰਦਾਂ ਅਛੂਤੇ ਹਨ। ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się usunąć lokalnej bazy danych. Nic nie usunięto — Twoje portfele, frazy seed i preferencje pozostały nietknięte. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível excluir o banco de dados local. Nada foi removido — suas carteiras, seeds e preferências estão intactas. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut șterge baza de date locală. Nimic nu a fost eliminat — portofelele, seed-urile și preferințele tale sunt neatinse. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить локальную базу. Ничего не удалено — ваши кошельки, seed-фразы и настройки не тронуты. Повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnu databázu sa nepodarilo odstrániť. Nič nebolo odstránené — vaše peňaženky, seed frázy a predvoľby sú nedotknuté. Skúste znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne baze ni bilo mogoče izbrisati. Nič ni bilo odstranjeno — vaše denarnice, seed fraze in nastavitve so nedotaknjene. Poskusite znova."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Локалну базу није било могуће обрисати. Ништа није уклоњено — ваши новчаници, seed фразе и подешавања остају нетакнути. Покушајте поново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att radera den lokala databasen. Inget togs bort — dina plånböcker, seeds och inställningar är orörda. Försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifadhidata ya ndani haikuweza kufutwa. Hakuna kilichoondolewa — pochi zako, mbegu na mapendeleo havikuguswa. Jaribu tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளக தரவுத்தளத்தை நீக்க முடியவில்லை. எதுவும் அகற்றப்படவில்லை — உங்கள் வாலெட்டுகள், விதைகள் மற்றும் விருப்பத்தேர்வுகள் தீண்டப்படாமல் உள்ளன. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థానిక డేటాబేస్‌ను తొలగించలేకపోయింది. ఏదీ తీసివేయబడలేదు — మీ వాలెట్‌లు, సీడ్‌లు మరియు ప్రాధాన్యతలు తాకబడలేదు. మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบฐานข้อมูลในเครื่องไม่ได้ ไม่มีสิ่งใดถูกลบ — กระเป๋าเงิน ซีด และค่ากำหนดของคุณยังคงอยู่ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel veritabanı silinemedi. Hiçbir şey kaldırılmadı — cüzdanlarınız, tohumlarınız ve tercihleriniz olduğu gibi duruyor. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося видалити локальну базу. Нічого не видалено — ваші гаманці, seed-фрази й налаштування недоторкані. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی ڈیٹابیس حذف نہیں ہو سکا۔ کچھ بھی نہیں ہٹایا گیا — آپ کے والیٹس، سیڈز اور ترجیحات بدستور برقرار ہیں۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xóa được cơ sở dữ liệu cục bộ. Không có gì bị gỡ bỏ — các ví, cụm từ gốc và tùy chọn của bạn vẫn nguyên vẹn. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除本地数据库。没有任何内容被移除 — 你的钱包、助记词和偏好设置完好无损。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除本機資料庫。沒有任何內容被移除 — 你的錢包、助記詞與偏好設定完好如初。請再試一次。"
          }
        }
      }
    },
    "The most the price can move before your swap is cancelled. Lower is safer; higher fills more often.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meeste wat die prys kan beweeg voordat jou omruil gekanselleer word. Laer is veiliger; hoër word meer dikwels gevul."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصى حد يمكن أن يتحرك به السعر قبل إلغاء مبادلتك. الأقل أكثر أمانًا؛ والأعلى يُنفَّذ أكثر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимумът, с който цената може да се промени, преди размяната ви да бъде отменена. По-ниско е по-безопасно; по-високо се изпълнява по-често."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সোয়াপ বাতিল হওয়ার আগে মূল্য সর্বোচ্চ যতটা সরতে পারে। কম হলে নিরাপদ; বেশি হলে আরও বেশিবার পূরণ হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El màxim que pot moure's el preu abans que es cancel·li el teu intercanvi. Més baix és més segur; més alt s'executa més sovint."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximální pohyb ceny, než se vaše směna zruší. Nižší je bezpečnější; vyšší se vyplní častěji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det meste, prisen kan bevæge sig, før dit bytte annulleres. Lavere er sikrere; højere udfyldes oftere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die maximale Preisbewegung, bevor dein Tausch abgebrochen wird. Niedriger ist sicherer; höher wird öfter ausgeführt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μέγιστη μεταβολή της τιμής πριν ακυρωθεί η ανταλλαγή σας. Το χαμηλότερο είναι ασφαλέστερο· το υψηλότερο εκτελείται συχνότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most the price can move before your swap is cancelled. Lower is safer; higher fills more often."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo máximo que el precio puede moverse antes de que se cancele tu intercambio. Más bajo es más seguro; más alto se completa con más frecuencia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimaalne hinnaliikumine, enne kui teie vahetus tühistatakse. Madalam on turvalisem; kõrgem täitub sagedamini."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیشترین مقداری که قیمت می‌تواند پیش از لغو تبدیل شما حرکت کند. کمتر امن‌تر است؛ بیشتر دفعات بیشتری انجام می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eniten, mitä hinta voi liikkua ennen kuin vaihtosi peruutetaan. Pienempi on turvallisempi; suurempi toteutuu useammin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pinakamarami na maaaring gumalaw ang presyo bago kanselahin ang iyong swap. Mas ligtas kapag mas mababa; mas madalas nagagampanan kapag mas mataas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mouvement de prix maximal avant l'annulation de votre échange. Plus bas est plus sûr ; plus haut s'exécute plus souvent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינוי המרבי של המחיר לפני שההמרה שלך מבוטלת. נמוך יותר בטוח יותר; גבוה יותר מתמלא לעיתים קרובות יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्वैप रद्द होने से पहले मूल्य अधिकतम कितना बदल सकता है। कम अधिक सुरक्षित है; अधिक अधिक बार भरता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše koliko se cijena može pomaknuti prije nego što se vaša zamjena otkaže. Niže je sigurnije; više se češće ispunjava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtöbb, amennyit az ár mozdulhat, mielőtt az átváltásod megszakad. Az alacsonyabb biztonságosabb; a magasabb gyakrabban teljesül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergerakan harga maksimum sebelum swap Anda dibatalkan. Lebih rendah lebih aman; lebih tinggi lebih sering terpenuhi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesta verðbreyting áður en skiptunum þínum er aflýst. Lægra er öruggara; hærra uppfyllist oftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il massimo che il prezzo può variare prima che il tuo swap venga annullato. Più basso è più sicuro; più alto si esegue più spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワップがキャンセルされるまでに価格が動ける最大幅です。低いほど安全で、高いほど成立しやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스왑이 취소되기 전에 가격이 움직일 수 있는 최대치입니다. 낮을수록 안전하고, 높을수록 더 자주 체결됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Didžiausias kainos pokytis, kol jūsų keitimas atšaukiamas. Mažesnis saugesnis; didesnis įvykdomas dažniau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimālā cenas izmaiņa, pirms jūsu apmaiņa tiek atcelta. Zemāka ir drošāka; augstāka izpildās biežāk."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സ്വാപ്പ് റദ്ദാക്കുന്നതിന് മുമ്പ് വിലയ്ക്ക് നീങ്ങാൻ കഴിയുന്ന പരമാവധി. കുറവ് സുരക്ഷിതമാണ്; കൂടുതൽ കൂടുതലായി പൂർത്തിയാകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा स्वॅप रद्द होण्यापूर्वी किंमत जास्तीत जास्त किती हलू शकते. कमी सुरक्षित आहे; जास्त असल्यास अधिक वेळा भरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergerakan harga paling banyak sebelum pertukaran anda dibatalkan. Lebih rendah lebih selamat; lebih tinggi lebih kerap dipenuhi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det meste prisen kan bevege seg før byttet ditt avbrytes. Lavere er tryggere; høyere fylles oftere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maximale dat de prijs kan bewegen voordat je swap wordt geannuleerd. Lager is veiliger; hoger wordt vaker uitgevoerd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਸਵੈਪ ਰੱਦ ਹੋਣ ਤੋਂ ਪਹਿਲਾਂ ਕੀਮਤ ਵੱਧ ਤੋਂ ਵੱਧ ਕਿੰਨੀ ਹਿੱਲ ਸਕਦੀ ਹੈ। ਘੱਟ ਜ਼ਿਆਦਾ ਸੁਰੱਖਿਅਤ ਹੈ; ਵੱਧ ਜ਼ਿਆਦਾ ਵਾਰ ਭਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalny ruch ceny, zanim Twoja wymiana zostanie anulowana. Niższy jest bezpieczniejszy, wyższy częściej się realizuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O máximo que o preço pode variar antes de sua troca ser cancelada. Menor é mais seguro; maior executa com mais frequência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult poate să se miște prețul înainte ca schimbul tău să fie anulat. Mai mic e mai sigur; mai mare se execută mai des."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальное изменение цены до отмены вашего обмена. Меньше — безопаснее; больше — чаще исполняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviac, o koľko sa môže cena pohnúť, kým sa vaša výmena zruší. Nižšie je bezpečnejšie; vyššie sa plní častejšie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Največ, kolikor se lahko cena premakne, preden se vaša zamenjava prekliče. Nižje je varnejše; višje se pogosteje izpolni."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše koliko cena može da se pomeri pre nego što se vaša zamena otkaže. Niže je sigurnije; više se češće izvršava."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det mesta priset kan röra sig innan ditt byte avbryts. Lägre är säkrare; högre fylls oftare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiwango cha juu zaidi bei inavyoweza kuhama kabla ubadilishaji wako kughairiwa. Chini ni salama zaidi; juu hutimizwa mara nyingi zaidi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஸ்வாப் ரத்துசெய்யப்படுவதற்கு முன் விலை நகரக்கூடிய அதிகபட்சம். குறைவானது பாதுகாப்பானது; அதிகமானது அடிக்கடி நிறைவடையும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ స్వాప్ రద్దు అయ్యే ముందు ధర కదలగల గరిష్టం. తక్కువది సురక్షితం; ఎక్కువది తరచుగా నింపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาเคลื่อนไหวได้มากที่สุดก่อนที่การสวอปของคุณจะถูกยกเลิก ต่ำกว่าปลอดภัยกว่า สูงกว่าจะสำเร็จบ่อยกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takasınız iptal edilmeden önce fiyatın hareket edebileceği maksimum miktar. Daha düşük daha güvenlidir; daha yüksek daha sık gerçekleşir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальна зміна ціни, перш ніж ваш обмін буде скасовано. Менше — безпечніше; більше — виконується частіше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے تبادلے کے منسوخ ہونے سے پہلے قیمت زیادہ سے زیادہ جتنی ہل سکتی ہے۔ کم محفوظ تر ہے؛ زیادہ زیادہ کثرت سے پوری ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức giá có thể biến động tối đa trước khi lượt hoán đổi của bạn bị hủy. Thấp hơn thì an toàn hơn; cao hơn thì khớp lệnh thường xuyên hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的兑换被取消之前价格可波动的最大幅度。越低越安全；越高越容易成交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的兌換被取消之前價格可波動的最大幅度。越低越安全；越高越容易成交。"
          }
        }
      }
    },
    "The network fee is displayed before you sign. No surprises after.": {
