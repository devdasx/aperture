          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ اصل جملہ چیک کریں جو آپ نے لکھا تھا — یہ لفظ کسی مختلف فہرست سے ہو سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra cụm từ gốc bạn đã ghi lại — từ này có thể thuộc danh sách từ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对你原本写下的短语——这个词可能来自不同的词表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請核對你原本寫下的片語——這個單字可能來自不同的詞表。"
          }
        }
      }
    },
    "Choose a 6-digit PIN. You'll use it to unlock Aperture and confirm transactions.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ʼn 6-syfer PIN. Jy sal dit gebruik om Aperture oop te sluit en transaksies te bevestig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر رمز PIN مكوّن من 6 أرقام. ستستخدمه لفتح Aperture وتأكيد المعاملات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете 6-цифрен PIN. Ще го използвате, за да отключите Aperture и да потвърждавате транзакции."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৬ অঙ্কের একটি PIN বেছে নিন। আপনি এটি Aperture আনলক করতে এবং লেনদেন নিশ্চিত করতে ব্যবহার করবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un PIN de 6 dígits. L’utilitzaràs per desbloquejar Aperture i confirmar transaccions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte 6místný PIN. Budete ho používat k odemknutí Aperture a potvrzení transakcí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en 6-cifret PIN. Du bruger den til at låse Aperture op og bekræfte transaktioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine 6-stellige PIN. Du verwendest sie, um Aperture zu entsperren und Transaktionen zu bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα 6ψήφιο PIN. Θα το χρησιμοποιείτε για να ξεκλειδώνετε το Aperture και να επιβεβαιώνετε συναλλαγές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un PIN de 6 dígitos. Lo usarás para desbloquear Aperture y confirmar transacciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali 6-kohaline PIN. Selle abil avad Aperture'i ja kinnitad tehinguid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک PIN ۶ رقمی انتخاب کنید. از آن برای باز کردن قفل Aperture و تأیید تراکنش‌ها استفاده خواهید کرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse 6-numeroinen PIN-koodi. Käytät sitä Aperturen avaamiseen ja tapahtumien vahvistamiseen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng 6-digit na PIN. Gagamitin mo ito para i-unlock ang Aperture at kumpirmahin ang mga transaksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un code PIN à 6 chiffres. Vous l’utiliserez pour déverrouiller Aperture et confirmer les transactions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר קוד PIN בן 6 ספרות. תשתמש בו לפתיחת Aperture ולאישור עסקאות."
          }
