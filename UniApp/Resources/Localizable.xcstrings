    "Test mode verifies balance reads only. Exit to see real activity for your wallet.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsmodus verifieer slegs saldo-lesings. Verlaat om jou beursie se werklike aktiwiteit te sien."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏يتحقق وضع الاختبار من قراءات الرصيد فقط. اخرج لرؤية النشاط الفعلي لمحفظتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестовият режим проверява само разчитането на баланса. Излезте, за да видите реалната активност на портфейла си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরীক্ষা মোড শুধু ব্যালেন্স রিড যাচাই করে। আপনার ওয়ালেটের প্রকৃত কার্যকলাপ দেখতে বেরিয়ে আসুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El mode de prova només verifica les lectures de saldo. Sortiu-ne per veure l'activitat real de la vostra cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Testovací režim ověřuje pouze čtení zůstatků. Ukončete jej a uvidíte skutečnou aktivitu své peněženky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Testtilstand verificerer kun saldolæsninger. Afslut for at se den faktiske aktivitet i din pung."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Testmodus überprüft nur das Lesen von Guthaben. Beenden Sie ihn, um die echte Aktivität Ihrer Wallet zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λειτουργία δοκιμής επαληθεύει μόνο την ανάγνωση υπολοίπου. Εξέλθετε για να δείτε την πραγματική δραστηριότητα του πορτοφολιού σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test mode verifies balance reads only. Exit to see real activity for your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de prueba solo verifica las lecturas de saldo. Sal del modo para ver la actividad real de tu cartera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Testrežiim kontrollib ainult saldo lugemist. Väljuge, et näha rahakoti tegelikku tegevust."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏حالت آزمایشی فقط خواندن موجودی را تأیید می‌کند. برای دیدن فعالیت واقعی کیف‌پول خود از این حالت خارج شوید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testitila vahvistaa vain saldojen luvun. Poistu nähdäksesi lompakkosi todellisen toiminnan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Vine-verify ng test mode ang pagbabasa ng balanse lamang. Lumabas para makita ang tunay na aktibidad ng iyong wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode test ne vérifie que la lecture des soldes. Quittez pour voir l'activité réelle de votre portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏מצב הבדיקה מאמת רק קריאות יתרה. צא כדי לראות את הפעילות האמיתית בארנק שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परीक्षण मोड केवल बैलेंस रीडिंग को सत्यापित करता है। अपने वॉलेट की वास्तविक गतिविधि देखने के लिए बाहर निकलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Način testiranja provjerava samo očitavanje stanja. Izađite kako biste vidjeli stvarnu aktivnost svog novčanika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tesztelési mód csak az egyenleg olvasását ellenőrzi. Lépjen ki, hogy lássa a tárcája valódi tevékenységét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode tes hanya memverifikasi pembacaan saldo. Keluar untuk melihat aktivitas nyata dompet Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Prufuhamur staðfestir aðeins lestur á stöðu. Hættu til að sjá raunverulega virkni veskisins þíns."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità test verifica solo la lettura del saldo. Esci per vedere l'attività reale del tuo wallet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストモードでは残高の読み取りのみを検証します。実際の取引履歴を見るには終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트 모드는 잔액 조회만 검증합니다. 지갑의 실제 활동을 보려면 종료하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandymo režimas patikrina tik likučio nuskaitymą. Išeikite, kad pamatytumėte tikrąją piniginės veiklą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārbaudes režīms pārbauda tikai atlikuma nolasīšanu. Iziet, lai redzētu maciņa patieso darbību."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടെസ്റ്റ് മോഡ് ബാലൻസ് വായനകൾ മാത്രമേ പരിശോധിക്കൂ. നിങ്ങളുടെ വാലറ്റിന്റെ യഥാർത്ഥ പ്രവർത്തനം കാണാൻ പുറത്തു കടക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चाचणी मोड फक्त शिल्लक वाचन तपासते. तुमच्या वॉलेटची खरी क्रियाकलाप पाहण्यासाठी बाहेर पडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod ujian hanya mengesahkan bacaan baki. Keluar untuk melihat aktiviti sebenar dompet anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testmodus verifiserer kun saldoavlesninger. Avslutt for å se den faktiske aktiviteten i lommeboken din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testmodus verifieert alleen het uitlezen van saldo's. Sluit af om de echte activiteit van je wallet te zien."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟੈਸਟ ਮੋਡ ਸਿਰਫ਼ ਬਕਾਏ ਪੜ੍ਹਨ ਦੀ ਪੁਸ਼ਟੀ ਕਰਦਾ ਹੈ। ਆਪਣੇ ਵਾਲਿਟ ਦੀ ਅਸਲ ਗਤੀਵਿਧੀ ਦੇਖਣ ਲਈ ਬਾਹਰ ਨਿਕਲੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb testowy weryfikuje tylko odczyt salda. Wyjdź, aby zobaczyć rzeczywistą aktywność swojego portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de teste verifica apenas as leituras de saldo. Saia para ver a atividade real da sua carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul de testare verifică doar citirea soldurilor. Ieșiți pentru a vedea activitatea reală a portofelului dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестовый режим проверяет только чтение балансов. Выйдите, чтобы увидеть реальную активность кошелька."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Testovací režim overuje len čítanie zostatkov. Ukončite ho a uvidíte skutočnú aktivitu svojej peňaženky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preizkusni način preverja samo branje stanja. Izhod prikaže pravo dejavnost vaše denarnice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим тестирања проверава само читање стања. Изађите да бисте видели стварну активност свог новчаника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testläge verifierar endast saldoavläsningar. Avsluta för att se den verkliga aktiviteten i din plånbok."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali ya majaribio inathibitisha tu kusoma kwa salio. Toka uone shughuli halisi ya pochi yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோதனை முறை இருப்பு வாசிப்புகளை மட்டுமே சரிபார்க்கிறது. உங்கள் வாலட்டின் உண்மையான செயல்பாட்டைக் காண வெளியேறவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టెస్ట్ మోడ్ కేవలం బ్యాలెన్స్ రీడింగ్‌లను మాత్రమే ధృవీకరిస్తుంది. మీ వాలెట్ యొక్క నిజమైన కార్యకలాపాన్ని చూడటానికి నిష్క్రమించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดทดสอบจะตรวจสอบเฉพาะการอ่านยอดคงเหลือ ออกเพื่อดูกิจกรรมจริงของกระเป๋าของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test modu yalnızca bakiye okumalarını doğrular. Cüzdanınızın gerçek etkinliğini görmek için çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестовий режим перевіряє лише читання балансу. Вийдіть, щоб побачити реальну активність гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏ٹیسٹ موڈ صرف بیلنس پڑھنے کی تصدیق کرتا ہے۔ اپنے بٹوے کی اصل سرگرمی دیکھنے کے لیے باہر نکلیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ thử chỉ kiểm tra việc đọc số dư. Thoát để xem hoạt động thực tế của ví bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试模式仅验证余额读取。退出后可查看你钱包的真实活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試模式僅驗證餘額讀取。退出後可查看你錢包的實際活動。"
          }
        }
      }
    },
