    "All of this is open source — see how recovery phrases are generated.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is alles oopbron — sien hoe herstelfrases gegenereer word."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل هذا مفتوح المصدر — اطّلع على كيفية إنشاء عبارات الاسترداد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко това е с отворен код — вижте как се генерират фразите за възстановяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সবই ওপেন সোর্স — দেখুন কীভাবে রিকভারি ফ্রেজ তৈরি হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot això és codi obert — mira com es generen les frases de recuperació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše je open source — podívejte se, jak se generují fráze pro obnovení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt dette er open source — se hvordan gendannelsessætninger genereres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "All das ist Open Source — sieh, wie Wiederherstellungsphrasen generiert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα αυτά είναι ανοιχτού κώδικα — δείτε πώς δημιουργούνται οι φράσεις ανάκτησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo esto es código abierto — mira cómo se generan las frases de recuperación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik see on avatud lähtekoodiga — vaata, kuidas taastefraase luuakse."
