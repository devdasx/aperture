        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súkromný kľúč je tajné číslo, ktoré ovláda jeden účet na jednej sieti. Zvyčajne vyzerá ako dlhý reťazec písmen a číslic."
          }
        },
        "sl": {
          "stringUnit": {
