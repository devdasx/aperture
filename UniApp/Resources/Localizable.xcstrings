          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Свако ко има ову фразу може узети ваша средства. Aperture не може да је врати уместо вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
