        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πορτοφόλια μόνο για παρακολούθηση βλέπουν υπόλοιπα και συναλλαγές στο %@. Δεν μπορούν να στείλουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las wallets de solo lectura ven saldos y transacciones en %@. No pueden enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult-vaatamise rahakotid näevad saldosid ja tehinguid %@ peal. Nad ei saa saata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف‌پول‌های فقط‌مشاهده مانده‌ها و تراکنش‌ها را روی %@ می‌بینند. نمی‌توانند ارسال کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain-katselu-lompakot näkevät %@-saldot ja -tapahtumat. Ne eivät voi lähettää."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakikita ng watch-only na mga wallet ang mga balanse at transaksyon sa %@. Hindi sila makapagpapadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les portefeuilles en lecture seule voient les soldes et les transactions sur %@. Ils ne peuvent pas envoyer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארנקים לצפייה בלבד רואים יתרות ועסקאות ב‑%@. הם לא יכולים לשלוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल-देखने वाले वॉलेट %@ पर शेष राशि और लेनदेन देखते हैं। वे भेज नहीं सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novčanici samo za pregled vide stanja i transakcije na %@. Ne mogu slati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csak megfigyelő tárcák a következő láncon látnak egyenlegeket és tranzakciókat: %@. Nem tudnak küldeni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet hanya-lihat melihat saldo dan transaksi di %@. Mereka tidak dapat mengirim."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins-skoða veski sjá stöður og færslur á %@. Þau geta ekki sent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I wallet di sola visualizzazione vedono saldi e transazioni su %@. Non possono inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧のみウォレットは %@ の残高とトランザクションを確認します。送信はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 지갑은 %@에서 잔액과 거래를 봅니다. 전송할 수는 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik stebėjimo piniginės mato likučius ir operacijas %@. Jos negali siųsti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai skatāmi maki redz bilances un darījumus %@. Tie nevar sūtīt."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാണൽ-മാത്രം വാലറ്റുകൾ %@-ൽ ബാലൻസുകളും ഇടപാടുകളും കാണുന്നു. അവയ്ക്ക് അയയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त-पाहण्यासाठीची वॉलेट्स %@ वर शिल्लक आणि व्यवहार पाहतात. ते पाठवू शकत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet pantau-sahaja melihat baki dan transaksi pada %@. Ia tidak boleh menghantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lommebøker kun for visning ser saldoer og transaksjoner på %@. De kan ikke sende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen-bekijken-wallets zien saldi en transacties op %@. Ze kunnen niet verzenden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੇਵਲ-ਦੇਖਣ ਵਾਲੇ ਵਾਲੇਟ %@ 'ਤੇ ਬੈਲੈਂਸ ਅਤੇ ਟ੍ਰਾਂਜੈਕਸ਼ਨਾਂ ਦੇਖਦੇ ਹਨ। ਉਹ ਨਹੀਂ ਭੇਜ ਸਕਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfele tylko do obserwacji widzą salda i transakcje na %@. Nie mogą wysyłać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallets somente leitura veem saldos e transações em %@. Não podem enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portofelele doar pentru vizualizare văd solduri și tranzacții pe %@. Nu pot trimite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошельки только для просмотра видят балансы и транзакции в %@. Они не могут отправлять."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Peňaženky len na sledovanie vidia zostatky a transakcie v %@. Nemôžu odosielať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denarnice samo za ogled vidijo stanja in transakcije v %@. Ne morejo pošiljati."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Новчаници само за преглед виде стања и трансакције на %@. Не могу слати."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plånböcker endast för visning ser saldon och transaktioner på %@. De kan inte skicka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi za kuangalia tu zinaona salio na miamala kwenye %@. Haziwezi kutuma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பார்வையிட மட்டும் வாலெட்கள் %@-இல் இருப்புகள் மற்றும் பரிவர்த்தனைகளைப் பார்க்கின்றன. அவை அனுப்ப முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వీక్షణ-మాత్రమే వాలెట్‌లు %@లో బ్యాలెన్స్‌లు మరియు లావాదేవీలను చూస్తాయి. అవి పంపలేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าแบบดูอย่างเดียวเห็นยอดคงเหลือและธุรกรรมบน %@ พวกเขาไม่สามารถส่งได้"
          }
