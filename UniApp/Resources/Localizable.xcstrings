        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณไม่ได้จดวลีกู้คืนไว้ กระเป๋าสตางค์ใด ๆ ที่คุณไม่ได้สำรองจะสูญหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma ifadelerinizi yazıya geçirmediyseniz, yedeklemediğiniz her cüzdan kaybolur."
