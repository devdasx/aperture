    "Sending transactions from the browser isn't available in Aperture yet. The request will be returned to the dApp unsigned.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om transaksies vanaf die blaaier te stuur is nog nie in Aperture beskikbaar nie. Die versoek sal ongeteken na die dApp teruggestuur word."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال المعاملات من المتصفّح غير متاح في Aperture بعد. سيُعاد الطلب إلى تطبيق dApp دون توقيع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпращането на транзакции от браузъра все още не е налично в Aperture. Заявката ще бъде върната на dApp неподписана."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-এ এখনও ব্রাউজার থেকে লেনদেন পাঠানো উপলব্ধ নেই। অনুরোধটি সাইন ছাড়াই dApp-এ ফেরত পাঠানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture encara no permet enviar transaccions des del navegador. La sol·licitud es retornarà a la dApp sense signar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílání transakcí z prohlížeče zatím v Aperture není dostupné. Požadavek bude vrácen dApp bez podpisu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At sende transaktioner fra browseren er endnu ikke muligt i Aperture. Anmodningen returneres til dAppen uden signatur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Senden von Transaktionen aus dem Browser ist in Aperture noch nicht verfügbar. Die Anfrage wird unsigniert an die dApp zurückgegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποστολή συναλλαγών από τον περιηγητή δεν είναι ακόμη διαθέσιμη στο Aperture. Το αίτημα θα επιστραφεί στο dApp χωρίς υπογραφή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture aún no permite enviar transacciones desde el navegador. La solicitud se devolverá a la dApp sin firmar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehingute saatmine brauserist pole Aperture'is veel saadaval. Päring tagastatakse dAppile allkirjastamata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسال تراکنش از مرورگر هنوز در Aperture در دسترس نیست. درخواست بدون امضا به dApp بازگردانده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumien lähettäminen selaimesta ei ole vielä saatavilla Aperturessa. Pyyntö palautetaan dApp:lle allekirjoittamattomana."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa available sa Aperture ang pagpapadala ng mga transaksyon mula sa browser. Ibabalik ang kahilingan sa dApp nang hindi naka-sign."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi de transactions depuis le navigateur n’est pas encore disponible dans Aperture. La demande sera renvoyée à la dApp non signée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליחת עסקאות מהדפדפן עדיין לא זמינה ב־Aperture. הבקשה תוחזר ל־dApp ללא חתימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture में अभी ब्राउज़र से लेनदेन भेजना उपलब्ध नहीं है। अनुरोध बिना साइन के dApp को लौटा दिया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slanje transakcija iz preglednika u Apertureu još nije dostupno. Zahtjev će biti vraćen dApp-u nepotpisan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A böngészőből történő tranzakcióküldés még nem érhető el az Aperture-ben. A kérést aláírás nélkül adjuk vissza a dApp-nak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim transaksi dari peramban belum tersedia di Aperture. Permintaan akan dikembalikan ke dApp tanpa ditandatangani."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Að senda færslur úr vafranum er ekki enn í boði í Aperture. Beiðnin verður skilað óundirritaðri til dApp-sins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invio di transazioni dal browser non è ancora disponibile in Aperture. La richiesta verrà restituita alla dApp non firmata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture では、ブラウザからのトランザクション送信はまだ利用できません。リクエストは署名されないまま dApp に返却されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 거래를 전송하는 기능은 아직 Aperture에서 제공되지 않아요. 요청은 서명되지 않은 채 dApp으로 반환돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijų siuntimas iš naršyklės Aperture dar negalimas. Užklausa bus grąžinta į dApp nepasirašyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījumu sūtīšana no pārlūka Aperture vēl nav pieejama. Pieprasījums tiks atgriezts dApp neparakstīts."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബ്രൗസറിൽ നിന്ന് ഇടപാടുകൾ അയയ്‌ക്കുന്നത് ഇതുവരെ Aperture-ൽ ലഭ്യമല്ല. അഭ്യർത്ഥന ഒപ്പിടാതെ dApp-ലേക്ക് തിരികെ നൽകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउझरवरून व्यवहार पाठवणे अद्याप Aperture मध्ये उपलब्ध नाही. विनंती स्वाक्षरीशिवाय dApp ला परत केली जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar transaksi daripada pelayar belum tersedia dalam Aperture. Permintaan akan dikembalikan kepada dApp tanpa ditandatangani."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sende transaksjoner fra nettleseren er ennå ikke tilgjengelig i Aperture. Forespørselen returneres til dAppen usignert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties verzenden vanuit de browser is nog niet beschikbaar in Aperture. Het verzoek wordt zonder ondertekening teruggestuurd naar de dApp."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬ੍ਰਾਊਜ਼ਰ ਤੋਂ ਲੈਣ-ਦੇਣ ਭੇਜਣਾ ਅਜੇ Aperture ਵਿੱਚ ਉਪਲਬਧ ਨਹੀਂ ਹੈ। ਬੇਨਤੀ ਬਿਨਾਂ ਦਸਤਖਤ ਦੇ dApp ਨੂੰ ਵਾਪਸ ਕੀਤੀ ਜਾਵੇਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłanie transakcji z przeglądarki nie jest jeszcze dostępne w Aperture. Żądanie zostanie zwrócone do dAppa bez podpisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar transações pelo navegador ainda não está disponível no Aperture. A solicitação será devolvida à dApp sem assinatura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiterea de tranzacții din browser nu este încă disponibilă în Aperture. Cererea va fi returnată dApp-ului nesemnată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Aperture отправка транзакций из браузера пока недоступна. Запрос будет возвращён в dApp без подписи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odosielanie transakcií z prehliadača zatiaľ nie je v Aperture dostupné. Žiadosť bude vrátená dApp bez podpisu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljanje transakcij iz brskalnika v Aperture še ni na voljo. Zahteva bo vrnjena dApp brez podpisa."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слање трансакција из прегледача још није доступно у Aperture-у. Захтев ће бити враћен dApp-у непотписан."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att skicka transaktioner från webbläsaren är ännu inte tillgängligt i Aperture. Begäran återlämnas till dAppen osignerad."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutuma miamala kutoka kwenye kivinjari bado hakupatikani katika Aperture. Ombi litarudishwa kwa dApp bila kutiwa saini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உலாவியிலிருந்து பரிவர்த்தனைகளை அனுப்புவது Aperture-இல் இன்னும் கிடைக்கவில்லை. கோரிக்கை கையொப்பமிடாமல் dApp-க்குத் திருப்பித் தரப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్రౌజర్ నుండి లావాదేవీలను పంపడం Aperture‌లో ఇంకా అందుబాటులో లేదు. అభ్యర్థన సంతకం లేకుండా dApp‌కు తిరిగి ఇవ్వబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งธุรกรรมจากเบราว์เซอร์ยังใช้ไม่ได้ใน Aperture คำขอจะถูกส่งกลับไปยัง dApp โดยไม่ลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıdan işlem gönderme henüz Aperture’da kullanılamıyor. İstek, imzalanmadan dApp’e geri döndürülecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання транзакцій із браузера в Aperture поки що недоступне. Запит буде повернуто в dApp без підпису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براؤزر سے لین دین بھیجنا Aperture میں ابھی دستیاب نہیں ہے۔ درخواست dApp کو بغیر دستخط کے واپس کر دی جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gửi giao dịch từ trình duyệt chưa khả dụng trong Aperture. Yêu cầu sẽ được trả lại cho dApp mà không được ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 暂不支持从浏览器发送交易。请求将以未签名状态返回给 dApp。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 尚未支援從瀏覽器傳送交易。請求將以未簽署狀態回傳給 dApp。"
          }
        }
      }
    },
