            "state": "translated",
            "value": "Ang mas mataas na slippage ay maaaring mangahulugan na kapansin-pansing mas kaunti ang matatanggap mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un glissement plus élevé peut signifier que vous recevez nettement moins."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלקה גבוהה יותר עשויה לגרום לך לקבל פחות באופן ניכר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिक स्लिपेज का मतलब हो सकता है कि आपको काफ़ी कम प्राप्त हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veće proklizavanje može značiti da primite znatno manje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb csúszás azt jelentheti, hogy észrevehetően kevesebbet kapsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage yang lebih tinggi bisa berarti Anda menerima jauh lebih sedikit."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hærri skekkjumörk geta þýtt að þú fáir umtalsvert minna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno slippage più alto può significare che ricevi sensibilmente meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリッページが大きいと、受け取る額が明らかに少なくなることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬리피지가 높으면 눈에 띄게 적게 받을 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Didesnis slydimas gali reikšti, kad gausite pastebimai mažiau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Augstāka slīde var nozīmēt, ka saņemsiet manāmi mazāk."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉയർന്ന സ്ലിപ്പേജ് അർത്ഥമാക്കുന്നത് നിങ്ങൾക്ക് ഗണ്യമായി കുറവ് ലഭിക്കാമെന്നാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जास्त स्लिपेजचा अर्थ तुम्हाला लक्षणीयरीत्या कमी मिळू शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelinciran yang lebih tinggi boleh bermakna anda menerima jauh lebih sedikit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyere slippage kan bety at du mottar merkbart mindre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogere slippage kan betekenen dat je merkbaar minder ontvangt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਧ ਸਲਿੱਪੇਜ ਦਾ ਮਤਲਬ ਹੋ ਸਕਦਾ ਹੈ ਕਿ ਤੁਹਾਨੂੰ ਕਾਫੀ ਘੱਟ ਮਿਲੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższy poślizg może oznaczać, że otrzymasz zauważalnie mniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma slippage maior pode fazer você receber bem menos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O alunecare mai mare poate însemna că primești considerabil mai puțin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большее проскальзывание может означать, что вы получите заметно меньше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyššie preklzávanie môže znamenať, že dostanete výrazne menej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Višji zdrs lahko pomeni, da prejmete opazno manj."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veći slip može značiti da primite primetno manje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre slippage kan innebära att du får märkbart mindre."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtelezo wa juu zaidi unaweza kumaanisha unapokea kidogo kwa kiasi kinachoonekana."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிக ஸ்லிப்பேஜ் என்றால் நீங்கள் கணிசமாகக் குறைவாகப் பெறலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎక్కువ స్లిప్పేజ్ అంటే మీరు గణనీయంగా తక్కువగా స్వీకరించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลิปเพจที่สูงกว่าอาจหมายความว่าคุณจะได้รับน้อยลงอย่างเห็นได้ชัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek kayma, gözle görülür şekilde daha az alacağınız anlamına gelebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вище проковзування може означати, що ви отримаєте помітно менше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سلیپیج کا مطلب ہو سکتا ہے کہ آپ نمایاں طور پر کم وصول کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt giá cao hơn có thể khiến bạn nhận được ít hơn rõ rệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑点越高，你收到的可能明显更少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑點越高，你收到的可能明顯更少。"
          }
        }
      }
    },
