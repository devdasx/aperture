        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যার কাছে এই ফ্রেজ থাকবে, সে আপনার অর্থ নিয়ে নিতে পারবে। Aperture এটি আপনার জন্য পুনরুদ্ধার করতে পারবে না।"
          }
        },
        "ca": {
