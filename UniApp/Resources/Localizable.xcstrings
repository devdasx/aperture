    "Tap Receive to see your address for each chain.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Ontvang om jou adres vir elke ketting te sien."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على استلام لرؤية عنوانك لكل سلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете Получи, за да видите адреса си за всяка верига."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি চেইনের জন্য আপনার ঠিকানা দেখতে গ্রহণ করুন এ ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Rep per veure la teva adreça a cada cadena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Přijmout pro zobrazení adresy pro každý řetězec."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Modtag for at se din adresse for hver kæde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Empfangen\", um deine Adresse für jede Chain zu sehen."
          }
        },
        "el": {
          "stringUnit": {
