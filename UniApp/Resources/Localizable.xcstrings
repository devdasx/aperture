        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சொற்றொடரை சேமித்துள்ளீர்கள் என்பதை உறுதிசெய்ய ஒவ்வொரு இடத்திலும் சரியான சொல்லைத் தேர்ந்தெடு."
          }
