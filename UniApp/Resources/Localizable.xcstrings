    "Aperture locks when this much time has passed in the background. Re-opening requires PIN or Face ID.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture sluit toe wanneer hierdie hoeveelheid tyd in die agtergrond verstryk het. Heropening vereis PIN of Face ID."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقفل Aperture بعد مرور هذه المدة في الخلفية. تتطلب إعادة فتحه رمز PIN أو Face ID."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture се заключва, когато това време изтече във фонов режим. Повторното отваряне изисква PIN или Face ID."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ডে এই সময় পেরিয়ে গেলে Aperture লক হয়ে যায়। আবার খুলতে PIN বা Face ID লাগবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture es bloqueja quan ha passat aquest temps en segon pla. Per tornar a obrir cal PIN o Face ID."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture se uzamkne, když na pozadí uplyne tato doba. K opětovnému otevření je potřeba PIN nebo Face ID."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture låses, når denne tid er gået i baggrunden. Genåbning kræver PIN eller Face ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture wird gesperrt, wenn diese Zeit im Hintergrund vergangen ist. Zum erneuten Öffnen sind PIN oder Face ID erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Aperture κλειδώνει αφού περάσει αυτός ο χρόνος στο παρασκήνιο. Το ξανά άνοιγμα απαιτεί PIN ή Face ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture locks when this much time has passed in the background. Re-opening requires PIN or Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture se bloquea cuando ha pasado este tiempo en segundo plano. Para reabrirlo se necesita PIN o Face ID."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture lukustub, kui see aeg on taustal möödunud. Uuesti avamiseks on vaja PIN-koodi või Face ID-d."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture وقتی این مدت در پس‌زمینه بگذرد قفل می‌شود. باز کردن مجدد به PIN یا Face ID نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture lukittuu, kun tämä aika on kulunut taustalla. Avaaminen vaatii PIN-koodin tai Face ID:n."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magla-lock ang Aperture kapag lumipas ang dami ng oras na ito sa background. Kailangan ng PIN o Face ID para muling buksan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture se verrouille lorsque ce délai s'est écoulé en arrière-plan. La réouverture nécessite le PIN ou Face ID."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ננעל לאחר שעובר זמן זה ברקע. פתיחה מחדש מחייבת PIN או Face ID."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture बैकग्राउंड में इतना समय बीतने पर लॉक हो जाता है। दोबारा खोलने के लिए PIN या Face ID चाहिए।"
