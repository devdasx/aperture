    "First time sending to this address. Double-check it's correct.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First time sending to this address. Double-check it's correct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la primera vez que envías a esta dirección. Comprueba que es correcta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次向此地址发送。请仔细核对是否正确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次向此位址傳送。請仔細核對是否正確。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पते पर पहली बार भेज रहे हैं। दोबारा जाँच लें कि यह सही है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه أول مرة تُرسل فيها إلى هذا العنوان. تحقّق من صحته."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeira vez enviando para este endereço. Confira se está correto."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঠিকানায় প্রথমবার পাঠাচ্ছেন। এটি সঠিক কিনা ভালো করে যাচাই করুন।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы впервые отправляете на этот адрес. Проверьте, что он верный."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスへの送信は初めてです。正しいかよく確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstmaliges Senden an diese Adresse. Prüfen Sie, ob sie korrekt ist."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вперше надсилаєте на цю адресу. Перевірте, що вона правильна."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρώτη φορά που στέλνετε σε αυτή τη διεύθυνση. Ελέγξτε ξανά ότι είναι σωστή."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiți pentru prima dată la această adresă. Verifică din nou că este corectă."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tuto adresu odesíláte poprvé. Zkontrolujte, že je správná."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most küld először erre a címre. Ellenőrizze újra, hogy helyes-e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första gången du skickar till den här adressen. Dubbelkolla att den är korrekt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første gang du sender til denne adressen. Dobbeltsjekk at den er riktig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Første gang du sender til denne adresse. Dobbelttjek, at den er korrekt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetät tähän osoitteeseen ensimmäistä kertaa. Tarkista, että se on oikein."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זו הפעם הראשונה שאתה שולח לכתובת הזו. בדוק שוב שהיא נכונה."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És el primer cop que envies a aquesta adreça. Comprova que sigui correcta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvi put šaljete na ovu adresu. Dvaput provjerite je li ispravna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na túto adresu posielate prvýkrát. Skontrolujte, či je správna."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ta naslov pošiljate prvič. Dvakrat preverite, ali je pravilen."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Први пут шаљете на ову адресу. Двапут проверите да ли је исправна."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premier envoi vers cette adresse. Vérifiez bien qu'elle est correcte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소로 처음 보내요. 올바른지 다시 확인하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È la prima volta che invia a questo indirizzo. Controlli bene che sia corretto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adrese ilk kez gönderiyorsunuz. Doğru olduğundan emin olun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đầu gửi đến địa chỉ này. Hãy kiểm tra kỹ xem đã đúng chưa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งไปยังที่อยู่นี้เป็นครั้งแรก ตรวจสอบให้แน่ใจว่าถูกต้อง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertama kali mengirim ke alamat ini. Periksa kembali apakah sudah benar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نخستین بار است که به این نشانی ارسال می‌کنید. درستی آن را به‌دقت بررسی کنید."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy raz wysyłasz na ten adres. Dokładnie sprawdź, czy jest poprawny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste keer dat je naar dit adres verzendt. Controleer goed of het klopt."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ایڈریس پر پہلی بار بھیج رہے ہیں۔ دوبارہ جانچ لیں کہ یہ درست ہے۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпращате за първи път до този адрес. Проверете внимателно дали е правилен."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saadad sellele aadressile esimest korda. Kontrolli üle, kas see on õige."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo adresu siunčiate pirmą kartą. Du kartus patikrinkite, ar jis teisingas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sūtāt uz šo adresi pirmo reizi. Vēlreiz pārbaudiet, vai tā ir pareiza."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú sendir á þetta vistfang í fyrsta sinn. Athugaðu vandlega hvort það sé rétt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kali pertama menghantar ke alamat ini. Semak semula sama ada ia betul."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Unang beses na magpapadala sa address na ito. Suriing mabuti kung tama ito."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mara ya kwanza kutuma kwa anwani hii. Hakiki kwamba ni sahihi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste keer dat jy na hierdie adres stuur. Kontroleer mooi of dit reg is."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த முகவரிக்கு முதல் முறையாக அனுப்புகிறீர்கள். அது சரியானதா என இருமுறை சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చిరునామాకు మొదటిసారి పంపుతున్నారు. ఇది సరైనదేనా అని రెండుసార్లు తనిఖీ చేయండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വിലാസത്തിലേക്ക് ആദ്യമായി അയയ്ക്കുന്നു. ഇത് ശരിയാണോ എന്ന് രണ്ടുതവണ പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या पत्त्यावर पहिल्यांदाच पाठवत आहात. तो बरोबर आहे का ते पुन्हा तपासा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਪਤੇ ਉੱਤੇ ਪਹਿਲੀ ਵਾਰ ਭੇਜ ਰਹੇ ਹੋ। ਦੁਬਾਰਾ ਜਾਂਚੋ ਕਿ ਇਹ ਸਹੀ ਹੈ।"
          }
        }
      }
    },
