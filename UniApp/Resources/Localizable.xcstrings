          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுக்குறியீட்டை முடக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాస్‌కోడ్‌ను నిలిపివేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดใช้รหัสผ่าน"
          }
        },
        "tr": {
