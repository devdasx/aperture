            "value": "Изменение количества слов создаёт новую фразу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena počtu slov vygeneruje novú frázu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprememba števila besed ustvari novo frazo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Промена броја речи генерише нову фразу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ändra antalet ord skapar en ny fras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubadilisha idadi ya maneno hutoa kifungu kipya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சொற்களின் எண்ணிக்கையை மாற்றுவது புதிய சொற்றொடரை உருவாக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పదాల సంఖ్యను మార్చడం కొత్త ఫ్రేజ్‌ను సృష్టిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนจำนวนคำจะสร้างวลีใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelime sayısını değiştirmek yeni bir ifade oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна кількості слів створить нову фразу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الفاظ کی تعداد بدلنے سے ایک نیا فریز بنتا ہے۔"
