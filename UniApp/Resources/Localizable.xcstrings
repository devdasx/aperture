            "value": "Kurtarma ifadenizi kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть фразу відновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا ریکوری فقرہ محفوظ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu cụm từ khôi phục của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你的助记词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你的助記詞。"
