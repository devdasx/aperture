        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع العبارة الأصلية التي دوّنتها — قد تكون هذه الكلمة من قائمة كلمات مختلفة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери оригиналната фраза, която си записал — тази дума може да е от друг списък с думи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে মূল বাক্যাংশটি লিখেছিলেন তা যাচাই করুন — এই শব্দটি ভিন্ন শব্দ-তালিকার হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova la frase original que vas anotar — aquesta paraula pot ser d'una altra llista de paraules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontroluj původní frázi, kterou sis poznamenal — toto slovo může být z jiného seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek den oprindelige sætning, du skrev ned — dette ord kan være fra en anden ordliste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe die ursprüngliche Phrase, die du notiert hast — dieses Wort stammt möglicherweise aus einer anderen Wortliste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε την αρχική φράση που σημείωσες — αυτή η λέξη μπορεί να προέρχεται από διαφορετική λίστα λέξεων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la frase original que anotaste — esta palabra puede ser de una lista distinta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli üles märgitud algset fraasi — see sõna võib pärineda mõnest teisest sõnaloendist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت اصلی که یادداشت کرده‌اید را بررسی کنید — این کلمه ممکن است از فهرست کلمات دیگری باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista muistiin kirjoittamasi alkuperäinen lause — tämä sana voi olla eri sanaluettelosta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin ang orihinal na pariralang isinulat mo — maaaring nagmula sa ibang listahan ng salita ang salitang ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie la phrase originale que tu as notée — ce mot peut provenir d'une autre liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את הביטוי המקורי שכתבת — ייתכן שמילה זו מגיעה מרשימת מילים אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो मूल वाक्यांश आपने लिखा था उसे जाँचें — यह शब्द किसी भिन्न शब्द-सूची का हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjeri izvornu frazu koju si zapisao — ova riječ možda potječe s drugog popisa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd a leírt eredeti kifejezést — ez a szó esetleg másik szólistából származik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa frasa asli yang Anda tulis — kata ini mungkin berasal dari daftar kata yang berbeda."
