        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വിലാസ പുസ്തകത്തിലില്ല — അയച്ചതിന് ശേഷം ഒരു കോൺടാക്റ്റായി സേവ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या पत्ता पुस्तिकेत नाही — पाठवल्यानंतर संपर्क म्हणून जतन करा."
