    "Only import a wallet that is yours.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer slegs ’n beursie in wat joune is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستورد سوى محفظة تخصّك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Внасяйте само портфейл, който е ваш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু সেই ওয়ালেটই ইম্পোর্ট করুন যা আপনার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa només una cartera que sigui teva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importujte pouze peněženku, která je skutečně vaše."
