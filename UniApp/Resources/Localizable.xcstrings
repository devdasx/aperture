          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوشیدہ نیٹ ورک معاون رہتے ہیں — صرف اس اثاثے کا نظارہ متاثر ہوتا ہے۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Скритите мрежи остават поддържани — засегнат е само изгледът на този актив."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peidetud võrgud jäävad toetatuks — mõjutatud on ainult selle vara vaade."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
