        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти слова — ваш кошелёк. Запишите их по порядку, ровно так, как показано."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto slová sú vaša peňaženka. Zapíšte si ich v poradí, presne ako sú zobrazené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te besede so vaša denarnica. Zapišite jih po vrsti, natanko kot so prikazane."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ове речи су ваш новчаник. Запишите их редом, тачно онако како су приказане."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här orden är din plånbok. Skriv ner dem i ordning, precis som de visas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maneno haya ndio pochi yako. Yaandike kwa mpangilio, kama yanavyoonyeshwa hasa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த சொற்களே உங்கள் பணப்பை. காட்டப்பட்டபடியே வரிசையில் எழுதிக்கொள்ளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పదాలే మీ వాలెట్. చూపిన విధంగానే వరుసలో రాసుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำเหล่านี้คือกระเป๋าของคุณ จดตามลำดับ ตรงตามที่แสดงทุกประการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kelimeler sizin cüzdanınızdır. Gösterildiği sırayla, tam olarak yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці слова — ваш гаманець. Запишіть їх по порядку, точно як показано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ الفاظ ہی آپ کا والٹ ہیں۔ انہیں اُسی ترتیب میں لکھیں، جیسا کہ دکھایا گیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những từ này là ví của bạn. Hãy ghi theo đúng thứ tự, chính xác như hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
