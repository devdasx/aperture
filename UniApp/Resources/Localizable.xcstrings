        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kifejezés titkosítva van az iPhone-od Kulcskarikájában, és sosem hagyja el ezt az eszközt. Ha elveszíted ezt az iPhone-t, és nincs írott másolatod, a pénz elveszett — írd le, és tartsd egy biztonságos helyen."
          }
