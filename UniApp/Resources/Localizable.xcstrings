    "Paste an ERC-20-style contract address. Aperture reads name, symbol, and decimals directly from the contract.": {
      "extractionState": "new",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألصق عنوان عقد بنمط ERC-20. تقرأ Aperture الاسم والرمز والكسور العشرية مباشرة من العقد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20-শৈলীর একটি কন্ট্রাক্ট ঠিকানা পেস্ট করুন। Aperture নাম, সিম্বল ও দশমিক সরাসরি কন্ট্রাক্ট থেকে পড়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enganxa una adreça de contracte d’estil ERC-20. Aperture llegeix el nom, el símbol i els decimals directament del contracte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte adresu kontraktu ve stylu ERC-20. Aperture čte název, symbol a desetinná místa přímo z kontraktu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt en kontraktadresse i ERC-20-stil. Aperture læser navn, symbol og decimaler direkte fra kontrakten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Vertragsadresse im ERC-20-Stil ein. Aperture liest Name, Symbol und Dezimalstellen direkt aus dem Vertrag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλήστε μια διεύθυνση συμβολαίου τύπου ERC-20. Το Aperture διαβάζει όνομα, σύμβολο και δεκαδικά απευθείας από το συμβόλαιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste an ERC-20-style contract address. Aperture reads name, symbol, and decimals directly from the contract."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una dirección de contrato tipo ERC-20. Aperture lee nombre, símbolo y decimales directamente desde el contrato."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک نشانی قرارداد به سبک ERC-20 بچسبانید. Aperture نام، نماد و رقم اعشار را مستقیماً از قرارداد می‌خواند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä ERC-20-tyylinen sopimusosoite. Aperture lukee nimen, symbolin ja desimaalit suoraan sopimuksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une adresse de contrat de type ERC-20. Aperture lit le nom, le symbole et les décimales directement depuis le contrat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להדביק כתובת חוזה בסגנון ERC-20. ‏Aperture קוראת את השם, הסמל ומספר העשרוניות ישירות מהחוזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20 शैली का कॉन्ट्रैक्ट पता पेस्ट करें। नाम, सिंबल और दशमलव Aperture सीधे कॉन्ट्रैक्ट से पढ़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepite adresu ugovora u ERC-20 stilu. Aperture čita naziv, simbol i decimale izravno iz ugovora."
          }
        },
        "hu": {
          "stringUnit": {
