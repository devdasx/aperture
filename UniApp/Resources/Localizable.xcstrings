        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-type ng URL para mag-navigate, o anumang search term para maghanap sa web."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika URL ili kusogeza, au neno lolote la utafutaji ili kutafuta kwenye wavuti."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik 'n URL om te navigeer, of enige soekterm om die web te deursoek."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழிசெலுத்த ஒரு URL-ஐயோ, அல்லது வலையில் தேட எந்தத் தேடற்சொல்லையோ உள்ளிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నావిగేట్ చేయడానికి ఒక URL ను, లేదా వెబ్‌లో శోధించడానికి ఏదైనా శోధన పదాన్ని నమోదు చేయండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നാവിഗേറ്റ് ചെയ്യാൻ ഒരു URL ടൈപ്പ് ചെയ്യുക, അല്ലെങ്കിൽ വെബ് തിരയാൻ ഏതെങ്കിലും തിരയൽ പദം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नेव्हिगेट करण्यासाठी URL टाइप करा, किंवा वेब शोधण्यासाठी कोणतीही शोध संज्ञा."
          }
        },
        "pa": {
