            "value": "یک یا چند آدرس یا یک کلید عمومی گسترش‌یافته برای %@ را بچسبانید. Aperture فقط موجودی و تراکنش‌ها را می‌خواند — توان ارسال ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä yksi tai useampi osoite tai laajennettu julkinen avain kohteelle %@. Aperture lukee vain saldoja ja tapahtumia — se ei voi lähettää."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-paste ang isa o higit pang address, o isang extended public key para sa %@. Binabasa lang ng Aperture ang mga balanse at transaksyon — hindi ito makakapagpadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une ou plusieurs adresses, ou une clé publique étendue pour %@. Aperture lit uniquement les soldes et les transactions — il ne peut pas envoyer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק כתובת אחת או יותר, או מפתח ציבורי מורחב עבור %@. Aperture קורא יתרות ועסקאות בלבד — הוא אינו יכול לשלוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक या अधिक पते, या %@ के लिए एक एक्सटेंडेड पब्लिक कुंजी पेस्ट करें। Aperture केवल शेष राशि और लेन-देन पढ़ता है — भेज नहीं सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepite jednu ili više adresa ili prošireni javni ključ za %@. Aperture čita samo stanja i transakcije — ne može slati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illessz be egy vagy több címet, vagy egy kiterjesztett nyilvános kulcsot a(z) %@-hoz. Az Aperture csak egyenlegeket és tranzakciókat olvas — nem tud küldeni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempelkan satu atau lebih alamat, atau sebuah kunci publik yang diperluas untuk %@. Aperture hanya membaca saldo dan transaksi — tidak dapat mengirim."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu inn eitt eða fleiri vistföng eða framlengdan opinberan lykil fyrir %@. Aperture les aðeins stöðu og færslur — getur ekki sent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla uno o più indirizzi, oppure una chiave pubblica estesa per %@. Aperture legge soltanto saldi e transazioni — non può inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ以上のアドレス、または %@ の拡張公開鍵を貼り付けてください。Aperture は残高と取引の読み取りだけを行い、送付はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대한 하나 이상의 주소, 또는 확장 공개 키를 붙여넣으세요. Aperture는 잔액과 거래만 읽으며 — 전송은 할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijuokite vieną ar daugiau adresų arba %@ skirtą išplėstinį viešąjį raktą. Aperture skaito tik likučius ir operacijas – siųsti negali."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielīmējiet vienu vai vairākas adreses vai paplašināto publisko atslēgu %@. Aperture lasa tikai bilances un darījumus — sūtīt nevar."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-നായി ഒന്നോ അതിലധികമോ വിലാസങ്ങൾ, അല്ലെങ്കിൽ ഒരു എക്സ്റ്റൻഡഡ് പബ്ലിക് കീ പേസ്റ്റ് ചെയ്യുക. Aperture ബാലൻസുകളും ഇടപാടുകളും മാത്രം വായിക്കുന്നു — അതിന് അയയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ साठी एक किंवा अधिक पत्ते, किंवा एक्सटेंडेड पब्लिक की पेस्ट करा. Aperture फक्त शिल्लक आणि व्यवहार वाचते — ते पाठवू शकत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal satu atau lebih alamat, atau kunci awam dilanjutkan untuk %@. Aperture hanya membaca baki dan transaksi — ia tidak boleh menghantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn en eller flere adresser, eller en utvidet offentlig nøkkel for %@. Aperture leser bare saldoer og transaksjoner — den kan ikke sende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een of meer adressen of een uitgebreide publieke sleutel voor %@. Aperture leest alleen saldi en transacties — hij kan niet versturen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਲਈ ਇੱਕ ਜਾਂ ਵੱਧ ਪਤੇ ਜਾਂ ਵਿਸਥਾਰਿਤ ਪਬਲਿਕ ਕੀ ਪੇਸਟ ਕਰੋ। Aperture ਸਿਰਫ਼ ਬੈਲੰਸ ਅਤੇ ਲੈਣ-ਦੇਣ ਪੜ੍ਹਦਾ ਹੈ — ਇਹ ਭੇਜ ਨਹੀਂ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej jeden lub więcej adresów albo rozszerzony klucz publiczny dla %@. Aperture odczytuje tylko salda i transakcje — nie może wysyłać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um ou mais endereços, ou uma chave pública estendida para %@. O Aperture só lê saldos e transações — não consegue enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește una sau mai multe adrese, sau o cheie publică extinsă pentru %@. Aperture citește doar solduri și tranzacții — nu poate trimite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте один или несколько адресов или расширенный публичный ключ для %@. Aperture только читает балансы и транзакции — отправлять он не умеет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlož jednu alebo viac adries, alebo rozšírený verejný kľúč pre %@. Aperture číta iba zostatky a transakcie — nedokáže odosielať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilepi enega ali več naslovov ali razširjeni javni ključ za %@. Aperture bere samo stanja in transakcije – ne more pošiljati."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налепи једну или више адреса или проширени јавни кључ за %@. Aperture чита само стања и трансакције – не може да шаље."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in en eller flera adresser, eller en utökad publik nyckel för %@. Aperture läser endast saldon och transaktioner — den kan inte skicka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandika anwani moja au zaidi, au ufunguo wa umma uliopanuliwa kwa ajili ya %@. Aperture inasoma salio na miamala pekee — haiwezi kutuma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-இற்கான ஒன்று அல்லது அதற்கு மேற்பட்ட முகவரிகளை, அல்லது நீட்டிக்கப்பட்ட பொதுச் சாவியை ஒட்டவும். Aperture இருப்புகளையும் பரிவர்த்தனைகளையும் மட்டுமே படிக்கிறது — அதனால் அனுப்ப முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కోసం ఒకటి లేదా అంతకంటే ఎక్కువ చిరునామాలను, లేదా ఎక్స్‌టెండెడ్ పబ్లిక్ కీని పేస్ట్ చేయండి. Aperture నిల్వలు మరియు లావాదేవీలను మాత్రమే చదువుతుంది — అది పంపలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางแอดเดรสหนึ่งรายการขึ้นไป หรือคีย์สาธารณะแบบขยายสำหรับ %@ Aperture จะอ่านยอดคงเหลือและธุรกรรมเท่านั้น — ไม่สามารถส่งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için bir veya daha fazla adres veya bir genişletilmiş genel anahtar yapıştırın. Aperture yalnızca bakiyeleri ve işlemleri okur — gönderim yapamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте одну або кілька адрес або розширений публічний ключ для %@. Aperture зчитує лише баланси й транзакції — він не може надсилати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کے لیے ایک یا زیادہ ایڈریسز یا کوئی توسیعی پبلک کی پیسٹ کریں۔ Aperture صرف بیلنس اور ٹرانزیکشنز پڑھتا ہے — یہ بھیج نہیں سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán một hoặc nhiều địa chỉ, hoặc một khóa công khai mở rộng cho %@. Aperture chỉ đọc số dư và giao dịch — không thể gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴一个或多个地址,或一个用于 %@ 的扩展公钥。Aperture 仅读取余额和交易——无法发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上一個或多個位址,或一個用於 %@ 的擴展公鑰。Aperture 只讀取餘額與交易——無法傳送。"
          }
        }
      }
    },
