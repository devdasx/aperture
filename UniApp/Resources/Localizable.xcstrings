        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਪੀ ਹੋ ਗਿਆ। ਕਲਿੱਪਬੋਰਡ 60 ਸਕਿੰਟਾਂ ਵਿੱਚ ਸਾਫ਼ ਹੋ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
