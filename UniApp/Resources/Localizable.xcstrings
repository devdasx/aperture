          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการใดผ่านการตรวจสอบสำหรับ \\(chain.displayName) แตะย้อนกลับและตรวจสอบที่อยู่หรือคีย์แต่ละรายการ"
