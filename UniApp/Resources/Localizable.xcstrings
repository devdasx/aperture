            "value": "Відкритий код"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپن سورس"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã nguồn mở"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源"
