    "Receive crypto on a network Aperture can swap on to get started.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang kripto op 'n netwerk waarop Aperture kan omruil om te begin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلم عملات مشفّرة على شبكة يمكن لـ Aperture المبادلة عليها للبدء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Получете крипто в мрежа, в която Aperture може да размени, за да започнете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে Aperture যে নেটওয়ার্কে সোয়াপ করতে পারে সেখানে ক্রিপ্টো গ্রহণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rep cripto en una xarxa on Aperture pugui intercanviar per començar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte tím, že přijmete kryptoměnu na síti, na které umí Aperture směňovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modtag krypto på et netværk, Aperture kan bytte på, for at komme i gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfange Krypto in einem Netzwerk, in dem Aperture tauschen kann, um zu starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβετε κρυπτονομίσματα σε ένα δίκτυο όπου το Aperture μπορεί να κάνει ανταλλαγές, για να ξεκινήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive crypto on a network Aperture can swap on to get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe cripto en una red donde Aperture pueda intercambiar para empezar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alustamiseks võtke krüpto vastu võrgus, milles Aperture saab vahetada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع، رمزارز را روی شبکه‌ای دریافت کنید که Aperture می‌تواند روی آن تبدیل کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita vastaanottamalla kryptoa verkossa, jossa Aperture voi vaihtaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumanggap ng crypto sa isang network na maaaring i-swap ng Aperture para magsimula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez des cryptos sur un réseau où Aperture peut échanger pour commencer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל קריפטו ברשת ש-Aperture יכול להמיר בה כדי להתחיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए ऐसे नेटवर्क पर क्रिप्टो प्राप्त करें जिस पर Aperture स्वैप कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primite kriptovalutu na mreži na kojoj Aperture može zamjenjivati za početak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az induláshoz fogadj kriptót egy olyan hálózaton, amelyen az Aperture tud átváltani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kripto di jaringan yang dapat ditukar Aperture untuk memulai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktu á móti rafmynt á neti sem Aperture getur skipt á til að byrja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi cripto su una rete su cui Aperture può effettuare swap per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture がスワップできるネットワークで暗号資産を受け取って始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 Aperture가 스왑할 수 있는 네트워크에서 암호화폐를 받으세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad pradėtumėte, gaukite kriptovaliutos tinkle, kuriame Aperture gali keisti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saņemiet kriptovalūtu tīklā, kurā Aperture var apmainīt, lai sāktu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരംഭിക്കാൻ Aperture-ന് സ്വാപ്പ് ചെയ്യാൻ കഴിയുന്ന ഒരു നെറ്റ്‌വർക്കിൽ ക്രിപ്റ്റോ സ്വീകരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरू करण्यासाठी Aperture स्वॅप करू शकेल अशा नेटवर्कवर क्रिप्टो प्राप्त करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kripto pada rangkaian yang boleh ditukar oleh Aperture untuk bermula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Motta krypto på et nettverk Aperture kan bytte på for å komme i gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang crypto op een netwerk waarop Aperture kan wisselen om te beginnen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਅਜਿਹੇ ਨੈੱਟਵਰਕ 'ਤੇ ਕ੍ਰਿਪਟੋ ਪ੍ਰਾਪਤ ਕਰੋ ਜਿਸ 'ਤੇ Aperture ਸਵੈਪ ਕਰ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbierz kryptowalutę w sieci, w której Aperture obsługuje wymianę, aby zacząć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba cripto em uma rede em que o Aperture possa trocar para começar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primește cripto pe o rețea pe care Aperture poate schimba, pentru a începe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите криптовалюту в сети, где Aperture может обменивать, чтобы начать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijmite kryptomenu v sieti, v ktorej môže Aperture vymieňať, aby ste začali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejmite kriptovaluto v omrežju, v katerem lahko Aperture zamenjuje, da začnete."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primite kriptovalute na mreži na kojoj Aperture može da menja da biste počeli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta emot krypto på ett nätverk som Aperture kan byta på för att komma igång."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokea crypto kwenye mtandao ambao Aperture inaweza kubadilisha ili kuanza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்க Aperture ஸ்வாப் செய்யக்கூடிய நெட்வொர்க்கில் கிரிப்டோவைப் பெறவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభించడానికి Aperture స్వాప్ చేయగల నెట్‌వర్క్‌లో క్రిప్టోను స్వీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับคริปโทบนเครือข่ายที่ Aperture สวอปได้เพื่อเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için Aperture'ın takas yapabileceği bir ağda kripto alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримайте криптовалюту в мережі, де Aperture може обмінювати, щоб почати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنے کے لیے کسی ایسے نیٹ ورک پر کرپٹو وصول کریں جس پر Aperture تبادلہ کر سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
