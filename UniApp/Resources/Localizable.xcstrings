            "value": "ఇక్కడికి మొదటిసారి పంపుతున్నారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งมาที่นี่เป็นครั้งแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya ilk gönderim"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перше надсилання сюди"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلی بار یہاں بھیج رہے ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đầu gửi tới đây"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次发送到此处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次傳送到此處"
          }
        }
      }
    },
    "First time sending here — double-check it, transactions can't be reversed.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste keer dat jy hierheen stuur — kontroleer dit dubbel, transaksies kan nie omgekeer word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإرسال هنا لأول مرة — تحقق منه مرتين، فالمعاملات لا يمكن عكسها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо изпращане тук — проверете внимателно, транзакциите не могат да бъдат отменени."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমবার এখানে পাঠানো হচ্ছে — ভালো করে যাচাই করুন, লেনদেন বাতিল করা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera vegada que envies aquí: comprova-ho bé, les transaccions no es poden revertir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První odeslání sem — pečlivě zkontrolujte, transakce nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Første gang du sender hertil — dobbelttjek det, transaktioner kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstes Senden hierher – prüfe es genau, Transaktionen können nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρώτη φορά αποστολή εδώ — ελέγξτε την ξανά, οι συναλλαγές δεν μπορούν να αναιρεθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First time sending here — double-check it, transactions can't be reversed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera vez que envías aquí: compruébalo dos veces, las transacciones no se pueden revertir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Esimene kord siia saatmas — kontrollige hoolikalt, tehinguid ei saa tagasi pöörata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نخستین بار ارسال به اینجا — آن را دوباره بررسی کنید، تراکنش‌ها قابل بازگشت نیستند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetät tänne ensimmäistä kertaa — tarkista vielä, tapahtumia ei voi perua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Unang beses magpadala dito — i-double-check ito, hindi maibabalik ang mga transaksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premier envoi ici — vérifiez bien, les transactions ne peuvent pas être annulées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח לכאן בפעם הראשונה — בדוק שוב, לא ניתן לבטל עסקאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ पहली बार भेज रहे हैं — इसे दोबारा जाँचें, ट्रांज़ैक्शन को उलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvi put šaljete ovamo — dvaput provjerite, transakcije se ne mogu poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először küldesz ide — ellenőrizd kétszer, a tranzakciók nem vonhatók vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertama kali mengirim ke sini — periksa kembali, transaksi tidak dapat dibatalkan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendir hingað í fyrsta skipti — athugaðu það tvisvar, ekki er hægt að afturkalla færslur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Primo invio qui — ricontrollalo, le transazioni non possono essere annullate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここへの送金は初めてです — よく確認してください。取引は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기로 처음 전송합니다 — 다시 한번 확인하세요. 거래는 되돌릴 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmą kartą siunčiate čia – patikrinkite dukart, operacijų atšaukti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmoreiz sūtāt šeit — pārbaudiet vēlreiz, transakcijas nevar atsaukt."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ ആദ്യമായി അയയ്ക്കുന്നു — ഇത് രണ്ടുതവണ പരിശോധിക്കുക, ഇടപാടുകൾ റിവേഴ്സ് ചെയ്യാനാവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "येथे प्रथमच पाठवत आहे — ते पुन्हा तपासा, व्यवहार परत करता येत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kali pertama menghantar ke sini — semak semula, transaksi tidak boleh diterbalikkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første gang du sender hit — dobbeltsjekk det, transaksjoner kan ikke reverseres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste keer hierheen verzenden — controleer het goed, transacties kunnen niet worden teruggedraaid."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਥੇ ਪਹਿਲੀ ਵਾਰ ਭੇਜ ਰਹੇ ਹੋ — ਇਸਨੂੰ ਦੁਬਾਰਾ ਜਾਂਚੋ, ਲੈਣ-ਦੇਣ ਵਾਪਸ ਨਹੀਂ ਕੀਤੇ ਜਾ ਸਕਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza wysyłka tutaj — sprawdź dokładnie, transakcji nie da się cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeira vez enviando aqui — verifique com atenção, transações não podem ser revertidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima trimitere aici — verifică de două ori, tranzacțiile nu pot fi anulate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая отправка сюда — перепроверьте адрес, транзакции нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvýkrát sem posielate — dvakrát to skontrolujte, transakcie sa nedajú vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvič pošiljate sem — dvakrat preverite, transakcij ni mogoče razveljaviti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvi put šaljete ovde — dvaput proverite, transakcije se ne mogu poništiti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första gången du skickar hit — dubbelkolla det, transaktioner kan inte ångras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mara ya kwanza kutuma hapa — ihakiki mara mbili, miamala haiwezi kutenguliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே முதல் முறையாக அனுப்புகிறீர்கள் — இருமுறை சரிபார்க்கவும், பரிவர்த்தனைகளைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడికి మొదటిసారి పంపుతున్నారు — దాన్ని రెండుసార్లు తనిఖీ చేయండి, లావాదేవీలను తిరిగి మార్చలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งมาที่นี่เป็นครั้งแรก — ตรวจสอบให้ดี ธุรกรรมไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya ilk gönderim — iki kez kontrol edin, işlemler geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перше надсилання сюди — перевірте ще раз, транзакції неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلی بار یہاں بھیج رہے ہیں — اسے دوبارہ چیک کریں، ٹرانزیکشنز واپس نہیں ہو سکتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đầu gửi tới đây — hãy kiểm tra kỹ, giao dịch không thể đảo ngược."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次发送到此处——请仔细核对，交易无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次傳送到此處——請仔細核對，交易無法復原。"
          }
        }
      }
    },
