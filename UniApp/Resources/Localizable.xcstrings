          "stringUnit": {
            "state": "translated",
            "value": "Nog geen wisselbare netwerken voor deze wallet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵਾਲਿਟ ਲਈ ਅਜੇ ਕੋਈ ਸਵੈਪ ਕਰਨ ਯੋਗ ਨੈੱਟਵਰਕ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak jeszcze sieci do wymiany dla tego portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há redes trocáveis para esta carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nicio rețea schimbabilă pentru acest portofel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого кошелька пока нет сетей для обмена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre túto peňaženku zatiaľ žiadne vymeniteľné siete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za to denarnico še ni omrežij za zamenjavo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još uvek nema zamenljivih mreža za ovaj novčanik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga bytbara nätverk för denna plånbok ännu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna mitandao inayoweza kubadilishwa kwa wallet hii bado."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வாலட்டிற்கு இன்னும் மாற்றக்கூடிய நெட்வொர்க்குகள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వాలెట్ కోసం ఇంకా మార్చదగిన నెట్‌వర్క్‌లు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีเครือข่ายที่สวอปได้สำหรับกระเป๋าเงินนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cüzdan için henüz takas edilebilir ağ yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього гаманця ще немає мереж для обміну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس والیٹ کے لیے ابھی تبادلے کے قابل کوئی نیٹ ورک نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có mạng nào có thể hoán đổi cho ví này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此钱包暂无可兑换的网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此錢包暫無可兌換的網路。"
          }
        }
      }
    },
    "No telemetry, no event tracking, no crash reports sent back to Aperture.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen telemetrie, geen gebeurtenis-opsporing, geen crash-verslae word terug na Aperture gestuur nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏لا قياس عن بُعد، ولا تتبع للأحداث، ولا تقارير أعطال تُرسل إلى Aperture."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без телеметрия, без проследяване на събития, без доклади за сривове, изпратени обратно към Aperture."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো টেলিমেট্রি নেই, কোনো ইভেন্ট ট্র্যাকিং নেই, Aperture-এ কোনো ক্র্যাশ রিপোর্ট পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense telemetria, sense seguiment d'esdeveniments, sense informes de fallida enviats a Aperture."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná telemetrie, žádné sledování událostí, žádné hlášení pádů odesílané do Aperture."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen telemetri, ingen hændelsesregistrering, ingen nedbrudsrapporter sendt til Aperture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Telemetrie, kein Event-Tracking, keine an Aperture gesendeten Absturzberichte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία τηλεμετρία, καμία παρακολούθηση συμβάντων, καμία αναφορά σφάλματος προς το Aperture."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No telemetry, no event tracking, no crash reports sent back to Aperture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin telemetría, sin seguimiento de eventos, sin informes de fallos enviados a Aperture."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitte mingit telemeetriat, sündmuste jälgimist ega tõrkearuandeid ei saadeta Aperture'ile tagasi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏هیچ تله‌متری، ردیابی رویداد، یا گزارش خرابی به Aperture ارسال نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei telemetriaa, ei tapahtumien seurantaa, ei Aperturelle lähetettyjä kaatumisraportteja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang telemetry, walang event tracking, walang crash report na ipinapadala pabalik sa Aperture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de télémétrie, pas de suivi d'événements, pas de rapports de crash envoyés à Aperture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏ללא טלמטריה, ללא מעקב אירועים, ללא דיווחי קריסה הנשלחים ל-Aperture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई टेलीमेट्री नहीं, कोई इवेंट ट्रैकिंग नहीं, Aperture को कोई क्रैश रिपोर्ट नहीं भेजी जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez telemetrije, bez praćenja događaja, bez izvješća o padovima poslanih u Aperture."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs telemetria, nincs eseménykövetés, nincs az Aperture-höz visszaküldött hibajelentés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa telemetri, tanpa pelacakan peristiwa, tanpa laporan crash yang dikirim kembali ke Aperture."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin fjarmæling, engin atburðatakk, engar hrunaskýrslur eru sendar til Aperture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna telemetria, nessun tracciamento eventi, nessun rapporto di crash inviato ad Aperture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テレメトリも、イベント追跡も、クラッシュレポートの Aperture への送信もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture로 전송되는 텔레메트리, 이벤트 추적, 크래시 보고서가 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokios telemetrijos, jokio įvykių sekimo, jokių strigčių pranešimų nesiunčiama atgal į Aperture."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekāda telemetrija, notikumu izsekošana vai avāriju ziņojumi netiek nosūtīti Aperture."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടെലിമെട്രി, ഇവന്റ് ട്രാക്കിംഗ്, ക്രാഷ് റിപ്പോർട്ടുകൾ എന്നിവ ഒന്നും Aperture-ലേക്ക് തിരികെ അയക്കുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणतीही टेलिमेट्री नाही, इव्हेंट ट्रॅकिंग नाही, क्रॅश अहवाल Aperture कडे परत पाठवले जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada telemetri, tiada penjejakan acara, tiada laporan ranap dihantar kembali ke Aperture."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen telemetri, ingen hendelsessporing, ingen krasjrapporter sendt til Aperture."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen telemetrie, geen event-tracking, geen crashrapporten naar Aperture verzonden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਟੈਲੀਮੈਟਰੀ, ਇਵੈਂਟ ਟਰੈਕਿੰਗ ਜਾਂ ਕਰੈਸ਼ ਰਿਪੋਰਟ Aperture ਨੂੰ ਵਾਪਸ ਨਹੀਂ ਭੇਜੀ ਜਾਂਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak telemetrii, brak śledzenia zdarzeń, brak raportów awarii wysyłanych do Aperture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem telemetria, sem rastreamento de eventos, sem relatórios de falhas enviados ao Aperture."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără telemetrie, fără urmărirea evenimentelor, fără rapoarte de blocare trimise către Aperture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакой телеметрии, никакого отслеживания событий, никаких отчётов о сбоях, отправляемых в Aperture."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadna telemetria, žiadne sledovanie udalostí, žiadne hlásenia o pádoch odosielané do Aperture."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez telemetrije, brez sledenja dogodkov, brez poročil o sesutju, poslanih nazaj Aperture."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без телеметрије, без праћења догађаја, без извештаја о паду који се шаљу Aperture-у."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen telemetri, ingen händelsespårning, inga kraschrapporter skickade till Aperture."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna telemetria, hakuna ufuatiliaji wa matukio, hakuna ripoti za kuanguka zinazotumwa kwa Aperture."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொலைஅளவீடு, நிகழ்வுக் கண்காணிப்பு அல்லது தடைஅறிக்கைகள் எதுவும் Aperture-க்குத் திருப்பி அனுப்பப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎటువంటి టెలిమెట్రీ, ఈవెంట్ ట్రాకింగ్, లేదా క్రాష్ నివేదికలు Aperture కు తిరిగి పంపబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการส่งข้อมูลการใช้งาน ไม่มีการติดตามอีเวนต์ ไม่มีรายงานข้อขัดข้องส่งกลับไปยัง Aperture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture'e geri gönderilen telemetri, etkinlik takibi veya çökme raporu yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодної телеметрії, відстеження подій чи звітів про збої, надісланих до Aperture."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏کوئی ٹیلی میٹری، ایونٹ ٹریکنگ، یا کریش رپورٹ Aperture کو واپس نہیں بھیجی جاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có telemetry, không có theo dõi sự kiện, không có báo cáo lỗi được gửi về Aperture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无遥测、无事件追踪、不向 Aperture 发送崩溃报告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無遙測、無事件追蹤、不向 Aperture 傳送當機報告。"
          }
        }
      }
    },
