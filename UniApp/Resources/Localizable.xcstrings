    "Switching modes discards your %lld rolls.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om die modus te wissel sal jou %lld rolle weggooi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبديل الوضع سيتجاهل %lld رميات سابقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Смяната на режима ще отхвърли твоите %lld хвърляния."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোড পরিবর্তন করলে আপনার %lld টি ছোঁড়া বাতিল হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar de mode descartarà les teves %lld tirades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepnutí režimu zahodí tvých %lld hodů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skifte tilstand kasserer dine %lld kast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Moduswechsel werden deine %lld Würfe verworfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή τρόπου απορρίπτει τις %lld ρίψεις σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de modo descartará tus %lld tiradas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Režiimi vahetamine tühistab sinu %lld viset."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر حالت %lld پرتاب قبلی تو را دور می‌اندازد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilan vaihtaminen hylkää %lld heittoasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagpapalit ng mode ay magtatapon ng %lld pukol mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de mode annulera tes %lld lancers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלפת מצב תבטל את %lld ההטלות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोड बदलने से आपकी %lld फेंक रद्द हो जाएँगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena načina odbacit će tvojih %lld bacanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mód váltása elveti az eddigi %lld dobásodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti mode akan membuang %lld lemparan kamu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Að skipta um stillingu hendir %lld köstunum þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare modalità scarterà i tuoi %lld tiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モードを切り替えると %lld 回の入力が破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드를 전환하면 %lld회의 입력이 사라집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitus režimą tavo %lld metimų bus atmesta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Režīma maiņa atmetīs tavus %lld metienus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോഡ് മാറ്റിയാൽ നിങ്ങളുടെ %lld ഉരുട്ടലുകൾ ഉപേക്ഷിക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोड बदलल्यास तुमच्या %lld टाकण्या रद्द होतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar mod akan membuang %lld lemparan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å bytte modus forkaster dine %lld kast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van modus wisselen verwerpt je %lld worpen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੋਡ ਬਦਲਣ ਨਾਲ ਤੁਹਾਡੀਆਂ %lld ਸੁੱਟਾਂ ਰੱਦ ਹੋ ਜਾਣਗੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana trybu odrzuci Twoje %lld rzutów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar de modo descartará suas %lld rolagens."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea modului va anula cele %lld aruncări ale tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена режима отменит ваши %lld бросков."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepnutie režimu zahodí tvojich %lld hodov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklop načina bo zavrgel tvojih %lld metov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Промена режима ће одбацити твојих %lld бацања."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att byta läge förkastar dina %lld kast."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubadilisha hali kutatupa marusho %lld yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்முறையை மாற்றினால் உங்கள் %lld உருட்டல்கள் கைவிடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోడ్ మార్చడం వలన మీ %lld దొర్లుళ్లు రద్దవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับโหมดจะทิ้งการทอย %lld ครั้งของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod değiştirmek %lld atışını iptal eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна режиму скасує ваші %lld кидків."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موڈ تبدیل کرنے سے آپ کی %lld پھینکیں ضائع ہو جائیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển chế độ sẽ bỏ %lld lần đổ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
