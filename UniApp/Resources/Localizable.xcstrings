    "Hello. You found the iris.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo. Jy het die iris gekry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا. لقد وجدت القزحية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Здравейте. Намерихте ириса."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যালো। আপনি আইরিসটি খুঁজে পেয়েছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola. Has trobat l'iris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj. Našel jsi clonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej. Du fandt iris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo. Du hast die Iris gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γεια. Βρήκατε την ίριδα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola. Has encontrado el iris."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tere. Te leidsite iirise."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سلام. عنبیه را پیدا کردید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei. Löysit irikseen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumusta. Natagpuan mo ang iris."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour. Vous avez trouvé l'iris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלום. מצאת את הקשתית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते। आपने आइरिस ढूँढ़ ली।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bok. Pronašli ste šarenicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
