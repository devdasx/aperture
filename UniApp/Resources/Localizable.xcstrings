    "All data lives on this iPhone. Aperture has no servers.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle data is op hierdie iPhone. Aperture het geen bedieners nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل البيانات تبقى على iPhone هذا. لا توجد لدى Aperture أي خوادم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички данни се намират на този iPhone. Aperture няма сървъри."
          }
        },
        "bn": {
