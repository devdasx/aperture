        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik SVG \\u{00B7} geriausiems rezultatams išlaikykite jį paprastą ir vienos formos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai SVG \\u{00B7} labākiem rezultātiem saglabājiet to vienkāršu un ar vienu formu."
          }
        },
        "is": {
