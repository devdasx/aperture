        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarınızı yapıştırın — Aperture sizden anahtarı karakter karakter yazmanızı asla istemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте ваш ключ — Aperture ніколи не просить вводити його символ за символом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی کی پیسٹ کریں — Aperture کبھی آپ سے اسے حرف بہ حرف ٹائپ کرنے کو نہیں کہتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dán khóa của bạn — Aperture không bao giờ yêu cầu bạn nhập từng ký tự."
