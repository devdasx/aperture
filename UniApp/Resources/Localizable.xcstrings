        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте mint-адресу токена SPL. Знаки після коми Aperture читає з mint, а назву й символ — із Metaplex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "SPL ٹوکن کا mint ایڈریس پیسٹ کریں۔ Aperture اعشاریے mint سے پڑھتا ہے اور نام + علامت Metaplex سے تلاش کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dán địa chỉ mint của token SPL. Aperture đọc số thập phân từ mint và tra cứu tên cùng ký hiệu từ Metaplex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴一个 SPL 代币的铸造地址。Aperture 会从 mint 读取精度,并在 Metaplex 查询名称与符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上一個 SPL 代幣的鑄造地址。Aperture 會從 mint 讀取小數位,並在 Metaplex 查詢名稱與符號。"
          }
        }
      }
    },
