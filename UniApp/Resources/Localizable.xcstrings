        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у вас нет записанных фраз восстановления, любой кошелёк без резервной копии будет утрачен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak nemáte frázy na obnovenie zapísané, každá peněženka bez zálohy bude stratená."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če nimate zapisanih obnovitvenih fraz, bo vsaka denarnica brez varnostne kopije izgubljena."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако немате записане фразе за опоравак, сваки новчаник без резервне копије биће изгубљен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du inte har skrivit ner dina återställningsfraser går alla plånböcker du inte har säkerhetskopierat förlorade."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kama hujaandika vifungu vyako vya kurejesha, pochi yoyote ambayo hujaihifadhi itapotea."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மீட்டெடுப்பு சொற்றொடர்களை எழுதி வைக்கவில்லை எனில், காப்பகப்படுத்தாத எந்த வாலட்டும் இழக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మీ రికవరీ పదబంధాలను రాసుకోకుంటే, మీరు బ్యాకప్ చేయని ఏ వాలెట్ అయినా కోల్పోతారు."
