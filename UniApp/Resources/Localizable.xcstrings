        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang pinakamataas na paggalaw ng presyo na tatanggapin mo. Mas ligtas kapag mas mababa; mas madalas nagagampanan kapag mas mataas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le mouvement de prix maximal que vous acceptez. Plus bas est plus sûr ; plus haut s'exécute plus souvent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את שינוי המחיר המרבי שתקבל. נמוך יותר בטוח יותר; גבוה יותר מתמלא לעיתים קרובות יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम मूल्य परिवर्तन दर्ज करें जिसे आप स्वीकार करेंगे। कम अधिक सुरक्षित है; अधिक अधिक बार भरता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite maksimalno kretanje cijene koje prihvaćate. Niže je sigurnije; više se češće ispunjava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a maximális ármozgást, amelyet elfogadsz. Az alacsonyabb biztonságosabb; a magasabb gyakrabban teljesül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan pergerakan harga maksimum yang Anda terima. Lebih rendah lebih aman; lebih tinggi lebih sering terpenuhi."
