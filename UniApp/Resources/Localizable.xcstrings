        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അത് നഷ്ടപ്പെട്ടാൽ, പണം പോയി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ती हरवली, की पैसे गेलेच."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda kehilangannya, dana hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mister du den, er midlene borte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je hem verliest, is het geld weg."
