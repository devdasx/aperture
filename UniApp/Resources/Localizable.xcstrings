    "Who can I send to?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan wie kan ek stuur?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى مَن يمكنني الإرسال؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На кого мога да изпратя?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি কাকে পাঠাতে পারি?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A qui puc enviar?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Komu mohu poslat?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem kan jeg sende til?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An wen kann ich senden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε ποιον μπορώ να στείλω;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can I send to?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A quién puedo enviar?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellele saan saata?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به چه کسی می‌توانم ارسال کنم؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenelle voin lähettää?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanino ako maaaring magpadala?"
