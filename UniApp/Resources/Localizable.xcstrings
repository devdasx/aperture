    "No website or support agent should ever ask for your recovery phrase.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen webwerf of ondersteuningsagent behoort ooit jou herstelfrase te vra nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ينبغي لأي موقع ويب أو وكيل دعم أن يطلب عبارة الاسترداد الخاصة بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никой уебсайт или агент за поддръжка не би трябвало да иска фразата ви за възстановяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ওয়েবসাইট বা সাপোর্ট এজেন্টের কখনও আপনার রিকভারি ফ্রেজ চাওয়া উচিত নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap lloc web ni agent d'assistència t'hauria de demanar mai la frase de recuperació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný web ani pracovník podpory by se vás nikdy neměl ptát na obnovovací frázi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet websted eller supportmedarbejder bør nogensinde bede om din gendannelsesfrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Website und kein Support-Agent darf jemals nach Ihrer Wiederherstellungsphrase fragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία ιστοσελίδα ή εκπρόσωπος υποστήριξης δεν πρέπει ποτέ να ζητήσει τη φράση ανάκτησής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No website or support agent should ever ask for your recovery phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún sitio web ni agente de soporte debería pedirte nunca tu frase de recuperación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ükski veebisait ega tugiisik ei tohiks kunagi küsida teie taastefraasi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ وب‌سایت یا کارشناس پشتیبانی نباید عبارت بازیابی شما را بخواهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään verkkosivusto tai tukihenkilö ei saa koskaan kysyä palautuslausettasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang website o support agent na dapat humingi ng inyong recovery phrase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun site web ni agent d'assistance ne devrait jamais vous demander votre phrase de récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אתר אינטרנט או נציג תמיכה לעולם לא יבקשו את ביטוי השחזור שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी वेबसाइट या सपोर्ट एजेंट को कभी आपका रिकवरी फ़्रेज़ नहीं माँगना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedna web-stranica ili agent podrške nikada ne bi smjeli tražiti vašu frazu za oporavak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen weboldal vagy ügyfélszolgálati munkatárs sem kérheti soha a helyreállítási kifejezését."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada situs web atau agen dukungan yang akan meminta frasa pemulihan Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin vefsíða eða þjónustufulltrúi ætti nokkurn tíma að biðja um endurheimtarsetninguna þína."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun sito web o agente di assistenza dovrebbe mai chiederle la frase di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブサイトやサポート担当者が復元フレーズを尋ねることは決してありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 웹사이트나 지원 담당자도 복구 문구를 요구하지 않아요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokia svetainė ar pagalbos atstovas neturėtų prašyti jūsų atkūrimo frazės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neviena tīmekļa vietne vai atbalsta pārstāvis nekad nedrīkst prasīt jūsu atkopšanas frāzi."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു വെബ്സൈറ്റോ സപ്പോർട്ട് ഏജന്റോ ഒരിക്കലും നിങ്ങളുടെ റിക്കവറി വാക്യം ചോദിക്കരുത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणतीही वेबसाइट किंवा सपोर्ट एजंट तुमचा रिकव्हरी फ्रेज मागू नये."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada laman web atau ejen sokongan yang sepatutnya meminta frasa pemulihan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nettsted eller kundeservicemedarbeider skal noensinne be om gjenopprettingsfrasen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele website of supportmedewerker zou ooit naar je herstelzin moeten vragen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਵੀ ਵੈੱਬਸਾਈਟ ਜਾਂ ਸਪੋਰਟ ਏਜੰਟ ਨੂੰ ਤੁਹਾਡਾ ਰਿਕਵਰੀ ਫ਼ਰੇਜ਼ ਨਹੀਂ ਮੰਗਣਾ ਚਾਹੀਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna strona internetowa ani pracownik wsparcia nie powinien prosić o Twoją frazę odzyskiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum site ou agente de suporte deve nunca pedir sua frase de recuperação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun site sau agent de asistență nu ar trebui să îți ceară vreodată fraza de recuperare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один сайт или агент поддержки никогда не должен запрашивать вашу фразу восстановления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadna webová stránka ani pracovník podpory by sa vás nikdy nemali pýtať na obnovovaciu frázu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobeno spletno mesto ali zastopnik podpore vas ne sme nikoli vprašati za obnovitveno frazo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниједан веб-сајт ни агент подршке никада не би требало да тражи вашу фразу за опоравак."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen webbplats eller supportagent ska någonsin fråga efter din återställningsfras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna tovuti au wakala wa msaada anayepaswa kuomba maneno yako ya kurejesha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த இணையதளமும் ஆதரவு முகவரும் உங்கள் மீட்பு சொற்றொடரைக் கேட்கக்கூடாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ వెబ్‌సైట్ లేదా సపోర్ట్ ఏజెంట్ మీ రికవరీ పదబంధాన్ని అడగకూడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเว็บไซต์หรือเจ้าหน้าที่สนับสนุนคนใดควรขอวลีกู้คืนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir web sitesi veya destek temsilcisi sizden kurtarma ifadenizi istemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден сайт чи агент підтримки ніколи не повинен запитувати вашу фразу відновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی ویب سائٹ یا سپورٹ ایجنٹ کو کبھی آپ کا ریکوری فقرہ نہیں مانگنا چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không trang web hay nhân viên hỗ trợ nào nên hỏi cụm từ khôi phục của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何网站或客服都不应向你索要恢复短语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何網站或客服都不應向你索要還原片語。"
          }
        }
      }
    },
    "Nobody from Aperture will ever message you. There is no Aperture support team. Treat any message claiming to be from Aperture as a scam.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand van Aperture sal jou ooit 'n boodskap stuur nie. Daar is geen Aperture-ondersteuningspan nie. Beskou enige boodskap wat beweer dat dit van Aperture kom as bedrog."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏لن يراسلك أحد من Aperture أبدًا. لا يوجد فريق دعم لـ Aperture. عامل أي رسالة تدّعي أنها من Aperture على أنها عملية احتيال."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никой от Aperture никога няма да ви пише. Няма екип за поддръжка на Aperture. Третирайте всяко съобщение, претендиращо да е от Aperture, като измама."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture থেকে কেউ আপনাকে কখনও বার্তা পাঠাবে না। Aperture-এর কোনো সাপোর্ট টিম নেই। Aperture থেকে আসা বলে দাবি করা যেকোনো বার্তাকে স্ক্যাম হিসেবে গণ্য করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningú d'Aperture us enviarà mai un missatge. No hi ha cap equip de suport d'Aperture. Tracteu qualsevol missatge que digui ser d'Aperture com una estafa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdo z Aperture vám nikdy nepošle zprávu. Aperture nemá podporu. Jakoukoli zprávu, která tvrdí, že pochází od Aperture, považujte za podvod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fra Aperture vil nogensinde sende dig en besked. Der findes ikke noget Aperture-supportteam. Behandl enhver besked, der hævder at være fra Aperture, som svindel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand von Aperture wird Sie jemals anschreiben. Es gibt kein Aperture-Support-Team. Behandeln Sie jede Nachricht, die angeblich von Aperture stammt, als Betrug."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς από το Aperture δεν θα σας στείλει ποτέ μήνυμα. Δεν υπάρχει ομάδα υποστήριξης Aperture. Αντιμετωπίστε κάθε μήνυμα που ισχυρίζεται ότι προέρχεται από το Aperture ως απάτη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody from Aperture will ever message you. There is no Aperture support team. Treat any message claiming to be from Aperture as a scam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie de Aperture te enviará mensajes nunca. No existe un equipo de soporte de Aperture. Trata cualquier mensaje que diga ser de Aperture como una estafa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitte keegi Aperture'ist ei kirjuta teile kunagi. Aperture'il pole klienditoe meeskonda. Käsitlege iga sõnumit, mis väidab end olevat Aperture'ist, kelmusena."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏هیچ‌کس از Aperture به شما پیام نخواهد داد. تیم پشتیبانی Aperture وجود ندارد. هر پیامی که ادعا کند از Aperture است را کلاهبرداری در نظر بگیرید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan Aperturesta ei koskaan ota sinuun yhteyttä. Aperturella ei ole asiakaspalvelutiimiä. Käsittele kaikkia Aperturen nimissä lähetettyjä viestejä huijauksena."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang kahit sinuman mula sa Aperture ang magpapadala sa iyo ng mensahe. Walang Aperture support team. Ituring na scam ang anumang mensaheng nag-aangking galing sa Aperture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne d'Aperture ne vous contactera jamais. Il n'existe aucune équipe d'assistance Aperture. Considérez tout message prétendant venir d'Aperture comme une arnaque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏אף אחד מ-Aperture לעולם לא ישלח לך הודעה. אין צוות תמיכה של Aperture. התייחס לכל הודעה הטוענת שהיא מ-Aperture כאל הונאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture से कोई भी आपको संदेश नहीं भेजेगा। Aperture की कोई सपोर्ट टीम नहीं है। Aperture से होने का दावा करने वाले किसी भी संदेश को घोटाला मानें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitko iz Aperturea nikada vam neće poslati poruku. Ne postoji Apertureov tim za podršku. Svaku poruku koja tvrdi da dolazi od Aperturea tretirajte kao prijevaru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture-től senki sem fog Önnek üzenetet küldeni. Az Aperture-nek nincs ügyfélszolgálati csapata. Minden olyan üzenetet, amely azt állítja, hogy az Aperture-től érkezik, tekintsen csalásnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak akan ada yang dari Aperture mengirim pesan kepada Anda. Tidak ada tim dukungan Aperture. Anggap semua pesan yang mengaku dari Aperture sebagai penipuan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Enginn frá Aperture mun nokkurn tímann senda þér skilaboð. Það er enginn Aperture stuðningshópur. Líttu á öll skilaboð sem segjast vera frá Aperture sem svindl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno di Aperture ti contatterà mai. Non esiste un team di assistenza Aperture. Considera qualsiasi messaggio che afferma di provenire da Aperture come una truffa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture からあなたにメッセージを送ることは決してありません。Aperture にはサポートチームはありません。Aperture を名乗るメッセージはすべて詐欺と見なしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture에서는 어떤 직원도 절대 메시지를 보내지 않습니다. Aperture 지원팀은 존재하지 않습니다. Aperture에서 보낸 것처럼 보이는 메시지는 모두 사기로 간주하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas iš Aperture niekada jums nerašys. Nėra jokios Aperture pagalbos komandos. Bet kokią žinutę, teigiančią, kad ji iš Aperture, laikykite sukčiavimu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neviens no Aperture jums nekad nesūtīs ziņojumu. Aperture nav atbalsta komandas. Uztveriet jebkuru ziņojumu, kas apgalvo, ka ir no Aperture, kā krāpniecību."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-ൽ നിന്ന് ആരും നിങ്ങൾക്ക് സന്ദേശം അയക്കില്ല. Aperture പിന്തുണാ ടീം എന്നൊന്നില്ല. Aperture-ൽ നിന്നുള്ളതാണെന്ന് അവകാശപ്പെടുന്ന ഏതൊരു സന്ദേശത്തെയും തട്ടിപ്പായി കണക്കാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture कडून कोणीही तुम्हाला कधीही संदेश पाठवणार नाही. Aperture चे कोणतेही समर्थन कार्यसंघ नाही. Aperture कडून आल्याचा दावा करणाऱ्या कोणत्याही संदेशाला फसवणूक समजा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada sesiapa daripada Aperture akan menghubungi anda. Tiada pasukan sokongan Aperture. Anggap mana-mana mesej yang mendakwa daripada Aperture sebagai penipuan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fra Aperture vil noensinne sende deg melding. Det finnes ikke et Aperture-støtteteam. Behandle enhver melding som hevder å være fra Aperture, som svindel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand van Aperture zal je ooit een bericht sturen. Er bestaat geen Aperture-supportteam. Behandel elk bericht dat beweert van Aperture te komen als oplichting."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ਤੋਂ ਕੋਈ ਵੀ ਤੁਹਾਨੂੰ ਕਦੇ ਸੁਨੇਹਾ ਨਹੀਂ ਭੇਜੇਗਾ। Aperture ਦੀ ਕੋਈ ਸਪੋਰਟ ਟੀਮ ਨਹੀਂ ਹੈ। Aperture ਤੋਂ ਹੋਣ ਦਾ ਦਾਅਵਾ ਕਰਨ ਵਾਲੇ ਕਿਸੇ ਵੀ ਸੁਨੇਹੇ ਨੂੰ ਧੋਖਾਧੜੀ ਸਮਝੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt z Aperture nigdy nie napisze do Ciebie. Nie istnieje zespół wsparcia Aperture. Każdą wiadomość podającą się za Aperture traktuj jako oszustwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém do Aperture jamais entrará em contato. Não existe equipe de suporte do Aperture. Trate qualquer mensagem que diga ser do Aperture como um golpe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeni de la Aperture nu vă va trimite vreodată un mesaj. Nu există echipă de asistență Aperture. Tratați orice mesaj care pretinde că este de la Aperture ca pe o înșelătorie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто из Aperture никогда не напишет вам. У Aperture нет службы поддержки. Любое сообщение, якобы от Aperture, считайте мошенничеством."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikto z Aperture vám nikdy nepošle správu. Aperture nemá tím podpory. Akúkoľvek správu, ktorá tvrdí, že pochádza od Aperture, považujte za podvod."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nihče iz Aperture vam ne bo nikoli poslal sporočila. Aperture nima ekipe za podporo. Vsa sporočila, ki trdijo, da prihajajo iz Aperture, obravnavajte kot prevaro."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нико из Aperture-а вам никада неће послати поруку. Не постоји Aperture тим за подршку. Сваку поруку која тврди да долази од Aperture-а третирајте као превару."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen från Aperture kommer någonsin att kontakta dig. Det finns inget Aperture-supportteam. Behandla varje meddelande som påstås komma från Aperture som bedrägeri."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna mtu yeyote kutoka Aperture atakayekutumia ujumbe. Hakuna timu ya msaada ya Aperture. Chukulia ujumbe wowote unaodai kuwa kutoka Aperture kama ulaghai."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-இல் இருந்து யாரும் உங்களுக்கு செய்தி அனுப்ப மாட்டார்கள். Aperture ஆதரவுக் குழு என்று எதுவும் இல்லை. Aperture-இல் இருந்து வந்ததாகக் கூறும் எந்த செய்தியையும் மோசடியாகக் கருதவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture నుండి ఎవరూ మీకు సందేశం పంపరు. Aperture సపోర్ట్ టీం అంటూ ఏదీ లేదు. Aperture నుండి వచ్చిందని క్లెయిమ్ చేసే ఏ సందేశాన్నైనా మోసంగా పరిగణించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีใครจาก Aperture จะส่งข้อความหาคุณ ไม่มีทีมสนับสนุนของ Aperture ให้ถือว่าข้อความใด ๆ ที่อ้างว่ามาจาก Aperture เป็นการหลอกลวง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture'den size asla kimse mesaj göndermez. Aperture destek ekibi diye bir şey yoktur. Aperture'den geldiğini iddia eden tüm mesajları dolandırıcılık olarak kabul edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніхто з Aperture ніколи не напише вам. У Aperture немає служби підтримки. Будь-яке повідомлення нібито від Aperture вважайте шахрайством."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Aperture سے کوئی بھی آپ کو پیغام نہیں بھیجے گا۔ Aperture کی کوئی سپورٹ ٹیم نہیں ہے۔ Aperture کے ہونے کا دعویٰ کرنے والے کسی بھی پیغام کو دھوکہ سمجھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ không có ai từ Aperture nhắn tin cho bạn. Aperture không có đội ngũ hỗ trợ. Hãy coi mọi tin nhắn tuyên bố đến từ Aperture là lừa đảo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 的人不会主动联系你。Aperture 没有支持团队。任何自称来自 Aperture 的消息都应视为诈骗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 的人不會主動聯絡你。Aperture 沒有支援團隊。任何自稱來自 Aperture 的訊息都應視為詐騙。"
          }
        }
      }
    },
