    "Per-asset URLs and licenses live in the project at Assets.xcassets/README.md — every shipped image has audit provenance recorded there.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "URL's en lisensies per bate is in die projek by Assets.xcassets/README.md — die herkoms wat geoudit kan word, is daar vir elke gestuurde beeld aangeteken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوفر روابط وتراخيص كل أصل في المشروع داخل Assets.xcassets/README.md — كل صورة منشورة لها مصدرها الموثّق هناك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "URL адресите и лицензите за всеки актив са в проекта в Assets.xcassets/README.md — за всяко изпратено изображение там е записан проследим източник."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি অ্যাসেটের URL ও লাইসেন্স প্রজেক্টের Assets.xcassets/README.md-এ আছে — শিপ করা প্রতিটি ছবির অডিট প্রভেন্যান্স সেখানে রেকর্ড করা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les URL i les llicències per recurs es troben al projecte a Assets.xcassets/README.md — cada imatge inclosa hi té la procedència auditable registrada."
          }
        },
        "cs": {
          "stringUnit": {
