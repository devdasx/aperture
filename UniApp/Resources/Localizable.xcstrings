        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही वाक्यरचना असलेला कोणीही तुमचा निधी घेऊ शकतो. Aperture तुमच्यासाठी ती परत मिळवू शकत नाही."
