            "state": "translated",
            "value": "Aperture にはサインアップも、メールアドレスも、パスワードもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture에는 가입, 이메일, 비밀번호가 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture neturi registracijos, el. pašto ar slaptažodžio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture nav reģistrēšanās, e-pasta vai paroles."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-ന് സൈൻ-അപ്, ഇമെയിൽ, പാസ്‌വേഡ് എന്നിവയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture मध्ये साइनअप, ईमेल किंवा पासवर्ड नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture tiada pendaftaran, e-mel atau kata laluan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture har ingen registrering, ingen e-post, intet passord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture heeft geen aanmelding, geen e-mailadres en geen wachtwoord."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ਵਿੱਚ ਕੋਈ ਸਾਈਨਅੱਪ, ਈਮੇਲ ਜਾਂ ਪਾਸਵਰਡ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture nie ma rejestracji, adresu e-mail ani hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Aperture não tem cadastro, e-mail nem senha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture nu are înregistrare, e-mail sau parolă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Aperture нет регистрации, электронной почты и пароля."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture nemá žiadnu registráciu, e-mail ani heslo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture nima registracije, e-pošte ali gesla."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture нема регистрацију, имејл ни лозинку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture har ingen registrering, ingen e-post, inget lösenord."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture haina usajili, barua pepe wala nenosiri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-இல் பதிவு, மின்னஞ்சல் அல்லது கடவுச்சொல் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture కు సైన్అప్ లేదు, ఇమెయిల్ లేదు, పాస్‌వర్డ్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ไม่มีการลงทะเบียน ไม่มีอีเมล ไม่มีรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture'de kayıt, e-posta veya parola yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture не має реєстрації, електронної пошти чи пароля."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Aperture میں نہ سائن اپ ہے، نہ ای میل، نہ پاس ورڈ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture không có đăng ký, email hay mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 没有注册、没有邮箱、没有密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 沒有註冊、沒有電子郵件、沒有密碼。"
          }
        }
      }
    },
    "Aperture imports keys locally. Nothing leaves this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture voer sleutels plaaslik in. Niks verlaat hierdie iPhone nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستورد Aperture المفاتيح محلياً. لا شيء يغادر هذا الـ iPhone."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture внася ключове локално. Нищо не напуска този iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture কী‑গুলি স্থানীয়ভাবে আমদানি করে। কিছুই এই iPhone ছেড়ে যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importa les claus localment. No surt res d'aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importuje klíče lokálně. Nic neopustí tento iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importerer nøgler lokalt. Intet forlader denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importiert Schlüssel lokal. Nichts verlässt dieses iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Aperture εισάγει τα κλειδιά τοπικά. Τίποτα δεν φεύγει από αυτό το iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importa las claves localmente. Nada sale de este iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture impordib võtmeid kohapeal. Miski ei lahku sellest iPhone'ist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture کلیدها را به‌صورت محلی وارد می‌کند. هیچ چیزی این iPhone را ترک نمی‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture tuo avaimet paikallisesti. Mikään ei poistu tästä iPhonesta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-iimport ang Aperture ng mga key nang lokal. Walang umaalis sa iPhone na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importe les clés localement. Rien ne quitte cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture מייבא מפתחות מקומית. שום דבר לא יוצא מה‑iPhone הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture कुंजियों को स्थानीय रूप से आयात करता है। कुछ भी इस iPhone से बाहर नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture uvozi ključeve lokalno. Ništa ne napušta ovaj iPhone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture helyileg importálja a kulcsokat. Semmi sem hagyja el ezt az iPhone-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture mengimpor kunci secara lokal. Tidak ada yang keluar dari iPhone ini."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture flytur inn lykla á staðnum. Ekkert yfirgefur þennan iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importa le chiavi localmente. Nulla esce da questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture はキーをローカルでインポートします。何もこの iPhone から出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture는 키를 로컬에서 가져옵니다. 이 iPhone에서 아무것도 나가지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importuoja raktus vietoje. Niekas neišeina iš šio iPhone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importē atslēgas lokāli. Nekas neatstāj šo iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture കീകൾ പ്രാദേശികമായി ഇറക്കുമതി ചെയ്യുന്നു. ഈ iPhone-ൽ നിന്ന് ഒന്നും പുറത്തുപോകുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture किल्ल्या स्थानिक पातळीवर आयात करते. काहीही या iPhone मधून बाहेर जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture mengimport kunci secara setempat. Tiada apa-apa keluar dari iPhone ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importerer nøkler lokalt. Ingenting forlater denne iPhone-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importeert sleutels lokaal. Niets verlaat deze iPhone."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ਕੁੰਜੀਆਂ ਨੂੰ ਸਥਾਨਕ ਤੌਰ 'ਤੇ ਆਯਾਤ ਕਰਦਾ ਹੈ। ਕੁਝ ਵੀ ਇਸ iPhone ਨੂੰ ਨਹੀਂ ਛੱਡਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importuje klucze lokalnie. Nic nie opuszcza tego iPhone'a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Aperture importa chaves localmente. Nada sai deste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importă cheile local. Nimic nu părăsește acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture импортирует ключи локально. Ничего не покидает этот iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importuje kľúče lokálne. Nič neopustí tento iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture uvozi ključe lokalno. Nič ne zapusti tega iPhona."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture увози кључеве локално. Ништа не напушта овај iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importerar nycklar lokalt. Inget lämnar denna iPhone."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture huingiza funguo kwa ndani. Hakuna kinachoondoka kwenye iPhone hii."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture சாவிகளை உள்ளூரில் இறக்குமதி செய்கிறது. எதுவும் இந்த iPhone-ஐ விட்டு வெளியேறாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture కీలను స్థానికంగా దిగుమతి చేస్తుంది. ఏదీ ఈ iPhoneని వదిలి వెళ్ళదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture นำเข้าคีย์ในเครื่อง ไม่มีอะไรออกจาก iPhone นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture anahtarları yerel olarak içe aktarır. Hiçbir şey bu iPhone'dan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture імпортує ключі локально. Нічого не залишає цей iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture کیز کو مقامی طور پر درآمد کرتا ہے۔ کچھ بھی اس iPhone سے باہر نہیں جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture nhập khóa cục bộ. Không có gì rời khỏi iPhone này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 在本地导入密钥。没有任何内容离开这台 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 在本機匯入金鑰。沒有任何資料離開這台 iPhone。"
          }
        }
      }
    },
    "Aperture is a wallet, and only a wallet. It lives on this iPhone, your keys live on this iPhone, and that is the entire arrangement.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture is ’n beursie, en net ’n beursie. Dit leef op hierdie iPhone, jou sleutels leef op hierdie iPhone, en dit is die hele afspraak."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture محفظة، ومحفظة فقط. تعيش على هذا الـ iPhone، ومفاتيحك تعيش على هذا الـ iPhone، وهذا هو الترتيب كله."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture е портфейл и само портфейл. Той живее на този iPhone, ключовете ви живеят на този iPhone, и това е цялото устройство."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture একটি ওয়ালেট, কেবল একটি ওয়ালেট। এটি এই iPhone-এ থাকে, আপনার কীগুলোও এই iPhone-এ থাকে, এবং পুরো ব্যবস্থাটা এটুকুই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture és una cartera, i només una cartera. Viu en aquest iPhone, les teves claus viuen en aquest iPhone, i aquest és tot l'acord."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture je peněženka a jen peněženka. Žije na tomto iPhonu, tvé klíče žijí na tomto iPhonu, a to je celé uspořádání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture er en tegnebog, og kun en tegnebog. Den bor på denne iPhone, dine nøgler bor på denne iPhone — og det er hele aftalen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ist eine Wallet, und nur eine Wallet. Sie lebt auf diesem iPhone, deine Schlüssel leben auf diesem iPhone, und das ist die ganze Abmachung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Aperture είναι ένα πορτοφόλι, και τίποτα άλλο. Ζει σε αυτό το iPhone, τα κλειδιά σας ζουν σε αυτό το iPhone, και αυτή είναι όλη η διευθέτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture es una cartera, y solo una cartera. Vive en este iPhone, tus claves viven en este iPhone, y ese es todo el acuerdo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture on rahakott ja ainult rahakott. See elab selles iPhone’is, teie võtmed elavad selles iPhone’is ja see ongi kogu kokkulepe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture یک کیف پول است، و فقط یک کیف پول. روی همین iPhone زندگی می‌کند، کلیدهای شما روی همین iPhone زندگی می‌کنند — و این تمام قرار است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture on lompakko, ja vain lompakko. Se asuu tällä iPhonella, avaimesi asuvat tällä iPhonella — ja se on koko järjestely."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Aperture ay isang wallet, at wallet lamang. Nakatira ito sa iPhone na ito, nakatira ang iyong mga susi sa iPhone na ito, at iyon na ang buong kasunduan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture est un portefeuille, et seulement un portefeuille. Il vit sur cet iPhone, vos clés vivent sur cet iPhone — c'est tout l'arrangement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture הוא ארנק, ורק ארנק. הוא חי על ה־iPhone הזה, המפתחות שלך חיים על ה־iPhone הזה — וזה כל ההסדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture एक वॉलेट है, और केवल एक वॉलेट है। यह इसी iPhone पर रहता है, आपकी कुंजियाँ भी इसी iPhone पर रहती हैं, और बस यही पूरी व्यवस्था है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture je novčanik, i samo novčanik. Živi na ovom iPhoneu, vaši ključevi žive na ovom iPhoneu — i to je cijeli aranžman."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture egy tárca, és csak egy tárca. Ezen az iPhone-on él, a kulcsaid ezen az iPhone-on élnek — és ez az egész elrendezés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture adalah dompet, dan hanya sebuah dompet. Ia hidup di iPhone ini, kunci-kuncimu hidup di iPhone ini — dan itulah seluruh kesepakatannya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture er veski og aðeins veski. Það býr í þessum iPhone, lyklarnir þínir búa í þessum iPhone, og það er allt fyrirkomulagið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture è un wallet, e soltanto un wallet. Vive su questo iPhone, le tue chiavi vivono su questo iPhone — ed è l'intero accordo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture はウォレットであり、ウォレットでしかありません。それはこの iPhone のなかに住み、あなたの鍵もこの iPhone のなかに住んでいる——取り決めはそれだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture는 지갑이며 오직 지갑일 뿐입니다. 이 iPhone 안에 살고, 당신의 키들도 이 iPhone 안에 살며 — 그것이 약속의 전부입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture yra piniginė ir tik piniginė. Ji gyvena šiame iPhone, jūsų raktai gyvena šiame iPhone, ir tai yra visa sutartis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ir maks un tikai maks. Tas mīt šajā iPhone, jūsu atslēgas mīt šajā iPhone, un tā ir visa vienošanās."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ഒരു വാലറ്റ് ആണ്, വാലറ്റ് മാത്രമാണ്. അത് ഈ iPhone-ൽ ജീവിക്കുന്നു, നിങ്ങളുടെ കീകൾ ഈ iPhone-ൽ ജീവിക്കുന്നു, അതാണ് മുഴുവൻ ക്രമീകരണവും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture एक वॉलेट आहे, आणि फक्त एक वॉलेट. ते या iPhone वर राहते, तुमच्या कीज् या iPhone वर राहतात, आणि ही संपूर्ण व्यवस्था आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ialah dompet, dan dompet sahaja. Ia tinggal di iPhone ini, kunci anda tinggal di iPhone ini, dan itu sahaja keseluruhan aturannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture er en lommebok, og bare en lommebok. Den bor på denne iPhonen, nøklene dine bor på denne iPhonen, og det er hele ordningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture is een wallet, en alleen een wallet. Hij woont op deze iPhone, jouw sleutels wonen op deze iPhone — en dat is de hele afspraak."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ਇੱਕ ਵਾਲਿਟ ਹੈ, ਅਤੇ ਸਿਰਫ਼ ਇੱਕ ਵਾਲਿਟ ਹੈ। ਇਹ ਇਸੇ iPhone ਉੱਤੇ ਰਹਿੰਦਾ ਹੈ, ਤੁਹਾਡੀਆਂ ਕੀਆਂ ਵੀ ਇਸੇ iPhone ਉੱਤੇ ਰਹਿੰਦੀਆਂ ਹਨ — ਅਤੇ ਪੂਰਾ ਪ੍ਰਬੰਧ ਇਹੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture jest portfelem — i tylko portfelem. Mieszka na tym iPhonie, twoje klucze mieszkają na tym iPhonie, i to całe porozumienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Aperture é uma carteira, e apenas uma carteira. Ele vive neste iPhone, suas chaves vivem neste iPhone, e esse é todo o arranjo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture este un portofel, și doar un portofel. Trăiește pe acest iPhone, cheile tale trăiesc pe acest iPhone, și asta este întreaga aranjare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture — это кошелёк, и только кошелёк. Он живёт на этом iPhone, ваши ключи живут на этом iPhone, и это всё устройство дела."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture je peňaženka a iba peňaženka. Žije na tomto iPhone, tvoje kľúče žijú na tomto iPhone — a to je celá dohoda."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture je denarnica in samo denarnica. Živi na tem iPhonu, tvoji ključi živijo na tem iPhonu, in to je ves dogovor."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture је новчаник, и само новчаник. Живи на овом iPhone-у, твоји кључеви живе на овом iPhone-у, и то је читав договор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture är en plånbok, och bara en plånbok. Den lever på den här iPhonen, dina nycklar lever på den här iPhonen, och det är hela arrangemanget."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ni pochi, na pochi tu. Inakaa kwenye iPhone hii, funguo zako zinakaa kwenye iPhone hii, na hilo ndilo mpango mzima."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ஒரு வாலட், வாலட் மட்டுமே. அது இந்த iPhone-இல் இருக்கிறது, உங்கள் சாவிகள் இந்த iPhone-இல் இருக்கின்றன, அவ்வளவுதான் முழு ஏற்பாடு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ఒక వాలెట్, వాలెట్ మాత్రమే. ఇది ఈ iPhone-లో ఉంటుంది, మీ కీలు ఈ iPhone-లో ఉంటాయి, మొత్తం ఏర్పాటు అదే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture เป็นกระเป๋าเงิน และเป็นเพียงกระเป๋าเงิน มันอาศัยอยู่บน iPhone เครื่องนี้ คีย์ของคุณอาศัยอยู่บน iPhone เครื่องนี้ — และนั่นคือข้อตกลงทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bir cüzdandır ve yalnızca bir cüzdandır. Bu iPhone'da yaşar, anahtarlarınız bu iPhone'da yaşar — ve tüm anlaşma bundan ibarettir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture — це гаманець, і лише гаманець. Він живе на цьому iPhone, ваші ключі живуть на цьому iPhone — і це вся домовленість."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ایک والیٹ ہے، اور صرف ایک والیٹ۔ یہ اسی iPhone پر رہتا ہے، آپ کی کیز اسی iPhone پر رہتی ہیں، اور بس یہی پورا انتظام ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture là một ví, và chỉ là một ví. Nó sống trên chiếc iPhone này, các khóa của bạn sống trên chiếc iPhone này — và đó là toàn bộ thỏa thuận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 是一个钱包,仅此而已。它就住在这部 iPhone 上,你的密钥也住在这部 iPhone 上,这就是全部的安排。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 是一個錢包,僅此而已。它就住在這部 iPhone 上,你的金鑰也住在這部 iPhone 上,這就是全部的安排。"
          }
        }
      }
    },
