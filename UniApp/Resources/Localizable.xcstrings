    "Submitted to the \\(executed.chain.displayName) network. Confirming may take a moment — check the explorer for the final result.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingedien by die \\(executed.chain.displayName)-netwerk. Bevestiging kan 'n oomblik neem — kontroleer die verkenner vir die finale resultaat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإرسال إلى شبكة \\(executed.chain.displayName). قد يستغرق التأكيد لحظة — تحقق من المستكشف للنتيجة النهائية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Подадено до мрежата \\(executed.chain.displayName). Потвърждаването може да отнеме момент — проверете експлоръра за крайния резултат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) নেটওয়ার্কে জমা দেওয়া হয়েছে। নিশ্চিত হতে কিছুক্ষণ লাগতে পারে — চূড়ান্ত ফলাফলের জন্য এক্সপ্লোরার দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviat a la xarxa \\(executed.chain.displayName). La confirmació pot trigar un moment: consulta l'explorador per al resultat final."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesláno do sítě \\(executed.chain.displayName). Potvrzení může chvíli trvat — konečný výsledek zkontrolujte v průzkumníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendt til \\(executed.chain.displayName)-netværket. Bekræftelse kan tage et øjeblik — tjek udforskeren for det endelige resultat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An das \\(executed.chain.displayName)-Netzwerk übermittelt. Die Bestätigung kann einen Moment dauern – prüfe das Endergebnis im Explorer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υποβλήθηκε στο δίκτυο \\(executed.chain.displayName). Η επιβεβαίωση μπορεί να πάρει λίγο — ελέγξτε τον explorer για το τελικό αποτέλεσμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted to the \\(executed.chain.displayName) network. Confirming may take a moment — check the explorer for the final result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado a la red \\(executed.chain.displayName). La confirmación puede tardar un momento; consulta el explorador para ver el resultado final."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Esitatud võrku \\(executed.chain.displayName). Kinnitamine võib võtta hetke — kontrollige plokiuurijast lõpptulemust."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به شبکه‌ی \\(executed.chain.displayName) ارسال شد. تأیید ممکن است لحظه‌ای طول بکشد — برای نتیجه‌ی نهایی اکسپلورر را بررسی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetetty verkkoon \\(executed.chain.displayName). Vahvistaminen voi kestää hetken — tarkista lopullinen tulos selaimesta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naisumite sa \\(executed.chain.displayName) network. Maaaring tumagal nang ilang sandali ang pagkumpirma — tingnan ang explorer para sa huling resulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soumis au réseau \\(executed.chain.displayName). La confirmation peut prendre un moment — consultez l'explorateur pour le résultat final."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשלח לרשת \\(executed.chain.displayName). האישור עשוי לקחת רגע — בדוק את הסייר לתוצאה הסופית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) नेटवर्क पर सबमिट किया गया। पुष्टि में कुछ समय लग सकता है — अंतिम परिणाम के लिए एक्सप्लोरर जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslano na mrežu \\(executed.chain.displayName). Potvrđivanje može potrajati trenutak — provjerite preglednik za konačni rezultat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beküldve a(z) \\(executed.chain.displayName) hálózatra. A megerősítés eltarthat egy pillanatig — a végeredményt ellenőrizd a böngészőben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikirim ke jaringan \\(executed.chain.displayName). Konfirmasi mungkin memerlukan waktu sejenak — periksa explorer untuk hasil akhir."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent inn á \\(executed.chain.displayName)-netið. Staðfesting getur tekið augnablik — athugaðu vafrann fyrir lokaniðurstöðuna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviata alla rete \\(executed.chain.displayName). La conferma può richiedere un momento — controlla l'explorer per il risultato finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) ネットワークに送信しました。承認には少し時間がかかることがあります — 最終結果はエクスプローラーで確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) 네트워크에 제출되었습니다. 확인에는 잠시 시간이 걸릴 수 있습니다 — 최종 결과는 익스플로러에서 확인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pateikta į \\(executed.chain.displayName) tinklą. Patvirtinimas gali užtrukti akimirką – galutinį rezultatą patikrinkite naršyklėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iesniegts \\(executed.chain.displayName) tīklā. Apstiprināšana var aizņemt brīdi — pārbaudiet pārlūkā galīgo rezultātu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) നെറ്റ്‌വർക്കിലേക്ക് സമർപ്പിച്ചു. സ്ഥിരീകരിക്കാൻ ഒരു നിമിഷമെടുത്തേക്കാം — അന്തിമ ഫലത്തിനായി എക്സ്പ്ലോറർ പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) नेटवर्कवर सबमिट केले. पुष्टी होण्यास क्षणभर लागू शकतो — अंतिम परिणामासाठी एक्सप्लोरर तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihantar ke rangkaian \\(executed.chain.displayName). Pengesahan mungkin mengambil masa sebentar — semak penjelajah untuk hasil akhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendt til \\(executed.chain.displayName)-nettverket. Bekreftelse kan ta et øyeblikk — sjekk utforskeren for det endelige resultatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingediend bij het \\(executed.chain.displayName)-netwerk. Bevestigen kan even duren — bekijk de explorer voor het eindresultaat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) ਨੈੱਟਵਰਕ 'ਤੇ ਜਮ੍ਹਾਂ ਕੀਤਾ। ਪੁਸ਼ਟੀ ਹੋਣ ਵਿੱਚ ਇੱਕ ਪਲ ਲੱਗ ਸਕਦਾ ਹੈ — ਅੰਤਿਮ ਨਤੀਜੇ ਲਈ ਐਕਸਪਲੋਰਰ ਜਾਂਚੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesłano do sieci \\(executed.chain.displayName). Potwierdzenie może chwilę potrwać — sprawdź ostateczny wynik w eksploratorze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado para a rede \\(executed.chain.displayName). A confirmação pode levar um momento — verifique o explorador para o resultado final."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimis în rețeaua \\(executed.chain.displayName). Confirmarea poate dura o clipă — verifică exploratorul pentru rezultatul final."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено в сеть \\(executed.chain.displayName). Подтверждение может занять некоторое время — проверьте обозреватель для окончательного результата."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odoslané do siete \\(executed.chain.displayName). Potvrdenie môže chvíľu trvať — skontrolujte prehliadač pre konečný výsledok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddano v omrežje \\(executed.chain.displayName). Potrjevanje lahko traja trenutek — za končni rezultat preverite raziskovalec."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslato na \\(executed.chain.displayName) mrežu. Potvrđivanje može potrajati trenutak — proverite pregledač za konačni rezultat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inskickad till \\(executed.chain.displayName)-nätverket. Bekräftelse kan ta ett ögonblick — kontrollera utforskaren för det slutliga resultatet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imewasilishwa kwa mtandao wa \\(executed.chain.displayName). Kuthibitisha kunaweza kuchukua muda — angalia kichunguzi kwa matokeo ya mwisho."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) நெட்வொர்க்கிற்கு சமர்ப்பிக்கப்பட்டது. உறுதிப்படுத்த சிறிது நேரம் ஆகலாம் — இறுதி முடிவுக்கு எக்ஸ்ப்ளோரரைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) నెట్‌వర్క్‌కు సమర్పించబడింది. నిర్ధారించడానికి కొద్ది క్షణం పట్టవచ్చు — తుది ఫలితం కోసం ఎక్స్‌ప్లోరర్‌ను తనిఖీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งไปยังเครือข่าย \\(executed.chain.displayName) แล้ว การยืนยันอาจใช้เวลาสักครู่ — ตรวจสอบเอ็กซ์พลอเรอร์เพื่อดูผลลัพธ์สุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) ağına gönderildi. Onaylanması biraz zaman alabilir — nihai sonuç için gezgini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслано до мережі \\(executed.chain.displayName). Підтвердження може зайняти мить — перевірте кінцевий результат в оглядачі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(executed.chain.displayName) نیٹ ورک پر جمع ہو گیا۔ تصدیق میں تھوڑا وقت لگ سکتا ہے — حتمی نتیجے کے لیے ایکسپلورر چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi lên mạng \\(executed.chain.displayName). Việc xác nhận có thể mất một lát — hãy kiểm tra trình khám phá để biết kết quả cuối cùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提交到 \\(executed.chain.displayName) 网络。确认可能需要片刻——请在区块浏览器中查看最终结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已提交到 \\(executed.chain.displayName) 網路。確認可能需要片刻——請在區塊瀏覽器中查看最終結果。"
          }
        }
      }
    },
    "Submitted to the %@ network. Confirming may take a moment — check the explorer for the final result.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
