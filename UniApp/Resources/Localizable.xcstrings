            "value": "Без PIN-коду ваш гаманець захищений лише екраном блокування iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN کے بغیر، آپ کا والٹ صرف آپ کے iPhone کی لاک اسکرین سے محفوظ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có mã PIN, ví của bạn chỉ được bảo vệ bởi màn hình khóa của iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 PIN 码,你的钱包仅受 iPhone 锁屏保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 PIN 碼,你的錢包僅受 iPhone 鎖定畫面保護。"
          }
        }
      }
    },
