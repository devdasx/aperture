          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ پر %1$@ سے متعلق لین دین جیسے ہی تصدیق ہوتے ہیں یہاں ظاہر ہوتے ہیں۔"
