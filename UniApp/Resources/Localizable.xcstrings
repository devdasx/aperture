    "Your Face ID enrollment changed. Authenticate once to trust this iPhone again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou Face ID-registrasie het verander. Verifieer een keer om hierdie iPhone weer te vertrou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر تسجيل Face ID لديك. صادق مرة واحدة لاستعادة الثقة بهذا iPhone."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрацията ви на Face ID се промени. Удостоверете се веднъж, за да се доверите отново на този iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Face ID নিবন্ধন পরিবর্তিত হয়েছে। এই iPhone-কে আবার বিশ্বাস করতে একবার প্রমাণীকরণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu registre de Face ID ha canviat. Autentica't una vegada per tornar a confiar en aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše registrace Face ID se změnila. Jednou se ověřte, abyste tomuto iPhonu znovu důvěřovali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Face ID-registrering er ændret. Godkend én gang for at stole på denne iPhone igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Face-ID-Einrichtung hat sich geändert. Authentifizieren Sie sich einmal, um diesem iPhone wieder zu vertrauen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή σας στο Face ID άλλαξε. Πιστοποιηθείτε μία φορά για να εμπιστευτείτε ξανά αυτό το iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Face ID enrollment changed. Authenticate once to trust this iPhone again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro de Face ID ha cambiado. Autentícate una vez para volver a confiar en este iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu Face ID registreering on muutunud. Autentige üks kord, et seda iPhone'i uuesti usaldada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبت‌نام Face ID شما تغییر کرده است. یک بار احراز هویت کنید تا این iPhone دوباره مورد اعتماد قرار گیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID -rekisteröintisi muuttui. Tunnistaudu kerran luottaaksesi taas tähän iPhoneen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang iyong Face ID enrollment. Mag-authenticate minsan para mapagkatiwalaan muli ang iPhone na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre inscription Face ID a changé. Authentifiez-vous une fois pour faire à nouveau confiance à cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרישום של Face ID השתנה. אמת פעם אחת כדי לסמוך שוב על iPhone זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Face ID एनरोलमेंट बदला है। इस iPhone पर फिर से भरोसा करने के लिए एक बार प्रमाणीकरण करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša Face ID prijava promijenjena je. Autentificirajte se jednom kako biste ponovno vjerovali ovom iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Face ID-regisztrációja megváltozott. Hitelesítse magát egyszer, hogy újra megbízzon ebben az iPhone-ban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran Face ID Anda berubah. Autentikasi sekali untuk mempercayai iPhone ini lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID skráning þín hefur breyst. Auðkenndu þig einu sinni til að treysta þessum iPhone aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua registrazione Face ID è cambiata. Autenticati una volta per dare di nuovo fiducia a questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID の登録内容が変更されました。この iPhone を再度信頼するために、一度認証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 등록이 변경되었습니다. 이 iPhone을 다시 신뢰하려면 한 번 인증하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų Face ID registracija pasikeitė. Vieną kartą patvirtinkite tapatybę, kad vėl pasitikėtumėte šiuo „iPhone“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu Face ID reģistrācija ir mainījusies. Autentificējieties vienreiz, lai atkal uzticētos šim iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Face ID എൻറോൾമെന്റ് മാറി. ഈ iPhone-നെ വീണ്ടും വിശ്വസിക്കാൻ ഒരിക്കൽ ആധികാരികമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची Face ID नोंदणी बदलली आहे. या iPhone वर पुन्हा विश्वास ठेवण्यासाठी एकदा प्रमाणीकरण करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran Face ID anda berubah. Sahkan sekali untuk mempercayai iPhone ini sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID-registreringen din er endret. Autentiser deg én gang for å stole på denne iPhonen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Face ID-registratie is gewijzigd. Verifieer je eenmaal om deze iPhone weer te vertrouwen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ Face ID ਨਾਮਾਂਕਣ ਬਦਲ ਗਈ ਹੈ। ਇਸ iPhone 'ਤੇ ਮੁੜ ਭਰੋਸਾ ਕਰਨ ਲਈ ਇੱਕ ਵਾਰ ਪ੍ਰਮਾਣਿਤ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rejestracja Face ID się zmieniła. Uwierzytelnij się raz, aby ponownie zaufać temu iPhone’owi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu cadastro do Face ID mudou. Autentique-se uma vez para voltar a confiar neste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea Face ID s-a schimbat. Autentifică-te o dată pentru a avea din nou încredere în acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация Face ID изменилась. Пройдите аутентификацию один раз, чтобы снова доверять этому iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša registrácia Face ID sa zmenila. Raz sa overte, aby ste tomuto iPhonu opäť dôverovali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša registracija Face ID se je spremenila. Enkrat se overite, da boste temu iPhonu znova zaupali."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша Face ID регистрација је промењена. Аутентификујте се једном да поново верујете овом iPhone-у."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Face ID-registrering har ändrats. Autentisera dig en gång för att lita på denna iPhone igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usajili wako wa Face ID umebadilika. Thibitisha mara moja ili kuamini iPhone hii tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Face ID பதிவு மாறிவிட்டது. இந்த iPhone-ஐ மீண்டும் நம்ப ஒரு முறை அங்கீகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Face ID నమోదు మారింది. ఈ iPhone ను మళ్లీ నమ్మడానికి ఒకసారి ప్రామాణీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงทะเบียน Face ID ของคุณเปลี่ยนไปแล้ว ยืนยันตัวตนหนึ่งครั้งเพื่อให้ iPhone นี้น่าเชื่อถืออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID kaydınız değişti. Bu iPhone'a yeniden güvenmek için bir kez kimlik doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша реєстрація Face ID змінилася. Пройдіть автентифікацію один раз, щоб знову довіряти цьому iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا Face ID اندراج تبدیل ہو گیا ہے۔ اس iPhone پر دوبارہ اعتماد کرنے کے لیے ایک بار توثیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký Face ID của bạn đã thay đổi. Hãy xác thực một lần để tin tưởng chiếc iPhone này trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Face ID 注册信息已更改。请认证一次以再次信任此 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Face ID 註冊資訊已變更。請認證一次以再次信任此 iPhone。"
          }
        }
      }
    },
    "Your funds are on their way. A bridge can take a few minutes to arrive on the destination network.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou fondse is op pad. 'n Brug kan 'n paar minute neem om op die bestemmingsnetwerk aan te kom."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أموالك في طريقها. قد يستغرق الجسر بضع دقائق للوصول إلى شبكة الوجهة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Средствата ви са на път. Мостът може да отнеме няколко минути, за да пристигне в целевата мрежа."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার তহবিল পথে আছে। একটি ব্রিজের গন্তব্য নেটওয়ার্কে পৌঁছাতে কয়েক মিনিট লাগতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus fons estan en camí. Un pont pot trigar uns minuts a arribar a la xarxa de destinació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše prostředky jsou na cestě. Most může trvat několik minut, než dorazí do cílové sítě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine midler er på vej. En bro kan tage et par minutter at ankomme til destinationsnetværket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mittel sind unterwegs. Eine Bridge kann ein paar Minuten brauchen, um im Zielnetzwerk anzukommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κεφάλαιά σας είναι καθ’ οδόν. Μια γέφυρα μπορεί να χρειαστεί μερικά λεπτά για να φτάσει στο δίκτυο προορισμού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fondos están en camino. Un puente puede tardar unos minutos en llegar a la red de destino."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie vahendid on teel. Sild võib sihtvõrku jõudmiseks võtta paar minutit."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وجوه شما در راه است. ممکن است چند دقیقه طول بکشد تا پل به شبکه‌ی مقصد برسد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varasi ovat matkalla. Silta voi viedä muutaman minuutin saapuakseen kohdeverkkoon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Papunta na ang iyong pondo. Ang isang bridge ay maaaring tumagal ng ilang minuto bago dumating sa destination network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fonds sont en route. Un pont peut prendre quelques minutes pour arriver sur le réseau de destination."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכספים שלך בדרך. גשר עשוי לקחת כמה דקות עד שיגיע לרשת היעד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ंड रास्ते में है। एक ब्रिज को गंतव्य नेटवर्क पर पहुँचने में कुछ मिनट लग सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša su sredstva na putu. Mostu može trebati nekoliko minuta da stigne na odredišnu mrežu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pénzed úton van. Egy híd néhány percig is eltarthat, mire megérkezik a célhálózatra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dana Anda sedang dalam perjalanan. Bridge dapat memerlukan beberapa menit untuk tiba di jaringan tujuan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Féð þitt er á leiðinni. Brú getur tekið nokkrar mínútur að berast á áfanganetið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi fondi sono in arrivo. Un bridge può richiedere qualche minuto per arrivare sulla rete di destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資金は送付中です。ブリッジが宛先ネットワークに到着するまで数分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자금이 이동 중입니다. 브리지가 목적지 네트워크에 도착하는 데 몇 분이 걸릴 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų lėšos jau pakeliui. Tiltui pasiekti paskirties tinklą gali prireikti kelių minučių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu līdzekļi ir ceļā. Tiltam var paiet dažas minūtes, līdz tas pienāk galamērķa tīklā."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫണ്ട് വഴിയിലാണ്. ഒരു ബ്രിഡ്ജ് ലക്ഷ്യസ്ഥാന നെറ്റ്‌വർക്കിൽ എത്താൻ കുറച്ച് മിനിറ്റ് എടുത്തേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा निधी मार्गावर आहे. ब्रिजला गंतव्य नेटवर्कवर पोहोचण्यास काही मिनिटे लागू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dana anda sedang dalam perjalanan. Jambatan boleh mengambil beberapa minit untuk tiba pada rangkaian destinasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Midlene dine er på vei. En bro kan ta noen minutter å ankomme destinasjonsnettverket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tegoed is onderweg. Een bridge kan een paar minuten duren om op het doelnetwerk aan te komen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਫੰਡ ਆਪਣੇ ਰਾਹ 'ਤੇ ਹਨ। ਬ੍ਰਿਜ ਨੂੰ ਮੰਜ਼ਿਲ ਨੈੱਟਵਰਕ 'ਤੇ ਪਹੁੰਚਣ ਵਿੱਚ ਕੁਝ ਮਿੰਟ ਲੱਗ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje środki są w drodze. Most może potrzebować kilku minut, aby dotrzeć do sieci docelowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus fundos estão a caminho. Uma ponte pode levar alguns minutos para chegar à rede de destino."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondurile tale sunt pe drum. O punte poate dura câteva minute până ajunge pe rețeaua de destinație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши средства в пути. Мост может занять несколько минут до прибытия в сеть назначения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše prostriedky sú na ceste. Mostu môže trvať niekoľko minút, kým dorazí do cieľovej siete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša sredstva so na poti. Most lahko potrebuje nekaj minut, da prispe v ciljno omrežje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša sredstva su na putu. Mostu može trebati nekoliko minuta da stigne na odredišnu mrežu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina medel är på väg. En brygga kan ta några minuter att anlända till destinationsnätverket."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fedha zako ziko njiani. Daraja linaweza kuchukua dakika chache kufika kwenye mtandao lengwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நிதி வழியில் உள்ளது. பாலம் இலக்கு நெட்வொர்க்கில் வந்து சேர சில நிமிடங்கள் ஆகலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నిధులు దారిలో ఉన్నాయి. బ్రిడ్జ్ గమ్యస్థాన నెట్‌వర్క్‌కు చేరడానికి కొన్ని నిమిషాలు పట్టవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เงินของคุณกำลังถูกส่ง บริดจ์อาจใช้เวลาสองสามนาทีกว่าจะถึงเครือข่ายปลายทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonlarınız yolda. Bir köprünün hedef ağa ulaşması birkaç dakika sürebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші кошти в дорозі. Перенесення через міст може зайняти кілька хвилин, щоб надійти в мережу призначення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی رقم راستے میں ہے۔ برج کو منزل نیٹ ورک پر پہنچنے میں چند منٹ لگ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiền của bạn đang trên đường. Một cầu nối có thể mất vài phút để đến mạng đích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的资金正在途中。跨链桥可能需要几分钟才能到达目标网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資金正在途中。跨鏈橋可能需要幾分鐘才能到達目標網路。"
          }
        }
      }
    },
    "Your holdings will appear here.": {
      "extractionState": "manual",
      "localizations": {
