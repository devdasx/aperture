    "Add ERC-20 / SPL tokens by pasting their contract or mint address. Aperture reads name, symbol, and decimals from chain.": {
      "extractionState": "new",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg ERC-20-/SPL-tokens by deur hul kontrak- of mint-adres te plak. Aperture lees naam, simbool en desimale vanaf die ketting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عملات ERC-20 / SPL بلصق عنوان عقدها أو عنوان الإصدار. تقرأ Aperture الاسم والرمز والكسور العشرية من السلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете ERC-20 / SPL токени, като поставите адреса на договора или mint. Aperture чете името, символа и десетичните знаци от веригата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্ট্রাক্ট বা mint ঠিকানা পেস্ট করে ERC-20 / SPL টোকেন যোগ করুন। Aperture চেইন থেকে নাম, সিম্বল এবং দশমিক পড়ে নেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix tokens ERC-20 / SPL enganxant la seva adreça de contracte o mint. Aperture llegeix el nom, el símbol i els decimals de la cadena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidávejte tokeny ERC-20 / SPL vložením adresy kontraktu nebo mintu. Název, symbol a desetinná místa si Aperture načte z chainu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj ERC-20- / SPL-tokens ved at indsætte deres kontrakt- eller mint-adresse. Aperture læser navn, symbol og decimaler fra kæden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ERC-20- / SPL-Tokens hinzu, indem du ihre Vertrags- oder Mint-Adresse einfügst. Name, Symbol und Dezimalstellen liest Aperture aus der Chain."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε tokens ERC-20 / SPL επικολλώντας τη διεύθυνση του συμβολαίου ή του mint. Το όνομα, το σύμβολο και τα δεκαδικά τα διαβάζει το Aperture από την αλυσίδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add ERC-20 / SPL tokens by pasting their contract or mint address. Aperture reads name, symbol, and decimals from chain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tokens ERC-20 / SPL pegando su dirección de contrato o mint. Aperture lee nombre, símbolo y decimales en la cadena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa ERC-20 / SPL märgid, kleepides nende lepingu või mint-aadressi. Aperture loeb nime, sümboli ja kümnendkohad ahelast."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با چسباندن نشانی قرارداد یا مینت، توکن‌های ERC-20 / SPL را اضافه کنید. Aperture نام، نماد و رقم اعشار را از زنجیره می‌خواند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ERC-20- / SPL-tokeneja liittämällä niiden sopimus- tai mint-osoite. Aperture lukee nimen, symbolin ja desimaalit ketjusta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng mga ERC-20 / SPL token sa pamamagitan ng pag-paste ng kanilang contract o mint address. Binabasa ng Aperture ang pangalan, simbolo, at decimals mula sa chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des jetons ERC-20 / SPL en collant leur adresse de contrat ou de mint. Aperture lit le nom, le symbole et les décimales depuis la chaîne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת טוקני ERC-20 / SPL נעשית על־ידי הדבקת כתובת החוזה או ה־mint שלהם. את השם, הסמל ומספר העשרוניות Aperture קוראת מהבלוקצ׳יין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20 / SPL टोकन उनके कॉन्ट्रैक्ट या मिंट पता पेस्ट करके जोड़ें। नाम, सिंबल और दशमलव Aperture चेन से पढ़ लेता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte ERC-20 / SPL tokene lijepljenjem adrese ugovora ili mint adrese. Naziv, simbol i decimale Aperture čita s lanca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá ERC-20 / SPL tokeneket a szerződés vagy a mint cím beillesztésével. A nevet, szimbólumot és tizedesjegyeket az Aperture leolvassa a láncról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan token ERC-20 / SPL dengan menempelkan alamat kontrak atau mint-nya. Aperture membaca nama, simbol, dan desimal dari rantai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu við ERC-20 / SPL tókum með því að líma inn samnings- eða mint-fangið þeirra. Aperture les nafn, tákn og aukastafi af keðjunni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunga token ERC-20 / SPL incollando il loro indirizzo del contratto o del mint. Aperture legge nome, simbolo e decimali dalla catena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントラクトまたはミントアドレスを貼り付けて ERC-20 / SPL トークンを追加します。名称、シンボル、小数桁はAperture がチェーンから読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트랙트 또는 민트 주소를 붙여넣어 ERC-20 / SPL 토큰을 추가하세요. Aperture가 이름, 심볼, 소수 자릿수를 체인에서 읽어와요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite ERC-20 / SPL žetonus įklijuodami jų sutarties arba mint adresą. Aperture nuskaito pavadinimą, simbolį ir dešimtaines iš grandinės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet ERC-20 / SPL marķierus, ielīmējot to līguma vai mint adresi. Aperture nolasa nosaukumu, simbolu un decimāldaļas no ķēdes."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20 / SPL ടോക്കണുകളുടെ കരാർ അല്ലെങ്കിൽ mint വിലാസം ഒട്ടിച്ച് അവ ചേർക്കുക. പേര്, ചിഹ്നം, ദശാംശങ്ങൾ എന്നിവ Aperture ചെയിനിൽ നിന്ന് വായിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्यांचा करार किंवा mint पत्ता पेस्ट करून ERC-20 / SPL टोकन जोडा. नाव, चिन्ह आणि दशांश Aperture चेनवरून वाचते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah token ERC-20 / SPL dengan menampal alamat kontrak atau mint-nya. Aperture membaca nama, simbol dan perpuluhan daripada rantaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til ERC-20- / SPL-tokens ved å lime inn kontrakt- eller mint-adressen. Aperture leser navn, symbol og desimaler fra kjeden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg ERC-20-/SPL-tokens toe door het contract- of mint-adres te plakken. Aperture leest naam, symbool en decimalen uit de chain."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹਨਾਂ ਦਾ ਕੰਟਰੈਕਟ ਜਾਂ mint ਪਤਾ ਪੇਸਟ ਕਰਕੇ ERC-20 / SPL ਟੋਕਨ ਜੋੜੋ। ਨਾਮ, ਚਿੰਨ੍ਹ ਅਤੇ ਦਸ਼ਮਲਵ Aperture ਚੇਨ ਤੋਂ ਪੜ੍ਹਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj tokeny ERC-20 / SPL, wklejając adres kontraktu lub mintu. Aperture odczyta nazwę, symbol i miejsca dziesiętne z łańcucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione tokens ERC-20 / SPL colando o endereço do contrato ou do mint. O Aperture lê nome, símbolo e casas decimais na rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă tokenuri ERC-20 / SPL lipind adresa contractului sau a mint-ului. Numele, simbolul și zecimalele sunt citite de Aperture de pe chain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте токены ERC-20 / SPL, вставив адрес контракта или mint-адрес. Имя, символ и знаки после запятой Aperture прочитает из сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridávajte tokeny ERC-20 / SPL vložením adresy kontraktu alebo mintu. Názov, symbol a desatinné miesta si Aperture načíta z reťazca."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte žetone ERC-20 / SPL z lepljenjem naslova pogodbe ali mint naslova. Ime, simbol in decimalna mesta Aperture prebere iz verige."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавајте ERC-20 / SPL токене налепљивањем адресе уговора или mint адресе. Назив, симбол и децимале Aperture чита са ланца."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ERC-20- / SPL-tokens genom att klistra in deras kontrakts- eller mint-adress. Aperture läser namn, symbol och decimaler från kedjan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza tokeni za ERC-20 / SPL kwa kubandika anwani yao ya mkataba au mint. Aperture husoma jina, alama na desimali kutoka kwenye mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20 / SPL டோக்கன்களின் ஒப்பந்த அல்லது mint முகவரியை ஒட்டுவதன் மூலம் சேர்க்கவும். பெயர், சின்னம் மற்றும் தசம இடங்களை Aperture பிணையத்திலிருந்து படிக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20 / SPL టోకెన్‌ల కాంట్రాక్ట్ లేదా mint చిరునామాను అతికించడం ద్వారా జోడించండి. పేరు, చిహ్నం మరియు దశాంశాలను Aperture చైన్ నుండి చదువుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มโทเคน ERC-20 / SPL ด้วยการวางที่อยู่สัญญาหรือมินต์ Aperture จะอ่านชื่อ สัญลักษณ์ และทศนิยมจากเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözleşme veya mint adresini yapıştırarak ERC-20 / SPL token ekleyin. Aperture adı, sembolü ve ondalık sayıları zincirden okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте токени ERC-20 / SPL, вставляючи адресу контракту або mint. Назву, символ і знаки після коми Aperture зчитує з мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20 / SPL ٹوکن ان کا کنٹریکٹ یا mint ایڈریس پیسٹ کر کے شامل کریں۔ Aperture نام، علامت اور اعشاریے چین سے پڑھ لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm token ERC-20 / SPL bằng cách dán địa chỉ hợp đồng hoặc mint của chúng. Aperture đọc tên, ký hiệu và số thập phân từ chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴合约或铸造地址,即可添加 ERC-20 / SPL 代币。Aperture 会从链上读取名称、符号和精度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上合約或鑄造地址即可新增 ERC-20 / SPL 代幣。Aperture 會從鏈上讀取名稱、符號與小數位。"
          }
        }
      }
    },
