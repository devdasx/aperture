        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli üles märgitud algset fraasi — see sõna võib pärineda mõnest teisest sõnaloendist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت اصلی که یادداشت کرده‌اید را بررسی کنید — این کلمه ممکن است از فهرست کلمات دیگری باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista muistiin kirjoittamasi alkuperäinen lause — tämä sana voi olla eri sanaluettelosta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin ang orihinal na pariralang isinulat mo — maaaring nagmula sa ibang listahan ng salita ang salitang ito."
          }
        },
        "fr": {
          "stringUnit": {
