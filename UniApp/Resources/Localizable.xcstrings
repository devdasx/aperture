        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소록에 없습니다 — 전송 후 연락처로 저장하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nėra jūsų adresų knygoje – po siuntimo išsaugokite kaip kontaktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav jūsu adrešu grāmatā — pēc sūtīšanas saglabājiet kā kontaktu."
