    "Send only to a \\(symbol) address on the same network. Sending across networks may result in permanent loss.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur slegs na 'n \\(symbol)-adres op dieselfde netwerk. Om oor netwerke te stuur, kan permanente verlies tot gevolg hê."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل فقط إلى عنوان \\(symbol) على الشبكة نفسها. الإرسال عبر الشبكات قد يؤدي إلى خسارة دائمة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпращайте само до \\(symbol) адрес в същата мрежа. Изпращането между мрежи може да доведе до постоянна загуба."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই নেটওয়ার্কে শুধুমাত্র একটি \\(symbol) ঠিকানায় পাঠান। নেটওয়ার্ক জুড়ে পাঠালে স্থায়ী ক্ষতি হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia només a una adreça de \\(symbol) a la mateixa xarxa. Enviar entre xarxes pot provocar una pèrdua permanent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílejte jen na adresu \\(symbol) ve stejné síti. Odeslání mezi sítěmi může vést k trvalé ztrátě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send kun til en \\(symbol)-adresse på samme netværk. At sende mellem netværk kan medføre permanent tab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende nur an eine \\(symbol)-Adresse im selben Netzwerk. Netzwerkübergreifendes Senden kann zu dauerhaftem Verlust führen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε μόνο σε διεύθυνση \\(symbol) στο ίδιο δίκτυο. Η αποστολή μεταξύ δικτύων μπορεί να οδηγήσει σε μόνιμη απώλεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send only to a \\(symbol) address on the same network. Sending across networks may result in permanent loss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía solo a una dirección de \\(symbol) en la misma red. Enviar entre redes puede provocar una pérdida permanente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatke ainult \\(symbol) aadressile samas võrgus. Võrkude vahel saatmine võib põhjustada püsiva kaotuse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط به یک نشانی \\(symbol) روی همان شبکه ارسال کنید. ارسال میان شبکه‌ها ممکن است به از دست رفتن دائمی منجر شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä vain \\(symbol)-osoitteeseen samassa verkossa. Verkkojen välinen lähetys voi johtaa pysyvään menetykseen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magpadala lamang sa isang \\(symbol) address sa parehong network. Ang pagpapadala sa iba't ibang network ay maaaring magresulta sa permanenteng pagkawala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez uniquement vers une adresse \\(symbol) sur le même réseau. L'envoi entre réseaux peut entraîner une perte définitive."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלח רק לכתובת \\(symbol) באותה רשת. שליחה בין רשתות עלולה לגרום לאובדן קבוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उसी नेटवर्क पर \\(symbol) पते पर भेजें। नेटवर्कों के बीच भेजने से स्थायी हानि हो सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šaljite samo na \\(symbol) adresu na istoj mreži. Slanje preko mreža može rezultirati trajnim gubitkom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ugyanazon a hálózaton lévő \\(symbol) címre küldj. A hálózatok közötti küldés végleges veszteséghez vezethet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim hanya ke alamat \\(symbol) di jaringan yang sama. Mengirim antar jaringan dapat mengakibatkan kehilangan permanen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendu aðeins á \\(symbol)-vistfang á sama neti. Sending milli neta getur valdið varanlegu tjóni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia solo a un indirizzo \\(symbol) sulla stessa rete. Inviare tra reti diverse può comportare una perdita permanente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じネットワーク上の \\(symbol) アドレスにのみ送ってください。ネットワークをまたいで送ると、永久に失われることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 네트워크의 \\(symbol) 주소로만 전송하세요. 네트워크 간 전송은 영구적인 손실을 초래할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siųskite tik į \\(symbol) adresą tame pačiame tinkle. Siunčiant tarp tinklų galima visam laikui prarasti lėšas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sūtiet tikai uz \\(symbol) adresi tajā pašā tīklā. Sūtīšana starp tīkliem var izraisīt neatgriezenisku zaudējumu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരേ നെറ്റ്‌വർക്കിലെ ഒരു \\(symbol) വിലാസത്തിലേക്ക് മാത്രം അയയ്ക്കുക. നെറ്റ്‌വർക്കുകൾക്കിടയിൽ അയയ്ക്കുന്നത് സ്ഥിരമായ നഷ്ടത്തിന് കാരണമായേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त त्याच नेटवर्कवरील \\(symbol) पत्त्यावर पाठवा. नेटवर्कमध्ये पाठवल्यास कायमचे नुकसान होऊ शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar hanya ke alamat \\(symbol) pada rangkaian yang sama. Menghantar merentas rangkaian boleh menyebabkan kehilangan kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send kun til en \\(symbol)-adresse på samme nettverk. Å sende mellom nettverk kan føre til permanent tap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuur alleen naar een \\(symbol)-adres op hetzelfde netwerk. Verzenden tussen netwerken kan tot permanent verlies leiden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਉਸੇ ਨੈੱਟਵਰਕ 'ਤੇ \\(symbol) ਪਤੇ ਨੂੰ ਭੇਜੋ। ਨੈੱਟਵਰਕਾਂ ਵਿਚਕਾਰ ਭੇਜਣ ਨਾਲ ਪੱਕਾ ਨੁਕਸਾਨ ਹੋ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłaj tylko na adres \\(symbol) w tej samej sieci. Wysyłka między sieciami może skutkować trwałą utratą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie somente para um endereço \\(symbol) na mesma rede. Enviar entre redes pode resultar em perda permanente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite doar către o adresă \\(symbol) de pe aceeași rețea. Trimiterea între rețele poate duce la pierdere permanentă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте только на адрес \\(symbol) в той же сети. Отправка между сетями может привести к безвозвратной потере."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posielajte len na adresu \\(symbol) v rovnakej sieti. Posielanie medzi sieťami môže viesť k trvalej strate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljajte samo na naslov \\(symbol) v istem omrežju. Pošiljanje med omrežji lahko povzroči trajno izgubo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šaljite samo na \\(symbol) adresu na istoj mreži. Slanje preko mreža može dovesti do trajnog gubitka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka endast till en \\(symbol)-adress på samma nätverk. Att skicka mellan nätverk kan leda till permanent förlust."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuma kwa anwani ya \\(symbol) tu kwenye mtandao uleule. Kutuma kati ya mitandao kunaweza kusababisha hasara ya kudumu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதே நெட்வொர்க்கில் உள்ள \\(symbol) முகவரிக்கு மட்டுமே அனுப்பவும். நெட்வொர்க்குகளுக்கு இடையே அனுப்புவது நிரந்தர இழப்பை ஏற்படுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అదే నెట్‌వర్క్‌లోని \\(symbol) చిరునామాకు మాత్రమే పంపండి. నెట్‌వర్క్‌ల మధ్య పంపడం శాశ్వత నష్టానికి దారితీయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งไปยังที่อยู่ \\(symbol) บนเครือข่ายเดียวกันเท่านั้น การส่งข้ามเครือข่ายอาจทำให้สูญเสียถาวรได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca aynı ağdaki bir \\(symbol) adresine gönderin. Ağlar arasında göndermek kalıcı kayba neden olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилайте лише на адресу \\(symbol) у тій самій мережі. Надсилання між мережами може призвести до безповоротної втрати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اسی نیٹ ورک پر \\(symbol) ایڈریس پر بھیجیں۔ نیٹ ورکس کے درمیان بھیجنے سے مستقل نقصان ہو سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ gửi tới một địa chỉ \\(symbol) trên cùng mạng. Gửi qua các mạng khác nhau có thể dẫn đến mất mát vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送到同一网络上的 \\(symbol) 地址。跨网络发送可能导致永久损失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅傳送到同一網路上的 \\(symbol) 地址。跨網路傳送可能導致永久損失。"
          }
        }
      }
    },
    "Send only to a %@ address on the same network. Sending across networks may result in permanent loss.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur slegs na 'n %@-adres op dieselfde netwerk. Om oor netwerke te stuur, kan permanente verlies tot gevolg hê."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل فقط إلى عنوان %@ على الشبكة نفسها. الإرسال عبر الشبكات قد يؤدي إلى خسارة دائمة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпращайте само до %@ адрес в същата мрежа. Изпращането между мрежи може да доведе до постоянна загуба."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই নেটওয়ার্কে শুধুমাত্র একটি %@ ঠিকানায় পাঠান। নেটওয়ার্ক জুড়ে পাঠালে স্থায়ী ক্ষতি হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia només a una adreça de %@ a la mateixa xarxa. Enviar entre xarxes pot provocar una pèrdua permanent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílejte jen na adresu %@ ve stejné síti. Odeslání mezi sítěmi může vést k trvalé ztrátě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send kun til en %@-adresse på samme netværk. At sende mellem netværk kan medføre permanent tab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende nur an eine %@-Adresse im selben Netzwerk. Netzwerkübergreifendes Senden kann zu dauerhaftem Verlust führen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε μόνο σε διεύθυνση %@ στο ίδιο δίκτυο. Η αποστολή μεταξύ δικτύων μπορεί να οδηγήσει σε μόνιμη απώλεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía solo a una dirección de %@ en la misma red. Enviar entre redes puede provocar una pérdida permanente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatke ainult %@ aadressile samas võrgus. Võrkude vahel saatmine võib põhjustada püsiva kaotuse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط به یک نشانی %@ روی همان شبکه ارسال کنید. ارسال میان شبکه‌ها ممکن است به از دست رفتن دائمی منجر شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä vain %@-osoitteeseen samassa verkossa. Verkkojen välinen lähetys voi johtaa pysyvään menetykseen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magpadala lamang sa isang %@ address sa parehong network. Ang pagpapadala sa iba't ibang network ay maaaring magresulta sa permanenteng pagkawala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez uniquement vers une adresse %@ sur le même réseau. L'envoi entre réseaux peut entraîner une perte définitive."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלח רק לכתובת %@ באותה רשת. שליחה בין רשתות עלולה לגרום לאובדן קבוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उसी नेटवर्क पर %@ पते पर भेजें। नेटवर्कों के बीच भेजने से स्थायी हानि हो सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šaljite samo na %@ adresu na istoj mreži. Slanje preko mreža može rezultirati trajnim gubitkom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ugyanazon a hálózaton lévő %@ címre küldj. A hálózatok közötti küldés végleges veszteséghez vezethet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim hanya ke alamat %@ di jaringan yang sama. Mengirim antar jaringan dapat mengakibatkan kehilangan permanen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendu aðeins á %@-vistfang á sama neti. Sending milli neta getur valdið varanlegu tjóni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
