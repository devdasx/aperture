          "stringUnit": {
            "state": "translated",
            "value": "Khóa riêng tư của bạn vẫn là của bạn. Bạn có thể nhập lại ví này bằng nó — không có máy chủ nào, và xóa nó ở đây không làm mất bất cứ thứ gì bạn đã lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的私钥始终属于你。你可凭它重新导入此钱包——没有服务器，在此移除不会丢失你已保存的任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的私鑰始終屬於你。你可憑它重新匯入此錢包——沒有伺服器，在此移除不會遺失你已儲存的任何內容。"
          }
        }
      }
    },
