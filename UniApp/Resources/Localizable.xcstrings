        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תאבד אותו, הכספים נעלמים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे खो दिया, तो धन भी गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je izgubite, sredstva su nestala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha elveszíti, a pénzeszközök elvesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika hilang, dana ikut hilang."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú týnir henni, þá eru fjármunirnir farnir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la perde, i fondi sono persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失えば、資金も失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잃어버리면 자금도 사라집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Praradę ją, prarandate ir lėšas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja to pazaudēsiet, līdzekļi būs pazuduši."
