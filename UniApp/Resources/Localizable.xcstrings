        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture estime automatiquement la limite de gas. Ne modifiez ceci que si vous savez que la transaction en nécessite plus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎Aperture מעריך את מגבלת הגז באופן אוטומטי. שנה זאת רק אם אתה יודע שהעסקה זקוקה ליותר."
