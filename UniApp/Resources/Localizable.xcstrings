    "A higher fee confirms faster. Too low and the transaction can get stuck.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Hoër fooi bevestig vinniger. Te laag en die transaksie kan vassteek."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرسوم الأعلى تؤكد أسرع. والمنخفضة جدًا قد تتسبب في تعليق المعاملة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По-високата такса потвърждава по-бързо. Твърде ниска и транзакцията може да заседне."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেশি ফি দ্রুত নিশ্চিত হয়। খুব কম হলে লেনদেন আটকে যেতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comissió més alta es confirma més de pressa. Massa baixa i la transacció es pot encallar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší poplatek potvrdí rychleji. Příliš nízký a transakce může uváznout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et højere gebyr bekræftes hurtigere. For lavt, og transaktionen kan sætte sig fast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine höhere Gebühr bestätigt schneller. Ist sie zu niedrig, kann die Transaktion hängen bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια υψηλότερη χρέωση επιβεβαιώνεται γρηγορότερα. Αν είναι πολύ χαμηλή, η συναλλαγή μπορεί να κολλήσει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comisión más alta se confirma antes. Si es demasiado baja, la transacción puede quedarse atascada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõrgem tasu kinnitub kiiremini. Liiga madala korral võib tehing kinni jääda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارمزد بالاتر سریع‌تر تأیید می‌شود. اگر بیش از حد پایین باشد، تراکنش ممکن است گیر کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkeampi maksu vahvistuu nopeammin. Liian matala voi jättää tapahtuman jumiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas mabilis kumpirmahin ang mas mataas na bayad. Kapag masyadong mababa, maaaring ma-stuck ang transaksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des frais plus élevés confirment plus vite. Trop bas, la transaction peut rester bloquée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמלה גבוהה יותר מאשרת מהר יותר. נמוכה מדי, והעסקה עלולה להיתקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिक शुल्क तेज़ी से पुष्टि करता है। बहुत कम होने पर ट्रांज़ैक्शन अटक सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veća naknada potvrđuje brže. Ako je preniska, transakcija može zapeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb díj gyorsabban megerősítődik. Túl alacsony esetén a tranzakció elakadhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya yang lebih tinggi mengonfirmasi lebih cepat. Terlalu rendah dan transaksi bisa tersendat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hærra gjald staðfestist hraðar. Of lágt og færslan getur fest sig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una commissione più alta si conferma più velocemente. Troppo bassa e la transazione può bloccarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手数料が高いほど早く承認されます。低すぎると取引が滞ることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수수료가 높을수록 더 빨리 확인됩니다. 너무 낮으면 거래가 막힐 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Didesnis mokestis patvirtinamas greičiau. Per mažas – ir operacija gali įstrigti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Augstāka maksa apstiprinās ātrāk. Pārāk zema, un transakcija var iestrēgt."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉയർന്ന ഫീസ് വേഗത്തിൽ സ്ഥിരീകരിക്കുന്നു. വളരെ കുറവാണെങ്കിൽ ഇടപാട് കുടുങ്ങിപ്പോകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जास्त शुल्क लवकर पुष्टी होते. खूप कमी असल्यास व्यवहार अडकू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuran yang lebih tinggi disahkan lebih cepat. Terlalu rendah dan transaksi boleh tersangkut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et høyere gebyr bekreftes raskere. For lavt, og transaksjonen kan sette seg fast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hogere kosten bevestigt sneller. Te laag en de transactie kan vastlopen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਧ ਫੀਸ ਤੇਜ਼ੀ ਨਾਲ ਪੁਸ਼ਟੀ ਹੁੰਦੀ ਹੈ। ਬਹੁਤ ਘੱਟ ਹੋਣ 'ਤੇ ਲੈਣ-ਦੇਣ ਅਟਕ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższa opłata przyspiesza potwierdzenie. Zbyt niska może zablokować transakcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma taxa maior confirma mais rápido. Baixa demais, a transação pode travar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comision mai mare se confirmă mai repede. Prea mic, iar tranzacția se poate bloca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более высокая комиссия подтверждается быстрее. Слишком низкая — транзакция может застрять."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší poplatok potvrdí rýchlejšie. Príliš nízky a transakcia môže uviaznuť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Višja provizija se hitreje potrdi. Prenizka pa lahko povzroči, da transakcija obtiči."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Viša naknada se brže potvrđuje. Premala i transakcija može da zaglavi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En högre avgift bekräftas snabbare. För låg och transaktionen kan fastna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada ya juu zaidi huthibitisha haraka. Ikiwa chini sana, muamala unaweza kukwama."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிக கட்டணம் வேகமாக உறுதியாகும். மிகக் குறைவாக இருந்தால் பரிவர்த்தனை சிக்கிக்கொள்ளலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎక్కువ ఫీజు వేగంగా నిర్ధారిస్తుంది. చాలా తక్కువగా ఉంటే లావాదేవీ ఆగిపోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าธรรมเนียมที่สูงกว่าจะยืนยันเร็วกว่า หากต่ำเกินไปธุรกรรมอาจค้างได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek bir ücret daha hızlı onaylanır. Çok düşük olursa işlem takılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вища комісія підтверджується швидше. Якщо вона занизька, транзакція може застрягти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ فیس تیزی سے تصدیق کراتی ہے۔ بہت کم ہو تو ٹرانزیکشن اٹک سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phí cao hơn sẽ xác nhận nhanh hơn. Quá thấp thì giao dịch có thể bị kẹt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用越高确认越快。过低则交易可能卡住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "費用越高確認越快。過低則交易可能卡住。"
          }
        }
      }
    },
    "A network fee is what you pay the blockchain — not Aperture — to process your transaction. It goes to the people running the network, never to us.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Netwerkfooi is wat jy aan die blokketting betaal — nie aan Aperture nie — om jou transaksie te verwerk. Dit gaan na die mense wat die netwerk bedryf, nooit na ons nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسوم الشبكة هي ما تدفعه إلى البلوكتشين — لا إلى Aperture — لمعالجة معاملتك. تذهب إلى من يُشغّلون الشبكة، ولا تصل إلينا أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мрежовата такса е това, което плащате на блокчейна — не на Aperture — за обработката на транзакцията Ви. Тя отива при хората, които поддържат мрежата, никога при нас."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্ক ফি হলো আপনার লেনদেন প্রক্রিয়া করার জন্য আপনি ব্লকচেইনকে যা দেন — Aperture-কে নয়। এটি নেটওয়ার্ক পরিচালনাকারীদের কাছে যায়, কখনও আমাদের কাছে নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La comissió de xarxa és el que pagues a la cadena de blocs —no a Aperture— per processar la teva transacció. Va a qui fa funcionar la xarxa, mai a nosaltres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síťový poplatek je to, co platíte blockchainu – nikoli Aperture – za zpracování vaší transakce. Putuje těm, kdo provozují síť, nikdy ne k nám."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværksgebyret er det, du betaler til blockchainen – ikke til Aperture – for at behandle din transaktion. Det går til dem, der driver netværket, aldrig til os."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Netzwerkgebühr ist das, was Sie der Blockchain – nicht Aperture – für die Verarbeitung Ihrer Transaktion zahlen. Sie geht an die Betreiber des Netzwerks, niemals an uns."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τέλος δικτύου είναι αυτό που πληρώνετε στο blockchain — όχι στην Aperture — για την επεξεργασία της συναλλαγής σας. Πηγαίνει σε όσους λειτουργούν το δίκτυο, ποτέ σε εμάς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A network fee is what you pay the blockchain — not Aperture — to process your transaction. It goes to the people running the network, never to us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión de red es lo que pagas a la cadena de bloques —no a Aperture— para procesar tu transacción. Va a quienes operan la red, nunca a nosotros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrgutasu on see, mida maksad tehingu töötlemise eest plokiahelale — mitte Aperture'ile. See läheb inimestele, kes võrku hoiavad, mitte kunagi meile."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارمزد شبکه چیزی است که شما برای پردازش تراکنش‌تان به بلاک‌چین می‌پردازید — نه به Aperture. این کارمزد به کسانی می‌رسد که شبکه را اداره می‌کنند، هرگز به ما نمی‌رسد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkomaksu on se, minkä maksat lohkoketjulle – et Aperturelle – tapahtumasi käsittelystä. Se menee verkkoa ylläpitäville, ei koskaan meille."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang network fee ang binabayad mo sa blockchain — hindi sa Aperture — upang iproseso ang iyong transaksyon. Napupunta ito sa mga taong nagpapatakbo ng network, hindi kailanman sa amin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais de réseau sont ce que vous payez à la blockchain — pas à Aperture — pour traiter votre transaction. Ils reviennent aux personnes qui font tourner le réseau, jamais à nous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמלת הרשת היא מה שאתה משלם לבלוקצ׳יין — לא ל-Aperture — כדי לעבד את העסקה שלך. היא מגיעה למי שמפעילים את הרשת, ולעולם לא אלינו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क शुल्क वह है जो आप अपने लेन-देन को संसाधित करने के लिए ब्लॉकचेन को चुकाते हैं — Aperture को नहीं। यह नेटवर्क चलाने वालों के पास जाता है, हमारे पास कभी नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mrežna naknada je ono što plaćate blockchainu – ne Apertureu – za obradu vaše transakcije. Ide onima koji održavaju mrežu, nikada nama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hálózati díj az, amit a blokkláncnak – nem az Aperture-nek – fizet a tranzakciója feldolgozásáért. Azokhoz kerül, akik a hálózatot működtetik, hozzánk soha."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya jaringan adalah yang Anda bayar kepada blockchain — bukan Aperture — untuk memproses transaksi Anda. Biaya itu diberikan kepada orang-orang yang menjalankan jaringan, bukan kepada kami."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Netgjald er það sem þú greiðir blokkakeðjunni — ekki Aperture — fyrir að vinna úr færslunni þinni. Það fer til þeirra sem reka netið, aldrei til okkar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La commissione di rete è ciò che paga alla blockchain — non ad Aperture — per elaborare la sua transazione. Va a chi gestisce la rete, mai a noi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク手数料は、取引を処理してもらうためにブロックチェーンへ支払うものです（Aperture へではありません）。ネットワークを運用する人々に渡り、私たちには一切渡りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 수수료는 거래를 처리하기 위해 Aperture가 아닌 블록체인에 지불하는 금액이에요. 네트워크를 운영하는 사람들에게 전달되며, 저희에게는 가지 않아요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinklo mokestis – tai, ką mokate blokų grandinei, o ne „Aperture“, kad būtų apdorota jūsų operacija. Jis atitenka žmonėms, palaikantiems tinklą, ir niekada – mums."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tīkla maksa ir tas, ko jūs maksājat blokķēdei, nevis Aperture, lai apstrādātu jūsu darījumu. Tā nonāk pie cilvēkiem, kuri uztur tīklu, nekad pie mums."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഇടപാട് പ്രോസസ്സ് ചെയ്യാൻ ബ്ലോക്ക്ചെയിനിന് നിങ്ങൾ നൽകുന്നതാണ് നെറ്റ്‌വർക്ക് ഫീസ് — Aperture-ന് അല്ല. ഇത് നെറ്റ്‌വർക്ക് നടത്തുന്നവർക്ക് പോകുന്നു, ഒരിക്കലും ഞങ്ങൾക്ക് അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा व्यवहार प्रक्रिया करण्यासाठी तुम्ही ब्लॉकचेनला देता ती नेटवर्क फी आहे — Aperture ला नाही. ती नेटवर्क चालवणाऱ्या लोकांकडे जाते, कधीही आमच्याकडे नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuran rangkaian ialah apa yang anda bayar kepada blockchain — bukan Aperture — untuk memproses transaksi anda. Ia pergi kepada orang yang mengendalikan rangkaian, bukan kepada kami."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverksgebyret er det du betaler til blokkjeden – ikke til Aperture – for å behandle transaksjonen din. Det går til dem som driver nettverket, aldri til oss."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een netwerkkosten is wat je aan de blockchain betaalt — niet aan Aperture — om je transactie te verwerken. Het gaat naar de mensen die het netwerk draaiende houden, nooit naar ons."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੈੱਟਵਰਕ ਫ਼ੀਸ ਉਹ ਹੈ ਜੋ ਤੁਸੀਂ ਆਪਣੇ ਲੈਣ-ਦੇਣ ਨੂੰ ਪ੍ਰੋਸੈੱਸ ਕਰਨ ਲਈ ਬਲਾਕਚੇਨ ਨੂੰ ਅਦਾ ਕਰਦੇ ਹੋ — Aperture ਨੂੰ ਨਹੀਂ। ਇਹ ਨੈੱਟਵਰਕ ਚਲਾਉਣ ਵਾਲੇ ਲੋਕਾਂ ਕੋਲ ਜਾਂਦੀ ਹੈ, ਕਦੇ ਸਾਡੇ ਕੋਲ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłata sieciowa to kwota, którą płacisz blockchainowi — a nie Aperture — za przetworzenie transakcji. Trafia do osób utrzymujących sieć, nigdy do nas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de rede é o que você paga à blockchain — não à Aperture — para processar sua transação. Ela vai para quem opera a rede, nunca para nós."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comisionul de rețea este ceea ce plătești blockchainului — nu Aperture — pentru a-ți procesa tranzacția. Ajunge la cei care operează rețeaua, niciodată la noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия сети — это плата блокчейну (а не Aperture) за обработку вашей транзакции. Она идёт тем, кто поддерживает работу сети, и никогда не достаётся нам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieťový poplatok je to, čo platíte blockchainu – nie Aperture – za spracovanie vašej transakcie. Putuje tým, ktorí prevádzkujú sieť, nikdy nie nám."
          }
