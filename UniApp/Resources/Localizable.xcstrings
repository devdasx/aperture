          "stringUnit": {
            "state": "translated",
            "value": "Kubadilisha hali kutatupa marusho %lld yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்முறையை மாற்றினால் உங்கள் %lld உருட்டல்கள் கைவிடப்படும்."
