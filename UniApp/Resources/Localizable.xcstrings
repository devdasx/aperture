          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Badilisha kati ya mitandao kwa mtiririko mmoja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே ஒட்டத்தில் சங்கிலிகளுக்கிடையே மாற்று."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకే ఫ్లోలో చైన్‌ల మధ్య స్వాప్ చేయండి."
