    "Your Face ID enrollment changed. Authenticate once to trust this iPhone again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou Face ID-registrasie het verander. Verifieer een keer om hierdie iPhone weer te vertrou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر تسجيل Face ID لديك. صادق مرة واحدة لاستعادة الثقة بهذا iPhone."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрацията ви на Face ID се промени. Удостоверете се веднъж, за да се доверите отново на този iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Face ID নিবন্ধন পরিবর্তিত হয়েছে। এই iPhone-কে আবার বিশ্বাস করতে একবার প্রমাণীকরণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu registre de Face ID ha canviat. Autentica't una vegada per tornar a confiar en aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše registrace Face ID se změnila. Jednou se ověřte, abyste tomuto iPhonu znovu důvěřovali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Face ID-registrering er ændret. Godkend én gang for at stole på denne iPhone igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Face-ID-Einrichtung hat sich geändert. Authentifizieren Sie sich einmal, um diesem iPhone wieder zu vertrauen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή σας στο Face ID άλλαξε. Πιστοποιηθείτε μία φορά για να εμπιστευτείτε ξανά αυτό το iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Face ID enrollment changed. Authenticate once to trust this iPhone again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro de Face ID ha cambiado. Autentícate una vez para volver a confiar en este iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu Face ID registreering on muutunud. Autentige üks kord, et seda iPhone'i uuesti usaldada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبت‌نام Face ID شما تغییر کرده است. یک بار احراز هویت کنید تا این iPhone دوباره مورد اعتماد قرار گیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID -rekisteröintisi muuttui. Tunnistaudu kerran luottaaksesi taas tähän iPhoneen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang iyong Face ID enrollment. Mag-authenticate minsan para mapagkatiwalaan muli ang iPhone na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre inscription Face ID a changé. Authentifiez-vous une fois pour faire à nouveau confiance à cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרישום של Face ID השתנה. אמת פעם אחת כדי לסמוך שוב על iPhone זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Face ID एनरोलमेंट बदला है। इस iPhone पर फिर से भरोसा करने के लिए एक बार प्रमाणीकरण करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša Face ID prijava promijenjena je. Autentificirajte se jednom kako biste ponovno vjerovali ovom iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Face ID-regisztrációja megváltozott. Hitelesítse magát egyszer, hogy újra megbízzon ebben az iPhone-ban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran Face ID Anda berubah. Autentikasi sekali untuk mempercayai iPhone ini lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID skráning þín hefur breyst. Auðkenndu þig einu sinni til að treysta þessum iPhone aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua registrazione Face ID è cambiata. Autenticati una volta per dare di nuovo fiducia a questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID の登録内容が変更されました。この iPhone を再度信頼するために、一度認証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 등록이 변경되었습니다. 이 iPhone을 다시 신뢰하려면 한 번 인증하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų Face ID registracija pasikeitė. Vieną kartą patvirtinkite tapatybę, kad vėl pasitikėtumėte šiuo „iPhone“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu Face ID reģistrācija ir mainījusies. Autentificējieties vienreiz, lai atkal uzticētos šim iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Face ID എൻറോൾമെന്റ് മാറി. ഈ iPhone-നെ വീണ്ടും വിശ്വസിക്കാൻ ഒരിക്കൽ ആധികാരികമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची Face ID नोंदणी बदलली आहे. या iPhone वर पुन्हा विश्वास ठेवण्यासाठी एकदा प्रमाणीकरण करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran Face ID anda berubah. Sahkan sekali untuk mempercayai iPhone ini sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID-registreringen din er endret. Autentiser deg én gang for å stole på denne iPhonen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Face ID-registratie is gewijzigd. Verifieer je eenmaal om deze iPhone weer te vertrouwen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ Face ID ਨਾਮਾਂਕਣ ਬਦਲ ਗਈ ਹੈ। ਇਸ iPhone 'ਤੇ ਮੁੜ ਭਰੋਸਾ ਕਰਨ ਲਈ ਇੱਕ ਵਾਰ ਪ੍ਰਮਾਣਿਤ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rejestracja Face ID się zmieniła. Uwierzytelnij się raz, aby ponownie zaufać temu iPhone’owi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu cadastro do Face ID mudou. Autentique-se uma vez para voltar a confiar neste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea Face ID s-a schimbat. Autentifică-te o dată pentru a avea din nou încredere în acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация Face ID изменилась. Пройдите аутентификацию один раз, чтобы снова доверять этому iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša registrácia Face ID sa zmenila. Raz sa overte, aby ste tomuto iPhonu opäť dôverovali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša registracija Face ID se je spremenila. Enkrat se overite, da boste temu iPhonu znova zaupali."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша Face ID регистрација је промењена. Аутентификујте се једном да поново верујете овом iPhone-у."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Face ID-registrering har ändrats. Autentisera dig en gång för att lita på denna iPhone igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usajili wako wa Face ID umebadilika. Thibitisha mara moja ili kuamini iPhone hii tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Face ID பதிவு மாறிவிட்டது. இந்த iPhone-ஐ மீண்டும் நம்ப ஒரு முறை அங்கீகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Face ID నమోదు మారింది. ఈ iPhone ను మళ్లీ నమ్మడానికి ఒకసారి ప్రామాణీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงทะเบียน Face ID ของคุณเปลี่ยนไปแล้ว ยืนยันตัวตนหนึ่งครั้งเพื่อให้ iPhone นี้น่าเชื่อถืออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID kaydınız değişti. Bu iPhone'a yeniden güvenmek için bir kez kimlik doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша реєстрація Face ID змінилася. Пройдіть автентифікацію один раз, щоб знову довіряти цьому iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا Face ID اندراج تبدیل ہو گیا ہے۔ اس iPhone پر دوبارہ اعتماد کرنے کے لیے ایک بار توثیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký Face ID của bạn đã thay đổi. Hãy xác thực một lần để tin tưởng chiếc iPhone này trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Face ID 注册信息已更改。请认证一次以再次信任此 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Face ID 註冊資訊已變更。請認證一次以再次信任此 iPhone。"
          }
        }
      }
    },
    "Your holdings will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your holdings will appear here."
          }
        }
      }
    },
    "Your key never leaves this iPhone. Aperture does not send it anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou sleutel verlaat hierdie iPhone nooit nie. Aperture stuur dit nêrens heen nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاحك لا يغادر هذا الـ iPhone أبدًا. ولا يرسله Aperture إلى أي مكان."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът ви никога не напуска този iPhone. Aperture не го изпраща никъде."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কী কখনোই এই iPhone ছাড়ে না। Aperture এটি কোথাও পাঠায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva clau no surt mai d'aquest iPhone. L'Aperture no l'envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš klíč nikdy neopustí tento iPhone. Aperture jej nikam neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nøgle forlader aldrig denne iPhone. Aperture sender den ikke nogen steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel verlässt dieses iPhone nie. Aperture sendet ihn nirgendwohin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί σας δεν φεύγει ποτέ από αυτό το iPhone. Το Aperture δεν το στέλνει πουθενά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave nunca sale de este iPhone. Aperture no la envía a ninguna parte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie võti ei lahku kunagi sellest iPhone’ist. Aperture ei saada seda kuhugi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید شما هرگز از این iPhone خارج نمی‌شود. Aperture آن را به هیچ جا نمی‌فرستد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimesi ei poistu koskaan tältä iPhonelta. Aperture ei lähetä sitä mihinkään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi umaalis sa iPhone na ito ang iyong susi. Hindi ito ipinapadala ng Aperture saanman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé ne quitte jamais cet iPhone. Aperture ne l’envoie nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח שלך לא יוצא לעולם מה-iPhone הזה. Aperture אינו שולח אותו לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुंजी कभी इस iPhone से बाहर नहीं जाती। Aperture इसे कहीं नहीं भेजता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ nikada ne napušta ovaj iPhone. Aperture ga nikamo ne šalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsa soha nem hagyja el ezt az iPhone-t. Az Aperture sehova nem küldi el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci Anda tidak pernah meninggalkan iPhone ini. Aperture tidak mengirimkannya ke mana pun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykillinn þinn yfirgefur þennan iPhone aldrei. Aperture sendir hann ekki neitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave non lascia mai questo iPhone. Aperture non la invia da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの鍵がこの iPhone から出ることはありません。Aperture がそれをどこかへ送ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 키는 이 iPhone을 벗어나지 않습니다. Aperture는 그것을 어디에도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų raktas niekada nepalieka šio iPhone. Aperture jo niekur nesiunčia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu atslēga nekad neatstāj šo iPhone. Aperture to nekur nenosūta."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കീ ഈ iPhone വിട്ടുപോകില്ല. Aperture അത് എവിടെയും അയയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची की हा iPhone कधीही सोडत नाही. Aperture ती कुठेही पाठवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci anda tidak pernah meninggalkan iPhone ini. Aperture tidak menghantarnya ke mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelen din forlater aldri denne iPhone-en. Aperture sender den ikke noe sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sleutel verlaat deze iPhone nooit. Aperture stuurt hem nergens naartoe."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਕੀ ਕਦੇ ਵੀ ਇਸ iPhone ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦੀ। Aperture ਇਸ ਨੂੰ ਕਿਤੇ ਨਹੀਂ ਭੇਜਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój klucz nigdy nie opuszcza tego iPhone’a. Aperture nigdzie go nie wysyła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave nunca sai deste iPhone. O Aperture não a envia para lugar nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia ta nu părăsește niciodată acest iPhone. Aperture nu o trimite nicăieri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ никогда не покидает этот iPhone. Aperture никуда его не отправляет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš kľúč nikdy neopustí tento iPhone. Aperture ho nikam neodosiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ tega iPhona nikoli ne zapusti. Aperture ga nikamor ne pošilja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш кључ никада не напушта овај iPhone. Aperture га нигде не шаље."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nyckel lämnar aldrig den här iPhone-enheten. Aperture skickar den inte någonstans."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufunguo wako hauondoki kamwe kwenye iPhone hii. Aperture hautumi popote."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாவி இந்த iPhone-ஐ விட்டு வெளியேறுவதில்லை. Aperture அதை எங்கும் அனுப்புவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కీ ఈ iPhone-ను వదిలి వెళ్ళదు. Aperture దాన్ని ఎక్కడికీ పంపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ของคุณไม่ออกจาก iPhone เครื่องนี้ Aperture ไม่ส่งคีย์ไปที่ใดทั้งสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarınız bu iPhone’dan asla çıkmaz. Aperture onu hiçbir yere göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ ніколи не залишає цей iPhone. Aperture нікуди його не надсилає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کی کبھی اس iPhone سے باہر نہیں جاتی۔ Aperture اسے کہیں نہیں بھیجتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa của bạn không bao giờ rời khỏi chiếc iPhone này. Aperture không gửi nó đi đâu cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密钥不会离开这部 iPhone。Aperture 不会把它发送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的金鑰不會離開這部 iPhone。Aperture 不會把它傳送到任何地方。"
          }
        }
      }
    },
