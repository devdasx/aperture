    "Paste an ERC-20-style contract address. Aperture reads name, symbol, and decimals directly from the contract.": {
      "extractionState": "new",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak 'n ERC-20-styl kontrakadres. Aperture lees naam, simbool en desimale direk vanaf die kontrak."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألصق عنوان عقد بنمط ERC-20. تقرأ Aperture الاسم والرمز والكسور العشرية مباشرة من العقد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете адрес на договор в стил ERC-20. Aperture чете името, символа и десетичните знаци директно от договора."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20-শৈলীর একটি কন্ট্রাক্ট ঠিকানা পেস্ট করুন। Aperture নাম, সিম্বল ও দশমিক সরাসরি কন্ট্রাক্ট থেকে পড়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enganxa una adreça de contracte d’estil ERC-20. Aperture llegeix el nom, el símbol i els decimals directament del contracte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte adresu kontraktu ve stylu ERC-20. Aperture čte název, symbol a desetinná místa přímo z kontraktu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt en kontraktadresse i ERC-20-stil. Aperture læser navn, symbol og decimaler direkte fra kontrakten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Vertragsadresse im ERC-20-Stil ein. Aperture liest Name, Symbol und Dezimalstellen direkt aus dem Vertrag."
