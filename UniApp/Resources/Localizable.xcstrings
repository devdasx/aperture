        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra cualquier filtro y orden seleccionado para los detalles del activo. ¿Continuar?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See tühjendab kõik vara üksikasjade filtri- ja sortimisvalikud. Kas jätkata?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار هر انتخاب فیلتر و مرتب‌سازی را برای جزئیات دارایی پاک می‌کند. ادامه می‌دهید؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tyhjentää kaikki suodattimet ja lajitteluasetukset omaisuuden tiedoissa. Jatketaanko?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Cli-clear nito ang bawat filter at sort na pinili para sa mga detalye ng asset. Magpatuloy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface tous les filtres et tris choisis pour les détails des actifs. Continuer ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תנקה את כל הסינונים והמיון בפרטי הנכס. להמשיך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे एसेट विवरण के सभी फ़िल्टर और सॉर्ट विकल्प साफ़ हो जाते हैं। जारी रखें?"
