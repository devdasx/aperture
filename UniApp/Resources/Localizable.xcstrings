        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne lommeboken har ennå ingen %@-adresse, så det finnes ingen sted å motta på dette nettverket. Aperture utleder kanskje fortsatt kontoene dine — prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
