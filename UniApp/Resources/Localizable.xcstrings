    "Type or paste your phrase, separating words with spaces. Order matters — the same words in a different order are a different wallet.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik of plak jou frase in en skei die woorde met spasies. Volgorde maak saak — dieselfde woorde in ’n ander volgorde is ’n ander beursie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب أو الصق عبارتك، مع الفصل بين الكلمات بمسافات. الترتيب مهم — فالكلمات نفسها بترتيب مختلف تعني محفظة مختلفة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете или поставете фразата си, като разделяте думите с интервали. Редът има значение — същите думи в различен ред са друг портфейл."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্পেস দিয়ে শব্দ আলাদা করে আপনার ফ্রেজ টাইপ বা পেস্ট করুন। ক্রম গুরুত্বপূর্ণ — একই শব্দ অন্য ক্রমে হলে অন্য ওয়ালেট হয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu o enganxa la teva frase i separa les paraules amb espais. L'ordre importa — les mateixes paraules en un altre ordre són una cartera diferent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište nebo vložte svou frázi a slova oddělte mezerami. Na pořadí záleží — stejná slova v jiném pořadí znamenají jinou peněženku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv eller indsæt din sætning, og adskil ordene med mellemrum. Rækkefølgen betyder noget — de samme ord i en anden rækkefølge er en anden wallet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine Phrase ein oder füge sie ein, getrennt durch Leerzeichen. Die Reihenfolge zählt – dieselben Wörter in anderer Reihenfolge sind eine andere Wallet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε ή επικολλήστε τη φράση σας, χωρίζοντας τις λέξεις με κενά. Η σειρά έχει σημασία — οι ίδιες λέξεις σε διαφορετική σειρά είναι άλλο πορτοφόλι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe o pega tu frase, separando las palabras con espacios. El orden importa: las mismas palabras en otro orden son otra cartera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestage või kleepige oma fraas, eraldades sõnad tühikutega. Järjekord on oluline — samad sõnad teises järjekorras on teine rahakott."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت خود را تایپ کنید یا بچسبانید و کلمات را با فاصله از هم جدا کنید. ترتیب مهم است — همان کلمات در ترتیبی دیگر، کیف پولی متفاوت هستند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita tai liitä lausekkeesi ja erota sanat välilyönnein. Järjestyksellä on merkitystä — samat sanat eri järjestyksessä muodostavat toisen lompakon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-type o i-paste ang iyong phrase, na pinaghihiwalay ang mga salita gamit ang space. Mahalaga ang pagkakasunod-sunod — ang parehong mga salita sa ibang ayos ay ibang wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ou collez votre phrase, en séparant les mots par des espaces. L’ordre compte — les mêmes mots dans un autre ordre forment un autre portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלד או הדבק את הביטוי שלך, והפרד בין המילים ברווחים. הסדר משנה — אותן מילים בסדר שונה הן ארנק אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना फ़्रेज़ लिखें या पेस्ट करें, शब्दों को स्पेस से अलग करें। क्रम महत्वपूर्ण है — वही शब्द किसी और क्रम में हों तो वह दूसरा वॉलेट हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upišite ili zalijepite svoju frazu i odvojite riječi razmacima. Redoslijed je važan — iste riječi u drugom redoslijedu drugačiji su novčanik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írja be vagy illessze be a kifejezést, a szavakat szóközökkel elválasztva. A sorrend számít — ugyanazok a szavak más sorrendben másik tárcát jelentenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik atau tempelkan frasa Anda, pisahkan kata-kata dengan spasi. Urutan itu penting — kata-kata yang sama dalam urutan berbeda adalah dompet yang berbeda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sláðu inn eða límdu setninguna þína og aðskildu orðin með bilum. Röðin skiptir máli — sömu orð í annarri röð eru annað veski."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita o incolla la tua frase, separando le parole con spazi. L’ordine conta — le stesse parole in un ordine diverso sono un altro portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズを入力するか貼り付けてください。単語はスペースで区切ります。順序が重要です——同じ単語でも順序が違えば別のウォレットになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 공백으로 구분해 구문을 입력하거나 붙여넣으세요. 순서가 중요합니다 — 같은 단어라도 순서가 다르면 다른 지갑입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite arba įklijuokite savo frazę, atskirdami žodžius tarpais. Eiliškumas svarbus – tie patys žodžiai kita tvarka yra kita piniginė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet vai ielīmējiet savu frāzi, atdalot vārdus ar atstarpēm. Secībai ir nozīme — tie paši vārdi citā secībā ir cits maks."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫ്രേസ് ടൈപ്പ് ചെയ്യുകയോ പേസ്റ്റ് ചെയ്യുകയോ ചെയ്യുക, വാക്കുകളെ സ്പേസുകൾ കൊണ്ട് വേർതിരിക്കുക. ക്രമം പ്രധാനമാണ് — ഒരേ വാക്കുകൾ വ്യത്യസ്ത ക്രമത്തിലാണെങ്കിൽ അവ വ്യത്യസ്ത വാലറ്റാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा फ्रेज टाइप किंवा पेस्ट करा, शब्दांना स्पेसने वेगळे करा. क्रम महत्त्वाचा आहे — तेच शब्द वेगळ्या क्रमात असल्यास ते वेगळे वॉलेट आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip atau tampal frasa anda, dengan memisahkan perkataan dengan ruang. Susunan penting — perkataan yang sama dalam susunan berbeza adalah dompet yang berbeza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv eller lim inn frasen din, og skill ordene med mellomrom. Rekkefølgen er viktig — de samme ordene i en annen rekkefølge er en annen lommebok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ of plak je zin en scheid de woorden met spaties. De volgorde is belangrijk — dezelfde woorden in een andere volgorde vormen een andere wallet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ਬਦਾਂ ਨੂੰ ਖਾਲੀ ਥਾਵਾਂ ਨਾਲ ਵੱਖ ਕਰਦਿਆਂ ਆਪਣਾ ਫ਼ਰੇਜ਼ ਟਾਈਪ ਕਰੋ ਜਾਂ ਪੇਸਟ ਕਰੋ। ਕ੍ਰਮ ਜ਼ਰੂਰੀ ਹੁੰਦਾ ਹੈ — ਉਹੀ ਸ਼ਬਦ ਵੱਖਰੇ ਕ੍ਰਮ ਵਿੱਚ ਹੋਣ ਤਾਂ ਉਹ ਇੱਕ ਵੱਖਰਾ ਵਾਲਿਟ ਬਣਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz lub wklej swoją frazę, oddzielając słowa spacjami. Kolejność ma znaczenie — te same słowa w innej kolejności tworzą inny portfel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite ou cole sua frase, separando as palavras com espaços. A ordem importa — as mesmas palavras em outra ordem formam outra carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu sau lipește fraza ta, separând cuvintele prin spații. Ordinea contează — aceleași cuvinte în altă ordine reprezintă un alt portofel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите или вставьте вашу фразу, разделяя слова пробелами. Порядок важен — те же слова в другом порядке — это другой кошелёк."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte alebo vložte svoju frázu a slová oddeľte medzerami. Na poradí záleží — tie isté slová v inom poradí znamenajú inú peňaženku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite ali prilepite svojo frazo in besede ločite s presledki. Vrstni red je pomemben — iste besede v drugačnem vrstnem redu so druga denarnica."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Унесите или налепите своју фразу и речи раздвојите размацима. Редослед је важан — исте речи у другом редоследу су други новчаник."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv eller klistra in din fras och separera orden med mellanslag. Ordningen är viktig — samma ord i en annan ordning blir en annan plånbok."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika au bandika kifungu chako, ukitenganisha maneno kwa nafasi. Mpangilio ni muhimu — maneno yale yale yakiwa kwa mpangilio tofauti ni pochi tofauti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சொற்றொடரைத் தட்டச்சு செய்யவும் அல்லது ஒட்டவும், சொற்களை இடைவெளிகளால் பிரிக்கவும். வரிசை முக்கியம் — அதே சொற்கள் வேறு வரிசையில் இருந்தால் அது வேறு வாலட்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫ్రేజ్‌ను టైప్ చేయండి లేదా పేస్ట్ చేయండి, పదాలను స్పేస్‌లతో వేరు చేయండి. క్రమం ముఖ్యం — అదే పదాలు వేరే క్రమంలో ఉంటే అవి వేరే వాలెట్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์หรือวางวลีของคุณ โดยคั่นคำด้วยเว้นวรรค ลำดับสำคัญ — คำเดียวกันในลำดับที่ต่างกันคือกระเป๋าคนละใบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfadenizi yazın ya da yapıştırın; sözcükleri boşluklarla ayırın. Sıralama önemlidir — aynı sözcükler farklı bir sırada başka bir cüzdandır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть або вставте вашу фразу, відокремлюючи слова пробілами. Порядок має значення — ті самі слова в іншому порядку — це вже інший гаманець."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا فریز ٹائپ یا پیسٹ کریں اور الفاظ کو خالی جگہوں سے الگ کریں۔ ترتیب اہم ہے — وہی الفاظ مختلف ترتیب میں ایک مختلف والیٹ بنتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập hoặc dán cụm từ của bạn, các từ cách nhau bằng dấu cách. Thứ tự rất quan trọng — cùng những từ đó nhưng thứ tự khác sẽ là một ví khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入或粘贴你的短语,用空格分隔每个单词。顺序很重要——同样的单词换个顺序就是另一个钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入或貼上你的短語,並以空白分隔每個單字。順序很重要——相同的單字換個順序就是另一個錢包。"
          }
        }
      }
    },
