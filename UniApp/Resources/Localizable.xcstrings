    "Disconnecting revokes a dApp's account access. It can't read your address again until you re-connect.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om te ontkoppel herroep 'n dApp se toegang tot die rekening. Dit kan jou adres nie weer lees nie totdat jy weer koppel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدّي قطع الاتّصال إلى إلغاء وصول تطبيق dApp إلى حسابك. ولن يتمكّن من قراءة عنوانك مجدّدًا حتى تُعيد الاتّصال."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекъсването на връзката отменя достъпа на dApp до акаунта. То няма да може да чете адреса Ви отново, докато не се свържете повторно."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ বিচ্ছিন্ন করলে কোনো dApp-এর আপনার অ্যাকাউন্টে প্রবেশাধিকার প্রত্যাহার হয়। আপনি পুনরায় সংযোগ না করা পর্যন্ত এটি আপনার ঠিকানা আর পড়তে পারবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconnectar revoca l’accés d’una dApp al teu compte. No podrà tornar a llegir la teva adreça fins que et tornis a connectar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojení odvolá přístup dApp k vašemu účtu. Vaši adresu už nepřečte, dokud se znovu nepřipojíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At afbryde forbindelsen tilbagekalder en dApps adgang til din konto. Den kan ikke læse din adresse igen, før du opretter forbindelse på ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Trennen wird der Kontozugriff einer dApp widerrufen. Sie kann Ihre Adresse erst wieder lesen, wenn Sie sich erneut verbinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποσύνδεση ανακαλεί την πρόσβαση μιας dApp στον λογαριασμό σας. Δεν θα μπορεί να διαβάσει ξανά τη διεύθυνσή σας μέχρι να επανασυνδεθείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting revokes a dApp's account access. It can't read your address again until you re-connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar revoca el acceso de una dApp a tu cuenta. No podrá volver a leer tu dirección hasta que vuelvas a conectarte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühenduse katkestamine tühistab dAppi juurdepääsu kontole. See ei saa sinu aadressi enam lugeda, kuni uuesti ühendud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع اتصال، دسترسی حساب یک dApp را لغو می‌کند. تا زمانی که دوباره متصل نشوید، نمی‌تواند نشانی شما را دوباره بخواند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteyden katkaiseminen peruu dApp-sovelluksen pääsyn tiliisi. Se ei voi lukea osoitettasi uudelleen, ennen kuin yhdistät uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagdiskonekta ay binabawi ang access ng isang dApp sa account. Hindi na nito mababasa muli ang iyong address hangga't hindi ka muling kumokonekta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion révoque l’accès d’une dApp à votre compte. Elle ne pourra plus lire votre adresse tant que vous ne vous reconnectez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוק החיבור מבטל את גישת ה-dApp לחשבון שלך. היא לא תוכל לקרוא את הכתובת שלך שוב עד שתתחבר מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्कनेक्ट करने से किसी dApp की आपके खाते तक पहुँच रद्द हो जाती है। जब तक आप दोबारा कनेक्ट नहीं करते, वह आपका पता दोबारा नहीं पढ़ सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekid veze opoziva pristup dApp-a vašem računu. Neće moći ponovno pročitati vašu adresu dok se ponovno ne povežete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leválasztás visszavonja egy dApp hozzáférését a fiókjához. Csak akkor olvashatja újra a címét, ha ismét csatlakozik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutus koneksi akan mencabut akses akun sebuah dApp. dApp tidak dapat membaca alamat Anda lagi hingga Anda menghubungkan kembali."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Að aftengja afturkallar aðgang dApp að reikningnum. Það getur ekki lesið vistfangið þitt aftur fyrr en þú tengist á ný."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disconnessione revoca l’accesso di una dApp al suo account. Non potrà più leggere il suo indirizzo finché non si riconnette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切断すると、dApp によるアカウントへのアクセスが取り消されます。再接続するまで、あなたのアドレスを再び読み取ることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 끊으면 dApp의 계정 접근 권한이 취소돼요. 다시 연결하기 전까지는 주소를 다시 읽을 수 없어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsijungus atšaukiama dApp prieiga prie paskyros. Ji nebegalės nuskaityti jūsų adreso, kol vėl neprisijungsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atvienošanās atsauc dApp piekļuvi kontam. Tā vairs nevarēs nolasīt jūsu adresi, līdz jūs atkārtoti izveidosiet savienojumu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിച്ഛേദിക്കുന്നത് ഒരു dApp-ന്റെ അക്കൗണ്ട് ആക്സസ് പിൻവലിക്കുന്നു. നിങ്ങൾ വീണ്ടും കണക്റ്റ് ചെയ്യുന്നതുവരെ അതിന് നിങ്ങളുടെ വിലാസം വീണ്ടും വായിക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन तोडल्याने एखाद्या dApp चा खात्यावरील प्रवेश रद्द होतो. तुम्ही पुन्हा कनेक्ट होईपर्यंत ते तुमचा पत्ता पुन्हा वाचू शकत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutuskan sambungan membatalkan akses akaun sesebuah dApp. Ia tidak boleh membaca alamat anda semula sehingga anda menyambung semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å koble fra tilbakekaller en dApps tilgang til kontoen din. Den kan ikke lese adressen din igjen før du kobler til på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het verbreken van de verbinding trek je de accounttoegang van een dApp in. Die kan je adres pas weer lezen als je opnieuw verbindt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਨੈਕਸ਼ਨ ਤੋੜਨ ਨਾਲ ਕਿਸੇ dApp ਦੀ ਖਾਤਾ ਪਹੁੰਚ ਰੱਦ ਹੋ ਜਾਂਦੀ ਹੈ। ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਮੁੜ ਕਨੈਕਟ ਨਹੀਂ ਹੁੰਦੇ, ਇਹ ਤੁਹਾਡਾ ਪਤਾ ਦੁਬਾਰਾ ਨਹੀਂ ਪੜ੍ਹ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozłączenie cofa dostęp dApp do konta. Nie odczyta ona ponownie Twojego adresu, dopóki nie połączysz się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar revoga o acesso de uma dApp à sua conta. Ela não poderá ler seu endereço novamente até você reconectar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectarea revocă accesul unei dApp la contul tău. Nu îți va mai putea citi adresa până când te reconectezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключение отзывает доступ dApp к вашему аккаунту. Оно не сможет снова прочитать ваш адрес, пока вы не подключитесь повторно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojenie odvolá prístup dApp k vášmu účtu. Vašu adresu už neprečíta, kým sa znova nepripojíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekinitev povezave prekliče dostop dApp do vašega računa. Vašega naslova ne bo mogel znova prebrati, dokler se znova ne povežete."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекид везе опозива приступ dApp-а вашем налогу. Неће моћи поново да прочита вашу адресу док се поново не повежете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att koppla från återkallar en dApp:s åtkomst till ditt konto. Den kan inte läsa din adress igen förrän du återansluter."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukata muunganisho hutengua ufikiaji wa akaunti wa dApp. Haitaweza kusoma anwani yako tena hadi uunganishe upya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்பை துண்டிப்பது ஒரு dApp இன் கணக்கு அணுகலைத் திரும்பப் பெறுகிறது. நீங்கள் மீண்டும் இணைக்கும் வரை அது உங்கள் முகவரியை மீண்டும் படிக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డిస్‌కనెక్ట్ చేయడం ఒక dApp యొక్క ఖాతా యాక్సెస్‌ను ఉపసంహరిస్తుంది. మీరు మళ్లీ కనెక్ట్ అయ్యే వరకు అది మీ చిరునామాను మళ్లీ చదవలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยกเลิกการเชื่อมต่อจะเพิกถอนสิทธิ์การเข้าถึงบัญชีของ dApp โดยจะอ่านที่อยู่ของคุณอีกไม่ได้จนกว่าคุณจะเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı kesmek, bir dApp’in hesap erişimini iptal eder. Yeniden bağlanana kadar adresinizi tekrar okuyamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відключення відкликає доступ dApp до вашого облікового запису. Воно не зможе знову прочитати вашу адресу, доки ви не під’єднаєтеся повторно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنکشن منقطع کرنے سے کسی dApp کی اکاؤنٹ رسائی منسوخ ہو جاتی ہے۔ جب تک آپ دوبارہ منسلک نہیں ہوتے، یہ آپ کا پتہ دوبارہ نہیں پڑھ سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngắt kết nối sẽ thu hồi quyền truy cập tài khoản của một dApp. Nó không thể đọc lại địa chỉ của bạn cho đến khi bạn kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接会撤销 dApp 对你账户的访问权限。在你重新连接之前,它无法再次读取你的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷連線會撤銷 dApp 對你帳戶的存取權。在你重新連線之前,它無法再次讀取你的位址。"
          }
        }
      }
    },
