        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokių paskyrų. Jokių serverių. Jokios analitikos, stebinčios jūsų likučius. Jokios pagalbos komandos, kurios kažkas galėtų apsimesti."
