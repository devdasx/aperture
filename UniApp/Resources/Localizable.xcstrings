    "None of the entries validated for %@. Tap back and check each address or key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تنجح أيٌّ من المدخلات في التحقّق لـ %@. ارجع للخلف وراجع كل عنوان أو مفتاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর জন্য কোনো এন্ট্রি যাচাই হয়নি। ফিরে যান এবং প্রতিটি ঠিকানা বা key পরীক্ষা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap entrada s’ha validat per a %@. Torna enrere i revisa cada adreça o clau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný záznam pro %@ neprošel ověřením. Vraťte se a zkontrolujte každou adresu nebo klíč."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen af posterne blev valideret for %@. Tryk tilbage, og kontrollér hver adresse eller nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner der Einträge konnte für %@ validiert werden. Gehe zurück und prüfe jede Adresse oder jeden Schlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία καταχώριση δεν επικυρώθηκε για το %@. Πατήστε πίσω και ελέγξτε κάθε διεύθυνση ή κλειδί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna de las entradas se ha validado para %@. Vuelve atrás y comprueba cada dirección o clave."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ‌یک از ورودی‌ها برای %@ معتبر نشد. بازگردید و هر نشانی یا کلید را بررسی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään syöte ei kelpaa kohteelle %@. Palaa takaisin ja tarkista jokainen osoite tai avain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune des entrées n’a été validée pour %@. Revenez en arrière et vérifiez chaque adresse ou clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף ערך לא אומת עבור %@. אפשר לחזור ולבדוק כל כתובת או מפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए कोई भी एंट्री वैध नहीं हुई। पीछे जाएँ और हर पता या key जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan unos nije potvrđen za %@. Vratite se i provjerite svaku adresu ili ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen bejegyzés sem érvényesült a(z) %@ esetén. Lépj vissza, és ellenőrizd minden címet vagy kulcsot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada entri yang tervalidasi untuk %@. Ketuk kembali dan periksa setiap alamat atau kunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna delle voci è stata convalidata per %@. Tocchi Indietro e controlli ogni indirizzo o chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で検証された項目はありません。戻って各アドレスまたはキーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대해 검증된 항목이 하나도 없어요. 뒤로 돌아가 각 주소나 키를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av oppføringene ble validert for %@. Trykk tilbake og kontroller hver adresse eller nøkkel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen van de vermeldingen is gevalideerd voor %@. Tik terug en controleer elk adres of sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden z wpisów nie przeszedł walidacji dla sieci %@. Wróć i sprawdź każdy adres lub klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma entrada foi validada para %@. Toque em voltar e confira cada endereço ou chave."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio intrare nu a fost validată pentru %@. Apasă înapoi și verifică fiecare adresă sau cheie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна запись не прошла проверку для %@. Вернитесь назад и проверьте каждый адрес или ключ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny záznam pre %@ neprešiel overením. Vráťte sa a skontrolujte každú adresu alebo kľúč."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noben vnos ni bil potrjen za %@. Pojdite nazaj in preverite vsak naslov ali ključ."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниједан унос није потврђен за %@. Идите назад и проверите сваку адресу или кључ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga av posterna validerades för %@. Tryck tillbaka och kontrollera varje adress eller nyckel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
