        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture stima automaticamente il limite di gas. Modificalo solo se sai che la transazione ne richiede di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture はガスリミットを自動で見積もります。取引にさらに必要だとわかっている場合のみ変更してください。"
