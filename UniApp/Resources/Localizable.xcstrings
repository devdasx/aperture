    "Only assets the recipient's network can receive are shown.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Slegs bates wat die ontvanger se netwerk kan ontvang, word gewys."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض فقط الأصول التي يمكن لشبكة المستلم استلامها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показани са само активи, които мрежата на получателя може да получи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাপকের নেটওয়ার্ক যে সম্পদগুলো গ্রহণ করতে পারে শুধু সেগুলোই দেখানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només es mostren els actius que la xarxa del destinatari pot rebre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazena jsou jen aktiva, která síť příjemce může přijmout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun aktiver, som modtagerens netværk kan modtage, vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Assets angezeigt, die das Netzwerk des Empfängers empfangen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζονται μόνο τα στοιχεία που μπορεί να λάβει το δίκτυο του παραλήπτη."
