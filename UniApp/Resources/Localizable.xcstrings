    "NEAR keeps a small amount locked for account storage; it can't be sent.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR hou 'n klein bedrag gesluit vir rekeningberging; dit kan nie gestuur word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ NEAR بمبلغ صغير مقفل لتخزين الحساب؛ لا يمكن إرساله."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR държи малка сума заключена за съхранение на акаунта; тя не може да бъде изпратена."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR অ্যাকাউন্ট স্টোরেজের জন্য সামান্য পরিমাণ লক করে রাখে; এটি পাঠানো যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR manté una petita quantitat bloquejada per a l'emmagatzematge del compte; no es pot enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR drží malou částku uzamčenou pro úložiště účtu; nelze ji odeslat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR holder et lille beløb låst til kontolagring; det kan ikke sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR hält einen kleinen Betrag für den Kontospeicher gesperrt; er kann nicht gesendet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το NEAR διατηρεί ένα μικρό ποσό κλειδωμένο για την αποθήκευση λογαριασμού· δεν μπορεί να αποσταλεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR mantiene una pequeña cantidad bloqueada para el almacenamiento de la cuenta; no se puede enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR hoiab väikese summa lukus konto salvestamiseks; seda ei saa saata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR مقدار کمی را برای ذخیره‌سازی حساب قفل نگه می‌دارد؛ این مقدار قابل ارسال نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR pitää pienen määrän lukittuna tilin tallennusta varten; sitä ei voi lähettää."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinanatili ng NEAR ang maliit na halaga na naka-lock para sa storage ng account; hindi ito maipapadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR conserve un petit montant verrouillé pour le stockage du compte ; il ne peut pas être envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎NEAR שומר סכום קטן נעול לאחסון החשבון; לא ניתן לשלוח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR अकाउंट स्टोरेज के लिए एक छोटी राशि लॉक रखता है; इसे भेजा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR zadržava mali iznos zaključan za pohranu računa; ne može se poslati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NEAR egy kis összeget zárolva tart a fióktárolásra; ez nem küldhető el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR mengunci sejumlah kecil untuk penyimpanan akun; tidak dapat dikirim."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR heldur lítilli upphæð læstri fyrir reikningsgeymslu; ekki er hægt að senda hana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR mantiene bloccata una piccola quantità per l'archiviazione dell'account; non può essere inviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR はアカウントストレージのために少額をロックして保持します。これは送金できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR는 계정 저장을 위해 소액을 잠가 둡니다. 이는 전송할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR užrakina nedidelę sumą paskyros saugojimui; jos siųsti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR patur nelielu summu bloķētu konta krātuvei; to nevar nosūtīt."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്കൗണ്ട് സ്റ്റോറേജിനായി NEAR ഒരു ചെറിയ തുക ലോക്ക് ചെയ്തുവയ്ക്കുന്നു; അത് അയയ്ക്കാനാവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR खाते संचयनासाठी थोडी रक्कम लॉक करून ठेवते; ती पाठवता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR mengunci sejumlah kecil untuk storan akaun; ia tidak boleh dihantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR holder et lite beløp låst til kontolagring; det kan ikke sendes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR houdt een klein bedrag vast voor accountopslag; dit kan niet worden verzonden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR ਖਾਤਾ ਸਟੋਰੇਜ ਲਈ ਥੋੜ੍ਹੀ ਰਕਮ ਲੌਕ ਰੱਖਦਾ ਹੈ; ਇਸਨੂੰ ਭੇਜਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR utrzymuje niewielką kwotę zablokowaną na przechowywanie konta; nie można jej wysłać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A NEAR mantém uma pequena quantia bloqueada para armazenamento da conta; ela não pode ser enviada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR păstrează blocată o sumă mică pentru stocarea contului; nu poate fi trimisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR удерживает небольшую сумму для хранения счёта; её нельзя отправить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR ponechá malú sumu zamknutú na úložisko účtu; nedá sa odoslať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR ohrani majhen znesek zaklenjen za shranjevanje računa; ni ga mogoče poslati."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR drži malu količinu zaključanu za skladištenje naloga; ne može se poslati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR håller en liten summa låst för kontolagring; den kan inte skickas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR huweka kiasi kidogo kimefungwa kwa hifadhi ya akaunti; hakiwezi kutumwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணக்குச் சேமிப்பிற்காக NEAR ஒரு சிறிய தொகையைப் பூட்டி வைக்கிறது; அதை அனுப்ப முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతా నిల్వ కోసం NEAR కొద్ది మొత్తాన్ని లాక్ చేసి ఉంచుతుంది; దాన్ని పంపలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR ล็อกจำนวนเล็กน้อยไว้สำหรับพื้นที่จัดเก็บบัญชี ซึ่งไม่สามารถส่งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR, hesap depolaması için küçük bir miktarı kilitli tutar; bu gönderilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NEAR утримує невелику суму заблокованою для зберігання рахунку; її неможливо надіслати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
