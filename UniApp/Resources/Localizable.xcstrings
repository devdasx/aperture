        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte kľúč k vášmu \\(chain.displayName) účtu. Aperture pred odvodením akejkoľvek adresy skontroluje formát a kľúč nikdy neopustí tento iPhone."
