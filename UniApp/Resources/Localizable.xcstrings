        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ваші фрази відновлення не записані, кожен гаманець без резервної копії буде втрачено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ نے اپنے ریکوری فقرے نہیں لکھے، تو جس والٹ کا آپ نے بیک اپ نہیں لیا وہ کھو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn không ghi lại các cụm từ khôi phục, mọi ví bạn chưa sao lưu sẽ bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你没有抄写过助记词,任何未备份的钱包都会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你沒有抄寫過助記詞,任何未備份的錢包都會遺失。"
