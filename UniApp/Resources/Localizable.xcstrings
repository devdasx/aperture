    "Your recovery phrase is saved. You can find your wallet on the main screen.": {
      "comment": "Wallet-ready terminal screen body.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou herstelfrase is gestoor. Jy kan jou beursie op die hoofskerm vind."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ عبارة الاسترداد. ستجد محفظتك في الشاشة الرئيسية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашата фраза за възстановяване е запазена. Можете да намерите портфейла си на основния екран."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিকভারি ফ্রেজ সংরক্ষিত হয়েছে। মূল স্ক্রিনে আপনি আপনার ওয়ালেট খুঁজে পাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva frase de recuperació s’ha desat. Trobaràs la cartera a la pantalla principal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše obnovovací fráze je uložena. Peněženku najdete na hlavní obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gendannelsessætning er gemt. Du finder din tegnebog på startskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Wiederherstellungsphrase ist gesichert. Ihr Wallet finden Sie auf dem Hauptbildschirm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φράση ανάκτησής σας αποθηκεύτηκε. Μπορείτε να βρείτε το πορτοφόλι σας στην κύρια οθόνη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery phrase is saved. You can find your wallet on the main screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frase de recuperación está guardada. Encontrarás tu cartera en la pantalla principal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu taastefraas on salvestatud. Leiad oma rahakoti põhikuvalt."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت بازیابی شما ذخیره شد. می‌توانید کیف پول خود را در صفحهٔ اصلی پیدا کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautuslauseesi on tallennettu. Löydät lompakkosi pääruudulta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save na ang iyong recovery phrase. Mahahanap mo ang iyong wallet sa main screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre phrase de récupération est enregistrée. Vous trouverez votre portefeuille sur l’écran principal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטוי השחזור שלך נשמר. אפשר למצוא את הארנק במסך הראשי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका रिकवरी फ़्रेज़ सहेज लिया गया है। आपका वॉलेट मुख्य स्क्रीन पर मिल जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša fraza za oporavak je spremljena. Novčanik je dostupan na glavnom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyreállítási kifejezést elmentettük. A tárcáját a főképernyőn találja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa pemulihan Anda telah disimpan. Anda dapat menemukan dompet Anda di layar utama."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurheimtarsetningin þín er vistuð. Þú finnur veskið þitt á aðalskjánum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua frase di ripristino è salvata. Può trovare il suo portafoglio nella schermata principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを保存しました。ウォレットはメイン画面で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 문구가 저장되었습니다. 메인 화면에서 지갑을 확인할 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų atkūrimo frazė įrašyta. Savo piniginę rasite pagrindiniame ekrane."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu atkopšanas frāze ir saglabāta. Savu maku atradīsiet galvenajā ekrānā."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വീണ്ടെടുക്കൽ വാക്യം സംരക്ഷിച്ചു. പ്രധാന സ്ക്രീനിൽ നിങ്ങളുടെ വാലറ്റ് കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची रिकव्हरी फ्रेज सेव्ह झाली आहे. तुमचं वॉलेट मुख्य स्क्रीनवर सापडेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa pemulihan anda telah disimpan. Anda boleh menemui dompet anda di skrin utama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprettingsfrasen er lagret. Du finner lommeboken på hovedskjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je herstelzin is opgeslagen. Je vindt je wallet op het hoofdscherm."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਰਿਕਵਰੀ ਫਰੇਜ਼ ਸੇਵ ਹੋ ਗਈ ਹੈ। ਤੁਸੀਂ ਆਪਣਾ ਵਾਲਿਟ ਮੁੱਖ ਸਕ੍ਰੀਨ ਉੱਤੇ ਲੱਭ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraza odzyskiwania została zapisana. Portfel znajdziesz na ekranie głównym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frase de recuperação está salva. Você encontra sua carteira na tela inicial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Expresia ta de recuperare e salvată. Portofelul tău e pe ecranul principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановительная фраза сохранена. Кошелёк находится на главном экране."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša obnovovacia fráza je uložená. Peňaženku nájdete na hlavnej obrazovke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša obnovitvena fraza je shranjena. Denarnico najdete na glavnem zaslonu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша фраза за опоравак је сачувана. Новчаник можете наћи на главном екрану."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din återställningsfras är sparad. Du hittar din plånbok på huvudskärmen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifungu chako cha urejesho kimehifadhiwa. Utapata pochi yako kwenye skrini kuu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மீட்பு சொற்றொடர் சேமிக்கப்பட்டுவிட்டது. முதன்மை திரையில் உங்கள் பணப்பையை காணலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రికవరీ ఫ్రేజ్ సేవ్ చేయబడింది. మీరు మీ వాలెట్‌ను ప్రధాన స్క్రీన్‌లో చూడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกวลีกู้คืนของคุณแล้ว คุณสามารถพบกระเป๋าของคุณได้บนหน้าจอหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma ifadeniz kaydedildi. Cüzdanınızı ana ekranda bulabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашу фразу відновлення збережено. Гаманець доступний на головному екрані."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ریکوری فریز محفوظ ہو گیا ہے۔ آپ اپنا والٹ مین اسکرین پر تلاش کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cụm từ khôi phục của bạn đã được lưu. Bạn có thể tìm thấy ví của mình trên màn hình chính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的恢复短语已保存。可以在主屏幕上找到你的钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的復原短語已儲存。可以在主畫面找到你的錢包。"
          }
        }
      }
    },
    "Your recovery phrase is stored encrypted on this iPhone (AES-GCM 256-bit, Keychain). Tap \"View recovery phrase\" anytime — the phrase never leaves this device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou herstelfrase word versleuteld op hierdie iPhone gestoor (AES-GCM 256-bis, Keychain). Tik enige tyd op \"Wys herstelsin\" — die frase verlaat nooit hierdie toestel nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن عبارة الاسترداد الخاصة بك مشفّرة على هذا iPhone (AES-GCM 256-bit، Keychain). اضغط على \"عرض عبارة الاسترداد\" في أي وقت — لا تغادر العبارة هذا الجهاز أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фразата ви за възстановяване се съхранява криптирана на този iPhone (AES-GCM 256-битов, Keychain). Докоснете „Виж фразата за възстановяване“ по всяко време — фразата никога не напуска това устройство."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিকভারি ফ্রেজ এই iPhone-এ এনক্রিপ্ট করে সংরক্ষিত থাকে (AES-GCM 256-bit, Keychain)। যেকোনো সময় \"রিকভারি ফ্রেজ দেখুন\"-এ ট্যাপ করুন — ফ্রেজটি কখনও এই ডিভাইস ছাড়ে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva frase de recuperació es desa xifrada en aquest iPhone (AES-GCM 256-bit, Keychain). Toca \"Mostra la frase de recuperació\" en qualsevol moment — la frase no surt mai d'aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše fráze pro obnovení je uložena šifrovaně na tomto iPhonu (AES-GCM 256bitové, Keychain). Kdykoli klepněte na „Zobrazit frázi pro obnovení“ — fráze nikdy neopustí toto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gendannelsessætning gemmes krypteret på denne iPhone (AES-GCM 256-bit, Keychain). Tryk på \"Vis gendannelsessætning\" når som helst — sætningen forlader aldrig denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wiederherstellungsphrase wird verschlüsselt auf diesem iPhone gespeichert (AES-GCM 256-Bit, Keychain). Tippe jederzeit auf „Wiederherstellungsphrase anzeigen“ – die Phrase verlässt dieses Gerät nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φράση ανάκτησής σου αποθηκεύεται κρυπτογραφημένη σε αυτό το iPhone (AES-GCM 256-bit, Keychain). Άγγιξε «Προβολή φράσης ανάκτησης» οποιαδήποτε στιγμή — η φράση δεν φεύγει ποτέ από αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frase de recuperación se guarda cifrada en este iPhone (AES-GCM 256 bits, Keychain). Toca \"Ver frase de recuperación\" cuando quieras: la frase nunca sale de este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu taastefraas on sellele iPhone'ile salvestatud krüpteeritult (AES-GCM 256-bitine, Keychain). Puuduta igal ajal „Kuva taastefraas\" — fraas ei lahku kunagi sellelt seadmelt."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت بازیابی شما به‌صورت رمزگذاری‌شده روی این iPhone ذخیره می‌شود (AES-GCM 256-bit، Keychain). هر زمان روی «مشاهده عبارت بازیابی» ضربه بزنید — عبارت هرگز این دستگاه را ترک نمی‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautuslauseesi tallennetaan salattuna tähän iPhoneen (AES-GCM 256-bittinen, Keychain). Napauta milloin tahansa \"Näytä palautuslause\" — lause ei poistu koskaan tältä laitteelta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang recovery phrase mo ay naka-encrypt na nakaimbak sa iPhone na ito (AES-GCM 256-bit, Keychain). I-tap ang \"Tingnan ang recovery phrase\" kahit kailan — hindi umaalis ang phrase sa device na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre phrase de récupération est stockée chiffrée sur cet iPhone (AES-GCM 256 bits, Keychain). Touchez « Afficher la phrase de récupération » à tout moment — la phrase ne quitte jamais cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטוי השחזור שלך מאוחסן מוצפן ב‎iPhone הזה (AES-GCM 256-bit, Keychain). הקש על \"הצג ביטוי שחזור\" בכל עת — הביטוי לעולם לא עוזב את המכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रिकवरी फ्रेज इस iPhone पर एन्क्रिप्टेड रूप में संग्रहीत है (AES-GCM 256-बिट, Keychain)। कभी भी \"रिकवरी फ्रेज देखें\" पर टैप करें — फ्रेज कभी इस डिवाइस को नहीं छोड़ती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja fraza za oporavak pohranjena je šifrirana na ovom iPhoneu (AES-GCM 256-bitna, Keychain). U bilo kojem trenutku dodirni „Prikaži frazu za oporavak\" — fraza nikada ne napušta ovaj uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyreállítási kifejezésed titkosítva tárolódik ezen az iPhone-on (AES-GCM 256 bites, Keychain). Bármikor koppints a „Helyreállítási kifejezés megtekintése\" lehetőségre — a kifejezés soha nem hagyja el ezt a készüléket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa pemulihan Anda disimpan terenkripsi di iPhone ini (AES-GCM 256-bit, Keychain). Ketuk \"Lihat frasa pemulihan\" kapan saja — frasa tidak pernah meninggalkan perangkat ini."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurheimtuorðin þín eru geymd dulkóðuð á þessum iPhone (AES-GCM 256-bita, Keychain). Ýttu á „Sýna endurheimtuorð\" hvenær sem er — orðin yfirgefa aldrei þetta tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua frase di recupero è memorizzata cifrata su questo iPhone (AES-GCM 256 bit, Keychain). Tocca \"Visualizza frase di recupero\" in qualsiasi momento — la frase non lascia mai questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
