          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ചെയിനിലെയും നിങ്ങളുടെ വിലാസം കാണാൻ സ്വീകരിക്കുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
