    "Authentication failed — the revoke wasn’t sent.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasie het misluk — die herroeping is nie gestuur nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المصادقة — لم يُرسَل الإلغاء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Удостоверяването е неуспешно — отмяната не беше изпратена."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রমাণীকরণ ব্যর্থ — প্রত্যাহার পাঠানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autenticació ha fallat — la revocació no s’ha enviat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověření selhalo — odvolání nebylo odesláno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelsen mislykkedes — tilbagekaldet blev ikke sendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizierung fehlgeschlagen — der Widerruf wurde nicht gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ταυτοποίηση απέτυχε — η ανάκληση δεν στάλθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed — the revoke wasn’t sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación falló — la revocación no se envió."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentimine ebaõnnestus — tühistust ei saadetud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "احراز هویت ناموفق بود — لغو ارسال نشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Todennus epäonnistui — peruutusta ei lähetetty."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigo ang pag-authenticate — hindi naipadala ang pagbawi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’authentification — la révocation n’a pas été envoyée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האימות נכשל — הביטול לא נשלח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणीकरण विफल — रद्द अनुरोध नहीं भेजा गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifikacija nije uspjela — opoziv nije poslan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hitelesítés sikertelen — a visszavonás nem lett elküldve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi gagal — pencabutan tidak terkirim."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Auðkenning mistókst — afturköllunin var ekki send."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticazione non riuscita — la revoca non è stata inviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に失敗しました — 取り消しは送信されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증에 실패했어요 — 취소가 전송되지 않았어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifikavimas nepavyko — atšaukimas neišsiųstas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifikācija neizdevās — atsaukums netika nosūtīts."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രാമാണീകരണം പരാജയപ്പെട്ടു — പിൻവലിക്കൽ അയച്ചില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणीकरण अयशस्वी झाले — रद्द करणे पाठवले गेले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengesahan gagal — pembatalan tidak dihantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentiseringen mislyktes — tilbakekallet ble ikke sendt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificatie mislukt — de intrekking is niet verzonden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਮਾਣੀਕਰਨ ਅਸਫਲ ਰਿਹਾ — ਰੱਦ ਕਰਨਾ ਨਹੀਂ ਭੇਜਿਆ ਗਿਆ।"
