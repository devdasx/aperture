          "stringUnit": {
            "state": "translated",
            "value": "Fără conturi. Fără servere. Portofelul tău trăiește pe iPhone-ul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никаких аккаунтов. Никаких серверов. Ваш кошелёк живёт на вашем iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadne účty. Žiadne servery. Vaša peňaženka žije na vašom iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez računov. Brez strežnikov. Vaša denarnica živi na vašem iPhoneu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без налога. Без сервера. Ваш новчаник живи на вашем iPhone-у."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga konton. Inga servrar. Din plånbok bor på din iPhone."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna akaunti. Hakuna seva. Pochi yako iko ndani ya iPhone yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தக் கணக்கும் இல்லை. எந்த சர்வரும் இல்லை. உங்கள் பணப்பை உங்கள் iPhone-இல் வாழ்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతాలు లేవు. సర్వర్లు లేవు. మీ వాలెట్ మీ iPhoneలోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีบัญชี ไม่มีเซิร์ฟเวอร์ กระเป๋าเงินของคุณอยู่บน iPhone ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok. Sunucu yok. Cüzdanınız iPhone’unuzda yaşar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без облікових записів. Без серверів. Ваш гаманець живе на вашому iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نہ کوئی اکاؤنٹ۔ نہ کوئی سرور۔ آپ کا والٹ آپ کے iPhone پر رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tài khoản. Không máy chủ. Ví của bạn sống trên iPhone của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无账户。无服务器。你的钱包存在于你的 iPhone 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無帳號。無伺服器。你的錢包存在於你的 iPhone 上。"
          }
        }
      }
    },
