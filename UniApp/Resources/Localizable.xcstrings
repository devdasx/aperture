        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутентификация не удалась — отзыв не отправлен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overenie zlyhalo — odvolanie nebolo odoslané."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverjanje pristnosti ni uspelo — preklic ni bil poslan."
