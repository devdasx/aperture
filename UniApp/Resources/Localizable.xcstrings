    "Apple's official symbol library — all UI iconography.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple se amptelike simboolbiblioteek — alle UI-ikonografie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏مكتبة الرموز الرسمية من Apple — جميع أيقونات الواجهة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Официалната библиотека със символи на Apple — цялата иконография на интерфейса."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-এর অফিসিয়াল সিম্বল লাইব্রেরি — সমস্ত UI আইকনোগ্রাফি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca de símbols oficial d'Apple: tota la iconografia de la interfície."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oficiální knihovna symbolů Apple — veškerá ikonografie rozhraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples officielle symbolbibliotek — al UI-ikonografi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die offizielle Symbolbibliothek von Apple — die gesamte UI-Ikonografie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επίσημη βιβλιοθήκη συμβόλων της Apple — όλη η εικονογραφία διεπαφής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's official symbol library — all UI iconography."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca de símbolos oficial de Apple: toda la iconografía de la interfaz."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple'i ametlik sümbolite raamatukogu — kogu UI ikonograafia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏کتابخانه‌ی رسمی نمادهای Apple — تمام آیکون‌های رابط کاربری."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applen virallinen symbolikirjasto — kaikki käyttöliittymän kuvakkeet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisyal na symbol library ng Apple — lahat ng UI iconography."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque officielle de symboles d'Apple — toute l'iconographie de l'interface."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏ספריית הסמלים הרשמית של Apple — כל אייקוני הממשק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple की आधिकारिक प्रतीक लाइब्रेरी — सभी UI आइकोनोग्राफी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleova službena knjižnica simbola — sva ikonografija sučelja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple hivatalos szimbólumkönyvtára — a teljes felhasználói felület ikonográfiája."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka simbol resmi Apple — seluruh ikonografi UI."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Opinber táknasafn Apple — öll UI tákn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria ufficiale di simboli di Apple — tutta l'iconografia dell'interfaccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 公式のシンボルライブラリ — UI アイコン全般を担います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 공식 심볼 라이브러리 — 모든 UI 아이콘."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oficiali Apple simbolių biblioteka — visa naudotojo sąsajos ikonografija."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple oficiālā simbolu bibliotēka — visa lietotāja saskarnes ikonogrāfija."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-ന്റെ ഔദ്യോഗിക സിംബൽ ലൈബ്രറി — എല്ലാ UI ഐക്കണുകളും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ची अधिकृत सिम्बॉल लायब्ररी — संपूर्ण UI आयकॉनोग्राफी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka simbol rasmi Apple — semua ikonografi UI."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples offisielle symbolbibliotek — all UI-ikonografi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De officiële symboolbibliotheek van Apple — alle UI-iconografie."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ਦੀ ਅਧਿਕਾਰਤ ਚਿੰਨ੍ਹ ਲਾਇਬ੍ਰੇਰੀ — ਸਾਰੀ UI ਆਈਕਨਗ੍ਰਾਫੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oficjalna biblioteka symboli Apple — cała ikonografia interfejsu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca oficial de símbolos da Apple — toda a iconografia da interface."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca oficială de simboluri Apple — întreaga iconografie a interfeței."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Официальная библиотека символов Apple — вся иконография интерфейса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oficiálna knižnica symbolov Apple — všetka ikonografia rozhrania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uradna Applova knjižnica simbolov — vsa ikonografija vmesnika."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Званична Apple-ова библиотека симбола — сва иконографија интерфејса."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples officiella symbolbibliotek — all UI-ikonografi."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maktaba rasmi ya alama ya Apple — alama zote za UI."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-ன் அதிகாரப்பூர்வ சின்ன நூலகம் — அனைத்து UI ஐகான்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple యొక్క అధికారిక చిహ్న లైబ్రరీ — UI లోని అన్ని ఐకాన్‌లు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไลบรารีสัญลักษณ์อย่างเป็นทางการของ Apple — สัญลักษณ์ทั้งหมดในอินเทอร์เฟซ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple'ın resmi sembol kütüphanesi — tüm arayüz ikonografisi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Офіційна бібліотека символів Apple — уся іконографія інтерфейсу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Apple کی آفیشل سمبل لائبریری — تمام UI آئیکنز۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện biểu tượng chính thức của Apple — toàn bộ icon giao diện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 官方符号库——全部界面图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 官方符號庫——所有介面圖示。"
          }
