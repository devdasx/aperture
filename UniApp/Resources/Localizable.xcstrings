        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഒപ്പിടുന്നതിന് മുമ്പ് നെറ്റ്‌വർക്ക് ഫീസ് കാണിക്കും. പിന്നീട് അത്ഭുതങ്ങളില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही साइन करण्याआधी नेटवर्क फी दाखवली जाते. नंतर कोणतीही नवलाई नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuran rangkaian dipaparkan sebelum anda menandatangani. Tiada kejutan selepas itu."
