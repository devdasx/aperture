        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest portofel are o parolă-frază. Introdu-o pentru a semna — nu părăsește niciodată acest iPhone, iar Aperture nu o poate recupera pentru tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
