        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperturen tietosuojakäytäntö on lyhyt, koska Aperture ei kerää tietoja: ei tiliä, ei sähköpostia, ei analytiikkaa, ei telemetriaa eikä lompakkosi toimintaan liittyviä palvelinlokeja."
          }
