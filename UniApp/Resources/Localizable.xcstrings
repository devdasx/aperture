    "Copied. The clipboard clears in 60 seconds.": {
      "comment": "Transient footnote confirmation shown after the user taps Copy on the recovery-phrase view. Names the OS-managed clipboard expiry.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekopieer. Die knipbord word binne 60 sekondes skoongemaak."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم النسخ. ستُمسح الحافظة خلال 60 ثانية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирано. Клипбордът се изчиства след 60 секунди."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কপি হয়েছে। ক্লিপবোর্ড ৬০ সেকেন্ডে পরিষ্কার হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiat. El porta-retalls s’esborra en 60 segons."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírováno. Schránka se za 60 sekund vymaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieret. Udklipsholderen ryddes om 60 sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert. Die Zwischenablage wird in 60 Sekunden geleert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράφηκε. Το πρόχειρο εκκαθαρίζεται σε 60 δευτερόλεπτα."
          }
        },
        "en": {
          "stringUnit": {
