    "Use a fair die or coin. Patterns from birthdays or phone numbers reduce real randomness.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik ’n regverdige dobbelsteen of munt. Patrone uit verjaarsdae of telefoonnommers verminder werklike toevalligheid."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم نردًا أو عملة عادلة. الأنماط من تواريخ الميلاد أو أرقام الهواتف تقلل من العشوائية الحقيقية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвай честен зар или монета. Модели от рождени дни или телефонни номера намаляват истинската произволност."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিরপেক্ষ পাশা বা মুদ্রা ব্যবহার করুন। জন্মদিন বা ফোন নম্বরের প্যাটার্ন আসল র‍্যান্ডমনেস কমিয়ে দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir un dau o moneda justos. Els patrons de dates de naixement o números de telèfon redueixen l'aleatorietat real."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použij férovou kostku nebo minci. Vzory z narozenin nebo telefonních čísel snižují skutečnou náhodnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en fair terning eller mønt. Mønstre fra fødselsdage eller telefonnumre svækker ægte tilfældighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende einen fairen Würfel oder eine faire Münze. Muster aus Geburtstagen oder Telefonnummern verringern die echte Zufälligkeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε αμερόληπτο ζάρι ή νόμισμα. Μοτίβα από γενέθλια ή τηλεφωνικούς αριθμούς μειώνουν την πραγματική τυχαιότητα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un dado o moneda justos. Los patrones de cumpleaños o números de teléfono reducen la aleatoriedad real."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuta ausat täringut või münti. Sünnipäevadest või telefoninumbritest tulenevad mustrid vähendavad päris juhuslikkust."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از تاس یا سکهٔ منصف استفاده کن. الگوهای روز تولد یا شمارهٔ تلفن تصادفی بودن واقعی را کم می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä reilua noppaa tai kolikkoa. Syntymäpäivistä tai puhelinnumeroista syntyvät kuviot heikentävät todellista satunnaisuutta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumamit ng patas na dais o barya. Ang mga pattern mula sa kaarawan o numero ng telepono ay nagpapababa ng totoong randomness."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un dé ou une pièce équitables. Les motifs issus de dates de naissance ou de numéros de téléphone réduisent l'aléa réel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בקובייה או במטבע הוגנים. דפוסים מתאריכי לידה או מספרי טלפון מפחיתים את האקראיות האמיתית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निष्पक्ष पासा या सिक्का इस्तेमाल करें। जन्मदिन या फ़ोन नंबर जैसे पैटर्न असली यादृच्छिकता को कम करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi poštenu kocku ili novčić. Uzorci iz rođendana ili telefonskih brojeva smanjuju pravu nasumičnost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használj korrekt kockát vagy érmét. A születésnapokból vagy telefonszámokból álló minták csökkentik a valódi véletlenszerűséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan dadu atau koin yang adil. Pola dari tanggal lahir atau nomor telepon mengurangi keacakan sebenarnya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Notaðu sanngjarnan tening eða mynt. Mynstur úr afmælisdögum eða símanúmerum draga úr raunverulegri tilviljun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un dado o una moneta equi. Pattern da compleanni o numeri di telefono riducono la vera casualità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公平なサイコロまたはコインを使ってください。誕生日や電話番号などのパターンは本当のランダム性を損ないます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공정한 주사위나 동전을 사용하세요. 생일이나 전화번호 같은 패턴은 실제 무작위성을 떨어뜨립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudok sąžiningą kauliuką ar monetą. Šablonai iš gimtadienių ar telefono numerių mažina tikrąjį atsitiktinumą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmanto godīgu kauliņu vai monētu. Modeļi no dzimšanas dienām vai telefona numuriem samazina patieso nejaušību."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീതിയുള്ള കല്ലോ നാണയമോ ഉപയോഗിക്കുക. ജന്മദിനങ്ങളിൽ നിന്നോ ഫോൺ നമ്പറുകളിൽ നിന്നോ ഉള്ള മാതൃകകൾ യഥാർത്ഥ ക്രമരാഹിത്യം കുറയ്ക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "न्याय्य फासा किंवा नाणे वापरा. वाढदिवस किंवा फोन नंबरमधील नमुने खरी यादृच्छिकता कमी करतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan dadu atau syiling yang adil. Corak daripada hari lahir atau nombor telefon mengurangkan kerawakan sebenar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en rettferdig terning eller mynt. Mønstre fra bursdager eller telefonnumre svekker ekte tilfeldighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een eerlijke dobbelsteen of munt. Patronen uit verjaardagen of telefoonnummers verkleinen echte willekeur."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿਰਪੱਖ ਪਾਸਾ ਜਾਂ ਸਿੱਕਾ ਵਰਤੋ। ਜਨਮਦਿਨ ਜਾਂ ਫ਼ੋਨ ਨੰਬਰਾਂ ਤੋਂ ਬਣੇ ਨਮੂਨੇ ਅਸਲ ਬੇਤਰਤੀਬੀ ਨੂੰ ਘਟਾਉਂਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj uczciwej kostki lub monety. Wzorce z dat urodzin lub numerów telefonów zmniejszają prawdziwą losowość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um dado ou moeda justos. Padrões de aniversários ou números de telefone reduzem a aleatoriedade real."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește un zar sau o monedă corectă. Tiparele din zile de naștere sau numere de telefon reduc aleatoritatea reală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте честные кости или монету. Шаблоны вроде дат рождения или номеров телефонов снижают настоящую случайность."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použi férovú kocku alebo mincu. Vzory z narodenín alebo telefónnych čísel znižujú skutočnú náhodnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi pošteno kocko ali kovanec. Vzorci iz rojstnih dni ali telefonskih številk zmanjšajo pravo naključnost."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користи поштену коцку или новчић. Шаблони рођендана или бројева телефона смањују праву насумичност."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd en rättvis tärning eller mynt. Mönster från födelsedagar eller telefonnummer minskar äkta slumpmässighet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia dadu au sarafu ya haki. Mifumo kutoka siku za kuzaliwa au nambari za simu hupunguza upungufu wa kweli wa mpangilio."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நியாயமான பகடை அல்லது நாணயத்தைப் பயன்படுத்துக. பிறந்தநாள் அல்லது தொலைபேசி எண்களின் வடிவங்கள் உண்மையான சீரற்ற தன்மையை குறைக்கின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిష్పక్షపాత పాచిక లేదా నాణేన్ని ఉపయోగించండి. పుట్టినరోజులు లేదా ఫోన్ నంబర్ల నుండి వచ్చే నమూనాలు నిజమైన యాదృచ్ఛికతను తగ్గిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ลูกเต๋าหรือเหรียญที่ยุติธรรม รูปแบบจากวันเกิดหรือเบอร์โทรศัพท์จะลดความสุ่มที่แท้จริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilesiz bir zar veya para kullan. Doğum günleri veya telefon numaralarından gelen örüntüler gerçek rastgeleliği azaltır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте чесний кубик чи монету. Шаблони з днів народження або номерів телефонів знижують справжню випадковість."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منصفانہ پانسہ یا سکہ استعمال کریں۔ سالگرہ یا فون نمبروں کے انداز اصل بے ترتیبی کم کر دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng xúc xắc hoặc đồng xu công bằng. Các mẫu từ ngày sinh hoặc số điện thoại sẽ làm giảm tính ngẫu nhiên thực sự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用公平的骰子或硬币。生日或电话号码等规律会削弱真正的随机性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用公平的骰子或硬幣。生日或電話號碼等規律會削弱真正的隨機性。"
          }
        }
      }
    },
