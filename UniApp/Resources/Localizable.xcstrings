        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) پر \\(identity.symbol) سے متعلق ٹرانزیکشنز آن چین تصدیق ہوتے ہی یہاں ظاہر ہوتی ہیں۔"
