        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas notīra katru aktīva informācijas filtra un kārtošanas izvēli. Turpināt?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ആസ്തി വിശദാംശങ്ങൾക്കായുള്ള എല്ലാ ഫിൽട്ടറും സോർട്ട് തിരഞ്ഞെടുപ്പും മായ്‌ക്കുന്നു. തുടരണോ?"
          }
