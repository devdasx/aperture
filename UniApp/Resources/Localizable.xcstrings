    "Other chains stay outside Aperture. Import their keys or your recovery phrase to add them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ander kettings bly buite Aperture. Voer hul sleutels of jou herstelfrase in om hulle by te voeg."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى السلاسل الأخرى خارج Aperture. استورد مفاتيحها أو عبارة الاسترداد الخاصة بك لإضافتها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Другите вериги остават извън Aperture. Внеси техните ключове или своята фраза за възстановяване, за да ги добавиш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্যান্য চেইন Aperture-এর বাইরে থাকে। সেগুলি যোগ করতে তাদের কী বা আপনার রিকভারি বাক্যাংশ আমদানি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les altres xarxes queden fora d'Aperture. Importa-ne les claus o la teva frase de recuperació per afegir-les."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní řetězce zůstávají mimo Aperture. Importujte jejich klíče nebo svou obnovovací frázi, abyste je přidali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre kæder forbliver uden for Aperture. Importer deres nøgler eller din gendannelsesfrase for at tilføje dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Chains bleiben außerhalb von Aperture. Importiere ihre Schlüssel oder deine Recovery-Phrase, um sie hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άλλες αλυσίδες παραμένουν εκτός Aperture. Εισαγάγετε τα κλειδιά τους ή τη φράση ανάκτησής σας για να τις προσθέσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás redes quedan fuera de Aperture. Importa sus claves o tu frase de recuperación para añadirlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teised ahelad jäävad väljapoole Aperture'i. Impordi nende võtmed või oma taastefraas, et need lisada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنجیره‌های دیگر بیرون از Aperture می‌مانند. برای افزودن آن‌ها، کلیدهایشان یا عبارت بازیابی خود را وارد کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muut ketjut pysyvät Aperturen ulkopuolella. Tuo niiden avaimet tai palautuslauseesi lisätäksesi ne."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang ibang chain ay nananatili sa labas ng Aperture. I-import ang kanilang mga key o ang iyong recovery phrase upang idagdag ang mga ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres chaînes restent en dehors d'Aperture. Importez leurs clés ou votre phrase de récupération pour les ajouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרשראות אחרות נשארות מחוץ ל‑Aperture. ייבא את המפתחות שלהן או את ביטוי השחזור שלך כדי להוסיף אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य चेन Aperture के बाहर रहते हैं। उन्हें जोड़ने के लिए उनकी कुंजियाँ या अपना रिकवरी वाक्यांश आयात करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostali lanci ostaju izvan Aperturea. Uvezi njihove ključeve ili svoju frazu za oporavak kako bi ih dodao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi lánc az Aperture-en kívül marad. Importáld a kulcsaikat vagy a helyreállítási kifejezésedet a hozzáadáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chain lain tetap di luar Aperture. Impor kunci mereka atau frasa pemulihanmu untuk menambahkannya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðrar keðjur eru áfram fyrir utan Aperture. Flyttu inn lyklana þeirra eða endurheimtarsetningu þína til að bæta þeim við."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le altre reti restano fuori da Aperture. Importa le loro chiavi o la tua frase di recupero per aggiungerle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のチェーンは Aperture の外に残ります。それらを追加するには、キーまたはリカバリーフレーズをインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 체인은 Aperture 외부에 남아 있습니다. 추가하려면 해당 키 또는 복구 구문을 가져오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitos grandinės lieka už Aperture ribų. Importuok jų raktus arba savo atkūrimo frazę, kad jas pridėtum."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Citas ķēdes paliek ārpus Aperture. Importē to atslēgas vai savu atjaunošanas frāzi, lai tās pievienotu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് ചെയിനുകൾ Aperture-ന് പുറത്ത് നിലനിൽക്കും. അവ ചേർക്കാൻ അവയുടെ കീകൾ അല്ലെങ്കിൽ നിങ്ങളുടെ വീണ്ടെടുക്കൽ ഫ്രേസ് ഇറക്കുമതി ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतर साखळ्या Aperture बाहेर राहतात. त्यांना जोडण्यासाठी त्यांच्या किल्ल्या किंवा तुमचा पुनर्प्राप्ती वाक्यांश आयात करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rantai lain kekal di luar Aperture. Import kunci mereka atau frasa pemulihan anda untuk menambahkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre kjeder blir værende utenfor Aperture. Importer nøklene deres eller gjenopprettingsfrasen din for å legge dem til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere chains blijven buiten Aperture. Importeer hun sleutels of je herstelfrase om ze toe te voegen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੋਰ ਚੇਨਾਂ Aperture ਤੋਂ ਬਾਹਰ ਰਹਿੰਦੀਆਂ ਹਨ। ਉਹਨਾਂ ਨੂੰ ਜੋੜਨ ਲਈ ਉਹਨਾਂ ਦੀਆਂ ਕੁੰਜੀਆਂ ਜਾਂ ਆਪਣਾ ਰਿਕਵਰੀ ਵਾਕੰਸ਼ ਆਯਾਤ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostałe łańcuchy zostają poza Aperture. Zaimportuj ich klucze lub swoją frazę odzyskiwania, aby je dodać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras redes ficam fora do Aperture. Importe suas chaves ou sua frase de recuperação para adicioná-las."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Celelalte rețele rămân în afara Aperture. Importă cheile lor sau fraza ta de recuperare pentru a le adăuga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальные сети остаются вне Aperture. Импортируйте их ключи или вашу фразу восстановления, чтобы добавить их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatné siete zostávajú mimo Aperture. Importuj ich kľúče alebo svoju obnovovaciu frázu, aby si ich pridal."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druge verige ostanejo zunaj Aperture. Uvozi njihove ključe ali svojo obnovitveno frazo, da jih dodaš."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Остале мреже остају ван Aperture. Увези њихове кључеве или своју фразу за опоравак да их додаш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andra kedjor stannar utanför Aperture. Importera deras nycklar eller din återställningsfras för att lägga till dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Minyororo mingine inabaki nje ya Aperture. Leta funguo zao au kifungu chako cha urejeshaji ili kuiongeza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்ற செயின்கள் Aperture-க்கு வெளியே இருக்கும். அவற்றைச் சேர்க்க அவற்றின் சாவிகளை அல்லது உங்கள் மீட்பு சொற்றொடரை இறக்குமதி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర చైన్‌లు Aperture వెలుపల ఉంటాయి. వాటిని జోడించడానికి వాటి కీలను లేదా మీ రికవరీ పదబంధాన్ని దిగుమతి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชนอื่นๆ อยู่นอก Aperture นำเข้าคีย์ของพวกเขาหรือวลีกู้คืนของคุณเพื่อเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer zincirler Aperture'ın dışında kalır. Eklemek için anahtarlarını veya kurtarma cümleni içe aktar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші ланцюги залишаються поза Aperture. Імпортуйте їхні ключі або вашу фразу відновлення, щоб додати їх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیگر چینز Aperture کے باہر رہتی ہیں۔ انہیں شامل کرنے کے لیے ان کی کیز یا اپنا ریکوری فقرہ درآمد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chuỗi khác vẫn nằm ngoài Aperture. Nhập khóa của chúng hoặc cụm từ khôi phục của bạn để thêm vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他链不在 Aperture 中。导入它们的密钥或你的恢复短语以添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他鏈不在 Aperture 中。匯入它們的金鑰或你的復原助記詞以加入。"
          }
        }
      }
    },
    "Outgoing": {
      "localizations": {
