    "Solana keeps ~0.00089 SOL as the rent-exempt minimum so the account stays on-chain.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana hou ~0.00089 SOL as die huur-vrygestelde minimum sodat die rekening op die ketting bly."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ Solana بـ ~0.00089 SOL كحد أدنى معفى من الإيجار حتى يبقى الحساب على السلسلة."
          }
        },
        "bg": {
