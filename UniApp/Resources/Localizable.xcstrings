    "Create a new wallet, or bring one you already have.": {
      "comment": "Slide 10 body.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skep ʼn nuwe beursie, of bring een wat jy reeds het."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ محفظة جديدة، أو أحضر محفظة لديك بالفعل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създайте нов портфейл или внесете такъв, който вече имате."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি নতুন ওয়ালেট তৈরি করুন, কিংবা ইতিমধ্যেই আছে এমন একটি নিয়ে আসুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cartera nova, o porta una que ja tens."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte novou peněženku nebo přeneste tu, kterou už máte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en ny tegnebog, eller tag en med, du allerede har."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eine neue Wallet oder bringen Sie eine vorhandene mit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε νέο πορτοφόλι ή φέρτε ένα που ήδη έχετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new wallet, or bring one you already have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cartera nueva, o trae una que ya tengas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loo uus rahakott või too kaasa see, mis sul juba on."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک کیف پول جدید بسازید، یا کیف پول موجود خود را وارد کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo uusi lompakko tai tuo jo olemassa oleva."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumawa ng bagong wallet, o dalhin ang isang mayroon ka na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un nouveau portefeuille, ou importez celui que vous avez déjà."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת ארנק חדש, או הבאת ארנק שכבר יש לך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया वॉलेट बनाएँ, या जो पहले से है उसे ले आएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvorite novi novčanik ili dovedite onaj koji već imate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzon létre új tárcát, vagy hozza át a meglévőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat dompet baru, atau bawa dompet yang sudah Anda miliki."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Búðu til nýtt veski eða komdu með það sem þú átt nú þegar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crei un nuovo portafoglio o importi quello che ha già."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいウォレットを作るか、すでにお持ちのものを取り込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 지갑을 만들거나, 이미 쓰던 지갑을 가져오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukurkite naują piniginę arba įsineškite tą, kurią jau turite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izveidojiet jaunu maku vai pievienojiet tādu, kāds jums jau ir."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ വാലറ്റ് സൃഷ്ടിക്കുക, അല്ലെങ്കിൽ നിങ്ങൾക്ക് നിലവിലുള്ളത് കൊണ്ടുവരിക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन वॉलेट तयार करा, किंवा तुमचं आधीचं इथे आणा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta dompet baharu, atau bawa masuk yang anda sedia ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag en ny lommebok, eller ta med en du allerede har."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een nieuwe wallet, of breng een bestaande mee."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਨਵਾਂ ਵਾਲਿਟ ਬਣਾਓ, ਜਾਂ ਜੋ ਤੁਹਾਡੇ ਕੋਲ ਪਹਿਲਾਂ ਹੀ ਹੈ ਉਸਨੂੰ ਲੈ ਆਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz nowy portfel lub zaimportuj istniejący."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma carteira nova ou traga uma que você já tem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează un portofel nou sau adu unul pe care îl ai deja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новый кошелёк или принесите тот, что уже есть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte novú peňaženku alebo prineste tú, ktorú už máte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarite novo denarnico ali prinesite tisto, ki jo že imate."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Направите нови новчаник или донесите онај који већ имате."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en ny plånbok, eller ta med en du redan har."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unda pochi mpya, au lete uliyo nayo tayari."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு புதிய பணப்பையை உருவாக்கு, அல்லது ஏற்கனவே உள்ளதை இங்கே கொண்டுவா."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త వాలెట్ సృష్టించండి, లేదా ఇప్పటికే ఉన్నదాన్ని తీసుకురండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างกระเป๋าใหม่ หรือเรียกกระเป๋าเดิมที่คุณมีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir cüzdan oluşturun ya da mevcut olanı içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть новий гаманець або імпортуйте наявний."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک نیا والٹ بنائیں، یا اپنا پہلے سے موجود والٹ لے آئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo ví mới, hoặc mang vào ví bạn đã có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一只新钱包,或带入一只你已有的钱包。"
          }
        },
        "zh-Hant": {
