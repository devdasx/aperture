        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paslēptie tīkli paliek atbalstīti — tiek ietekmēts tikai šī aktīva skats."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Falin net eru áfram studd — aðeins sýn þessarar eignar verður fyrir áhrifum."
