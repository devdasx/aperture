        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana trybu odrzuci Twoje %lld rzutów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar de modo descartará suas %lld rolagens."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea modului va anula cele %lld aruncări ale tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена режима отменит ваши %lld бросков."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepnutie režimu zahodí tvojich %lld hodov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklop načina bo zavrgel tvojih %lld metov."
