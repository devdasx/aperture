          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте между сетями в одном потоке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymieňajte naprieč reťazcami v jednom toku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamenjave med verigami v enem koraku."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
