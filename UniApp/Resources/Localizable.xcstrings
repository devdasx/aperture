    "Move value between networks without leaving the wallet.": {
      "comment": "Slide 8 body.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuif waarde tussen netwerke sonder om die beursie te verlaat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقُل القيمة بين الشبكات دون مغادرة المحفظة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Премествайте стойност между мрежи, без да напускате портфейла."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট না ছেড়ে বিভিন্ন নেটওয়ার্কের মধ্যে মূল্য সরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou valor entre xarxes sense sortir de la cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesouvejte hodnotu mezi sítěmi, aniž byste opustili peněženku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt værdi mellem netværk uden at forlade tegnebogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte zwischen Netzwerken bewegen, ohne die Wallet zu verlassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφέρετε αξία ανάμεσα σε δίκτυα χωρίς να φύγετε από το πορτοφόλι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move value between networks without leaving the wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve valor entre redes sin salir de la billetera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liiguta väärtust võrkude vahel rahakotist lahkumata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارزش را میان شبکه‌ها جابه‌جا کنید، بدون خروج از کیف پول."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä arvoa verkkojen välillä lompakosta poistumatta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglipat ng halaga sa pagitan ng mga network nang hindi iniiwan ang wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez de la valeur entre les réseaux sans quitter le portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העברת ערך בין רשתות בלי לצאת מהארנק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट से बाहर निकले बिना अलग-अलग नेटवर्क के बीच मूल्य भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premještajte vrijednost između mreža bez napuštanja novčanika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozgasson értéket hálózatok között a tárca elhagyása nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan nilai antar jaringan tanpa meninggalkan dompet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Færðu virði milli neta án þess að yfirgefa veskið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposti valore tra le reti senza uscire dal portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットを離れることなく、ネットワーク間で価値を移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑을 벗어나지 않고도 네트워크 사이로 자산을 옮깁니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkelkite vertę tarp tinklų neišeidami iš piniginės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārvietojiet vērtību starp tīkliem, neizejot no maka."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാലറ്റ് വിടാതെ നെറ്റ്‌വർക്കുകൾക്കിടയിൽ മൂല്യം നീക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट सोडल्याशिवाय नेटवर्क्समध्ये मूल्य हलवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan nilai antara rangkaian tanpa meninggalkan dompet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt verdier mellom nettverk uten å forlate lommeboken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats waarde tussen netwerken zonder de wallet te verlaten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਾਲਿਟ ਛੱਡੇ ਬਿਨਾਂ ਨੈੱਟਵਰਕਾਂ ਵਿਚਕਾਰ ਮੁੱਲ ਮੂਵ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoś wartość między sieciami bez wychodzenia z portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova valor entre redes sem sair da carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută valoare între rețele fără să părăsești portofelul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещайте средства между сетями, не покидая кошелька."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presúvajte hodnotu medzi sieťami bez opustenia peňaženky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premikajte vrednost med omrežji, ne da bi zapustili denarnico."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Премештајте вредност између мрежа без напуштања новчаника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta värde mellan nätverk utan att lämna plånboken."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamisha thamani kati ya mitandao bila kuondoka pochini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பணப்பையை விட்டு வெளியேறாமல் வலையமைப்புகளுக்கிடையே மதிப்பை மாற்று."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాలెట్‌ను వదలకుండానే నెట్‌వర్క్‌ల మధ్య విలువను తరలించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายมูลค่าระหว่างเครือข่ายโดยไม่ต้องออกจากกระเป๋า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdandan çıkmadan ağlar arasında değer aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщайте кошти між мережами, не виходячи з гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ سے باہر گئے بغیر نیٹ‌ورکس کے درمیان قدر منتقل کریں۔"
          }
        },
