        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví này chỉ theo dõi một địa chỉ — không có gì bí mật được lưu trên iPhone này, nên không mất gì bí mật. Bạn có thể thêm lại bất cứ lúc nào."
          }
        },
        "zh-Hans": {
