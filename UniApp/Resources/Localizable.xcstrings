        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giao dịch liên quan đến tài sản này xuất hiện ở đây khi chúng được xác nhận trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "涉及该资产的交易在链上确认后会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "涉及此資產的交易在鏈上確認後會顯示在這裡。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اثاثے سے متعلق لین دین جیسے ہی آن-چین تصدیق ہوتے ہیں یہاں ظاہر ہوتے ہیں۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакциите, включващи този актив, се появяват тук, щом бъдат потвърдени в мрежата."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda vara hõlmavad tehingud ilmuvad siia kohe, kui need ahelas kinnitatakse."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijos, susijusios su šiuo turtu, atsiranda čia, kai tik patvirtinamos grandinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījumi, kas saistīti ar šo aktīvu, parādās šeit, tiklīdz tie tiek apstiprināti ķēdē."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Færslur sem varða þessa eign birtast hér jafnóðum og þær staðfestast á keðjunni."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi yang melibatkan aset ini muncul di sini apabila ia disahkan atas rantaian."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumilitaw dito ang mga transaksyong kinasasangkutan ng asset na ito habang nakukumpirma ang mga ito on-chain."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Miamala inayohusisha rasilimali hii inaonekana hapa inapothibitishwa kwenye mnyororo."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksies wat hierdie bate behels, verskyn hier soos hulle op die ketting bevestig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சொத்து சம்பந்தப்பட்ட பரிவர்த்தனைகள் சங்கிலியில் உறுதிப்படும்போது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఆస్తికి సంబంధించిన లావాదేవీలు చైన్‌లో నిర్ధారించబడినప్పుడు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ആസ്തി ഉൾപ്പെടുന്ന ഇടപാടുകൾ ഓൺ-ചെയിൻ സ്ഥിരീകരിക്കുമ്പോൾ ഇവിടെ ദൃശ്യമാകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही मालमत्ता समाविष्ट असलेले व्यवहार ऑन-चेन पुष्टी होताच येथे दिसतात."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਜਾਇਦਾਦ ਨਾਲ ਜੁੜੇ ਲੈਣ-ਦੇਣ ਜਿਵੇਂ ਹੀ ਉਹ ਆਨ-ਚੇਨ ਪੁਸ਼ਟ ਹੁੰਦੇ ਹਨ ਇੱਥੇ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ।"
          }
        }
      }
    },
