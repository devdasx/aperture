        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманці лише для перегляду бачать баланси та транзакції в %@. Надсилати вони не можуть."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف-دیکھنے والے والیٹس %@ پر بیلنس اور لین دین دیکھتے ہیں۔ وہ بھیج نہیں سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
