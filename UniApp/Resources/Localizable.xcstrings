          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši piniginė buvo importuota iš privataus rakto. Atkūrimo frazės nėra ką rodyti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis maciņš tika importēts no privātās atslēgas. Nav atkopšanas frāzes, ko parādīt."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വാലറ്റ് സ്വകാര്യ കീയിൽ നിന്നാണ് ഇറക്കുമതി ചെയ്തത്. കാണിക്കാൻ റിക്കവറി വാക്യമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे वॉलेट खाजगी कीवरून आयात केले होते. दाखवण्यासाठी कोणताही रिकव्हरी फ्रेज नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet ini diimport dari kunci peribadi. Tiada frasa pemulihan untuk ditunjukkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne lommeboken ble importert fra en privat nøkkel. Det finnes ingen gjenopprettingsfrase å vise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze portemonnee is geïmporteerd uit een privésleutel. Er is geen herstelzin om weer te geven."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਵਾਲਿਟ ਪ੍ਰਾਈਵੇਟ ਕੁੰਜੀ ਤੋਂ ਆਯਾਤ ਕੀਤਾ ਗਿਆ ਸੀ। ਦਿਖਾਉਣ ਲਈ ਕੋਈ ਰਿਕਵਰੀ ਫ਼ਰੇਜ਼ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten portfel został zaimportowany z klucza prywatnego. Nie ma frazy odzyskiwania do wyświetlenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carteira foi importada de uma chave privada. Não há frase de recuperação para mostrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest portofel a fost importat dintr-o cheie privată. Nu există nicio frază de recuperare de afișat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот кошелёк был импортирован из приватного ключа. Фразы восстановления для показа нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto peňaženka bola importovaná zo súkromného kľúča. Nie je k dispozícii žiadna obnovovacia fráza na zobrazenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta denarnica je bila uvožena iz zasebnega ključa. Ni obnovitvene fraze za prikaz."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Овај новчаник је увезен из приватног кључа. Нема фразе за опоравак коју бисмо могли да прикажемо."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här plånboken importerades från en privat nyckel. Det finns ingen återställningsfras att visa."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi hii iliingizwa kutoka ufunguo wa faragha. Hakuna maneno ya kurejesha ya kuonyesha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வாலெட் தனிப்பட்ட விசையிலிருந்து இறக்குமதி செய்யப்பட்டது. காட்ட மீட்பு சொற்றொடர் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వాలెట్ ప్రైవేట్ కీ నుండి దిగుమతి చేయబడింది. చూపించడానికి రికవరీ పదబంధం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋านี้นำเข้าจากคีย์ส่วนตัว ไม่มีวลีกู้คืนให้แสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cüzdan özel anahtardan içe aktarıldı. Gösterilecek bir kurtarma ifadesi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей гаманець було імпортовано з приватного ключа. Фрази відновлення для показу немає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ والیٹ نجی کلید سے درآمد کیا گیا تھا۔ دکھانے کے لیے کوئی ریکوری فقرہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví này được nhập từ khóa riêng tư. Không có cụm từ khôi phục để hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此钱包是从私钥导入的。没有可显示的恢复短语。"
