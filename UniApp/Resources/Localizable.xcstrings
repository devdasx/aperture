    "\\(chain.displayName) can pay up to \\(maxRecipients) recipients in one transaction.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) kan tot \\(maxRecipients) ontvangers in een transaksie betaal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ \\(chain.displayName) الدفع إلى ما يصل إلى \\(maxRecipients) مستلمًا في معاملة واحدة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) може да плати до \\(maxRecipients) получатели в една транзакция."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) একটি লেনদেনে সর্বোচ্চ \\(maxRecipients) জন প্রাপককে পরিশোধ করতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) pot pagar fins a \\(maxRecipients) destinataris en una sola transacció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) může v jedné transakci zaplatit až \\(maxRecipients) příjemcům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) kan betale op til \\(maxRecipients) modtagere i én transaktion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) kann bis zu \\(maxRecipients) Empfänger in einer Transaktion bezahlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το \\(chain.displayName) μπορεί να πληρώσει έως \\(maxRecipients) παραλήπτες σε μία συναλλαγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) can pay up to \\(maxRecipients) recipients in one transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) puede pagar hasta \\(maxRecipients) destinatarios en una sola transacción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) saab ühe tehinguga maksta kuni \\(maxRecipients) saajale."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) می‌تواند در یک تراکنش تا \\(maxRecipients) گیرنده پرداخت کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) voi maksaa enintään \\(maxRecipients) vastaanottajalle yhdessä tapahtumassa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring magbayad ang \\(chain.displayName) ng hanggang \\(maxRecipients) na tatanggap sa isang transaksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) peut payer jusqu'à \\(maxRecipients) destinataires en une transaction."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) יכול לשלם עד \\(maxRecipients) נמענים בעסקה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) एक ट्रांज़ैक्शन में \\(maxRecipients) तक प्राप्तकर्ताओं को भुगतान कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) može isplatiti do \\(maxRecipients) primatelja u jednoj transakciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \\(chain.displayName) egyetlen tranzakcióban legfeljebb \\(maxRecipients) címzettnek tud fizetni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) dapat membayar hingga \\(maxRecipients) penerima dalam satu transaksi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) getur greitt allt að \\(maxRecipients) viðtakendum í einni færslu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) può pagare fino a \\(maxRecipients) destinatari in una sola transazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) は 1 回の取引で最大 \\(maxRecipients) 人の受取人に支払えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName)은(는) 한 거래에서 최대 \\(maxRecipients)명의 받는 사람에게 지불할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) gali sumokėti iki \\(maxRecipients) gavėjų viena operacija."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) vienā transakcijā var samaksāt līdz \\(maxRecipients) saņēmējiem."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName)-ന് ഒരു ഇടപാടിൽ \\(maxRecipients) സ്വീകർത്താക്കൾ വരെ പണം നൽകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) एका व्यवहारात \\(maxRecipients) पर्यंत प्राप्तकर्त्यांना पैसे देऊ शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) boleh membayar sehingga \\(maxRecipients) penerima dalam satu transaksi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) kan betale opptil \\(maxRecipients) mottakere i én transaksjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) kan tot \\(maxRecipients) ontvangers in één transactie betalen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) ਇੱਕ ਲੈਣ-ਦੇਣ ਵਿੱਚ \\(maxRecipients) ਪ੍ਰਾਪਤਕਰਤਾਵਾਂ ਤੱਕ ਨੂੰ ਭੁਗਤਾਨ ਕਰ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) może zapłacić maksymalnie \\(maxRecipients) odbiorcom w jednej transakcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) pode pagar até \\(maxRecipients) destinatários em uma transação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) poate plăti până la \\(maxRecipients) destinatari într-o singură tranzacție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) может оплатить до \\(maxRecipients) получателей в одной транзакции."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) môže v jednej transakcii vyplatiť až \\(maxRecipients) príjemcov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) lahko v eni transakciji izplača do \\(maxRecipients) prejemnikov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) može platiti do \\(maxRecipients) primalaca u jednoj transakciji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) kan betala upp till \\(maxRecipients) mottagare i en transaktion."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) inaweza kulipa hadi wapokeaji \\(maxRecipients) katika muamala mmoja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
