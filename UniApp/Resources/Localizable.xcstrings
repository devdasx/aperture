        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó bắt đầu và kết thúc giống địa chỉ đã lưu của \\(match.savedName) nhưng phần giữa lại khác. Đây là cách kẻ lừa đảo dụ bạn gửi nhầm chỗ."
          }
        },
        "zh-Hans": {
