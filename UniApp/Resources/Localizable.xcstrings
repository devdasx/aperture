        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається менше мережевого мінімуму (\\(floor)), тому цьому одержувачу неможливо заплатити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیٹ ورک کے کم از کم (\\(floor)) سے کم باقی رہتا ہے، اس لیے اس وصول کنندہ کو ادائیگی نہیں ہو سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số còn lại ít hơn mức tối thiểu của mạng (\\(floor)), nên không thể thanh toán cho người nhận này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余金额低于网络最低限额（\\(floor)），因此无法向此收款人付款。"
