    "Tip: leave it on “Letter” to auto-use the wallet’s initial.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenk: laat dit op “Letter” staan om die beursie se eerste letter outomaties te gebruik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلميح: اتركه على «حرف» لاستخدام الحرف الأول من اسم المحفظة تلقائيًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съвет: оставете на „Буква“, за да се използва автоматично инициалът на портфейла."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরামর্শ: ওয়ালেটের প্রথম অক্ষর স্বয়ংক্রিয়ভাবে ব্যবহার করতে \"অক্ষর\" বিকল্পটি রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consell: deixeu-ho a «Lletra» per utilitzar automàticament la inicial de la cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: ponechte na „Písmeno\", aby se automaticky použilo počáteční písmeno peněženky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: lad den stå på \"Bogstav\" for automatisk at bruge tegnebogens initial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Belassen Sie es auf „Buchstabe\", um automatisch den Anfangsbuchstaben der Wallet zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμβουλή: αφήστε το στο «Γράμμα» για αυτόματη χρήση του αρχικού γράμματος του πορτοφολιού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: leave it on “Letter” to auto-use the wallet’s initial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencia: deja la opción en «Letra» para usar automáticamente la inicial del monedero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vihje: jäta valikule „Täht“, et kasutada automaatselt rahakoti algustähte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نکته: روی «حرف» بگذارید تا حرف اول کیف پول به‌طور خودکار استفاده شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vihje: jätä asetukseksi \"Kirjain\", niin lompakon alkukirjainta käytetään automaattisesti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: panatilihin sa “Titik” para awtomatikong gamitin ang unang titik ng wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : laissez sur « Lettre » pour utiliser automatiquement l’initiale du portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיפ: השאר את האפשרות על \"אות\" כדי להשתמש אוטומטית באות הראשונה של הארנק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव: इसे \"अक्षर\" पर रखें ताकि वॉलेट का पहला अक्षर अपने आप उपयोग हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savjet: ostavite na „Slovo\" kako bi se automatski koristilo početno slovo novčanika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: hagyja „Betű\" beállításon, hogy automatikusan a tárca kezdőbetűjét használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: biarkan pada “Huruf” untuk menggunakan inisial dompet secara otomatis."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábending: hafðu „Bókstafur“ valið til að nota fyrsta staf veskisins sjálfkrafa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: lascia su “Lettera” per usare automaticamente l’iniziale del portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント:「文字」のままにすると、ウォレット名の頭文字を自動で使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: “문자”로 두면 지갑 이름의 첫 글자가 자동으로 사용돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patarimas: palikite ties „Raidė“, kad būtų automatiškai naudojama piniginės pirmoji raidė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Padoms: atstājiet uz „Burts“, lai automātiski tiktu izmantots maka sākumburts."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നുറുങ്ങ്: വാലറ്റിന്റെ ആദ്യാക്ഷരം സ്വയം ഉപയോഗിക്കാൻ “അക്ഷരം” എന്നതിൽ വിടുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टिप: वॉलेटचे पहिले अक्षर आपोआप वापरण्यासाठी “अक्षर” वर ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petua: biarkan pada “Huruf” untuk menggunakan inisial dompet secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: la den stå på «Bokstav» for å automatisk bruke lommebokens initial."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: laat het op “Letter” staan om automatisch de eerste letter van je wallet te gebruiken."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੁਝਾਅ: ਵਾਲਿਟ ਦਾ ਪਹਿਲਾ ਅੱਖਰ ਆਪਣੇ ਆਪ ਵਰਤਣ ਲਈ “ਅੱਖਰ” ‘ਤੇ ਛੱਡੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: pozostaw na „Litera”, aby automatycznie używać inicjału portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: mantenha em \"Letra\" para usar a inicial da carteira automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestie: lăsați pe „Literă\" pentru a folosi automat inițiala portofelului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказка: оставьте «Буква», чтобы автоматически использовать первую букву названия кошелька."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: ponechajte na „Písmeno\", aby sa automaticky použilo začiatočné písmeno peňaženky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namig: pustite na »Črka«, da se samodejno uporabi začetnica denarnice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Савет: оставите на „Слово\" да би се аутоматски користило почетно слово новчаника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: lämna inställningen på \"Bokstav\" för att automatiskt använda plånbokens initial."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kidokezo: acha kwenye “Herufi” ili kutumia herufi ya kwanza ya pochi kiotomatiki."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறிப்பு: வாலட்டின் முதல் எழுத்து தானாகப் பயன்படுத்தப்பட “எழுத்து” என்பதில் விட்டுவிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిట్కా: వాలెట్ యొక్క మొదటి అక్షరం స్వయంచాలకంగా ఉపయోగించబడేందుకు “అక్షరం” పై ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคล็ดลับ: เลือก “ตัวอักษร” ไว้เพื่อใช้อักษรตัวแรกของกระเป๋าเงินโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: cüzdan adının baş harfinin otomatik kullanılması için “Harf” seçeneğinde bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підказка: залиште «Літера», щоб автоматично використовувати першу літеру назви гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اشارہ: “حرف” پر چھوڑ دیں تاکہ والیٹ کا پہلا حرف خود بخود استعمال ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẹo: để ở “Chữ cái” để tự động dùng chữ đầu của ví."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：保留在\"字母\"选项，自动使用钱包名称的首字母。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：保留在「字母」選項，自動使用錢包名稱的首字。"
          }
        }
      }
    },
