    "Paste an SPL token mint address. Aperture reads decimals from the mint and looks up name + symbol from Metaplex.": {
      "extractionState": "new",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألصق عنوان إصدار عملة SPL. تقرأ Aperture الكسور العشرية من العنوان وتجلب الاسم والرمز من Metaplex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি SPL টোকেনের mint ঠিকানা পেস্ট করুন। Aperture mint থেকে দশমিক পড়ে এবং Metaplex থেকে নাম ও সিম্বল আনে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enganxa una adreça de mint d’un token SPL. Aperture llegeix els decimals del mint i consulta nom i símbol a Metaplex."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte mint-adresu SPL tokenu. Aperture čte desetinná místa z mintu a načte název a symbol z Metaplexu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt mint-adressen til en SPL-token. Aperture læser decimalerne fra mint og slår navn og symbol op i Metaplex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Mint-Adresse eines SPL-Tokens ein. Aperture liest die Dezimalstellen aus dem Mint und holt Name und Symbol aus Metaplex."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλήστε μια διεύθυνση mint ενός SPL token. Το Aperture διαβάζει τα δεκαδικά από το mint και αναζητά όνομα και σύμβολο από το Metaplex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste an SPL token mint address. Aperture reads decimals from the mint and looks up name + symbol from Metaplex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una dirección de mint de un token SPL. Aperture lee los decimales del mint y consulta el nombre y el símbolo en Metaplex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی مینت توکن SPL را بچسبانید. Aperture رقم اعشار را از مینت می‌خواند و نام و نماد را از Metaplex پیدا می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä SPL-tokenin mint-osoite. Aperture lukee desimaalit mintistä ja hakee nimen ja symbolin Metaplexistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez l’adresse de mint d’un jeton SPL. Aperture lit les décimales depuis le mint et recherche le nom et le symbole via Metaplex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להדביק את כתובת ה־mint של טוקן SPL. ‏Aperture קוראת את מספר העשרוניות מה־mint ושולפת את השם והסמל מ־Metaplex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी SPL टोकन का mint पता पेस्ट करें। Aperture mint से दशमलव पढ़ता है और Metaplex से नाम और सिंबल लाता है।"
          }
        },
        "hr": {
