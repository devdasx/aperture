    "We couldn't decrypt this wallet's phrase. Try restarting Aperture.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ons kon hierdie beursie se frase nie dekripteer nie. Probeer Aperture herbegin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذَّر علينا فك تشفير عبارة هذه المحفظة. حاول إعادة تشغيل Aperture."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успяхме да декриптираме фразата на този портфейл. Опитайте да рестартирате Aperture."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা এই ওয়ালেটের ফ্রেজ ডিক্রিপ্ট করতে পারিনি। Aperture পুনরায় চালু করে দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
