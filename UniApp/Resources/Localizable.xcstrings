        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture više nema vašu frazu. Vi ste jedina kopija – zapišite je i čuvajte na sigurnom mjestu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture-nál már nincs meg a kifejezése. Ön az egyetlen példány – írja le és tartsa biztonságos helyen."
