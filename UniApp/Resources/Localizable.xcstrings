    "Anyone with a key can take the funds on its address. Aperture cannot undo a leak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with a key can take the funds on its address. Aperture cannot undo a leak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que tenga una clave puede llevarse los fondos de su dirección. Aperture no puede deshacer una filtración."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人只要拥有密钥，就能取走其地址上的资金。Aperture 无法撤销泄露。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人只要擁有金鑰，就能取走其位址上的資金。Aperture 無法撤銷外洩。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसके पास कुंजी होगी वह उसके पते पर मौजूद धनराशि ले सकता है। Aperture किसी लीक को पूर्ववत नहीं कर सकता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص يملك المفتاح أن يأخذ الأموال الموجودة في عنوانه. لا تستطيع Aperture التراجع عن أي تسريب."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com uma chave pode levar os fundos do endereço dela. A Aperture não pode desfazer um vazamento."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যার কাছে কী থাকবে সে তার ঠিকানার তহবিল নিয়ে নিতে পারে। Aperture কোনো ফাঁস পূর্বাবস্থায় ফেরাতে পারে না।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой, у кого есть ключ, может забрать средства с его адреса. Aperture не сможет отменить утечку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵を持つ人は誰でも、そのアドレスにある資金を引き出せます。Aperture は漏洩を取り消すことはできません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer einen Schlüssel besitzt, kann das Guthaben an dessen Adresse abheben. Aperture kann ein Leck nicht rückgängig machen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-хто, хто має ключ, може забрати кошти з його адреси. Aperture не може скасувати витік."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όποιος έχει ένα κλειδί μπορεί να πάρει τα κεφάλαια στη διεύθυνσή του. Το Aperture δεν μπορεί να αναιρέσει μια διαρροή."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine deține o cheie poate lua fondurile de la adresa ei. Aperture nu poate anula o scurgere."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdokoli s klíčem může vybrat prostředky z jeho adresy. Aperture nedokáže únik vrátit zpět."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bárki, akinél a kulcs van, elviheti az adott címen lévő összeget. Az Aperture nem tudja visszavonni a kiszivárgást."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem som helst med en nyckel kan ta tillgångarna på dess adress. Aperture kan inte ångra en läcka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem som helst med en nøkkel kan ta midlene på adressen dens. Aperture kan ikke angre en lekkasje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhver med en nøgle kan tage midlerne på dens adresse. Aperture kan ikke fortryde en lækage."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa avaimen haltija voi viedä sen osoitteessa olevat varat. Aperture ei voi peruuttaa vuotoa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מי שברשותו מפתח יכול לקחת את הכספים שבכתובת שלו. Aperture אינה יכולה לבטל דליפה."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsevol persona amb una clau pot endur-se els fons de la seva adreça. Aperture no pot desfer una filtració."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilo tko s ključem može uzeti sredstva s njegove adrese. Aperture ne može poništiti curenje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktokoľvek s kľúčom môže vybrať prostriedky z jeho adresy. Aperture nedokáže únik vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdor koli s ključem lahko vzame sredstva na njegovem naslovu. Aperture razkritja ne more razveljaviti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Свако ко има кључ може узети средства са његове адресе. Aperture не може да поништи цурење."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque possède une clé peut prendre les fonds de son adresse. Aperture ne peut pas annuler une fuite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 가진 사람은 누구나 해당 주소의 자금을 가져갈 수 있어요. Aperture는 유출을 되돌릴 수 없어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque possieda una chiave può prelevare i fondi del suo indirizzo. Aperture non può annullare una fuga di dati."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir anahtara sahip olan herkes, o anahtarın adresindeki fonları alabilir. Aperture bir sızıntıyı geri alamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai có khóa đều có thể lấy tiền tại địa chỉ của khóa đó. Aperture không thể hoàn tác một vụ rò rỉ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็ตามที่มีคีย์สามารถนำเงินที่อยู่ของคีย์นั้นไปได้ Aperture ไม่สามารถย้อนกลับการรั่วไหลได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun yang memiliki kunci dapat mengambil dana di alamatnya. Aperture tidak dapat membatalkan kebocoran."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کسی که یک کلید داشته باشد می‌تواند دارایی‌های نشانی آن را بردارد. ‏Aperture‏ نمی‌تواند یک نشت را جبران کند."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy, kto ma klucz, może zabrać środki z jego adresu. Aperture nie cofnie wycieku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen met een sleutel kan het tegoed op het bijbehorende adres weghalen. Aperture kan een lek niet ongedaan maken."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس کسی کے پاس کلید ہو وہ اس کے پتے پر موجود رقم لے سکتا ہے۔ ‏Aperture‏ کسی رساؤ کو واپس نہیں کر سکتا۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки, който разполага с ключ, може да вземе средствата на неговия адрес. Aperture не може да отмени изтичане."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igaüks, kellel on võti, saab võtta selle aadressil olevad rahalised vahendid. Aperture ei saa leket tagasi võtta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bet kuris asmuo, turintis raktą, gali pasiimti lėšas iš jo adreso. „Aperture“ negali atšaukti nutekėjimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikviens, kuram ir atslēga, var paņemt līdzekļus tās adresē. Aperture nevar atsaukt noplūdi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver sem hefur lykil getur tekið féð á vistfangi hans. Aperture getur ekki afturkallað leka."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa sahaja yang memiliki kunci boleh mengambil dana di alamatnya. Aperture tidak dapat membatalkan kebocoran."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahit sino na may hawak ng key ay puwedeng kunin ang pondo sa address nito. Hindi maibabalik ng Aperture ang isang pagtagas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtu yeyote aliye na ufunguo anaweza kuchukua fedha zilizo katika anwani yake. Aperture haiwezi kutendua uvujaji."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Enigeen met 'n sleutel kan die fondse op die adres daarvan neem. Aperture kan nie 'n lek ongedaan maak nie."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு கீ உள்ள எவரும் அதன் முகவரியில் உள்ள நிதியை எடுத்துக்கொள்ளலாம். கசிவை Aperture-ஆல் மீட்டெடுக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కీ ఉన్న ఎవరైనా దాని చిరునామాలోని నిధులను తీసుకోవచ్చు. లీక్‌ను Aperture రద్దు చేయలేదు."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു കീ കൈവശമുള്ള ആർക്കും അതിന്റെ വിലാസത്തിലെ ഫണ്ട് എടുക്കാം. ഒരു ചോർച്ച പഴയപടിയാക്കാൻ Aperture-ന് കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्याच्याकडे की आहे तो कोणीही तिच्या पत्त्यावरील निधी घेऊ शकतो. गळती Aperture पूर्ववत करू शकत नाही."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਸ ਕਿਸੇ ਕੋਲ ਕੁੰਜੀ ਹੋਵੇ ਉਹ ਇਸ ਦੇ ਪਤੇ ਉੱਤੇ ਮੌਜੂਦ ਰਕਮ ਲੈ ਸਕਦਾ ਹੈ। Aperture ਕਿਸੇ ਲੀਕ ਨੂੰ ਵਾਪਸ ਨਹੀਂ ਕਰ ਸਕਦਾ।"
          }
        }
      }
    },
