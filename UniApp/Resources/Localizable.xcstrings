    "Paste one or more \\(chain.displayName) addresses. Aperture reads balances and transactions only — it cannot send.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een of meer \\(chain.displayName)-adresse. Aperture lees slegs saldi en transaksies — dit kan nie stuur nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق عنوانًا واحدًا أو أكثر لـ \\(chain.displayName). تقرأ Aperture الأرصدة والمعاملات فقط — ولا يمكنها الإرسال."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете един или повече адреси на \\(chain.displayName). Aperture чете само салда и транзакции — не може да изпраща."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক বা একাধিক \\(chain.displayName) ঠিকানা পেস্ট করুন। Aperture শুধুমাত্র ব্যালেন্স এবং লেনদেন পড়ে — পাঠাতে পারে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enganxa una o més adreces de \\(chain.displayName). Aperture només llegeix saldos i transaccions — no pot enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte jednu nebo více adres \\(chain.displayName). Aperture pouze čte zůstatky a transakce — nemůže odesílat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt en eller flere \\(chain.displayName)-adresser. Aperture læser kun saldi og transaktioner — den kan ikke sende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine oder mehrere \\(chain.displayName)-Adressen ein. Aperture liest nur Salden und Transaktionen — Senden ist nicht möglich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικόλλησε μία ή περισσότερες διευθύνσεις \\(chain.displayName). Η Aperture διαβάζει μόνο υπόλοιπα και συναλλαγές — δεν μπορεί να στείλει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste one or more \\(chain.displayName) addresses. Aperture reads balances and transactions only — it cannot send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una o más direcciones de \\(chain.displayName). Aperture solo lee saldos y transacciones — no puede enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleebi üks või mitu \\(chain.displayName) aadressi. Aperture loeb ainult saldot ja tehinguid — saata ei saa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک یا چند نشانی \\(chain.displayName) را جای‌گذاری کنید. Aperture فقط موجودی و تراکنش‌ها را می‌خواند — نمی‌تواند چیزی بفرستد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä yksi tai useampi \\(chain.displayName)-osoite. Aperture lukee vain saldot ja tapahtumat — se ei voi lähettää."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-paste ang isa o higit pang \\(chain.displayName) address. Babasahin lamang ng Aperture ang mga balanse at transaksyon — hindi ito makakapagpadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une ou plusieurs adresses \\(chain.displayName). Aperture ne lit que les soldes et les transactions — il ne peut pas envoyer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק כתובת \\(chain.displayName) אחת או יותר. Aperture קוראת רק יתרות ועסקאות — היא לא יכולה לשלוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक या अधिक \\(chain.displayName) पते चिपकाएँ। Aperture केवल शेष राशि और लेन-देन पढ़ता है — भेज नहीं सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepi jednu ili više \\(chain.displayName) adresa. Aperture čita samo stanja i transakcije — ne može slati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illessz be egy vagy több \\(chain.displayName) címet. Az Aperture csak az egyenlegeket és tranzakciókat olvassa — küldeni nem tud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempelkan satu atau lebih alamat \\(chain.displayName). Aperture hanya membaca saldo dan transaksi — tidak dapat mengirim."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu inn eitt eða fleiri \\(chain.displayName) vistföng. Aperture les aðeins jafnstöðu og færslur — getur ekki sent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla uno o più indirizzi \\(chain.displayName). Aperture legge solo saldi e transazioni — non può inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) のアドレスを 1 つ以上貼り付けてください。Aperture は残高と取引を読み取るだけで、送信はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) 주소를 하나 이상 붙여 넣으세요. Aperture는 잔액과 거래 내역만 읽을 뿐, 전송은 할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijuokite vieną ar daugiau \\(chain.displayName) adresų. Aperture skaito tik likučius ir operacijas — siųsti negali."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielīmējiet vienu vai vairākas \\(chain.displayName) adreses. Aperture lasa tikai atlikumus un darījumus — sūtīt nevar."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നോ അതിലധികമോ \\(chain.displayName) വിലാസങ്ങൾ ഒട്ടിക്കുക. Aperture ബാലൻസുകളും ഇടപാടുകളും മാത്രമേ വായിക്കൂ — അയയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक किंवा अधिक \\(chain.displayName) पत्ते पेस्ट करा. Aperture फक्त शिल्लक आणि व्यवहार वाचतो — पाठवू शकत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal satu atau lebih alamat \\(chain.displayName). Aperture hanya membaca baki dan transaksi — tidak boleh menghantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn én eller flere \\(chain.displayName)-adresser. Aperture leser kun saldoer og transaksjoner — den kan ikke sende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een of meer \\(chain.displayName)-adressen. Aperture leest alleen saldi en transacties — versturen kan niet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਜਾਂ ਵੱਧ \\(chain.displayName) ਪਤੇ ਪੇਸਟ ਕਰੋ। Aperture ਸਿਰਫ਼ ਬਕਾਇਆ ਅਤੇ ਲੈਣ-ਦੇਣ ਪੜ੍ਹਦਾ ਹੈ — ਭੇਜ ਨਹੀਂ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej co najmniej jeden adres \\(chain.displayName). Aperture odczytuje tylko salda i transakcje — nie może wysyłać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um ou mais endereços de \\(chain.displayName). O Aperture apenas lê saldos e transações — não pode enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește una sau mai multe adrese \\(chain.displayName). Aperture citește doar soldurile și tranzacțiile — nu poate trimite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте один или несколько адресов \\(chain.displayName). Aperture только считывает балансы и транзакции — отправлять не может."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte jednu alebo viac adries \\(chain.displayName). Aperture iba číta zostatky a transakcie — nedokáže odosielať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilepi enega ali več naslovov \\(chain.displayName). Aperture samo bere stanja in transakcije — pošiljati ne more."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налепи једну или више \\(chain.displayName) адреса. Aperture само чита стања и трансакције — не може да шаље."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in en eller flera \\(chain.displayName)-adresser. Aperture läser endast saldon och transaktioner — det kan inte skicka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandika anwani moja au zaidi za \\(chain.displayName). Aperture inasoma tu salio na muamala — haiwezi kutuma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒன்று அல்லது அதற்கு மேற்பட்ட \\(chain.displayName) முகவரிகளை ஒட்டவும். Aperture மீதிகளையும் பரிவர்த்தனைகளையும் மட்டுமே படிக்கிறது — அனுப்ப இயலாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకటి లేదా అంతకంటే ఎక్కువ \\(chain.displayName) చిరునామాలను అతికించండి. Aperture నిల్వలను మరియు లావాదేవీలను మాత్రమే చదువుతుంది — పంపలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางที่อยู่ \\(chain.displayName) อย่างน้อยหนึ่งรายการ Aperture อ่านเฉพาะยอดคงเหลือและธุรกรรมเท่านั้น ส่งไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir veya daha fazla \\(chain.displayName) adresi yapıştırın. Aperture yalnızca bakiye ve işlemleri okur — gönderim yapamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте одну або кілька адрес \\(chain.displayName). Aperture лише зчитує баланси та транзакції — надсилати не може."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک یا زیادہ \\(chain.displayName) پتے چسپاں کریں۔ Aperture صرف بیلنس اور لین دین پڑھتا ہے — کچھ بھیج نہیں سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán một hoặc nhiều địa chỉ \\(chain.displayName). Aperture chỉ đọc số dư và giao dịch — không thể gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴一个或多个 \\(chain.displayName) 地址。Aperture 仅读取余额和交易记录 — 无法发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
