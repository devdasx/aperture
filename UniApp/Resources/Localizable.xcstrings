        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez PIN je vaša peňaženka chránená iba zamknutou obrazovkou iPhonu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez PIN je vaša denarnica zaščitena samo z zaklenjenim zaslonom iPhona."
