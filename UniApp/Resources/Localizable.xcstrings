            "value": "Вимкнути код-пароль"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس کوڈ غیر فعال کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt mật mã"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用密码"
          }
