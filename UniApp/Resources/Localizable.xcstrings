    "Transactions appear here as they confirm on-chain.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksies verskyn hier sodra hulle op die ketting bevestig word."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر المعاملات هنا فور تأكيدها على السلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакциите се появяват тук, щом бъдат потвърдени в мрежата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেনগুলো অন-চেইনে নিশ্চিত হওয়ার সাথে সাথে এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transaccions apareixen aquí a mesura que es confirmen a la cadena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce se zde objevují, jakmile jsou potvrzeny na blockchainu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktioner vises her, efterhånden som de bekræftes på kæden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen erscheinen hier, sobald sie auf der Chain bestätigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συναλλαγές εμφανίζονται εδώ καθώς επιβεβαιώνονται στην αλυσίδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactions appear here as they confirm on-chain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transacciones aparecen aquí a medida que se confirman en la cadena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehingud ilmuvad siia, kui need ahelas kinnitatakse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش‌ها به‌محض تأیید روی زنجیره اینجا نمایش داده می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumat näkyvät täällä sitä mukaa kun ne vahvistuvat ketjussa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga transaksyon habang nakukumpirma ang mga ito on-chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transactions apparaissent ici dès leur confirmation sur la chaîne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עסקאות מופיעות כאן ככל שהן מאושרות בבלוקצ'יין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे-जैसे लेन-देन ऑन-चेन पुष्ट होते हैं, वे यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcije se ovdje pojavljuju kako se potvrđuju na lancu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tranzakciók itt jelennek meg, ahogy a láncon megerősítést nyernek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi muncul di sini saat dikonfirmasi on-chain."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Færslur birtast hér um leið og þær eru staðfestar á keðjunni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transazioni appaiono qui non appena vengono confermate on-chain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引はオンチェーンで確認されると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래는 온체인에서 확인되는 대로 여기에 나타나요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijos atsiranda čia, kai jos patvirtinamos grandinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījumi parādās šeit, tiklīdz tie tiek apstiprināti ķēdē."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇടപാടുകൾ ഓൺ-ചെയിനിൽ സ്ഥിരീകരിക്കുമ്പോൾ ഇവിടെ ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवहार ऑन-चेन पुष्टी होताच इथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi akan muncul di sini sebaik sahaja disahkan di rantaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksjoner vises her etter hvert som de bekreftes på kjeden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties verschijnen hier zodra ze on-chain bevestigd worden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੈਣ-ਦੇਣ ਆਨ-ਚੇਨ ਪੁਸ਼ਟੀ ਹੁੰਦੇ ਹੀ ਇੱਥੇ ਦਿਖਾਈ ਦੇਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcje pojawiają się tutaj w miarę ich potwierdzania w łańcuchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transações aparecem aqui à medida que são confirmadas na rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacțiile apar aici pe măsură ce sunt confirmate pe lanț."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакции появляются здесь по мере подтверждения в сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcie sa tu zobrazujú, keď sa potvrdia v reťazci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcije se prikažejo tukaj, ko se potrdijo v verigi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакције се појављују овде како се потврђују на ланцу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktioner visas här när de bekräftas på kedjan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Miamala inaonekana hapa inapothibitishwa kwenye mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனைகள் ஆன்-செயினில் உறுதியாகும் போது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లావాదేవీలు ఆన్-చైన్‌లో నిర్ధారణ అయిన వెంటనే ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมจะปรากฏที่นี่เมื่อได้รับการยืนยันบนเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler zincirde onaylandıkça burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакції з'являються тут у міру підтвердження в мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین آن-چین تصدیق ہوتے ہی یہاں ظاہر ہو جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch xuất hiện ở đây khi được xác nhận trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易在链上确认后会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易在鏈上確認後會顯示在這裡。"
          }
        }
      }
    },
