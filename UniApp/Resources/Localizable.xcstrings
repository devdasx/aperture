    "EIP-55 checksum doesn't match. Double-check the address — one wrong letter case can mean the wrong contract.": {
      "extractionState": "new",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏EIP-55 checksum غير مطابق. دقّق العنوان مرّة أخرى — حرف واحد بحالة مختلفة قد يعني عقداً مختلفاً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 চেকসাম মেলে না। ঠিকানাটি আবার মিলিয়ে দেখুন — একটি অক্ষরের বড়/ছোট হাত ভুল হলেও সেটি অন্য কন্ট্রাক্ট হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma de control EIP-55 no coincideix. Comprova de nou l’adreça — una sola lletra amb una majúscula o minúscula errònia pot voler dir un altre contracte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolní součet EIP-55 nesedí. Adresu pečlivě překontrolujte — i jediný špatně napsaný velký nebo malý znak může znamenat jiný kontrakt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55-tjeksummen stemmer ikke. Tjek adressen igen — bare ét forkert store eller lille bogstav kan betyde en anden kontrakt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die EIP-55-Prüfsumme stimmt nicht überein. Überprüfe die Adresse — schon ein falscher Groß-/Kleinbuchstabe kann einen anderen Vertrag bedeuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το EIP-55 checksum δεν ταιριάζει. Ελέγξτε ξανά τη διεύθυνση — ένας λάθος πεζός/κεφαλαίος χαρακτήρας μπορεί να σημαίνει διαφορετικό συμβόλαιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 checksum doesn't match. Double-check the address — one wrong letter case can mean the wrong contract."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma de comprobación EIP-55 no coincide. Revisa la dirección: un solo carácter en mayúsculas o minúsculas distinto puede apuntar a otro contrato."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چک‌سام EIP-55 مطابقت ندارد. نشانی را دوباره بررسی کنید — یک حرف بزرگ یا کوچک نادرست می‌تواند به معنای قرارداد اشتباه باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55-tarkistussumma ei täsmää. Tarkista osoite uudelleen — yksikin väärä iso tai pieni kirjain voi tarkoittaa eri sopimusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme de contrôle EIP-55 ne correspond pas. Vérifiez bien l’adresse — une seule majuscule erronée peut désigner le mauvais contrat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏EIP-55 checksum לא תואם. יש לבדוק שוב את הכתובת — אות אחת באותיות לא נכונות יכולה להוביל לחוזה אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 चेकसम मेल नहीं खाता। पते की दोबारा जाँच करें — एक भी अक्षर का केस गलत होने पर वह दूसरा कॉन्ट्रैक्ट हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 checksum se ne podudara. Pažljivo provjerite adresu — i jedno krivo veliko ili malo slovo može značiti drugačiji ugovor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az EIP-55 ellenőrzőösszeg nem egyezik. Nézd át újra a címet — egyetlen rossz kis- vagy nagybetű is más szerződést jelenthet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Checksum EIP-55 tidak cocok. Periksa kembali alamatnya — satu huruf besar-kecil yang salah bisa berarti kontrak yang salah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checksum EIP-55 non corrisponde. Controlli bene l’indirizzo — una sola lettera maiuscola o minuscola sbagliata può indicare il contratto errato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 のチェックサムが一致しません。アドレスをもう一度確認してください — 1 文字の大文字 / 小文字違いで別のコントラクトを指すことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 체크섬이 일치하지 않아요. 주소를 다시 확인하세요 — 한 글자의 대소문자만 틀려도 다른 컨트랙트가 될 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55-sjekksummen stemmer ikke. Sjekk adressen en gang til — en enkelt feil store/små bokstav kan bety en annen kontrakt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55-checksum komt niet overeen. Controleer het adres nogmaals — één verkeerde hoofdletter kan een verkeerd contract betekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma kontrolna EIP-55 nie pasuje. Sprawdź dokładnie adres — jedna błędna wielkość litery może oznaczać zły kontrakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checksum EIP-55 não confere. Confira o endereço com atenção — uma única letra com caixa errada pode apontar para outro contrato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma de control EIP-55 nu coincide. Verifică adresa cu atenție — o singură literă cu majusculă sau minusculă greșită poate însemna alt contract."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольная сумма EIP-55 не совпадает. Перепроверьте адрес — даже одна неверная буква в регистре может означать другой контракт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolný súčet EIP-55 sa nezhoduje. Adresu si starostlivo skontrolujte — aj jeden nesprávne napísaný veľký či malý znak môže znamenať iný kontrakt."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolna vsota EIP-55 se ne ujema. Še enkrat preverite naslov — že ena napačno zapisana velika ali mala črka lahko pomeni drugo pogodbo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 checksum се не подудара. Пажљиво проверите адресу — једно погрешно велико или мало слово може значити други уговор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55-checksumman stämmer inte. Dubbelkolla adressen — en enda fel versal kan betyda fel kontrakt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช็กซัม EIP-55 ไม่ตรงกัน ตรวจสอบที่อยู่ให้ดี — ตัวพิมพ์ผิดเพียงตัวเดียวอาจหมายถึงสัญญาที่ผิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 sağlama toplamı eşleşmiyor. Adresi yeniden kontrol edin — tek bir harfin büyük/küçük yazımı yanlış sözleşme anlamına gelebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольна сума EIP-55 не збігається. Перевірте адресу ще раз — навіть одна літера в неправильному регістрі може означати інший контракт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng kiểm tra EIP-55 không khớp. Hãy kiểm tra kỹ địa chỉ — chỉ một chữ viết hoa hay thường sai có thể dẫn đến nhầm hợp đồng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 校验和不匹配。请再次检查地址 — 任何一个字母大小写不同都可能指向错误的合约。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 檢查碼不符。請再次確認地址 — 任何一個字母大小寫不同都可能指向錯誤的合約。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 چیک سم مطابقت نہیں رکھتا۔ ایڈریس کو دوبارہ جانچیں — ایک غلط حرف کا کیس غلط کنٹریکٹ کا مطلب ہو سکتا ہے۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контролната сума по EIP-55 не съвпада. Проверете адреса отново — една грешна главна/малка буква може да означава грешен договор."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 kontrollsumma ei ühti. Kontrolli aadress üle — üks vale tähesuurus võib tähendada valet lepingut."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 kontrolinė suma nesutampa. Dar kartą patikrinkite adresą — viena neteisinga raidės registro forma gali reikšti klaidingą sutartį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 kontrolsumma nesakrīt. Vēlreiz pārbaudiet adresi — viens nepareizs burta reģistrs var nozīmēt nepareizu līgumu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 tékksumma stemmir ekki. Athugaðu fangið vandlega — einn rangur hástafur eða lágstafur getur þýtt rangan samning."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah semak EIP-55 tidak sepadan. Semak alamat sekali lagi — satu huruf besar atau kecil yang salah boleh bermakna kontrak yang salah."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tugma ang EIP-55 checksum. Suriing mabuti ang address — ang isang maling letter case ay maaaring mangahulugan ng maling contract."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisho la EIP-55 halilingani. Kagua anwani tena — herufi moja yenye kesi isiyo sahihi inaweza kumaanisha mkataba usio sahihi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55-kontrolesom stem nie ooreen nie. Kontroleer die adres weer — een verkeerde lettergrootte kan die verkeerde kontrak beteken."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 செக்சம் பொருந்தவில்லை. முகவரியை மீண்டும் சரிபார்க்கவும் — ஒரு எழுத்தின் தவறான பெரிய/சிறிய வடிவம் தவறான ஒப்பந்தத்தைக் குறிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 చెక్‌సమ్ సరిపోలడం లేదు. చిరునామాను మళ్లీ సరిచూసుకోండి — ఒక అక్షరం తప్పు పెద్ద/చిన్న రూపం తప్పు కాంట్రాక్ట్‌ను సూచించవచ్చు."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 ചെക്ക്‌സം പൊരുത്തപ്പെടുന്നില്ല. വിലാസം ഒന്നുകൂടി പരിശോധിക്കുക — ഒരു അക്ഷരത്തിന്റെ തെറ്റായ കേസ് തെറ്റായ കരാർ അർത്ഥമാക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 चेकसम जुळत नाही. पत्ता पुन्हा तपासा — एका अक्षराची चुकीची केस चुकीचा करार दर्शवू शकते."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "EIP-55 ਚੈੱਕਸਮ ਮੇਲ ਨਹੀਂ ਖਾਂਦਾ। ਪਤਾ ਦੁਬਾਰਾ ਜਾਂਚੋ — ਇੱਕ ਅੱਖਰ ਦਾ ਗਲਤ ਕੇਸ ਗਲਤ ਕੰਟਰੈਕਟ ਦਾ ਮਤਲਬ ਹੋ ਸਕਦਾ ਹੈ।"
          }
        }
      }
    },
