          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإرسال إلى شبكة %@. قد يستغرق التأكيد لحظة — تحقق من المستكشف للنتيجة النهائية."
          }
        },
        "bg": {
          "stringUnit": {
