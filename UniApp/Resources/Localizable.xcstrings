          "stringUnit": {
            "state": "translated",
            "value": "Anmodningsgrænse nået — prøv igen om lidt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage-Limit erreicht – bitte gleich erneut versuchen"
