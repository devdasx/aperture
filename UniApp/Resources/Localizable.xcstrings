        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਜਾਇਦਾਦ ਵੇਰਵਿਆਂ ਲਈ ਹਰ ਫਿਲਟਰ ਅਤੇ ਕ੍ਰਮ ਚੋਣ ਸਾਫ਼ ਕਰਦਾ ਹੈ। ਜਾਰੀ ਰੱਖਣਾ ਹੈ?"
