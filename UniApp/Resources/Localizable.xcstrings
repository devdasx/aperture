          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, ਤੁਹਾਡਾ ਬੈਂਕ — ਕਿਸੇ ਨੂੰ ਵੀ ਤੁਹਾਡੀ ਰਿਕਵਰੀ ਫਰੇਜ਼ ਦੀ ਲੋੜ ਨਹੀਂ। ਕਦੇ ਵੀ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, twój bank — nikt nie potrzebuje twojej frazy odzyskiwania. Nigdy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, seu banco — ninguém precisa da sua frase de recuperação. Nunca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, banca ta — nimeni nu are nevoie de expresia ta de recuperare. Niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, ваш банк — никому не нужна ваша фраза восстановления. Никогда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, vaša banka — nikto vašu obnovovaciu frázu nepotrebuje. Nikdy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, vaša banka — nihče ne potrebuje vaše obnovitvene fraze. Nikoli."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, ваша банка — никоме није потребна ваша фраза за опоравак. Никада."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, din bank — ingen behöver din återställningsfras. Aldrig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, benki yako — hakuna anayehitaji kifungu chako cha urejesho. Kamwe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, உங்கள் வங்கி — யாருக்கும் உங்கள் மீட்பு சொற்றொடர் தேவையில்லை. ஒருபோதும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, మీ బ్యాంక్ — ఎవరికీ మీ రికవరీ ఫ్రేజ్ అవసరం లేదు. ఎప్పటికీ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, ธนาคารของคุณ — ไม่มีใครต้องการวลีกู้คืนของคุณ ไม่ว่าเมื่อใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, bankanız — hiç kimsenin kurtarma ifadenize ihtiyacı yoktur. Asla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, ваш банк — нікому не потрібна ваша фраза відновлення. Ніколи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture، Apple، آپ کا بینک — کسی کو بھی آپ کے ریکوری فریز کی ضرورت نہیں۔ کبھی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture, Apple, ngân hàng của bạn — không ai cần cụm từ khôi phục của bạn. Không bao giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture、Apple、你的银行——没有人需要你的助记词。永远不会。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture、Apple、你的銀行——沒有人需要你的助記詞。永遠不會。"
          }
        }
      }
    },
