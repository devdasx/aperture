        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture nije mogao pročitati naziv i simbol s lanca — potvrdite gore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture nem tudta beolvasni a nevet és a szimbólumot a láncról — kérjük, erősítsd meg fent."
