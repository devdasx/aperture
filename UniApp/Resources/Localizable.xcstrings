        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa pemulihan yang baru anda lihat akan dibuang. Anda perlu memulakan semula proses penciptaan jika anda berubah fikiran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprettingsfrasen du nettopp så vil bli forkastet. Du må starte opprettelsesprosessen på nytt hvis du ombestemmer deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herstelzin die je net zag, wordt verwijderd. Je moet het aanmaakproces opnieuw starten als je van gedachten verandert."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਹੁਣੇ ਹੁਣੇ ਦੇਖੀ ਰਿਕਵਰੀ ਫ੍ਰੇਜ਼ ਛੱਡ ਦਿੱਤੀ ਜਾਵੇਗੀ। ਜੇ ਤੁਸੀਂ ਆਪਣਾ ਮਨ ਬਦਲਦੇ ਹੋ ਤਾਂ ਤੁਹਾਨੂੰ ਬਣਾਉਣ ਦੀ ਪ੍ਰਕਿਰਿਆ ਨੂੰ ਦੁਬਾਰਾ ਸ਼ੁਰੂ ਕਰਨਾ ਪਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
