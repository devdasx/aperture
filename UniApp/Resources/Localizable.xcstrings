        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvič pošiljate sem — dvakrat preverite. Transakcij ni mogoče razveljaviti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvi put šaljete ovde — dvaput proverite. Transakcije se ne mogu poništiti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första gången du skickar hit — dubbelkolla det. Transaktioner kan inte ångras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mara ya kwanza kutuma hapa — ihakiki mara mbili. Miamala haiwezi kutenguliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே முதல் முறையாக அனுப்புகிறீர்கள் — இருமுறை சரிபார்க்கவும். பரிவர்த்தனைகளைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడికి మొదటిసారి పంపుతున్నారు — దాన్ని రెండుసార్లు తనిఖీ చేయండి. లావాదేవీలను తిరిగి మార్చలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งมาที่นี่เป็นครั้งแรก — ตรวจสอบให้ดี ธุรกรรมไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya ilk gönderim — iki kez kontrol edin. İşlemler geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перше надсилання сюди — перевірте ще раз. Транзакції неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلی بار یہاں بھیج رہے ہیں — اسے دوبارہ چیک کریں۔ ٹرانزیکشنز واپس نہیں ہو سکتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đầu gửi tới đây — hãy kiểm tra kỹ. Giao dịch không thể đảo ngược."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次发送到此处——请仔细核对。交易无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次傳送到此處——請仔細核對。交易無法復原。"
          }
        }
      }
    },
