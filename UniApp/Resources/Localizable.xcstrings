          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giao dịch liên quan đến %1$@ trên %2$@ xuất hiện ở đây khi chúng được xác nhận trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "涉及 %2$@ 上 %1$@ 的交易在链上确认后会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "涉及 %2$@ 上 %1$@ 的交易在鏈上確認後會顯示在這裡。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ پر %1$@ سے متعلق لین دین جیسے ہی آن-چین تصدیق ہوتے ہیں یہاں ظاہر ہوتے ہیں۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакциите, включващи %1$@ в %2$@, се появяват тук, щом бъдат потвърдени в мрежата."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehingud, mis hõlmavad %1$@ võrgus %2$@, ilmuvad siia kohe, kui need ahelas kinnitatakse."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijos, susijusios su %1$@ tinkle %2$@, atsiranda čia, kai tik patvirtinamos grandinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījumi, kas saistīti ar %1$@ tīklā %2$@, parādās šeit, tiklīdz tie tiek apstiprināti ķēdē."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Færslur sem varða %1$@ á %2$@ birtast hér jafnóðum og þær staðfestast á keðjunni."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi yang melibatkan %1$@ pada %2$@ muncul di sini apabila ia disahkan atas rantaian."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumilitaw dito ang mga transaksyong kinasasangkutan ng %1$@ sa %2$@ habang nakukumpirma ang mga ito on-chain."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Miamala inayohusisha %1$@ kwenye %2$@ inaonekana hapa inapothibitishwa kwenye mnyororo."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksies wat %1$@ op %2$@ behels, verskyn hier soos hulle op die ketting bevestig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இல் %1$@ சம்பந்தப்பட்ட பரிவர்த்தனைகள் சங்கிலியில் உறுதிப்படும்போது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ లో %1$@ సంబంధించిన లావాదేవీలు చైన్‌లో నిర్ధారించబడినప్పుడు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-ൽ %1$@ ഉൾപ്പെടുന്ന ഇടപാടുകൾ ഓൺ-ചെയിൻ സ്ഥിരീകരിക്കുമ്പോൾ ഇവിടെ ദൃശ്യമാകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ वर %1$@ समाविष्ट असलेले व्यवहार ऑन-चेन पुष्टी होताच येथे दिसतात."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ਉੱਤੇ %1$@ ਨਾਲ ਜੁੜੇ ਲੈਣ-ਦੇਣ ਜਿਵੇਂ ਹੀ ਉਹ ਆਨ-ਚੇਨ ਪੁਸ਼ਟ ਹੁੰਦੇ ਹਨ ਇੱਥੇ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ।"
          }
        }
      }
    },
    "Transactions involving this asset appear here as they confirm on-chain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا المعاملات المرتبطة بهذا الأصل فور تأكيدها على السلسلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাসেট জড়িত লেনদেনগুলো অন-চেইনে নিশ্চিত হলেই এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transaccions d’aquest actiu apareixen aquí a mesura que es confirmen on-chain."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce s tímto aktivem se objeví zde, jakmile budou potvrzeny na chainu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktioner med dette aktiv vises her, efterhånden som de bekræftes on-chain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen mit diesem Asset erscheinen hier, sobald sie on-chain bestätigt sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συναλλαγές που αφορούν αυτό το asset εμφανίζονται εδώ καθώς επιβεβαιώνονται στην αλυσίδα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transacciones de este activo aparecen aquí cuando se confirman en la cadena."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش‌های مرتبط با این دارایی همین‌که روی زنجیره تأیید شوند اینجا نمایان می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän omaisuuteen liittyvät tapahtumat näkyvät täällä, kun ne vahvistuvat ketjussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transactions impliquant cet actif apparaissent ici dès leur confirmation sur la chaîne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עסקאות הקשורות לנכס הזה מופיעות כאן ברגע שהן מאושרות בבלוקצ׳יין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एसेट से जुड़ी लेनदेन ऑन-चेन कन्फ़र्म होते ही यहाँ दिखाई देती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcije s ovom imovinom pojavljuju se ovdje čim se potvrde na lancu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközhöz kapcsolódó tranzakciók itt jelennek meg, ahogy láncon visszaigazolódnak."
