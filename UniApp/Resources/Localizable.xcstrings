        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сакривене мреже остају подржане — утиче само на приказ овог средства."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolda nätverk fortsätter att stödjas — endast den här tillgångens vy påverkas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครือข่ายที่ซ่อนยังคงรองรับ — มีผลเฉพาะมุมมองของสินทรัพย์นี้"
