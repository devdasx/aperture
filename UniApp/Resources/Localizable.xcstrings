          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ਉੱਤੇ %1$@ ਨਾਲ ਜੁੜੇ ਲੈਣ-ਦੇਣ ਜਿਵੇਂ ਹੀ ਉਹ ਆਨ-ਚੇਨ ਪੁਸ਼ਟ ਹੁੰਦੇ ਹਨ ਇੱਥੇ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcje obejmujące %1$@ w sieci %2$@ pojawią się tutaj po potwierdzeniu w łańcuchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transações envolvendo %1$@ em %2$@ aparecem aqui assim que são confirmadas na rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacțiile cu %1$@ în %2$@ apar aici pe măsură ce sunt confirmate pe chain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакции с участием %1$@ в сети %2$@ появляются здесь по мере подтверждения в блокчейне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcie s %1$@ v sieti %2$@ sa zobrazia tu, len čo sa potvrdia on-chain."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcije z %1$@ v omrežju %2$@ se prikažejo tukaj, ko se potrdijo na verigi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакције са %1$@ на %2$@ појављују се овде чим се потврде на ланцу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktioner med %1$@ på %2$@ visas här när de bekräftas on-chain."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Miamala inayohusisha %1$@ kwenye %2$@ inaonekana hapa inapothibitishwa kwenye mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இல் %1$@ சம்பந்தப்பட்ட பரிவர்த்தனைகள் சங்கிலியில் உறுதிப்படும்போது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ లో %1$@ సంబంధించిన లావాదేవీలు చైన్‌లో నిర్ధారించబడినప్పుడు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมที่เกี่ยวข้องกับ %1$@ บน %2$@ จะปรากฏที่นี่เมื่อยืนยันบนเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ üzerindeki %1$@ ile ilgili işlemler, zincirde onaylandıkça burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакції з %1$@ у мережі %2$@ з’являються тут після підтвердження в мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ پر %1$@ سے متعلق لین دین جیسے ہی آن-چین تصدیق ہوتے ہیں یہاں ظاہر ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giao dịch liên quan đến %1$@ trên %2$@ xuất hiện ở đây khi chúng được xác nhận trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "涉及 %2$@ 上 %1$@ 的交易在链上确认后会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "涉及 %2$@ 上 %1$@ 的交易在鏈上確認後會顯示在這裡。"
          }
        }
      }
    },
    "Transactions involving this asset appear here as they confirm on-chain.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksies wat hierdie bate behels, verskyn hier soos hulle op die ketting bevestig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا المعاملات المرتبطة بهذا الأصل فور تأكيدها على السلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакциите, включващи този актив, се появяват тук, щом бъдат потвърдени в мрежата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাসেট জড়িত লেনদেনগুলো অন-চেইনে নিশ্চিত হলেই এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transaccions d’aquest actiu apareixen aquí a mesura que es confirmen on-chain."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce s tímto aktivem se objeví zde, jakmile budou potvrzeny na chainu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktioner med dette aktiv vises her, efterhånden som de bekræftes on-chain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen mit diesem Asset erscheinen hier, sobald sie on-chain bestätigt sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συναλλαγές που αφορούν αυτό το asset εμφανίζονται εδώ καθώς επιβεβαιώνονται στην αλυσίδα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transacciones de este activo aparecen aquí cuando se confirman en la cadena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda vara hõlmavad tehingud ilmuvad siia kohe, kui need ahelas kinnitatakse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش‌های مرتبط با این دارایی همین‌که روی زنجیره تأیید شوند اینجا نمایان می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän omaisuuteen liittyvät tapahtumat näkyvät täällä, kun ne vahvistuvat ketjussa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumilitaw dito ang mga transaksyong kinasasangkutan ng asset na ito habang nakukumpirma ang mga ito on-chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transactions impliquant cet actif apparaissent ici dès leur confirmation sur la chaîne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עסקאות הקשורות לנכס הזה מופיעות כאן ברגע שהן מאושרות בבלוקצ׳יין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एसेट से जुड़ी लेनदेन ऑन-चेन कन्फ़र्म होते ही यहाँ दिखाई देती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcije s ovom imovinom pojavljuju se ovdje čim se potvrde na lancu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközhöz kapcsolódó tranzakciók itt jelennek meg, ahogy láncon visszaigazolódnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi yang melibatkan aset ini muncul di sini saat dikonfirmasi di rantai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Færslur sem varða þessa eign birtast hér jafnóðum og þær staðfestast á keðjunni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transazioni che coinvolgono questo asset compaiono qui man mano che vengono confermate sulla catena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアセットに関するトランザクションは、チェーンで承認され次第ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자산 관련 거래는 온체인에서 확인되는 대로 여기에 표시돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijos, susijusios su šiuo turtu, atsiranda čia, kai tik patvirtinamos grandinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījumi, kas saistīti ar šo aktīvu, parādās šeit, tiklīdz tie tiek apstiprināti ķēdē."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ആസ്തി ഉൾപ്പെടുന്ന ഇടപാടുകൾ ഓൺ-ചെയിൻ സ്ഥിരീകരിക്കുമ്പോൾ ഇവിടെ ദൃശ്യമാകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही मालमत्ता समाविष्ट असलेले व्यवहार ऑन-चेन पुष्टी होताच येथे दिसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi yang melibatkan aset ini muncul di sini apabila ia disahkan atas rantaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksjoner med denne ressursen vises her etter hvert som de bekreftes on-chain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties met dit asset verschijnen hier zodra ze on-chain bevestigd zijn."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਜਾਇਦਾਦ ਨਾਲ ਜੁੜੇ ਲੈਣ-ਦੇਣ ਜਿਵੇਂ ਹੀ ਉਹ ਆਨ-ਚੇਨ ਪੁਸ਼ਟ ਹੁੰਦੇ ਹਨ ਇੱਥੇ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcje obejmujące to aktywo pojawią się tutaj po potwierdzeniu w łańcuchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transações deste ativo aparecem aqui assim que são confirmadas na rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacțiile cu acest activ apar aici pe măsură ce sunt confirmate pe chain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакции с этим активом появляются здесь по мере подтверждения в блокчейне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcie s týmto aktívom sa zobrazia tu, len čo sa potvrdia on-chain."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcije s tem sredstvom se prikažejo tukaj, ko se potrdijo na verigi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакције са овим средством појављују се овде чим се потврде на ланцу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktioner med den här tillgången visas här när de bekräftas on-chain."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Miamala inayohusisha rasilimali hii inaonekana hapa inapothibitishwa kwenye mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சொத்து சம்பந்தப்பட்ட பரிவர்த்தனைகள் சங்கிலியில் உறுதிப்படும்போது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఆస్తికి సంబంధించిన లావాదేవీలు చైన్‌లో నిర్ధారించబడినప్పుడు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมที่เกี่ยวข้องกับสินทรัพย์นี้จะปรากฏที่นี่เมื่อยืนยันบนเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu varlıkla ilgili işlemler, zincirde onaylandıkça burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакції з цим активом з’являються тут після підтвердження в мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اثاثے سے متعلق لین دین جیسے ہی آن-چین تصدیق ہوتے ہیں یہاں ظاہر ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giao dịch liên quan đến tài sản này xuất hiện ở đây khi chúng được xác nhận trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "涉及该资产的交易在链上确认后会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "涉及此資產的交易在鏈上確認後會顯示在這裡。"
          }
        }
      }
    },
