        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej klucz konta \\(chain.displayName). Aperture sprawdza format przed wyprowadzeniem jakiegokolwiek adresu, a klucz nigdy nie opuszcza tego iPhone'a."
