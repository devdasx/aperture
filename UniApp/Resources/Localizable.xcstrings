        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce gördüğünüz kurtarma ifadesi atılacak. Fikrinizi değiştirirseniz oluşturma sürecini yeniden başlatmanız gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фраза відновлення, яку ви щойно бачили, буде відкинута. Вам доведеться почати процес створення знову, якщо передумаєте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے ابھی جو ریکوری فقرہ دیکھا وہ مسترد کر دیا جائے گا۔ اگر آپ نے ارادہ بدل لیا تو آپ کو تخلیق کا عمل دوبارہ شروع کرنا ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cụm từ khôi phục bạn vừa xem sẽ bị loại bỏ. Bạn sẽ phải bắt đầu lại quá trình tạo nếu đổi ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你刚才看到的恢复短语将被丢弃。如果你改变主意,需要重新开始创建过程。"
