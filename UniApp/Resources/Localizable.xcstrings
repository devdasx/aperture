          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਜਾਇਦਾਦ ਦੀ ਹੋਰ ਗਤੀਵਿਧੀ ਦੇਖਣ ਲਈ ਫਿਲਟਰ ਸ਼ੀਟ ਅਡਜਸਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj arkusz filtrów, aby zobaczyć więcej aktywności tego aktywa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o filtro para ver mais atividade deste ativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustează filtrul pentru a vedea mai multă activitate pentru acest activ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените фильтры, чтобы увидеть больше активности по этому активу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte filter, aby ste videli viac aktivity tohto aktíva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodite filter, da vidite več dejavnosti za to sredstvo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Подесите филтер да бисте видели више активности за ово средство."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justera filtret för att se mer aktivitet för den här tillgången."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekebisha jedwali la kichujio ili kuona shughuli zaidi za rasilimali hii."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சொத்துக்கான கூடுதல் செயல்பாட்டைக் காண வடிகட்டித் தாளைச் சரிசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఆస్తి కోసం మరింత కార్యకలాపాన్ని చూడటానికి ఫిల్టర్ షీట్‌ను సర్దుబాటు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับแผ่นตัวกรองเพื่อดูกิจกรรมของสินทรัพย์นี้เพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu varlık için daha fazla etkinlik görmek üzere filtreleri ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте фільтр, щоб побачити більше активності цього активу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اثاثے کی مزید سرگرمی دیکھنے کے لیے فلٹر شیٹ کو ایڈجسٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh bộ lọc để xem thêm hoạt động cho tài sản này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整筛选条件以查看该资产的更多活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整篩選條件以查看此資產的更多活動。"
          }
        }
      }
    },
