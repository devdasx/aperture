    },
    "Aperture signs this on your iPhone and broadcasts it to the network. A bridge moves funds across chains and can't be reversed once it's sent.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture onderteken dit op jou iPhone en saai dit uit na die netwerk. 'n Brug skuif fondse oor kettings en kan nie omgekeer word sodra dit gestuur is nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقّع Aperture على هذا على جهاز iPhone الخاص بك ويبثّه إلى الشبكة. الجسر ينقل الأموال عبر السلاسل ولا يمكن عكسه بعد إرساله."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture подписва това на вашия iPhone и го излъчва в мрежата. Мостът премества средства между вериги и не може да бъде отменен, след като е изпратен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture এটি আপনার iPhone-এ সই করে এবং নেটওয়ার্কে সম্প্রচার করে। একটি ব্রিজ চেইন জুড়ে তহবিল সরায় এবং পাঠানোর পর তা বাতিল করা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ho signa al teu iPhone i ho emet a la xarxa. Un pont mou fons entre cadenes i no es pot revertir un cop enviat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture toto podepíše na vašem iPhonu a odešle do sítě. Most přesouvá prostředky mezi řetězci a po odeslání jej nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture signerer dette på din iPhone og udsender det til netværket. En bro flytter midler mellem kæder og kan ikke fortrydes, når den er sendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture signiert dies auf deinem iPhone und sendet es ans Netzwerk. Eine Bridge bewegt Mittel über Chains hinweg und kann nach dem Senden nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Aperture το υπογράφει στο iPhone σας και το μεταδίδει στο δίκτυο. Μια γέφυρα μετακινεί κεφάλαια μεταξύ αλυσίδων και δεν μπορεί να αναιρεθεί μόλις αποσταλεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture lo firma en tu iPhone y lo transmite a la red. Un puente mueve fondos entre redes y no se puede revertir una vez enviado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture allkirjastab selle teie iPhone'is ja edastab võrku. Sild liigutab vahendeid ahelate vahel ja seda ei saa pärast saatmist tagasi pöörata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture این را روی آیفون شما امضا و به شبکه ارسال می‌کند. پل وجوه را میان زنجیره‌ها جابه‌جا می‌کند و پس از ارسال قابل بازگشت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture allekirjoittaa tämän iPhonessasi ja lähettää sen verkkoon. Silta siirtää varoja ketjujen välillä, eikä sitä voi perua lähetyksen jälkeen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinipirmahan ito ng Aperture sa iyong iPhone at ibino-broadcast sa network. Inililipat ng bridge ang pondo sa iba't ibang chain at hindi na maibabalik kapag naipadala na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture signe ceci sur votre iPhone et le diffuse sur le réseau. Un pont déplace des fonds entre les chaînes et ne peut pas être annulé une fois envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎Aperture חותם על כך ב-iPhone שלך ומשדר אותו לרשת. גשר מעביר כספים בין רשתות ולא ניתן לבטלו לאחר השליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture इसे आपके iPhone पर साइन करता है और नेटवर्क पर ब्रॉडकास्ट करता है। एक ब्रिज फ़ंड को चेनों के बीच ले जाता है और भेजे जाने के बाद उसे उलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ovo potpisuje na vašem iPhoneu i emitira na mrežu. Most prenosi sredstva preko lanaca i ne može se poništiti nakon slanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture ezt az iPhone-odon írja alá, és sugározza a hálózatra. Egy híd láncok között mozgat pénzt, és elküldés után nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture menandatangani ini di iPhone Anda dan menyiarkannya ke jaringan. Bridge memindahkan dana antar chain dan tidak dapat dibatalkan setelah dikirim."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture undirritar þetta á iPhone-num þínum og sendir það á netið. Brú flytur fé milli keðja og ekki er hægt að afturkalla það þegar það hefur verið sent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture la firma sul tuo iPhone e la trasmette alla rete. Un bridge sposta i fondi tra chain e non può essere annullato una volta inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture はこれを iPhone 上で署名し、ネットワークにブロードキャストします。ブリッジはチェーン間で資金を移動させ、送信後は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture는 이를 iPhone에서 서명하여 네트워크에 전파합니다. 브리지는 체인 간에 자금을 이동하며 전송된 후에는 되돌릴 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture pasirašo tai jūsų iPhone ir transliuoja į tinklą. Tiltas perkelia lėšas tarp grandinių ir negali būti atšauktas, kai išsiųsta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture paraksta šo jūsu iPhone un pārraida to tīklā. Tilts pārvieto līdzekļus starp tīkliem, un to nevar atsaukt, tiklīdz tas ir nosūtīts."
