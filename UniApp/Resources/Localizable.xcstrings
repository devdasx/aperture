    "Your passcode unlocks Aperture. Face ID is a faster shortcut to the same lock — you can always fall back to passcode.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou toegangskode ontsluit Aperture. Face ID is 'n vinniger kortpad na dieselfde slot — jy kan altyd terugkeer na die toegangskode."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح رمز المرور Aperture. Face ID اختصار أسرع إلى القفل نفسه — يمكنك دائمًا العودة إلى رمز المرور."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашият код отключва Aperture. Face ID е по-бърз пряк път до същата ключалка — винаги можете да се върнете към кода."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পাসকোড Aperture আনলক করে। Face ID একই লকের একটি দ্রুততর শর্টকাট — আপনি যেকোনো সময় পাসকোডে ফিরে যেতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu codi desbloqueja Aperture. El Face ID és una drecera més ràpida al mateix pany: sempre pots tornar al codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture odemyká váš kód. Face ID je rychlejší zkratka ke stejnému zámku – ke kódu se vždy můžete vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din kode låser Aperture op. Face ID er en hurtigere genvej til samme lås – du kan altid falde tilbage på koden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Ihrem Code entsperren Sie Aperture. Face ID ist eine schnellere Abkürzung zum selben Schloss – Sie können jederzeit zum Code zurückkehren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός σας ξεκλειδώνει το Aperture. Το Face ID είναι μια πιο γρήγορη συντόμευση προς την ίδια κλειδαριά — μπορείτε πάντα να επιστρέψετε στον κωδικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu código desbloquea Aperture. Face ID es un atajo más rápido al mismo bloqueo: siempre puedes volver al código."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääsukood avab Aperture'i. Face ID on kiirem otsetee samale lukule — saate alati pääsukoodile naasta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز شما Aperture را باز می‌کند. Face ID میانبری سریع‌تر برای همان قفل است — همیشه می‌توانید به رمز برگردید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääsykoodisi avaa Aperturen. Face ID on nopeampi oikotie samaan lukkoon – voit aina palata pääsykoodiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ng passcode ninyo ang Aperture. Ang Face ID ay mas mabilis na shortcut sa parehong lock — puwede kayong bumalik sa passcode anumang oras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre code déverrouille Aperture. Face ID est un raccourci plus rapide vers le même verrouillage — vous pouvez toujours revenir au code."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד הגישה שלך פותח את Aperture. Face ID הוא קיצור דרך מהיר יותר לאותה נעילה — תמיד תוכל לחזור לקוד הגישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पासकोड Aperture को अनलॉक करता है। Face ID उसी लॉक तक का तेज़ शॉर्टकट है — आप हमेशा पासकोड पर लौट सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš pristupni kod otključava Aperture. Face ID je brža prečica do iste brave — uvijek se možete vratiti na pristupni kod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kódjával oldja fel az Aperture-t. A Face ID egy gyorsabb hozzáférési mód ugyanahhoz a zárhoz – bármikor visszatérhet a kódhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode sandi membuka Aperture. Face ID adalah pintasan lebih cepat ke kunci yang sama — Anda selalu dapat kembali ke kode sandi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðgangskóðinn opnar Aperture. Face ID er hraðari flýtileið að sömu lás — þú getur alltaf snúið aftur að aðgangskóða."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice sblocca Aperture. Face ID è una scorciatoia più rapida verso lo stesso blocco — può sempre tornare al codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードで Aperture のロックを解除します。Face ID は同じロックへの近道です。いつでもパスコードに戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호로 Aperture를 잠금 해제해요. Face ID는 같은 잠금을 빠르게 푸는 지름길이에요 — 언제든 암호로 돌아갈 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų prieigos kodas atrakina Aperture. Face ID yra greitesnis tos pačios spynos sutrumpinimas — visada galite grįžti prie kodo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu piekļuves kods atbloķē Aperture. Face ID ir ātrāks īsceļš uz to pašu slēdzeni — vienmēr varat atgriezties pie koda."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പാസ്‌കോഡ് Aperture തുറക്കുന്നു. Face ID അതേ ലോക്കിലേക്കുള്ള വേഗത്തിലുള്ള കുറുക്കുവഴിയാണ് — എപ്പോൾ വേണമെങ്കിലും പാസ്‌കോഡിലേക്ക് മടങ്ങാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पासकोड Aperture अनलॉक करतो. Face ID त्याच लॉकसाठी अधिक जलद शॉर्टकट आहे — तुम्ही नेहमी पासकोडवर परत येऊ शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod laluan anda membuka Aperture. Face ID ialah jalan pintas yang lebih cepat ke kunci yang sama — anda sentiasa boleh kembali ke kod laluan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden din låser opp Aperture. Face ID er en raskere snarvei til samme lås – du kan alltid falle tilbake til koden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je toegangscode ontgrendelt Aperture. Face ID is een snellere snelkoppeling naar dezelfde vergrendeling — je kunt altijd terugvallen op de toegangscode."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਪਾਸਕੋਡ Aperture ਨੂੰ ਅਨਲਾਕ ਕਰਦਾ ਹੈ। Face ID ਉਸੇ ਲਾਕ ਲਈ ਤੇਜ਼ ਸ਼ਾਰਟਕੱਟ ਹੈ — ਤੁਸੀਂ ਕਦੇ ਵੀ ਪਾਸਕੋਡ ਉੱਤੇ ਵਾਪਸ ਆ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój kod odblokowuje Aperture. Face ID jest szybszym skrótem do tego samego zamka — zawsze możesz wrócić do kodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu código desbloqueia a Aperture. O Face ID é um atalho mais rápido para a mesma trava — você sempre pode voltar para o código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul tău deblochează Aperture. Face ID este o scurtătură mai rapidă către aceeași încuietoare — poți reveni oricând la cod."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код разблокирует Aperture. Face ID — более быстрый путь к тому же замку: вы всегда можете вернуться к коду."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaším kódom odomykáte Aperture. Face ID je rýchlejšia skratka k tomu istému zámku – ku kódu sa môžete vždy vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše geslo odklene Aperture. Face ID je hitrejša bližnjica do iste ključavnice – vedno se lahko vrnete na geslo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш код откључава Aperture. Face ID је бржа пречица до исте браве — увек можете да се вратите на код."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din kod låser upp Aperture. Face ID är en snabbare genväg till samma lås – du kan alltid återgå till koden."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenosiri lako linafungua Aperture. Face ID ni njia ya haraka zaidi kwa kufuli ile ile — daima unaweza kurudi kwenye nenosiri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடவுக்குறியீடு Aperture-ஐ திறக்கிறது. Face ID அதே பூட்டுக்கான வேகமான குறுக்குவழி — எப்போதும் கடவுக்குறியீட்டிற்கு மாறலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పాస్‌కోడ్ Aperture‌ను అన్‌లాక్ చేస్తుంది. Face ID అదే లాక్‌కు వేగవంతమైన షార్ట్‌కట్ — మీరు ఎప్పుడైనా పాస్‌కోడ్‌కు తిరిగి వెళ్లవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านปลดล็อก Aperture Face ID เป็นทางลัดที่เร็วกว่าไปยังการล็อกเดียวกัน คุณกลับมาใช้รหัสผ่านได้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolanız Aperture'ı açar. Face ID, aynı kilide daha hızlı ulaşan bir kısayoldur — istediğinizde parolaya geri dönebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш код розблоковує Aperture. Face ID — швидший спосіб відкрити той самий замок: ви завжди можете повернутися до коду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا پاس کوڈ Aperture کو کھولتا ہے۔ Face ID اسی تالے کے لیے ایک تیز شارٹ کٹ ہے — آپ کسی بھی وقت پاس کوڈ پر واپس آ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã của bạn mở khóa Aperture. Face ID là phím tắt nhanh hơn đến cùng một ổ khóa — bạn luôn có thể quay lại dùng mã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码用于解锁 Aperture。Face ID 是通往同一把锁的更快捷径——你随时可以退回到使用密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼用於解鎖 Aperture。Face ID 是通往同一把鎖的更快捷徑——你隨時可以退回到使用密碼。"
          }
        }
      }
    },
    "Your phrase wasn't kept when this wallet was imported. You still have it — to store it on this iPhone too, delete this wallet and import the phrase again.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou frase is nie gehou toe hierdie beursie ingevoer is nie. Jy het dit steeds — om dit ook op hierdie iPhone te stoor, skrap hierdie beursie en voer die frase weer in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم الاحتفاظ بعبارتك عند استيراد هذه المحفظة. لا تزال لديك — لتخزينها على جهاز iPhone هذا أيضًا، احذف هذه المحفظة واستورد العبارة مجددًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фразата ви не беше запазена, когато този портфейл беше импортиран. Все още я имате — за да я съхраните и на този iPhone, изтрийте този портфейл и импортирайте фразата отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ওয়ালেট আমদানি করার সময় আপনার ফ্রেজ রাখা হয়নি। এটি এখনও আপনার কাছে আছে — এটি এই iPhone-এও সংরক্ষণ করতে, এই ওয়ালেট মুছে ফেলুন এবং ফ্রেজ আবার আমদানি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva frase no es va conservar quan es va importar aquesta cartera. Encara la tens: per desar-la també en aquest iPhone, elimina aquesta cartera i torna a importar la frase."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše fráze nebyla uchována, když byla tato peněženka importována. Stále ji máte — chcete-li ji uložit i na tento iPhone, smažte tuto peněženku a importujte frázi znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din sætning blev ikke bevaret, da denne tegnebog blev importeret. Du har den stadig — for at gemme den på denne iPhone også, slet denne tegnebog og importer sætningen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Phrase wurde beim Importieren dieses Wallets nicht aufbewahrt. Du hast sie noch – um sie auch auf diesem iPhone zu speichern, lösche dieses Wallet und importiere die Phrase erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φράση σας δεν διατηρήθηκε κατά την εισαγωγή αυτού του πορτοφολιού. Εξακολουθείτε να την έχετε — για να την αποθηκεύσετε και σε αυτό το iPhone, διαγράψτε αυτό το πορτοφόλι και εισαγάγετε ξανά τη φράση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frase no se conservó cuando se importó esta cartera. Aún la tienes: para almacenarla también en este iPhone, elimina esta cartera e importa la frase de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie fraasi ei säilitatud, kui see rahakott imporditi. Teil on see endiselt — et seda ka sellel iPhone'il hoida, kustutage see rahakott ja importige fraas uuesti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت شما هنگام وارد کردن این کیف پول نگه داشته نشد. شما همچنان آن را دارید — برای ذخیره‌ی آن روی این آیفون نیز، این کیف پول را حذف و عبارت را دوباره وارد کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lausettasi ei säilytetty, kun tämä lompakko tuotiin. Se on yhä sinulla — tallentaaksesi sen myös tähän iPhoneen, poista tämä lompakko ja tuo lause uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naitago ang iyong phrase noong na-import ang wallet na ito. Nasa iyo pa rin ito — para iimbak din ito sa iPhone na ito, tanggalin ang wallet na ito at i-import muli ang phrase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre phrase n'a pas été conservée lors de l'importation de ce portefeuille. Vous l'avez toujours — pour la stocker aussi sur cet iPhone, supprimez ce portefeuille et réimportez la phrase."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הביטוי שלך לא נשמר כאשר ארנק זה יובא. הוא עדיין ברשותך — כדי לשמור אותו גם ב-iPhone זה, מחק ארנק זה וייבא את הביטוי שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वॉलेट को इंपोर्ट करते समय आपका फ़्रेज़ नहीं रखा गया था। यह अभी भी आपके पास है — इसे इस iPhone पर भी संग्रहीत करने के लिए, इस वॉलेट को हटाएँ और फ़्रेज़ फिर से इंपोर्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša fraza nije sačuvana kada je ovaj novčanik uvezen. I dalje je imate — da biste je pohranili i na ovom iPhoneu, izbrišite ovaj novčanik i ponovno uvezite frazu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kifejezésed nem lett megőrizve, amikor ezt a tárcát importáltad. Még megvan neked — hogy ezen az iPhone-on is tárolódjon, töröld ezt a tárcát, és importáld újra a kifejezést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa Anda tidak disimpan saat dompet ini diimpor. Anda masih memilikinya — untuk menyimpannya di iPhone ini juga, hapus dompet ini dan impor frasanya lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Setningin þín var ekki geymd þegar þetta veski var flutt inn. Þú átt hana enn — til að geyma hana líka á þessum iPhone skaltu eyða þessu veski og flytja setninguna inn aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua frase non è stata conservata quando questo wallet è stato importato. La possiedi ancora — per memorizzarla anche su questo iPhone, elimina questo wallet e importa di nuovo la frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウォレットをインポートした際、フレーズは保持されませんでした。あなたはまだそれを持っています — この iPhone にも保存するには、このウォレットを削除してフレーズを再びインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지갑을 가져올 때 문구가 보관되지 않았습니다. 문구는 여전히 가지고 계십니다 — 이 iPhone에도 저장하려면 이 지갑을 삭제하고 문구를 다시 가져오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų frazė nebuvo išsaugota, kai ši piniginė buvo importuota. Ji vis dar turima – kad ją išsaugotumėte ir šiame iPhone, ištrinkite šią piniginę ir importuokite frazę iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu frāze netika saglabāta, kad šis maks tika importēts. Jums tā joprojām ir — lai to glabātu arī šajā iPhone, izdzēsiet šo maku un importējiet frāzi vēlreiz."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വാലറ്റ് ഇറക്കുമതി ചെയ്തപ്പോൾ നിങ്ങളുടെ ഫ്രെയ്സ് സൂക്ഷിച്ചില്ല. അത് ഇപ്പോഴും നിങ്ങൾക്കുണ്ട് — അത് ഈ iPhone-ലും സംഭരിക്കാൻ, ഈ വാലറ്റ് ഇല്ലാതാക്കി ഫ്രെയ്സ് വീണ്ടും ഇറക്കുമതി ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे वॉलेट आयात केले तेव्हा तुमचा फ्रेज ठेवला गेला नाही. तो अजूनही तुमच्याकडे आहे — तो या iPhone वरही संग्रहित करण्यासाठी, हे वॉलेट हटवा आणि फ्रेज पुन्हा आयात करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa anda tidak disimpan semasa dompet ini diimport. Anda masih memilikinya — untuk menyimpannya pada iPhone ini juga, padam dompet ini dan import frasa semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasen din ble ikke beholdt da denne lommeboken ble importert. Du har den fremdeles — for å lagre den på denne iPhonen også, slett denne lommeboken og importer frasen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zin is niet bewaard toen deze wallet werd geïmporteerd. Je hebt hem nog — om hem ook op deze iPhone te bewaren, verwijder je deze wallet en importeer je de zin opnieuw."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਇਹ ਵਾਲਿਟ ਆਯਾਤ ਕੀਤਾ ਗਿਆ ਸੀ ਤਾਂ ਤੁਹਾਡਾ ਫ੍ਰੇਜ਼ ਨਹੀਂ ਰੱਖਿਆ ਗਿਆ ਸੀ। ਇਹ ਅਜੇ ਵੀ ਤੁਹਾਡੇ ਕੋਲ ਹੈ — ਇਸਨੂੰ ਇਸ iPhone 'ਤੇ ਵੀ ਸਟੋਰ ਕਰਨ ਲਈ, ਇਹ ਵਾਲਿਟ ਮਿਟਾਓ ਅਤੇ ਫ੍ਰੇਜ਼ ਦੁਬਾਰਾ ਆਯਾਤ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja fraza nie została zachowana podczas importu tego portfela. Nadal ją masz — aby przechowywać ją również na tym iPhonie, usuń ten portfel i zaimportuj frazę ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frase não foi mantida quando esta carteira foi importada. Você ainda a tem — para armazená-la também neste iPhone, exclua esta carteira e importe a frase novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraza ta nu a fost păstrată când acest portofel a fost importat. O ai în continuare — pentru a o stoca și pe acest iPhone, șterge acest portofel și importă fraza din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша фраза не была сохранена при импорте этого кошелька. Она по-прежнему у вас — чтобы хранить её и на этом iPhone, удалите этот кошелёк и импортируйте фразу снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša fráza sa neuchovala pri importe tejto peňaženky. Stále ju máte — ak ju chcete uložiť aj na tomto iPhone, odstráňte túto peňaženku a importujte frázu znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše geslo ni bilo ohranjeno ob uvozu te denarnice. Še vedno ga imate — da ga shranite tudi na ta iPhone, izbrišite to denarnico in znova uvozite geslo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša fraza nije sačuvana kada je ovaj novčanik uvezen. I dalje je imate — da biste je sačuvali i na ovom iPhone-u, izbrišite ovaj novčanik i ponovo uvezite frazu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fras sparades inte när denna plånbok importerades. Du har den fortfarande — för att lagra den på denna iPhone också, ta bort denna plånbok och importera frasen igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifungu chako hakikuwekwa wakati wallet hii ilipoletwa. Bado unacho — ili kukihifadhi kwenye iPhone hii pia, futa wallet hii na ulete kifungu tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வாலட் இறக்குமதி செய்யப்பட்டபோது உங்கள் சொற்றொடர் வைக்கப்படவில்லை. அது இன்னும் உங்களிடம் உள்ளது — அதை இந்த iPhone இலும் சேமிக்க, இந்த வாலட்டை நீக்கி சொற்றொடரை மீண்டும் இறக்குமதி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వాలెట్ దిగుమతి చేయబడినప్పుడు మీ పదబంధం ఉంచబడలేదు. అది ఇంకా మీ వద్ద ఉంది — దాన్ని ఈ iPhoneలో కూడా నిల్వ చేయడానికి, ఈ వాలెట్‌ను తొలగించి పదబంధాన్ని మళ్లీ దిగుమతి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วลีของคุณไม่ได้ถูกเก็บไว้เมื่อนำเข้ากระเป๋าเงินนี้ คุณยังมีมันอยู่ — หากต้องการจัดเก็บบน iPhone นี้ด้วย ให้ลบกระเป๋าเงินนี้แล้วนำเข้าวลีอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cüzdan içe aktarılırken ifadeniz saklanmadı. Hâlâ sizde — bu iPhone'da da saklamak için bu cüzdanı silin ve ifadeyi yeniden içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша фраза не зберіглася під час імпорту цього гаманця. Вона все ще у вас — щоб зберегти її й на цьому iPhone, видаліть цей гаманець і імпортуйте фразу знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس والیٹ کی درآمد کے وقت آپ کا فقرہ محفوظ نہیں رکھا گیا۔ یہ اب بھی آپ کے پاس ہے — اسے اس آئی فون پر بھی رکھنے کے لیے، اس والیٹ کو حذف کر کے فقرہ دوبارہ درآمد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cụm từ của bạn không được giữ lại khi ví này được nhập vào. Bạn vẫn còn nó — để lưu nó trên iPhone này nữa, hãy xóa ví này và nhập lại cụm từ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入此钱包时未保留你的助记词。你仍持有它——若想也将其存储在此 iPhone 上，请删除此钱包并重新导入助记词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入此錢包時未保留你的助記詞。你仍持有它——若想也將其儲存在此 iPhone 上，請刪除此錢包並重新匯入助記詞。"
          }
        }
      }
    },
