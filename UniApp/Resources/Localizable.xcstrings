    "Each word is one of 2,048 standard words. Aperture checks every word you type against that list.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke woord is een van 2 048 standaardwoorde. Aperture vergelyk elke woord wat jy tik met daardie lys."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل كلمة هي واحدة من 2,048 كلمة معيارية. يقارن Aperture كل كلمة تكتبها بتلك القائمة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяка дума е една от 2048-те стандартни думи. Aperture сверява всяка дума, която въведете, с този списък."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি শব্দ ২,০৪৮টি মানক শব্দের একটি। আপনি যা লেখেন, Aperture প্রতিটি শব্দ ওই তালিকার সঙ্গে মিলিয়ে দেখে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada paraula és una de les 2.048 paraules estàndard. L'Aperture comprova cada paraula que escrius amb aquesta llista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé slovo je jedním z 2 048 standardních slov. Aperture porovnává každé slovo, které napíšete, s tímto seznamem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert ord er ét af 2.048 standardord. Aperture tjekker hvert ord, du skriver, op imod denne liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Wort ist eines von 2.048 Standardwörtern. Aperture prüft jedes von dir eingegebene Wort gegen diese Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε λέξη είναι μία από τις 2.048 τυποποιημένες λέξεις. Το Aperture ελέγχει κάθε λέξη που πληκτρολογείτε σε σχέση με αυτή τη λίστα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palabra es una de las 2.048 palabras estándar. Aperture comprueba cada palabra que escribes con esa lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga sõna on üks 2048 standardsõnast. Aperture võrdleb iga teie sisestatud sõna selle nimekirjaga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کلمه یکی از ۲٬۰۴۸ کلمهٔ استاندارد است. Aperture هر کلمه‌ای را که تایپ می‌کنید با آن فهرست مقایسه می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen sana on yksi 2 048 vakiosanasta. Aperture tarkistaa jokaisen kirjoittamasi sanan tätä luetteloa vasten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang bawat salita ay isa sa 2,048 standard na salita. Tinitingnan ng Aperture ang bawat salitang itinatype mo kontra sa listahang iyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mot fait partie des 2 048 mots standard. Aperture vérifie chaque mot que vous saisissez par rapport à cette liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מילה היא אחת מ-2,048 מילים תקניות. Aperture בודק כל מילה שאתה מקליד מול הרשימה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर शब्द 2,048 मानक शब्दों में से एक है। Aperture आपके लिखे हर शब्द को उसी सूची से मिलाकर जाँचता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka je riječ jedna od 2 048 standardnih riječi. Aperture svaku riječ koju upišete uspoređuje s tim popisom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden szó a 2048 szabványos szó valamelyike. Az Aperture minden begépelt szót ehhez a listához hasonlít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kata adalah salah satu dari 2.048 kata standar. Aperture memeriksa setiap kata yang Anda ketik terhadap daftar tersebut."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert orð er eitt af 2.048 stöðluðum orðum. Aperture ber hvert orð sem þú slærð inn saman við þennan lista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni parola è una delle 2.048 parole standard. Aperture verifica ogni parola che digiti rispetto a quell’elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれの単語は、2,048個の標準単語のうちの1つです。Aperture は入力された単語すべてをそのリストと照合します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 단어는 2,048개의 표준 단어 중 하나입니다. Aperture는 입력한 모든 단어를 이 목록과 대조합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas žodis yra vienas iš 2048 standartinių žodžių. Aperture kiekvieną jūsų įvestą žodį palygina su šiuo sąrašu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrs vārds ir viens no 2048 standarta vārdiem. Aperture katru jūsu ievadīto vārdu salīdzina ar šo sarakstu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ വാക്കും 2,048 സ്റ്റാൻഡേർഡ് വാക്കുകളിൽ ഒന്നാണ്. നിങ്ങൾ ടൈപ്പ് ചെയ്യുന്ന ഓരോ വാക്കും Aperture ആ ലിസ്റ്റുമായി പരിശോധിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक शब्द 2,048 मानक शब्दांपैकी एक आहे. तुम्ही टाइप केलेला प्रत्येक शब्द Aperture त्या सूचीशी तपासते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap perkataan ialah salah satu daripada 2,048 perkataan standard. Aperture memeriksa setiap perkataan yang anda taip dengan senarai itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert ord er ett av 2048 standardord. Aperture sjekker hvert ord du skriver opp mot den listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk woord is een van de 2.048 standaardwoorden. Aperture vergelijkt elk woord dat je intikt met die lijst."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਸ਼ਬਦ 2,048 ਮਿਆਰੀ ਸ਼ਬਦਾਂ ਵਿੱਚੋਂ ਇੱਕ ਹੁੰਦਾ ਹੈ। ਜੋ ਵੀ ਸ਼ਬਦ ਤੁਸੀਂ ਟਾਈਪ ਕਰਦੇ ਹੋ, Aperture ਉਹ ਉਸੇ ਸੂਚੀ ਨਾਲ ਮਿਲਾ ਕੇ ਜਾਂਚਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde słowo to jedno z 2048 słów standardowych. Aperture porównuje każde wpisywane słowo z tą listą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palavra é uma das 2.048 palavras padrão. O Aperture confere cada palavra que você digita com essa lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare cuvânt este unul dintre cele 2.048 de cuvinte standard. Aperture verifică fiecare cuvânt pe care îl introduci cu această listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
