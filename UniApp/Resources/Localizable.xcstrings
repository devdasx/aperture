        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinar estes dados pode autorizar uma transferência de token ou um permit. Assine dados tipados somente de dApps em que você confia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Semnarea acestor date poate autoriza un transfer de token sau un permit. Semnează date tipizate doar de la dApps de încredere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись этих данных может разрешить перевод токена или permit. Подписывайте типизированные данные только от dApp, которым вы доверяете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpísanie týchto údajov môže schváliť prevod tokenu alebo permit. Typované údaje podpisujte len z dApp, ktorým dôverujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
