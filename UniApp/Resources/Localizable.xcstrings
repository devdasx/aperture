        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਤੁਸੀਂ ਇਹ ਗੁਆ ਦਿੱਤੀ, ਤਾਂ ਫੰਡ ਖ਼ਤਮ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ją zgubisz, środki przepadają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você perder, os fundos vão embora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă o pierzi, fondurile dispar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеряете её — потеряете средства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak ju stratíte, prostriedky sú preč."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če jo izgubite, so sredstva izgubljena."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако је изгубите, средства су нестала."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förlorar du den, är pengarna borta."
