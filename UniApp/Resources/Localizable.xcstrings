    "Couldn't delete this wallet from the local database. Try again.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon nie hierdie beursie uit die plaaslike databasis uitvee nie. Probeer weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف هذه المحفظة من قاعدة البيانات المحلية. حاول مرة أخرى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този портфейл не можа да бъде изтрит от локалната база данни. Опитайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ওয়ালেটটি স্থানীয় ডেটাবেস থেকে মুছে ফেলা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut esborrar aquesta cartera de la base de dades local. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto peněženku se nepodařilo odstranit z místní databáze. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne wallet kunne ikke slettes fra den lokale database. Prøv igen."
