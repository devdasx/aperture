    "Aperture is open source. Every claim above is verifiable in the code.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture is oopbron. Elke bewering hierbo kan in die kode geverifieer word."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture مفتوح المصدر. كل ما ورد أعلاه يمكن التحقق منه في الكود."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture е с отворен код. Всяко твърдение по-горе може да бъде проверено в кода."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ওপেন সোর্স। উপরের প্রতিটি দাবি কোডে যাচাই করা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture és de codi obert. Cada afirmació anterior es pot verificar al codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture je open source. Každé tvrzení výše lze ověřit v kódu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture er open source. Hver påstand ovenfor kan verificeres i koden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ist Open Source. Jede der obigen Aussagen lässt sich im Code überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Aperture είναι ανοιχτού κώδικα. Κάθε δήλωση παραπάνω μπορεί να επαληθευτεί στον κώδικα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture es de código abierto. Todas las afirmaciones anteriores se pueden verificar en el código."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture on avatud lähtekoodiga. Iga ülaltoodud väide on koodis kontrollitav."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture متن‌باز است. هر ادعای بالا در کد قابل بررسی است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
