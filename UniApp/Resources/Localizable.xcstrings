        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only assets the recipient's network can receive are shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran los activos que la red del destinatario puede recibir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvatakse ainult varad, mida saaja võrk vastu võtta saab."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنها دارایی‌هایی که شبکه‌ی گیرنده می‌تواند دریافت کند نمایش داده می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain ne omaisuuserät, jotka vastaanottajan verkko voi vastaanottaa, näytetään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga asset lang na matatanggap ng network ng tatanggap ang ipinapakita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les actifs que le réseau du destinataire peut recevoir sont affichés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצגים רק נכסים שרשת הנמען יכולה לקבל."
