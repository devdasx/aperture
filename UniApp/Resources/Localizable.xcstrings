            "value": "Naka-rate limit — subukan muli sa ilang sandali"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de débit atteinte — réessayez dans un instant"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגעת למגבלת הקצב — נסה שוב בעוד רגע"
