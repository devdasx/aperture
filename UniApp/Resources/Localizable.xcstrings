    "A 24-word phrase is the only key.": {
      "comment": "Slide 5 hero title.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "ʼn Frase van 24 woorde is die enigste sleutel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارة من 24 كلمة هي المفتاح الوحيد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фраза от 24 думи е единственият ключ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "২৪ শব্দের একটি বাক্যাংশই একমাত্র চাবি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase de 24 paraules és l'única clau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fráze o 24 slovech je jediný klíč."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En sætning på 24 ord er den eneste nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine 24-Wort-Phrase ist der einzige Schlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια φράση 24 λέξεων είναι το μοναδικό κλειδί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 24-word phrase is the only key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase de 24 palabras es la única llave."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "24‑sõnaline taastefraas on ainus võti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک عبارت ۲۴ کلمه‌ای تنها کلید است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 sanan lause on ainoa avain."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang 24-salitang phrase ang tanging susi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une phrase de 24 mots est la seule clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטוי בן 24 מילים הוא המפתח היחיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 शब्दों का वाक्यांश ही एकमात्र कुंजी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraza od 24 riječi jedini je ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy 24 szavas kifejezés az egyetlen kulcs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa 24 kata adalah satu-satunya kunci."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "24 orða setning er eini lykillinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase di 24 parole è l’unica chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24 語のフレーズが、唯一の鍵です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
