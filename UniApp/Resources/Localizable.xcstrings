          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa Pokea kuona anwani yako kwa kila mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு செயினுக்கான உங்கள் முகவரியைப் பார்க்க Receive-ஐத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
