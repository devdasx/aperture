    "Leave nonce on Auto unless you're replacing a stuck transaction. A wrong nonce can make the transaction fail.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave nonce on Auto unless you're replacing a stuck transaction. A wrong nonce can make the transaction fail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el nonce en Automático salvo que estés reemplazando una transacción atascada. Un nonce incorrecto puede hacer que la transacción falle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你要替换一笔卡住的交易，否则请将 nonce 保持为自动。错误的 nonce 会导致交易失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你要取代一筆卡住的交易，否則請將 nonce 保持為自動。錯誤的 nonce 會導致交易失敗。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "nonce को स्वतः पर ही रहने दें, जब तक कि आप किसी अटके हुए लेन-देन को बदल न रहे हों। गलत nonce लेन-देन को विफल कर सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك nonce على تلقائي ما لم تكن تستبدل معاملة عالقة. قد تُفشِل قيمة nonce خاطئة المعاملة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o nonce em Automático, a menos que esteja substituindo uma transação travada. Um nonce errado pode fazer a transação falhar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো আটকে থাকা লেনদেন প্রতিস্থাপন না করলে nonce স্বয়ংক্রিয় রাখুন। ভুল nonce লেনদেন ব্যর্থ করে দিতে পারে।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте nonce на «Авто», если только вы не заменяете застрявшую транзакцию. Неверный nonce может привести к сбою транзакции."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き詰まった取引を置き換える場合を除き、nonce は自動のままにしてください。誤った nonce は取引を失敗させることがあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie die Nonce auf Automatisch, außer Sie ersetzen eine feststeckende Transaktion. Eine falsche Nonce kann die Transaktion scheitern lassen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште nonce на «Авто», якщо ви не замінюєте застряглу транзакцію. Хибний nonce може спричинити збій транзакції."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε το nonce στο Αυτόματο, εκτός αν αντικαθιστάτε μια κολλημένη συναλλαγή. Ένα λανθασμένο nonce μπορεί να κάνει τη συναλλαγή να αποτύχει."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă nonce-ul pe Automat dacă nu înlocuiești o tranzacție blocată. Un nonce greșit poate face tranzacția să eșueze."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonce ponechte na Automaticky, pokud nenahrazujete uvíznutou transakci. Špatný nonce může způsobit selhání transakce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyja a nonce-ot Automatikuson, hacsak nem egy elakadt tranzakciót cserél le. A hibás nonce a tranzakció meghiúsulását okozhatja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna nonce på Auto om du inte ersätter en fastnad transaktion. En felaktig nonce kan få transaktionen att misslyckas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La nonce stå på Auto med mindre du erstatter en fastlåst transaksjon. En feil nonce kan få transaksjonen til å mislykkes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad nonce stå på Auto, medmindre du erstatter en fastlåst transaktion. En forkert nonce kan få transaktionen til at mislykkes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätä nonce Automaattiseksi, ellet korvaa jumiutunutta tapahtumaa. Väärä nonce voi saada tapahtuman epäonnistumaan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר את ה-nonce על אוטומטי אלא אם אתה מחליף עסקה תקועה. nonce שגוי עלול לגרום לעסקה להיכשל."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa el nonce en Automàtic tret que estiguis substituint una transacció encallada. Un nonce incorrecte pot fer que la transacció falli."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostavite nonce na Automatski osim ako zamjenjujete zaglavljenu transakciju. Pogrešan nonce može uzrokovati neuspjeh transakcije."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonce ponechajte na Automaticky, pokiaľ nenahrádzate zaseknutú transakciu. Nesprávny nonce môže spôsobiť zlyhanie transakcie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustite nonce na Samodejno, razen če nadomeščate zataknjeno transakcijo. Napačen nonce lahko povzroči, da transakcija ne uspe."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставите nonce на Аутоматски осим ако замењујете заглављену трансакцију. Погрешан nonce може да доведе до неуспеха трансакције."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez le nonce sur Auto sauf si vous remplacez une transaction bloquée. Un nonce incorrect peut faire échouer la transaction."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막힌 거래를 교체하는 경우가 아니라면 nonce는 자동으로 두세요. 잘못된 nonce는 거래를 실패하게 만들 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasci il nonce su Auto, a meno che non stia sostituendo una transazione bloccata. Un nonce errato può far fallire la transazione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takılmış bir işlemi değiştirmiyorsanız nonce'u Otomatik'te bırakın. Yanlış bir nonce işlemin başarısız olmasına yol açabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy để nonce ở chế độ Tự động trừ khi bạn đang thay thế một giao dịch bị kẹt. Một nonce sai có thể khiến giao dịch thất bại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อย nonce ไว้ที่อัตโนมัติ เว้นแต่คุณกำลังแทนที่ธุรกรรมที่ค้างอยู่ nonce ที่ผิดอาจทำให้ธุรกรรมล้มเหลวได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan nonce pada Otomatis kecuali Anda mengganti transaksi yang macet. Nonce yang salah dapat membuat transaksi gagal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "nonce را روی خودکار بگذارید مگر آنکه در حال جایگزینی یک تراکنش گیرکرده باشید. nonce نادرست می‌تواند تراکنش را ناموفق کند."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw nonce na Auto, chyba że zastępujesz zablokowaną transakcję. Błędny nonce może spowodować niepowodzenie transakcji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat nonce op Auto staan, tenzij je een vastgelopen transactie vervangt. Een verkeerde nonce kan de transactie laten mislukken."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "nonce کو خودکار پر رہنے دیں جب تک کہ آپ کوئی پھنسی ہوئی ٹرانزیکشن تبدیل نہ کر رہے ہوں۔ غلط nonce ٹرانزیکشن کو ناکام کر سکتا ہے۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставете nonce на Авто, освен ако не заменяте заседнала транзакция. Грешен nonce може да доведе до провал на транзакцията."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäta nonce Auto peale, kui sa just ei asenda kinni jäänud tehingut. Vale nonce võib panna tehingu ebaõnnestuma."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palikite nonce ties Auto, nebent keičiate įstrigusią operaciją. Neteisingas nonce gali sukelti operacijos nesėkmę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atstājiet nonce uz Auto, ja vien neaizstājat iestrēgušu darījumu. Nepareizs nonce var izraisīt darījuma neizdošanos."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafðu nonce á Sjálfvirkt nema þú sért að skipta út fastri færslu. Rangt nonce getur valdið því að færslan mistakist."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan nonce pada Auto melainkan anda menggantikan transaksi yang tersekat. Nonce yang salah boleh menyebabkan transaksi gagal."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwan ang nonce sa Auto maliban kung pinapalitan mo ang isang naipit na transaksyon. Ang maling nonce ay maaaring magpabigo sa transaksyon."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Acha nonce kwenye Otomatiki isipokuwa unabadilisha muamala uliokwama. Nonce isiyo sahihi inaweza kufanya muamala ushindwe."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nonce op Outo, tensy jy 'n vasgevalde transaksie vervang. 'n Verkeerde nonce kan die transaksie laat misluk."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிக்கிய பரிவர்த்தனையை மாற்றாவிட்டால் nonce-ஐ தானியங்கியில் விட்டுவிடவும். தவறான nonce பரிவர்த்தனையைத் தோல்வியடையச் செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆగిపోయిన లావాదేవీని భర్తీ చేస్తున్నప్పుడు తప్ప nonceను ఆటోలోనే ఉంచండి. తప్పు nonce లావాదేవీ విఫలమయ్యేలా చేయవచ్చు."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുടുങ്ങിയ ഇടപാട് മാറ്റിസ്ഥാപിക്കുന്നില്ലെങ്കിൽ nonce ഓട്ടോയിൽ വിടുക. തെറ്റായ nonce ഇടപാട് പരാജയപ്പെടാൻ ഇടയാക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अडकलेला व्यवहार बदलत नसाल तर nonce स्वयं वर ठेवा. चुकीचा nonce व्यवहार अयशस्वी करू शकतो."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦ ਤੱਕ ਤੁਸੀਂ ਅਟਕੇ ਹੋਏ ਲੈਣ-ਦੇਣ ਨੂੰ ਨਹੀਂ ਬਦਲ ਰਹੇ, nonce ਨੂੰ ਆਟੋ ਉੱਤੇ ਛੱਡੋ। ਗ਼ਲਤ nonce ਲੈਣ-ਦੇਣ ਨੂੰ ਅਸਫਲ ਕਰ ਸਕਦਾ ਹੈ।"
          }
        }
      }
    },
    "Lets you bump the fee later if it's stuck.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you bump the fee later if it's stuck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te permite subir la comisión más tarde si se queda atascada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便于日后在交易卡住时提高费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方便日後在交易卡住時提高費用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अटक जाने पर बाद में शुल्क बढ़ाने देता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك رفع الرسوم لاحقًا إذا علقت المعاملة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite aumentar a taxa depois, caso ela trave."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আটকে গেলে পরে ফি বাড়াতে দেয়।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет позже поднять комиссию, если транзакция застряла."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き詰まったときに後から手数料を引き上げられます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht es, die Gebühr später zu erhöhen, falls sie feststeckt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дає змогу пізніше підвищити комісію, якщо транзакція застрягла."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σας επιτρέπει να αυξήσετε αργότερα το τέλος αν κολλήσει."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți permite să crești comisionul mai târziu, dacă se blochează."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní vám později zvýšit poplatek, pokud transakce uvízne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi a díj későbbi megemelését, ha elakad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter dig höja avgiften senare om den fastnar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar deg øke gebyret senere hvis den setter seg fast."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader dig hæve gebyret senere, hvis den sidder fast."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa korottaa maksua myöhemmin, jos se jumiutuu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפשר לך להעלות את העמלה מאוחר יותר אם היא נתקעת."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et permet apujar la comissió més tard si s'encalla."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje vam da kasnije povisite naknadu ako se zaglavi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní vám neskôr zvýšiť poplatok, ak sa zasekne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogoča vam, da pozneje zvišate nadomestilo, če se zatakne."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Омогућава вам да касније повисите накнаду ако се заглави."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous permet d'augmenter les frais plus tard si elle est bloquée."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막혔을 때 나중에 수수료를 올릴 수 있게 해 줘요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le consente di aumentare la commissione in seguito, se resta bloccata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takılırsa ücreti daha sonra artırmanızı sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép bạn tăng phí sau nếu giao dịch bị kẹt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้คุณเพิ่มค่าธรรมเนียมภายหลังได้หากธุรกรรมค้าง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan Anda menaikkan biaya nanti jika macet."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به شما امکان می‌دهد اگر گیر کرد، بعداً کارمزد را افزایش دهید."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala później podnieść opłatę, jeśli transakcja się zablokuje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee kun je de kosten later verhogen als de transactie vastloopt."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر یہ پھنس جائے تو بعد میں فیس بڑھانے کی اجازت دیتا ہے۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволява Ви да увеличите таксата по-късно, ако заседне."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võimaldab tasu hiljem tõsta, kui tehing kinni jääb."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leidžia vėliau padidinti mokestį, jei operacija įstringa."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ļauj vēlāk paaugstināt maksu, ja darījums iestrēgst."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerir þér kleift að hækka gjaldið síðar ef hún festist."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membenarkan anda menaikkan yuran kemudian jika ia tersekat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinahayaan kang itaas ang fee mamaya kung ito ay maipit."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hukuwezesha kuongeza ada baadaye iwapo utakwama."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat jou die fooi later verhoog as dit vassit."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிக்கிக்கொண்டால் பிறகு கட்டணத்தை உயர்த்த உங்களை அனுமதிக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆగిపోతే తర్వాత ఫీజును పెంచడానికి మిమ్మల్ని అనుమతిస్తుంది."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുടുങ്ങിയാൽ പിന്നീട് ഫീസ് ഉയർത്താൻ നിങ്ങളെ അനുവദിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अडकल्यास नंतर फी वाढवण्याची मुभा देते."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਇਹ ਅਟਕ ਜਾਵੇ ਤਾਂ ਬਾਅਦ ਵਿੱਚ ਫ਼ੀਸ ਵਧਾਉਣ ਦਿੰਦਾ ਹੈ।"
          }
        }
      }
    },
