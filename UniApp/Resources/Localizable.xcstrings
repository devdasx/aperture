    "Aperture browses dApps; it doesn't audit them. Read every request before you sign.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture blaai deur dApps; dit oudit hulle nie. Lees elke versoek voordat jy teken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتصفّح Aperture التطبيقات اللامركزية ولا تدقّقها. اقرأ كل طلب قبل التوقيع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture разглежда dApps; не ги проверява. Прочетете всяка заявка, преди да подпишете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApp ব্রাউজ করে; অডিট করে না। সাইন করার আগে প্রতিটি অনুরোধ পড়ুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture navega per dApps; no les audita. Llegeix cada sol·licitud abans de signar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture prochází dApp, ale neaudituje je. Před podpisem si přečtěte každý požadavek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture browser dApps, men reviderer dem ikke. Læs hver anmodning, før du signerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture öffnet dApps, prüft sie aber nicht. Lies jede Anfrage, bevor du sie signierst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Aperture περιηγείται σε dApps, δεν τα ελέγχει. Διαβάστε κάθε αίτημα πριν υπογράψετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture browses dApps; it doesn't audit them. Read every request before you sign."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture navega por dApps; no las audita. Lee cada solicitud antes de firmar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture sirvib dAppe, kuid ei auditeeri neid. Loe iga päring enne allkirjastamist läbi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dAppها را مرور می‌کند؛ آنها را بازرسی نمی‌کند. هر درخواست را پیش از امضا بخوانید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture selaa dAppeja, mutta ei auditoi niitä. Lue jokainen pyyntö ennen allekirjoittamista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagba-browse ang Aperture ng mga dApp; hindi nito ito ina-audit. Basahin ang bawat kahilingan bago ka mag-sign."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture parcourt les dApps ; il ne les audite pas. Lisez chaque demande avant de signer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Aperture גולשת ב־dApps אך אינה מבקרת אותם. יש לקרוא כל בקשה לפני החתימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApps ब्राउज़ करता है, उनकी ऑडिट नहीं करता। साइन करने से पहले हर अनुरोध पढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture pregledava dApps; ne revidira ih. Pročitajte svaki zahtjev prije nego što potpišete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture böngészi a dApp-okat, de nem auditálja őket. Aláírás előtt olvass el minden kérést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture menjelajahi dApp; ia tidak mengauditnya. Baca setiap permintaan sebelum Anda menandatangani."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture vafrar um dApps; það endurskoðar þau ekki. Lestu hverja beiðni áður en þú undirritar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture esplora le dApp; non le verifica. Legga ogni richiesta prima di firmare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture は dApp を閲覧しますが、監査はしません。署名する前にすべてのリクエストを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture는 dApp을 둘러볼 뿐 감사하지는 않아요. 서명하기 전에 모든 요청을 읽어 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture naršo dApps, bet jų neaudituoja. Perskaitykite kiekvieną užklausą prieš pasirašydami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture pārlūko dApps, taču tās neaudita. Izlasiet katru pieprasījumu pirms parakstīšanas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApp-കൾ ബ്രൗസ് ചെയ്യുന്നു; അവയെ ഓഡിറ്റ് ചെയ്യുന്നില്ല. ഒപ്പിടുന്നതിന് മുമ്പ് ഓരോ അഭ്യർത്ഥനയും വായിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApps ब्राउझ करते; त्यांचे ऑडिट करत नाही. स्वाक्षरी करण्यापूर्वी प्रत्येक विनंती वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture melayari dApp; ia tidak mengaudit dApp tersebut. Baca setiap permintaan sebelum anda menandatangani."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture surfer på dApps, men reviderer dem ikke. Les hver forespørsel før du signerer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bekijkt dApps; het controleert ze niet. Lees elk verzoek voordat je ondertekent."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApps ਬ੍ਰਾਊਜ਼ ਕਰਦਾ ਹੈ; ਇਹ ਉਹਨਾਂ ਦਾ ਆਡਿਟ ਨਹੀਂ ਕਰਦਾ। ਦਸਤਖਤ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਹਰ ਬੇਨਤੀ ਪੜ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture przegląda dAppy; nie audytuje ich. Przeczytaj każde żądanie przed podpisaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Aperture navega em dApps; não os audita. Leia cada solicitação antes de assinar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture răsfoiește dApps; nu le auditează. Citește fiecare cerere înainte de a semna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture открывает dApp, но не проводит их аудит. Прочитайте каждый запрос перед подписанием."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture prehliada dApp, ale neaudituje ich. Pred podpisom si prečítajte každú žiadosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture brska po dApp, vendar jih ne revidira. Pred podpisom preberite vsako zahtevo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture прегледа dApp; не ревидира их. Прочитајте сваки захтев пре него што потпишете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture surfar på dApps men granskar dem inte. Läs varje begäran innan du signerar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture huvinjari dApps; haifanyi ukaguzi wa hizo. Soma kila ombi kabla ya kutia saini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApps-ஐ உலாவுகிறது; அவற்றைத் தணிக்கை செய்வதில்லை. கையொப்பமிடும் முன் ஒவ்வொரு கோரிக்கையையும் படியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApps‌ను బ్రౌజ్ చేస్తుంది; వాటిని ఆడిట్ చేయదు. సంతకం చేయడానికి ముందు ప్రతి అభ్యర్థనను చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture เรียกดู dApp แต่ไม่ได้ตรวจสอบ อ่านทุกคำขอก่อนลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApp’lere göz atar; onları denetlemez. İmzalamadan önce her isteği okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture відкриває dApp, але не перевіряє їх. Прочитайте кожен запит перед підписанням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture dApps براؤز کرتا ہے؛ ان کا آڈٹ نہیں کرتا۔ دستخط سے پہلے ہر درخواست کو پڑھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture duyệt các dApp; nó không kiểm tra chúng. Hãy đọc mọi yêu cầu trước khi bạn ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 浏览 dApp,但不会对其进行审计。签名前请仔细阅读每一个请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 瀏覽 dApp,但不會對其進行稽核。簽署前請仔細閱讀每一個請求。"
          }
        }
      }
    },
    "Aperture builds and signs this on your iPhone. Nothing is uploaded — the fee goes to the network, not to us.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bou en onderteken dit op jou iPhone. Niks word opgelaai nie — die fooi gaan na die netwerk, nie na ons nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشئ Aperture هذه المعاملة ويُوقّعها على جهاز iPhone الخاص بك. لا يُرفَع أي شيء — تذهب الرسوم إلى الشبكة، لا إلينا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture изгражда и подписва това на Вашия iPhone. Нищо не се качва — таксата отива в мрежата, не при нас."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture এটি আপনার iPhone-এ তৈরি ও স্বাক্ষর করে। কিছুই আপলোড হয় না — ফি নেটওয়ার্কে যায়, আমাদের কাছে নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture la crea i la signa al teu iPhone. No es puja res: la comissió va a la xarxa, no a nosaltres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ji sestaví a podepíše ve vašem iPhonu. Nic se neodesílá – poplatek jde síti, ne nám."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bygger og signerer dette på din iPhone. Intet uploades – gebyret går til netværket, ikke til os."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture erstellt und signiert dies auf Ihrem iPhone. Es wird nichts hochgeladen – die Gebühr geht ans Netzwerk, nicht an uns."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Aperture τη δημιουργεί και την υπογράφει στο iPhone σας. Δεν αποστέλλεται τίποτα — το τέλος πηγαίνει στο δίκτυο, όχι σε εμάς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture builds and signs this on your iPhone. Nothing is uploaded — the fee goes to the network, not to us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture la crea y la firma en tu iPhone. No se sube nada: la comisión va a la red, no a nosotros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture loob ja allkirjastab selle sinu iPhone'is. Midagi ei laadita üles — tasu läheb võrgule, mitte meile."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture این تراکنش را روی iPhone شما می‌سازد و امضا می‌کند. چیزی بارگذاری نمی‌شود — کارمزد به شبکه می‌رسد، نه به ما."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture rakentaa ja allekirjoittaa tämän iPhonessasi. Mitään ei ladata palvelimelle – maksu menee verkolle, ei meille."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuo at nilalagdaan ito ng Aperture sa iyong iPhone. Walang ina-upload — ang fee ay napupunta sa network, hindi sa amin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture construit et signe ceci sur votre iPhone. Rien n'est envoyé — les frais reviennent au réseau, pas à nous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Aperture בונה וחותם על זה ב-iPhone שלך. שום דבר אינו מועלה — העמלה מגיעה לרשת, לא אלינו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture इसे आपके iPhone पर बनाता और हस्ताक्षरित करता है। कुछ भी अपलोड नहीं होता — शुल्क नेटवर्क को जाता है, हमें नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture je izrađuje i potpisuje na vašem iPhoneu. Ništa se ne učitava na poslužitelj – naknada ide mreži, ne nama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture ezt az Ön iPhone-ján építi fel és írja alá. Semmi sem kerül feltöltésre – a díj a hálózathoz kerül, nem hozzánk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture membangun dan menandatangani transaksi ini di iPhone Anda. Tidak ada yang diunggah — biaya diberikan kepada jaringan, bukan kepada kami."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture byggir og undirritar þetta á iPhone-num þínum. Engu er hlaðið upp — gjaldið fer til netsins, ekki til okkar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture crea e firma questa transazione sul suo iPhone. Nulla viene caricato — la commissione va alla rete, non a noi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture はこれをお使いの iPhone 上で構築・署名します。何もアップロードされません。手数料はネットワークへ渡り、私たちには渡りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture는 이 거래를 iPhone에서 만들고 서명해요. 아무것도 업로드되지 않으며, 수수료는 저희가 아닌 네트워크로 가요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aperture“ sukuria ir pasirašo tai jūsų „iPhone“. Niekas neįkeliama – mokestis atitenka tinklui, o ne mums."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture izveido un paraksta to jūsu iPhone. Nekas netiek augšupielādēts — maksa nonāk tīklā, nevis pie mums."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ഇത് നിങ്ങളുടെ iPhone-ൽ നിർമ്മിക്കുകയും ഒപ്പിടുകയും ചെയ്യുന്നു. ഒന്നും അപ്‌ലോഡ് ചെയ്യപ്പെടുന്നില്ല — ഫീസ് നെറ്റ്‌വർക്കിലേക്ക് പോകുന്നു, ഞങ്ങൾക്ക് അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture हे तुमच्या iPhone वर तयार करते आणि स्वाक्षरी करते. काहीही अपलोड होत नाही — फी नेटवर्ककडे जाते, आमच्याकडे नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture membina dan menandatangani ini pada iPhone anda. Tiada apa-apa dimuat naik — yuran pergi kepada rangkaian, bukan kepada kami."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bygger og signerer dette på din iPhone. Ingenting lastes opp – gebyret går til nettverket, ikke til oss."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bouwt en ondertekent dit op je iPhone. Er wordt niets geüpload — de kosten gaan naar het netwerk, niet naar ons."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ਇਸਨੂੰ ਤੁਹਾਡੇ iPhone ਉੱਤੇ ਬਣਾਉਂਦਾ ਅਤੇ ਸਾਈਨ ਕਰਦਾ ਹੈ। ਕੁਝ ਵੀ ਅੱਪਲੋਡ ਨਹੀਂ ਹੁੰਦਾ — ਫ਼ੀਸ ਨੈੱਟਵਰਕ ਨੂੰ ਜਾਂਦੀ ਹੈ, ਸਾਨੂੰ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture tworzy i podpisuje tę transakcję na Twoim iPhonie. Nic nie jest wysyłane — opłata trafia do sieci, nie do nas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Aperture monta e assina isto no seu iPhone. Nada é enviado — a taxa vai para a rede, não para nós."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture o construiește și o semnează pe iPhone-ul tău. Nu se încarcă nimic — comisionul ajunge la rețea, nu la noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture формирует и подписывает её на вашем iPhone. Ничего не отправляется на серверы — комиссия идёт сети, а не нам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ju zostaví a podpíše vo vašom iPhone. Nič sa neodošle na server – poplatok ide sieti, nie nám."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture to zgradi in podpiše na vašem iPhonu. Nič se ne naloži v splet – nadomestilo gre omrežju, ne nam."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture је гради и потписује на вашем iPhone-у. Ништа се не отпрема — накнада иде мрежи, не нама."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bygger och signerar detta på din iPhone. Inget laddas upp – avgiften går till nätverket, inte till oss."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture inajenga na kutia saini hii kwenye iPhone yako. Hakuna kinachopakiwa — ada inakwenda kwa mtandao, si kwetu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture இதை உங்கள் iPhone-இல் உருவாக்கி கையொப்பமிடுகிறது. எதுவும் பதிவேற்றப்படுவதில்லை — கட்டணம் நெட்வொர்க்கிற்குச் செல்கிறது, எங்களுக்கு அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture దీన్ని మీ iPhoneలో రూపొందించి సంతకం చేస్తుంది. ఏదీ అప్‌లోడ్ చేయబడదు — ఫీజు నెట్‌వర్క్‌కు వెళుతుంది, మాకు కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture สร้างและลงนามธุรกรรมนี้บน iPhone ของคุณ ไม่มีการอัปโหลดสิ่งใด — ค่าธรรมเนียมไปยังเครือข่าย ไม่ใช่มาที่เรา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture bunu iPhone'unuzda oluşturur ve imzalar. Hiçbir şey yüklenmez — ücret bize değil, ağa gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture формує та підписує це на вашому iPhone. Нічого не надсилається — комісія йде мережі, а не нам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture اسے آپ کے iPhone پر بناتا اور سائن کرتا ہے۔ کچھ بھی اپ لوڈ نہیں ہوتا — فیس نیٹ ورک کو جاتی ہے، ہمیں نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture tạo và ký giao dịch này ngay trên iPhone của bạn. Không có gì được tải lên — phí thuộc về mạng, không phải chúng tôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 在你的 iPhone 上构建并签名此交易。不会上传任何内容——费用归网络所有，而非归我们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 在你的 iPhone 上建立並簽署此交易。不會上傳任何內容——費用歸網路所有，而非歸我們。"
          }
        }
      }
    },
