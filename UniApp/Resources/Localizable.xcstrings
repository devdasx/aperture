        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omrežnina je tisto, kar plačate verigi blokov – ne Apertureu – za obdelavo vaše transakcije. Gre tistim, ki upravljajo omrežje, nikoli nam."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Мрежна накнада је оно што плаћате блокчејну — не Aperture-у — за обраду ваше трансакције. Иде онима који одржавају мрежу, никада нама."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätverksavgiften är det du betalar till blockkedjan – inte till Aperture – för att behandla din transaktion. Den går till dem som driver nätverket, aldrig till oss."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada ya mtandao ndiyo unayolipa blockchain — si Aperture — ili kuchakata muamala wako. Inakwenda kwa watu wanaoendesha mtandao, kamwe si kwetu."
