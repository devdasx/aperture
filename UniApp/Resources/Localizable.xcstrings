        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilepi ključ svojega računa \\(chain.displayName). Aperture pred izpeljavo katerega koli naslova preveri obliko, ključ pa nikoli ne zapusti tega iPhona."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налепи кључ за свој \\(chain.displayName) налог. Aperture проверава формат пре него што изведе било коју адресу, а кључ никада не напушта овај iPhone."
          }
