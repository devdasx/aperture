        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture allekirjoittaa tämän iPhonessasi ja lähettää sen verkkoon. Lähetyksen jälkeen sitä ei voi perua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinipirmahan ito ng Aperture sa iyong iPhone at ibino-broadcast sa network. Kapag naipadala na, hindi na ito maibabalik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture signe ceci sur votre iPhone et le diffuse sur le réseau. Une fois envoyé, cela ne peut pas être annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎Aperture חותם על כך ב-iPhone שלך ומשדר אותו לרשת. לאחר השליחה, לא ניתן לבטלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture इसे आपके iPhone पर साइन करता है और नेटवर्क पर ब्रॉडकास्ट करता है। एक बार भेजे जाने के बाद, इसे उलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ovo potpisuje na vašem iPhoneu i emitira na mrežu. Nakon slanja ne može se poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture ezt az iPhone-odon írja alá, és sugározza a hálózatra. Elküldés után nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture menandatangani ini di iPhone Anda dan menyiarkannya ke jaringan. Setelah dikirim, tidak dapat dibatalkan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture undirritar þetta á iPhone-num þínum og sendir það á netið. Þegar það hefur verið sent er ekki hægt að afturkalla það."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture la firma sul tuo iPhone e la trasmette alla rete. Una volta inviata, non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture はこれを iPhone 上で署名し、ネットワークにブロードキャストします。送信後は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture는 이를 iPhone에서 서명하여 네트워크에 전파합니다. 전송된 후에는 되돌릴 수 없습니다."
