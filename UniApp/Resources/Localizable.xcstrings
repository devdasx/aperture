    "I understand if I lose my recovery phrase, I lose my crypto.": {
      "comment": "Create-wallet disclosure acknowledgement toggle label.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek verstaan — as ek my herstelfrase verloor, verloor ek my kripto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُدرك أنّني إذا فقدت عبارة الاسترداد، فقدتُ عملاتي المُشفَّرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбирам, че ако загубя фразата си за възстановяване, губя криптото си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি বুঝি, রিকভারি ফ্রেজ হারালে আমার ক্রিপ্টোও হারিয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entenc que si perdo la meva frase de recuperació, perdo el meu cripto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumím, že pokud ztratím obnovovací frázi, ztratím své kryptoměny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forstår, at hvis jeg mister min gendannelsessætning, mister jeg min krypto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist klar: Wenn ich meine Wiederherstellungsphrase verliere, verliere ich meine Krypto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταλαβαίνω ότι αν χάσω τη φράση ανάκτησης, χάνω τα κρυπτονομίσματά μου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand if I lose my recovery phrase, I lose my crypto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que si pierdo mi frase de recuperación, pierdo mis criptos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saan aru, et kui kaotan taastefraasi, kaotan oma krüpto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌دانم که اگر عبارت بازیابی‌ام را گم کنم، رمزارزهایم را از دست می‌دهم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymmärrän, että jos menetän palautuslauseeni, menetän kryptoni."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naiintindihan ko na kapag nawala ang aking recovery phrase, mawawala rin ang aking crypto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que si je perds ma phrase de récupération, je perds mes cryptos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מבין שאם אאבד את ביטוי השחזור, אאבד את הקריפטו שלי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझे समझ है: अगर मेरा रिकवरी फ़्रेज़ खो गया, तो मेरी क्रिप्टो भी खो जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razumijem: ako izgubim frazu za oporavak, gubim svoju kriptovalutu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megértem, hogy ha elveszítem a helyreállítási kifejezést, elveszítem a kriptómat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya memahami bahwa jika kehilangan frasa pemulihan, saya kehilangan kripto saya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ég skil að ef ég týni endurheimtarsetningunni minni, þá týni ég rafmyntinni minni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capisco che se perdo la mia frase di ripristino, perdo le mie cripto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを失えば、私の暗号資産も失われることを理解しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 문구를 잃어버리면 제 암호화폐도 잃는다는 사실을 이해합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprantu, kad praradęs atkūrimo frazę prarandu savo kriptovaliutą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Es saprotu — ja pazaudēšu savu atkopšanas frāzi, es zaudēšu savu kriptovalūtu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്റെ വീണ്ടെടുക്കൽ വാക്യം നഷ്ടപ്പെട്ടാൽ, എന്റെ ക്രിപ്റ്റോയും നഷ്ടപ്പെടുമെന്ന് എനിക്ക് മനസ്സിലാകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मला समजतंय — माझी रिकव्हरी फ्रेज हरवली, तर माझी क्रिप्टोही हरवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya faham, jika saya kehilangan frasa pemulihan saya, saya kehilangan kripto saya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forstår at hvis jeg mister gjenopprettingsfrasen, mister jeg kryptoen min."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat als ik mijn herstelzin verlies, ik mijn crypto verlies."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਂ ਸਮਝਦਾ ਹਾਂ — ਜੇ ਮੈਂ ਆਪਣੀ ਰਿਕਵਰੀ ਫਰੇਜ਼ ਗੁਆ ਦਿੱਤੀ, ਤਾਂ ਮੈਂ ਆਪਣੀ ਕ੍ਰਿਪਟੋ ਗੁਆ ਦੇਵਾਂਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem, że jeśli zgubię frazę odzyskiwania, tracę swoje kryptowaluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu entendo que se eu perder minha frase de recuperação, eu perco minhas criptos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înțeleg că dacă îmi pierd expresia de recuperare, îmi pierd cripto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я понимаю: если я потеряю фразу восстановления, я потеряю свою криптовалюту."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem, že ak stratím obnovovaciu frázu, stratím svoje kryptomeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razumem, da če izgubim obnovitveno frazo, izgubim svoje kriptovalute."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Разумем: ако изгубим фразу за опоравак, губим своју криптовалуту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag förstår att om jag förlorar min återställningsfras förlorar jag mina kryptotillgångar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Naelewa, nikipoteza kifungu changu cha urejesho, ninapoteza krypto yangu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என் மீட்பு சொற்றொடரை இழந்தால், என் கிரிப்டோவையும் இழக்கிறேன் என்பதை நான் புரிந்துகொள்கிறேன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను నా రికవరీ ఫ్రేజ్‌ను కోల్పోతే, నా క్రిప్టోను కూడా కోల్పోతానని నాకు అర్థమైంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเข้าใจว่าหากสูญเสียวลีกู้คืน ฉันจะสูญเสียคริปโตของฉัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma ifademi kaybedersem kriptolarımı kaybederim, anlıyorum."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я розумію: якщо я втрачу фразу відновлення, я втрачу свою криптовалюту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں سمجھتا ہوں کہ اگر میں نے اپنا ریکوری فریز کھو دیا، تو میں اپنی کرپٹو کھو دوں گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi hiểu rằng nếu mất cụm từ khôi phục, tôi sẽ mất tiền điện tử của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我明白：丢失助记词，就等于丢失我的加密资产。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我明白：遺失助記詞，就等於失去我的加密資產。"
          }
        }
      }
    },
