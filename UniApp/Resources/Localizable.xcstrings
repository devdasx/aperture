        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovitvena fraza je sestavljena iz dvanajstih ali štiriindvajsetih preprostih angleških besed. Skupaj tvorijo seme, iz katerega je bila ustvarjena vaša denarnica."
          }
