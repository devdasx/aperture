    "You haven't paid anything — we never broadcast a transaction that will fail.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy het niks betaal nie — ons saai nooit 'n transaksie uit wat sal misluk nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تدفع أي شيء — لا نبثّ أبدًا معاملة ستفشل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сте платили нищо — никога не излъчваме транзакция, която ще се провали."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কিছুই পরিশোধ করেননি — আমরা কখনো এমন লেনদেন সম্প্রচার করি না যা ব্যর্থ হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No has pagat res: mai no emetem una transacció que fallarà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jste nezaplatili — nikdy neodesíláme transakci, která selže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke betalt noget — vi udsender aldrig en transaktion, der vil mislykkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast nichts bezahlt – wir senden nie eine Transaktion, die fehlschlagen wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχετε πληρώσει τίποτα — δεν μεταδίδουμε ποτέ μια συναλλαγή που θα αποτύχει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't paid anything — we never broadcast a transaction that will fail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has pagado nada: nunca transmitimos una transacción que vaya a fallar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pole midagi maksnud — me ei edasta kunagi tehingut, mis ebaõnnestub."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما چیزی پرداخت نکرده‌اید — ما هرگز تراکنشی را که ناموفق خواهد بود ارسال نمی‌کنیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole maksanut mitään — emme koskaan lähetä tapahtumaa, joka epäonnistuu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala kang binayaran — hindi kami kailanman nagbo-broadcast ng transaksyong mabibigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez rien payé — nous ne diffusons jamais une transaction vouée à l'échec."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא שילמת דבר — לעולם איננו משדרים עסקה שתיכשל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने कुछ भुगतान नहीं किया — हम कभी ऐसा ट्रांज़ैक्शन ब्रॉडकास्ट नहीं करते जो विफल होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste platili ništa — nikad ne emitiramo transakciju koja će propasti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmit nem fizettél — sosem sugárzunk olyan tranzakciót, amely sikertelen lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum membayar apa pun — kami tidak pernah menyiarkan transaksi yang akan gagal."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hefur ekki greitt neitt — við sendum aldrei færslu sem mun mistakast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai pagato nulla — non trasmettiamo mai una transazione destinata a fallire."
          }
        },
        "ja": {
          "stringUnit": {
