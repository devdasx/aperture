    "Not a valid EVM address — must be 0x followed by 40 hex characters.": {
      "extractionState": "new",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie 'n geldige EVM-adres nie — moet 0x wees gevolg deur 40 heks-karakters."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس عنوان EVM صالحاً — يجب أن يبدأ بـ 0x متبوعاً بـ 40 رمزاً سداسياً عشرياً."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Невалиден EVM адрес — трябва да е 0x, последван от 40 шестнадесетични символа."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বৈধ EVM ঠিকানা নয় — 0x-এর পর 40 টি hex অক্ষর থাকতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No és una adreça EVM vàlida: ha de ser 0x seguit de 40 caràcters hexadecimals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neplatná adresa EVM — musí být 0x následované 40 šestnáctkovými znaky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke en gyldig EVM-adresse — skal være 0x efterfulgt af 40 heksadecimaltegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine gültige EVM-Adresse — muss 0x gefolgt von 40 Hexadezimalzeichen sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη έγκυρη διεύθυνση EVM — πρέπει να είναι 0x ακολουθούμενο από 40 δεκαεξαδικούς χαρακτήρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a valid EVM address — must be 0x followed by 40 hex characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una dirección EVM válida: debe ser 0x seguido de 40 caracteres hexadecimales."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehtetu EVM aadress — peab olema 0x, millele järgneb 40 kuueteistkümnendmärki."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی EVM معتبر نیست — باید 0x و سپس ۴۰ نویسهٔ هگزادسیمال باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kelvollinen EVM-osoite — alkukoodi 0x ja 40 heksadesimaalimerkkiä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi valid na EVM address — dapat 0x na sinusundan ng 40 hex character."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse EVM non valide — elle doit commencer par 0x suivi de 40 caractères hexadécimaux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתובת EVM לא תקינה — חייבת להתחיל ב־0x ולכלול 40 תווי hex."
          }
        },
