    "Confirm to view your recovery phrase.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig om jou hersteltfrase te sien."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد لعرض عبارة الاسترداد الخاصة بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Потвърдете, за да видите фразата за възстановяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পুনরুদ্ধার বাক্যাংশ দেখতে নিশ্চিত করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma per veure la frase de recuperació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrďte zobrazení obnovovací fráze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft for at se din gendannelsessætning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie, um Ihre Wiederherstellungsphrase anzuzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιβεβαιώστε για να δείτε τη φράση ανάκτησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm to view your recovery phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma para ver tu frase de recuperación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnitage taastefraasi vaatamiseks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن عبارت بازیابی خود تأیید کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista nähdäksesi palautuslauseesi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpirmahin upang tingnan ang iyong recovery phrase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez pour afficher votre phrase de récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר כדי להציג את ביטוי השחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पुनर्प्राप्ति वाक्यांश देखने के लिए पुष्टि करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdite za prikaz fraze za oporavak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erősítse meg a helyreállítási kifejezés megtekintését."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasi untuk melihat frasa pemulihan Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Staðfestu til að sjá endurheimtarsetninguna þína."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma per visualizzare la frase di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを表示するには確認してください。"
