          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En modtageradresse er en streng, der identificerer en af dine konti på en bestemt kæde. Ved at dele den lader du nogen sende midler til den konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Empfangsadresse ist eine Zeichenkette, die eines Ihrer Konten in einer bestimmten Chain identifiziert. Wenn Sie sie weitergeben, kann jemand Mittel an dieses Konto senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια διεύθυνση λήψης είναι μια συμβολοσειρά που προσδιορίζει έναν από τους λογαριασμούς σας σε μια συγκεκριμένη αλυσίδα. Η κοινοποίησή της επιτρέπει σε κάποιον να στείλει κεφάλαια σε αυτόν τον λογαριασμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A receive address is a string that identifies one of your accounts on one specific chain. Sharing it lets someone send funds to that account."
