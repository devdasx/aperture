          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستطيع أي شخص يحصل على هذه العبارة أن يأخذ أموالك. ولا يستطيع Aperture استردادها نيابةً عنك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
