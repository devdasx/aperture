          "stringUnit": {
            "state": "translated",
            "value": "Ta emot krypto till någon av dina adresser för att se det visas här."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokea sarafu ya crypto kwenye anwani yoyote yako ili kuiona ikionekana hapa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஏதேனும் ஒரு முகவரிக்கு கிரிப்டோவைப் பெறுங்கள், அது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఏదైనా చిరునామాకు క్రిప్టోను స్వీకరించండి, అది ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับคริปโตเข้ามายังที่อยู่ใดก็ตามของคุณเพื่อให้ปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adreslerinizden herhangi birine kripto alın; burada görünecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримайте криптовалюту на будь-яку зі своїх адрес, щоб побачити її тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏اپنے کسی بھی پتے پر کرپٹو وصول کریں تاکہ یہاں نظر آئے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận tiền điện tử vào bất kỳ địa chỉ nào của bạn để thấy chúng xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向你的任意地址接收加密货币,它们会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向你的任意地址接收加密貨幣,它們會顯示在這裡。"
          }
        }
      }
    },
