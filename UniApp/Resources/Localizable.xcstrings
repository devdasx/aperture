          }
        }
      }
    },
    "These words are your wallet. Write them in order, exactly as shown.": {
      "comment": "Recovery-phrase view hero copy (word-count-agnostic — replaces 'These 12 words …').",
      "extractionState": "manual",
      "localizations": {
        "af": {
