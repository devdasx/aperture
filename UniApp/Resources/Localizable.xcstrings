          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לפענח את הביטוי של הארנק הזה. נסה להפעיל מחדש את Aperture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम इस वॉलेट का फ़्रेज़ डिक्रिप्ट नहीं कर सके। Aperture को पुनः आरंभ करके देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo uspjeli dešifrirati frazu ovog novčanika. Pokušajte ponovno pokrenuti Aperture."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült visszafejteni a tárca kifejezését. Próbálja meg újraindítani az Aperture-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mendekripsi frasa dompet ini. Coba mulai ulang Aperture."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að afkóða setningu þessa veskis. Reyndu að endurræsa Aperture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile decifrare la frase di questo portafoglio. Provi a riavviare Aperture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウォレットのフレーズを復号できませんでした。Aperture を再起動してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지갑의 문구를 복호화할 수 없었어요. Aperture를 다시 시작해 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko iššifruoti šios piniginės frazės. Pabandykite paleisti Aperture iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevarējām atšifrēt šī maciņa frāzi. Mēģiniet restartēt Aperture."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വാലറ്റിന്റെ വാക്യം ഡീക്രിപ്റ്റ് ചെയ്യാനായില്ല. Aperture പുനരാരംഭിക്കാൻ ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या वॉलेटचा फ्रेज डिक्रिप्ट करता आला नाही. Aperture पुन्हा सुरू करून पाहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat menyahsulit frasa dompet ini. Cuba mulakan semula Aperture."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke dekryptere frasen til denne lommeboken. Prøv å starte Aperture på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden de zin van deze portemonnee niet ontsleutelen. Probeer Aperture opnieuw te starten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵਾਲਿਟ ਦਾ ਫ਼ਰੇਜ਼ ਡੀਕ੍ਰਿਪਟ ਨਹੀਂ ਹੋ ਸਕਿਆ। Aperture ਨੂੰ ਮੁੜ ਚਾਲੂ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odszyfrować frazy tego portfela. Spróbuj uruchomić Aperture ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos descriptografar a frase desta carteira. Tente reiniciar a Aperture."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut decripta fraza acestui portofel. Încearcă să repornești Aperture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось расшифровать фразу этого кошелька. Попробуйте перезапустить Aperture."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Frázu tejto peňaženky sa nepodarilo dešifrovať. Skúste Aperture reštartovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraze te denarnice nismo mogli dešifrirati. Poskusite znova zagnati Aperture."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нисмо могли да дешифрујемо фразу овог новчаника. Покушајте поново да покренете Aperture."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte dekryptera den här plånbokens fras. Försök att starta om Aperture."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatukuweza kufichua maneno ya pochi hii. Jaribu kuanzisha upya Aperture."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வாலெட்டின் சொற்றொடரை மறைதிறக்க முடியவில்லை. Aperture-ஐ மீண்டும் தொடங்க முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వాలెట్ పదబంధాన్ని డీక్రిప్ట్ చేయలేకపోయాం. Aperture‌ను రీస్టార్ట్ చేయడానికి ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถถอดรหัสวลีของกระเป๋านี้ได้ ลองรีสตาร์ท Aperture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cüzdanın ifadesi şifrelenemedi. Aperture'ı yeniden başlatmayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розшифрувати фразу цього гаманця. Спробуйте перезапустити Aperture."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس والیٹ کے فقرے کو ڈیکرپٹ نہیں کیا جا سکا۔ Aperture کو دوبارہ شروع کرنے کی کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể giải mã cụm từ của ví này. Hãy thử khởi động lại Aperture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解密此钱包的短语。请尝试重启 Aperture。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解密此錢包的片語。請嘗試重新啟動 Aperture。"
          }
        }
      }
    },
