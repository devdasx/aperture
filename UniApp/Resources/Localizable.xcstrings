    "The transaction reverted on-chain. Nothing was sent — your funds did not move.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die transaksie is op die ketting teruggerol. Niks is gestuur nie — jou fondse het nie beweeg nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التراجع عن المعاملة على السلسلة. لم يُرسَل أي شيء — لم تتحرك أموالك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцията беше отменена в блокчейна. Нищо не беше изпратено — средствата ви не са се преместили."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেনটি অন-চেইন প্রত্যাহার হয়েছে। কিছুই পাঠানো হয়নি — আপনার তহবিল সরেনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacció s’ha revertit a la cadena. No s’ha enviat res — els teus fons no s’han mogut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce byla na blockchainu vrácena zpět. Nic nebylo odesláno — vaše prostředky se nepohnuly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen blev tilbageført on-chain. Intet blev sendt — dine midler blev ikke flyttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion wurde On-Chain rückgängig gemacht. Es wurde nichts gesendet — Ihr Guthaben wurde nicht bewegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συναλλαγή αναιρέθηκε on-chain. Δεν στάλθηκε τίποτα — τα κεφάλαιά σας δεν μετακινήθηκαν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction reverted on-chain. Nothing was sent — your funds did not move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción se revirtió en la cadena. No se envió nada — tus fondos no se movieron."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehing tühistati ahelas. Midagi ei saadetud — sinu raha ei liikunud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش روی زنجیره برگشت خورد. چیزی ارسال نشد — وجوه شما جابه‌جا نشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtuma peruuntui lohkoketjussa. Mitään ei lähetetty — varasi eivät liikkuneet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binawi ang transaksyon on-chain. Walang naipadala — hindi gumalaw ang iyong pondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction a été annulée sur la chaîne. Rien n’a été envoyé — vos fonds n’ont pas bougé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה בוטלה על גבי הרשת. שום דבר לא נשלח — הכספים שלך לא זזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन ऑन-चेन वापस लौट गया। कुछ भी नहीं भेजा गया — आपके फंड स्थानांतरित नहीं हुए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcija je poništena na lancu. Ništa nije poslano — vaša sredstva nisu pomaknuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tranzakció visszafordult a láncon. Semmi sem lett elküldve — az egyenlege nem mozdult."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi dibatalkan on-chain. Tidak ada yang terkirim — dana Anda tidak berpindah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Færslan var afturkölluð á keðjunni. Ekkert var sent — fjármunir þínir hreyfðust ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione è stata annullata on-chain. Non è stato inviato nulla — i tuoi fondi non si sono mossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションはオンチェーンで取り消されました。何も送信されていません — 資金は移動していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 온체인에서 되돌려졌어요. 아무것도 전송되지 않았어요 — 자금은 이동하지 않았어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacija buvo atšaukta grandinėje. Niekas nebuvo išsiųsta — jūsų lėšos nepajudėjo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījums tika atcelts ķēdē. Nekas netika nosūtīts — jūsu līdzekļi nekustējās."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇടപാട് ചെയിനിൽ പിൻവലിക്കപ്പെട്ടു. ഒന്നും അയച്ചിട്ടില്ല — നിങ്ങളുടെ ഫണ്ട് നീങ്ങിയിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवहार चेनवर परत झाला. काहीही पाठवले गेले नाही — तुमचा निधी हलला नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi telah dibatalkan di atas rantai. Tiada apa yang dihantar — dana anda tidak berpindah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksjonen ble reversert on-chain. Ingenting ble sendt — midlene dine ble ikke flyttet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie is on-chain teruggedraaid. Er is niets verzonden — je tegoed is niet verplaatst."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੈਣ-ਦੇਣ ਚੇਨ ਉੱਤੇ ਵਾਪਸ ਹੋ ਗਿਆ। ਕੁਝ ਨਹੀਂ ਭੇਜਿਆ ਗਿਆ — ਤੁਹਾਡੇ ਫੰਡ ਨਹੀਂ ਹਿੱਲੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja została wycofana w łańcuchu. Nic nie wysłano — środki nie zostały przeniesione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação foi revertida on-chain. Nada foi enviado — seus fundos não se moveram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
