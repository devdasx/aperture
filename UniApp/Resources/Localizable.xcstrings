        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വീകർത്താവിന്റെ നെറ്റ്‌വർക്കിന് സ്വീകരിക്കാൻ കഴിയുന്ന ആസ്തികൾ മാത്രമേ കാണിക്കൂ."
