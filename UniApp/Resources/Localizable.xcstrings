    "Write it down. Keep it offline. Lose it and the funds are gone — there is no recovery.": {
      "comment": "Slide 5 body. Honesty: explicitly says funds are unrecoverable on loss.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryf dit neer. Hou dit aflyn. Verloor dit en die fondse is weg — daar is geen herwinning nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوِّنها. واحتفظ بها دون اتصال. إذا فقدتها، تذهب الأموال — ولا استرداد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишете я. Дръжте я офлайн. Ако я загубите, средствата изчезват — няма възстановяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিখে রাখুন। অফলাইনে রাখুন। হারালে টাকাও চলে যায় — কোনো রিকভারি নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota-la. Manté-la fora de línia. Si la perds, els fons s’han perdut — no hi ha recuperació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište si ji. Držte ji offline. Když ji ztratíte, prostředky jsou pryč — neexistuje obnova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv den ned. Hold den offline. Mister du den, er midlerne væk — der er ingen gendannelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie sie auf. Halten Sie sie offline. Verlieren Sie sie, ist das Guthaben weg — es gibt keine Wiederherstellung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψτε τη. Κρατήστε τη εκτός σύνδεσης. Αν τη χάσετε, τα κεφάλαια χάνονται — δεν υπάρχει ανάκτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write it down. Keep it offline. Lose it and the funds are gone — there is no recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anótala. Mantenla sin conexión. Si la pierdes, los fondos se pierden: no hay recuperación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pane see kirja. Hoia võrgust eemal. Kaotad selle ja raha on läinud — taastamist pole."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن را یادداشت کنید. به‌صورت آفلاین نگه دارید. اگر گم شود، دارایی‌ها از دست می‌روند — هیچ راه بازیابی وجود ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita se ylös. Pidä se verkon ulkopuolella. Jos menetät sen, varat ovat poissa — palautusta ei ole."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isulat ito. Itago nang offline. Kapag nawala, wala na rin ang pondo — walang recovery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez-la. Conservez-la hors ligne. La perdre, c’est perdre les fonds — il n’y a aucune récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשום אותו. שמור אותו לא מקוון. אם תאבד אותו, הכספים נעלמים — אין שחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे लिख लें। ऑफ़लाइन रखें। खो दिया, तो धन भी गया — कोई रिकवरी नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapišite je. Držite je izvan mreže. Ako je izgubite, sredstva su nestala — oporavka nema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írja le. Tartsa offline. Ha elveszíti, a pénzeszközök elvesznek — nincs helyreállítás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis. Simpan secara luring. Bila hilang, dana ikut hilang — tidak ada pemulihan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifaðu hana niður. Geymdu hana ótengda. Týnir þú henni, þá eru fjármunirnir farnir — engin endurheimt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scriva. La conservi offline. Se la perde, i fondi sono persi — non c’è alcun recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き留め、オフラインで保管してください。失えば資金も失われ——取り戻す術はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어 두세요. 오프라인으로 보관하세요. 잃어버리면 자금도 함께 사라집니다 — 복구 수단은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užsirašykite ją. Laikykite neprijungtą prie tinklo. Praradę — prarasite ir lėšas; atkūrimo nėra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstiet to. Glabājiet bezsaistē. Pazaudēsiet — līdzekļi būs prom; atkopšanas nav."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എഴുതിവയ്ക്കുക. ഓഫ്‌ലൈനായി സൂക്ഷിക്കുക. നഷ്ടപ്പെട്ടാൽ പണം പോയി — വീണ്ടെടുപ്പ് ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ती लिहून ठेवा. ऑफलाइन ठेवा. हरवली, तर पैसे गेलेच — रिकव्हरी नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuliskan ia. Simpan di luar talian. Kehilangannya bermakna dana hilang — tiada pemulihan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv den ned. Hold den frakoblet. Mister du den, er midlene borte — det finnes ingen gjenoppretting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf hem op. Bewaar hem offline. Verlies hem en het geld is weg — er is geen herstel."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸਨੂੰ ਲਿਖ ਲਓ। ਔਫਲਾਈਨ ਰੱਖੋ। ਗੁਆਚੀ — ਫੰਡ ਖ਼ਤਮ — ਕੋਈ ਰਿਕਵਰੀ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ją. Trzymaj offline. Jej utrata oznacza utratę środków — nie ma odzyskania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote. Mantenha offline. Perdeu, os fundos vão embora — não existe recuperação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie-o. Ține-o offline. Dacă o pierzi, fondurile dispar — nu există recuperare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите её. Храните офлайн. Потеряете — потеряете и средства; восстановления не будет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíšte si ju. Držte ju offline. Ak ju stratíte, prostriedky sú preč — žiadna obnova neexistuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapišite jo. Naj ostane brez povezave. Če jo izgubite, so sredstva izgubljena — obnove ni."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите је. Држите је ван мреже. Ако је изгубите, средства су нестала — опоравка нема."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv ner den. Håll den offline. Förlorar du den är pengarna borta — det finns ingen återställning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Iandike. Iweke nje ya mtandao. Ukikipoteza, fedha zimepotea — hakuna urejesho."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுதிக்கொள். ஆஃப்லைனாக வைத்திரு. இழந்தால் நிதி போய்விடும் — மீட்பு இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రాసుకోండి. ఆఫ్‌లైన్‌లోనే ఉంచండి. కోల్పోతే నిధులు పోతాయి — రికవరీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดไว้ เก็บไว้แบบออฟไลน์ หากสูญหาย เงินก็จะหายไปด้วย ไม่มีวิธีกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıp saklayın. Çevrimdışı tutun. Kaybederseniz fonlar da gider — geri alma yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть її. Тримайте її офлайн. Втратите — кошти зникнуть, відновлення немає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اِسے لکھ لیں۔ آف‌لائن رکھیں۔ کھو دیا تو فنڈز چلے جائیں گے — کوئی بازیافت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy ghi lại. Giữ ngoại tuyến. Mất nó là mất tiền — không có cách khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下来。保持离线。一旦丢失，资金即逝——没有找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫下來。保持離線。一旦遺失，資金即逝——沒有找回。"
          }
        }
      }
    },
    "Write it on paper. Keep the paper offline.": {
      "comment": "First better-method row in the screenshot-warning sheet — write the phrase on paper offline.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryf dit op papier. Hou die papier aflyn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتبها على ورقة. واحتفظ بالورقة دون اتصال."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишете я на хартия. Дръжте хартията офлайн."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কাগজে লিখুন। কাগজটি অফলাইনে রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota-la en paper. Manté el paper fora de línia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište ji na papír. Papír držte offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv den på papir. Hold papiret offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie sie auf Papier. Bewahren Sie das Papier offline auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψτε τη σε χαρτί. Κρατήστε το χαρτί εκτός σύνδεσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write it on paper. Keep the paper offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbela en papel. Mantén el papel sin conexión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjuta see paberile. Hoia paberit võrgust eemal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن را روی کاغذ بنویسید. کاغذ را آفلاین نگه دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita se paperille. Pidä paperi verkon ulkopuolella."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isulat ito sa papel. Itago ang papel nang offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez-la sur papier. Gardez le papier hors ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשום אותו על נייר. שמור את הנייר לא מקוון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे काग़ज़ पर लिखें। काग़ज़ को ऑफ़लाइन रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapišite je na papir. Papir držite izvan mreže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írja papírra. A papírt tartsa offline."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis di kertas. Simpan kertas itu secara luring."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifaðu hana á pappír. Geymdu pappírinn ótengdan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scriva su carta. Tenga la carta offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙に書きとめてください。その紙はオフラインで保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이에 적으세요. 그 종이는 오프라인에 보관하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užrašykite ją ant popieriaus. Popierių laikykite neprijungtą prie tinklo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstiet to uz papīra. Glabājiet papīru bezsaistē."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കടലാസിൽ എഴുതുക. കടലാസ് ഓഫ്‌ലൈനായി സൂക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ती कागदावर लिहा. कागद ऑफलाइन ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuliskan di atas kertas. Simpan kertas itu di luar talian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv den på papir. Hold papiret frakoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf hem op papier. Bewaar het papier offline."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸਨੂੰ ਕਾਗਜ਼ ਉੱਤੇ ਲਿਖੋ। ਕਾਗਜ਼ ਨੂੰ ਔਫਲਾਈਨ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ją na papierze. Trzymaj papier offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva em papel. Mantenha o papel offline."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie-o pe hârtie. Ține hârtia offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите её на бумаге. Храните бумагу офлайн."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíšte si ju na papier. Papier držte offline."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapišite jo na papir. Papir naj ostane brez povezave."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите је на папир. Папир држите ван мреже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv den på papper. Håll pappret offline."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Iandike kwenye karatasi. Iweke karatasi hiyo nje ya mtandao."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காகிதத்தில் எழுது. காகிதத்தை ஆஃப்லைனாக வை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాగితంపై రాయండి. కాగితాన్ని ఆఫ్‌లైన్‌లోనే ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนลงบนกระดาษ และเก็บกระดาษไว้แบบออฟไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kâğıda yazın. Kâğıdı çevrimdışı saklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть її на папері. Тримайте папір офлайн."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اِسے کاغذ پر لکھیں۔ کاغذ کو آف‌لائن رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết ra giấy. Giữ tờ giấy ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把它写在纸上。让纸张保持离线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把它寫在紙上。讓紙張保持離線。"
          }
        }
      }
    },
