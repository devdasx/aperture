    "EVM private key (32-byte hex).": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "EVM privaatsleutel (32-grepe hex)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح الخاص لـ EVM (32 بايت hex)."
          }
        },
        "bg": {
