    "Stellar keeps a minimum balance (from 1 XLM) reserved to keep your account active.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar hou 'n minimum balans (vanaf 1 XLM) gereserveer om jou rekening aktief te hou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ Stellar برصيد أدنى (من 1 XLM) محجوزًا للحفاظ على حسابك نشطًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar държи резервиран минимален баланс (от 1 XLM), за да поддържа акаунта ви активен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar আপনার অ্যাকাউন্ট সক্রিয় রাখতে একটি ন্যূনতম ব্যালেন্স (১ XLM থেকে) সংরক্ষিত রাখে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar manté un saldo mínim (a partir d'1 XLM) reservat per mantenir el teu compte actiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar drží rezervovaný minimální zůstatek (od 1 XLM), aby váš účet zůstal aktivní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar holder en minimumssaldo (fra 1 XLM) reserveret for at holde din konto aktiv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar reserviert ein Mindestguthaben (ab 1 XLM), um dein Konto aktiv zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Stellar διατηρεί ένα ελάχιστο υπόλοιπο (από 1 XLM) δεσμευμένο ώστε ο λογαριασμός σας να παραμένει ενεργός."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar mantiene un saldo mínimo (desde 1 XLM) reservado para mantener tu cuenta activa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar hoiab reserveeritud miinimumsaldo (alates 1 XLM), et teie konto püsiks aktiivsena."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar یک موجودی حداقلی (از ۱ XLM) را ذخیره نگه می‌دارد تا حساب شما فعال بماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar pitää vähimmäissaldon (alkaen 1 XLM) varattuna pitääkseen tilisi aktiivisena."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapanatili ng Stellar ang isang minimum na balance (mula sa 1 XLM) na nakareserba upang manatiling aktibo ang iyong account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar conserve un solde minimum (à partir de 1 XLM) réservé pour garder votre compte actif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎Stellar שומר יתרת מינימום (החל מ-‏1 XLM) שמורה כדי לשמור על החשבון שלך פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar आपके अकाउंट को सक्रिय रखने के लिए एक न्यूनतम बैलेंस (1 XLM से) आरक्षित रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar zadržava rezervirano minimalno stanje (od 1 XLM) kako bi vaš račun ostao aktivan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Stellar minimális egyenleget (1 XLM-től) tart fenn, hogy a fiókod aktív maradjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar menyimpan saldo minimum (mulai dari 1 XLM) yang dicadangkan untuk menjaga akun Anda tetap aktif."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar heldur lágmarksstöðu (frá 1 XLM) frátekinni til að halda reikningnum þínum virkum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar mantiene un saldo minimo (a partire da 1 XLM) riservato per mantenere attivo il tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar はアカウントを有効に保つため、最低残高（1 XLM から）を予約として保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar은 계정을 활성 상태로 유지하기 위해 최소 잔액(1 XLM부터)을 예약해 둡니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar rezervuoja minimalų balansą (nuo 1 XLM), kad jūsų paskyra liktų aktyvi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar patur rezervētu minimālo bilanci (no 1 XLM), lai jūsu konts paliktu aktīvs."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് സജീവമായി നിലനിർത്താൻ Stellar ഒരു മിനിമം ബാലൻസ് (1 XLM മുതൽ) റിസർവ് ചെയ്തുവയ്ക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे खाते सक्रिय ठेवण्यासाठी Stellar किमान शिल्लक (1 XLM पासून) राखीव ठेवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar mengekalkan baki minimum (dari 1 XLM) disimpan untuk mengekalkan akaun anda aktif."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar holder en minimumssaldo (fra 1 XLM) reservert for å holde kontoen din aktiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar reserveert een minimumsaldo (vanaf 1 XLM) om je account actief te houden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar ਤੁਹਾਡੇ ਖਾਤੇ ਨੂੰ ਸਰਗਰਮ ਰੱਖਣ ਲਈ ਘੱਟੋ-ਘੱਟ ਬਕਾਇਆ (1 XLM ਤੋਂ) ਰਾਖਵੀਂ ਰੱਖਦਾ ਹੈ।"
          }
        },
        "pl": {
