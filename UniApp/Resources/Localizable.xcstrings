          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начало и конец совпадают с сохранённым адресом \\(match.savedName), но середина другая. Так мошенники обманом заставляют отправить не туда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začína a končí ako uložená adresa kontaktu \\(match.savedName), ale stred je iný. Takto vás podvodníci oklamú, aby ste poslali na nesprávne miesto."
          }
