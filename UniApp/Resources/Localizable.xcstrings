        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins SVG · einfalt og ein form gefur besta niðurstöðu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo SVG · forma semplice e singola per i risultati migliori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SVGのみ · シンプルな単一シェイプが最適です。"
