        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkalykill er leyninúmerið sem stýrir einum reikningi á einni keðju. Hann lítur yfirleitt út eins og löng röð af bókstöfum og tölustöfum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
