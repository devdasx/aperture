    "Attach a small data note to the transaction. This is optional and isn't needed to send — exchanges never require it.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Heg 'n klein data-nota aan die transaksie. Dit is opsioneel en is nie nodig om te stuur nie — beurse vereis dit nooit nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرفق ملاحظة بيانات صغيرة بالمعاملة. هذا اختياري وغير مطلوب للإرسال — لا تتطلبه منصات التداول أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикачете малка бележка с данни към транзакцията. Това е незадължително и не е нужно за изпращане — борсите никога не го изискват."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেনের সাথে একটি ছোট ডেটা নোট সংযুক্ত করুন। এটি ঐচ্ছিক এবং পাঠানোর জন্য প্রয়োজন নেই — এক্সচেঞ্জ কখনো এটি চায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta una petita nota de dades a la transacció. És opcional i no cal per enviar: els exchanges no la requereixen mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte k transakci malou datovou poznámku. Je volitelná a k odeslání není potřeba — burzy ji nikdy nevyžadují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedhæft en lille datanote til transaktionen. Dette er valgfrit og er ikke nødvendigt for at sende — børser kræver det aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hänge eine kleine Datennotiz an die Transaktion. Das ist optional und zum Senden nicht nötig – Börsen verlangen es nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επισυνάψτε μια μικρή σημείωση δεδομένων στη συναλλαγή. Αυτό είναι προαιρετικό και δεν απαιτείται για την αποστολή — τα ανταλλακτήρια δεν το ζητούν ποτέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta una pequeña nota de datos a la transacción. Es opcional y no hace falta para enviar; los exchanges nunca la requieren."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisage tehingule väike andmemärkus. See on valikuline ega ole saatmiseks vajalik — börsid ei nõua seda kunagi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک یادداشت داده‌ی کوچک به تراکنش پیوست کنید. این اختیاری است و برای ارسال لازم نیست — صرافی‌ها هرگز به آن نیاز ندارند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä pieni datamerkintä tapahtumaan. Tämä on valinnainen eikä sitä tarvita lähettämiseen — pörssit eivät koskaan vaadi sitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglakip ng maliit na data note sa transaksyon. Opsyonal ito at hindi kailangan para magpadala — hindi ito kailanman hinihingi ng mga exchange."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez une petite note de données à la transaction. C'est facultatif et inutile pour l'envoi — les plateformes d'échange ne l'exigent jamais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צרף הערת נתונים קטנה לעסקה. זו אופציונלית ואינה נדרשת לשליחה — בורסות לעולם אינן דורשות אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांज़ैक्शन के साथ एक छोटा डेटा नोट संलग्न करें। यह वैकल्पिक है और भेजने के लिए आवश्यक नहीं है — एक्सचेंज इसकी कभी आवश्यकता नहीं रखते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priložite malu podatkovnu napomenu transakciji. Ovo je neobavezno i nije potrebno za slanje — burze to nikad ne zahtijevaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatolj egy kis adatjegyzetet a tranzakcióhoz. Ez nem kötelező, és a küldéshez nem szükséges — a tőzsdék sosem kérik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampirkan catatan data kecil ke transaksi. Ini opsional dan tidak diperlukan untuk mengirim — bursa tidak pernah memerlukannya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Festu litla gagnaathugasemd við færsluna. Þetta er valfrjálst og ekki nauðsynlegt til að senda — kauphallir krefjast hennar aldrei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega una piccola nota dati alla transazione. È facoltativa e non serve per inviare — gli exchange non la richiedono mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引に小さなデータメモを添付します。これは任意で、送金に必須ではありません。取引所が要求することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래에 작은 데이터 메모를 첨부하세요. 이는 선택 사항이며 전송에 필요하지 않습니다 — 거래소는 절대 요구하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite prie operacijos mažą duomenų pastabą. Tai neprivaloma ir nereikalinga siunčiant – biržos to niekada nereikalauja."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet transakcijai nelielu datu piezīmi. Tā ir neobligāta un nav nepieciešama sūtīšanai — biržas to nekad neprasa."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇടപാടിലേക്ക് ഒരു ചെറിയ ഡാറ്റ കുറിപ്പ് അറ്റാച്ച് ചെയ്യുക. ഇത് ഓപ്ഷണലാണ്, അയയ്ക്കാൻ ആവശ്യമില്ല — എക്സ്ചേഞ്ചുകൾ ഇത് ഒരിക്കലും ആവശ്യപ്പെടുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवहाराला एक लहान डेटा टीप जोडा. हे ऐच्छिक आहे आणि पाठवण्यासाठी आवश्यक नाही — एक्सचेंजना याची कधीही गरज नसते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampirkan nota data kecil pada transaksi. Ini adalah pilihan dan tidak diperlukan untuk menghantar — bursa tidak pernah memerlukannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg ved et lite datanotat til transaksjonen. Dette er valgfritt og trengs ikke for å sende — børser krever det aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een kleine datanotitie toe aan de transactie. Dit is optioneel en niet nodig om te verzenden — exchanges vereisen het nooit."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੈਣ-ਦੇਣ ਨਾਲ ਇੱਕ ਛੋਟਾ ਡਾਟਾ ਨੋਟ ਜੋੜੋ। ਇਹ ਵਿਕਲਪਿਕ ਹੈ ਅਤੇ ਭੇਜਣ ਲਈ ਲੋੜੀਂਦਾ ਨਹੀਂ ਹੈ — ਐਕਸਚੇਂਜ ਇਸਦੀ ਕਦੇ ਮੰਗ ਨਹੀਂ ਕਰਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz do transakcji niewielką notatkę danych. Jest opcjonalna i nie jest wymagana do wysłania — giełdy nigdy jej nie wymagają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe uma pequena nota de dados à transação. Isto é opcional e não é necessário para enviar — corretoras nunca exigem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atașează o mică notă de date la tranzacție. Este opțională și nu e necesară pentru a trimite — bursele nu o cer niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикрепите к транзакции небольшую заметку с данными. Это необязательно и не требуется для отправки — биржи никогда этого не требуют."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte k transakcii malú dátovú poznámku. Toto je voliteľné a nie je potrebné na odoslanie — burzy to nikdy nevyžadujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakciji priložite majhno podatkovno opombo. To je neobvezno in ni potrebno za pošiljanje — borze tega nikoli ne zahtevajo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priložite malu napomenu sa podacima uz transakciju. Ovo je opciono i nije potrebno za slanje — menjačnice to nikada ne zahtevaju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifoga en liten dataanteckning till transaktionen. Detta är valfritt och behövs inte för att skicka — börser kräver det aldrig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambatisha dokezo dogo la data kwenye muamala. Hili ni la hiari na halihitajiki kutuma — sarafu za kubadilishana hazilihitaji kamwe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனையுடன் ஒரு சிறிய தரவுக் குறிப்பை இணைக்கவும். இது விருப்பத் தேர்வு மற்றும் அனுப்ப தேவையில்லை — பரிமாற்றங்கள் ஒருபோதும் இதைக் கோராது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లావాదేవీకి చిన్న డేటా గమనికను జోడించండి. ఇది ఐచ్ఛికం మరియు పంపడానికి అవసరం లేదు — ఎక్స్ఛేంజీలు దీన్ని ఎప్పుడూ కోరవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนบหมายเหตุข้อมูลขนาดเล็กไปกับธุรกรรม ไม่บังคับและไม่จำเป็นสำหรับการส่ง — แพลตฟอร์มแลกเปลี่ยนไม่เคยต้องการสิ่งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşleme küçük bir veri notu iliştirin. Bu isteğe bağlıdır ve göndermek için gerekli değildir — borsalar asla bunu istemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте до транзакції невелику примітку з даними. Це необов’язково й не потрібно для надсилання — біржі цього ніколи не вимагають."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانزیکشن کے ساتھ ایک چھوٹا ڈیٹا نوٹ منسلک کریں۔ یہ اختیاری ہے اور بھیجنے کے لیے ضروری نہیں — ایکسچینجز کو اس کی کبھی ضرورت نہیں ہوتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đính kèm một ghi chú dữ liệu nhỏ vào giao dịch. Đây là tùy chọn và không cần thiết để gửi — các sàn giao dịch không bao giờ yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为交易附加一小段数据附言。此项为可选，发送时无需填写——交易所从不要求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為交易附加一小段資料附言。此項為選用，傳送時無需填寫——交易所從不要求。"
          }
        }
      }
    },
    "Authenticate": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Outentiseer"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصادقة"
          }
