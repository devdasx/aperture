    "Could not decrypt the phrase. Try restarting Aperture.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon nie die frase ontsyfer nie. Probeer Aperture herbegin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فكّ تشفير العبارة. حاول إعادة تشغيل Aperture."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фразата не може да бъде дешифрирана. Опитайте да рестартирате Aperture."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রেজ ডিক্রিপ্ট করা যায়নি। Aperture পুনরায় চালু করে দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut desxifrar la frase. Prova de reiniciar Aperture."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Frázi se nepodařilo dešifrovat. Zkuste Aperture restartovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasen kunne ikke dekrypteres. Prøv at genstarte Aperture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Phrase konnte nicht entschlüsselt werden. Bitte starten Sie Aperture neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποκρυπτογράφηση της φράσης. Δοκιμάστε να επανεκκινήσετε το Aperture."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not decrypt the phrase. Try restarting Aperture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descifrar la frase. Prueba a reiniciar Aperture."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraasi ei õnnestunud dekrüpteerida. Proovi Aperture taaskäivitada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتوانست عبارت را رمزگشایی کند. Aperture را دوباره راه‌اندازی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lausetta ei voitu purkaa. Käynnistä Aperture uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-decrypt ang parirala. Subukang i-restart ang Aperture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déchiffrer la phrase. Essayez de redémarrer Aperture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לפענח את הביטוי. נסה להפעיל מחדש את Aperture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्रेज़ डिक्रिप्ट नहीं हो सका। Aperture को पुनः चालू करके देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frazu nije bilo moguće dešifrirati. Pokušajte ponovno pokrenuti Aperture."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mondat nem volt megfejthető. Próbálja meg újraindítani az Aperture-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mendekripsi frasa. Coba mulai ulang Aperture."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að afkóða setninguna. Reyndu að endurræsa Aperture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decifrare la frase. Prova a riavviare Aperture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズを復号できませんでした。Aperture を再起動してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구문을 복호화할 수 없습니다. Aperture를 다시 시작해 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko iššifruoti frazės. Pabandykite paleisti „Aperture“ iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frāzi nevarēja atšifrēt. Mēģiniet restartēt Aperture."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാചകം ഡീക്രിപ്റ്റ് ചെയ്യാനായില്ല. Aperture പുനരാരംഭിക്കാൻ ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वाक्यरचना डिक्रिप्ट करता आली नाही. Aperture पुन्हा सुरू करून पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mendekripsi frasa. Cuba mulakan semula Aperture."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klarte ikke å dekryptere frasen. Prøv å starte Aperture på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon de zin niet ontsleutelen. Probeer Aperture opnieuw te starten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਾਕ ਡੀਕ੍ਰਿਪਟ ਨਹੀਂ ਹੋ ਸਕਿਆ। Aperture ਮੁੜ ਚਾਲੂ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odszyfrować frazy. Spróbuj uruchomić Aperture ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível descriptografar a frase. Tente reiniciar o Aperture."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraza nu a putut fi decriptată. Încercați să reporniți Aperture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось расшифровать фразу. Попробуйте перезапустить Aperture."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Frázu sa nepodarilo dešifrovať. Skúste Aperture reštartovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraze ni bilo mogoče dešifrirati. Poskusite znova zagnati Aperture."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Фразу није било могуће дешифровати. Покушајте поново да покренете Aperture."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasen kunde inte dekrypteras. Försök att starta om Aperture."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kufunga ufunguo wa kifungu. Jaribu kuanzisha upya Aperture."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சொற்றொடரை மறைகுறியீடு நீக்க முடியவில்லை. Aperture-ஐ மீள்தொடங்க முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పదబంధాన్ని డీక్రిప్ట్ చేయలేకపోయింది. Aperture ను పునఃప్రారంభించడానికి ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถอดรหัสวลีไม่สำเร็จ ลองเริ่ม Aperture ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfade çözülemedi. Aperture'ı yeniden başlatmayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розшифрувати фразу. Спробуйте перезапустити Aperture."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فقرہ ڈکرپٹ نہیں ہو سکا۔ Aperture کو دوبارہ شروع کرنے کی کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể giải mã cụm từ. Hãy thử khởi động lại Aperture."
          }
