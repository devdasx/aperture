        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture est open source. Chaque affirmation ci-dessus est vérifiable dans le code."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture היא בקוד פתוח. כל אחת מהאמירות לעיל ניתנת לאימות בקוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ओपन सोर्स है। ऊपर दिए गए हर दावे को कोड में सत्यापित किया जा सकता है।"
          }
        },
        "hr": {
