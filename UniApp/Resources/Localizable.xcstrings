    "Wipes the on-disk price cache. The next refresh fetches fresh prices from Coinbase.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vee die prys-kas op skyf uit. Die volgende verfrissing haal vars pryse by Coinbase."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح ذاكرة التخزين المؤقت للأسعار على القرص. ستجلب عملية التحديث التالية أسعارًا جديدة من Coinbase."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтрива кеша на цените на диска. Следващото опресняване извлича пресни цени от Coinbase."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিস্কে থাকা প্রাইস ক্যাশে মুছে ফেলে। পরবর্তী রিফ্রেশে Coinbase থেকে নতুন দাম আনা হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esborra la memòria cau de preus al disc. La pròxima actualització obté preus nous de Coinbase."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže mezipaměť cen na disku. Při dalším obnovení se z Coinbase načtou nové ceny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydder pris-cachen på disken. Næste opdatering henter friske priser fra Coinbase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den Preis-Cache auf der Festplatte. Bei der nächsten Aktualisierung werden frische Preise von Coinbase abgerufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει την προσωρινή μνήμη τιμών στον δίσκο. Η επόμενη ανανέωση θα ανακτήσει νέες τιμές από την Coinbase."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wipes the on-disk price cache. The next refresh fetches fresh prices from Coinbase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la caché de precios en disco. La próxima actualización obtiene precios nuevos de Coinbase."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutab kettal oleva hindade vahemälu. Järgmine värskendamine toob uued hinnad Coinbase'ist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کش قیمت روی دیسک را پاک می‌کند. در رفرش بعدی، قیمت‌های تازه از Coinbase دریافت می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjentää levyltä hintavälimuistin. Seuraava päivitys hakee uudet hinnat Coinbasesta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubura ang price cache sa disk. Sa susunod na refresh, kukuha ng sariwang presyo mula sa Coinbase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le cache des prix sur disque. Le prochain rafraîchissement récupère des prix actualisés depuis Coinbase."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנקה את מטמון המחירים בדיסק. הרענון הבא יביא מחירים טריים מ-Coinbase."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्क पर मौजूद कीमत कैश को मिटा देता है। अगली रिफ्रेश Coinbase से नई कीमतें लाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše predmemoriju cijena s diska. Sljedeće osvježavanje dohvaća nove cijene s Coinbasea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli a lemezen tárolt árak gyorsítótárát. A következő frissítés friss árakat hoz le a Coinbase-ről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus cache harga di disk. Penyegaran berikutnya akan mengambil harga baru dari Coinbase."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyðir verðskyndiminni á diski. Næsta endurnýjun sækir ferskt verð frá Coinbase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella la cache dei prezzi su disco. Il prossimo aggiornamento recupera prezzi nuovi da Coinbase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上の価格キャッシュを削除します。次回の更新で Coinbase から新しい価格を取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크에 저장된 가격 캐시를 지웁니다. 다음 새로 고침 때 Coinbase에서 새 가격을 가져옵니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išvalo diske esančią kainų talpyklą. Kitas atnaujinimas paims naujas kainas iš „Coinbase“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notīra diskā esošo cenu kešatmiņu. Nākamais atjauninājums iegūs jaunas cenas no Coinbase."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡിസ്കിലെ വില കാഷ് മായ്‌ക്കും. അടുത്ത പുതുക്കൽ Coinbase-ൽ നിന്ന് പുതിയ വിലകൾ ലഭ്യമാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्कवरील किंमत कॅशे पुसते. पुढील रिफ्रेश Coinbase कडून ताज्या किमती आणेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam cache harga pada cakera. Penyegaran seterusnya mengambil harga baharu dari Coinbase."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tømmer pris-bufferen på disken. Neste oppdatering henter ferske priser fra Coinbase."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist de prijscache op schijf. De volgende vernieuwing haalt nieuwe prijzen op bij Coinbase."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡਿਸਕ 'ਤੇ ਮੌਜੂਦ ਕੀਮਤ ਕੈਸ਼ ਨੂੰ ਮਿਟਾਉਂਦਾ ਹੈ। ਅਗਲੀ ਰਿਫਰੈਸ਼ Coinbase ਤੋਂ ਤਾਜ਼ੀਆਂ ਕੀਮਤਾਂ ਲਿਆਏਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyści pamięć podręczną cen na dysku. Następne odświeżenie pobiera świeże ceny z Coinbase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa o cache de preços em disco. A próxima atualização busca preços novos na Coinbase."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge memoria cache a prețurilor de pe disc. Următoarea reîmprospătare aduce prețuri noi de la Coinbase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет дисковый кэш цен. При следующем обновлении новые цены будут получены из Coinbase."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymaže vyrovnávaciu pamäť cien na disku. Pri ďalšom obnovení sa z Coinbase načítajú nové ceny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Počisti predpomnilnik cen na disku. Naslednja osvežitev pridobi sveže cene s Coinbasea."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Брише кеш цена са диска. Следеће освежавање преузима нове цене са Coinbase-а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensar pris-cachen på disken. Nästa uppdatering hämtar nya priser från Coinbase."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufuta cache ya bei iliyo kwenye diski. Uburudishaji unaofuata utachota bei mpya kutoka Coinbase."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வட்டில் உள்ள விலை கேச்சை அழிக்கிறது. அடுத்த புதுப்பிப்பு Coinbase-லிருந்து புதிய விலைகளை எடுக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డిస్క్‌లోని ధర కాష్‌ను తుడిచివేస్తుంది. తదుపరి రిఫ్రెష్ Coinbase నుండి తాజా ధరలను తీసుకువస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบแคชราคาที่จัดเก็บบนดิสก์ การรีเฟรชครั้งถัดไปจะดึงราคาใหม่จาก Coinbase"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskteki fiyat önbelleğini siler. Bir sonraki yenileme, fiyatları Coinbase'den taze olarak getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє кеш цін на диску. Під час наступного оновлення нові ціни буде отримано з Coinbase."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈسک پر موجود قیمت کیشے کو مٹاتا ہے۔ اگلی ریفریش پر Coinbase سے تازہ قیمتیں حاصل کی جائیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá bộ nhớ đệm giá trên đĩa. Lần làm mới tiếp theo sẽ tải giá mới từ Coinbase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除磁盘上的价格缓存。下次刷新会从 Coinbase 获取新价格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除磁碟上的價格快取。下次重新整理時會從 Coinbase 取得新價格。"
          }
        }
      }
    },
    "With RBF on, a pending transaction can be bumped with a higher fee so it confirms sooner. It does not let anyone change where the funds go — only the fee.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Met RBF aan kan 'n hangende transaksie met 'n hoër fooi opgestoot word sodat dit gouer bevestig. Dit laat niemand toe om te verander waarheen die fondse gaan nie — net die fooi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تفعيل RBF، يمكن دفع معاملة معلّقة برسوم أعلى لتتأكّد أسرع. وهو لا يتيح لأي أحد تغيير وجهة الأموال — الرسوم فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С включен RBF чакаща транзакция може да бъде повишена с по-висока такса, за да се потвърди по-скоро. Това не позволява на никого да промени къде отиват средствата — само таксата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF চালু থাকলে, একটি মুলতুবি লেনদেন বেশি ফি দিয়ে এগিয়ে নেওয়া যায় যাতে তা দ্রুত নিশ্চিত হয়। এটি কাউকে তহবিলের গন্তব্য পরিবর্তন করতে দেয় না — শুধু ফি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb RBF activat, una transacció pendent es pot accelerar amb una comissió més alta perquè es confirmi abans. No permet que ningú canviï on van els fons: només la comissió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Se zapnutým RBF lze čekající transakci urychlit vyšším poplatkem, aby se potvrdila dříve. Nikomu to neumožní změnit, kam prostředky míří – pouze poplatek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med RBF slået til kan en ventende transaktion hæves med et højere gebyr, så den bekræftes hurtigere. Det lader ingen ændre, hvor midlerne går hen – kun gebyret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit aktiviertem RBF kann eine ausstehende Transaktion mit einer höheren Gebühr beschleunigt werden, sodass sie früher bestätigt wird. Es erlaubt niemandem, das Ziel der Mittel zu ändern – nur die Gebühr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ενεργό το RBF, μια εκκρεμής συναλλαγή μπορεί να επιταχυνθεί με υψηλότερο τέλος ώστε να επιβεβαιωθεί νωρίτερα. Δεν επιτρέπει σε κανέναν να αλλάξει πού πηγαίνουν τα κεφάλαια — μόνο το τέλος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With RBF on, a pending transaction can be bumped with a higher fee so it confirms sooner. It does not let anyone change where the funds go — only the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con RBF activado, una transacción pendiente puede acelerarse con una comisión más alta para que se confirme antes. No permite que nadie cambie el destino de los fondos: solo la comisión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui RBF on sees, saab ootel tehingut kõrgema tasuga tõsta, et see kinnitataks varem. See ei luba kellelgi muuta, kuhu raha läheb — ainult tasu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با روشن‌بودن RBF، یک تراکنش در انتظار می‌تواند با کارمزدی بالاتر افزایش یابد تا زودتر تأیید شود. این کار به کسی اجازه نمی‌دهد مقصد دارایی‌ها را تغییر دهد — فقط کارمزد را."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun RBF on käytössä, odottavaa tapahtumaa voi nopeuttaa korkeammalla maksulla, jotta se vahvistuu aiemmin. Se ei anna kenenkään muuttaa, minne varat menevät – vain maksua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-on ang RBF, maaaring itaas ang isang nakabinbing transaksyon sa pamamagitan ng mas mataas na fee upang mas maagang makumpirma. Hindi nito pinapayagan ang sinuman na baguhin kung saan mapupunta ang pondo — ang fee lamang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le RBF activé, une transaction en attente peut être relancée avec des frais plus élevés pour confirmer plus tôt. Cela ne permet à personne de changer la destination des fonds — seulement les frais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כש-RBF פעיל, אפשר להאיץ עסקה ממתינה בעמלה גבוהה יותר כדי שתאושר מוקדם יותר. זה אינו מאפשר לאף אחד לשנות לאן הכספים מגיעים — רק את העמלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF चालू होने पर, किसी लंबित लेन-देन को अधिक शुल्क के साथ बढ़ाया जा सकता है ताकि वह जल्दी पुष्ट हो। यह किसी को भी फ़ंड का गंतव्य बदलने नहीं देता — केवल शुल्क।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz uključen RBF, transakcija na čekanju može se ubrzati višom naknadom kako bi se ranije potvrdila. Nikome ne omogućuje promjenu odredišta sredstava – samo naknade."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolt RBF mellett egy függőben lévő tranzakció magasabb díjjal felgyorsítható, hogy hamarabb megerősödjön. Senkinek sem teszi lehetővé, hogy megváltoztassa, hová kerül a pénz – csak a díjat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan RBF aktif, transaksi yang tertunda dapat dinaikkan biayanya agar terkonfirmasi lebih cepat. Ini tidak memungkinkan siapa pun mengubah tujuan dana — hanya biayanya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þegar RBF er á má hækka gjald á færslu í bið svo hún staðfestist fyrr. Það gerir engum kleift að breyta hvert fjármunirnir fara — aðeins gjaldinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l'RBF attivo, una transazione in sospeso può essere rilanciata con una commissione più alta per confermare prima. Non consente a nessuno di cambiare la destinazione dei fondi — solo la commissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF を有効にすると、保留中の取引をより高い手数料で引き上げ、早く確認させられます。資金の送り先を誰かが変更することはできません。変えられるのは手数料だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF가 켜져 있으면 대기 중인 거래의 수수료를 더 높여 더 빨리 확정시킬 수 있어요. 자금이 가는 곳은 아무도 바꿀 수 없고 — 오직 수수료만 바뀌어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjungus RBF, laukiančiai operacijai galima padidinti mokestį, kad ji būtų patvirtinta greičiau. Tai neleidžia niekam pakeisti, kur keliauja lėšos – tik mokestį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja RBF ir ieslēgts, gaidošam darījumam var paaugstināt maksu, lai tas tiktu apstiprināts ātrāk. Tas nevienam neļauj mainīt, kurp aiziet līdzekļi — tikai maksu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF ഓണാണെങ്കിൽ, തീർച്ചപ്പെടാത്ത ഒരു ഇടപാട് ഉയർന്ന ഫീസോടെ ഉയർത്തി വേഗത്തിൽ സ്ഥിരീകരിക്കാം. ഫണ്ടുകൾ എവിടേക്ക് പോകുന്നു എന്നത് മാറ്റാൻ ഇത് ആരെയും അനുവദിക്കില്ല — ഫീസ് മാത്രം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF चालू असल्यास, प्रलंबित व्यवहार जास्त फीसह वाढवून लवकर पुष्टी करता येतो. निधी कुठे जातो हे बदलण्याची मुभा तो कोणालाही देत नाही — फक्त फी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan RBF dihidupkan, transaksi yang menunggu boleh dinaikkan dengan yuran lebih tinggi supaya ia disahkan lebih awal. Ia tidak membenarkan sesiapa mengubah ke mana dana pergi — hanya yuran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med RBF på kan en ventende transaksjon økes med et høyere gebyr slik at den bekreftes raskere. Det lar ingen endre hvor midlene går – bare gebyret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met RBF aan kan een lopende transactie met hogere kosten worden opgehoogd zodat die sneller bevestigt. Het laat niemand veranderen waar het tegoed heen gaat — alleen de kosten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF ਚਾਲੂ ਹੋਣ 'ਤੇ, ਬਕਾਇਆ ਲੈਣ-ਦੇਣ ਨੂੰ ਵੱਧ ਫ਼ੀਸ ਨਾਲ ਵਧਾਇਆ ਜਾ ਸਕਦਾ ਹੈ ਤਾਂ ਜੋ ਇਹ ਜਲਦੀ ਪੁਸ਼ਟ ਹੋਵੇ। ਇਹ ਕਿਸੇ ਨੂੰ ਇਹ ਬਦਲਣ ਨਹੀਂ ਦਿੰਦਾ ਕਿ ਫੰਡ ਕਿੱਥੇ ਜਾਂਦੇ ਹਨ — ਸਿਰਫ਼ ਫ਼ੀਸ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy włączonym RBF oczekującą transakcję można podbić wyższą opłatą, aby potwierdziła się szybciej. Nie pozwala to nikomu zmienić miejsca docelowego środków — tylko opłatę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o RBF ativado, uma transação pendente pode ser acelerada com uma taxa maior para confirmar mais cedo. Ele não permite que ninguém altere o destino dos fundos — apenas a taxa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu RBF activat, o tranzacție în așteptare poate fi accelerată cu un comision mai mare, ca să se confirme mai devreme. Nu permite nimănui să schimbe unde ajung fondurile — doar comisionul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включённом RBF ожидающую транзакцию можно ускорить более высокой комиссией, чтобы она подтвердилась раньше. Это не позволяет никому изменить, куда уходят средства — только комиссию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "So zapnutým RBF možno čakajúcu transakciu urýchliť vyšším poplatkom, aby sa potvrdila skôr. Nikomu to neumožní zmeniť, kam prostriedky smerujú – iba poplatok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z vklopljenim RBF lahko transakcijo v čakanju pospešite z višjim nadomestilom, da se prej potrdi. Nikomur ne dovoli spremeniti, kam gredo sredstva – le nadomestilo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Са укљученим RBF-ом, трансакција на чекању може се убрзати вишом накнадом да би се раније потврдила. Никоме не дозвољава да промени куда средства иду — само накнаду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med RBF på kan en väntande transaktion höjas med en högre avgift så att den bekräftas snabbare. Det låter ingen ändra vart medlen går – endast avgiften."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF ikiwa imewashwa, muamala unaosubiri unaweza kuongezewa ada ya juu ili uthibitishwe mapema zaidi. Hauruhusu mtu yeyote kubadilisha mahali fedha zinakoenda — ada pekee."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF இயக்கப்பட்டிருந்தால், நிலுவையில் உள்ள பரிவர்த்தனையை அதிக கட்டணத்துடன் உயர்த்தி விரைவில் உறுதிப்படுத்தலாம். நிதி எங்கு செல்கிறது என்பதை யாரும் மாற்ற இது அனுமதிக்காது — கட்டணம் மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF ఆన్‌లో ఉంటే, పెండింగ్‌లో ఉన్న లావాదేవీని ఎక్కువ ఫీజుతో పెంచి త్వరగా నిర్ధారించవచ్చు. నిధులు ఎక్కడికి వెళ్తాయో మార్చడానికి ఇది ఎవరినీ అనుమతించదు — ఫీజును మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิด RBF ธุรกรรมที่รออยู่สามารถเพิ่มค่าธรรมเนียมให้สูงขึ้นเพื่อยืนยันเร็วขึ้นได้ มันไม่ให้ใครเปลี่ยนปลายทางของเงิน — เปลี่ยนได้เฉพาะค่าธรรมเนียม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF açıkken, bekleyen bir işlem daha yüksek bir ücretle hızlandırılarak daha erken onaylanabilir. Hiç kimsenin paranın gideceği yeri değiştirmesine izin vermez — yalnızca ücreti değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли RBF увімкнено, очікувану транзакцію можна прискорити вищою комісією, щоб вона підтвердилася раніше. Це не дає нікому змінити, куди йдуть кошти — лише комісію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "RBF آن ہونے پر، زیر التوا ٹرانزیکشن کو زیادہ فیس کے ساتھ بڑھایا جا سکتا ہے تاکہ یہ جلد تصدیق ہو جائے۔ یہ کسی کو رقم کی منزل تبدیل کرنے نہیں دیتا — صرف فیس بدلتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật RBF, một giao dịch đang chờ có thể được tăng phí cao hơn để xác nhận sớm hơn. Nó không cho phép bất kỳ ai thay đổi nơi tiền đến — chỉ thay đổi phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启 RBF 后，待处理交易可通过提高费用来加快确认。它不会让任何人更改资金的去向——只能更改费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 RBF 後，待處理交易可透過提高費用來加快確認。它不會讓任何人變更資金的去向——只能變更費用。"
          }
        }
      }
    },
    "Without a passcode, your wallet is only protected by your iPhone's lock screen.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder 'n toegangskode word jou beursie slegs deur jou iPhone se sluitskerm beskerm."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون رمز دخول، تكون محفظتك محميّة فقط بقفل شاشة iPhone."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без паролен код портфейлът ви е защитен само от заключения екран на iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসকোড ছাড়া আপনার ওয়ালেট কেবল iPhone-এর লক স্ক্রিন দ্বারা সুরক্ষিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense un codi, la teva cartera només la protegeix la pantalla de bloqueig de l'iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez hesla je vaše peněženka chráněna pouze zamykací obrazovkou iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden en adgangskode beskyttes din tegnebog kun af iPhones låseskærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Code ist Ihre Wallet nur durch den Sperrbildschirm des iPhone geschützt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς κωδικό, το πορτοφόλι σας προστατεύεται μόνο από την οθόνη κλειδώματος του iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a passcode, your wallet is only protected by your iPhone's lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin código, tu wallet solo está protegido por la pantalla de bloqueo del iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma pääsukoodita on sinu rahakott kaitstud ainult iPhone'i lukustusekraaniga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون رمز عبور، کیف پول شما فقط با صفحهٔ قفل iPhone محافظت می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman pääsykoodia lompakkoasi suojaa vain iPhonen lukitusnäyttö."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung walang passcode, ang lock screen lamang ng iPhone mo ang nagpoprotekta sa wallet mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans code, votre portefeuille n'est protégé que par l'écran de verrouillage de votre iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללא קוד גישה, הארנק שלך מוגן רק על ידי מסך הנעילה של ה-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना पासकोड के, आपका वॉलेट केवल iPhone की लॉक स्क्रीन से सुरक्षित है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez šifre, vaš novčanik štiti samo zaključani zaslon iPhonea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelkód nélkül a tárcáját csak az iPhone zárolási képernyője védi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kode sandi, dompet Anda hanya dilindungi oleh layar kunci iPhone Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Án aðgangskóða er veskið þitt aðeins verndað af lásskjá iPhone-sins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un codice, il tuo portafoglio è protetto solo dalla schermata di blocco del tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードを設定しないと、ウォレットは iPhone のロック画面でのみ保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 없으면 지갑은 iPhone의 잠금 화면으로만 보호됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Be prieigos kodo jūsų piniginę saugo tik „iPhone“ užrakto ekranas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez piekļuves koda jūsu maku aizsargā tikai iPhone bloķēšanas ekrāns."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാസ്‌കോഡില്ലെങ്കിൽ, നിങ്ങളുടെ വാലറ്റ് നിങ്ങളുടെ iPhone-ന്റെ ലോക്ക് സ്‌ക്രീൻ മാത്രമേ പരിരക്ഷിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पासकोडशिवाय, तुमचे वॉलेट फक्त तुमच्या iPhone च्या लॉक स्क्रीनद्वारे संरक्षित आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kod laluan, dompet anda hanya dilindungi oleh skrin kunci iPhone anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten en kode er lommeboken din kun beskyttet av iPhones låseskjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder toegangscode wordt je portemonnee alleen beschermd door het vergrendelscherm van je iPhone."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਾਸਕੋਡ ਤੋਂ ਬਿਨਾਂ, ਤੁਹਾਡਾ ਵਾਲਿਟ ਸਿਰਫ਼ ਤੁਹਾਡੀ iPhone ਦੀ ਲਾਕ ਸਕ੍ਰੀਨ ਨਾਲ ਸੁਰੱਖਿਅਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kodu dostępu Twój portfel jest chroniony tylko ekranem blokady iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um código, sua carteira é protegida apenas pela tela de bloqueio do iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără un cod, portofelul vă este protejat doar de ecranul de blocare al iPhone-ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без код-пароля ваш кошелёк защищён только экраном блокировки iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez prístupového kódu vašu peňaženku chráni iba uzamknutá obrazovka iPhonu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez gesla vašo denarnico ščiti le zaklenjeni zaslon iPhona."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без шифре, ваш новчаник штити само закључани екран iPhone-а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan en lösenkod skyddas din plånbok endast av iPhones låsskärm."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila nenosiri, pochi yako inalindwa tu na skrini ya kufunga ya iPhone yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுக்குறியீடு இல்லாமல், உங்கள் வாலட் உங்கள் iPhone-இன் பூட்டு திரையால் மட்டுமே பாதுகாக்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాస్‌కోడ్ లేకుండా, మీ వాలెట్ మీ iPhone యొక్క లాక్ స్క్రీన్ ద్వారా మాత్రమే రక్షించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีรหัสผ่าน กระเป๋าสตางค์ของคุณจะได้รับการปกป้องด้วยหน้าจอล็อกของ iPhone เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola olmadan, cüzdanınız yalnızca iPhone'unuzun kilit ekranıyla korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без код-пароля ваш гаманець захищає лише екран блокування iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس کوڈ کے بغیر، آپ کا والٹ صرف آپ کے iPhone کے لاک اسکرین سے محفوظ ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có mật mã, ví của bạn chỉ được bảo vệ bằng màn hình khoá của iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置密码时,你的钱包仅由 iPhone 的锁屏保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定密碼時,你的錢包僅由 iPhone 的鎖定畫面保護。"
          }
        }
      }
    },
    "Without a passcode, your wallet is only protected by your iPhone's lock screen. Set one to require authentication every time you open Aperture.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder 'n toegangskode word jou beursie net deur jou iPhone se sluitskerm beskerm. Stel een in om verifikasie elke keer wat jy Aperture oopmaak, te vereis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون رمز مرور، تكون محفظتك محمية فقط بشاشة قفل الـ iPhone الخاص بك. اضبط رمزًا لطلب المصادقة في كل مرة تفتح فيها Aperture."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без код, портфейлът ви е защитен само от заключения екран на iPhone. Задайте такъв, за да изисквате удостоверяване всеки път, когато отваряте Aperture."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসকোড ছাড়া, আপনার ওয়ালেট শুধু আপনার iPhone-এর লক স্ক্রিন দ্বারা সুরক্ষিত থাকে। প্রতিবার Aperture খোলার সময় প্রমাণীকরণ প্রয়োজন হতে একটি সেট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense un codi, la teva cartera només està protegida per la pantalla de bloqueig del teu iPhone. Estableix-ne un perquè calgui autenticació cada vegada que obris Aperture."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kódu je vaše peněženka chráněna pouze zamykací obrazovkou iPhonu. Nastavte si jej, aby Aperture vyžadovala ověření při každém otevření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden en kode er din wallet kun beskyttet af din iPhones låseskærm. Indstil en, hvis du vil kræve godkendelse, hver gang du åbner Aperture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Code ist Ihr Wallet nur durch den Sperrbildschirm Ihres iPhones geschützt. Legen Sie einen Code fest, damit bei jedem Öffnen von Aperture eine Authentifizierung erforderlich ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς κωδικό, το πορτοφόλι σας προστατεύεται μόνο από την οθόνη κλειδώματος του iPhone σας. Ορίστε έναν, ώστε να απαιτείται έλεγχος ταυτότητας κάθε φορά που ανοίγετε το Aperture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un código, tu billetera solo está protegida por la pantalla de bloqueo de tu iPhone. Establece uno para requerir autenticación cada vez que abras Aperture."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma pääsukoodita kaitseb teie rahakotti ainult iPhone'i lukustusekraan. Määrake see, et nõuda autentimist iga kord, kui Aperture'i avate."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون رمز، کیف پول شما فقط با صفحه قفل آیفون محافظت می‌شود. یک رمز تنظیم کنید تا هر بار که Aperture را باز می‌کنید احراز هویت لازم باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman pääsykoodia lompakkoasi suojaa vain iPhonen lukitusnäyttö. Aseta sellainen, jolloin Aperture vaatii todennusta jokaisella avauskerralla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung walang passcode, protektado lang ang wallet ninyo ng lock screen ng iPhone. Mag-set ng isa para mangailangan ng authentication tuwing bubuksan ninyo ang Aperture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans code, votre portefeuille n'est protégé que par l'écran de verrouillage de votre iPhone. Définissez-en un pour exiger l'authentification à chaque ouverture d'Aperture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי קוד גישה, הארנק שלך מוגן רק על ידי מסך הנעילה של ה-iPhone. הגדר קוד כדי לדרוש אימות בכל פעם שאתה פותח את Aperture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासकोड के बिना, आपका वॉलेट केवल आपके iPhone की लॉक स्क्रीन से सुरक्षित होता है। हर बार Aperture खोलने पर प्रमाणीकरण माँगने के लिए एक पासकोड सेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez pristupnog koda vaš je novčanik zaštićen samo zaključanim zaslonom vašeg iPhonea. Postavite ga kako bi pri svakom otvaranju Aperturea bila potrebna autentikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód nélkül a tárcáját csak az iPhone zárolási képernyője védi. Állítson be egyet, hogy az Aperture minden megnyitáskor hitelesítést kérjen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kode sandi, dompet Anda hanya dilindungi oleh layar kunci iPhone. Atur kode untuk meminta autentikasi setiap kali Anda membuka Aperture."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Án aðgangskóða er veskið þitt aðeins varið með lásskjá iPhone. Stilltu hann svo að krafist sé auðkenningar í hvert sinn sem þú opnar Aperture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un codice, il suo portafoglio è protetto soltanto dalla schermata di blocco dell'iPhone. Lo imposti per richiedere l'autenticazione ogni volta che apre Aperture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードがない場合、ウォレットは iPhone のロック画面でしか保護されません。Aperture を開くたびに認証を求めるには、パスコードを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호가 없으면 지갑은 iPhone의 잠금 화면으로만 보호돼요. 암호를 설정하면 Aperture를 열 때마다 인증을 요구할 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Be prieigos kodo jūsų piniginę saugo tik iPhone užrakto ekranas. Nustatykite jį, kad būtų reikalaujama autentifikuotis kiekvieną kartą atidarius Aperture."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez piekļuves koda jūsu maciņu aizsargā tikai iPhone bloķēšanas ekrāns. Iestatiet to, lai prasītu autentifikāciju katru reizi, kad atverat Aperture."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാസ്‌കോഡില്ലാതെ, നിങ്ങളുടെ വാലറ്റിനെ iPhone-ന്റെ ലോക്ക് സ്ക്രീൻ മാത്രമേ സംരക്ഷിക്കുന്നുള്ളൂ. Aperture തുറക്കുമ്പോഴെല്ലാം പ്രാമാണീകരണം ആവശ്യപ്പെടാൻ ഒന്ന് സജ്ജമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पासकोडशिवाय, तुमचे वॉलेट फक्त iPhone च्या लॉक स्क्रीनद्वारे संरक्षित आहे. Aperture उघडता तेव्हा प्रत्येक वेळी प्रमाणीकरण आवश्यक करण्यासाठी एक सेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kod laluan, dompet anda hanya dilindungi oleh skrin kunci iPhone. Tetapkan satu untuk memerlukan pengesahan setiap kali anda membuka Aperture."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten en kode er lommeboken din kun beskyttet av låseskjermen på iPhone. Sett en for å kreve autentisering hver gang du åpner Aperture."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder toegangscode wordt je portemonnee alleen beschermd door het vergrendelscherm van je iPhone. Stel er een in om bij elke opening van Aperture authenticatie te vereisen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਾਸਕੋਡ ਤੋਂ ਬਿਨਾਂ, ਤੁਹਾਡਾ ਵਾਲਿਟ ਸਿਰਫ਼ iPhone ਦੀ ਲਾਕ ਸਕਰੀਨ ਨਾਲ ਸੁਰੱਖਿਅਤ ਹੈ। Aperture ਖੋਲ੍ਹਣ 'ਤੇ ਹਰ ਵਾਰ ਪ੍ਰਮਾਣਿਕਤਾ ਮੰਗਣ ਲਈ ਇੱਕ ਸੈੱਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kodu portfel jest chroniony jedynie ekranem blokady iPhone'a. Ustaw kod, aby wymagać uwierzytelnienia za każdym razem, gdy otwierasz Aperture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um código, sua carteira fica protegida apenas pela tela de bloqueio do seu iPhone. Defina um para exigir autenticação toda vez que abrir a Aperture."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără un cod, portofelul tău este protejat doar de ecranul de blocare al iPhone-ului. Setează unul pentru a solicita autentificare de fiecare dată când deschizi Aperture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без кода ваш кошелёк защищён только экраном блокировки iPhone. Установите код, чтобы при каждом открытии Aperture требовалась аутентификация."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kódu je vaša peňaženka chránená iba uzamknutou obrazovkou iPhonu. Nastavte si ho, aby pri každom otvorení Aperture vyžadovala overenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez gesla je vaša denarnica zaščitena le z zaklenjenim zaslonom iPhona. Nastavite ga, da bo Aperture ob vsakem odpiranju zahteval preverjanje pristnosti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без кода, ваш новчаник је заштићен само закључаним екраном вашег iPhone-а. Поставите га да бисте захтевали проверу идентитета сваки пут када отворите Aperture."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan en kod skyddas din plånbok endast av iPhones låsskärm. Ange en så att autentisering krävs varje gång du öppnar Aperture."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila nenosiri, pochi yako inalindwa tu na skrini ya kufunga ya iPhone. Weka moja ili kuhitaji uthibitishaji kila unapofungua Aperture."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுக்குறியீடு இல்லாமல், உங்கள் வாலெட் iPhone-இன் பூட்டுத் திரையால் மட்டுமே பாதுகாக்கப்படுகிறது. Aperture-ஐ திறக்கும் ஒவ்வொரு முறையும் அங்கீகாரம் கேட்க ஒன்றை அமைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాస్‌కోడ్ లేకుండా, మీ వాలెట్‌ను iPhone లాక్ స్క్రీన్ మాత్రమే రక్షిస్తుంది. Aperture తెరిచిన ప్రతిసారీ ప్రామాణీకరణను అడిగేలా ఒకటి సెట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีรหัสผ่าน กระเป๋าของคุณจะได้รับการป้องกันด้วยหน้าจอล็อกของ iPhone เท่านั้น ตั้งรหัสไว้เพื่อให้ต้องยืนยันตัวตนทุกครั้งที่เปิด Aperture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola olmadan cüzdanınızı yalnızca iPhone'unuzun kilit ekranı korur. Aperture'ı her açtığınızda kimlik doğrulama istemek için bir parola belirleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без коду ваш гаманець захищений лише екраном блокування iPhone. Установіть код, щоб під час кожного відкриття Aperture потрібна була автентифікація."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس کوڈ کے بغیر، آپ کا والیٹ صرف iPhone کی لاک اسکرین سے محفوظ ہوتا ہے۔ ایک سیٹ کریں تاکہ ہر بار Aperture کھولنے پر تصدیق لازمی ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có mã, ví của bạn chỉ được bảo vệ bởi màn hình khóa iPhone. Đặt mã để yêu cầu xác thực mỗi khi mở Aperture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有密码,你的钱包仅受 iPhone 锁屏保护。设置一个密码,每次打开 Aperture 都需要身份验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有密碼,你的錢包僅受 iPhone 鎖定畫面保護。設定一個密碼,每次打開 Aperture 都需要身分驗證。"
          }
        }
      }
    },
    "Without a PIN, your wallet is only protected by your iPhone's lock screen.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder ʼn PIN word jou beursie net deur jou iPhone se sluitskerm beskerm."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون رمز PIN، محفظتك محمية فقط بشاشة قفل iPhone الخاص بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без PIN портфейлът ви е защитен само от заключения екран на вашия iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN ছাড়া, আপনার ওয়ালেট শুধুমাত্র আপনার iPhone-এর লক স্ক্রিন দ্বারা সুরক্ষিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense un PIN, la teva cartera només està protegida per la pantalla de bloqueig de l'iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez PIN je vaše peněženka chráněna pouze uzamknutou obrazovkou iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden en PIN er din wallet kun beskyttet af din iPhones låseskærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne PIN ist deine Wallet nur durch den Sperrbildschirm deines iPhones geschützt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς PIN, το πορτοφόλι σας προστατεύεται μόνο από την οθόνη κλειδώματος του iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un PIN, tu cartera solo está protegida por la pantalla de bloqueo de tu iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN-ita on sinu rahakott kaitstud ainult iPhone'i lukustuskuvaga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون PIN، کیف پول شما فقط با صفحهٔ قفل iPhone محافظت می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman PIN-koodia lompakkosi on suojattu vain iPhonen lukitusnäytöllä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag walang PIN, ang lock screen lang ng iyong iPhone ang nagpoprotekta sa iyong wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans PIN, votre portefeuille n’est protégé que par l’écran de verrouillage de votre iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללא PIN, הארנק שלך מוגן רק על ידי מסך הנעילה של ה-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN के बिना, आपका वॉलेट केवल आपके iPhone की लॉक स्क्रीन से सुरक्षित है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez PIN-a vaš novčanik štiti samo zaključani zaslon iPhonea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN nélkül a tárcádat csak az iPhone-od zárolási képernyője védi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa PIN, dompet Anda hanya dilindungi oleh layar kunci iPhone Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Án PIN-númers er veskið þitt aðeins varið með læsiskjá iPhone-sins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un PIN, il tuo wallet è protetto solo dalla schermata di blocco del tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PINがない場合、あなたのウォレットはiPhoneのロック画面でのみ保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 없이는 지갑이 iPhone의 잠금 화면으로만 보호됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Be PIN jūsų piniginė apsaugota tik „iPhone“ užrakto ekranu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez PIN jūsu maks ir aizsargāts tikai ar iPhone bloķēšanas ekrānu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN ഇല്ലെങ്കിൽ, നിങ്ങളുടെ വാലറ്റ് iPhone-ന്റെ ലോക്ക് സ്ക്രീൻ വഴി മാത്രമേ പരിരക്ഷിക്കപ്പെടുകയുള്ളൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN शिवाय, तुमचं वॉलेट फक्त iPhone च्या लॉक स्क्रीनद्वारेच सुरक्षित आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa PIN, dompet anda hanya dilindungi oleh skrin kunci iPhone anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten en PIN er lommeboken din bare beskyttet av iPhonens låseskjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder pincode wordt je wallet alleen beschermd door het toegangsscherm van je iPhone."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN ਤੋਂ ਬਿਨਾਂ, ਤੁਹਾਡਾ ਵਾਲਿਟ ਸਿਰਫ਼ ਤੁਹਾਡੇ iPhone ਦੀ ਲੌਕ ਸਕ੍ਰੀਨ ਨਾਲ ਹੀ ਸੁਰੱਖਿਅਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez PIN-u Twój portfel jest chroniony tylko ekranem blokady iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um PIN, sua carteira só está protegida pela tela de bloqueio do iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără un PIN, portofelul tău este protejat doar de ecranul de blocare al iPhone-ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без PIN-кода ваш кошелёк защищён только экраном блокировки iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez PIN je vaša peňaženka chránená iba zamknutou obrazovkou iPhonu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez PIN je vaša denarnica zaščitena samo z zaklenjenim zaslonom iPhona."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без PIN-а ваш новчаник штити само закључани екран iPhone-а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan en PIN-kod skyddas din plånbok endast av iPhonens låsskärm."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila PIN, pochi yako inalindwa tu na skrini ya kufunga ya iPhone yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN இல்லாமல், உங்கள் பணப்பை உங்கள் iPhone-இன் பூட்டு திரையால் மட்டுமே பாதுகாக்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN లేకుండా, మీ వాలెట్ కేవలం మీ iPhone లాక్ స్క్రీన్ ద్వారా మాత్రమే రక్షించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มี PIN กระเป๋าเงินของคุณจะได้รับการปกป้องโดยหน้าจอล็อกของ iPhone เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN olmadan cüzdanınız yalnızca iPhone’unuzun kilit ekranıyla korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без PIN-коду ваш гаманець захищений лише екраном блокування iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN کے بغیر، آپ کا والٹ صرف آپ کے iPhone کی لاک اسکرین سے محفوظ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có mã PIN, ví của bạn chỉ được bảo vệ bởi màn hình khóa của iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 PIN 码,你的钱包仅受 iPhone 锁屏保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 PIN 碼,你的錢包僅受 iPhone 鎖定畫面保護。"
          }
        }
      }
    },
