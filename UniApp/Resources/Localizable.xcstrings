            "value": "\\(chain.displayName) இல் \\(identity.symbol) சம்பந்தப்பட்ட பரிவர்த்தனைகள் ஆன்-செயினில் உறுதியாகும்போது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
