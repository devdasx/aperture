          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ नेटवर्क पर सबमिट किया गया। पुष्टि में कुछ समय लग सकता है — अंतिम परिणाम के लिए एक्सप्लोरर जाँचें।"
