    "Swap across chains in one flow.": {
      "comment": "Slide 8 hero title.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruil oor kettings in een vloei."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل بين الشبكات في تدفق واحد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разменяйте между вериги в един поток."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি প্রবাহেই চেইনের মধ্যে সোয়াপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescanvia entre cadenes en un sol flux."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyměňujte napříč řetězci v jednom toku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift mellem kæder i ét forløb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauschen Sie chainübergreifend in einem Ablauf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανταλλάξτε ανάμεσα σε αλυσίδες σε μία ροή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap across chains in one flow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercambia entre redes en un solo flujo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaheta erinevate ahelate vahel ühe käiguga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میان شبکه‌ها در یک جریان واحد مبادله کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda ketjujen välillä yhdellä kerralla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-swap sa kabila ng mga chain sa iisang daloy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échangez entre les réseaux en un seul geste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלפה בין רשתות בתהליך אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही प्रवाह में चेनों के बीच स्वैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razmjenjujte između lanaca u jednom toku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cseréljen láncok között egyetlen folyamatban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar lintas jaringan dalam satu alur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiptu á milli keðja í einum ferli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scambi tra reti in un solo flusso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつの流れでチェーンをまたいでスワップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 체인 간 스왑을 한 흐름으로 진행합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiskite tarp grandinių vienu srautu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainiet starp ķēdēm vienā plūsmā."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒറ്റ ഫ്ലോയിൽ ചെയിനുകൾക്കിടയിൽ സ്വാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एकाच फ्लोमध्ये चेन्समध्ये स्वॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar antara rangkaian dalam satu aliran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt mellom kjeder i én flyt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel tussen netwerken in één stroom."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕੋ ਫਲੋ ਵਿੱਚ ਚੇਨਾਂ ਵਿਚਕਾਰ ਸਵੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymieniaj między sieciami w jednym przepływie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque entre redes em um único fluxo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbă între lanțuri într-un singur flux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте между сетями в одном потоке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymieňajte naprieč reťazcami v jednom toku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamenjave med verigami v enem koraku."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
