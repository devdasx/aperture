        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏דוגמה בלבד — לעולם אל תשלח לכאן כספים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उदाहरण — इस पर कभी धन न भेजें।"
