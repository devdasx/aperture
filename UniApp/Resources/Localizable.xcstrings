    "Add a token by pasting its contract address. Aperture reads the rest from chain.": {
      "extractionState": "new",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg 'n token by deur sy kontrakadres te plak. Aperture lees die res vanaf die ketting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عملة رمزية بلصق عنوان عقدها. تقرأ Aperture الباقي من السلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете токен, като поставите адреса на договора му. Aperture чете останалото от веригата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্ট্রাক্ট ঠিকানা পেস্ট করে একটি টোকেন যোগ করুন। Aperture চেইন থেকে বাকি তথ্য পড়ে নেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un token enganxant la seva adreça de contracte. Aperture llegeix la resta de la cadena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte token vložením adresy jeho kontraktu. Zbytek si Aperture načte z chainu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en token ved at indsætte kontraktadressen. Aperture læser resten fra kæden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Token hinzu, indem du seine Vertragsadresse einfügst. Den Rest liest Aperture aus der Chain."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα token επικολλώντας τη διεύθυνση του συμβολαίου του. Τα υπόλοιπα τα διαβάζει το Aperture από την αλυσίδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a token by pasting its contract address. Aperture reads the rest from chain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un token pegando su dirección de contrato. Aperture lee el resto en la cadena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa märk, kleepides selle lepingu aadressi. Aperture loeb ülejäänu ahelast."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با چسباندن نشانی قراردادش یک توکن اضافه کنید. Aperture بقیه را از زنجیره می‌خواند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää token liittämällä sen sopimusosoite. Aperture lukee loput ketjusta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng token sa pamamagitan ng pag-paste ng contract address nito. Binabasa ng Aperture ang iba pa mula sa chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un jeton en collant son adresse de contrat. Aperture lit le reste depuis la chaîne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להוסיף טוקן על־ידי הדבקת כתובת החוזה שלו. את השאר Aperture קוראת מהבלוקצ׳יין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके कॉन्ट्रैक्ट पता पेस्ट करके टोकन जोड़ें। बाकी जानकारी Aperture चेन से पढ़ लेता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte token lijepljenjem adrese ugovora. Ostalo Aperture čita s lanca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá a tokent a szerződés címének beillesztésével. A többit az Aperture leolvassa a láncról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan token dengan menempelkan alamat kontraknya. Aperture membaca sisanya dari rantai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu við tóka með því að líma inn samningsfangið hans. Aperture les afganginn af keðjunni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunga un token incollando il suo indirizzo del contratto. Aperture legge il resto dalla catena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントラクトアドレスを貼り付けてトークンを追加します。残りはAperture がチェーンから読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트랙트 주소를 붙여넣어 토큰을 추가하세요. 나머지는 Aperture가 체인에서 읽어와요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite žetoną įklijuodami jo sutarties adresą. Aperture likusią informaciją nuskaito iš grandinės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet marķieri, ielīmējot tā līguma adresi. Aperture pārējo nolasa no ķēdes."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കരാർ വിലാസം ഒട്ടിച്ച് ഒരു ടോക്കൺ ചേർക്കുക. ബാക്കിയുള്ളവ Aperture ചെയിനിൽ നിന്ന് വായിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्याचा करार पत्ता पेस्ट करून टोकन जोडा. उर्वरित Aperture चेनवरून वाचते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah token dengan menampal alamat kontraknya. Aperture membaca selebihnya daripada rantaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en token ved å lime inn kontraktadressen. Aperture leser resten fra kjeden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een token toe door het contractadres te plakken. Aperture leest de rest uit de chain."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਦਾ ਕੰਟਰੈਕਟ ਪਤਾ ਪੇਸਟ ਕਰਕੇ ਟੋਕਨ ਜੋੜੋ। ਬਾਕੀ Aperture ਚੇਨ ਤੋਂ ਪੜ੍ਹਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj token, wklejając adres jego kontraktu. Aperture odczyta resztę z łańcucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um token colando o endereço do contrato. O Aperture lê o resto na rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un token lipind adresa contractului. Aperture citește restul de pe chain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте токен, вставив адрес его контракта. Остальное Aperture прочитает из сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte token vložením adresy jeho kontraktu. Zvyšok si Aperture načíta z reťazca."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte žeton z lepljenjem naslova pogodbe. Ostalo Aperture prebere iz verige."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додајте токен налепљивањем адресе уговора. Остало Aperture чита са ланца."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en token genom att klistra in dess kontraktsadress. Aperture läser resten från kedjan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza tokeni kwa kubandika anwani yake ya mkataba. Aperture husoma mengine kutoka kwenye mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதன் ஒப்பந்த முகவரியை ஒட்டுவதன் மூலம் டோக்கனைச் சேர்க்கவும். மீதியை Aperture பிணையத்திலிருந்து படிக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాని కాంట్రాక్ట్ చిరునామాను అతికించడం ద్వారా టోకెన్‌ను జోడించండి. మిగిలినవి Aperture చైన్ నుండి చదువుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มโทเคนด้วยการวางที่อยู่สัญญา Aperture จะอ่านส่วนที่เหลือจากเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözleşme adresini yapıştırarak bir token ekleyin. Aperture gerisini zincirden okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте токен, вставивши адресу його контракту. Решту Aperture зчитає з мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کا کنٹریکٹ ایڈریس پیسٹ کر کے ٹوکن شامل کریں۔ Aperture باقی تفصیلات چین سے پڑھ لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm token bằng cách dán địa chỉ hợp đồng của nó. Aperture đọc phần còn lại từ chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴合约地址来添加代币。Aperture 会从链上读取其余信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上合約地址來新增代幣。Aperture 會從鏈上讀取其餘資訊。"
          }
        }
      }
    },
