        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primateljska adresa je niz koji identificira jedan od vaših računa na određenom lancu. Njezino dijeljenje omogućuje nekome da pošalje sredstva na taj račun."
          }
