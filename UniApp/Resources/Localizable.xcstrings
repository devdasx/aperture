    "Hidden networks stay supported — only this asset's view is affected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الشبكات المخفية مدعومة — يتأثّر عرض هذا الأصل فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লুকানো নেটওয়ার্কগুলো সমর্থিতই থাকে — শুধু এই অ্যাসেটের ভিউ প্রভাবিত হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les xarxes amagades segueixen suportades: només es veu afectada la vista d’aquest actiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryté sítě jsou nadále podporovány — ovlivněno je jen zobrazení tohoto aktiva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte netværk understøttes fortsat — kun visningen af dette aktiv påvirkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Netzwerke bleiben unterstützt — nur die Ansicht dieses Assets ist betroffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κρυφά δίκτυα παραμένουν υποστηριζόμενα — επηρεάζεται μόνο η προβολή αυτού του asset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las redes ocultas siguen siendo compatibles: solo se afecta la vista de este activo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شبکه‌های پنهان همچنان پشتیبانی می‌شوند — فقط نمای این دارایی تأثیر می‌پذیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilotetut verkot pysyvät tuettuina — vain tämän omaisuuden näkymä muuttuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réseaux masqués restent pris en charge — seul l’affichage de cet actif est concerné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשתות מוסתרות נשארות נתמכות — מושפעת רק התצוגה של הנכס הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छिपे हुए नेटवर्क समर्थित ही रहते हैं — सिर्फ़ इस एसेट का व्यू प्रभावित होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivene mreže i dalje su podržane — utječe se samo na prikaz ove imovine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rejtett hálózatok továbbra is támogatottak — csak ennek az eszköznek a nézete változik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaringan tersembunyi tetap didukung — hanya tampilan aset ini yang terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reti nascoste restano supportate — è interessata solo la vista di questo asset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のネットワークも引き続きサポートされます — このアセットの表示だけが変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 네트워크도 계속 지원돼요 — 이 자산의 보기에만 영향을 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte nettverk støttes fortsatt — bare visningen av denne ressursen påvirkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen netwerken blijven ondersteund — alleen de weergave van dit asset wordt beïnvloed."
