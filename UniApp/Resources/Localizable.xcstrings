        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture سورس کے بغیر کنٹریکٹ کالز کو ڈی کوڈ نہیں کرتا۔ سلیکٹر کو dApp کی دستاویزات کے مقابلے میں پڑھیں۔"
          }
