        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਵਾਕ ਰੱਖਣ ਵਾਲਾ ਕੋਈ ਵੀ ਤੁਹਾਡੇ ਫੰਡ ਲੈ ਸਕਦਾ ਹੈ। Aperture ਇਸਨੂੰ ਤੁਹਾਡੇ ਲਈ ਮੁੜ-ਪ੍ਰਾਪਤ ਨਹੀਂ ਕਰ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy, kto ma tę frazę, może zabrać Twoje środki. Aperture nie może jej odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
