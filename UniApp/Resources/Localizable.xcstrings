    "Every signature is gated by your biometrics. No password to forget.": {
      "comment": "Slide 4 body.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke handtekening word deur jou biometrie beheer. Geen wagwoord om te vergeet nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل توقيع محميٌّ بقياساتك الحيوية. لا كلمة سرٍّ تُنسى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки подпис се потвърждава с вашата биометрия. Няма парола, която да забравите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি সই আপনার বায়োমেট্রিক্স দ্বারা সুরক্ষিত। ভুলে যাওয়ার মতো কোনো পাসওয়ার্ড নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada signatura passa per la teva biometria. Cap contrasenya per oblidar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý podpis je střežen vaší biometrií. Žádné heslo k zapomenutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver signatur er låst bag din biometri. Intet kodeord at glemme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Signatur wird durch Ihre Biometrie freigegeben. Kein Passwort, das man vergessen könnte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε υπογραφή προστατεύεται από τα βιομετρικά σας. Καμία κωδική φράση προς απομνημόνευση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every signature is gated by your biometrics. No password to forget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada firma queda protegida por tu biometría. Sin contraseñas que olvidar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga allkiri kinnitatakse sinu biomeetriaga. Pole parooli, mida unustada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر امضا با شناسایی زیستی شما تأیید می‌شود. هیچ گذرواژه‌ای برای فراموش کردن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen allekirjoitus vaatii biometriikkasi. Ei salasanaa, jonka voisi unohtaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat lagda ay binubukas ng iyong biometrics. Walang password na malilimutan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque signature passe par votre biométrie. Aucun mot de passe à retenir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל חתימה דורשת ביומטריה שלך. אין סיסמה לשכוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर हस्ताक्षर आपकी बायोमेट्रिक्स से सुरक्षित है। भूलने के लिए कोई पासवर्ड नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki je potpis zaštićen vašom biometrijom. Nema lozinke za zaboraviti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden aláírást a biometria véd. Nincs jelszó, amit elfelejthetne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tanda tangan melewati biometrik Anda. Tidak ada kata sandi untuk dilupakan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver undirskrift krefst lífkenna þinna. Engin lykilorð til að gleyma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni firma passa dalla sua biometria. Nessuna password da ricordare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての署名は、あなたの生体認証によって守られます。忘れるべきパスワードはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서명은 생체 인증을 거칩니다. 잊을 비밀번호가 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas parašas patvirtinamas jūsų biometrija. Slaptažodžio, kurį pamiršti, nėra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrs paraksts tiek apstiprināts ar jūsu biometriju. Nav paroles, ko aizmirst."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ഒപ്പും നിങ്ങളുടെ ബയോമെട്രിക്സ് വഴി മാത്രമേ അനുവദിക്കൂ. മറക്കാൻ പാസ്‌വേഡ് ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक स्वाक्षरीसाठी तुमची बायोमेट्रिक्स लागते. विसरण्यासाठी पासवर्ड नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tandatangan disahkan dengan biometrik anda. Tiada kata laluan untuk dilupakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver signatur sikres av biometrien din. Ingen passord å glemme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke ondertekening verloopt via je biometrie. Geen wachtwoord om te onthouden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਦਸਤਖਤ ਤੁਹਾਡੇ ਬਾਇਓਮੈਟ੍ਰਿਕਸ ਨਾਲ ਸੁਰੱਖਿਅਤ ਹੈ। ਭੁੱਲਣ ਲਈ ਕੋਈ ਪਾਸਵਰਡ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy podpis wymaga biometrii. Brak hasła do zapamiętania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda assinatura passa pela sua biometria. Nenhuma senha para esquecer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare semnătură e blocată de biometria ta. Nicio parolă de uitat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая подпись подтверждается вашей биометрией. Никаких паролей, которые можно забыть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý podpis je chránený vašou biometriou. Žiadne heslo na zabudnutie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak podpis je zaščiten z vašo biometrijo. Nobenega gesla, ki bi ga bilo mogoče pozabiti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сваки потпис чува ваша биометрија. Нема лозинке коју бисте могли заборавити."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje signatur kräver din biometri. Inget lösenord att glömma."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila saini hulindwa na biometriki yako. Hakuna nenosiri la kusahau."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு கையொப்பமும் உங்கள் உயிரியல் அடையாளத்தால் காக்கப்படுகிறது. மறக்க கடவுச்சொல் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి సంతకం మీ బయోమెట్రిక్స్‌తో అనుమతించబడుతుంది. మర్చిపోవడానికి పాస్‌వర్డ్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการลงนามผ่านการยืนยันด้วยข้อมูลชีวมิติ ไม่มีรหัสผ่านให้ต้องจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her imza biyometriden geçer. Unutulacak parola yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен підпис захищений вашою біометрією. Жодного пароля, який можна забути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر دستخط آپ کے بایومیٹرکس کے ذریعے محفوظ ہے۔ بھولنے کے لیے کوئی پاس‌ورڈ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi chữ ký đều cần xác thực sinh trắc học. Không có mật khẩu để quên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次签名都由你的生物识别把关。再无密码可忘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次簽名都由你的生物辨識把關。再無密碼可忘。"
          }
        }
      }
    },
    "Every Solana transaction pays a small fixed base fee. The priority fee is an optional tip on top — it only matters when the network is busy.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke Solana-transaksie betaal 'n klein vaste basisfooi. Die prioriteitsfooi is 'n opsionele fooitjie bo-op — dit maak net saak wanneer die netwerk besig is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدفع كل معاملة على Solana رسومًا أساسية ثابتة صغيرة. أما رسوم الأولوية فهي إكرامية اختيارية إضافية — ولا تهمّ إلا عندما تكون الشبكة مزدحمة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяка Solana транзакция плаща малка фиксирана базова такса. Приоритетната такса е незадължителен бакшиш отгоре — има значение само когато мрежата е натоварена."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি Solana লেনদেন একটি ছোট নির্দিষ্ট ভিত্তি ফি দেয়। অগ্রাধিকার ফি হলো এর উপর একটি ঐচ্ছিক টিপ — নেটওয়ার্ক ব্যস্ত থাকলেই কেবল এটি গুরুত্বপূর্ণ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada transacció de Solana paga una petita comissió base fixa. La comissió de prioritat és una propina opcional a sobre: només importa quan la xarxa està ocupada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá transakce Solana platí malý pevný základní poplatek. Prioritní poplatek je nepovinné spropitné navíc – záleží na něm jen tehdy, když je síť vytížená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver Solana-transaktion betaler et lille fast basisgebyr. Prioritetsgebyret er ekstra valgfri drikkepenge oveni – det betyder kun noget, når netværket er travlt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Solana-Transaktion zahlt eine kleine feste Grundgebühr. Die Prioritätsgebühr ist ein optionales Trinkgeld obendrauf – sie zählt nur, wenn das Netzwerk ausgelastet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε συναλλαγή Solana πληρώνει ένα μικρό σταθερό βασικό τέλος. Το τέλος προτεραιότητας είναι ένα προαιρετικό φιλοδώρημα από πάνω — έχει σημασία μόνο όταν το δίκτυο είναι πολυάσχολο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Solana transaction pays a small fixed base fee. The priority fee is an optional tip on top — it only matters when the network is busy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada transacción de Solana paga una pequeña comisión base fija. La comisión de prioridad es una propina opcional adicional: solo importa cuando la red está saturada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga Solana tehing maksab väikese fikseeritud baastasu. Prioriteeditasu on valikuline lisatasu peale — see loeb ainult siis, kui võrk on hõivatud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر تراکنش Solana یک کارمزد پایه ثابت کوچک می‌پردازد. کارمزد اولویت یک انعام اختیاری روی آن است — فقط زمانی اهمیت دارد که شبکه شلوغ باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen Solana-tapahtuma maksaa pienen kiinteän perusmaksun. Prioriteettimaksu on valinnainen lisäpalkkio sen päälle – sillä on merkitystä vain, kun verkko on ruuhkainen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat transaksyon sa Solana ay nagbabayad ng maliit na nakapirming base fee. Ang priority fee ay opsyonal na dagdag — mahalaga lamang ito kapag abala ang network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque transaction Solana paie de petits frais de base fixes. Les frais de priorité sont un pourboire facultatif en plus — ils ne comptent que lorsque le réseau est saturé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל עסקת Solana משלמת עמלת בסיס קבועה וקטנה. עמלת העדיפות היא תשר אופציונלי נוסף מעל — היא חשובה רק כשהרשת עמוסה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर Solana लेन-देन एक छोटा निश्चित आधार शुल्क चुकाता है। प्राथमिकता शुल्क उसके ऊपर एक वैकल्पिक टिप है — यह केवल तब मायने रखता है जब नेटवर्क व्यस्त हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka Solana transakcija plaća malu fiksnu osnovnu naknadu. Prioritetna naknada je neobavezna napojnica povrh toga – važna je samo kada je mreža opterećena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden Solana-tranzakció kis, fix alapdíjat fizet. A prioritási díj egy opcionális borravaló ezen felül – csak akkor számít, amikor a hálózat zsúfolt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap transaksi Solana membayar biaya dasar tetap yang kecil. Biaya prioritas adalah tip opsional di atasnya — hanya penting saat jaringan sibuk."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sérhver Solana-færsla greiðir lítið fast grunngjald. Forgangsgjaldið er valfrjáls þjórfé til viðbótar — það skiptir aðeins máli þegar netið er upptekið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni transazione Solana paga una piccola commissione base fissa. La commissione di priorità è una mancia facoltativa in più — conta solo quando la rete è congestionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana のすべての取引は、わずかな固定の基本手数料を支払います。優先手数料はその上に乗せる任意のチップで、ネットワークが混雑しているときだけ意味を持ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Solana 거래는 작은 고정 기본 수수료를 내요. 우선 수수료는 그 위에 더하는 선택적 팁이고 — 네트워크가 혼잡할 때만 의미가 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekviena „Solana“ operacija moka nedidelį fiksuotą bazinį mokestį. Prioriteto mokestis – tai pasirinktinis papildomas arbatpinigis: jis svarbus tik tada, kai tinklas užimtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrs Solana darījums maksā nelielu fiksētu pamatmaksu. Prioritātes maksa ir izvēles papildmaksa virspusē — tai ir nozīme tikai tad, kad tīkls ir noslogots."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ Solana ഇടപാടും ഒരു ചെറിയ സ്ഥിര അടിസ്ഥാന ഫീസ് നൽകുന്നു. മുൻഗണനാ ഫീസ് അതിന് മുകളിലുള്ള ഓപ്ഷണൽ ടിപ്പാണ് — നെറ്റ്‌വർക്ക് തിരക്കിലായിരിക്കുമ്പോൾ മാത്രമേ ഇത് പ്രസക്തമാകൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक Solana व्यवहार एक लहान निश्चित मूळ फी भरतो. प्राधान्य फी ही त्यावरील पर्यायी टिप आहे — नेटवर्क व्यस्त असतानाच ती महत्त्वाची ठरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap transaksi Solana membayar yuran asas tetap yang kecil. Yuran keutamaan ialah tip pilihan di atasnya — ia hanya penting apabila rangkaian sibuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver Solana-transaksjon betaler et lite, fast basisgebyr. Prioritetsgebyret er en valgfri ekstra tips på toppen – det betyr bare noe når nettverket er travelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke Solana-transactie betaalt een kleine vaste basiskosten. De prioriteitskosten zijn een optionele fooi erbovenop — die telt alleen wanneer het netwerk druk is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ Solana ਲੈਣ-ਦੇਣ ਇੱਕ ਛੋਟੀ ਨਿਸ਼ਚਿਤ ਮੂਲ ਫ਼ੀਸ ਅਦਾ ਕਰਦਾ ਹੈ। ਤਰਜੀਹ ਫ਼ੀਸ ਉਸ ਉੱਤੇ ਇੱਕ ਵਿਕਲਪਿਕ ਟਿੱਪ ਹੈ — ਇਹ ਸਿਰਫ਼ ਉਦੋਂ ਮਾਇਨੇ ਰੱਖਦੀ ਹੈ ਜਦੋਂ ਨੈੱਟਵਰਕ ਰੁੱਝਿਆ ਹੋਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda transakcja Solana płaci małą stałą opłatę podstawową. Opłata priorytetowa to opcjonalny napiwek na wierzchu — ma znaczenie tylko wtedy, gdy sieć jest obciążona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada transação na Solana paga uma pequena taxa base fixa. A taxa de prioridade é uma gorjeta opcional por cima — só importa quando a rede está congestionada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare tranzacție Solana plătește un mic comision de bază fix. Comisionul de prioritate este un bacșiș opțional pe deasupra — contează doar când rețeaua este aglomerată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая транзакция Solana платит небольшую фиксированную базовую комиссию. Приоритетная комиссия — это дополнительные необязательные чаевые сверху, они важны только когда сеть загружена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá transakcia Solana platí malý pevný základný poplatok. Prioritný poplatok je voliteľné prepitné navyše – záleží naň iba vtedy, keď je sieť zaťažená."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka transakcija Solana plača majhno fiksno osnovno nadomestilo. Prednostno nadomestilo je neobvezna napitnina povrhu – pomembno je le, ko je omrežje zasedeno."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Свака Solana трансакција плаћа малу фиксну основну накнаду. Приоритетна накнада је необавезна напојница изнад тога — важна је само када је мрежа оптерећена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje Solana-transaktion betalar en liten fast basavgift. Prioritetsavgiften är en valfri extra dricks ovanpå – den spelar bara roll när nätverket är upptaget."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila muamala wa Solana hulipa ada ndogo ya msingi isiyobadilika. Ada ya kipaumbele ni bakhshishi ya hiari juu yake — inakuwa muhimu tu wakati mtandao una shughuli nyingi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு Solana பரிவர்த்தனையும் ஒரு சிறிய நிலையான அடிப்படை கட்டணத்தைச் செலுத்துகிறது. முன்னுரிமை கட்டணம் என்பது அதன்மேல் விருப்பத்தேர்வான கூடுதலானது — நெட்வொர்க் பரபரப்பாக இருக்கும்போது மட்டுமே இது முக்கியம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి Solana లావాదేవీ చిన్న స్థిర బేస్ ఫీజును చెల్లిస్తుంది. ప్రాధాన్యత ఫీజు అనేది దానిపై ఐచ్ఛిక చిట్కా — నెట్‌వర్క్ రద్దీగా ఉన్నప్పుడు మాత్రమే ఇది ముఖ్యం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกธุรกรรม Solana จ่ายค่าธรรมเนียมพื้นฐานคงที่จำนวนเล็กน้อย ค่าธรรมเนียมเร่งด่วนเป็นทิปเพิ่มเติมที่เลือกได้ — สำคัญเฉพาะเมื่อเครือข่ายแออัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Solana işlemi küçük, sabit bir temel ücret öder. Öncelik ücreti üstüne eklenen isteğe bağlı bir bahşiştir — yalnızca ağ yoğun olduğunda önem taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна транзакція Solana сплачує невелику фіксовану базову комісію. Пріоритетна комісія — це додаткові необов’язкові чайові зверху; вони важливі лише коли мережа завантажена."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر Solana ٹرانزیکشن ایک چھوٹی مقررہ بنیادی فیس ادا کرتی ہے۔ پرائیورٹی فیس اس کے اوپر ایک اختیاری ٹِپ ہے — یہ صرف اس وقت اہم ہوتی ہے جب نیٹ ورک مصروف ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi giao dịch Solana trả một khoản phí cơ bản nhỏ cố định. Phí ưu tiên là khoản thưởng tùy chọn cộng thêm — chỉ quan trọng khi mạng bận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每笔 Solana 交易都会支付一笔固定的小额基础费。优先费是额外的可选小费——仅在网络繁忙时才有意义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每筆 Solana 交易都會支付一筆固定的小額基礎費。優先費是額外的可選小費——僅在網路繁忙時才有意義。"
          }
        }
      }
    },
