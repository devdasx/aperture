    "Could not decrypt the phrase. Try restarting Aperture.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon nie die frase ontsyfer nie. Probeer Aperture herbegin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فكّ تشفير العبارة. حاول إعادة تشغيل Aperture."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фразата не може да бъде дешифрирана. Опитайте да рестартирате Aperture."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রেজ ডিক্রিপ্ট করা যায়নি। Aperture পুনরায় চালু করে দেখুন।"
