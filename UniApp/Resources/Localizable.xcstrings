          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana drži ~0,00089 SOL kao minimum oslobođen zakupnine da bi nalog ostao na lancu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana håller ~0,00089 SOL som det hyresfria minimum så att kontot stannar på kedjan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana huweka ~0.00089 SOL kama kiwango cha chini kisicholipiwa kodi ili akaunti ibaki kwenye mnyororo."
          }
