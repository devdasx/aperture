          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ নেটওয়ার্কে জমা দেওয়া হয়েছে। নিশ্চিত হতে কিছুক্ষণ লাগতে পারে — চূড়ান্ত ফলাফলের জন্য এক্সপ্লোরার দেখুন।"
