    "Total balance hidden, double tap the eye button to reveal": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Totale balans versteek, tik die oogknoppie dubbel om te onthul"
