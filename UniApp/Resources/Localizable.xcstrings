    "Broadcast to the \\(transaction.chain.displayName) network. Confirming may take a moment — you can safely leave this screen.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgesaai na die \\(transaction.chain.displayName)-netwerk. Bevestiging kan ’n oomblik neem — jy kan hierdie skerm veilig verlaat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بثّها إلى شبكة \\(transaction.chain.displayName). قد يستغرق التأكيد لحظة — يمكنك مغادرة هذه الشاشة بأمان."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Излъчена към мрежата \\(transaction.chain.displayName). Потвърждението може да отнеме момент — можете безопасно да напуснете този екран."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) নেটওয়ার্কে সম্প্রচার করা হয়েছে। নিশ্চিত হতে কিছুটা সময় লাগতে পারে — আপনি নিরাপদে এই স্ক্রিন থেকে বেরিয়ে যেতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmesa a la xarxa \\(transaction.chain.displayName). La confirmació pot trigar un moment — pots sortir d’aquesta pantalla amb seguretat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesláno do sítě \\(transaction.chain.displayName). Potvrzení může chvíli trvat — tuto obrazovku můžete bezpečně opustit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendt til \\(transaction.chain.displayName)-netværket. Bekræftelsen kan tage et øjeblik — du kan trygt forlade denne skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An das \\(transaction.chain.displayName)-Netzwerk gesendet. Die Bestätigung kann einen Moment dauern — Sie können diesen Bildschirm bedenkenlos verlassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταδόθηκε στο δίκτυο \\(transaction.chain.displayName). Η επιβεβαίωση μπορεί να πάρει λίγο χρόνο — μπορείτε να φύγετε από αυτήν την οθόνη με ασφάλεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadcast to the \\(transaction.chain.displayName) network. Confirming may take a moment — you can safely leave this screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmitido a la red \\(transaction.chain.displayName). La confirmación puede tardar un momento — puedes salir de esta pantalla con seguridad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Edastatud võrku \\(transaction.chain.displayName). Kinnitamine võib veidi aega võtta — sa võid selle ekraani turvaliselt sulgeda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در شبکه \\(transaction.chain.displayName) منتشر شد. تأیید ممکن است لحظه‌ای طول بکشد — می‌توانید با خیال راحت این صفحه را ترک کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetetty \\(transaction.chain.displayName)-verkkoon. Vahvistus voi kestää hetken — voit turvallisesti poistua tästä näkymästä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-broadcast sa network na \\(transaction.chain.displayName). Maaaring tumagal nang sandali ang pagkumpirma — ligtas mong maiiwan ang screen na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusée sur le réseau \\(transaction.chain.displayName). La confirmation peut prendre un instant — vous pouvez quitter cet écran en toute sécurité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שודרה אל רשת \\(transaction.chain.displayName). האישור עשוי להימשך רגע — אפשר לצאת מהמסך הזה בבטחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) नेटवर्क पर प्रसारित किया गया। पुष्टि होने में थोड़ा समय लग सकता है — आप यह स्क्रीन सुरक्षित रूप से छोड़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emitirano u mrežu \\(transaction.chain.displayName). Potvrda može potrajati trenutak — ovaj zaslon možete sigurno napustiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elküldve a(z) \\(transaction.chain.displayName) hálózatra. A megerősítés eltarthat egy ideig — nyugodtan elhagyhatja ezt a képernyőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disiarkan ke jaringan \\(transaction.chain.displayName). Konfirmasi mungkin memerlukan waktu sejenak — Anda dapat meninggalkan layar ini dengan aman."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent á \\(transaction.chain.displayName)-netið. Staðfesting getur tekið augnablik — þú getur óhætt farið af þessum skjá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmessa sulla rete \\(transaction.chain.displayName). La conferma può richiedere un momento — puoi lasciare questa schermata in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) ネットワークにブロードキャストしました。確認には少し時間がかかることがあります — この画面はそのまま閉じても問題ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) 네트워크에 전송했어요. 확인에 잠시 시간이 걸릴 수 있어요 — 이 화면을 벗어나도 괜찮아요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsiųsta į \\(transaction.chain.displayName) tinklą. Patvirtinimas gali šiek tiek užtrukti — galite saugiai palikti šį ekraną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārraidīts uz \\(transaction.chain.displayName) tīklu. Apstiprināšana var aizņemt mirkli — jūs varat droši pamest šo ekrānu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) നെറ്റ്‌വർക്കിലേക്ക് പ്രക്ഷേപണം ചെയ്തു. സ്ഥിരീകരണത്തിന് അല്പസമയം എടുത്തേക്കാം — ഈ സ്ക്രീൻ സുരക്ഷിതമായി വിട്ടുപോകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) नेटवर्कवर प्रसारित केले. पुष्टी होण्यास थोडा वेळ लागू शकतो — तुम्ही ही स्क्रीन सुरक्षितपणे सोडू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disiarkan ke rangkaian \\(transaction.chain.displayName). Pengesahan mungkin mengambil seketika — anda boleh meninggalkan skrin ini dengan selamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kringkastet til \\(transaction.chain.displayName)-nettverket. Bekreftelsen kan ta et øyeblikk — du kan trygt forlate denne skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzonden naar het \\(transaction.chain.displayName)-netwerk. Bevestiging kan even duren — je kunt dit scherm veilig verlaten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) ਨੈੱਟਵਰਕ ਉੱਤੇ ਪ੍ਰਸਾਰਿਤ ਕੀਤਾ। ਪੁਸ਼ਟੀ ਹੋਣ ਵਿੱਚ ਕੁਝ ਪਲ ਲੱਗ ਸਕਦੇ ਹਨ — ਤੁਸੀਂ ਇਸ ਸਕ੍ਰੀਨ ਨੂੰ ਸੁਰੱਖਿਅਤ ਢੰਗ ਨਾਲ ਛੱਡ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłano do sieci \\(transaction.chain.displayName). Potwierdzenie może chwilę potrwać — można bezpiecznie opuścić ten ekran."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmitida para a rede \\(transaction.chain.displayName). A confirmação pode levar um momento — você pode sair desta tela com segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Difuzată către rețeaua \\(transaction.chain.displayName). Confirmarea poate dura un moment — puteți părăsi acest ecran în siguranță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено в сеть \\(transaction.chain.displayName). Подтверждение может занять время — вы можете спокойно покинуть этот экран."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odoslané do siete \\(transaction.chain.displayName). Potvrdenie môže chvíľu trvať — túto obrazovku môžete bezpečne opustiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posredovano v omrežje \\(transaction.chain.displayName). Potrditev lahko traja trenutek — ta zaslon lahko varno zapustite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Емитовано у мрежу \\(transaction.chain.displayName). Потврда може потрајати тренутак — овај екран можете безбедно напустити."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sänd till \\(transaction.chain.displayName)-nätverket. Bekräftelsen kan ta en stund — du kan lämna den här skärmen utan risk."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imetangazwa kwa mtandao wa \\(transaction.chain.displayName). Uthibitisho unaweza kuchukua muda kidogo — unaweza kuondoka kwenye skrini hii kwa usalama."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) நெட்வொர்க்கில் ஒளிபரப்பப்பட்டது. உறுதிப்படுத்தலுக்கு சிறிது நேரம் ஆகலாம் — இந்தத் திரையைப் பாதுகாப்பாக விட்டுச் செல்லலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) నెట్‌వర్క్‌కి ప్రసారం చేయబడింది. నిర్ధారణకు కొద్దిసేపు పట్టవచ్చు — మీరు ఈ స్క్రీన్‌ను సురక్షితంగా వదిలి వెళ్లవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เผยแพร่ไปยังเครือข่าย \\(transaction.chain.displayName) แล้ว การยืนยันอาจใช้เวลาสักครู่ — คุณออกจากหน้านี้ได้อย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) ağına yayınlandı. Onay biraz zaman alabilir — bu ekrandan güvenle ayrılabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслано до мережі \\(transaction.chain.displayName). Підтвердження може зайняти трохи часу — ви можете безпечно залишити цей екран."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(transaction.chain.displayName) نیٹ ورک پر نشر کر دیا گیا۔ تصدیق میں کچھ لمحے لگ سکتے ہیں — آپ بحفاظت اس اسکرین سے باہر جا سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã phát lên mạng \\(transaction.chain.displayName). Việc xác nhận có thể mất một lát — bạn có thể rời màn hình này một cách an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已广播至 \\(transaction.chain.displayName) 网络。确认可能需要片刻 — 你可以放心离开此页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已廣播至 \\(transaction.chain.displayName) 網路。確認可能需要片刻 — 你可以放心離開此頁面。"
          }
        }
      }
    },
    "Broadcast to the \\(transaction.chain.displayName) network. It'll confirm on-chain in a moment.": {
      "extractionState": "manual",
