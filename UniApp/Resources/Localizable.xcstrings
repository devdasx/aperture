        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatiling sa iyo ang iyong private key. Maaari mong i-import muli ang wallet na ito gamit ito — walang server, at ang pag-alis nito dito ay hindi magpapawala ng anumang na-save mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé privée reste la vôtre. Vous pouvez réimporter ce portefeuille avec elle — il n'y a pas de serveur, et la supprimer ici ne perd rien de ce que vous avez enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח הפרטי שלך נשאר שלך. תוכל לייבא ארנק זה שוב באמצעותו — אין שרת, והסרתו כאן אינה מאבדת דבר ששמרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी निजी कुंजी आपकी रहती है। आप इससे इस वॉलेट को फिर से इंपोर्ट कर सकते हैं — कोई सर्वर नहीं है, और इसे यहाँ हटाने से आपकी सहेजी गई कोई चीज़ नहीं खोती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš privatni ključ ostaje vaš. Ovaj novčanik možete ponovno uvesti s njim — nema poslužitelja, a uklanjanje ovdje ne gubi ništa što ste spremili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A privát kulcsod a tiéd marad. Ezzel újra importálhatod ezt a tárcát — nincs szerver, és az itteni eltávolítással semmit nem veszítesz el abból, amit elmentettél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci privat Anda tetap milik Anda. Anda dapat mengimpor dompet ini lagi dengannya — tidak ada server, dan menghapusnya di sini tidak menghilangkan apa pun yang telah Anda simpan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkalykillinn þinn helst þinn. Þú getur flutt þetta veski inn aftur með honum — það er enginn þjónn, og að fjarlægja það hér glatar engu sem þú hefur vistað."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave privata resta tua. Puoi importare di nuovo questo wallet con essa — non esiste un server e rimuoverla qui non fa perdere nulla di ciò che hai salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵はあなたのものです。これを使ってこのウォレットを再びインポートできます — サーバーはなく、ここで削除しても保存したものは何も失われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 키는 계속 당신의 것입니다. 이를 사용해 이 지갑을 다시 가져올 수 있습니다 — 서버가 없으며, 여기서 제거해도 저장한 것은 아무것도 잃지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų privatusis raktas lieka jūsų. Galite vėl importuoti šią piniginę su juo – serverio nėra, o pašalinus jį čia neprarandama nieko, ką esate išsaugoję."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu privātā atslēga paliek jūsu. Ar to varat atkārtoti importēt šo maku — servera nav, un tās noņemšana šeit nezaudē neko, ko esat saglabājis."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രൈവറ്റ് കീ നിങ്ങളുടേതായി തുടരുന്നു. അതുപയോഗിച്ച് ഈ വാലറ്റ് വീണ്ടും ഇറക്കുമതി ചെയ്യാം — സെർവർ ഇല്ല, ഇവിടെ നീക്കംചെയ്യുന്നത് നിങ്ങൾ സേവ് ചെയ്ത ഒന്നും നഷ്ടപ്പെടുത്തുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची खाजगी की तुमचीच राहते. तुम्ही तिच्यासह हे वॉलेट पुन्हा आयात करू शकता — कोणताही सर्व्हर नाही, आणि ती येथे काढल्याने तुम्ही जतन केलेले काहीही गमावले जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci peribadi anda kekal milik anda. Anda boleh mengimport dompet ini semula dengannya — tiada pelayan, dan mengalih keluarnya di sini tidak menghilangkan apa-apa yang telah anda simpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
