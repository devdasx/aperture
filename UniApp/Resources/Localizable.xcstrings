        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή διαφορετικού δικτύου από την άλλη πλευρά γεφυρώνει μεταξύ αλυσίδων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picking a different network than the other side bridges across chains."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir una red distinta a la del otro lado transfiere por puente entre redes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teisest poolest erineva võrgu valimine sillab ahelate vahel."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
