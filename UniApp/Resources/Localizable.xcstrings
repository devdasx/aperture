    "Nothing was sent — your funds didn't move.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niks is gestuur nie — jou fondse het nie beweeg nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إرسال أي شيء — لم تتحرك أموالك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не беше изпратено — средствата ви не се преместиха."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই পাঠানো হয়নি — আপনার তহবিল সরেনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha enviat res: els teus fons no s'han mogut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nebylo odesláno — vaše prostředky se nepohnuly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet blev sendt — dine midler flyttede sig ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts gesendet – deine Mittel haben sich nicht bewegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν στάλθηκε τίποτα — τα κεφάλαιά σας δεν μετακινήθηκαν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was sent — your funds didn't move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envió nada; tus fondos no se movieron."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi ei saadetud — teie vahendid ei liikunud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزی ارسال نشد — وجوه شما جابه‌جا نشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei lähetetty — varasi eivät liikkuneet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang ipinadala — hindi gumalaw ang iyong pondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été envoyé — vos fonds n'ont pas bougé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר לא נשלח — הכספים שלך לא זזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ नहीं भेजा गया — आपका फ़ंड नहीं हटा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije poslano — vaša se sredstva nisu pomaknula."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem lett elküldve — a pénzed nem mozdult."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dikirim — dana Anda tidak berpindah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert var sent — féð þitt hreyfðist ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato inviato nulla — i tuoi fondi non si sono mossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も送られていません — 資金は移動していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 전송되지 않았습니다 — 자금이 이동하지 않았습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas nebuvo išsiųsta – jūsų lėšos nepajudėjo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas netika nosūtīts — jūsu līdzekļi nepārvietojās."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും അയച്ചില്ല — നിങ്ങളുടെ ഫണ്ട് നീങ്ങിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही पाठवले गेले नाही — तुमचा निधी हलला नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dihantar — dana anda tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting ble sendt — midlene dine flyttet seg ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets verzonden — je tegoed is niet verplaatst."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਨਹੀਂ ਭੇਜਿਆ ਗਿਆ — ਤੁਹਾਡੇ ਫੰਡ ਨਹੀਂ ਹਿੱਲੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie wysłano — Twoje środki się nie ruszyły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi enviado — seus fundos não se moveram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu a fost trimis — fondurile tale nu s-au mișcat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не отправлено — ваши средства остались на месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nebolo odoslané — vaše prostriedky sa nepohli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič ni bilo poslano — vaša sredstva se niso premaknila."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije poslato — vaša sredstva se nisu pomerila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget skickades — dina medel flyttades inte."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kilichotumwa — fedha zako hazikuhama."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் அனுப்பப்படவில்லை — உங்கள் நிதி நகரவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏమీ పంపబడలేదు — మీ నిధులు కదలలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรถูกส่ง — เงินของคุณไม่ได้เคลื่อนไหว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey gönderilmedi — fonlarınız hareket etmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не надіслано — ваші кошти не рухалися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ نہیں بھیجا گیا — آپ کی رقم نہیں ہلی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì được gửi — tiền của bạn không di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发送任何内容——你的资金未发生转移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未傳送任何內容——你的資金未發生轉移。"
          }
        }
      }
    },
