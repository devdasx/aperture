    "No accounts. No servers. Aperture lives on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen rekeninge. Geen bedieners. Aperture leef op jou iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا حسابات. بلا خوادم. Aperture يعيش على iPhone الخاص بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без акаунти. Без сървъри. Aperture живее на вашия iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যাকাউন্ট নয়। কোনো সার্ভার নয়। Aperture আপনার iPhone-এ থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense comptes. Sense servidors. Aperture viu al teu iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné účty. Žádné servery. Aperture žije ve vašem iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konti. Ingen servere. Aperture lever på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Konten. Keine Server. Aperture lebt auf deinem iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς λογαριασμούς. Χωρίς διακομιστές. Το Aperture ζει στο iPhone σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuentas. Sin servidores. Aperture vive en tu iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kontosid. Ei servereid. Aperture elab sinu iPhone'is."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون حساب. بدون سرور. Aperture روی iPhone شما زندگی می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tilejä. Ei palvelimia. Aperture elää iPhonessasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang account. Walang server. Nakatira ang Aperture sa iyong iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de comptes. Pas de serveurs. Aperture vit sur votre iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חשבונות. אין שרתים. Aperture חי באייפון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अकाउंट नहीं। कोई सर्वर नहीं। Aperture आपके iPhone पर रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez računa. Bez poslužitelja. Aperture živi na vašem iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs fiók. Nincs szerver. Az Aperture az iPhone-odon él."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun. Tanpa server. Aperture ada di iPhone Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engir reikningar. Engir netþjónar. Aperture býr í iPhone-inum þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account. Nessun server. Aperture vive sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなし。サーバーなし。Aperture はあなたの iPhone に常駐します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없음. 서버 없음. Aperture는 당신의 iPhone에 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokių paskyrų. Jokių serverių. Aperture gyvena jūsų iPhone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav kontu. Nav serveru. Aperture dzīvo jūsu iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്കൗണ്ടുകളില്ല. സെർവറുകളില്ല. Aperture നിങ്ങളുടെ iPhone-ൽ ജീവിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते नाहीत. सर्व्हर नाहीत. Aperture तुमच्या iPhone वर राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada akaun. Tiada pelayan. Aperture hidup di iPhone anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kontoer. Ingen servere. Aperture lever på din iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen accounts. Geen servers. Aperture leeft op je iPhone."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਖਾਤੇ ਨਹੀਂ। ਕੋਈ ਸਰਵਰ ਨਹੀਂ। Aperture ਤੁਹਾਡੇ iPhone ਤੇ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
