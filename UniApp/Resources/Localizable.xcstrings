    "Signing this data may authorize a token transfer or permit. Only sign typed data from dApps you trust.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يأذن توقيع هذه البيانات بنقل عملة رمزية أو permit. وقّع البيانات المُنمَّطة فقط من dApps تثق بها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডেটায় সাইন করলে টোকেন ট্রান্সফার বা permit অনুমোদন হতে পারে। শুধুমাত্র বিশ্বস্ত dApp-এর টাইপড ডেটা সাইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Signar aquestes dades pot autoritzar una transferència de token o un permit. Signa dades tipades només de dApps en què confiïs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis těchto dat může schválit převod tokenu nebo permit. Typovaná data podepisujte jen od dApp, kterým důvěřujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At signere disse data kan godkende en token-overførsel eller et permit. Signér kun typede data fra dApps, du stoler på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Signieren dieser Daten kann eine Token-Übertragung oder einen Permit autorisieren. Signiere typisierte Daten nur von vertrauenswürdigen dApps."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπογραφή αυτών των δεδομένων μπορεί να εξουσιοδοτήσει μεταφορά token ή permit. Υπογράφετε δομημένα δεδομένα μόνο από dApps που εμπιστεύεστε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing this data may authorize a token transfer or permit. Only sign typed data from dApps you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmar estos datos puede autorizar una transferencia o un permit de token. Firma datos tipados solo de dApps en las que confíes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امضای این داده ممکن است انتقال یا مجوز توکن را اجازه دهد. فقط دادهٔ نوع‌دار را از dAppهایی که به آنها اعتماد دارید امضا کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden tietojen allekirjoittaminen voi valtuuttaa tokenin siirron tai permitin. Allekirjoita tyypitettyä dataa vain luotettavista dAppeista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signer ces données peut autoriser un transfert de jetons ou un permit. Ne signez des données typées que provenant de dApps de confiance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חתימה על נתונים אלה עשויה לאשר העברת טוקן או permit. יש לחתום על נתונים מוקלדים רק מ־dApps שאתה סומך עליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डेटा को साइन करने से टोकन ट्रांसफ़र या permit अधिकृत हो सकता है। केवल उन्हीं dApps के टाइप्ड डेटा साइन करें जिन पर आपको भरोसा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potpisivanje ovih podataka može odobriti prijenos tokena ili permit. Potpisujte tipizirane podatke samo s dApps kojima vjerujete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen adatok aláírása token átutalást vagy permit-et engedélyezhet. Csak megbízható dApp-ok típusos adatait írd alá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandatangani data ini dapat mengizinkan transfer atau izin token. Hanya tandatangani data berformat dari dApp yang Anda percaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmare questi dati potrebbe autorizzare un trasferimento di token o un permit. Firmi dati tipizzati solo da dApp di cui si fida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデータへの署名は、トークン送付または permit を承認することがあります。信頼できる dApp の型付きデータのみ署名してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터에 서명하면 토큰 전송이나 permit이 승인될 수 있어요. 신뢰하는 dApp의 타입 데이터만 서명하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å signere disse dataene kan godkjenne en tokenoverføring eller et permit. Signer kun typede data fra dApps du stoler på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze data ondertekenen kan een tokenoverdracht of permit autoriseren. Onderteken alleen getypte data van dApps die je vertrouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpisanie tych danych może autoryzować transfer lub zezwolenie tokenów. Podpisuj dane typowane tylko z dAppów, którym ufasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
