    "Bitcoin, Ethereum, Solana, and twenty-one more — held together in a single place.": {
      "comment": "Slide 2 body.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana en nog een‑en‑twintig ander — saamgehou op een plek."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin وEthereum وSolana وواحدٌ وعشرون غيرها — جميعها في مكان واحد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana и още двадесет и една — събрани на едно място."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana এবং আরও একুশটি — সব এক জায়গায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana i vint-i-una més — totes en un sol lloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana a dalších dvacet jedna — pohromadě na jednom místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana og enogtyve mere — samlet på ét sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana und einundzwanzig weitere — an einem einzigen Ort vereint."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana και άλλα είκοσι ένα — μαζί, σε ένα σημείο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, and twenty-one more — held together in a single place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana y veintiuna redes más, en un solo lugar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana ja veel kakskümmend üks — kõik ühes kohas koos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin، Ethereum، Solana و بیست و یک شبکه دیگر — همگی در یک مکان."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana ja kaksikymmentäyksi muuta — yhdessä paikassa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, at dalawampu’t isa pa — pinagsama-sama sa iisang lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, et vingt et un autres — réunis en un seul endroit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana ועוד עשרים ואחת — יחד במקום אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana और इक्कीस अन्य — सब एक ही जगह।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana i još dvadeset jedna — sve na jednom mjestu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana és további huszonegy — egy helyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, dan dua puluh satu lainnya — tersatukan di satu tempat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana og tuttugu og einn til viðbótar — saman á einum stað."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana e altri ventuno — riuniti in un solo posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin、Ethereum、Solana、さらに 21 のネットワーク——すべてをひとつの場所に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, 그리고 스물한 개의 네트워크가 한곳에 모입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana ir dar dvidešimt vienas — visi vienoje vietoje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana un vēl divdesmit viens — visi vienkopus vienuviet."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, പിന്നെ ഇരുപത്തിയൊന്ന് കൂടി — എല്ലാം ഒരേ സ്ഥലത്ത് ഒരുമിച്ച്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana आणि आणखी एकवीस — सर्व एकाच ठिकाणी एकत्र."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, dan dua puluh satu lagi — disatukan di satu tempat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana og tjueén andre — samlet på ett sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana en eenentwintig andere — samen op één plek."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, ਅਤੇ ਹੋਰ ਇੱਕੀ — ਸਾਰੇ ਇੱਕੋ ਥਾਂ ਇਕੱਠੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana i dwadzieścia jeden innych — w jednym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana e mais vinte e uma — reunidas em um único lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana și încă douăzeci și unu — ținute laolaltă, într-un singur loc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana и ещё двадцать одна сеть — собраны в одном месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana a ďalších dvadsaťjeden — pohromade na jednom mieste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana in še enaindvajset — vse na enem mestu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana и још двадесет једна — све на једном месту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana och tjugoen till — samlade på ett ställe."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, na ishirini na moja zaidi — vimewekwa pamoja katika sehemu moja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, மற்றும் இன்னும் இருபத்தொன்று — அனைத்தும் ஒரே இடத்தில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin, Ethereum, Solana, ఇంకా ఇరవై ఒక్కటి — అన్నీ ఒకే చోట కలిసి."
