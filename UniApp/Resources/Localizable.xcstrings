    "Nothing left your wallet. You can try again — your funds are safe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing left your wallet. You can try again — your funds are safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada salió de tu monedero. Puedes intentarlo de nuevo: tus fondos están a salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任何资金离开你的钱包。你可以重试——你的资金是安全的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何資金離開你的錢包。你可以重試——你的資金是安全的。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके वॉलेट से कुछ भी नहीं गया। आप दोबारा कोशिश कर सकते हैं — आपके फ़ंड सुरक्षित हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُغادر أي شيء محفظتك. يمكنك المحاولة مرة أخرى — أموالك آمنة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada saiu da sua carteira. Você pode tentar de novo — seus fundos estão seguros."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ওয়ালেট থেকে কিছুই যায়নি। আপনি আবার চেষ্টা করতে পারেন — আপনার তহবিল নিরাপদ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из вашего кошелька ничего не ушло. Можете попробовать снова — ваши средства в безопасности."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットからは何も出ていません。もう一度お試しいただけます。資金は安全です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Ihrer Wallet ist nichts abgeflossen. Sie können es erneut versuchen – Ihre Mittel sind sicher."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З вашого гаманця нічого не пішло. Можете спробувати ще раз — ваші кошти в безпеці."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν έφυγε από το πορτοφόλι σας. Μπορείτε να δοκιμάσετε ξανά — τα κεφάλαιά σας είναι ασφαλή."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu a plecat din portofelul tău. Poți încerca din nou — fondurile tale sunt în siguranță."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z vaší peněženky nic neodešlo. Můžete to zkusit znovu – vaše prostředky jsou v bezpečí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem hagyta el a tárcáját. Újra próbálkozhat – a pénze biztonságban van."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget lämnade din plånbok. Du kan försöka igen – dina medel är säkra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting forlot lommeboken din. Du kan prøve igjen – midlene dine er trygge."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet forlod din wallet. Du kan prøve igen – dine midler er sikre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lompakostasi ei lähtenyt mitään. Voit yrittää uudelleen – varasi ovat turvassa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא יצא מהארנק שלך. אפשר לנסות שוב — הכספים שלך בטוחים."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha sortit res de la teva cartera. Pots tornar-ho a provar: els teus fons estan segurs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije napustilo vaš novčanik. Možete pokušati ponovno – vaša su sredstva sigurna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Z vašej peňaženky nič neodišlo. Môžete to skúsiť znova – vaše prostriedky sú v bezpečí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz vaše denarnice ni odšlo nič. Lahko poskusite znova – vaša sredstva so varna."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ништа није напустило ваш новчаник. Можете покушати поново — ваша средства су безбедна."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a quitté votre portefeuille. Vous pouvez réessayer — vos fonds sont en sécurité."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑에서 빠져나간 것은 없어요. 다시 시도할 수 있고 — 자금은 안전해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla ha lasciato il suo wallet. Può riprovare — i suoi fondi sono al sicuro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdanınızdan hiçbir şey çıkmadı. Tekrar deneyebilirsiniz — paranız güvende."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì rời khỏi ví của bạn. Bạn có thể thử lại — tiền của bạn vẫn an toàn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิ่งใดออกจากกระเป๋าของคุณ คุณลองอีกครั้งได้ — เงินของคุณปลอดภัย"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang keluar dari dompet Anda. Anda dapat mencoba lagi — dana Anda aman."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزی از کیف پول شما خارج نشد. می‌توانید دوباره تلاش کنید — دارایی‌تان امن است."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie opuściło Twojego portfela. Możesz spróbować ponownie — Twoje środki są bezpieczne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets uit je wallet vertrokken. Je kunt het opnieuw proberen — je tegoed is veilig."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے والیٹ سے کچھ نہیں نکلا۔ آپ دوبارہ کوشش کر سکتے ہیں — آپ کی رقم محفوظ ہے۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не е напуснало портфейла Ви. Можете да опитате отново — средствата Ви са в безопасност."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu rahakotist ei läinud midagi välja. Saad uuesti proovida — sinu raha on turvaline."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas neišėjo iš jūsų piniginės. Galite bandyti dar kartą – jūsų lėšos saugios."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "No jūsu maka nekas neaizgāja. Varat mēģināt vēlreiz — jūsu līdzekļi ir drošībā."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert fór úr veskinu þínu. Þú getur reynt aftur — fjármunir þínir eru öruggir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa keluar daripada dompet anda. Anda boleh cuba lagi — dana anda selamat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang umalis sa iyong wallet. Maaari kang subukang muli — ligtas ang iyong pondo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kilichotoka kwenye mkoba wako. Unaweza kujaribu tena — fedha zako ziko salama."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niks het jou beursie verlaat nie. Jy kan weer probeer — jou fondse is veilig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வாலட்டிலிருந்து எதுவும் வெளியேறவில்லை. மீண்டும் முயற்சிக்கலாம் — உங்கள் நிதி பாதுகாப்பாக உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వాలెట్ నుండి ఏదీ బయటకు వెళ్లలేదు. మీరు మళ్లీ ప్రయత్నించవచ్చు — మీ నిధులు సురక్షితంగా ఉన్నాయి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാലറ്റിൽ നിന്ന് ഒന്നും പുറത്തുപോയില്ല. നിങ്ങൾക്ക് വീണ്ടും ശ്രമിക്കാം — നിങ്ങളുടെ ഫണ്ടുകൾ സുരക്ഷിതമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या वॉलेटमधून काहीही बाहेर गेले नाही. तुम्ही पुन्हा प्रयत्न करू शकता — तुमचा निधी सुरक्षित आहे."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਵਾਲਿਟ ਤੋਂ ਕੁਝ ਵੀ ਬਾਹਰ ਨਹੀਂ ਗਿਆ। ਤੁਸੀਂ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰ ਸਕਦੇ ਹੋ — ਤੁਹਾਡੇ ਫੰਡ ਸੁਰੱਖਿਅਤ ਹਨ।"
          }
        }
      }
    },
