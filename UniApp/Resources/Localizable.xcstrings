    "Restores the default wallet identity — Ink background, Wallet glyph.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel die verstekvoorkoms van die beursie — inkagtergrond, Wallet-simbool."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد هوية المحفظة الافتراضية — خلفية حبرية، رمز Wallet."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възстановява облика по подразбиране на портфейла — мастилен фон, символ Wallet."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেটের ডিফল্ট পরিচয় পুনরুদ্ধার করে — কালি ব্যাকগ্রাউন্ড, Wallet গ্লিফ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura la identitat per defecte de la cartera — fons tinta, glif Wallet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví výchozí vzhled peněženky — inkoustové pozadí, symbol Wallet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendanner tegnebogens standardudseende — blækbaggrund, Wallet-symbol."
