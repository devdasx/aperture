        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konti. Ingen servere. Ingen analyse, der følger dine saldi. Intet supportteam at udgive sig for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Konten. Keine Server. Keine Analytics, die deine Guthaben beobachten. Kein Support-Team, das sich vortäuschen ließe."
