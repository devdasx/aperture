          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft for å se gjenopprettingsfrasen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig om uw herstelzin te bekijken."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣਾ ਰਿਕਵਰੀ ਵਾਕਾਂਸ਼ ਦੇਖਣ ਲਈ ਪੁਸ਼ਟੀ ਕਰੋ।"
