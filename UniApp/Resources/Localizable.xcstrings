    "None of the entries validated for \\(chain.displayName). Tap back and check each address or key.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen van die inskrywings is vir \\(chain.displayName) gevalideer nie. Tik terug en kontroleer elke adres of sleutel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تنجح أيٌّ من المدخلات في التحقّق لـ \\(chain.displayName). ارجع للخلف وراجع كل عنوان أو مفتاح."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нито един запис не беше валидиран за \\(chain.displayName). Върнете се и проверете всеки адрес или ключ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName)-এর জন্য কোনো এন্ট্রি যাচাই হয়নি। ফিরে যান এবং প্রতিটি ঠিকানা বা key পরীক্ষা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap entrada s’ha validat per a \\(chain.displayName). Torna enrere i revisa cada adreça o clau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný záznam pro \\(chain.displayName) neprošel ověřením. Vraťte se a zkontrolujte každou adresu nebo klíč."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen af posterne blev valideret for \\(chain.displayName). Tryk tilbage, og kontrollér hver adresse eller nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner der Einträge konnte für \\(chain.displayName) validiert werden. Gehe zurück und prüfe jede Adresse oder jeden Schlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία καταχώριση δεν επικυρώθηκε για το \\(chain.displayName). Πατήστε πίσω και ελέγξτε κάθε διεύθυνση ή κλειδί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the entries validated for \\(chain.displayName). Tap back and check each address or key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna de las entradas se ha validado para \\(chain.displayName). Vuelve atrás y comprueba cada dirección o clave."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ükski kirje ei läbinud valideerimist võrgu \\(chain.displayName) jaoks. Mine tagasi ja kontrolli iga aadress või võti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ‌یک از ورودی‌ها برای \\(chain.displayName) معتبر نشد. بازگردید و هر نشانی یا کلید را بررسی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään syöte ei kelpaa kohteelle \\(chain.displayName). Palaa takaisin ja tarkista jokainen osoite tai avain."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala sa mga entry ang na-validate para sa \\(chain.displayName). I-tap ang balik at suriin ang bawat address o key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune des entrées n’a été validée pour \\(chain.displayName). Revenez en arrière et vérifiez chaque adresse ou clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף ערך לא אומת עבור \\(chain.displayName). אפשר לחזור ולבדוק כל כתובת או מפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) के लिए कोई भी एंट्री वैध नहीं हुई। पीछे जाएँ और हर पता या key जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan unos nije potvrđen za \\(chain.displayName). Vratite se i provjerite svaku adresu ili ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen bejegyzés sem érvényesült a(z) \\(chain.displayName) esetén. Lépj vissza, és ellenőrizd minden címet vagy kulcsot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada entri yang tervalidasi untuk \\(chain.displayName). Ketuk kembali dan periksa setiap alamat atau kunci."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin færslnanna staðfestist fyrir \\(chain.displayName). Farðu til baka og athugaðu hvert fang eða lykil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna delle voci è stata convalidata per \\(chain.displayName). Tocchi Indietro e controlli ogni indirizzo o chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(chain.displayName) で検証された項目はありません。戻って各アドレスまたはキーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
