    "Rate-limited — try again in a moment": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo beperk — probeer 'n oomblik later weer"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجاوز معدّل الطلبات — أعد المحاولة بعد قليل"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
