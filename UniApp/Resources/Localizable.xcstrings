        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een echte, live offerte — maar Aperture ondertekent en verstuurt swaps nog niet. Er is niets verzonden. Ondertekenen + versturen op het apparaat komt in de volgende update, net zoals verzenden eerder kwam."
          }
