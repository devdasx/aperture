          "stringUnit": {
            "state": "translated",
            "value": "将已有的钱包导入 Aperture。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將已有的錢包匯入 Aperture。"
          }
        }
      }
    },
