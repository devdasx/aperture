          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší skluz může znamenat, že dostanete znatelně méně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere slippage kan betyde, at du modtager mærkbart mindre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Slippage kann bedeuten, dass du merklich weniger erhältst."
