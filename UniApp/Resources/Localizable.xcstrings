          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقّع Aperture على هذا على جهاز iPhone الخاص بك ويبثّه إلى الشبكة. بمجرد إرساله، لا يمكن عكسه."
          }
        },
        "bg": {
