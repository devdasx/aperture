    "Per-asset URLs and licenses live in the project at Assets.xcassets/README.md — every shipped image has audit provenance recorded there.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "URL's en lisensies per bate is in die projek by Assets.xcassets/README.md — die herkoms wat geoudit kan word, is daar vir elke gestuurde beeld aangeteken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوفر روابط وتراخيص كل أصل في المشروع داخل Assets.xcassets/README.md — كل صورة منشورة لها مصدرها الموثّق هناك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "URL адресите и лицензите за всеки актив са в проекта в Assets.xcassets/README.md — за всяко изпратено изображение там е записан проследим източник."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি অ্যাসেটের URL ও লাইসেন্স প্রজেক্টের Assets.xcassets/README.md-এ আছে — শিপ করা প্রতিটি ছবির অডিট প্রভেন্যান্স সেখানে রেকর্ড করা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les URL i les llicències per recurs es troben al projecte a Assets.xcassets/README.md — cada imatge inclosa hi té la procedència auditable registrada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "URL adresy a licence jednotlivých assetů jsou v projektu v Assets.xcassets/README.md — u každého dodaného obrázku je tam zaznamenán auditovatelný původ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "URL'er og licenser per ressource ligger i projektet i Assets.xcassets/README.md — hvert leveret billede har sin reviderbare oprindelse registreret der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URLs und Lizenzen pro Asset befinden sich im Projekt unter Assets.xcassets/README.md — jedes ausgelieferte Bild hat dort eine prüfbare Herkunft hinterlegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διευθύνσεις URL και οι άδειες ανά πόρο βρίσκονται στο έργο, στο Assets.xcassets/README.md — κάθε εικόνα που αποστέλλεται έχει εκεί καταγεγραμμένη ελέγξιμη προέλευση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-asset URLs and licenses live in the project at Assets.xcassets/README.md — every shipped image has audit provenance recorded there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las URL y licencias de cada recurso están en el proyecto en Assets.xcassets/README.md — toda imagen incluida tiene allí su procedencia auditable."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga varaobjekti URL-id ja litsentsid asuvad projektis failis Assets.xcassets/README.md — iga tarnitud pildi auditeeritav päritolu on seal kirjas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آدرس‌ها و مجوزها به‌ازای هر دارایی در پروژه در Assets.xcassets/README.md قرار دارند — منشأ قابل ممیزی هر تصویر ارسال‌شده در آنجا ثبت شده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunkin resurssin URL-osoitteet ja lisenssit ovat projektissa polussa Assets.xcassets/README.md — jokaisen toimitetun kuvan tarkastettava alkuperä on siellä kirjattu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga per-asset URL at lisensya ay nasa proyekto sa Assets.xcassets/README.md — bawat ipinadalang larawan ay may audit provenance na naitala doon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les URL et licences par actif se trouvent dans le projet à Assets.xcassets/README.md — chaque image livrée y a sa provenance auditable consignée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתובות ה-URL והרישיונות לכל נכס נמצאים בפרויקט תחת Assets.xcassets/README.md — לכל תמונה שמסופקת מתועד שם מקור הניתן לביקורת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर एसेट की URL और लाइसेंस प्रोजेक्ट में Assets.xcassets/README.md पर हैं — हर शिप की गई इमेज की ऑडिट प्रोवेनेंस वहाँ दर्ज है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-ovi i licence po resursu nalaze se u projektu na Assets.xcassets/README.md — svaka isporučena slika ima ondje zabilježeno provjerljivo podrijetlo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyes eszközök URL-jei és licencei a projektben az Assets.xcassets/README.md-ben találhatók — minden kiszállított képnek itt van rögzítve az auditálható eredete."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "URL dan lisensi per aset berada di proyek di Assets.xcassets/README.md — setiap gambar yang dikirim memiliki asal-usul yang dapat diaudit tercatat di sana."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Slóðir og leyfi fyrir hverja eign eru í verkefninu í Assets.xcassets/README.md — uppruni hverrar sendrar myndar er þar skráður."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli URL e le licenze per asset sono nel progetto in Assets.xcassets/README.md — la provenienza verificabile di ogni immagine spedita è registrata lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アセットの URL とライセンスはプロジェクトの Assets.xcassets/README.md に記載されており、収録されたすべての画像について、そこで監査可能な出所が記録されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산별 URL과 라이선스는 프로젝트의 Assets.xcassets/README.md에 있습니다 — 출시된 모든 이미지의 감사 추적이 그곳에 기록되어 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Konkretaus turto URL ir licencijos yra projekte faile Assets.xcassets/README.md — kiekvieno išsiųsto vaizdo audituojama kilmė yra ten užfiksuota."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "URL un licences pa aktīviem atrodas projektā failā Assets.xcassets/README.md — katra piegādātā attēla auditējamā izcelsme tur ir reģistrēta."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ അസെറ്റിന്റെയും URL-കളും ലൈസൻസുകളും പ്രോജക്ടിൽ Assets.xcassets/README.md-ൽ ഉണ്ട് — അയച്ച ഓരോ ചിത്രത്തിന്റെയും ഓഡിറ്റ് ചെയ്യാവുന്ന ഉറവിടം അവിടെ രേഖപ്പെടുത്തിയിട്ടുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति-असेट URLs आणि परवाने प्रकल्पात Assets.xcassets/README.md मध्ये असतात — पाठवलेल्या प्रत्येक प्रतिमेची ऑडिट करता येणारी मूळ माहिती तिथे नोंदवली आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "URL dan lesen setiap aset berada dalam projek di Assets.xcassets/README.md — setiap imej yang dihantar mempunyai asal usul audit yang direkodkan di sana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-er og lisenser per ressurs ligger i prosjektet under Assets.xcassets/README.md — hvert leverte bilde har der dokumentert opphav som kan revideres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL's en licenties per asset staan in het project in Assets.xcassets/README.md — van elke geleverde afbeelding is daar de herkomst vastgelegd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਤੀ-ਅਸਾਸਾ URLs ਅਤੇ ਲਾਇਸੰਸ ਪ੍ਰੋਜੈਕਟ ਵਿੱਚ Assets.xcassets/README.md 'ਤੇ ਹਨ — ਭੇਜੀ ਗਈ ਹਰ ਤਸਵੀਰ ਦਾ ਆਡਿਟ ਕੀਤਾ ਜਾਣ ਵਾਲਾ ਸਰੋਤ ਉੱਥੇ ਦਰਜ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresy URL i licencje poszczególnych zasobów znajdują się w projekcie w Assets.xcassets/README.md — pochodzenie każdego dostarczonego obrazu jest tam udokumentowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As URLs e licenças de cada recurso ficam no projeto em Assets.xcassets/README.md — toda imagem incluída tem ali sua procedência auditável."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-urile și licențele fiecărui activ se află în proiect, în Assets.xcassets/README.md — fiecare imagine livrată are acolo proveniența auditabilă înregistrată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки и лицензии каждого ресурса находятся в проекте в Assets.xcassets/README.md — у каждой включённой картинки там записано аудируемое происхождение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL adresy a licencie jednotlivých assetov sú v projekte v Assets.xcassets/README.md — pri každom dodanom obrázku je tam zaznamenaný auditovateľný pôvod."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-ji in licence posameznih sredstev so v projektu v datoteki Assets.xcassets/README.md — vsaka priložena slika ima tam zabeleženo preverljivo izvor."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-ови и лиценце по средству налазе се у пројекту у Assets.xcassets/README.md — свака испоручена слика тамо има забележено проверљиво порекло."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "URL:er och licenser per resurs finns i projektet i Assets.xcassets/README.md — varje levererad bild har sin granskningsbara härkomst registrerad där."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "URL na leseni za kila rasilimali zipo katika mradi katika Assets.xcassets/README.md — kila picha iliyotumwa ina chanzo cha kukaguliwa kilichohifadhiwa hapo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு ஆதார URL மற்றும் உரிமமும் திட்டத்தில் Assets.xcassets/README.md-ல் உள்ளன — அனுப்பப்பட்ட ஒவ்வொரு படத்திற்கும் தணிக்கை மூலம் சரிபார்க்கக்கூடிய மூலம் அங்கு பதிவு செய்யப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక్కో ఆస్తికి URLలు మరియు లైసెన్స్‌లు ప్రాజెక్ట్‌లో Assets.xcassets/README.md వద్ద ఉంటాయి — పంపిన ప్రతి చిత్రానికి ఆడిట్ చేయదగిన మూలం అక్కడ నమోదైంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "URL และใบอนุญาตของแต่ละแอสเซ็ตอยู่ในโปรเจกต์ที่ Assets.xcassets/README.md — ทุกภาพที่ส่งมีบันทึกที่มาที่ตรวจสอบได้ที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlık başına URL'ler ve lisanslar projede Assets.xcassets/README.md dosyasında bulunur — gönderilen her görselin denetlenebilir kaynak bilgisi orada kayıtlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання та ліцензії кожного ресурсу містяться в проєкті за шляхом Assets.xcassets/README.md — для кожного включеного зображення там записане аудиторське походження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فی اثاثہ URLs اور لائسنس پروجیکٹ میں Assets.xcassets/README.md پر موجود ہیں — ہر شپ کی گئی تصویر کا آڈٹ قابل ماخذ وہاں درج ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL và giấy phép của từng tài sản nằm trong dự án tại Assets.xcassets/README.md — mọi hình ảnh được phát hành đều có nguồn gốc được ghi lại ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个素材的 URL 和许可证都记录在项目的 Assets.xcassets/README.md 中 — 每一张随版本发布的图片都在那里留有可审计的来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個素材的 URL 和授權都記錄在專案的 Assets.xcassets/README.md 中 — 每一張隨版本發布的圖片都在那裡留有可稽核的來源。"
          }
        }
      }
    },
