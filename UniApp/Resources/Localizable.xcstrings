    "SVG only \\u{00B7} keep it simple and single-shape for best results.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG فقط \\u{00B7} للحصول على أفضل النتائج، اجعله بسيطاً وبشكل واحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু SVG \\u{00B7} সেরা ফলাফলের জন্য সহজ এবং একক-আকার রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només SVG \\u{00B7} mantén-lo senzill i d’una sola forma per obtenir-ne els millors resultats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze SVG \\u{00B7} pro nejlepší výsledek ho udržujte jednoduchý a tvořený jedním tvarem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun SVG \\u{00B7} hold det enkelt og som én form for bedste resultat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur SVG \\u{00B7} halte es einfach und einformig für die besten Ergebnisse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο SVG \\u{00B7} κρατήστε το απλό και με μία φόρμα για καλύτερα αποτελέσματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG only \\u{00B7} keep it simple and single-shape for best results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo SVG \\u{00B7} para mejores resultados, manténlo simple y de una sola figura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط SVG \\u{00B7} برای بهترین نتیجه آن را ساده و تک‌شکل نگه دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain SVG \\u{00B7} pidä se yksinkertaisena ja yhden muodon näköisenä parhaiden tulosten saamiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG uniquement \\u{00B7} restez simple et sur une seule forme pour de meilleurs résultats."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏SVG בלבד \\u{00B7} כדאי לשמור על פשטות ועל צורה אחת לתוצאות מיטביות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल SVG \\u{00B7} सबसे अच्छे परिणाम के लिए इसे सरल और सिंगल-शेप रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo SVG \\u{00B7} za najbolje rezultate neka bude jednostavan i jednog oblika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak SVG \\u{00B7} a legjobb eredményhez tartsd egyszerűnek és egyetlen alakzatból állónak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya SVG \\u{00B7} buat sederhana dan satu bentuk untuk hasil terbaik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo SVG \\u{00B7} lo mantenga semplice e con una sola forma per risultati ottimali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG のみ \\u{00B7} 最良の結果を得るため、シンプルで単一形状にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG만 가능 \\u{00B7} 최상의 결과를 위해 단순하고 단일 도형으로 유지하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare SVG \\u{00B7} hold det enkelt og med én form for best resultat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen SVG \\u{00B7} houd het simpel en uit één vorm voor het beste resultaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko SVG \\u{00B7} dla najlepszych efektów zachowaj prostotę i jeden kształt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente SVG \\u{00B7} para obter melhores resultados, deixe simples e com forma única."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar SVG \\u{00B7} pentru rezultate optime păstrează-l simplu și cu o singură formă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только SVG \\u{00B7} для лучшего результата держите его простым и из одной фигуры."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba SVG \\u{00B7} pre najlepšie výsledky ho udržujte jednoduchý a tvorený jediným tvarom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo SVG \\u{00B7} za najboljše rezultate naj bo preprost in iz ene oblike."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Само SVG \\u{00B7} за најбоље резултате нека буде једноставан и од једног облика."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast SVG \\u{00B7} håll det enkelt och med en form för bästa resultat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG เท่านั้น \\u{00B7} ทำให้เรียบง่ายและเป็นรูปทรงเดียวเพื่อผลลัพธ์ที่ดีที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca SVG \\u{00B7} en iyi sonuç için sade ve tek şekilli tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише SVG \\u{00B7} для найкращого результату нехай він буде простим і складається з однієї фігури."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ SVG \\u{00B7} hãy giữ đơn giản và một hình duy nhất để có kết quả tốt nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持 SVG \\u{00B7} 保持简洁、单一形状以获得最佳效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅支援 SVG \\u{00B7} 為求最佳效果,請保持簡潔且為單一形狀。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف SVG \\u{00B7} بہترین نتائج کے لیے اسے سادہ اور واحد-شکل رکھیں۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само SVG \\u{00B7} за най-добри резултати го запазете прост и с една форма."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult SVG \\u{00B7} parima tulemuse saamiseks hoia see lihtne ja ühe kujundiga."
