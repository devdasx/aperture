    "Show transaction-history amounts in your local currency. Turn off to show the native coin amount instead.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys die bedrae in jou transaksiegeskiedenis in jou plaaslike geldeenheid. Skakel af om eerder die bedrag in die muntstuk self te wys."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض مبالغ سجل المعاملات بعملتك المحلية. أوقف التشغيل لعرض مبلغ العملة الأصلية بدلًا من ذلك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показва сумите в историята на транзакциите в местната ви валута. Изключете, за да виждате вместо това сумата в самата криптовалута."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেনের ইতিহাসের পরিমাণ আপনার স্থানীয় মুদ্রায় দেখান। পরিবর্তে মূল কয়েনের পরিমাণ দেখাতে এটি বন্ধ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els imports de l'historial de transaccions en la teva moneda local. Desactiva-ho per mostrar l'import en la moneda nativa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí částky v historii transakcí ve vaší místní měně. Vypnutím zobrazíte místo toho částku v nativní minci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis beløbene i transaktionshistorikken i din lokale valuta. Slå fra for at vise beløbet i den oprindelige valuta i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Beträge im Transaktionsverlauf in Ihrer lokalen Währung an. Deaktivieren Sie diese Option, um stattdessen den Betrag in der nativen Münze anzuzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση των ποσών του ιστορικού συναλλαγών στο τοπικό σας νόμισμα. Απενεργοποιήστε το για να εμφανίζεται το ποσό στο εγγενές νόμισμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show transaction-history amounts in your local currency. Turn off to show the native coin amount instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los importes del historial de transacciones en tu moneda local. Desactívalo para mostrar el importe en la moneda nativa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvab tehinguajaloo summad sinu kohalikus vääringus. Lülita välja, et kuvada selle asemel summa mündi enda ühikus."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مبالغ تاریخچهٔ تراکنش‌ها را به ارز محلی شما نمایش می‌دهد. برای نمایش مبلغ به واحد ارز اصلی، آن را خاموش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tapahtumahistorian summat paikallisessa valuutassasi. Poista käytöstä, jos haluat näyttää summan alkuperäisessä valuutassa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ang mga halaga sa history ng transaksyon sa iyong lokal na pera. I-off para ipakita ang halaga sa mismong unit ng coin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les montants de l’historique des transactions dans votre devise locale. Désactivez pour afficher le montant dans la cryptomonnaie d’origine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת הסכומים בהיסטוריית העסקאות במטבע המקומי שלך. כבה כדי להציג במקום זאת את הסכום במטבע המקורי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन इतिहास की राशियाँ आपकी स्थानीय मुद्रा में दिखाएँ। इसके बजाय मूल सिक्के की राशि दिखाने के लिए इसे बंद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikažite iznose u povijesti transakcija u svojoj lokalnoj valuti. Isključite kako biste umjesto toga prikazali iznos u izvornoj valuti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tranzakciós előzmények összegeit a helyi pénznemében jeleníti meg. Kapcsolja ki, ha helyette az eredeti érme összegét szeretné megjeleníteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan jumlah pada riwayat transaksi dalam mata uang lokal Anda. Matikan untuk menampilkan jumlah dalam satuan koin aslinya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sýnir upphæðir í færslusögunni í þínum staðargjaldmiðli. Slökktu til að sýna upphæðina í myntinni sjálfri í staðinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli importi della cronologia transazioni nella tua valuta locale. Disattiva per mostrare invece l’importo nella criptovaluta originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引履歴の金額を現地通貨で表示します。オフにすると、元の通貨の金額を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래 내역의 금액을 현지 통화로 표시합니다. 끄면 해당 코인 단위의 금액으로 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodo operacijų istorijos sumas jūsų vietine valiuta. Išjunkite, kad vietoj to būtų rodoma suma pačios monetos vienetais."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rāda darījumu vēstures summas jūsu vietējā valūtā. Izslēdziet, lai tā vietā rādītu summu pašas monētas vienībās."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇടപാട് ചരിത്രത്തിലെ തുകകൾ നിങ്ങളുടെ പ്രാദേശിക കറൻസിയിൽ കാണിക്കുന്നു. പകരം നാണയത്തിന്റെ സ്വന്തം യൂണിറ്റിൽ തുക കാണിക്കാൻ ഇത് ഓഫ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवहार इतिहासातील रकमा तुमच्या स्थानिक चलनात दाखवते. त्याऐवजी नाण्याच्या स्वतःच्या एककात रक्कम दाखवण्यासाठी हे बंद करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan jumlah dalam sejarah transaksi dengan mata wang tempatan anda. Matikan untuk memaparkan jumlah dalam unit syiling asalnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis beløpene i transaksjonshistorikken i din lokale valuta. Slå av for å vise beløpet i den opprinnelige valutaen i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de bedragen in je transactiegeschiedenis in je lokale valuta. Zet uit om in plaats daarvan het bedrag in de munt zelf te tonen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੈਣ-ਦੇਣ ਇਤਿਹਾਸ ਦੀਆਂ ਰਕਮਾਂ ਤੁਹਾਡੀ ਸਥਾਨਕ ਮੁਦਰਾ ਵਿੱਚ ਦਿਖਾਉਂਦਾ ਹੈ। ਇਸ ਦੀ ਥਾਂ ਰਕਮ ਨੂੰ ਕੋਇਨ ਦੀ ਆਪਣੀ ਇਕਾਈ ਵਿੱਚ ਦਿਖਾਉਣ ਲਈ ਇਸਨੂੰ ਬੰਦ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje kwoty w historii transakcji w Twojej walucie lokalnej. Wyłącz, aby zamiast tego pokazać kwotę w jednostce danej kryptowaluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os valores do histórico de transações na sua moeda local. Desative para mostrar o valor na moeda nativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează sumele din istoricul tranzacțiilor în moneda dumneavoastră locală. Dezactivați pentru a afișa în schimb suma în moneda nativă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать суммы в истории транзакций в вашей местной валюте. Отключите, чтобы вместо этого показывать сумму в собственной монете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí sumy v histórii transakcií vo vašej miestnej mene. Vypnutím zobrazíte namiesto toho sumu v natívnej minci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže zneske v zgodovini transakcij v vaši lokalni valuti. Izklopite, če želite namesto tega prikazati znesek v izvirni valuti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Приказује износе у историји трансакција у вашој локалној валути. Искључите да бисте уместо тога приказали износ у изворној валути."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa beloppen i transaktionshistoriken i din lokala valuta. Stäng av för att visa beloppet i den ursprungliga valutan i stället."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huonyesha kiasi katika historia ya miamala kwa sarafu ya eneo lako. Zima ili kuonyesha kiasi katika sarafu ya msingi badala yake."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனை வரலாற்றில் உள்ள தொகைகளை உங்கள் உள்ளூர் நாணயத்தில் காட்டும். அதற்குப் பதிலாக நாணயத்தின் சொந்த அலகில் தொகையைக் காட்ட இதை அணைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లావాదేవీ చరిత్రలోని మొత్తాలను మీ స్థానిక కరెన్సీలో చూపుతుంది. బదులుగా కాయిన్ స్వంత యూనిట్‌లో మొత్తాన్ని చూపడానికి దీన్ని ఆఫ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงจำนวนเงินในประวัติธุรกรรมเป็นสกุลเงินท้องถิ่นของคุณ ปิดเพื่อแสดงจำนวนเป็นหน่วยเหรียญดั้งเดิมแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem geçmişindeki tutarları yerel para biriminizde gösterir. Bunun yerine tutarı kendi kripto biriminde göstermek için kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати суми в історії транзакцій у вашій місцевій валюті. Вимкніть, щоб натомість показувати суму у власній монеті."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانزیکشن کی تاریخ میں رقوم آپ کی مقامی کرنسی میں دکھاتا ہے۔ اس کے بجائے رقم کوائن کی اپنی اکائی میں دکھانے کے لیے اسے بند کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị số tiền trong lịch sử giao dịch theo nội tệ của bạn. Tắt để hiển thị số tiền theo đơn vị đồng coin gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在交易历史中以本地货币显示金额。关闭后将改为显示原生币种金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在交易紀錄中以當地貨幣顯示金額。關閉後將改為顯示原生幣種金額。"
          }
        }
      }
    },
