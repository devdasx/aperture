        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla la chiave del tuo account %@. Aperture verifica il formato prima di derivare qualsiasi indirizzo, e la chiave non lascia mai questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの %@ アカウントの鍵を貼り付けてください。Aperture はアドレスを導き出す前に形式を確認します。鍵がこの iPhone の外へ出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 계정의 키를 붙여넣으세요. Aperture는 주소를 도출하기 전에 형식을 확인하며, 키는 이 iPhone을 절대 떠나지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijuokite raktą savo %@ paskyrai. Aperture patikrina formatą prieš išvesdamas bet kokį adresą, o raktas niekada nepalieka šio iPhone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielīmējiet sava %@ konta atslēgu. Aperture pārbauda formātu, pirms tiek atvasināta kāda adrese, un atslēga nekad neatstāj šo iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ %@ അക്കൗണ്ടിന്റെ കീ പേസ്റ്റ് ചെയ്യുക. ഏതെങ്കിലും വിലാസം ഉരുത്തിരിക്കുന്നതിന് മുമ്പ് Aperture ഫോർമാറ്റ് പരിശോധിക്കുന്നു, കീ ഈ iPhone വിട്ടുപോകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या %@ खात्यासाठी की पेस्ट करा. कोणताही पत्ता मिळवण्यापूर्वी Aperture फॉरमॅट तपासते, आणि की हा iPhone कधीही सोडत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal kunci untuk akaun %@ anda. Aperture menyemak format sebelum menerbitkan sebarang alamat, dan kunci tidak pernah meninggalkan iPhone ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn nøkkelen for %@-kontoen din. Aperture sjekker formatet før den utleder noen adresse, og nøkkelen forlater aldri denne iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak de sleutel voor je %@-account. Aperture controleert het formaat voordat er een adres wordt afgeleid en de sleutel verlaat deze iPhone nooit."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ %@ ਖਾਤੇ ਲਈ ਕੀ ਪੇਸਟ ਕਰੋ। ਕੋਈ ਵੀ ਪਤਾ ਬਣਾਉਣ ਤੋਂ ਪਹਿਲਾਂ Aperture ਉਸ ਦਾ ਫਾਰਮੈਟ ਜਾਂਚਦਾ ਹੈ, ਅਤੇ ਉਹ ਕੀ ਕਦੇ ਵੀ ਇਸ iPhone ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej klucz dla swojego konta %@. Aperture sprawdza format przed wyprowadzeniem jakiegokolwiek adresu, a klucz nigdy nie opuszcza tego iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole a chave da sua conta %@. O Aperture confere o formato antes de derivar qualquer endereço, e a chave nunca sai deste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește cheia pentru contul tău %@. Aperture verifică formatul înainte de a deriva orice adresă, iar cheia nu părăsește niciodată acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ключ для вашего счёта %@. Aperture проверяет формат, прежде чем вывести любой адрес, и ключ никогда не покидает этот iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlož kľúč pre svoj účet %@. Aperture skontroluje formát pred odvodením akejkoľvek adresy a kľúč nikdy neopustí tento iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilepi ključ za svoj račun %@. Aperture preveri obliko, preden izpelje kakršen koli naslov, in ključ nikoli ne zapusti tega iPhona."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налепи кључ свог %@ налога. Aperture проверава формат пре извођења било које адресе, а кључ никад не напушта овај iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in nyckeln för ditt %@-konto. Aperture kontrollerar formatet innan någon adress härleds, och nyckeln lämnar aldrig denna iPhone."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandika ufunguo wa akaunti yako ya %@. Aperture inakagua muundo kabla ya kupata anwani yoyote, na ufunguo hauondoki kamwe kwenye iPhone hii."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் %@ கணக்கிற்கான சாவியை ஒட்டவும். எந்த முகவரியையும் பெறுவதற்கு முன்பு Aperture வடிவத்தைச் சரிபார்க்கிறது, சாவி இந்த iPhone-ஐ விட்டு வெளியேறுவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ %@ ఖాతా కోసం కీని పేస్ట్ చేయండి. ఏ చిరునామాను పొందే ముందు Aperture ఫార్మాట్‌ను తనిఖీ చేస్తుంది, మరియు కీ ఈ iPhone-ను వదిలి వెళ్ళదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางคีย์สำหรับบัญชี %@ ของคุณ Aperture จะตรวจสอบรูปแบบก่อนสืบหาแอดเดรสใด ๆ และคีย์จะไม่ออกจาก iPhone เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hesabınız için anahtarı yapıştırın. Aperture herhangi bir adresi türetmeden önce biçimi denetler ve anahtar bu iPhone'dan asla ayrılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте ключ для вашого облікового запису %@. Aperture перевіряє формат перед виведенням будь-якої адреси, і ключ ніколи не залишає цей iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے %@ اکاؤنٹ کی کی پیسٹ کریں۔ Aperture کسی بھی ایڈریس کو اخذ کرنے سے پہلے اس کا فارمیٹ جانچتا ہے، اور یہ کی کبھی اس iPhone سے باہر نہیں جاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán khóa cho tài khoản %@ của bạn. Aperture kiểm tra định dạng trước khi dẫn ra bất kỳ địa chỉ nào, và khóa không bao giờ rời khỏi chiếc iPhone này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你 %@ 账户的密钥。Aperture 会先校验格式再推导任何地址,密钥不会离开这部 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你 %@ 帳戶的金鑰。Aperture 會先檢查格式再推導任何位址,金鑰不會離開這部 iPhone。"
          }
        }
      }
    },
