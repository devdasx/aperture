          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытые сети по-прежнему поддерживаются — изменяется только представление этого актива."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryté siete sú naďalej podporované — ovplyvnené je iba zobrazenie tohto aktíva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
