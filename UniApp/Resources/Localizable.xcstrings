          "stringUnit": {
            "state": "translated",
            "value": "এটি বাতিল করা যায় না। যে ওয়ালেটগুলো আপনি ব্যাকআপ করেননি সেগুলো হারিয়ে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això no es pot desfer. Les carteres de les quals no hagis fet còpia de seguretat es perdran."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle nelze vrátit zpět. Peněženky, které jste nezálohovali, budou ztraceny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke fortrydes. Tegnebøger, du ikke sikkerhedskopierede, vil gå tabt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann nicht rückgängig gemacht werden. Wallets, die du nicht gesichert hast, gehen verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν μπορεί να αναιρεθεί. Τα πορτοφόλια για τα οποία δεν κρατήσατε αντίγραφο ασφαλείας θα χαθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone. Wallets you didn't back up will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Las carteras de las que no hiciste copia de seguridad se perderán."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda ei saa tagasi võtta. Rahakotid, mida te varundasite, lähevad kaduma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این قابل بازگشت نیست. کیف پول‌هایی که پشتیبان نگرفته‌اید از دست خواهند رفت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ei voi perua. Lompakot, joita et varmuuskopioinut, menetetään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ito maibabalik. Mawawala ang mga wallet na hindi mo na-back up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est irréversible. Les portefeuilles que vous n'avez pas sauvegardés seront perdus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לבטל זאת. ארנקים שלא גיבית יאבדו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पूर्ववत नहीं किया जा सकता। जिन वॉलेट का आपने बैकअप नहीं लिया वे खो जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo se ne može poništiti. Novčanici koje niste sigurnosno kopirali bit će izgubljeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem vonható vissza. A nem mentett tárcák elvesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak dapat dibatalkan. Dompet yang tidak Anda cadangkan akan hilang."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki er hægt að afturkalla þetta. Veski sem þú tókst ekki afrit af glatast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione non può essere annullata. I wallet di cui non hai fatto il backup andranno persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは取り消せません。バックアップしていないウォレットは失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없습니다. 백업하지 않은 지갑은 손실됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "To atšaukti negalima. Piniginės, kurių nepasidarėte atsarginės kopijos, bus prarastos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "To nevar atsaukt. Maki, kurus nedublējāt, tiks zaudēti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് പിൻവലിക്കാനാവില്ല. നിങ്ങൾ ബാക്കപ്പ് ചെയ്യാത്ത വാലറ്റുകൾ നഷ്ടപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे पूर्ववत करता येत नाही. तुम्ही बॅकअप न घेतलेली वॉलेट गमावली जातील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak boleh dibatalkan. Dompet yang tidak anda sandarkan akan hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke angres. Lommebøker du ikke sikkerhetskopierte vil gå tapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt. Wallets zonder back-up gaan verloren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸਨੂੰ ਵਾਪਸ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ। ਜਿਹੜੇ ਵਾਲਿਟ ਤੁਸੀਂ ਬੈਕਅੱਪ ਨਹੀਂ ਕੀਤੇ ਉਹ ਗੁਆਚ ਜਾਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego nie da się cofnąć. Portfele bez kopii zapasowej zostaną utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode ser desfeito. Carteiras das quais você não fez backup serão perdidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta nu poate fi anulată. Portofelele pe care nu le-ai salvat vor fi pierdute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить. Кошельки без резервной копии будут потеряны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto sa nedá vrátiť. Peňaženky, ktoré ste nezálohovali, sa stratia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega ni mogoče razveljaviti. Denarnice, ki jih niste varnostno kopirali, bodo izgubljene."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo se ne može poništiti. Novčanici koje niste rezervisali biće izgubljeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kan inte ångras. Plånböcker du inte säkerhetskopierade kommer att gå förlorade."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii haiwezi kutenguliwa. Wallet ambazo hukuzihifadhi nakala rudufu zitapotea."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை மாற்ற முடியாது. நீங்கள் காப்புப்பிரதி எடுக்காத வாலட்கள் இழக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీన్ని రద్దు చేయలేరు. మీరు బ్యాకప్ చేయని వాలెట్‌లు పోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้ไม่สามารถย้อนกลับได้ กระเป๋าเงินที่คุณไม่ได้สำรองไว้จะสูญหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geri alınamaz. Yedeklemediğiniz cüzdanlar kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це неможливо скасувати. Гаманці, які ви не зберегли в резервній копії, буде втрачено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے واپس نہیں کیا جا سکتا۔ جن والیٹس کا بیک اپ آپ نے نہیں لیا وہ ضائع ہو جائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này không thể hoàn tác. Các ví bạn chưa sao lưu sẽ bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。你未备份的钱包将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法復原。你未備份的錢包將會遺失。"
          }
        }
      }
    },
    "This clears every filter and sort choice for asset details. Continue?": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vee elke filter- en sorteerkeuse vir batebesonderhede uit. Gaan voort?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يمسح كل خيارات التصفية والفرز لتفاصيل الأصل. هل تريد المتابعة؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това изчиства всеки избор на филтър и сортиране за подробностите за актива. Продължаване?"
