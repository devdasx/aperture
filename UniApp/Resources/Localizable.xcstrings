    "Your balance changes will appear here as transactions confirm on-chain.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou saldoveranderings sal hier verskyn soos transaksies op-ketting bevestig word."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر تغييرات رصيدك هنا عند تأكيد المعاملات على السلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промените на баланса ще се появят тук, когато транзакциите се потвърдят в мрежата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেন অন-চেইনে নিশ্চিত হওয়ার সাথে সাথে আপনার ব্যালেন্সের পরিবর্তন এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els canvis del teu saldo apareixeran aquí a mesura que les transaccions es confirmin a la cadena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny zůstatku se zde zobrazí, jakmile budou transakce potvrzeny v řetězci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoændringer vises her, efterhånden som transaktionerne bekræftes i kæden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoänderungen erscheinen hier, sobald Transaktionen On-Chain bestätigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μεταβολές του υπολοίπου σας θα εμφανίζονται εδώ καθώς οι συναλλαγές επιβεβαιώνονται στην αλυσίδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your balance changes will appear here as transactions confirm on-chain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de tu saldo aparecerán aquí a medida que las transacciones se confirmen en la cadena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo muutused ilmuvad siia, kui tehingud ahelas kinnitatakse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییرات موجودی شما همین‌جا نمایش داده می‌شود وقتی تراکنش‌ها روی زنجیره تأیید شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldosi muutokset näkyvät tässä sitä mukaa kuin tapahtumat vahvistuvat ketjussa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga pagbabago sa balanse mo habang nagko-confirm ang mga transaksyon sa chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos changements de solde apparaîtront ici à mesure que les transactions sont confirmées sur la chaîne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינויי היתרה שלך יופיעו כאן ככל שהעסקאות יאושרו ברשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे-जैसे लेन-देन ऑन-चेन पुष्ट होते जाएँगे, आपकी शेष राशि के बदलाव यहाँ दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene stanja prikazivat će se ovdje kako se transakcije potvrđuju u lancu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyenleged változásai itt jelennek meg, ahogy a tranzakciók megerősítést kapnak a láncon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan saldo akan muncul di sini saat transaksi dikonfirmasi di rantai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Breytingar á jafnstöðu birtast hér eftir því sem færslur staðfestast á keðjunni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variazioni del saldo appariranno qui man mano che le transazioni vengono confermate on-chain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引がオンチェーンで承認されると、残高の変化がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온체인에서 거래가 확정되면 잔액 변화가 여기 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Likučio pokyčiai pasirodys čia, kai operacijos bus patvirtintos grandinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlikuma izmaiņas parādīsies šeit, tiklīdz darījumi tiks apstiprināti ķēdē."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇടപാടുകൾ ഓൺ-ചെയിനിൽ സ്ഥിരീകരിക്കുമ്പോൾ നിങ്ങളുടെ ബാലൻസ് മാറ്റങ്ങൾ ഇവിടെ ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवहार ऑन-चेन पुष्ट होताच तुमच्या शिल्लकीतील बदल येथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan baki akan muncul di sini apabila transaksi disahkan dalam rantai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoendringene vises her etter hvert som transaksjoner bekreftes på kjeden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veranderingen in je saldo verschijnen hier zodra transacties on-chain worden bevestigd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਲੈਣ-ਦੇਣ ਆਨ-ਚੇਨ ਪੁਸ਼ਟ ਹੋਣਗੇ ਤਾਂ ਤੁਹਾਡੇ ਬਕਾਇਆ ਵਿੱਚ ਤਬਦੀਲੀਆਂ ਇੱਥੇ ਦਿਖਾਈ ਦੇਣਗੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany salda pojawią się tutaj, gdy transakcje zostaną potwierdzone w łańcuchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações do seu saldo aparecerão aqui à medida que as transações forem confirmadas na blockchain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările soldului tău vor apărea aici pe măsură ce tranzacțiile sunt confirmate pe blockchain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения баланса будут появляться здесь по мере подтверждения транзакций в сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeny zostatku sa zobrazia tu, len čo budú transakcie potvrdené v reťazci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremembe stanja se bodo prikazale tukaj, ko se transakcije potrdijo v verigi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Промене стања ће се појавити овде како се трансакције потврђују на ланцу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoändringarna visas här när transaktionerna bekräftas på kedjan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabadiliko ya salio yako yataonekana hapa kadiri muamala unavyothibitishwa kwenye mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனைகள் சங்கிலியில் உறுதிப்படுத்தப்படும் போது உங்கள் மீதி மாற்றங்கள் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లావాదేవీలు ఆన్-చైన్‌లో నిర్ధారించబడినప్పుడు మీ నిల్వ మార్పులు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงยอดคงเหลือจะปรากฏที่นี่เมื่อธุรกรรมได้รับการยืนยันบนเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler zincir üzerinde onaylandıkça bakiye değişiklikleriniz burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни балансу з’являтимуться тут у міру підтвердження транзакцій у мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بیلنس میں تبدیلیاں یہاں ظاہر ہوں گی جیسے ہی لین دین آن چین تصدیق پائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi số dư của bạn sẽ xuất hiện ở đây khi giao dịch được xác nhận trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当交易在链上确认后,余额变化将显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當交易在鏈上確認後,餘額變化會顯示在此處。"
          }
        }
      }
    },
    "Your balances will appear once Aperture can reach the chains.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou saldo's verskyn sodra Aperture die kettings kan bereik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر أرصدتك بمجرد أن يتمكّن Aperture من الوصول إلى الشبكات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансите Ви ще се покажат, щом Aperture успее да достигне веригите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture চেইনগুলোতে পৌঁছাতে পারলেই আপনার ব্যালেন্স দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus saldos apareixeran quan Aperture pugui connectar amb les cadenes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zůstatky se zobrazí, jakmile se Aperture připojí k sítím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine saldi vises, så snart Aperture kan nå kæderne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Guthaben werden angezeigt, sobald Aperture die Chains erreichen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα υπόλοιπά σας θα εμφανιστούν μόλις το Aperture μπορέσει να συνδεθεί στις αλυσίδες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your balances will appear once Aperture can reach the chains."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus saldos aparecerán cuando Aperture pueda conectar con las cadenas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu saldod kuvatakse niipea, kui Aperture jõuab ahelateni."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودی شما به‌محض اینکه Aperture بتواند به زنجیره‌ها دسترسی پیدا کند نمایش داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldosi näkyvät heti, kun Aperture saa yhteyden ketjuihin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas ang iyong mga balanse kapag naabot na ng Aperture ang mga chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos soldes s’afficheront dès qu’Aperture pourra joindre les chaînes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היתרות שלך יופיעו ברגע ש-Aperture יוכל להתחבר לרשתות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Aperture चेन तक पहुँच सकेगा, तब आपका बैलेंस दिखाई देगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša stanja prikazat će se čim se Aperture poveže s lancima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyenlegei megjelennek, amint az Aperture eléri a láncokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo Anda akan muncul setelah Aperture dapat menjangkau rantai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstæður þínar birtast um leið og Aperture nær til keðjanna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi saldi appariranno non appena Aperture potrà raggiungere le catene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture がチェーンに接続できると、残高が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture가 체인에 연결되면 잔액이 표시돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų likučiai bus rodomi, kai Aperture pasieks grandines."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu atlikumi parādīsies, tiklīdz Aperture varēs sasniegt ķēdes."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-ന് ചെയിനുകളിലേക്ക് എത്താനായാൽ ഉടൻ നിങ്ങളുടെ ബാലൻസുകൾ കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture चेनशी संपर्क करू शकल्यावर तुमची शिल्लक दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baki anda akan dipaparkan sebaik sahaja Aperture dapat menghubungi rangkaian rantai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoene dine vises så snart Aperture når kjedene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je saldi verschijnen zodra Aperture de chains kan bereiken."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਬਕਾਏ ਉਦੋਂ ਦਿਖਣਗੇ ਜਦੋਂ Aperture ਚੇਨਾਂ ਤੱਕ ਪਹੁੰਚ ਸਕੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda pojawią się, gdy Aperture połączy się z łańcuchami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus saldos aparecerão assim que o Aperture conseguir conectar às chains."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Soldurile tale vor apărea de îndată ce Aperture se poate conecta la lanțuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши балансы появятся, как только Aperture сможет подключиться к сетям."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zostatky sa zobrazia, hneď ako sa Aperture pripojí k sieťam."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša stanja se bodo prikazala, ko se bo Aperture lahko povezal z verigami."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша стања ће се приказати чим Aperture буде могао да се повеже са ланцима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina saldon visas så snart Aperture når kedjorna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Salio lako litaonekana mara Aperture itakapoweza kufikia chaini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture செயின்களைத் தொடர்பு கொண்டவுடன் உங்கள் இருப்புகள் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture చెయిన్‌లను చేరుకోగలిగిన వెంటనే మీ బ్యాలెన్స్‌లు కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดคงเหลือจะปรากฏเมื่อ Aperture เชื่อมต่อกับเชนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiyeleriniz, Aperture zincirlere ulaşabildiğinde görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші баланси з’являться, щойно Aperture зможе підключитися до мереж."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بیلنس اُس وقت ظاہر ہوں گے جب Aperture چینز تک رسائی حاصل کر لے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư của bạn sẽ hiển thị khi Aperture kết nối được với các chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Aperture 能够连接到链时，你的余额便会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Aperture 能夠連線到鏈時，你的餘額便會顯示。"
          }
        }
      }
    },
