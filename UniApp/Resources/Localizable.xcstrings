    "This removes \\(walletName) from this iPhone. Every other wallet stays exactly as it is.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwyder \\(walletName) van hierdie iPhone. Elke ander beursie bly presies soos dit is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يزيل \\(walletName) من جهاز iPhone هذا. تبقى كل محفظة أخرى كما هي تمامًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това премахва \\(walletName) от този iPhone. Всеки друг портфейл остава точно както си е."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এই iPhone থেকে \\(walletName) সরিয়ে দেয়। অন্য প্রতিটি ওয়ালেট ঠিক যেমন আছে তেমনই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això elimina \\(walletName) d'aquest iPhone. La resta de carteres es mantenen exactament igual."
          }
        },
        "cs": {
