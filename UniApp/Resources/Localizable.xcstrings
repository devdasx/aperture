        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیسٹ موڈ — عوامی پتوں کو اسکین کر رہا ہے۔ اس موڈ میں Import کارروائی غیر فعال ہے؛ اپنا والٹ درآمد کرنے کے لیے باہر نکلیں۔"
