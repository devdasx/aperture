    "History lives on this iPhone only. Aperture has no server copy.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geskiedenis bly slegs op hierdie iPhone. Aperture het geen bedienerkopie nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى السجلّ على هذا الـ iPhone فقط. لا تملك Aperture أي نسخة على الخادم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Историята се съхранява само на този iPhone. Aperture няма копие на сървър."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইতিহাস শুধু এই iPhone-এ থাকে। Aperture-এর কাছে কোনো সার্ভার কপি নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historial només es queda en aquest iPhone. Aperture no en té cap còpia al servidor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie zůstává jen na tomto iPhonu. Aperture nemá žádnou kopii na serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Historikken findes kun på denne iPhone. Aperture har ingen serverkopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf bleibt nur auf diesem iPhone. Aperture hat keine Kopie auf einem Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ιστορικό μένει μόνο σε αυτό το iPhone. Το Aperture δεν διατηρεί αντίγραφο σε διακομιστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History lives on this iPhone only. Aperture has no server copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial solo se guarda en este iPhone. Aperture no conserva ninguna copia en servidores."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajalugu asub ainult sellel iPhone'il. Aperture'il pole serverikoopiat."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخچه فقط روی این آیفون است. Aperture هیچ نسخه‌ای روی سرور ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia säilyy vain tällä iPhonella. Aperturella ei ole palvelinkopiota."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa iPhone na ito lamang ang kasaysayan. Walang kopya sa server ang Aperture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique réside uniquement sur cet iPhone. Aperture n’en conserve aucune copie sur serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההיסטוריה נשמרת רק ב־iPhone הזה. ל־Aperture אין עותק בשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास सिर्फ़ इस iPhone पर रहता है। Aperture के पास सर्वर पर कोई कॉपी नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povijest ostaje samo na ovom iPhoneu. Aperture nema kopiju na poslužitelju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előzmények kizárólag ezen az iPhone-on tárolódnak. Az Aperture nem őriz másolatot szerveren."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat hanya tersimpan di iPhone ini. Aperture tidak memiliki salinan di server."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferillinn er aðeins á þessum iPhone. Aperture hefur ekkert afrit á netþjóni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia risiede solo su questo iPhone. Aperture non ne conserva alcuna copia su server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はこの iPhone にだけ保存されます。Aperture はサーバーに複製を持ちません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 iPhone에만 저장돼요. Aperture는 서버에 사본을 두지 않아요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Istorija saugoma tik šiame iPhone. Aperture neturi serverio kopijos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēsture glabājas tikai šajā iPhone. Aperture nav servera kopijas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചരിത്രം ഈ iPhone-ൽ മാത്രമേ ഉള്ളൂ. Aperture-ന് സെർവർ പകർപ്പില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास फक्त या iPhone वरच राहतो. Aperture कडे सर्व्हर प्रत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah berada pada iPhone ini sahaja. Aperture tiada salinan pelayan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggen finnes bare på denne iPhonen. Aperture har ingen serverkopi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschiedenis staat alleen op deze iPhone. Aperture heeft geen kopie op een server."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਤਿਹਾਸ ਸਿਰਫ਼ ਇਸ iPhone ਉੱਤੇ ਹੀ ਰਹਿੰਦਾ ਹੈ। Aperture ਕੋਲ ਕੋਈ ਸਰਵਰ ਕਾਪੀ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia jest tylko na tym iPhonie. Aperture nie ma kopii na serwerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico fica somente neste iPhone. O Aperture não guarda cópias em servidores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul rămâne doar pe acest iPhone. Aperture nu păstrează nicio copie pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История хранится только на этом iPhone. У Aperture нет копии на сервере."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "História zostáva len v tomto iPhone. Aperture nemá žiadnu kópiu na serveri."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgodovina ostane samo na tem iPhonu. Aperture nima kopije na strežniku."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Историја остаје само на овом iPhone. Aperture нема копију на серверу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Historiken finns endast på den här iPhonen. Aperture har ingen serverkopia."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia inakaa kwenye iPhone hii pekee. Aperture haina nakala kwenye seva."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரலாறு இந்த iPhone-இல் மட்டுமே இருக்கிறது. Aperture-இடம் சர்வர் நகல் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చరిత్ర ఈ iPhone‌లో మాత్రమే ఉంటుంది. Aperture‌కు సర్వర్ కాపీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติอยู่บน iPhone นี้เท่านั้น Aperture ไม่มีสำเนาบนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş yalnızca bu iPhone’da bulunur. Aperture’ın sunucuda bir kopyası yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія залишається лише на цьому iPhone. У Aperture немає копії на сервері."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ صرف اس iPhone پر رہتی ہے۔ Aperture کے پاس کوئی سرور کاپی نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử chỉ nằm trên iPhone này. Aperture không lưu bản sao trên máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录仅保存在这台 iPhone 上。Aperture 没有任何服务器副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄僅儲存在這部 iPhone 上。Aperture 沒有任何伺服器副本。"
          }
        }
      }
    },
