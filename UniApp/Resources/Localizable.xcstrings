    "Stamp it into metal for fire and water survival.": {
      "comment": "Third better-method row in the screenshot-warning sheet — stamp the phrase into metal for durability.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stempel dit in metaal vir oorlewing in vuur en water."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطبعها على المعدن لتصمد أمام النار والماء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гравирайте я в метал, за да оцелее през огън и вода."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগুন ও পানিতে টিকে থাকার জন্য এটি ধাতুতে খোদাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estampa-la en metall perquè sobrevisqui al foc i a l’aigua."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyražte ji do kovu, aby přežila oheň i vodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Præg den i metal, så den overlever ild og vand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prägen Sie sie in Metall, damit sie Feuer und Wasser übersteht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαράξτε τη σε μέταλλο για επιβίωση σε φωτιά και νερό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamp it into metal for fire and water survival."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grábala en metal para que sobreviva al fuego y al agua."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Stantsi see metalli, et see peaks vastu tulele ja veele."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای مقاومت در برابر آتش و آب، آن را روی فلز حک کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyö se metalliin, jotta se kestää tulen ja veden."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Imarka ito sa metal para makaligtas sa apoy at tubig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravez-la dans du métal pour résister au feu et à l’eau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטבע אותו במתכת כדי לשרוד אש ומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे धातु पर अंकित करें ताकि यह आग और पानी में बची रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utisnite je u metal kako bi preživjela vatru i vodu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üsse fémbe, hogy túléljen tüzet és vizet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetak ke logam agar tahan api dan air."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Slegðu hana í málm til að standast eld og vatn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La incida nel metallo per resistere al fuoco e all’acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "火と水に耐えるよう、金属に刻印してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불과 물에 견디도록 금속에 각인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įmuškite ją į metalą, kad atlaikytų ugnį ir vandenį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iespiediet to metālā, lai tā izturētu uguni un ūdeni."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തീയും വെള്ളവും അതിജീവിക്കാൻ ഇതിനെ ലോഹത്തിൽ പതിയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आग आणि पाण्यापासून टिकण्यासाठी ती धातूत कोरून ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap ke dalam logam supaya kekal walaupun kebakaran dan air."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stans den inn i metall så den tåler ild og vann."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla hem in metaal voor brand- en waterbestendigheid."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਗ ਅਤੇ ਪਾਣੀ ਤੋਂ ਬਚਾਅ ਲਈ ਇਸਨੂੰ ਧਾਤ ਉੱਤੇ ਉੱਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybij ją na metalu, aby przetrwała ogień i wodę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave em metal para resistir a fogo e água."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează-o pe metal pentru a supraviețui focului și apei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбейте её на металле, чтобы она пережила огонь и воду."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrazte ju do kovu, aby prežila oheň a vodu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vtisnite jo v kovino, da preživi ogenj in vodo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Утисните је у метал да преживи ватру и воду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stansa in den i metall för att överleva eld och vatten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichapishe kwenye chuma ili ipambane na moto na maji."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தீ மற்றும் நீரிலிருந்து தப்பிக்க அதை உலோகத்தில் பொறி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిప్పు మరియు నీటిని తట్టుకునేలా దాన్ని లోహంలో ముద్రించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอกลงบนโลหะเพื่อให้ทนไฟและทนน้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangına ve suya dayanması için metale işleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Викарбуйте її на металі, щоб пережити вогонь і воду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آگ اور پانی سے بچاؤ کے لیے اِسے دھات پر مہر زدہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khắc vào kim loại để chịu được lửa và nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将它刻入金属,以抵御火与水。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將它刻入金屬,以抵禦火與水。"
          }
        }
      }
    },
    "Start when you're ready.": {
      "comment": "Slide 10 hero title.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin wanneer jy gereed is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ متى كنت مستعدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Започнете, когато сте готови."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যখন প্রস্তুত, তখন শুরু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comença quan estiguis a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte, až budete připraveni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynd, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie, wenn Sie bereit sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε όταν είστε έτοιμοι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza cuando estés listo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alusta, kui oled valmis."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر زمان آماده بودید، آغاز کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita kun olet valmis."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimula kapag handa ka na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez quand vous êtes prêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל כשתהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तैयार हों, तब शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krenite kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkor kezdje, amikor készen áll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai saat Anda siap."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Byrjaðu þegar þú ert tilbúin(n)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizi quando è pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができたら、はじめましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비되시면 시작하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pradėkite, kai būsite pasiruošę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sāciet, kad esat gatavs."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് തയ്യാറാകുമ്പോൾ ആരംഭിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तयार झाल्यावर सुरुवात करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula apabila anda sudah bersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynn når du er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin wanneer je er klaar voor bent."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦ ਤਿਆਰ ਹੋਵੋ, ਸ਼ੁਰੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
