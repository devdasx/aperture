    "Share the address as text, or let the sender scan the QR code. They look different but they carry the same information.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel die adres as teks, of laat die afsender die QR-kode skandeer. Hulle lyk verskillend, maar dra dieselfde inligting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏شارك العنوان كنص، أو دع المرسل يمسح رمز QR. يبدوان مختلفين لكنهما يحملان المعلومات نفسها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Споделете адреса като текст или оставете подателя да сканира QR кода. Изглеждат различно, но носят една и съща информация."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঠিকানাটি টেক্সট হিসেবে শেয়ার করুন, অথবা প্রেরককে QR কোড স্ক্যান করতে দিন। দেখতে আলাদা হলেও দুটিতে একই তথ্য থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartiu l'adreça com a text o deixeu que el remitent escanegi el codi QR. Es veuen diferents, però porten la mateixa informació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílejte adresu jako text nebo nechte odesílatele naskenovat QR kód. Vypadají odlišně, ale nesou stejnou informaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del adressen som tekst, eller lad afsenderen scanne QR-koden. De ser forskellige ud, men bærer samme information."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie die Adresse als Text oder lassen Sie den Absender den QR-Code scannen. Sie sehen unterschiedlich aus, enthalten aber dieselbe Information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοινοποιήστε τη διεύθυνση ως κείμενο ή αφήστε τον αποστολέα να σαρώσει τον κωδικό QR. Φαίνονται διαφορετικά, αλλά μεταφέρουν την ίδια πληροφορία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the address as text, or let the sender scan the QR code. They look different but they carry the same information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte la dirección como texto o deja que el remitente escanee el código QR. Aunque son distintos visualmente, llevan la misma información."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagage aadressi tekstina või laske saatjal skannida QR-kood. Need näevad erinevad välja, kuid kannavad sama teavet."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏آدرس را به‌صورت متن به اشتراک بگذارید یا اجازه دهید فرستنده کد QR را اسکن کند. ظاهر متفاوتی دارند اما اطلاعات یکسانی منتقل می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa osoite tekstinä tai anna lähettäjän skannata QR-koodi. Ne näyttävät erilaisilta, mutta sisältävät saman tiedon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibahagi ang address bilang teksto, o hayaang i-scan ng nagpapadala ang QR code. Magkaiba ang itsura nila pero pareho ang impormasyong dala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez l'adresse sous forme de texte, ou laissez l'expéditeur scanner le QR code. Ils paraissent différents mais contiennent la même information."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏שתף את הכתובת כטקסט, או תן לשולח לסרוק את קוד ה-QR. הם נראים שונים אך נושאים את אותו מידע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पते को टेक्स्ट के रूप में साझा करें, या भेजने वाले को QR कोड स्कैन करने दें। ये अलग दिखते हैं लेकिन इनमें एक ही जानकारी होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podijelite adresu kao tekst ili dopustite pošiljatelju da skenira QR kôd. Izgledaju različito, ali nose iste informacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ossza meg a címet szövegként, vagy hagyja, hogy a feladó beolvassa a QR-kódot. Másképp néznek ki, de ugyanazt az információt hordozzák."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan alamat sebagai teks, atau biarkan pengirim memindai kode QR. Keduanya terlihat berbeda tetapi membawa informasi yang sama."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Deildu vistfanginu sem texta, eða leyfðu sendanda að skanna QR-kóðann. Þau líta öðruvísi út en bera sömu upplýsingar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi l'indirizzo come testo, oppure lascia che il mittente scansioni il codice QR. Sembrano diversi ma contengono la stessa informazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスをテキストとして共有するか、送信者に QR コードをスキャンしてもらいましょう。見た目は違いますが、同じ情報を持っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소를 텍스트로 공유하거나 보내는 사람이 QR 코드를 스캔하게 하세요. 모양은 다르지만 같은 정보가 담겨 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendrinkite adresą kaip tekstą arba leiskite siuntėjui nuskaityti QR kodą. Atrodo skirtingai, bet neša tą pačią informaciją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopīgojiet adresi kā tekstu vai ļaujiet sūtītājam noskenēt QR kodu. Tās izskatās atšķirīgi, bet satur to pašu informāciju."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിലാസം ടെക്സ്റ്റായി പങ്കിടുക, അല്ലെങ്കിൽ അയക്കുന്നയാളെ QR കോഡ് സ്കാൻ ചെയ്യാൻ അനുവദിക്കുക. അവ വ്യത്യസ്തമായി കാണപ്പെടുന്നു, എന്നാൽ ഒരേ വിവരം വഹിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पत्ता मजकूर म्हणून शेअर करा, किंवा पाठवणाऱ्याला QR कोड स्कॅन करू द्या. ते वेगळे दिसतात पण समान माहिती बाळगतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kongsi alamat sebagai teks, atau biarkan penghantar mengimbas kod QR. Mereka kelihatan berbeza tetapi membawa maklumat yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del adressen som tekst, eller la avsenderen skanne QR-koden. De ser ulike ut, men inneholder samme informasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel het adres als tekst of laat de afzender de QR-code scannen. Ze zien er anders uit, maar bevatten dezelfde informatie."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਤੇ ਨੂੰ ਟੈਕਸਟ ਵਜੋਂ ਸਾਂਝਾ ਕਰੋ, ਜਾਂ ਭੇਜਣ ਵਾਲੇ ਨੂੰ QR ਕੋਡ ਸਕੈਨ ਕਰਨ ਦਿਓ। ਉਹ ਵੱਖਰੇ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ ਪਰ ਇੱਕੋ ਜਾਣਕਾਰੀ ਰੱਖਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij adres jako tekst lub pozwól nadawcy zeskanować kod QR. Wyglądają inaczej, ale niosą tę samą informację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe o endereço como texto ou peça ao remetente para escanear o QR code. Eles parecem diferentes, mas carregam a mesma informação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuiți adresa ca text sau lăsați expeditorul să scaneze codul QR. Arată diferit, dar conțin aceleași informații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь адресом в виде текста или дайте отправителю отсканировать QR-код. Они выглядят по-разному, но содержат одну и ту же информацию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľajte adresu ako text alebo nechajte odosielateľa naskenovať QR kód. Vyzerajú odlišne, ale obsahujú rovnaké informácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslov delite kot besedilo ali pošiljatelju omogočite, da skenira kodo QR. Videti sta drugačni, vendar nosita iste informacije."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделите адресу као текст или дозволите пошиљаоцу да скенира QR код. Изгледају различито, али носе исте информације."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela adressen som text eller låt avsändaren skanna QR-koden. De ser olika ut men bär samma information."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiriki anwani kama maandishi, au mruhusu mtumaji achanganue msimbo wa QR. Vinaonekana tofauti lakini vinabeba taarifa zilezile."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகவரியை உரையாகப் பகிரவும், அல்லது அனுப்புபவர் QR கோடைஸ் ஸ்கேன் செய்யட்டும். அவை வேறுபட்டுத் தோன்றினாலும் ஒரே தகவலையே கொண்டிருக்கின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిరునామాను టెక్స్ట్‌గా భాగస్వామ్యం చేయండి, లేదా పంపేవారిని QR కోడ్‌ను స్కాన్ చేయనివ్వండి. అవి విభిన్నంగా కనిపిస్తాయి కానీ ఒకే సమాచారం కలిగి ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ที่อยู่เป็นข้อความ หรือให้ผู้ส่งสแกน QR code ทั้งสองดูต่างกันแต่บรรจุข้อมูลเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresi metin olarak paylaşın veya gönderenin QR kodu taramasına izin verin. Farklı görünürler ama aynı bilgiyi taşırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться адресою як текстом або дайте відправнику відсканувати QR-код. Виглядають по-різному, але містять однакову інформацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏پتے کو ٹیکسٹ کی صورت میں شیئر کریں، یا بھیجنے والے کو QR کوڈ اسکین کرنے دیں۔ یہ مختلف نظر آتے ہیں لیکن دونوں میں ایک ہی معلومات ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chia sẻ địa chỉ dưới dạng văn bản, hoặc để người gửi quét mã QR. Chúng trông khác nhau nhưng chứa cùng một thông tin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以文字形式分享地址,或让发送方扫描二维码。它们看起来不同,但承载的是相同的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以文字形式分享地址,或讓發送方掃描 QR 碼。它們看起來不同,但承載的是相同的資訊。"
          }
        }
      }
    },
