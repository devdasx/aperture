        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فقرے کے ساتھ کوئی بھی آپ کی رقم لے سکتا ہے۔ Aperture اسے آپ کے لیے بحال نہیں کر سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai có cụm từ này đều có thể lấy tiền của bạn. Aperture không thể khôi phục nó cho bạn."
