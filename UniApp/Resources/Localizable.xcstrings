        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어둔 원본 구문을 확인하세요——이 단어는 다른 단어 목록에서 온 것일 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikrink originalią frazę, kurią užsirašei — šis žodis gali būti iš kito žodžių sąrašo."
