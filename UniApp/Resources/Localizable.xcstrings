    "Aperture no longer has your phrase. You're the only copy — write it down and keep it safe.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture het nie meer jou herstelfrase nie. Jy is die enigste kopie — skryf dit neer en hou dit veilig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد Aperture تحتفظ بعبارتك. أنت النسخة الوحيدة — اكتبها واحتفظ بها في مكان آمن."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture вече не съхранява вашата фраза. Вие сте единственото копие — запишете я и я пазете на сигурно място."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-এর কাছে আর আপনার ফ্রেজ নেই। আপনিই একমাত্র কপি — এটি লিখে নিন এবং নিরাপদে রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ja no té la teva frase. Ets l'única còpia: anota-la i guarda-la en un lloc segur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture už vaši frázi nemá. Jste jediná kopie – zapište si ji a uschovejte ji na bezpečném místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture har ikke længere din frase. Du er den eneste kopi – skriv den ned, og opbevar den sikkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture hat Ihre Phrase nicht mehr. Sie sind die einzige Kopie – notieren Sie sie und bewahren Sie sie sicher auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Aperture δεν διατηρεί πλέον τη φράση σας. Είστε το μοναδικό αντίγραφο — σημειώστε την και φυλάξτε την με ασφάλεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ya no tiene tu frase. Eres la única copia: anótala y guárdala en un lugar seguro."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture'il pole enam teie taastefraasi. Olete ainus koopia — kirjutage see üles ja hoidke turvaliselt."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture دیگر عبارت بازیابی شما را ندارد. شما تنها نسخه هستید — آن را یادداشت کنید و در جای امن نگه دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperturella ei ole enää lausettasi. Olet ainoa kopio – kirjoita se ylös ja säilytä turvallisesti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala na sa Aperture ang inyong recovery phrase. Kayo na lang ang tanging kopya — isulat ito at itago nang ligtas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ne conserve plus votre phrase. Vous en êtes la seule copie — notez-la et gardez-la en lieu sûr."
