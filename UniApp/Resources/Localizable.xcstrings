    "Scanning lands with the real Send flow. For now, paste or pick a recent recipient.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning lands with the real Send flow. For now, paste or pick a recent recipient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo llegará con el flujo de envío real. Por ahora, pega o elige un destinatario reciente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描将随真正的发送流程一同推出。目前请粘贴或选择一位近期收款方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描將隨真正的傳送流程一同推出。目前請貼上或選擇一位近期收款方。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैनिंग असली भेजें प्रवाह के साथ आएगी। अभी के लिए, किसी हाल के प्राप्तकर्ता को पेस्ट करें या चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصل المسح مع تدفّق الإرسال الحقيقي. حاليًا، الصق مُستلِمًا حديثًا أو اختره."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O escaneamento chega com o fluxo de envio real. Por enquanto, cole ou escolha um destinatário recente."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যানিং আসল পাঠানোর প্রবাহের সাথে আসবে। আপাতত, সাম্প্রতিক কোনো প্রাপক পেস্ট করুন বা বেছে নিন।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование появится вместе с реальным процессом отправки. Пока вставьте или выберите недавнего получателя."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンは実際の送信フローとともに登場します。今は、最近の受取人を貼り付けるか選択してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Scannen kommt mit dem echten Sende-Ablauf. Fügen Sie vorerst einen kürzlichen Empfänger ein oder wählen Sie ihn aus."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування з’явиться разом зі справжнім процесом надсилання. Поки що вставте або виберіть нещодавнього отримувача."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σάρωση έρχεται μαζί με την πραγματική ροή αποστολής. Προς το παρόν, επικολλήστε ή επιλέξτε έναν πρόσφατο παραλήπτη."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanarea sosește odată cu fluxul real de trimitere. Deocamdată, lipește sau alege un destinatar recent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenování přijde se skutečným postupem odesílání. Zatím vložte nebo vyberte nedávného příjemce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beolvasás a valódi küldési folyamattal érkezik. Egyelőre illesszen be vagy válasszon egy nemrégi címzettet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanning kommer med det riktiga sändningsflödet. Klistra in eller välj en nyligen använd mottagare så länge."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanning kommer med den ekte sendeflyten. Foreløpig kan du lime inn eller velge en nylig mottaker."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning kommer med det rigtige afsendelsesflow. Indtil videre kan du indsætte eller vælge en nylig modtager."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaus saapuu todellisen lähetysprosessin mukana. Liitä tai valitse toistaiseksi viimeaikainen vastaanottaja."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסריקה תגיע יחד עם תהליך השליחה האמיתי. בינתיים, הדבק או בחר נמען אחרון."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'escaneig arribarà amb el flux d'enviament real. De moment, enganxa o tria un destinatari recent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeniranje stiže s pravim tijekom slanja. Zasad zalijepite ili odaberite nedavnog primatelja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenovanie príde so skutočným postupom odosielania. Zatiaľ vložte alebo vyberte nedávneho príjemcu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeniranje pride s pravim potekom pošiljanja. Za zdaj prilepite ali izberite nedavnega prejemnika."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Скенирање стиже са правим током слања. Засад налепите или изаберите недавног примаоца."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scan arrivera avec le vrai parcours d'envoi. Pour l'instant, collez ou choisissez un destinataire récent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔은 실제 전송 기능과 함께 추가돼요. 지금은 붙여넣거나 최근 받는 사람을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione arriverà con il vero flusso di invio. Per ora, incolli o scelga un destinatario recente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama, gerçek Gönderme akışıyla birlikte gelecek. Şimdilik bir alıcı yapıştırın ya da son alıcılardan birini seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng quét sẽ có cùng luồng Gửi thực tế. Hiện tại, hãy dán hoặc chọn một người nhận gần đây."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสแกนจะมาพร้อมกับการส่งจริง ตอนนี้ให้วางหรือเลือกผู้รับล่าสุด"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemindaian akan hadir bersama alur Kirim yang sebenarnya. Untuk saat ini, tempelkan atau pilih penerima terbaru."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکن همراه با جریان واقعی ارسال می‌آید. فعلاً یک گیرنده اخیر را بچسبانید یا انتخاب کنید."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie pojawi się wraz z pełnym procesem wysyłki. Na razie wklej lub wybierz ostatniego odbiorcę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen komt samen met de echte verzendflow. Plak voorlopig een adres of kies een recente ontvanger."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سکیننگ اصل بھیجنے کے عمل کے ساتھ آئے گی۔ فی الحال، پیسٹ کریں یا کوئی حالیہ وصول کنندہ منتخب کریں۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирането ще дойде с истинския процес на изпращане. Засега поставете или изберете скорошен получател."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannimine saabub koos päris saatmisvooga. Praegu kleebi või vali hiljutine saaja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuskaitymas atsiras kartu su tikru siuntimo procesu. Kol kas įklijuokite arba pasirinkite neseną gavėją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenēšana parādīsies kopā ar īsto sūtīšanas procesu. Pagaidām ielīmējiet vai izvēlieties nesenu saņēmēju."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skönnun kemur með raunverulega sendingarferlinu. Í bili skaltu líma inn eða velja nýlegan viðtakanda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengimbasan akan tiba bersama aliran Hantar sebenar. Buat masa ini, tampal atau pilih penerima terkini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Darating ang scanning kasama ng tunay na daloy ng Pagpapadala. Sa ngayon, mag-paste o pumili ng kamakailang recipient."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uskanaji utafika pamoja na mtiririko halisi wa Kutuma. Kwa sasa, bandika au chagua mpokeaji wa hivi karibuni."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skandering kom saam met die werklike Stuur-vloei. Plak vir eers, of kies 'n onlangse ontvanger."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உண்மையான அனுப்பும் செயல்முறையுடன் ஸ்கேனிங் வரும். இப்போதைக்கு, ஒட்டவும் அல்லது சமீபத்திய பெறுநரைத் தேர்வுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిజమైన పంపే ప్రక్రియతో పాటు స్కానింగ్ వస్తుంది. ప్రస్తుతానికి, అతికించండి లేదా ఇటీవలి గ్రహీతను ఎంచుకోండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "യഥാർത്ഥ അയയ്ക്കൽ പ്രക്രിയയ്‌ക്കൊപ്പം സ്കാനിംഗ് വരും. തൽക്കാലം, ഒട്ടിക്കുക അല്ലെങ്കിൽ ഒരു സമീപകാല സ്വീകർത്താവിനെ തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅनिंग प्रत्यक्ष पाठवण्याच्या प्रक्रियेसह येईल. सध्या, पेस्ट करा किंवा अलीकडील प्राप्तकर्ता निवडा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨਿੰਗ ਅਸਲ ਭੇਜਣ ਪ੍ਰਕਿਰਿਆ ਨਾਲ ਆਵੇਗੀ। ਫ਼ਿਲਹਾਲ, ਪੇਸਟ ਕਰੋ ਜਾਂ ਕੋਈ ਹਾਲੀਆ ਪ੍ਰਾਪਤਕਰਤਾ ਚੁਣੋ।"
          }
        }
      }
    },
    "Search assets": {
