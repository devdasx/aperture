        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleepige oma %@ konto võti. Aperture kontrollib vormingut enne ühegi aadressi tuletamist ning võti ei lahku kunagi sellest iPhone’ist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
