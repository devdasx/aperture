        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există nicio frază criptată stocată pentru acest portofel. Dacă ai salvat-o în altă parte, ești deja singura copie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого кошелька не сохранено зашифрованной фразы. Если вы записали её где-то ещё, вы — её единственная копия."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre túto peňaženku nie je uložená žiadna šifrovaná fráza. Ak ste si ju uložili inde, ste už jej jediná kópia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za to denarnico ni shranjene šifrirane fraze. Če ste jo shranili drugje, ste že njen edini izvod."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "За овај новчаник није сачувана шифрована фраза. Ако сте је сачували негде другде, ви сте већ једина њена копија."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ingen krypterad fras lagrad för den här plånboken. Om du sparat den på annat håll är du redan dess enda kopia."
