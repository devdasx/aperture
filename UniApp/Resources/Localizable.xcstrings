    "Choose a 6-digit passcode. You'll use it to unlock Aperture and confirm transactions.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies 'n 6-syfer toegangskode. Jy gebruik dit om Aperture te ontsluit en transaksies te bevestig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر رمز مرور من 6 أرقام. ستستخدمه لإلغاء قفل Aperture وتأكيد المعاملات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете 6-цифрен код. Ще го използвате, за да отключвате Aperture и да потвърждавате транзакции."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৬-সংখ্যার একটি পাসকোড বেছে নিন। আপনি এটি Aperture আনলক করতে এবং লেনদেন নিশ্চিত করতে ব্যবহার করবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un codi d'accés de 6 dígits. L'utilitzaràs per desbloquejar l'Aperture i confirmar transaccions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte 6místný kód. Použijete jej k odemčení Aperture a potvrzení transakcí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en 6-cifret kode. Du bruger den til at låse Aperture op og bekræfte transaktioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen 6-stelligen Code. Sie verwenden ihn, um Aperture zu entsperren und Transaktionen zu bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε έναν 6ψήφιο κωδικό. Θα τον χρησιμοποιείτε για να ξεκλειδώνετε το Aperture και να επιβεβαιώνετε συναλλαγές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un código de 6 dígitos. Lo usarás para desbloquear Aperture y confirmar transacciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valige 6-kohaline pääsukood. Kasutate seda Aperture'i avamiseks ja tehingute kinnitamiseks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک رمز ۶ رقمی انتخاب کنید. از آن برای باز کردن Aperture و تأیید تراکنش‌ها استفاده می‌کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse 6-numeroinen pääsykoodi. Käytät sitä Aperturen avaamiseen ja tapahtumien vahvistamiseen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng 6-digit na passcode. Gagamitin ninyo ito para i-unlock ang Aperture at kumpirmahin ang mga transaksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un code à 6 chiffres. Vous l'utiliserez pour déverrouiller Aperture et confirmer les transactions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר קוד גישה בן 6 ספרות. תשתמש בו כדי לבטל את הנעילה של Aperture ולאשר עסקאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6 अंकों का पासकोड चुनें। आप इसका उपयोग Aperture को अनलॉक करने और लेन-देन की पुष्टि करने के लिए करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite 6-znamenkasti pristupni kod. Koristit ćete ga za otključavanje Aperturea i potvrdu transakcija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon egy 6 jegyű kódot. Ezzel oldja fel az Aperture-t és hagyhatja jóvá a tranzakciókat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kode sandi 6 digit. Anda akan menggunakannya untuk membuka Aperture dan mengonfirmasi transaksi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu 6 stafa aðgangskóða. Þú notar hann til að opna Aperture og staðfesta færslur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelga un codice di 6 cifre. Lo userà per sbloccare Aperture e confermare le transazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6桁のパスコードを設定してください。Aperture のロック解除と取引の確認に使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6자리 암호를 선택하세요. Aperture 잠금 해제 및 거래 확인에 사용해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite 6 skaitmenų prieigos kodą. Naudosite jį Aperture atrakinti ir operacijoms patvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties 6 ciparu piekļuves kodu. Izmantosiet to, lai atbloķētu Aperture un apstiprinātu darījumus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "6 അക്കങ്ങളുള്ള പാസ്‌കോഡ് തിരഞ്ഞെടുക്കുക. Aperture അൺലോക്ക് ചെയ്യാനും ഇടപാടുകൾ സ്ഥിരീകരിക്കാനും ഇത് ഉപയോഗിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "6-अंकी पासकोड निवडा. Aperture अनलॉक करण्यासाठी आणि व्यवहारांची पुष्टी करण्यासाठी तो वापराल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kod laluan 6 digit. Anda akan menggunakannya untuk membuka Aperture dan mengesahkan transaksi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en 6-sifret kode. Du bruker den til å låse opp Aperture og bekrefte transaksjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een 6-cijferige toegangscode. Je gebruikt hem om Aperture te ontgrendelen en transacties te bevestigen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "6-ਅੰਕਾਂ ਦਾ ਪਾਸਕੋਡ ਚੁਣੋ। Aperture ਨੂੰ ਅਨਲਾਕ ਕਰਨ ਅਤੇ ਲੈਣ-ਦੇਣ ਦੀ ਪੁਸ਼ਟੀ ਕਰਨ ਲਈ ਤੁਸੀਂ ਇਸਦੀ ਵਰਤੋਂ ਕਰੋਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrać 6-cyfrowy kod. Będzie używany do odblokowywania Aperture i potwierdzania transakcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um código de 6 dígitos. Você o usará para desbloquear a Aperture e confirmar transações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un cod de 6 cifre. Îl vei folosi pentru a debloca Aperture și a confirma tranzacțiile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите 6-значный код. Вы будете использовать его, чтобы разблокировать Aperture и подтверждать транзакции."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoľte si 6-miestny kód. Použijete ho na odomknutie Aperture a potvrdenie transakcií."
