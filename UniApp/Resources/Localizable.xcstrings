        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நகலெடுக்கப்பட்டது. கிளிப்போர்டு 60 வினாடிகளில் காலியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాపీ చేయబడింది. క్లిప్‌బోర్డ్ 60 సెకన్లలో క్లియర్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกแล้ว คลิปบอร์ดจะถูกล้างใน 60 วินาที"
