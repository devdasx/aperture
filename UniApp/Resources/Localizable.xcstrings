        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل أن تتابع"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди да продължите"
          }
        },
        "bn": {
