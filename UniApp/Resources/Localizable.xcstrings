    "Switching modes discards your %lld rolls.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om die modus te wissel sal jou %lld rolle weggooi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبديل الوضع سيتجاهل %lld رميات سابقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Смяната на режима ще отхвърли твоите %lld хвърляния."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোড পরিবর্তন করলে আপনার %lld টি ছোঁড়া বাতিল হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar de mode descartarà les teves %lld tirades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepnutí režimu zahodí tvých %lld hodů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skifte tilstand kasserer dine %lld kast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Moduswechsel werden deine %lld Würfe verworfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή τρόπου απορρίπτει τις %lld ρίψεις σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de modo descartará tus %lld tiradas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Režiimi vahetamine tühistab sinu %lld viset."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر حالت %lld پرتاب قبلی تو را دور می‌اندازد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilan vaihtaminen hylkää %lld heittoasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagpapalit ng mode ay magtatapon ng %lld pukol mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de mode annulera tes %lld lancers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלפת מצב תבטל את %lld ההטלות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोड बदलने से आपकी %lld फेंक रद्द हो जाएँगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena načina odbacit će tvojih %lld bacanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mód váltása elveti az eddigi %lld dobásodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti mode akan membuang %lld lemparan kamu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Að skipta um stillingu hendir %lld köstunum þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare modalità scarterà i tuoi %lld tiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モードを切り替えると %lld 回の入力が破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드를 전환하면 %lld회의 입력이 사라집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitus režimą tavo %lld metimų bus atmesta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Režīma maiņa atmetīs tavus %lld metienus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോഡ് മാറ്റിയാൽ നിങ്ങളുടെ %lld ഉരുട്ടലുകൾ ഉപേക്ഷിക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोड बदलल्यास तुमच्या %lld टाकण्या रद्द होतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar mod akan membuang %lld lemparan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å bytte modus forkaster dine %lld kast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van modus wisselen verwerpt je %lld worpen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੋਡ ਬਦਲਣ ਨਾਲ ਤੁਹਾਡੀਆਂ %lld ਸੁੱਟਾਂ ਰੱਦ ਹੋ ਜਾਣਗੀਆਂ।"
