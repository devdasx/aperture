    "Long-press the Wallet tab to switch, customise, create, or import.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou die Wallet-blad ingedruk om te wissel, aan te pas, te skep of in te voer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على تبويب Wallet للتبديل أو التخصيص أو الإنشاء أو الاستيراد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръжте натиснат раздела Wallet, за да превключите, персонализирате, създадете или импортирате."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet ট্যাবে চাপ ধরে রেখে স্যুইচ, কাস্টমাইজ, তৈরি বা ইম্পোর্ট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premut el botó Wallet per canviar, personalitzar, crear o importar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržením karty Wallet můžete přepnout, přizpůsobit, vytvořit nebo importovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold på Wallet-fanen for at skifte, tilpasse, oprette eller importere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie länger auf den Wallet-Tab, um zu wechseln, anzupassen, zu erstellen oder zu importieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρατεταμένο πάτημα στην καρτέλα Wallet για εναλλαγή, προσαρμογή, δημιουργία ή εισαγωγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the Wallet tab to switch, customise, create, or import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón Wallet para cambiar, personalizar, crear o importar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta ja hoia Wallet-vahekaarti, et vahetada, kohandada, luua või importida."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای جابه‌جایی، سفارشی‌سازی، ایجاد یا وارد کردن، روی برگه Wallet نگه دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä Wallet-välilehteä painettuna vaihtaaksesi, mukauttaaksesi, luodaksesi tai tuodaksesi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindutin nang matagal ang tab na Wallet para magpalit, mag-customize, gumawa, o mag-import."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez appuyé l'onglet Wallet pour basculer, personnaliser, créer ou importer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצה ארוכה על הלשונית Wallet כדי להחליף, להתאים, ליצור או לייבא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलने, कस्टमाइज़ करने, बनाने या इम्पोर्ट करने के लिए Wallet टैब को देर तक दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dugo pritisni karticu Wallet za promjenu, prilagodbu, izradu ili uvoz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa nyomva a Wallet lapot a váltáshoz, testreszabáshoz, létrehozáshoz vagy importáláshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama tab Wallet untuk beralih, sesuaikan, buat, atau impor."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltu inni Wallet-flipanum til að skipta, sérsníða, búa til eða flytja inn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il pannello Wallet per cambiare, personalizzare, creare o importare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Walletタブを長押しすると、切り替え・カスタマイズ・作成・読み込みができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet 탭을 길게 누르면 전환, 사용자화, 생성 또는 가져오기를 할 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaikykite paspaudę kortelę Wallet, kad pakeistumėte, tinkintumėte, sukurtumėte ar importuotumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turiet nospiestu cilni Wallet, lai pārslēgtos, pielāgotu, izveidotu vai importētu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാറാൻ, ഇഷ്ടാനുസൃതമാക്കാൻ, സൃഷ്ടിക്കാൻ അല്ലെങ്കിൽ ഇറക്കുമതി ചെയ്യാൻ Wallet ടാബ് ദീർഘനേരം അമർത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्विच, सानुकूलित, तयार किंवा आयात करण्यासाठी Wallet टॅब दाबून ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama tab Wallet untuk menukar, menyesuaikan, mencipta atau mengimport."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og hold på Wallet-fanen for å bytte, tilpasse, opprette eller importere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd het Wallet-tabblad ingedrukt om te wisselen, aan te passen, te maken of te importeren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਦਲਣ, ਅਨੁਕੂਲਿਤ ਕਰਨ, ਬਣਾਉਣ ਜਾਂ ਆਯਾਤ ਕਰਨ ਲਈ Wallet ਟੈਬ ਨੂੰ ਦਬਾ ਕੇ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij i przytrzymaj kartę Wallet, aby przełączyć, dostosować, utworzyć lub zaimportować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionada a aba Wallet para trocar, personalizar, criar ou importar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă lung pe fila Wallet pentru a comuta, personaliza, crea sau importa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте вкладку Wallet, чтобы переключиться, настроить, создать или импортировать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržaním karty Wallet môžete prepnúť, prispôsobiť, vytvoriť alebo importovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite in držite zavihek Wallet za preklop, prilagoditev, ustvarjanje ali uvoz."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Држите притиснуту картицу Wallet за пребацивање, прилагођавање, креирање или увоз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll på Wallet-fliken för att växla, anpassa, skapa eller importera."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonyeza kwa muda kichupo cha Wallet ili kubadilisha, kubadilisha mtindo, kuunda au kuingiza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாற்ற, வடிவமைக்க, உருவாக்க, அல்லது இறக்குமதி செய்ய Wallet தாவலை அழுத்திப் பிடி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మార్చడానికి, అనుకూలీకరించడానికి, సృష్టించడానికి లేదా దిగుమతి చేయడానికి Wallet ట్యాబ్‌ను నొక్కి పట్టుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้างที่แท็บ Wallet เพื่อสลับ ปรับแต่ง สร้าง หรือนำเข้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet sekmesini basılı tutarak geçiş yap, özelleştir, oluştur veya içe aktar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте вкладку Wallet, щоб перемкнути, налаштувати, створити або імпортувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدیل، حسب ضرورت، تخلیق یا درآمد کرنے کے لیے Wallet ٹیب کو دیر تک دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ tab Wallet để chuyển đổi, tuỳ chỉnh, tạo mới hoặc nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按 Wallet 标签可切换、自定义、创建或导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按「Wallet」標籤可切換、自訂、建立或匯入。"
          }
        }
      }
    },
