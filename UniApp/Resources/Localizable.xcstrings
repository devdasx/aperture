        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta denarnica še nima naslova %@, zato v tem omrežju ni naslova za prejem. Aperture morda še izpeljuje vaše račune — poskusite znova v trenutku."
          }
