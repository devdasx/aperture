    "Let Aperture choose the best coins": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Aperture die beste munte kies"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع Aperture يختار أفضل العملات"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставете Aperture да избере най-добрите монети"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-কে সেরা কয়েন বেছে নিতে দিন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa que Aperture triï les millors monedes"
          }
        },
