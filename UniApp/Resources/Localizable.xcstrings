        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਕੁੰਜੀਆਂ ਕਦੇ ਵੀ ਤੁਹਾਡੇ iPhone ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
