        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کے لیے کوئی بھی اندراج تصدیق نہیں ہوا۔ واپس جائیں اور ہر ایڈریس یا کلید کو جانچیں۔"
