        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikkaðu á Taka á móti til að sjá netfangið þitt fyrir hverja keðju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Ricevi per vedere il tuo indirizzo per ogni chain."
          }
        },
