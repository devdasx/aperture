        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un destinatario es una dirección en una cadena de bloques: una cadena larga que identifica una cuenta. Puedes pegarla, escanear su código QR o escribir un nombre que la resuelva (como un nombre ENS)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
