    "Tap back and check the key format for \\(chain.displayName).": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik terug en kyk na die sleutelformaat vir \\(chain.displayName)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على رجوع وتحقق من تنسيق مفتاح \\(chain.displayName)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натиснете назад и проверете формата на ключа за \\(chain.displayName)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেছনে যান এবং \\(chain.displayName) এর জন্য কী ফরম্যাট পরীক্ষা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Enrere» i comprova el format de la clau per a \\(chain.displayName)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Zpět a zkontrolujte formát klíče pro \\(chain.displayName)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Tilbage, og tjek nøgleformatet for \\(chain.displayName)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Zurück und überprüfe das Schlüsselformat für \\(chain.displayName)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε «Πίσω» και έλεγξε τη μορφή του κλειδιού για το \\(chain.displayName)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap back and check the key format for \\(chain.displayName)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Atrás» y revisa el formato de la clave para \\(chain.displayName)."
          }
        },
        "et": {
