        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto peňaženka zatiaľ nemá %@ adresu, takže v tejto sieti nie je kam prijímať. Aperture možno stále odvodzuje vaše účty — skúste znova o chvíľu."
