          "stringUnit": {
            "state": "translated",
            "value": "പാസ്‌കോഡില്ലെങ്കിൽ, നിങ്ങളുടെ വാലറ്റ് നിങ്ങളുടെ iPhone-ന്റെ ലോക്ക് സ്‌ക്രീൻ മാത്രമേ പരിരക്ഷിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पासकोडशिवाय, तुमचे वॉलेट फक्त तुमच्या iPhone च्या लॉक स्क्रीनद्वारे संरक्षित आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kod laluan, dompet anda hanya dilindungi oleh skrin kunci iPhone anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten en kode er lommeboken din kun beskyttet av iPhones låseskjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder toegangscode wordt je portemonnee alleen beschermd door het vergrendelscherm van je iPhone."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਾਸਕੋਡ ਤੋਂ ਬਿਨਾਂ, ਤੁਹਾਡਾ ਵਾਲਿਟ ਸਿਰਫ਼ ਤੁਹਾਡੀ iPhone ਦੀ ਲਾਕ ਸਕ੍ਰੀਨ ਨਾਲ ਸੁਰੱਖਿਅਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kodu dostępu Twój portfel jest chroniony tylko ekranem blokady iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um código, sua carteira é protegida apenas pela tela de bloqueio do iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără un cod, portofelul vă este protejat doar de ecranul de blocare al iPhone-ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без код-пароля ваш кошелёк защищён только экраном блокировки iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez prístupového kódu vašu peňaženku chráni iba uzamknutá obrazovka iPhonu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez gesla vašo denarnico ščiti le zaklenjeni zaslon iPhona."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без шифре, ваш новчаник штити само закључани екран iPhone-а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan en lösenkod skyddas din plånbok endast av iPhones låsskärm."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila nenosiri, pochi yako inalindwa tu na skrini ya kufunga ya iPhone yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுக்குறியீடு இல்லாமல், உங்கள் வாலட் உங்கள் iPhone-இன் பூட்டு திரையால் மட்டுமே பாதுகாக்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాస్‌కోడ్ లేకుండా, మీ వాలెట్ మీ iPhone యొక్క లాక్ స్క్రీన్ ద్వారా మాత్రమే రక్షించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีรหัสผ่าน กระเป๋าสตางค์ของคุณจะได้รับการปกป้องด้วยหน้าจอล็อกของ iPhone เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola olmadan, cüzdanınız yalnızca iPhone'unuzun kilit ekranıyla korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без код-пароля ваш гаманець захищає лише екран блокування iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس کوڈ کے بغیر، آپ کا والٹ صرف آپ کے iPhone کے لاک اسکرین سے محفوظ ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có mật mã, ví của bạn chỉ được bảo vệ bằng màn hình khoá của iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置密码时,你的钱包仅由 iPhone 的锁屏保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定密碼時,你的錢包僅由 iPhone 的鎖定畫面保護。"
          }
        }
      }
    },
    "Without a passcode, your wallet is only protected by your iPhone's lock screen. Set one to require authentication every time you open Aperture.": {},
