        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifungu chako cha urejesho kimehifadhiwa. Utapata pochi yako kwenye skrini kuu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மீட்பு சொற்றொடர் சேமிக்கப்பட்டுவிட்டது. முதன்மை திரையில் உங்கள் பணப்பையை காணலாம்."
