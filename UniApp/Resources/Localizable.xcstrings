    "This wallet can't revoke — it's watch-only or a single-key import.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie beursie kan nie herroep nie — dit is slegs-kyk of 'n enkelsleutel-invoer."
