        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte sieci nadal są obsługiwane — zmiana dotyczy tylko widoku tego aktywa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
