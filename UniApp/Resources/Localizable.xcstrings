          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar резервує мінімальний баланс (від 1 XLM), щоб ваш рахунок залишався активним."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar آپ کے اکاؤنٹ کو فعال رکھنے کے لیے کم از کم بیلنس (1 XLM سے) محفوظ رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellar giữ một số dư tối thiểu (từ 1 XLM) được dành riêng để giữ tài khoản của bạn hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
