          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे शब्द म्हणजेच तुमचं वॉलेट. दाखवल्याप्रमाणे क्रमाने तसेच लिहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan ini ialah dompet anda. Tuliskannya mengikut urutan, tepat seperti yang ditunjukkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse ordene er lommeboken din. Skriv dem ned i rekkefølge, akkurat som vist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze woorden zijn je wallet. Schrijf ze in volgorde op, precies zoals getoond."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸ਼ਬਦ ਹੀ ਤੁਹਾਡਾ ਵਾਲਿਟ ਹਨ। ਜਿਵੇਂ ਦਿਖਾਇਆ ਗਿਆ ਹੈ, ਉਸੇ ਕ੍ਰਮ ਵਿੱਚ ਲਿਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
