          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagpapalit ng bilang ng salita ay bumubuo ng bagong phrase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer le nombre de mots génère une nouvelle phrase."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
