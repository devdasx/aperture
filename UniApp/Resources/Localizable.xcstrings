    "Your balance changes will appear here as transactions confirm on-chain.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou saldoveranderings sal hier verskyn soos transaksies op-ketting bevestig word."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر تغييرات رصيدك هنا عند تأكيد المعاملات على السلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промените на баланса ще се появят тук, когато транзакциите се потвърдят в мрежата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেন অন-চেইনে নিশ্চিত হওয়ার সাথে সাথে আপনার ব্যালেন্সের পরিবর্তন এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els canvis del teu saldo apareixeran aquí a mesura que les transaccions es confirmin a la cadena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny zůstatku se zde zobrazí, jakmile budou transakce potvrzeny v řetězci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoændringer vises her, efterhånden som transaktionerne bekræftes i kæden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoänderungen erscheinen hier, sobald Transaktionen On-Chain bestätigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μεταβολές του υπολοίπου σας θα εμφανίζονται εδώ καθώς οι συναλλαγές επιβεβαιώνονται στην αλυσίδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your balance changes will appear here as transactions confirm on-chain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de tu saldo aparecerán aquí a medida que las transacciones se confirmen en la cadena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo muutused ilmuvad siia, kui tehingud ahelas kinnitatakse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییرات موجودی شما همین‌جا نمایش داده می‌شود وقتی تراکنش‌ها روی زنجیره تأیید شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldosi muutokset näkyvät tässä sitä mukaa kuin tapahtumat vahvistuvat ketjussa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga pagbabago sa balanse mo habang nagko-confirm ang mga transaksyon sa chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos changements de solde apparaîtront ici à mesure que les transactions sont confirmées sur la chaîne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינויי היתרה שלך יופיעו כאן ככל שהעסקאות יאושרו ברשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे-जैसे लेन-देन ऑन-चेन पुष्ट होते जाएँगे, आपकी शेष राशि के बदलाव यहाँ दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene stanja prikazivat će se ovdje kako se transakcije potvrđuju u lancu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyenleged változásai itt jelennek meg, ahogy a tranzakciók megerősítést kapnak a láncon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan saldo akan muncul di sini saat transaksi dikonfirmasi di rantai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Breytingar á jafnstöðu birtast hér eftir því sem færslur staðfestast á keðjunni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variazioni del saldo appariranno qui man mano che le transazioni vengono confermate on-chain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引がオンチェーンで承認されると、残高の変化がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온체인에서 거래가 확정되면 잔액 변화가 여기 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Likučio pokyčiai pasirodys čia, kai operacijos bus patvirtintos grandinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlikuma izmaiņas parādīsies šeit, tiklīdz darījumi tiks apstiprināti ķēdē."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇടപാടുകൾ ഓൺ-ചെയിനിൽ സ്ഥിരീകരിക്കുമ്പോൾ നിങ്ങളുടെ ബാലൻസ് മാറ്റങ്ങൾ ഇവിടെ ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवहार ऑन-चेन पुष्ट होताच तुमच्या शिल्लकीतील बदल येथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan baki akan muncul di sini apabila transaksi disahkan dalam rantai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoendringene vises her etter hvert som transaksjoner bekreftes på kjeden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veranderingen in je saldo verschijnen hier zodra transacties on-chain worden bevestigd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਲੈਣ-ਦੇਣ ਆਨ-ਚੇਨ ਪੁਸ਼ਟ ਹੋਣਗੇ ਤਾਂ ਤੁਹਾਡੇ ਬਕਾਇਆ ਵਿੱਚ ਤਬਦੀਲੀਆਂ ਇੱਥੇ ਦਿਖਾਈ ਦੇਣਗੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany salda pojawią się tutaj, gdy transakcje zostaną potwierdzone w łańcuchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações do seu saldo aparecerão aqui à medida que as transações forem confirmadas na blockchain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările soldului tău vor apărea aici pe măsură ce tranzacțiile sunt confirmate pe blockchain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения баланса будут появляться здесь по мере подтверждения транзакций в сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeny zostatku sa zobrazia tu, len čo budú transakcie potvrdené v reťazci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremembe stanja se bodo prikazale tukaj, ko se transakcije potrdijo v verigi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Промене стања ће се појавити овде како се трансакције потврђују на ланцу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoändringarna visas här när transaktionerna bekräftas på kedjan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabadiliko ya salio yako yataonekana hapa kadiri muamala unavyothibitishwa kwenye mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனைகள் சங்கிலியில் உறுதிப்படுத்தப்படும் போது உங்கள் மீதி மாற்றங்கள் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లావాదేవీలు ఆన్-చైన్‌లో నిర్ధారించబడినప్పుడు మీ నిల్వ మార్పులు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงยอดคงเหลือจะปรากฏที่นี่เมื่อธุรกรรมได้รับการยืนยันบนเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler zincir üzerinde onaylandıkça bakiye değişiklikleriniz burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни балансу з’являтимуться тут у міру підтвердження транзакцій у мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بیلنس میں تبدیلیاں یہاں ظاہر ہوں گی جیسے ہی لین دین آن چین تصدیق پائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi số dư của bạn sẽ xuất hiện ở đây khi giao dịch được xác nhận trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当交易在链上确认后,余额变化将显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當交易在鏈上確認後,餘額變化會顯示在此處。"
          }
        }
      }
    },
    "Your Face ID enrollment changed. Authenticate once to trust this iPhone again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou Face ID-registrasie het verander. Verifieer een keer om hierdie iPhone weer te vertrou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر تسجيل Face ID لديك. صادق مرة واحدة لاستعادة الثقة بهذا iPhone."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрацията ви на Face ID се промени. Удостоверете се веднъж, за да се доверите отново на този iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Face ID নিবন্ধন পরিবর্তিত হয়েছে। এই iPhone-কে আবার বিশ্বাস করতে একবার প্রমাণীকরণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu registre de Face ID ha canviat. Autentica't una vegada per tornar a confiar en aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše registrace Face ID se změnila. Jednou se ověřte, abyste tomuto iPhonu znovu důvěřovali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Face ID-registrering er ændret. Godkend én gang for at stole på denne iPhone igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Face-ID-Einrichtung hat sich geändert. Authentifizieren Sie sich einmal, um diesem iPhone wieder zu vertrauen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή σας στο Face ID άλλαξε. Πιστοποιηθείτε μία φορά για να εμπιστευτείτε ξανά αυτό το iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Face ID enrollment changed. Authenticate once to trust this iPhone again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro de Face ID ha cambiado. Autentícate una vez para volver a confiar en este iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu Face ID registreering on muutunud. Autentige üks kord, et seda iPhone'i uuesti usaldada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبت‌نام Face ID شما تغییر کرده است. یک بار احراز هویت کنید تا این iPhone دوباره مورد اعتماد قرار گیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID -rekisteröintisi muuttui. Tunnistaudu kerran luottaaksesi taas tähän iPhoneen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang iyong Face ID enrollment. Mag-authenticate minsan para mapagkatiwalaan muli ang iPhone na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre inscription Face ID a changé. Authentifiez-vous une fois pour faire à nouveau confiance à cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרישום של Face ID השתנה. אמת פעם אחת כדי לסמוך שוב על iPhone זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Face ID एनरोलमेंट बदला है। इस iPhone पर फिर से भरोसा करने के लिए एक बार प्रमाणीकरण करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša Face ID prijava promijenjena je. Autentificirajte se jednom kako biste ponovno vjerovali ovom iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Face ID-regisztrációja megváltozott. Hitelesítse magát egyszer, hogy újra megbízzon ebben az iPhone-ban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran Face ID Anda berubah. Autentikasi sekali untuk mempercayai iPhone ini lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID skráning þín hefur breyst. Auðkenndu þig einu sinni til að treysta þessum iPhone aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua registrazione Face ID è cambiata. Autenticati una volta per dare di nuovo fiducia a questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID の登録内容が変更されました。この iPhone を再度信頼するために、一度認証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 등록이 변경되었습니다. 이 iPhone을 다시 신뢰하려면 한 번 인증하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų Face ID registracija pasikeitė. Vieną kartą patvirtinkite tapatybę, kad vėl pasitikėtumėte šiuo „iPhone“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu Face ID reģistrācija ir mainījusies. Autentificējieties vienreiz, lai atkal uzticētos šim iPhone."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Face ID എൻറോൾമെന്റ് മാറി. ഈ iPhone-നെ വീണ്ടും വിശ്വസിക്കാൻ ഒരിക്കൽ ആധികാരികമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची Face ID नोंदणी बदलली आहे. या iPhone वर पुन्हा विश्वास ठेवण्यासाठी एकदा प्रमाणीकरण करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran Face ID anda berubah. Sahkan sekali untuk mempercayai iPhone ini sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID-registreringen din er endret. Autentiser deg én gang for å stole på denne iPhonen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Face ID-registratie is gewijzigd. Verifieer je eenmaal om deze iPhone weer te vertrouwen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ Face ID ਨਾਮਾਂਕਣ ਬਦਲ ਗਈ ਹੈ। ਇਸ iPhone 'ਤੇ ਮੁੜ ਭਰੋਸਾ ਕਰਨ ਲਈ ਇੱਕ ਵਾਰ ਪ੍ਰਮਾਣਿਤ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rejestracja Face ID się zmieniła. Uwierzytelnij się raz, aby ponownie zaufać temu iPhone’owi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu cadastro do Face ID mudou. Autentique-se uma vez para voltar a confiar neste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea Face ID s-a schimbat. Autentifică-te o dată pentru a avea din nou încredere în acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация Face ID изменилась. Пройдите аутентификацию один раз, чтобы снова доверять этому iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša registrácia Face ID sa zmenila. Raz sa overte, aby ste tomuto iPhonu opäť dôverovali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša registracija Face ID se je spremenila. Enkrat se overite, da boste temu iPhonu znova zaupali."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша Face ID регистрација је промењена. Аутентификујте се једном да поново верујете овом iPhone-у."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Face ID-registrering har ändrats. Autentisera dig en gång för att lita på denna iPhone igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usajili wako wa Face ID umebadilika. Thibitisha mara moja ili kuamini iPhone hii tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Face ID பதிவு மாறிவிட்டது. இந்த iPhone-ஐ மீண்டும் நம்ப ஒரு முறை அங்கீகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Face ID నమోదు మారింది. ఈ iPhone ను మళ్లీ నమ్మడానికి ఒకసారి ప్రామాణీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงทะเบียน Face ID ของคุณเปลี่ยนไปแล้ว ยืนยันตัวตนหนึ่งครั้งเพื่อให้ iPhone นี้น่าเชื่อถืออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID kaydınız değişti. Bu iPhone'a yeniden güvenmek için bir kez kimlik doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша реєстрація Face ID змінилася. Пройдіть автентифікацію один раз, щоб знову довіряти цьому iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا Face ID اندراج تبدیل ہو گیا ہے۔ اس iPhone پر دوبارہ اعتماد کرنے کے لیے ایک بار توثیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký Face ID của bạn đã thay đổi. Hãy xác thực một lần để tin tưởng chiếc iPhone này trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Face ID 注册信息已更改。请认证一次以再次信任此 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Face ID 註冊資訊已變更。請認證一次以再次信任此 iPhone。"
          }
        }
      }
    },
    "Your holdings will appear here.": {
      "extractionState": "manual",
      "localizations": {
