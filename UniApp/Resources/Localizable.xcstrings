            "state": "translated",
            "value": "แชร์ที่อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresi paylaş"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділитися адресою"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پتہ شیئر کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ địa chỉ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享地址"
          }
