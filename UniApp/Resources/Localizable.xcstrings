        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери оригиналну фразу коју си записао — ова реч можда потиче са другог списка речи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera den ursprungliga fras du skrev ner — detta ord kan komma från en annan ordlista."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Angalia kifungu cha asili ulichoandika — neno hili linaweza kutoka kwenye orodha tofauti ya maneno."
