    "Activity will appear here as it happens on-chain.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiwiteit sal hier verskyn sodra dit on-chain gebeur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر النشاط هنا حينما يحدث على السلسلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активността ще се появи тук, когато се случи в мрежата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন-চেইনে ঘটার সাথে সাথে এখানে কার্যকলাপ দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'activitat apareixerà aquí a mesura que es produeixi on-chain."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivita se zde objeví, jakmile proběhne on-chain."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitet vises her, når den sker on-chain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität erscheint hier, sobald sie on-chain stattfindet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δραστηριότητα θα εμφανίζεται εδώ μόλις πραγματοποιείται on-chain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad aparecerá aquí cuando ocurra en la cadena."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegevus ilmub siia kohe, kui see ahelas toimub."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فعالیت‌ها به‌محض رخ‌دادن روی زنجیره اینجا نمایش داده می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiminta näkyy täällä sitä mukaa, kun se tapahtuu lohkoketjussa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas ang aktibidad dito sa pagkakataong mangyari sa on-chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'activité apparaîtra ici à mesure qu'elle se produit on-chain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילות תופיע כאן עם התרחשותה ב-on-chain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गतिविधि होने पर ऑन-चेन यहाँ दिखाई देगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivnost će se ovdje pojaviti čim se dogodi on-chain."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tevékenység itt jelenik meg, ahogy on-chain történik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitas akan muncul di sini saat terjadi di on-chain."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Virkni mun birtast hér um leið og hún gerist on-chain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attività apparirà qui non appena avviene on-chain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェーン上で発生したアクティビティはここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온체인에서 발생하는 활동이 여기에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veikla bus rodoma čia, kai ji įvyks grandinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitāte parādīsies šeit, tiklīdz tā notiek ķēdē."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓൺ-ചെയിനിൽ സംഭവിക്കുമ്പോൾ പ്രവർത്തനം ഇവിടെ പ്രത്യക്ഷപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑन-चेन वर घडल्यानंतर क्रिया येथे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviti akan dipaparkan di sini apabila ia berlaku di on-chain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitet vises her etter hvert som den skjer on-chain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activiteit verschijnt hier zodra deze on-chain plaatsvindt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਨ-ਚੇਨ ਤੇ ਹੋਣ ਤੇ ਸਰਗਰਮੀ ਇੱਥੇ ਦਿਖਾਈ ਦੇਵੇਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywność pojawi się tutaj, gdy nastąpi w łańcuchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atividade aparecerá aqui assim que acontecer on-chain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activitatea va apărea aici pe măsură ce se întâmplă on-chain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активность появится здесь по мере её фиксации в сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivita sa tu zobrazí, hneď ako sa udeje on-chain."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivnost se bo pojavila tukaj, ko se zgodi on-chain."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Активност ће се појавити овде чим се догоди on-chain."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitet visas här när den sker on-chain."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shughuli zitaonekana hapa zinapotokea kwenye mnyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "on-chain இல் நடக்கும்போது இங்கே செயல்பாடு தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆన్-చైన్‌లో జరిగే కొద్దీ కార్యకలాపం ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมจะปรากฏที่นี่เมื่อเกิดขึ้นบนเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik, zincirde gerçekleştikçe burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активність з'явиться тут, щойно вона відбудеться у мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرگرمی یہاں ظاہر ہوگی جیسے ہی یہ آن چین پر ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
