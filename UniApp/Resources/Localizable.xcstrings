    "Swipe a row in Hidden assets to pin it to the top of your wallet home.": {
      "extractionState": "new",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vee oor ’n ry in Versteekte bates om dit bo-aan jou beursie se tuisblad vas te speld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب صفًّا في الأصول المخفية لتثبيته أعلى الصفحة الرئيسية لمحفظتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плъзнете ред в Скрити активи, за да го закачите в горната част на началния екран на портфейла."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট হোমের শীর্ষে পিন করতে লুকানো এসেট-এ একটি সারিতে সোয়াইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llisca una fila a Actius ocults per fixar-la a la part superior de l'inici de la cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
