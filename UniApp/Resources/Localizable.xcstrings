        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara din återställningsfras innan du hoppar över."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifadhi kifungu chako cha urejesho kabla ya kuruka hatua hii."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவிர்ப்பதற்கு முன் உங்கள் மீட்பு சொற்றொடரைச் சேமி."
          }
        },
        "te": {
          "stringUnit": {
