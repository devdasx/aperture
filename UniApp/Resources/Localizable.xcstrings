    "Send is coming next. Aperture will broadcast transactions directly to the chain — no servers in the middle.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur kom volgende. Aperture sal transaksies direk na die chain uitsaai — geen bedieners in die middel nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏الإرسال قادم قريبًا. سيبثّ Aperture المعاملات مباشرة إلى الشبكة — بدون أي خوادم وسيطة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпращането предстои. Aperture ще излъчва транзакциите директно към веригата — без сървъри по средата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঠানোর সুবিধা শীঘ্রই আসছে। Aperture সরাসরি চেইনে লেনদেন সম্প্রচার করবে — মাঝখানে কোনো সার্ভার নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enviament arribarà aviat. Aperture transmetrà les transaccions directament a la cadena, sense servidors enmig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílání přijde brzy. Aperture bude vysílat transakce přímo na řetězec — bez serverů mezi tím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send kommer snart. Aperture sender transaktioner direkte til kæden — uden servere imellem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden folgt bald. Aperture sendet Transaktionen direkt an die Chain — ohne Server dazwischen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποστολή έρχεται σύντομα. Το Aperture θα μεταδίδει συναλλαγές απευθείας στην αλυσίδα — χωρίς διακομιστές στη μέση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send is coming next. Aperture will broadcast transactions directly to the chain — no servers in the middle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío llegará pronto. Aperture transmitirá las transacciones directamente a la cadena, sin servidores intermedios."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatmine on tulekul. Aperture edastab tehinguid otse ahelasse — vahepealsete serverite ilma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏ارسال به‌زودی اضافه می‌شود. Aperture تراکنش‌ها را مستقیماً به شبکه پخش خواهد کرد — بدون هیچ سروری در میانه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetys tulee pian. Aperture välittää tapahtumat suoraan ketjuun — ilman välipalvelimia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Susunod na ang Send. Direktang ibo-broadcast ng Aperture ang mga transaksyon sa chain — walang server sa gitna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi arrive ensuite. Aperture diffusera les transactions directement à la chaîne — sans serveurs intermédiaires."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏שליחה תגיע בקרוב. Aperture ישדר עסקאות ישירות לרשת — ללא שרתים באמצע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने की सुविधा जल्द आ रही है। Aperture लेन-देन को सीधे चेन पर प्रसारित करेगा — बीच में कोई सर्वर नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slanje uskoro stiže. Aperture će transakcije emitirati izravno na lanac — bez poslužitelja u sredini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A küldés hamarosan jön. Az Aperture közvetlenül a láncra továbbítja a tranzakciókat — szerverek nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim akan segera hadir. Aperture akan menyiarkan transaksi langsung ke chain — tanpa server di tengah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending kemur næst. Aperture mun senda færslur beint á keðjuna — engir vefþjónar á milli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invio arriverà prossimamente. Aperture trasmetterà le transazioni direttamente alla chain — senza server intermedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金機能を準備中です。Aperture はサーバーを介さず、トランザクションをチェーンに直接ブロードキャストします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 기능은 다음에 추가됩니다. Aperture는 중간 서버 없이 거래를 체인에 직접 전송합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siuntimas pasirodys netrukus. Aperture transliuos operacijas tiesiai į grandinę — be tarpinių serverių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sūtīšana drīzumā. Aperture pārraidīs darījumus tieši ķēdei — bez starpserveriem."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെൻഡ് അടുത്തതായി വരുന്നു. Aperture ഇടപാടുകൾ നേരിട്ട് chain-ലേക്ക് സംപ്രേഷണം ചെയ്യും — നടുവിൽ സെർവറുകളില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठवणे लवकरच येत आहे. Aperture व्यवहार थेट chain वर प्रसारित करेल — मध्ये कोणतेही सर्व्हर नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar akan datang seterusnya. Aperture akan menyiarkan transaksi terus ke chain — tanpa pelayan di tengah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending kommer snart. Aperture vil kringkaste transaksjoner direkte til kjeden — uten servere imellom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versturen komt eraan. Aperture verzendt transacties rechtstreeks naar de chain — zonder tussenliggende servers."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਭੇਜਣਾ ਅੱਗੇ ਆ ਰਿਹਾ ਹੈ। Aperture ਲੈਣ-ਦੇਣ ਨੂੰ ਸਿੱਧਾ chain ਉੱਤੇ ਪ੍ਰਸਾਰਿਤ ਕਰੇਗਾ — ਵਿਚਕਾਰ ਕੋਈ ਸਰਵਰ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłanie pojawi się wkrótce. Aperture będzie nadawać transakcje bezpośrednio do sieci — bez serwerów pośrednich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio chega em breve. O Aperture transmitirá as transações diretamente para a rede — sem servidores no meio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiterea urmează în curând. Aperture va difuza tranzacțiile direct către rețea — fără servere intermediare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скоро появится отправка. Aperture будет передавать транзакции напрямую в сеть — без серверов посередине."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odosielanie príde čoskoro. Aperture bude transakcie vysielať priamo na reťazec — bez serverov v strede."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljanje sledi. Aperture bo transakcije oddajal neposredno na verigo — brez strežnikov vmes."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слање стиже ускоро. Aperture ће трансакције емитовати директно на ланац — без сервера у средини."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka kommer snart. Aperture sänder transaktioner direkt till kedjan — utan servrar emellan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutuma kunakuja hivi karibuni. Aperture itatangaza miamala moja kwa moja kwenye chain — bila seva katikati."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுப்புதல் அடுத்து வரும். Aperture பரிவர்த்தனைகளை நேரடியாக chain-க்கு ஒளிபரப்பும் — இடையில் சேவையகங்கள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పంపడం త్వరలో రాబోతోంది. Aperture లావాదేవీలను నేరుగా chain కు ప్రసారం చేస్తుంది — మధ్యలో సర్వర్లు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งกำลังจะมา Aperture จะส่งธุรกรรมตรงไปยัง chain — โดยไม่มีเซิร์ฟเวอร์อยู่ตรงกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderme yakında geliyor. Aperture, işlemleri aradaki sunucular olmadan doğrudan zincire yayınlayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання з'явиться згодом. Aperture транслюватиме транзакції безпосередньо в мережу — без жодних серверів посередині."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏بھیجنے کی سہولت جلد آ رہی ہے۔ Aperture لین دین کو براہِ راست chain پر نشر کرے گا — درمیان میں کوئی سرور نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng gửi sẽ sớm có. Aperture sẽ phát các giao dịch trực tiếp tới chain — không có máy chủ ở giữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送功能即将推出。Aperture 会将交易直接广播到链上——中间没有任何服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送功能即將推出。Aperture 會將交易直接廣播到鏈上——中間沒有任何伺服器。"
          }
        }
      }
    },
