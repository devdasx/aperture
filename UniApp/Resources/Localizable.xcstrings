        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "WalletConnect QR ਕੋਡ ਸਕੈਨ ਕਰਨ ਲਈ Aperture ਕੈਮਰਾ ਵਰਤਦਾ ਹੈ। ਜਾਰੀ ਰੱਖਣ ਲਈ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਕੈਮਰਾ ਪਹੁੰਚ ਸਮਰੱਥ ਕਰੋ।"
          }
        }
