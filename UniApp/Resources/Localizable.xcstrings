    "XRP keeps a 1 XRP base reserve (plus 0.2 XRP per object) locked to keep your account open.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP hou 'n 1 XRP-basisreserwe (plus 0.2 XRP per voorwerp) gesluit om jou rekening oop te hou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ XRP باحتياطي أساسي قدره 1 XRP (بالإضافة إلى 0.2 XRP لكل كائن) مقفلًا للحفاظ على فتح حسابك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP държи заключен базов резерв от 1 XRP (плюс 0,2 XRP на обект), за да поддържа акаунта ви отворен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP আপনার অ্যাকাউন্ট খোলা রাখতে ১ XRP মূল সংরক্ষণ (প্লাস প্রতি অবজেক্টে ০.২ XRP) লক করে রাখে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP manté una reserva base d'1 XRP (més 0,2 XRP per objecte) bloquejada per mantenir el teu compte obert."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP drží uzamčenou základní rezervu 1 XRP (plus 0,2 XRP za objekt), aby váš účet zůstal otevřený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP holder en basereserve på 1 XRP (plus 0,2 XRP pr. objekt) låst for at holde din konto åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP hält eine Grundreserve von 1 XRP (plus 0,2 XRP pro Objekt) gesperrt, um dein Konto offen zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το XRP διατηρεί κλειδωμένο ένα βασικό απόθεμα 1 XRP (συν 0,2 XRP ανά αντικείμενο) ώστε ο λογαριασμός σας να παραμένει ανοιχτός."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP mantiene una reserva base de 1 XRP (más 0,2 XRP por objeto) bloqueada para mantener tu cuenta abierta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP hoiab lukus 1 XRP baasreservi (pluss 0,2 XRP objekti kohta), et teie konto püsiks avatuna."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP یک ذخیره‌ی پایه‌ی ۱ XRP (به‌علاوه‌ی ۰٫۲ XRP به ازای هر شیء) را قفل نگه می‌دارد تا حساب شما باز بماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP pitää 1 XRP:n perusvarauksen (sekä 0,2 XRP per objekti) lukittuna pitääkseen tilisi avoinna."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapanatili ng XRP ang 1 XRP base reserve (plus 0.2 XRP bawat object) na naka-lock upang manatiling bukas ang iyong account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP conserve une réserve de base de 1 XRP (plus 0,2 XRP par objet) verrouillée pour garder votre compte ouvert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎XRP שומר רזרבת בסיס של ‎1 XRP (בתוספת ‎0.2 XRP לכל אובייקט) נעולה כדי לשמור על החשבון שלך פתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP आपके अकाउंट को खुला रखने के लिए 1 XRP बेस रिज़र्व (साथ ही प्रति ऑब्जेक्ट 0.2 XRP) लॉक रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP zadržava osnovnu rezervu od 1 XRP (plus 0.2 XRP po objektu) zaključanu kako bi vaš račun ostao otvoren."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az XRP 1 XRP alaptartalékot (plusz objektumonként 0,2 XRP-t) zárolva tart, hogy a fiókod nyitva maradjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP mengunci cadangan dasar 1 XRP (ditambah 0,2 XRP per objek) untuk menjaga akun Anda tetap terbuka."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP heldur 1 XRP grunnvarasjóði (auk 0,2 XRP á hvern hlut) læstum til að halda reikningnum þínum opnum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP mantiene bloccata una riserva base di 1 XRP (più 0,2 XRP per oggetto) per mantenere aperto il tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP はアカウントを開いたままにするため、基本予備の 1 XRP（およびオブジェクトごとに 0.2 XRP）をロックして保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP는 계정을 열어 두기 위해 1 XRP 기본 예치금(객체당 0.2 XRP 추가)을 잠가 둡니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP užrakina 1 XRP bazinį rezervą (plius 0,2 XRP už objektą), kad jūsų paskyra liktų atvira."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP patur bloķētu 1 XRP pamatrezervi (plus 0,2 XRP par objektu), lai jūsu konts paliktu atvērts."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് തുറന്നുവയ്ക്കാൻ XRP 1 XRP ബേസ് റിസർവ് (ഒരു ഒബ്ജക്റ്റിന് അധികമായി 0.2 XRP) ലോക്ക് ചെയ്തുവയ്ക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे खाते उघडे ठेवण्यासाठी XRP 1 XRP बेस रिझर्व्ह (अधिक प्रति ऑब्जेक्ट 0.2 XRP) लॉक करून ठेवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP mengunci rizab asas 1 XRP (tambah 0.2 XRP setiap objek) untuk mengekalkan akaun anda terbuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP holder en basereserve på 1 XRP (pluss 0,2 XRP per objekt) låst for å holde kontoen din åpen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP houdt een basisreserve van 1 XRP vast (plus 0,2 XRP per object) om je account open te houden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP ਤੁਹਾਡਾ ਖਾਤਾ ਖੁੱਲ੍ਹਾ ਰੱਖਣ ਲਈ 1 XRP ਬੇਸ ਰਿਜ਼ਰਵ (ਨਾਲ ਹੀ ਪ੍ਰਤੀ ਆਬਜੈਕਟ 0.2 XRP) ਲੌਕ ਰੱਖਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP utrzymuje zablokowaną rezerwę bazową 1 XRP (oraz 0,2 XRP na obiekt), aby Twoje konto pozostało otwarte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O XRP mantém uma reserva base de 1 XRP (mais 0,2 XRP por objeto) bloqueada para manter sua conta aberta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP păstrează blocată o rezervă de bază de 1 XRP (plus 0,2 XRP per obiect) pentru a-ți menține contul deschis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP удерживает базовый резерв 1 XRP (плюс 0,2 XRP за объект), чтобы ваш счёт оставался открытым."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP ponecháva základnú rezervu 1 XRP (plus 0.2 XRP za objekt) zamknutú, aby váš účet zostal otvorený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP ohrani osnovno rezervo 1 XRP (plus 0.2 XRP na objekt) zaklenjeno, da vaš račun ostane odprt."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP drži osnovnu rezervu od 1 XRP (plus 0,2 XRP po objektu) zaključanu da bi vaš nalog ostao otvoren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP håller en basreserv på 1 XRP (plus 0,2 XRP per objekt) låst för att hålla ditt konto öppet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP huweka akiba ya msingi ya XRP 1 (pamoja na XRP 0.2 kwa kila kitu) imefungwa ili kuweka akaunti yako wazi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கைத் திறந்து வைத்திருக்க XRP 1 XRP அடிப்படை இருப்பை (ஒவ்வொரு பொருளுக்கும் கூடுதலாக 0.2 XRP) பூட்டி வைக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖాతాను తెరిచి ఉంచడానికి XRP 1 XRP బేస్ రిజర్వ్‌ను (ఒక్కో ఆబ్జెక్ట్‌కు అదనంగా 0.2 XRP) లాక్ చేసి ఉంచుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP ล็อกสำรองพื้นฐาน 1 XRP (บวก 0.2 XRP ต่อออบเจกต์) ไว้เพื่อให้บัญชีของคุณเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP, hesabınızı açık tutmak için 1 XRP'lik bir temel rezervi (artı nesne başına 0,2 XRP) kilitli tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP утримує заблокованим базовий резерв 1 XRP (плюс 0,2 XRP за об’єкт), щоб ваш рахунок залишався відкритим."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP آپ کے اکاؤنٹ کو کھلا رکھنے کے لیے 1 XRP بنیادی ریزرو (اور فی آبجیکٹ 0.2 XRP) مقفل رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP giữ khóa một khoản dự trữ cơ bản 1 XRP (cộng thêm 0,2 XRP mỗi đối tượng) để giữ tài khoản của bạn mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP 会锁定 1 XRP 基础储备金（每个对象再加 0.2 XRP）以保持你的账户开通。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP 會鎖定 1 XRP 基礎儲備金（每個物件再加 0.2 XRP）以保持你的帳戶開通。"
          }
        }
      }
    },
