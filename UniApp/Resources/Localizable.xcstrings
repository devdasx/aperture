    "Paste one or more %@ addresses. Aperture reads balances and transactions only — it cannot send.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een of meer %@-adresse in. Aperture lees slegs saldo’s en transaksies — dit kan nie stuur nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق عنوانًا أو أكثر من عناوين %@. يقرأ Aperture الأرصدة والمعاملات فقط — ولا يستطيع الإرسال."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете един или повече адреси за %@. Aperture чете само салда и транзакции — не може да изпраща."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক বা একাধিক %@ অ্যাড্রেস পেস্ট করুন। Aperture শুধু ব্যালেন্স ও লেনদেন পড়ে — পাঠাতে পারে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enganxa una o més adreces %@. Aperture només llegeix saldos i transaccions — no pot enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlož jednu nebo více adres %@. Aperture čte pouze zůstatky a transakce — nemůže odesílat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt en eller flere %@-adresser. Aperture læser kun saldi og transaktioner — den kan ikke sende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine oder mehrere %@-Adressen ein. Aperture liest nur Guthaben und Transaktionen – senden kann es nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλήστε μία ή περισσότερες διευθύνσεις %@. Το Aperture διαβάζει μόνο υπόλοιπα και συναλλαγές — δεν μπορεί να στείλει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una o más direcciones de %@. Aperture solo lee saldos y transacciones; no puede enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleepige üks või mitu %@ aadressi. Aperture loeb ainult saldosid ja tehinguid — saata ei saa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک یا چند آدرس %@ را بچسبانید. Aperture فقط موجودی و تراکنش‌ها را می‌خواند — توان ارسال ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä yksi tai useampi %@-osoite. Aperture lukee vain saldoja ja tapahtumia — se ei voi lähettää."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-paste ang isa o higit pang %@ na address. Binabasa lang ng Aperture ang mga balanse at transaksyon — hindi ito makakapagpadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une ou plusieurs adresses %@. Aperture lit uniquement les soldes et les transactions — il ne peut pas envoyer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק כתובת %@ אחת או יותר. Aperture קורא יתרות ועסקאות בלבד — הוא אינו יכול לשלוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक या एक से अधिक %@ पते पेस्ट करें। Aperture केवल शेष राशि और लेन-देन पढ़ता है — भेज नहीं सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepite jednu ili više %@ adresa. Aperture čita samo stanja i transakcije — ne može slati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illessz be egy vagy több %@ címet. Az Aperture csak egyenlegeket és tranzakciókat olvas — nem tud küldeni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempelkan satu atau lebih alamat %@. Aperture hanya membaca saldo dan transaksi — tidak dapat mengirim."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu inn eitt eða fleiri %@ vistföng. Aperture les aðeins stöðu og færslur — getur ekki sent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla uno o più indirizzi %@. Aperture legge soltanto saldi e transazioni — non può inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のアドレスを1つ以上貼り付けてください。Aperture は残高と取引の読み取りだけを行い、送付はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 이상의 %@ 주소를 붙여넣으세요. Aperture는 잔액과 거래만 읽으며 — 전송은 할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijuokite vieną ar daugiau %@ adresų. Aperture skaito tik likučius ir operacijas – siųsti negali."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielīmējiet vienu vai vairākas %@ adreses. Aperture lasa tikai bilances un darījumus — sūtīt nevar."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നോ അതിലധികമോ %@ വിലാസങ്ങൾ പേസ്റ്റ് ചെയ്യുക. Aperture ബാലൻസുകളും ഇടപാടുകളും മാത്രം വായിക്കുന്നു — അതിന് അയയ്ക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक किंवा अधिक %@ पत्ते पेस्ट करा. Aperture फक्त शिल्लक आणि व्यवहार वाचते — ते पाठवू शकत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal satu atau lebih alamat %@. Aperture hanya membaca baki dan transaksi — ia tidak boleh menghantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn en eller flere %@-adresser. Aperture leser bare saldoer og transaksjoner — den kan ikke sende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een of meer %@-adressen. Aperture leest alleen saldi en transacties — hij kan niet versturen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਜਾਂ ਵੱਧ %@ ਪਤੇ ਪੇਸਟ ਕਰੋ। Aperture ਸਿਰਫ਼ ਬੈਲੰਸ ਅਤੇ ਲੈਣ-ਦੇਣ ਪੜ੍ਹਦਾ ਹੈ — ਇਹ ਭੇਜ ਨਹੀਂ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej jeden lub więcej adresów %@. Aperture odczytuje tylko salda i transakcje — nie może wysyłać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um ou mais endereços %@. O Aperture só lê saldos e transações — não consegue enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește una sau mai multe adrese %@. Aperture citește doar solduri și tranzacții — nu poate trimite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте один или несколько адресов %@. Aperture только читает балансы и транзакции — отправлять он не умеет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlož jednu alebo viac adries %@. Aperture číta iba zostatky a transakcie — nedokáže odosielať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilepi enega ali več naslovov %@. Aperture bere samo stanja in transakcije – ne more pošiljati."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налепи једну или више %@ адреса. Aperture чита само стања и трансакције – не може да шаље."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in en eller flera %@-adresser. Aperture läser endast saldon och transaktioner — den kan inte skicka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandika anwani moja au zaidi za %@. Aperture inasoma salio na miamala pekee — haiwezi kutuma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒன்று அல்லது அதற்கு மேற்பட்ட %@ முகவரிகளை ஒட்டவும். Aperture இருப்புகளையும் பரிவர்த்தனைகளையும் மட்டுமே படிக்கிறது — அதனால் அனுப்ப முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకటి లేదా అంతకంటే ఎక్కువ %@ చిరునామాలను పేస్ట్ చేయండి. Aperture నిల్వలు మరియు లావాదేవీలను మాత్రమే చదువుతుంది — అది పంపలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางแอดเดรส %@ หนึ่งรายการขึ้นไป Aperture จะอ่านยอดคงเหลือและธุรกรรมเท่านั้น — ไม่สามารถส่งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir veya daha fazla %@ adresini yapıştırın. Aperture yalnızca bakiyeleri ve işlemleri okur — gönderim yapamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте одну або кілька адрес %@. Aperture зчитує лише баланси й транзакції — він не може надсилати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک یا زیادہ %@ ایڈریسز پیسٹ کریں۔ Aperture صرف بیلنس اور ٹرانزیکشنز پڑھتا ہے — یہ بھیج نہیں سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán một hoặc nhiều địa chỉ %@. Aperture chỉ đọc số dư và giao dịch — không thể gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴一个或多个 %@ 地址。Aperture 仅读取余额和交易——无法发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上一個或多個 %@ 位址。Aperture 只讀取餘額與交易——無法傳送。"
          }
        }
      }
    },
    "Paste one or more addresses you already own. For Bitcoin, Litecoin, or Dogecoin you can also paste an extended public key, and Aperture will derive the wallet's receive addresses for you.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een of meer adresse wat reeds joune is. Vir Bitcoin, Litecoin of Dogecoin kan jy ook ’n uitgebreide openbare sleutel plak en Aperture sal die ontvangsadresse van die beursie vir jou aflei."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق عنوانًا أو أكثر تملكه بالفعل. وبالنسبة لـ Bitcoin أو Litecoin أو Dogecoin يمكنك أيضًا لصق مفتاح عام ممتد، وسيشتق Aperture لك عناوين الاستلام الخاصة بالمحفظة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете един или повече адреси, които вече притежавате. За Bitcoin, Litecoin или Dogecoin можете да поставите и разширен публичен ключ, а Aperture ще извлече вместо вас приемащите адреси на портфейла."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইতিমধ্যে থাকা এক বা একাধিক অ্যাড্রেস পেস্ট করুন। Bitcoin, Litecoin বা Dogecoin-এর জন্য আপনি একটি এক্সটেন্ডেড পাবলিক কী-ও পেস্ট করতে পারেন, এবং Aperture আপনার জন্য সেই ওয়ালেটের গ্রহণযোগ্য অ্যাড্রেসগুলো বের করে দেবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enganxa una o més adreces que ja posseeixes. Per a Bitcoin, Litecoin o Dogecoin també pots enganxar una clau pública estesa, i Aperture derivarà per a tu les adreces de recepció de la cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlož jednu nebo více adres, které již vlastníš. Pro Bitcoin, Litecoin nebo Dogecoin můžeš vložit i rozšířený veřejný klíč a Aperture za tebe odvodí přijímací adresy peněženky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt en eller flere adresser, du allerede ejer. Til Bitcoin, Litecoin eller Dogecoin kan du også indsætte en udvidet offentlig nøgle, og Aperture afleder tegnebogens modtageradresser for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine oder mehrere Adressen ein, die dir bereits gehören. Für Bitcoin, Litecoin oder Dogecoin kannst du auch einen erweiterten öffentlichen Schlüssel einfügen, und Aperture leitet dir die Empfangsadressen der Wallet ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλήστε μία ή περισσότερες διευθύνσεις που ήδη κατέχετε. Για Bitcoin, Litecoin ή Dogecoin μπορείτε επίσης να επικολλήσετε ένα εκτεταμένο δημόσιο κλειδί, και το Aperture θα παραγάγει για εσάς τις διευθύνσεις λήψης του πορτοφολιού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una o más direcciones que ya posees. Para Bitcoin, Litecoin o Dogecoin también puedes pegar una clave pública extendida, y Aperture derivará por ti las direcciones de recepción de la cartera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleepige üks või mitu aadressi, mis teile juba kuuluvad. Bitcoini, Litecoini või Dogecoini puhul võite kleepida ka laiendatud avaliku võtme ning Aperture tuletab teie eest selle rahakoti vastuvõtuaadressid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک یا چند آدرسی را که از قبل در اختیار دارید بچسبانید. برای Bitcoin، Litecoin یا Dogecoin می‌توانید یک کلید عمومی گسترش‌یافته نیز بچسبانید و Aperture آدرس‌های دریافت کیف پول را برای شما استخراج می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä yksi tai useampi osoite, joka on jo sinun. Bitcoinia, Litecoinia tai Dogecoinia varten voit liittää myös laajennetun julkisen avaimen, ja Aperture johtaa puolestasi lompakon vastaanotto-osoitteet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-paste ang isa o higit pang mga address na pag-aari mo na. Para sa Bitcoin, Litecoin, o Dogecoin, maaari ka ring mag-paste ng extended public key, at kukunin ng Aperture para sa iyo ang mga receive address ng wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une ou plusieurs adresses que vous possédez déjà. Pour Bitcoin, Litecoin ou Dogecoin, vous pouvez aussi coller une clé publique étendue, et Aperture dérivera pour vous les adresses de réception du portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק כתובת אחת או יותר שכבר בבעלותך. עבור Bitcoin, Litecoin או Dogecoin אפשר גם להדביק מפתח ציבורי מורחב, ו־Aperture יגזור עבורך את כתובות הקבלה של הארנק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पहले से मौजूद एक या अधिक पते पेस्ट करें। Bitcoin, Litecoin या Dogecoin के लिए आप एक एक्सटेंडेड पब्लिक कुंजी भी पेस्ट कर सकते हैं, और Aperture आपके लिए उस वॉलेट के प्राप्ति पते निकाल देगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepite jednu ili više adresa koje već posjedujete. Za Bitcoin, Litecoin ili Dogecoin možete zalijepiti i prošireni javni ključ, a Aperture će za vas izvesti adrese za primanje novčanika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illessz be egy vagy több címet, ami már a tied. Bitcoin, Litecoin vagy Dogecoin esetén beilleszthetsz egy kiterjesztett nyilvános kulcsot is, és az Aperture leszármaztatja számodra a tárca fogadó címeit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempelkan satu atau lebih alamat yang sudah Anda miliki. Untuk Bitcoin, Litecoin, atau Dogecoin Anda juga dapat menempelkan kunci publik yang diperluas, dan Aperture akan menurunkan alamat penerima dompet itu untuk Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu inn eitt eða fleiri vistföng sem þú átt nú þegar. Fyrir Bitcoin, Litecoin eða Dogecoin geturðu einnig límt inn framlengdan opinberan lykil og Aperture mun leiða fram móttökuvistföng veskisins fyrir þig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla uno o più indirizzi che possiedi già. Per Bitcoin, Litecoin o Dogecoin puoi anche incollare una chiave pubblica estesa, e Aperture deriverà per te gli indirizzi di ricezione del wallet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに所有しているアドレスを1つ以上貼り付けてください。Bitcoin、Litecoin、Dogecoin の場合は拡張公開鍵を貼り付けることもでき、Aperture がそのウォレットの受取アドレスを導き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 소유한 하나 이상의 주소를 붙여넣으세요. Bitcoin, Litecoin, Dogecoin의 경우 확장 공개 키를 붙여넣을 수도 있으며, Aperture가 지갑의 수신 주소들을 자동으로 도출해 드립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijuokite vieną ar daugiau adresų, kurie jau yra jūsų. Bitcoin, Litecoin ar Dogecoin atveju galite įklijuoti ir išplėstinį viešąjį raktą – Aperture jums išves piniginės gavimo adresus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielīmējiet vienu vai vairākas adreses, kas jau pieder jums. Bitcoin, Litecoin vai Dogecoin gadījumā varat ielīmēt arī paplašināto publisko atslēgu, un Aperture jums atvasinās maka saņemšanas adreses."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതിനകം സ്വന്തമാക്കിയ ഒന്നോ അതിലധികമോ വിലാസങ്ങൾ പേസ്റ്റ് ചെയ്യുക. Bitcoin, Litecoin, അല്ലെങ്കിൽ Dogecoin-നായി നിങ്ങൾക്ക് ഒരു എക്സ്റ്റൻഡഡ് പബ്ലിക് കീയും പേസ്റ്റ് ചെയ്യാം, Aperture നിങ്ങൾക്കായി വാലറ്റിന്റെ സ്വീകരണ വിലാസങ്ങൾ ഉരുത്തിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या आधीच मालकीचे एक किंवा अधिक पत्ते पेस्ट करा. Bitcoin, Litecoin, किंवा Dogecoin साठी तुम्ही एक्सटेंडेड पब्लिक की देखील पेस्ट करू शकता, आणि Aperture तुमच्यासाठी वॉलेटचे प्राप्ती पत्ते मिळवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal satu atau lebih alamat yang sudah menjadi milik anda. Untuk Bitcoin, Litecoin atau Dogecoin anda juga boleh menampal kunci awam dilanjutkan, dan Aperture akan menerbitkan alamat penerima dompet untuk anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn en eller flere adresser du allerede eier. For Bitcoin, Litecoin eller Dogecoin kan du også lime inn en utvidet offentlig nøkkel, og Aperture vil utlede lommebokens mottakeradresser for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een of meer adressen die je al bezit. Voor Bitcoin, Litecoin of Dogecoin kun je ook een uitgebreide publieke sleutel plakken; Aperture leidt dan de ontvangstadressen van de wallet voor je af."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਇੱਕ ਜਾਂ ਵੱਧ ਪਤੇ ਪੇਸਟ ਕਰੋ ਜੋ ਪਹਿਲਾਂ ਹੀ ਤੁਹਾਡੇ ਆਪਣੇ ਹਨ। Bitcoin, Litecoin ਜਾਂ Dogecoin ਲਈ ਤੁਸੀਂ ਇੱਕ ਵਿਸਥਾਰਿਤ ਪਬਲਿਕ ਕੀ ਵੀ ਪੇਸਟ ਕਰ ਸਕਦੇ ਹੋ ਅਤੇ Aperture ਤੁਹਾਡੇ ਲਈ ਉਸ ਵਾਲਿਟ ਦੇ ਪ੍ਰਾਪਤ ਪਤੇ ਬਣਾ ਦੇਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej jeden lub więcej adresów, które już posiadasz. W przypadku Bitcoina, Litecoina lub Dogecoina możesz wkleić również rozszerzony klucz publiczny — Aperture wyprowadzi za ciebie adresy odbiorcze portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um ou mais endereços que você já tem. Para Bitcoin, Litecoin ou Dogecoin você também pode colar uma chave pública estendida, e o Aperture vai derivar os endereços de recebimento da carteira para você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește una sau mai multe adrese pe care le deții deja. Pentru Bitcoin, Litecoin sau Dogecoin poți lipi și o cheie publică extinsă, iar Aperture va deriva pentru tine adresele de primire ale portofelului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте один или несколько адресов, которыми вы уже владеете. Для Bitcoin, Litecoin или Dogecoin вы также можете вставить расширенный публичный ключ, и Aperture сам выведет для вас адреса получения этого кошелька."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlož jednu alebo viac adries, ktoré už vlastníš. Pre Bitcoin, Litecoin alebo Dogecoin môžeš vložiť aj rozšírený verejný kľúč a Aperture za teba odvodí prijímacie adresy peňaženky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilepi enega ali več naslovov, ki jih že imaš. Za Bitcoin, Litecoin ali Dogecoin lahko prilepiš tudi razširjeni javni ključ, in Aperture bo zate izpeljal prejemne naslove denarnice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налепи једну или више адреса које већ поседујеш. За Bitcoin, Litecoin или Dogecoin можеш да налепиш и проширени јавни кључ, а Aperture ће за тебе извести пријемне адресе тог новчаника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in en eller flera adresser som du redan äger. För Bitcoin, Litecoin eller Dogecoin kan du också klistra in en utökad publik nyckel, så härleder Aperture mottagaradresserna för plånboken åt dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandika anwani moja au zaidi ambazo tayari ni zako. Kwa Bitcoin, Litecoin au Dogecoin unaweza pia kubandika ufunguo wa umma uliopanuliwa, na Aperture itazalisha anwani za kupokea za pochi kwa ajili yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கனவே சொந்தமாக வைத்திருக்கும் ஒன்று அல்லது அதற்கு மேற்பட்ட முகவரிகளை ஒட்டவும். Bitcoin, Litecoin, அல்லது Dogecoin-இற்கு நீட்டிக்கப்பட்ட பொதுச் சாவியையும் ஒட்டலாம், Aperture உங்களுக்காக வாலட்டின் பெறும் முகவரிகளைப் பெறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పటికే సొంతం చేసుకున్న ఒకటి లేదా అంతకంటే ఎక్కువ చిరునామాలను పేస్ట్ చేయండి. Bitcoin, Litecoin, లేదా Dogecoin కోసం మీరు ఎక్స్‌టెండెడ్ పబ్లిక్ కీని కూడా పేస్ట్ చేయవచ్చు, మరియు Aperture మీ కోసం వాలెట్ యొక్క స్వీకరణ చిరునామాలను పొందుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางแอดเดรสหนึ่งรายการขึ้นไปที่คุณเป็นเจ้าของอยู่แล้ว สำหรับ Bitcoin, Litecoin หรือ Dogecoin คุณยังสามารถวางคีย์สาธารณะแบบขยายได้ และ Aperture จะสืบหาแอดเดรสรับเงินของกระเป๋านั้นให้คุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Halihazırda sahip olduğunuz bir veya daha fazla adresi yapıştırın. Bitcoin, Litecoin veya Dogecoin için ayrıca bir genişletilmiş genel anahtar da yapıştırabilirsiniz; Aperture cüzdanın alıcı adreslerini sizin için türetecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте одну або кілька адрес, якими ви вже володієте. Для Bitcoin, Litecoin або Dogecoin ви також можете вставити розширений публічний ключ, і Aperture виведе для вас адреси отримання гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک یا زیادہ ایسے ایڈریسز پیسٹ کریں جو پہلے سے آپ کی ملکیت میں ہیں۔ Bitcoin، Litecoin یا Dogecoin کے لیے آپ ایک توسیعی پبلک کی بھی پیسٹ کر سکتے ہیں اور Aperture آپ کے لیے اس والیٹ کے وصول کنندہ ایڈریسز اخذ کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán một hoặc nhiều địa chỉ mà bạn đã sở hữu. Với Bitcoin, Litecoin hoặc Dogecoin, bạn cũng có thể dán một khóa công khai mở rộng và Aperture sẽ dẫn ra các địa chỉ nhận của ví giúp bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你已拥有的一个或多个地址。对于比特币、莱特币或狗狗币,你也可以粘贴一个扩展公钥,Aperture 会为你推导出该钱包的接收地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你已擁有的一個或多個位址。對於比特幣、萊特幣或狗狗幣,你也可以貼上一個擴展公鑰,Aperture 會為你推導出該錢包的接收位址。"
          }
        }
      }
    },
