          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш приватный ключ остаётся вашим. Вы можете снова импортировать этот кошелёк с ним — сервера нет, и удаление здесь не теряет ничего из сохранённого вами."
