        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mister du den, er midlerne væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlieren Sie sie, ist das Guthaben weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν τη χάσετε, τα κεφάλαια χάνονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose it, the funds are gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la pierdes, los fondos se pierden."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaotad selle, on raha läinud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر گمش کنید، دارایی‌ها از دست می‌روند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos menetät sen, varat ovat poissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag nawala ito, wala na ang pondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous la perdez, les fonds sont perdus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תאבד אותו, הכספים נעלמים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे खो दिया, तो धन भी गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je izgubite, sredstva su nestala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha elveszíti, a pénzeszközök elvesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika hilang, dana ikut hilang."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú týnir henni, þá eru fjármunirnir farnir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la perde, i fondi sono persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失えば、資金も失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잃어버리면 자금도 사라집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Praradę ją, prarandate ir lėšas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja to pazaudēsiet, līdzekļi būs pazuduši."
