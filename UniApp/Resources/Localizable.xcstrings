          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt mellom kjeder i én flyt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel tussen netwerken in één stroom."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕੋ ਫਲੋ ਵਿੱਚ ਚੇਨਾਂ ਵਿਚਕਾਰ ਸਵੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
