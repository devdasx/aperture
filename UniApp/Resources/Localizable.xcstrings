          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabasa ang mga balanse mula sa mga pampublikong network. Ang Aperture mismo ay walang ipinapadala — ngunit maaaring i-log ng pampublikong mga RPC provider ang mga kahilingan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
