        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvjeti pružanja usluge još nisu napisani. Aperture je otvorenog koda — jedina stvar koja danas uređuje vaše korištenje aplikacije je MIT licenca u repozitoriju."
