          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фраза восстановления, которую вы только что видели, будет отброшена. Вам нужно будет начать процесс создания заново, если вы передумаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovovacia fráza, ktorú ste práve videli, sa zahodí. Ak si to rozmyslíte, budete musieť proces vytvárania začať odznova."
          }
        },
        "sl": {
          "stringUnit": {
