          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a Fogadás gombra, hogy lássa a címét minden láncon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Terima untuk melihat alamat Anda di setiap chain."
