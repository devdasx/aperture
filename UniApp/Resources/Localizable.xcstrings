    "Re-enables the security warning that appears before you import a recovery phrase or private key.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiveer weer die sekuriteitswaarskuwing wat verskyn voordat jy 'n herstelfrase of privaat sleutel invoer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعيد تفعيل تحذير الأمان الذي يظهر قبل استيراد عبارة الاسترداد أو المفتاح الخاص."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активира отново предупреждението за сигурност, което се появява, преди да импортирате фраза за възстановяване или частен ключ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিকভারি ফ্রেজ বা প্রাইভেট কী ইম্পোর্ট করার আগে যে নিরাপত্তা সতর্কতা দেখানো হয়, সেটি আবার চালু করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a activar l'avís de seguretat que apareix abans d'importar una frase de recuperació o una clau privada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu zapne bezpečnostní upozornění, které se zobrazí předtím, než importujete obnovovací frázi nebo privátní klíč."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverer igen sikkerhedsadvarslen, der vises før du importerer en gendannelsesfrase eller privat nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert die Sicherheitswarnung erneut, die vor dem Import einer Wiederherstellungs-Phrase oder eines privaten Schlüssels angezeigt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επανενεργοποιεί την προειδοποίηση ασφαλείας που εμφανίζεται πριν εισαγάγετε φράση ανάκτησης ή ιδιωτικό κλειδί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-enables the security warning that appears before you import a recovery phrase or private key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a activar la advertencia de seguridad que aparece antes de importar una frase de recuperación o una clave privada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lubab uuesti turvahoiatuse, mis ilmub enne taastefraasi või privaatvõtme importimist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدار امنیتی که پیش از وارد کردن عبارت بازیابی یا کلید خصوصی ظاهر می‌شود را دوباره فعال می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottaa uudelleen käyttöön suojavaroituksen, joka näkyy ennen palautuslauseen tai yksityisen avaimen tuontia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Muling pinagagana ang security warning na lumalabas bago ka mag-import ng recovery phrase o private key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réactive l'avertissement de sécurité qui apparaît avant l'importation d'une phrase de récupération ou d'une clé privée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל מחדש את אזהרת האבטחה שמופיעה לפני ייבוא ביטוי שחזור או מפתח פרטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी फ़्रेज़ या प्राइवेट की इम्पोर्ट करने से पहले दिखने वाली सुरक्षा चेतावनी को फिर से सक्षम करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno omogućuje sigurnosno upozorenje koje se pojavljuje prije uvoza fraze za oporavak ili privatnog ključa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra engedélyezi a biztonsági figyelmeztetést, amely a helyreállítási mondat vagy privát kulcs importálása előtt jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkan kembali peringatan keamanan yang muncul sebelum Anda mengimpor frasa pemulihan atau kunci pribadi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Virkjar aftur öryggisviðvörun sem birtist áður en þú flytur inn endurheimtarsetningu eða einkalykil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riabilita l'avviso di sicurezza che appare prima di importare una frase di recupero o una chiave privata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズや秘密鍵をインポートする前に表示されるセキュリティ警告を再有効化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 구문이나 개인 키를 가져오기 전에 표시되는 보안 경고를 다시 활성화합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iš naujo įjungia saugumo įspėjimą, kuris rodomas prieš importuojant atkūrimo frazę arba privačiąjį raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atkārtoti iespējo drošības brīdinājumu, kas parādās pirms atkopšanas frāzes vai privātās atslēgas importēšanas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീണ്ടെടുക്കൽ വാചകം അല്ലെങ്കിൽ പ്രൈവറ്റ് കീ ഇറക്കുമതി ചെയ്യും മുമ്പ് കാണിക്കുന്ന സുരക്ഷാ മുന്നറിയിപ്പ് വീണ്ടും പ്രവർത്തനക്ഷമമാക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही रिकव्हरी वाक्यरचना किंवा खाजगी की आयात करण्यापूर्वी दिसणारी सुरक्षा चेतावणी पुन्हा सक्षम करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkan semula amaran keselamatan yang muncul sebelum anda mengimport frasa pemulihan atau kunci peribadi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverer på nytt sikkerhetsadvarselen som vises før du importerer en gjenopprettingsfrase eller privat nøkkel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt de beveiligingswaarschuwing weer in die verschijnt voordat je een herstelzin of privésleutel importeert."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਸੁਰੱਖਿਆ ਚੇਤਾਵਨੀ ਮੁੜ ਯੋਗ ਕਰਦਾ ਹੈ ਜੋ ਤੁਸੀਂ ਰਿਕਵਰੀ ਵਾਕ ਜਾਂ ਪ੍ਰਾਈਵੇਟ ਕੀ ਆਯਾਤ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਦਿਖਾਈ ਦਿੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie włącza ostrzeżenie bezpieczeństwa wyświetlane przed importem frazy odzyskiwania lub klucza prywatnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reativa o aviso de segurança exibido antes de você importar uma frase de recuperação ou chave privada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactivează avertismentul de securitate care apare înainte de a importa o frază de recuperare sau o cheie privată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова включает предупреждение о безопасности, которое появляется перед импортом фразы восстановления или приватного ключа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu zapne bezpečnostné upozornenie, ktoré sa zobrazí pred importom frázy na obnovenie alebo súkromného kľúča."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova omogoči varnostno opozorilo, ki se prikaže pred uvozom obnovitvene fraze ali zasebnega ključa."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Поново омогућава безбедносно упозорење које се појављује пре него што увезете фразу за опоравак или приватни кључ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverar igen säkerhetsvarningen som visas innan du importerar en återställningsfras eller privat nyckel."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inawasha upya onyo la usalama linaloonekana kabla ya kuingiza kifungu cha kurejesha au ufunguo wa faragha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்டெடுப்பு சொற்றொடரையோ தனிப்பட்ட சாவியையோ இறக்குமதி செய்வதற்கு முன்னர் தோன்றும் பாதுகாப்பு எச்சரிக்கையை மீண்டும் இயக்குகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు రికవరీ పదబంధం లేదా ప్రైవేట్ కీని దిగుమతి చేయడానికి ముందు కనిపించే భద్రతా హెచ్చరికను తిరిగి ప్రారంభిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้คำเตือนความปลอดภัยที่ปรากฏก่อนนำเข้าวลีกู้คืนหรือคีย์ส่วนตัวอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kurtarma ifadesini veya özel anahtarı içe aktarmadan önce görünen güvenlik uyarısını yeniden etkinleştirir."
          }
        },
        "uk": {
          "stringUnit": {
