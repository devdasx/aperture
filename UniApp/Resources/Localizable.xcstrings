          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakopya. Magbabakante ang clipboard sa loob ng 60 segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié. Le presse-papiers s'efface dans 60 secondes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועתק. הלוח יתנקה בעוד 60 שניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी हो गया। क्लिपबोर्ड 60 सेकंड में साफ़ हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirano. Međuspremnik se briše za 60 sekundi."
          }
        },
        "hu": {
