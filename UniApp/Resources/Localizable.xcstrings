          "stringUnit": {
            "state": "translated",
            "value": "Detta är en utökad publik nyckel. Använd Endast visning istället."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huu ni ufunguo wa umma uliopanuliwa. Tumia Kuangalia tu badala yake."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது விரிவாக்கப்பட்ட பொது சாவி. அதற்கு பதிலாக பார்வையிட மட்டும் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది విస్తరించిన పబ్లిక్ కీ. బదులుగా వీక్షణ-మాత్రమే ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือคีย์สาธารณะแบบขยาย ใช้ดูอย่างเดียวแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, genişletilmiş bir genel anahtardır. Bunun yerine Yalnızca izleme kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це розширений публічний ключ. Замість цього використайте Лише перегляд."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایک توسیعی پبلک کلید ہے۔ اس کے بجائے صرف-دیکھنے والا استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là khóa công khai mở rộng. Hãy dùng Chỉ xem thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一个扩展公钥。请改用仅监视。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是一個延伸公鑰。請改用僅監看。"
          }
        }
      }
    },
