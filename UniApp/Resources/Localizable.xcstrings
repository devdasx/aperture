        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 위치의 단어를 선택해 문구를 저장했는지 확인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite žodį kiekvienoje pozicijoje, kad patvirtintumėte, jog išsaugojote frazę."
