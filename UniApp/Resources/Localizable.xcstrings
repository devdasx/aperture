    "Polkadot needs 0.01 DOT to remain — dropping below it would close the account and lose the funds.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot benodig 0.01 DOT om oor te bly — om daaronder te daal, sal die rekening sluit en die fondse verloor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Polkadot إلى بقاء 0.01 DOT — الانخفاض دونها سيغلق الحساب ويفقد الأموال."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot изисква да останат 0,01 DOT — спадане под тях би затворило акаунта и изгубило средствата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot-এ ০.০১ DOT অবশিষ্ট থাকা প্রয়োজন — এর নিচে নামলে অ্যাকাউন্ট বন্ধ হয়ে তহবিল হারিয়ে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot necessita que quedin 0,01 DOT: baixar per sota tancaria el compte i es perdrien els fons."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot vyžaduje, aby zbylo 0,01 DOT — pokles pod tuto hranici by uzavřel účet a ztratil prostředky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot kræver, at 0,01 DOT er tilbage — at falde under det vil lukke kontoen og miste midlerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot benötigt 0,01 DOT als Rest – darunter würde das Konto geschlossen und die Mittel gingen verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Polkadot χρειάζεται να απομένουν 0,01 DOT — η πτώση κάτω από αυτό θα έκλεινε τον λογαριασμό και θα χάνονταν τα κεφάλαια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot necesita que queden 0.01 DOT; bajar de ahí cerraría la cuenta y perderías los fondos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot vajab, et alles jääks 0,01 DOT — selle alla langemine sulgeks konto ja kaotaks vahendid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot نیاز دارد ۰٫۰۱ DOT باقی بماند — افت به زیر آن حساب را می‌بندد و وجوه را از دست می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot vaatii, että 0,01 DOT jää jäljelle — sen alle putoaminen sulkisi tilin ja hävittäisi varat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng Polkadot na manatili ang 0.01 DOT — ang pagbaba sa ibaba nito ay magsasara ng account at magpapawala ng pondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot exige que 0,01 DOT reste — passer en dessous fermerait le compte et perdrait les fonds."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎Polkadot דורש שיישארו ‎0.01 DOT — ירידה מתחת לכך תסגור את החשבון ותאבד את הכספים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot को 0.01 DOT शेष रखने की आवश्यकता है — इससे नीचे जाने पर अकाउंट बंद हो जाएगा और फ़ंड खो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot zahtijeva da ostane 0.01 DOT — pad ispod toga zatvorio bi račun i izgubio sredstva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Polkadotnál 0,01 DOT-nak maradnia kell — ez alá esve a fiók bezárulna, és a pénz elveszne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot memerlukan sisa 0,01 DOT — turun di bawahnya akan menutup akun dan menghilangkan dana."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot þarf að 0,01 DOT sé eftir — að fara niður fyrir það myndi loka reikningnum og glata fénu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot richiede che rimangano 0,01 DOT — scendere al di sotto chiuderebbe l'account e farebbe perdere i fondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot は 0.01 DOT を残しておく必要があります — それを下回るとアカウントが閉鎖され、資金が失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot은 0.01 DOT가 남아 있어야 합니다 — 그 아래로 떨어지면 계정이 닫히고 자금이 손실됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot reikia, kad liktų 0,01 DOT – nukritus žemiau, paskyra būtų uždaryta ir lėšos prarastos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot ir nepieciešams atlikt 0,01 DOT — nokļūšana zem tā slēgtu kontu un zaudētu līdzekļus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot-ന് 0.01 DOT ശേഷിക്കേണ്ടതുണ്ട് — അതിന് താഴെ പോയാൽ അക്കൗണ്ട് അടയ്ക്കുകയും ഫണ്ട് നഷ്ടപ്പെടുകയും ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot ला 0.01 DOT शिल्लक राहणे आवश्यक आहे — त्याखाली गेल्यास खाते बंद होईल आणि निधी गमावला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot memerlukan 0.01 DOT untuk kekal — jatuh di bawahnya akan menutup akaun dan menghilangkan dana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot trenger at 0,01 DOT gjenstår — å gå under det vil lukke kontoen og miste midlene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot vereist dat er 0,01 DOT overblijft — daaronder zakken sluit het account en gaat het tegoed verloren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot ਨੂੰ 0.01 DOT ਬਾਕੀ ਰਹਿਣ ਦੀ ਲੋੜ ਹੈ — ਇਸ ਤੋਂ ਹੇਠਾਂ ਜਾਣ ਨਾਲ ਖਾਤਾ ਬੰਦ ਹੋ ਜਾਵੇਗਾ ਅਤੇ ਫੰਡ ਗੁਆਚ ਜਾਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot wymaga pozostawienia 0,01 DOT — spadek poniżej tej wartości zamknie konto i spowoduje utratę środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Polkadot precisa de 0,01 DOT restante — cair abaixo disso encerraria a conta e perderia os fundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot are nevoie să rămână 0,01 DOT — coborârea sub acest prag ar închide contul și ar pierde fondurile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Polkadot должно оставаться 0,01 DOT — если опуститься ниже, счёт закроется и средства будут потеряны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot vyžaduje, aby zostalo 0.01 DOT — pokles pod to by zatvoril účet a stratili by sa prostriedky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot zahteva, da ostane 0.01 DOT — padec pod to vrednost bi zaprl račun in izgubil sredstva."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot zahteva da ostane 0,01 DOT — pad ispod toga zatvorio bi nalog i izgubio sredstva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot behöver att 0,01 DOT återstår — att gå under det skulle stänga kontot och förlora medlen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot inahitaji DOT 0.01 zibaki — kushuka chini yake kungefunga akaunti na kupoteza fedha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot இல் 0.01 DOT மீதமிருக்க வேண்டும் — அதற்குக் கீழே சென்றால் கணக்கு மூடப்பட்டு நிதி இழக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadotకు 0.01 DOT మిగిలి ఉండాలి — దానికంటే తగ్గితే ఖాతా మూసివేయబడి నిధులు పోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot ต้องเหลือ 0.01 DOT — หากลดต่ำกว่านั้นจะปิดบัญชีและสูญเสียเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot'un 0,01 DOT kalmasını gerektirir — bunun altına düşmek hesabı kapatır ve fonları kaybettirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot потребує, щоб залишилося 0,01 DOT — зниження нижче закриє рахунок і призведе до втрати коштів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot کو 0.01 DOT باقی رہنا چاہیے — اس سے کم ہونا اکاؤنٹ بند کر دے گا اور رقم ضائع ہو جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot cần giữ lại 0,01 DOT — xuống dưới mức đó sẽ đóng tài khoản và làm mất tiền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot 需保留 0.01 DOT——低于此值将关闭账户并损失资金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot 需保留 0.01 DOT——低於此值將關閉帳戶並損失資金。"
          }
        }
      }
    },
