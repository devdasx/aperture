        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette rydder alle filter- og sorteringsvalg for aktivdetaljerne. Fortsæt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Filter- und Sortieroptionen für die Asset-Details zurückgesetzt. Fortfahren?"
