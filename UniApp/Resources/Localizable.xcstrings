    "Stored locally until you back up": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaaslik gestoor totdat jy rugsteun"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفَظ محليًا حتى تقوم بإنشاء نسخة احتياطية"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазено локално, докато не направите архивиране"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকআপ না নেওয়া পর্যন্ত স্থানীয়ভাবে সংরক্ষিত"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desat localment fins que en facis una còpia"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo lokálně, dokud nevytvoříte zálohu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt lokalt, indtil du sikkerhedskopierer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal gespeichert, bis Sie sichern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκευμένο τοπικά μέχρι να δημιουργήσετε αντίγραφο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored locally until you back up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenada localmente hasta que hagas la copia"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestatud kohalikult kuni varundamiseni"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زمان پشتیبان‌گیری به‌صورت محلی ذخیره می‌شود"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu paikallisesti, kunnes teet varmuuskopion"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-store nang lokal hanggang sa makapag-back up ka"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké localement jusqu'à la sauvegarde"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאוחסן מקומית עד שתבצע גיבוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
