    "Picking a different network than the other side bridges across chains.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om 'n ander netwerk as die ander kant te kies, brug oor kettings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار شبكة مختلفة عن الجانب الآخر يُجسر عبر السلاسل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изборът на различна мрежа от другата страна прехвърля между вериги."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপর পক্ষের চেয়ে ভিন্ন নেটওয়ার্ক বেছে নিলে চেইন জুড়ে ব্রিজ হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Triar una xarxa diferent de l'altre costat enllaça entre cadenes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volba jiné sítě než na druhé straně přemostí napříč řetězci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At vælge et andet netværk end den anden side broforbinder mellem kæder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Netzwerk als die Gegenseite zu wählen, überbrückt über Chains hinweg."
