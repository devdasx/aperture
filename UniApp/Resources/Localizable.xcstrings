    "Example only — never send funds to this.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Net 'n voorbeeld — moenie ooit fondse hierheen stuur nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏مثال فقط — لا ترسل أي أموال إليه أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само пример — никога не изпращайте средства на този адрес."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু উদাহরণ — এখানে কখনও তহবিল পাঠাবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només és un exemple: no hi envieu mai fons."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze ukázka — nikdy sem neposílejte prostředky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et eksempel — send aldrig midler hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Beispiel — senden Sie niemals Mittel dorthin."
