          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta Võta vastu, et näha oma aadressi iga ahela jaoks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن آدرس خود در هر زنجیره، روی دریافت ضربه بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Vastaanota nähdäksesi osoitteesi kullekin ketjulle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang Tumanggap para makita ang iyong address sa bawat chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Recevoir pour voir votre adresse sur chaque chaîne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על קבל כדי לראות את הכתובת שלך בכל שרשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक चेन के लिए अपना पता देखने के लिए प्राप्त करें पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
