        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda kehilangannya, dana hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mister du den, er midlene borte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je hem verliest, is het geld weg."
