        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاپی ہو گیا۔ کلپ‌بورڈ 60 سیکنڈ میں صاف ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao chép. Bộ nhớ tạm sẽ tự xoá sau 60 giây."
          }
