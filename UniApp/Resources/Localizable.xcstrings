        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ نے یہ کھو دیا، تو فنڈز چلے جائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đánh mất, tiền sẽ mất theo."
