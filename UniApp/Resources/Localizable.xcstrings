          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten portfel nie ma jeszcze adresu %@, więc nie ma gdzie odbierać w tej sieci. Aperture może nadal wyprowadzać Twoje konta — spróbuj ponownie za chwilę."
