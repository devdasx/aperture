          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagpili ng ibang network kaysa sa kabilang panig ay nagbo-bridge sa iba't ibang chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir un réseau différent de l'autre côté crée un pont entre les chaînes."
