    "Pick a network, then the token. Choosing a different network than the other side bridges across chains.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies 'n netwerk, dan die token. Om 'n ander netwerk as die ander kant te kies, brug oor kettings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر شبكة، ثم الرمز. اختيار شبكة مختلفة عن الجانب الآخر يُجسر عبر السلاسل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете мрежа, после токена. Изборът на различна мрежа от другата страна прехвърля между вериги."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি নেটওয়ার্ক বেছে নিন, তারপর টোকেন। অপর পক্ষের চেয়ে ভিন্ন নেটওয়ার্ক বেছে নিলে চেইন জুড়ে ব্রিজ হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una xarxa i després el token. Triar una xarxa diferent de l'altre costat enllaça entre cadenes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte síť, poté token. Volba jiné sítě než na druhé straně přemostí napříč řetězci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et netværk, derefter token. At vælge et andet netværk end den anden side broforbinder mellem kæder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Netzwerk, dann den Token. Ein anderes Netzwerk als die Gegenseite zu wählen, überbrückt über Chains hinweg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε δίκτυο, μετά το token. Η επιλογή διαφορετικού δικτύου από την άλλη πλευρά γεφυρώνει μεταξύ αλυσίδων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a network, then the token. Choosing a different network than the other side bridges across chains."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una red y luego el token. Elegir una red distinta a la del otro lado transfiere por puente entre redes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valige võrk, seejärel token. Teisest poolest erineva võrgu valimine sillab ahelate vahel."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک شبکه و سپس توکن را انتخاب کنید. انتخاب شبکه‌ای متفاوت از طرف دیگر، میان زنجیره‌ها پل می‌زند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse verkko ja sen jälkeen token. Eri verkon valinta kuin toisella puolella sillataan ketjujen yli."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng network, pagkatapos ay ang token. Ang pagpili ng ibang network kaysa sa kabilang panig ay nagbo-bridge sa iba't ibang chain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un réseau, puis le jeton. Choisir un réseau différent de l'autre côté crée un pont entre les chaînes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר רשת, ולאחר מכן את הטוקן. בחירת רשת שונה מהצד השני מגשרת בין רשתות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नेटवर्क चुनें, फिर टोकन। दूसरी ओर से अलग नेटवर्क चुनना चेनों के बीच ब्रिज करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite mrežu, zatim token. Odabir mreže različite od one na drugoj strani premošćuje preko lanaca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz hálózatot, majd a tokent. A másik oldaltól eltérő hálózat választása láncok között hidat épít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jaringan, lalu token. Memilih jaringan yang berbeda dari sisi lainnya akan mem-bridge antar chain."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu net, svo tókenann. Ef þú velur annað net en hin hliðin er brúað milli keðja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una rete, poi il token. Scegliere una rete diversa dall'altro lato effettua un bridge tra chain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークを選び、次にトークンを選びます。相手側と異なるネットワークを選ぶと、チェーン間でブリッジされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크를 선택한 다음 토큰을 선택하세요. 상대편과 다른 네트워크를 선택하면 체인 간 브리지가 이루어집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite tinklą, tada atpažinimo ženklą. Pasirinkus kitokį tinklą nei kita pusė, perkeliama tiltu tarp grandinių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties tīklu, pēc tam marķieri. Tīkla izvēle, kas atšķiras no otras puses, pārvieto līdzekļus ar tiltu starp tīkliem."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു നെറ്റ്‌വർക്ക് തിരഞ്ഞെടുക്കുക, പിന്നെ ടോക്കൺ. മറുവശത്തേക്കാൾ വ്യത്യസ്തമായ നെറ്റ്‌വർക്ക് തിരഞ്ഞെടുക്കുന്നത് ചെയിനുകൾക്കിടയിൽ ബ്രിഡ്ജ് ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क निवडा, मग टोकन. दुसऱ्या बाजूपेक्षा वेगळे नेटवर्क निवडल्यास चेनमध्ये ब्रिज होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih rangkaian, kemudian token. Memilih rangkaian yang berbeza daripada pihak lain menjambatani merentas rangkaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et nettverk, deretter token. Å velge et annet nettverk enn den andre siden bygger bro mellom kjeder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een netwerk en daarna de token. Een ander netwerk kiezen dan de andere kant bridget tussen chains."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੈੱਟਵਰਕ ਚੁਣੋ, ਫਿਰ ਟੋਕਨ। ਦੂਜੇ ਪਾਸੇ ਨਾਲੋਂ ਵੱਖਰਾ ਨੈੱਟਵਰਕ ਚੁਣਨ ਨਾਲ ਚੇਨਾਂ ਵਿਚਕਾਰ ਬ੍ਰਿਜ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sieć, a następnie token. Wybranie innej sieci niż druga strona przenosi środki między sieciami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma rede, depois o token. Escolher uma rede diferente da do outro lado faz a ponte entre redes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o rețea, apoi jetonul. Alegerea unei rețele diferite de cealaltă parte face un transfer prin punte între lanțuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сеть, затем токен. Выбор сети, отличной от другой стороны, создаёт мост между сетями."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte sieť, potom token. Výber inej siete než na druhej strane premosťuje medzi reťazcami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite omrežje, nato žeton. Izbira drugega omrežja kot na drugi strani premosti med verigami."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izaberite mrežu, zatim token. Izbor mreže drugačije od druge strane premošćuje preko lanaca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett nätverk, sedan token. Att välja ett annat nätverk än den andra sidan överbryggar mellan kedjor."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua mtandao, kisha tokeni. Kuchagua mtandao tofauti na upande mwingine huvusha kati ya minyororo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு நெட்வொர்க்கைத் தேர்வுசெய்து, பின்னர் டோக்கனைத் தேர்வுசெய்யவும். மறுபக்கத்தை விட வேறு நெட்வொர்க்கைத் தேர்வுசெய்தால் செயின்களுக்கு இடையே பாலமிடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక నెట్‌వర్క్‌ను ఎంచుకోండి, ఆపై టోకెన్‌ను. అవతలి వైపు కంటే వేరే నెట్‌వర్క్‌ను ఎంచుకుంటే చైన్‌ల మధ్య బ్రిడ్జ్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเครือข่าย จากนั้นเลือกโทเค็น การเลือกเครือข่ายที่ต่างจากอีกฝั่งจะเป็นการบริดจ์ข้ามเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ağ, ardından token seçin. Diğer taraftan farklı bir ağ seçmek zincirler arasında köprü kurar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть мережу, потім токен. Вибір іншої мережі, ніж на протилежному боці, виконує перенесення між мережами через міст."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک نیٹ ورک منتخب کریں، پھر ٹوکن۔ دوسری طرف سے مختلف نیٹ ورک منتخب کرنے سے چینز کے درمیان برج ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một mạng, rồi chọn token. Chọn mạng khác với bên kia sẽ bắc cầu giữa các chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选择网络，再选择代币。选择与另一方不同的网络将进行跨链。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先選擇網路，再選擇代幣。選擇與另一方不同的網路將進行跨鏈。"
          }
        }
      }
    },
