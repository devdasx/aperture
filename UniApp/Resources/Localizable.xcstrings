        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu orðið í hverri stöðu til að staðfesta að þú hafir vistað setninguna þína."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
