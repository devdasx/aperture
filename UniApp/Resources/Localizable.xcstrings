    "Less than the network minimum (\\(floor)) remains, so this recipient can't be paid.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder as die netwerkminimum (\\(floor)) bly oor, dus kan hierdie ontvanger nie betaal word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبقى أقل من الحد الأدنى للشبكة (\\(floor))، لذا لا يمكن الدفع لهذا المستلم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Остава по-малко от мрежовия минимум (\\(floor)), затова на този получател не може да бъде платено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্কের ন্যূনতম (\\(floor))-এর চেয়ে কম অবশিষ্ট আছে, তাই এই প্রাপককে পরিশোধ করা যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda menys que el mínim de la xarxa (\\(floor)), de manera que no es pot pagar aquest destinatari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývá méně než síťové minimum (\\(floor)), takže tomuto příjemci nelze zaplatit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre end netværksminimum (\\(floor)) er tilbage, så denne modtager kan ikke betales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es bleibt weniger als das Netzwerkminimum (\\(floor)), daher kann dieser Empfänger nicht bezahlt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απομένει λιγότερο από το ελάχιστο του δικτύου (\\(floor)), οπότε δεν είναι δυνατή η πληρωμή αυτού του παραλήπτη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than the network minimum (\\(floor)) remains, so this recipient can't be paid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda menos del mínimo de la red (\\(floor)), así que no se puede pagar a este destinatario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles jääb vähem kui võrgu miinimum (\\(floor)), seega ei saa sellele saajale maksta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کمتر از حداقل شبکه (\\(floor)) باقی می‌ماند، بنابراین این گیرنده قابل پرداخت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäljellä on vähemmän kuin verkon vähimmäismäärä (\\(floor)), joten tälle vastaanottajalle ei voi maksaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas kaunti pa sa network minimum (\\(floor)) ang natitira, kaya hindi mababayaran ang tatanggap na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste moins que le minimum du réseau (\\(floor)), ce destinataire ne peut donc pas être payé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותר פחות מהמינימום של הרשת (\\(floor)), ולכן לא ניתן לשלם לנמען זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क न्यूनतम (\\(floor)) से कम शेष है, इसलिए इस प्राप्तकर्ता को भुगतान नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preostaje manje od mrežnog minimuma (\\(floor)), pa se ovaj primatelj ne može isplatiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hálózati minimumnál (\\(floor)) kevesebb marad, így ennek a címzettnek nem lehet fizetni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisa kurang dari minimum jaringan (\\(floor)), jadi penerima ini tidak dapat dibayar."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Minna en lágmark netsins (\\(floor)) er eftir, svo ekki er hægt að greiða þessum viðtakanda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimane meno del minimo di rete (\\(floor)), quindi questo destinatario non può essere pagato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークの最低額（\\(floor)）を下回る残高のため、この受取人には支払えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 최소값(\\(floor))보다 적게 남아 이 받는 사람에게 지불할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieka mažiau nei tinklo minimumas (\\(floor)), todėl šiam gavėjui sumokėti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atliek mazāk par tīkla minimumu (\\(floor)), tāpēc šim saņēmējam nevar samaksāt."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നെറ്റ്‌വർക്ക് മിനിമത്തേക്കാൾ (\\(floor)) കുറവ് മാത്രമേ ശേഷിക്കുന്നുള്ളൂ, അതിനാൽ ഈ സ്വീകർത്താവിന് പണം നൽകാനാവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क किमान (\\(floor)) पेक्षा कमी शिल्लक आहे, त्यामुळे या प्राप्तकर्त्याला पैसे देता येत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurang daripada minimum rangkaian (\\(floor)) yang tinggal, jadi penerima ini tidak boleh dibayar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre enn nettverksminimum (\\(floor)) gjenstår, så denne mottakeren kan ikke betales."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er blijft minder dan het netwerkminimum (\\(floor)) over, dus deze ontvanger kan niet worden betaald."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੈੱਟਵਰਕ ਘੱਟੋ-ਘੱਟ (\\(floor)) ਤੋਂ ਘੱਟ ਬਾਕੀ ਹੈ, ਇਸ ਲਈ ਇਸ ਪ੍ਰਾਪਤਕਰਤਾ ਨੂੰ ਭੁਗਤਾਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
