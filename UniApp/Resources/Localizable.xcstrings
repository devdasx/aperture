    "Before you continue": {
      "comment": "Create-wallet disclosure sheet — navigation-bar title. Framing question; the body headline ('Your recovery phrase is the only way back.') carries the substance.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat jy voortgaan"
