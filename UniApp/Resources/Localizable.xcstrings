          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O adresă de primire este un șir care identifică unul dintre conturile dvs. pe o anumită rețea. Partajarea acesteia permite cuiva să trimită fonduri în acel cont."
