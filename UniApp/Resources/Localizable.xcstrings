    "If you lose your iPhone before backing up, your wallet is gone — there is no recovery without the phrase.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "As jy jou iPhone verloor voordat jy 'n rugsteun maak, is jou beursie weg — daar is geen herstel sonder die frase nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فقدت iPhone قبل إنشاء النسخة الاحتياطية، فستفقد محفظتك — لا يوجد استرداد بدون العبارة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако загубите своя iPhone преди да направите архивиране, портфейлът ви е изгубен — без фразата няма възстановяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকআপ নেওয়ার আগে যদি আপনার iPhone হারিয়ে যায়, ওয়ালেট চলে যাবে — ফ্রেজ ছাড়া কোনো পুনরুদ্ধার নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si perds l'iPhone abans de fer la còpia, la cartera desapareix — no hi ha recuperació sense la frase."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud iPhone ztratíte před vytvořením zálohy, peněženka je pryč — bez fráze není obnova možná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du mister din iPhone, før du sikkerhedskopierer, er tegnebogen væk — der er ingen gendannelse uden frasen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie Ihr iPhone vor einer Sicherung verlieren, ist Ihre Wallet weg — ohne die Phrase gibt es keine Wiederherstellung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν χάσετε το iPhone σας πριν δημιουργήσετε αντίγραφο ασφαλείας, το πορτοφόλι σας χάνεται — δεν υπάρχει ανάκτηση χωρίς τη φράση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose your iPhone before backing up, your wallet is gone — there is no recovery without the phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si pierdes el iPhone antes de hacer la copia, tu wallet desaparece — no hay recuperación sin la frase."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaotad oma iPhone'i enne varundamist, on rahakott läinud — taastamist ilma fraasita ei ole."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر iPhone خود را پیش از پشتیبان‌گیری از دست بدهید، کیف پول از بین می‌رود — بدون عبارت بازیابی وجود ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos kadotat iPhonen ennen varmuuskopiointia, lompakkosi katoaa — ilman lausetta palautusta ei ole."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung mawala ang iyong iPhone bago mag-back up, mawawala ang wallet mo — walang recovery nang walang phrase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous perdez votre iPhone avant la sauvegarde, votre portefeuille est perdu — il n'y a pas de récupération sans la phrase."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תאבד את ה-iPhone שלך לפני שגיבית, הארנק שלך אבוד — אין שחזור בלי הביטוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर बैकअप लेने से पहले आप अपना iPhone खो देते हैं, तो वॉलेट चला जाएगा — फ़्रेज़ के बिना कोई रिकवरी नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako izgubite iPhone prije nego što napravite sigurnosnu kopiju, novčanik je nestao — bez fraze nema oporavka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha biztonsági mentés előtt elveszíti az iPhone-ját, a tárcája odavész — a mondat nélkül nincs helyreállítás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda kehilangan iPhone sebelum mencadangkan, dompet Anda hilang — tidak ada pemulihan tanpa frasa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú týnir iPhone-inum þínum áður en þú tekur öryggisafrit er veskið glatað — engin endurheimt án setningarinnar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdi il tuo iPhone prima del backup, il portafoglio è perso — non c'è alcun recupero senza la frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを取る前に iPhone を失うと、ウォレットは失われます — フレーズなしでの復元はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업하기 전에 iPhone을 잃어버리면 지갑도 사라집니다 — 구문 없이는 복구할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei prarasite „iPhone“ prieš sukurdami atsarginę kopiją, jūsų piniginė bus prarasta — be frazės atkūrimo nėra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja zaudēsiet iPhone pirms dublēšanas, jūsu maks ir pazudis — bez frāzes atjaunošanas nav."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാക്കപ്പ് ചെയ്യും മുമ്പ് നിങ്ങളുടെ iPhone നഷ്ടപ്പെട്ടാൽ, വാലറ്റ് പോകും — വാചകമില്ലാതെ വീണ്ടെടുക്കലില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बॅकअप घेण्यापूर्वी तुमचा iPhone हरवला तर तुमचे वॉलेट जाते — वाक्यरचनेशिवाय पुनर्प्राप्ती नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda kehilangan iPhone anda sebelum sandaran, dompet anda hilang — tiada pemulihan tanpa frasa itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du mister iPhonen før du sikkerhetskopierer, er lommeboken borte — det finnes ingen gjenoppretting uten frasen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je iPhone verliest voordat je een back-up hebt gemaakt, is je portemonnee weg — zonder de zin is er geen herstel."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਤੁਸੀਂ ਬੈਕਅੱਪ ਲੈਣ ਤੋਂ ਪਹਿਲਾਂ ਆਪਣਾ iPhone ਗੁਆ ਦਿੰਦੇ ਹੋ, ਤਾਂ ਤੁਹਾਡਾ ਵਾਲਿਟ ਚਲਾ ਜਾਂਦਾ ਹੈ — ਵਾਕ ਤੋਂ ਬਿਨਾਂ ਕੋਈ ਰਿਕਵਰੀ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli zgubisz iPhone’a przed wykonaniem kopii zapasowej, twój portfel zniknie — bez frazy nie ma odzyskiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você perder seu iPhone antes de fazer o backup, sua carteira se perde — não há recuperação sem a frase."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă vă pierdeți iPhone-ul înainte de a face copia de rezervă, portofelul dispare — nu există recuperare fără frază."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы потеряете iPhone до резервного копирования, кошелёк будет утрачен — без фразы восстановления нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak svoj iPhone stratíte pred zálohovaním, peněženka je preč — bez frázy nie je obnova možná."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če izgubite iPhone, preden ustvarite varnostno kopijo, je denarnica izgubljena — brez fraze ni obnove."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако изгубите iPhone пре него што направите резервну копију, новчаник је нестао — без фразе нема опоравка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du tappar bort din iPhone innan du säkerhetskopierar är plånboken borta — det går inte att återställa utan frasen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukipoteza iPhone yako kabla ya kuhifadhi nakala, pochi yako imepotea — hakuna kurejesha bila kifungu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காப்பகப்படுத்துவதற்கு முன் iPhone-ஐ இழந்தால், உங்கள் வாலட் இழந்தது — சொற்றொடர் இல்லாமல் மீட்டெடுப்பு இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాకప్ చేయడానికి ముందు మీ iPhone పోతే, మీ వాలెట్ పోతుంది — పదబంధం లేకుండా రికవరీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณทำ iPhone หายก่อนสำรองข้อมูล กระเป๋าสตางค์จะหายไป — ไม่มีการกู้คืนหากไม่มีวลี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek almadan iPhone'unuzu kaybederseniz cüzdanınız kaybolur — ifade olmadan kurtarma yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви втратите iPhone до резервного копіювання, гаманець зникне — без фрази відновлення неможливе."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ بیک اپ سے پہلے اپنا iPhone کھو دیں، تو آپ کا والٹ ختم — بغیر فقرے کے کوئی بحالی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn mất iPhone trước khi sao lưu, ví của bạn sẽ mất — không thể khôi phục nếu không có cụm từ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你在备份之前丢失了 iPhone,你的钱包就没了 — 没有助记词就无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你在備份之前遺失 iPhone,你的錢包就沒了 — 沒有助記詞就無法還原。"
          }
        }
      }
    },
    "If you stop now, your new wallet won't be saved.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "As jy nou stop, sal jou nuwe beursie nie gestoor word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا توقفت الآن، لن يتم حفظ محفظتك الجديدة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако спрете сега, новият ви портфейл няма да бъде запазен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যদি আপনি এখন থামেন, আপনার নতুন ওয়ালেট সংরক্ষণ করা হবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si t’atures ara, la teva cartera nova no es desarà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud nyní přestanete, vaše nová peněženka nebude uložena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du stopper nu, gemmes din nye wallet ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du jetzt aufhörst, wird deine neue Wallet nicht gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν σταματήσετε τώρα, το νέο σας πορτοφόλι δεν θα αποθηκευτεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te detienes ahora, tu nueva cartera no se guardará."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sa praegu lõpetad, ei salvestata su uut rahakotti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اکنون متوقف شوید، کیف پول جدید شما ذخیره نخواهد شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos lopetat nyt, uutta lompakkoasi ei tallenneta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung titigil ka ngayon, hindi mase-save ang bago mong wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous arrêtez maintenant, votre nouveau portefeuille ne sera pas sauvegardé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תפסיק עכשיו, הארנק החדש שלך לא יישמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप अभी रुकते हैं, तो आपका नया वॉलेट सहेजा नहीं जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako sada stanete, vaš novi novčanik neće biti spremljen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha most leállsz, az új tárcád nem lesz elmentve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda berhenti sekarang, dompet baru Anda tidak akan disimpan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú hættir núna verður nýja veskið þitt ekki vistað."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ti fermi ora, il tuo nuovo wallet non verrà salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今停止すると、新しいウォレットは保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 중단하면 새 지갑이 저장되지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei sustosite dabar, jūsų nauja piniginė nebus išsaugota."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja apturēsi tagad, tavs jaunais maks netiks saglabāts."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ നിർത്തിയാൽ, നിങ്ങളുടെ പുതിയ വാലറ്റ് സംരക്ഷിക്കപ്പെടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जर तुम्ही आत्ता थांबलात, तर तुमचे नवीन वॉलेट जतन होणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda berhenti sekarang, dompet baharu anda tidak akan disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du stopper nå, blir den nye lommeboken ikke lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je nu stopt, wordt je nieuwe wallet niet opgeslagen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਤੁਸੀਂ ਹੁਣ ਰੁਕ ਜਾਂਦੇ ਹੋ, ਤਾਂ ਤੁਹਾਡਾ ਨਵਾਂ ਵਾਲਿਟ ਸੇਵ ਨਹੀਂ ਹੋਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli teraz zatrzymasz, Twój nowy portfel nie zostanie zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você parar agora, sua nova carteira não será salva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă te oprești acum, noul tău portofel nu va fi salvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы остановитесь сейчас, ваш новый кошелёк не будет сохранён."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak teraz prestanete, vaša nová peňaženka sa neuloží."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če zdaj prenehate, vaša nova denarnica ne bo shranjena."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако сада станете, ваш нови новчаник неће бити сачуван."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du slutar nu sparas inte din nya plånbok."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukisimama sasa, pochi yako mpya haitahifadhiwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இப்போது நிறுத்தினால், உங்கள் புதிய வாலெட் சேமிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పుడు ఆపితే, మీ కొత్త వాలెట్ సేవ్ చేయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณหยุดตอนนี้ กระเป๋าเงินใหม่ของคุณจะไม่ถูกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi durursanız yeni cüzdanınız kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви припините зараз, ваш новий гаманець не буде збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ ابھی رک گئے تو آپ کا نیا والیٹ محفوظ نہیں ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn dừng bây giờ, ví mới của bạn sẽ không được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你现在停止,你的新钱包将不会被保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你現在停止,你的新錢包將不會儲存。"
          }
        }
      }
    },
    "If your iPhone is unlocked, anyone with it can use your wallet. A PIN adds a second check before sending crypto or seeing your recovery phrase.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "As jou iPhone ontsluit is, kan enigiemand wat dit hou jou beursie gebruik. ʼn PIN voeg ʼn tweede kontrole by voordat jy kripto stuur of jou herstelfrase sien."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان iPhone الخاص بك غير مقفل، يمكن لأي شخص يحمله استخدام محفظتك. يضيف رمز PIN فحصاً ثانياً قبل إرسال العملات المشفّرة أو رؤية عبارة الاسترداد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако вашият iPhone е отключен, всеки, който го държи, може да използва портфейла ви. PIN добавя втора проверка преди да изпратите крипто или да видите фразата си за възстановяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যদি আপনার iPhone আনলক থাকে, তবে যে কেউ এটি ব্যবহার করে আপনার ওয়ালেট ব্যবহার করতে পারে। ক্রিপ্টো পাঠানোর বা আপনার রিকভারি ফ্রেজ দেখার আগে একটি PIN দ্বিতীয় চেক যোগ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el teu iPhone està desbloquejat, qualsevol que el tingui pot fer servir la teva cartera. Un PIN afegeix una segona comprovació abans d'enviar cripto o veure la frase de recuperació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je váš iPhone odemčený, může vaši peněženku použít kdokoli, kdo ho má. PIN přidává druhou kontrolu před odesláním kryptoměny nebo zobrazením fráze pro obnovení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis din iPhone er låst op, kan enhver, der har den, bruge din wallet. En PIN tilføjer endnu et tjek, før der sendes krypto eller vises en gendannelsessætning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein iPhone entsperrt ist, kann jeder, der es hat, deine Wallet verwenden. Eine PIN fügt eine zweite Prüfung hinzu, bevor du Krypto sendest oder deine Wiederherstellungsphrase siehst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν το iPhone σας είναι ξεκλείδωτο, οποιοσδήποτε το έχει μπορεί να χρησιμοποιήσει το πορτοφόλι σας. Ένα PIN προσθέτει έναν δεύτερο έλεγχο πριν από την αποστολή crypto ή την προβολή της φράσης ανάκτησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu iPhone está desbloqueado, cualquiera que lo tenga puede usar tu cartera. Un PIN añade una segunda verificación antes de enviar cripto o ver tu frase de recuperación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sinu iPhone on lukustamata, saab igaüks, kelle käes see on, kasutada sinu rahakotti. PIN lisab teise kontrolli enne krüpto saatmist või taastefraasi nägemist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر iPhone شما باز باشد، هرکسی که آن را در اختیار دارد می‌تواند از کیف پول شما استفاده کند. PIN قبل از ارسال رمزارز یا دیدن عبارت بازیابی یک بررسی دوم اضافه می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos iPhonesi on lukitsematon, kuka tahansa sen omistaja voi käyttää lompakkoasi. PIN-koodi lisää toisen tarkistuksen ennen kryptovaluutan lähettämistä tai palautuslauseen näkemistä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-unlock ang iyong iPhone, sinumang may hawak nito ay maaaring gumamit ng iyong wallet. Nagdaragdag ang PIN ng pangalawang check bago magpadala ng crypto o makita ang iyong recovery phrase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre iPhone est déverrouillé, n’importe qui peut utiliser votre portefeuille. Un PIN ajoute une deuxième vérification avant l’envoi de crypto ou l’affichage de votre phrase de récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם ה-iPhone שלך פתוח, כל מי שמחזיק בו יכול להשתמש בארנק שלך. PIN מוסיף בדיקה שנייה לפני שליחת קריפטו או צפייה בביטוי השחזור שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपका iPhone अनलॉक है, तो इसे रखने वाला कोई भी व्यक्ति आपके वॉलेट का उपयोग कर सकता है। एक PIN क्रिप्टो भेजने या आपका रिकवरी फ़्रेज़ देखने से पहले दूसरी जांच जोड़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je vaš iPhone otključan, bilo tko ga može koristiti za pristup vašem novčaniku. PIN dodaje drugu provjeru prije slanja kripta ili prikaza fraze za oporavak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az iPhone-od fel van oldva, bárki, akinél van, használhatja a tárcádat. A PIN egy második ellenőrzést ad hozzá, mielőtt kriptot küldenél vagy láthatnád a helyreállítási kifejezésed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika iPhone Anda terbuka, siapa pun yang memilikinya dapat menggunakan dompet Anda. PIN menambahkan pemeriksaan kedua sebelum mengirim kripto atau melihat frasa pemulihan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef iPhone-inn þinn er ólæstur getur hver sem hefur hann notað veskið þitt. PIN bætir við annarri staðfestingu áður en rafmynt er send eða endurheimtarsetningin er sýnd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo iPhone è sbloccato, chiunque lo abbia può usare il tuo wallet. Un PIN aggiunge una seconda verifica prima di inviare crypto o vedere la frase di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneがロック解除されている場合、それを持っている誰でもあなたのウォレットを使用できます。PINは、暗号資産を送信したりリカバリーフレーズを表示したりする前の2つ目のチェックを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 잠금 해제되어 있다면, 그것을 가진 누구나 지갑을 사용할 수 있습니다. PIN은 암호화폐를 보내거나 복구 문구를 보기 전에 두 번째 확인을 추가합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei jūsų „iPhone“ atrakintas, bet kas, kas jį turi, gali naudoti jūsų piniginę. PIN prideda antrą patikrinimą prieš siunčiant kriptovaliutą ar matant atkūrimo frazę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja jūsu iPhone ir atbloķēts, ikviens, kurš to tur, var izmantot jūsu maku. PIN pievieno otru pārbaudi pirms kriptovalūtas nosūtīšanas vai atkopšanas frāzes apskates."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ iPhone അൺലോക്ക് ആണെങ്കിൽ, അത് കൈവശമുള്ള ആർക്കും നിങ്ങളുടെ വാലറ്റ് ഉപയോഗിക്കാം. ക്രിപ്റ്റോ അയയ്ക്കുന്നതിന് മുമ്പോ വീണ്ടെടുക്കൽ വാക്യം കാണുന്നതിന് മുമ്പോ PIN ഒരു രണ്ടാം പരിശോധന കൂട്ടിച്ചേർക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा iPhone अनलॉक असेल, तर तो ज्याच्या हातात आहे तो तुमचं वॉलेट वापरू शकतो. क्रिप्टो पाठवण्याआधी किंवा रिकव्हरी फ्रेज पाहण्याआधी PIN दुसरी तपासणी जोडतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika iPhone anda tidak dikunci, sesiapa sahaja yang memegangnya boleh menggunakan dompet anda. PIN menambah satu lagi pemeriksaan sebelum menghantar kripto atau melihat frasa pemulihan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis iPhonen din er låst opp, kan alle som har den bruke lommeboken din. En PIN-kode legger til en ekstra sjekk før du sender krypto eller ser gjenopprettingsfrasen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je iPhone ontgrendeld is, kan iedereen die hem heeft je wallet gebruiken. Een pincode voegt een tweede controle toe voordat je crypto verstuurt of je herstelzin bekijkt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਤੁਹਾਡਾ iPhone ਅਨਲੌਕ ਹੈ, ਤਾਂ ਜੋ ਵੀ ਇਸਨੂੰ ਫੜਦਾ ਹੈ ਉਹ ਤੁਹਾਡਾ ਵਾਲਿਟ ਵਰਤ ਸਕਦਾ ਹੈ। ਕ੍ਰਿਪਟੋ ਭੇਜਣ ਜਾਂ ਤੁਹਾਡੀ ਰਿਕਵਰੀ ਫਰੇਜ਼ ਦੇਖਣ ਤੋਂ ਪਹਿਲਾਂ PIN ਇੱਕ ਦੂਜੀ ਜਾਂਚ ਜੋੜਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli Twój iPhone jest odblokowany, każdy kto go ma, może użyć Twojego portfela. PIN dodaje drugą weryfikację przed wysłaniem krypto lub wyświetleniem frazy odzyskiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se seu iPhone estiver desbloqueado, qualquer pessoa com ele pode usar sua carteira. Um PIN adiciona uma segunda verificação antes de enviar cripto ou ver sua frase de recuperação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă iPhone-ul tău este deblocat, oricine îl deține îți poate folosi portofelul. Un PIN adaugă o a doua verificare înainte de a trimite crypto sau de a vedea fraza de recuperare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ваш iPhone разблокирован, любой, у кого он есть, может использовать ваш кошелёк. PIN-код добавляет вторую проверку перед отправкой криптовалюты или просмотром фразы восстановления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je váš iPhone odomknutý, ktokoľvek, kto ho má, môže použiť vašu peňaženku. PIN pridáva druhú kontrolu pred odoslaním krypta alebo zobrazením obnovovacej frázy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če je vaš iPhone odklenjen, lahko vsakdo, ki ga ima, uporablja vašo denarnico. PIN doda drugo preverjanje pred pošiljanjem kripto valute ali ogledom obnovitvene fraze."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако је ваш iPhone откључан, било ко са њим може користити ваш новчаник. PIN додаје другу проверу пре слања крипта или приказа фразе за опоравак."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om din iPhone är upplåst kan vem som helst som har den använda din plånbok. En PIN-kod lägger till en andra kontroll innan du skickar krypto eller ser din återställningsfras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone yako ikiwa imefunguliwa, mtu yeyote aliye nayo anaweza kutumia pochi yako. PIN huongeza ukaguzi wa pili kabla ya kutuma krypto au kuona kifungu chako cha urejesho."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iPhone அன்லாக்காக இருந்தால், அதைக் கைவசம் வைத்திருக்கும் எவராலும் உங்கள் பணப்பையை பயன்படுத்த முடியும். கிரிப்டோ அனுப்புவதற்கு அல்லது உங்கள் மீட்பு சொற்றொடரைப் பார்ப்பதற்கு முன் PIN ஒரு இரண்டாவது சரிபார்ப்பைச் சேர்க்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iPhone అన్‌లాక్‌గా ఉంటే, దాన్ని పట్టుకున్న ఎవరైనా మీ వాలెట్‌ను ఉపయోగించగలరు. క్రిప్టో పంపే ముందు లేదా మీ రికవరీ ఫ్రేజ్‌ను చూసే ముందు PIN రెండవ తనిఖీని జోడిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หาก iPhone ของคุณถูกปลดล็อก ใครก็ตามที่มีมันสามารถใช้กระเป๋าเงินของคุณได้ PIN เพิ่มการตรวจสอบครั้งที่สองก่อนส่งคริปโตหรือดูวลีกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuz kilidi açıksa, onu elinde tutan herkes cüzdanınızı kullanabilir. Bir PIN, kripto göndermeden veya kurtarma ifadenizi görmeden önce ikinci bir kontrol ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ваш iPhone розблоковано, будь-хто з ним може використати ваш гаманець. PIN-код додає другу перевірку перед надсиланням криптовалюти або переглядом фрази відновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ کا iPhone اَن‌لاک ہے، تو جو بھی اِسے رکھتا ہے، آپ کا والٹ استعمال کر سکتا ہے۔ PIN کرپٹو بھیجنے یا آپ کا ریکوری فریز دیکھنے سے پہلے ایک دوسرا چیک شامل کر دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu iPhone của bạn được mở khóa, bất kỳ ai có nó cũng có thể dùng ví của bạn. Mã PIN thêm một bước kiểm tra thứ hai trước khi gửi crypto hoặc xem cụm từ khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 iPhone 已解锁,任何持有它的人都可以使用你的钱包。PIN 码在发送加密货币或查看恢复短语前增加了第二重验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 iPhone 已解鎖,任何持有它的人都可以使用你的錢包。PIN 碼在傳送加密貨幣或查看復原片語前增加了第二重驗證。"
          }
        }
      }
    },
    "If your original wallet was set up without a passphrase, leave this empty. If you used one, it must match exactly — we cannot recover or guess it for you.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "As jou oorspronklike beursie sonder 'n passphrase opgestel is, laat dit leeg. As jy een gebruik het, moet dit presies ooreenstem — ons kan dit nie vir jou herstel of raai nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تم إعداد محفظتك الأصلية بدون عبارة مرور، اتركها فارغة. إذا استخدمت واحدة، يجب أن تتطابق تماماً — لا يمكننا استردادها أو تخمينها لك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако оригиналният ти портфейл е настроен без passphrase, остави празно. Ако си използвал такава, тя трябва да съвпада точно — не можем да я възстановим или познаем вместо теб."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যদি আপনার মূল ওয়ালেট প্যাসফ্রেজ ছাড়াই সেট আপ করা হয়, এটি খালি রাখুন। যদি আপনি একটি ব্যবহার করে থাকেন, এটি অবশ্যই হুবহু মিলতে হবে — আমরা এটি আপনার জন্য পুনরুদ্ধার বা অনুমান করতে পারি না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la teva wallet original es va configurar sense passphrase, deixa-ho en blanc. Si en vas fer servir una, ha de coincidir exactament — no la podem recuperar ni endevinar per tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud vaše původní peněženka byla nastavena bez passphrase, ponechte prázdné. Pokud jste ji použili, musí se přesně shodovat — nemůžeme ji za vás obnovit ani uhodnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis din oprindelige wallet blev sat op uden passphrase, lad denne være tom. Hvis du brugte en, skal den matche nøjagtigt — vi kan ikke gendanne eller gætte den for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deine ursprüngliche Wallet ohne Passphrase eingerichtet wurde, lass dies leer. Wenn du eine verwendet hast, muss sie exakt übereinstimmen — wir können sie nicht für dich wiederherstellen oder erraten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν το αρχικό σας πορτοφόλι ρυθμίστηκε χωρίς passphrase, αφήστε το κενό. Αν χρησιμοποιήσατε μία, πρέπει να ταιριάζει ακριβώς — δεν μπορούμε να την ανακτήσουμε ή να τη μαντέψουμε για εσάς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu wallet original se configuró sin frase de contraseña, déjalo vacío. Si usaste una, debe coincidir exactamente — no podemos recuperarla ni adivinarla por ti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sinu algne rahakott seadistati ilma passphrase'ita, jäta tühjaks. Kui kasutasid seda, peab see täpselt klappima — me ei saa seda sinu eest taastada ega ära arvata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کیف‌پول اصلی شما بدون passphrase تنظیم شده، خالی بگذارید. اگر از آن استفاده کرده‌اید، باید دقیقاً مطابقت داشته باشد — ما نمی‌توانیم آن را برای شما بازیابی یا حدس بزنیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos alkuperäinen lompakkosi luotiin ilman passphrasea, jätä tämä tyhjäksi. Jos käytit sellaista, sen on täsmättävä tarkasti — emme voi palauttaa tai arvata sitä puolestasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung ang orihinal mong wallet ay na-set up nang walang passphrase, iwanang walang laman ito. Kung gumamit ka ng isa, dapat itong eksaktong magtugma — hindi namin mababawi o mahuhulaan ito para sa iyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre portefeuille d'origine a été configuré sans passphrase, laissez vide. Si vous en avez utilisé une, elle doit correspondre exactement — nous ne pouvons pas la récupérer ni la deviner à votre place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם הארנק המקורי שלך הוגדר ללא passphrase, השאר ריק. אם השתמשת באחד, הוא חייב להתאים בדיוק — איננו יכולים לשחזר או לנחש אותו עבורך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपका मूल वॉलेट बिना पासफ़्रेज़ के सेट किया गया था, तो इसे खाली छोड़ दें। यदि आपने एक का उपयोग किया, तो यह बिल्कुल मेल खाना चाहिए — हम इसे आपके लिए पुनर्प्राप्त या अनुमान नहीं लगा सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je tvoj izvorni novčanik postavljen bez passphrasea, ostavi prazno. Ako si je koristio, mora se točno podudarati — ne možemo je oporaviti niti pogoditi umjesto tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az eredeti tárcád passphrase nélkül lett beállítva, hagyd üresen. Ha használtál egyet, pontosan egyeznie kell — nem tudjuk helyreállítani vagy kitalálni helyetted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika dompet aslimu disiapkan tanpa passphrase, biarkan kosong. Jika kamu menggunakannya, harus cocok persis — kami tidak dapat memulihkan atau menebaknya untukmu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef upphaflega veskið þitt var sett upp án passphrase, skildu þetta eftir tómt. Ef þú notaðir slíkt verður það að passa nákvæmlega — við getum ekki endurheimt eða giskað á það fyrir þig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo wallet originale è stato configurato senza passphrase, lascia vuoto. Se ne hai usata una, deve corrispondere esattamente — non possiamo recuperarla o indovinarla per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のウォレットが passphrase なしで設定されていた場合は、空のままにしてください。passphrase を使用していた場合は、完全に一致する必要があります — 私たちはそれをあなたのために復元したり推測したりすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 지갑이 passphrase 없이 설정된 경우 비워두세요. 사용했다면 정확히 일치해야 합니다 — 저희가 복구하거나 추측해 드릴 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei tavo originali piniginė buvo sukurta be passphrase, palik tuščia. Jei naudojai vieną, ji turi tiksliai sutapti — negalime jos atkurti ar atspėti už tave."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja tavs sākotnējais maks tika izveidots bez passphrase, atstāj tukšu. Ja izmantoji to, tai jāatbilst precīzi — mēs nevaram to atjaunot vai uzminēt tavā vietā."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ യഥാർത്ഥ വാലറ്റ് passphrase ഇല്ലാതെയാണ് സജ്ജീകരിച്ചതെങ്കിൽ, ഇത് ശൂന്യമായി വിടുക. നിങ്ങൾ ഒന്ന് ഉപയോഗിച്ചിട്ടുണ്ടെങ്കിൽ, അത് കൃത്യമായി പൊരുത്തപ്പെടണം — ഞങ്ങൾക്ക് അത് നിങ്ങൾക്കായി വീണ്ടെടുക്കാനോ ഊഹിക്കാനോ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे मूळ वॉलेट passphrase शिवाय सेट केले असल्यास, हे रिकामे ठेवा. तुम्ही एक वापरला असल्यास, तो अचूक जुळला पाहिजे — आम्ही तुमच्यासाठी तो पुनर्प्राप्त करू शकत नाही किंवा अंदाज लावू शकत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika dompet asal anda disediakan tanpa passphrase, biarkan kosong. Jika anda menggunakannya, ia mesti sepadan dengan tepat — kami tidak dapat memulihkan atau meneka untuk anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis din opprinnelige lommebok ble satt opp uten passphrase, la dette stå tomt. Hvis du brukte en, må den matche nøyaktig — vi kan ikke gjenopprette eller gjette den for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je oorspronkelijke wallet zonder passphrase is opgezet, laat dit leeg. Als je er een gebruikte, moet deze exact overeenkomen — we kunnen hem niet voor je herstellen of raden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇਕਰ ਤੁਹਾਡਾ ਅਸਲੀ ਵਾਲੇਟ passphrase ਤੋਂ ਬਿਨਾਂ ਸੈੱਟਅੱਪ ਕੀਤਾ ਗਿਆ ਸੀ, ਤਾਂ ਇਸਨੂੰ ਖਾਲੀ ਛੱਡੋ। ਜੇਕਰ ਤੁਸੀਂ ਇੱਕ ਵਰਤਿਆ ਹੈ, ਤਾਂ ਇਹ ਬਿਲਕੁਲ ਮੇਲ ਖਾਣਾ ਚਾਹੀਦਾ ਹੈ — ਅਸੀਂ ਤੁਹਾਡੇ ਲਈ ਇਸਨੂੰ ਮੁੜ ਪ੍ਰਾਪਤ ਜਾਂ ਅਨੁਮਾਨ ਨਹੀਂ ਲਗਾ ਸਕਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli twój oryginalny portfel został skonfigurowany bez passphrase, zostaw puste. Jeśli jej użyłeś, musi się dokładnie zgadzać — nie możemy jej za ciebie odzyskać ani odgadnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sua wallet original foi configurada sem frase secreta, deixe em branco. Se você usou uma, ela precisa corresponder exatamente — não podemos recuperá-la ou adivinhá-la para você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă portofelul tău original a fost configurat fără passphrase, lasă gol. Dacă ai folosit una, trebuie să se potrivească exact — nu o putem recupera sau ghici pentru tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ваш исходный кошелёк был настроен без passphrase, оставьте поле пустым. Если вы использовали её, она должна совпадать точно — мы не можем её восстановить или угадать за вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak bola tvoja pôvodná peňaženka nastavená bez passphrase, nechaj prázdne. Ak si ju použil, musí sa presne zhodovať — nemôžeme ju za teba obnoviť ani uhádnuť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če je bila tvoja izvirna denarnica nastavljena brez passphrase, pusti prazno. Če si ga uporabil, se mora natančno ujemati — ne moremo ga obnoviti ali uganiti namesto tebe."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако је твој оригинални новчаник постављен без passphrase, остави празно. Ако си је користио, мора се тачно поклапати — не можемо је опоравити нити погодити уместо тебе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om din ursprungliga plånbok skapades utan passphrase, lämna detta tomt. Om du använde en måste den stämma exakt — vi kan inte återställa eller gissa den åt dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikiwa pochi yako ya asili iliwekwa bila passphrase, acha tupu. Ikiwa ulitumia moja, lazima ifanane haswa — hatuwezi kuirejesha au kuibahatisha kwa ajili yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அசல் வாலெட் passphrase இல்லாமல் அமைக்கப்பட்டிருந்தால், இதை வெறுமையாக விடவும். ஒன்றைப் பயன்படுத்தினால், அது சரியாகப் பொருந்த வேண்டும் — உங்களுக்காக நாங்கள் அதை மீட்டெடுக்கவோ அல்லது ஊகிக்கவோ முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అసలు వాలెట్ passphrase లేకుండా సెటప్ చేయబడితే, దీన్ని ఖాళీగా ఉంచండి. మీరు ఒకటి ఉపయోగించినట్లయితే, అది సరిగ్గా సరిపోలాలి — మేము దానిని మీ కోసం పునరుద్ధరించలేము లేదా ఊహించలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากกระเป๋าเดิมของคุณตั้งค่าโดยไม่มี passphrase ให้เว้นว่างไว้ หากคุณใช้ มันต้องตรงกันทุกประการ — เราไม่สามารถกู้คืนหรือเดาให้คุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal cüzdanın passphrase olmadan kurulduysa boş bırak. Kullandıysan tam olarak eşleşmesi gerekir — senin için kurtaramayız veya tahmin edemeyiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ваш початковий гаманець було налаштовано без passphrase, залиште поле порожнім. Якщо ви використовували її, вона має точно збігатися — ми не можемо відновити або вгадати її за вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ کا اصل والیٹ passphrase کے بغیر سیٹ کیا گیا تھا تو اسے خالی چھوڑ دیں۔ اگر آپ نے ایک استعمال کیا تو یہ بالکل مماثل ہونا چاہیے — ہم اسے آپ کے لیے بحال یا اندازہ نہیں لگا سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu ví gốc của bạn được thiết lập không có passphrase, hãy để trống. Nếu bạn đã dùng một cái, nó phải khớp chính xác — chúng tôi không thể khôi phục hay đoán cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的原钱包未设置密码短语,请留空。如果你设置过,它必须完全匹配 — 我们无法为你恢复或猜测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的原錢包未設定通行短語,請留空。如果你設定過,它必須完全相符 — 我們無法為你復原或猜測。"
          }
        }
      }
    },
