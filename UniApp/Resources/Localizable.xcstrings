        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സപ്പോർട്ട് ടീമില്ല, പാസ്‌വേഡ് റീസെറ്റ് ഇല്ല, വീണ്ടെടുപ്പും ഇല്ല."
          }
