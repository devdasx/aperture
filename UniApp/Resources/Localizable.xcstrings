    "The key never leaves this iPhone. Aperture does not send it anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutel verlaat nooit hierdie iPhone nie. Aperture stuur dit nêrens nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغادر المفتاح هذا الـ iPhone أبداً. لا يرسله Aperture إلى أي مكان."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът никога не напуска този iPhone. Aperture не го изпраща никъде."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী কখনো এই iPhone ছেড়ে যায় না। Aperture এটিকে কোথাও পাঠায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La clau no surt mai d'aquest iPhone. Aperture no l'envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč nikdy neopustí tento iPhone. Aperture jej nikam neposílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøglen forlader aldrig denne iPhone. Aperture sender den ingen steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel verlässt dieses iPhone nie. Aperture sendet ihn nirgendwohin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
