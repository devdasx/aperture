        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ഗ്യാസ് പരിധി സ്വയമേവ കണക്കാക്കുന്നു. ഇടപാടിന് കൂടുതൽ ആവശ്യമാണെന്ന് നിങ്ങൾക്ക് അറിയാമെങ്കിൽ മാത്രം ഇത് മാറ്റുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture गॅस मर्यादा आपोआप अंदाजित करते. व्यवहाराला अधिक हवे आहे हे माहीत असल्यासच हे बदला."
          }
        },
        "ms": {
