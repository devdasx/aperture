        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணக்கு ஆன்-செயினில் இருக்க Solana வாடகை விலக்கு குறைந்தபட்சமாக ~0.00089 SOL ஐ வைத்திருக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతా ఆన్-చైన్‌లో ఉండేలా Solana అద్దె-మినహాయింపు కనిష్టంగా ~0.00089 SOLను ఉంచుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana เก็บ ~0.00089 SOL ไว้เป็นขั้นต่ำที่ยกเว้นค่าเช่าเพื่อให้บัญชียังคงอยู่บนเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana, hesabın zincir üzerinde kalması için kira muafiyeti minimumu olarak ~0,00089 SOL tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana утримує ~0,00089 SOL як мінімум, звільнений від оренди, щоб рахунок залишався в мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana ~0.00089 SOL کو رینٹ سے مستثنیٰ کم از کم کے طور پر رکھتا ہے تاکہ اکاؤنٹ آن چین رہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana giữ ~0,00089 SOL làm mức tối thiểu miễn phí thuê để tài khoản vẫn tồn tại trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana 会保留约 0.00089 SOL 作为免租金最低额，以使账户保留在链上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana 會保留約 0.00089 SOL 作為免租金最低額，以使帳戶保留在鏈上。"
          }
        }
      }
    },
