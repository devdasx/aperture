        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovu adresu šaljite samo %@ na mreži %@. Slanje bilo kojeg drugog tokena ili korištenje druge mreže može dovesti do trajnog gubitka."
