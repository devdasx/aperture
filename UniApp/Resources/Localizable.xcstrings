    "Your key never leaves this iPhone. Aperture does not send it anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou sleutel verlaat hierdie iPhone nooit nie. Aperture stuur dit nêrens heen nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاحك لا يغادر هذا الـ iPhone أبدًا. ولا يرسله Aperture إلى أي مكان."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът ви никога не напуска този iPhone. Aperture не го изпраща никъде."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কী কখনোই এই iPhone ছাড়ে না। Aperture এটি কোথাও পাঠায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva clau no surt mai d'aquest iPhone. L'Aperture no l'envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš klíč nikdy neopustí tento iPhone. Aperture jej nikam neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nøgle forlader aldrig denne iPhone. Aperture sender den ikke nogen steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel verlässt dieses iPhone nie. Aperture sendet ihn nirgendwohin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί σας δεν φεύγει ποτέ από αυτό το iPhone. Το Aperture δεν το στέλνει πουθενά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave nunca sale de este iPhone. Aperture no la envía a ninguna parte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie võti ei lahku kunagi sellest iPhone’ist. Aperture ei saada seda kuhugi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید شما هرگز از این iPhone خارج نمی‌شود. Aperture آن را به هیچ جا نمی‌فرستد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimesi ei poistu koskaan tältä iPhonelta. Aperture ei lähetä sitä mihinkään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi umaalis sa iPhone na ito ang iyong susi. Hindi ito ipinapadala ng Aperture saanman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé ne quitte jamais cet iPhone. Aperture ne l’envoie nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח שלך לא יוצא לעולם מה-iPhone הזה. Aperture אינו שולח אותו לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुंजी कभी इस iPhone से बाहर नहीं जाती। Aperture इसे कहीं नहीं भेजता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ nikada ne napušta ovaj iPhone. Aperture ga nikamo ne šalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsa soha nem hagyja el ezt az iPhone-t. Az Aperture sehova nem küldi el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci Anda tidak pernah meninggalkan iPhone ini. Aperture tidak mengirimkannya ke mana pun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykillinn þinn yfirgefur þennan iPhone aldrei. Aperture sendir hann ekki neitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave non lascia mai questo iPhone. Aperture non la invia da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの鍵がこの iPhone から出ることはありません。Aperture がそれをどこかへ送ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 키는 이 iPhone을 벗어나지 않습니다. Aperture는 그것을 어디에도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų raktas niekada nepalieka šio iPhone. Aperture jo niekur nesiunčia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu atslēga nekad neatstāj šo iPhone. Aperture to nekur nenosūta."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കീ ഈ iPhone വിട്ടുപോകില്ല. Aperture അത് എവിടെയും അയയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची की हा iPhone कधीही सोडत नाही. Aperture ती कुठेही पाठवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci anda tidak pernah meninggalkan iPhone ini. Aperture tidak menghantarnya ke mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelen din forlater aldri denne iPhone-en. Aperture sender den ikke noe sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sleutel verlaat deze iPhone nooit. Aperture stuurt hem nergens naartoe."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਕੀ ਕਦੇ ਵੀ ਇਸ iPhone ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦੀ। Aperture ਇਸ ਨੂੰ ਕਿਤੇ ਨਹੀਂ ਭੇਜਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój klucz nigdy nie opuszcza tego iPhone’a. Aperture nigdzie go nie wysyła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave nunca sai deste iPhone. O Aperture não a envia para lugar nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia ta nu părăsește niciodată acest iPhone. Aperture nu o trimite nicăieri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ никогда не покидает этот iPhone. Aperture никуда его не отправляет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš kľúč nikdy neopustí tento iPhone. Aperture ho nikam neodosiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ tega iPhona nikoli ne zapusti. Aperture ga nikamor ne pošilja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш кључ никада не напушта овај iPhone. Aperture га нигде не шаље."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nyckel lämnar aldrig den här iPhone-enheten. Aperture skickar den inte någonstans."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufunguo wako hauondoki kamwe kwenye iPhone hii. Aperture hautumi popote."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாவி இந்த iPhone-ஐ விட்டு வெளியேறுவதில்லை. Aperture அதை எங்கும் அனுப்புவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కీ ఈ iPhone-ను వదిలి వెళ్ళదు. Aperture దాన్ని ఎక్కడికీ పంపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ของคุณไม่ออกจาก iPhone เครื่องนี้ Aperture ไม่ส่งคีย์ไปที่ใดทั้งสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarınız bu iPhone’dan asla çıkmaz. Aperture onu hiçbir yere göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ ніколи не залишає цей iPhone. Aperture нікуди його не надсилає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کی کبھی اس iPhone سے باہر نہیں جاتی۔ Aperture اسے کہیں نہیں بھیجتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa của bạn không bao giờ rời khỏi chiếc iPhone này. Aperture không gửi nó đi đâu cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密钥不会离开这部 iPhone。Aperture 不会把它发送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的金鑰不會離開這部 iPhone。Aperture 不會把它傳送到任何地方。"
          }
        }
      }
    },
    "Your key wasn't kept when this wallet was imported. You still have it — to store it on this iPhone too, delete this wallet and import the key again.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou sleutel is nie gehou toe hierdie beursie ingevoer is nie. Jy het dit steeds — om dit ook op hierdie iPhone te stoor, skrap hierdie beursie en voer die sleutel weer in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم الاحتفاظ بمفتاحك عند استيراد هذه المحفظة. لا يزال لديك — لتخزينه على جهاز iPhone هذا أيضًا، احذف هذه المحفظة واستورد المفتاح مجددًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът ви не беше запазен, когато този портфейл беше импортиран. Все още го имате — за да го съхраните и на този iPhone, изтрийте този портфейл и импортирайте ключа отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ওয়ালেট আমদানি করার সময় আপনার কী রাখা হয়নি। এটি এখনও আপনার কাছে আছে — এটি এই iPhone-এও সংরক্ষণ করতে, এই ওয়ালেট মুছে ফেলুন এবং কী আবার আমদানি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva clau no es va conservar quan es va importar aquesta cartera. Encara la tens: per desar-la també en aquest iPhone, elimina aquesta cartera i torna a importar la clau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš klíč nebyl uchován, když byla tato peněženka importována. Stále jej máte — chcete-li jej uložit i na tento iPhone, smažte tuto peněženku a importujte klíč znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nøgle blev ikke bevaret, da denne tegnebog blev importeret. Du har den stadig — for at gemme den på denne iPhone også, slet denne tegnebog og importer nøglen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel wurde beim Importieren dieses Wallets nicht aufbewahrt. Du hast ihn noch – um ihn auch auf diesem iPhone zu speichern, lösche dieses Wallet und importiere den Schlüssel erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί σας δεν διατηρήθηκε κατά την εισαγωγή αυτού του πορτοφολιού. Εξακολουθείτε να το έχετε — για να το αποθηκεύσετε και σε αυτό το iPhone, διαγράψτε αυτό το πορτοφόλι και εισαγάγετε ξανά το κλειδί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave no se conservó cuando se importó esta cartera. Aún la tienes: para almacenarla también en este iPhone, elimina esta cartera e importa la clave de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie võtit ei säilitatud, kui see rahakott imporditi. Teil on see endiselt — et seda ka sellel iPhone'il hoida, kustutage see rahakott ja importige võti uuesti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید شما هنگام وارد کردن این کیف پول نگه داشته نشد. شما همچنان آن را دارید — برای ذخیره‌ی آن روی این آیفون نیز، این کیف پول را حذف و کلید را دوباره وارد کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaintasi ei säilytetty, kun tämä lompakko tuotiin. Se on yhä sinulla — tallentaaksesi sen myös tähän iPhoneen, poista tämä lompakko ja tuo avain uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naitago ang iyong key noong na-import ang wallet na ito. Nasa iyo pa rin ito — para iimbak din ito sa iPhone na ito, tanggalin ang wallet na ito at i-import muli ang key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé n'a pas été conservée lors de l'importation de ce portefeuille. Vous l'avez toujours — pour la stocker aussi sur cet iPhone, supprimez ce portefeuille et réimportez la clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח שלך לא נשמר כאשר ארנק זה יובא. הוא עדיין ברשותך — כדי לשמור אותו גם ב-iPhone זה, מחק ארנק זה וייבא את המפתח שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वॉलेट को इंपोर्ट करते समय आपकी कुंजी नहीं रखी गई थी। यह अभी भी आपके पास है — इसे इस iPhone पर भी संग्रहीत करने के लिए, इस वॉलेट को हटाएँ और कुंजी फिर से इंपोर्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ nije sačuvan kada je ovaj novčanik uvezen. I dalje ga imate — da biste ga pohranili i na ovom iPhoneu, izbrišite ovaj novčanik i ponovno uvezite ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsod nem lett megőrizve, amikor ezt a tárcát importáltad. Még megvan neked — hogy ezen az iPhone-on is tárolódjon, töröld ezt a tárcát, és importáld újra a kulcsot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci Anda tidak disimpan saat dompet ini diimpor. Anda masih memilikinya — untuk menyimpannya di iPhone ini juga, hapus dompet ini dan impor kuncinya lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykillinn þinn var ekki geymdur þegar þetta veski var flutt inn. Þú átt hann enn — til að geyma hann líka á þessum iPhone skaltu eyða þessu veski og flytja lykilinn inn aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave non è stata conservata quando questo wallet è stato importato. La possiedi ancora — per memorizzarla anche su questo iPhone, elimina questo wallet e importa di nuovo la chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウォレットをインポートした際、鍵は保持されませんでした。あなたはまだそれを持っています — この iPhone にも保存するには、このウォレットを削除して鍵を再びインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지갑을 가져올 때 키가 보관되지 않았습니다. 키는 여전히 가지고 계십니다 — 이 iPhone에도 저장하려면 이 지갑을 삭제하고 키를 다시 가져오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų raktas nebuvo išsaugotas, kai ši piniginė buvo importuota. Jis vis dar turimas – kad jį išsaugotumėte ir šiame iPhone, ištrinkite šią piniginę ir importuokite raktą iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu atslēga netika saglabāta, kad šis maks tika importēts. Jums tā joprojām ir — lai to glabātu arī šajā iPhone, izdzēsiet šo maku un importējiet atslēgu vēlreiz."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വാലറ്റ് ഇറക്കുമതി ചെയ്തപ്പോൾ നിങ്ങളുടെ കീ സൂക്ഷിച്ചില്ല. അത് ഇപ്പോഴും നിങ്ങൾക്കുണ്ട് — അത് ഈ iPhone-ലും സംഭരിക്കാൻ, ഈ വാലറ്റ് ഇല്ലാതാക്കി കീ വീണ്ടും ഇറക്കുമതി ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे वॉलेट आयात केले तेव्हा तुमची की ठेवली गेली नाही. ती अजूनही तुमच्याकडे आहे — ती या iPhone वरही संग्रहित करण्यासाठी, हे वॉलेट हटवा आणि की पुन्हा आयात करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci anda tidak disimpan semasa dompet ini diimport. Anda masih memilikinya — untuk menyimpannya pada iPhone ini juga, padam dompet ini dan import kunci semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelen din ble ikke beholdt da denne lommeboken ble importert. Du har den fremdeles — for å lagre den på denne iPhonen også, slett denne lommeboken og importer nøkkelen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sleutel is niet bewaard toen deze wallet werd geïmporteerd. Je hebt hem nog — om hem ook op deze iPhone te bewaren, verwijder je deze wallet en importeer je de sleutel opnieuw."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਇਹ ਵਾਲਿਟ ਆਯਾਤ ਕੀਤਾ ਗਿਆ ਸੀ ਤਾਂ ਤੁਹਾਡੀ ਕੁੰਜੀ ਨਹੀਂ ਰੱਖੀ ਗਈ ਸੀ। ਇਹ ਅਜੇ ਵੀ ਤੁਹਾਡੇ ਕੋਲ ਹੈ — ਇਸਨੂੰ ਇਸ iPhone 'ਤੇ ਵੀ ਸਟੋਰ ਕਰਨ ਲਈ, ਇਹ ਵਾਲਿਟ ਮਿਟਾਓ ਅਤੇ ਕੁੰਜੀ ਦੁਬਾਰਾ ਆਯਾਤ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój klucz nie został zachowany podczas importu tego portfela. Nadal go masz — aby przechowywać go również na tym iPhonie, usuń ten portfel i zaimportuj klucz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave não foi mantida quando esta carteira foi importada. Você ainda a tem — para armazená-la também neste iPhone, exclua esta carteira e importe a chave novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia ta nu a fost păstrată când acest portofel a fost importat. O ai în continuare — pentru a o stoca și pe acest iPhone, șterge acest portofel și importă cheia din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ не был сохранён при импорте этого кошелька. Он по-прежнему у вас — чтобы хранить его и на этом iPhone, удалите этот кошелёк и импортируйте ключ снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš kľúč sa neuchoval pri importe tejto peňaženky. Stále ho máte — ak ho chcete uložiť aj na tomto iPhone, odstráňte túto peňaženku a importujte kľúč znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ ni bil ohranjen ob uvozu te denarnice. Še vedno ga imate — da ga shranite tudi na ta iPhone, izbrišite to denarnico in znova uvozite ključ."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ nije sačuvan kada je ovaj novčanik uvezen. I dalje ga imate — da biste ga sačuvali i na ovom iPhone-u, izbrišite ovaj novčanik i ponovo uvezite ključ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nyckel sparades inte när denna plånbok importerades. Du har den fortfarande — för att lagra den på denna iPhone också, ta bort denna plånbok och importera nyckeln igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufunguo wako haukuwekwa wakati wallet hii ilipoletwa. Bado unao — ili kuuhifadhi kwenye iPhone hii pia, futa wallet hii na ulete ufunguo tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வாலட் இறக்குமதி செய்யப்பட்டபோது உங்கள் விசை வைக்கப்படவில்லை. அது இன்னும் உங்களிடம் உள்ளது — அதை இந்த iPhone இலும் சேமிக்க, இந்த வாலட்டை நீக்கி விசையை மீண்டும் இறக்குமதி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వాలెట్ దిగుమతి చేయబడినప్పుడు మీ కీ ఉంచబడలేదు. అది ఇంకా మీ వద్ద ఉంది — దాన్ని ఈ iPhoneలో కూడా నిల్వ చేయడానికి, ఈ వాలెట్‌ను తొలగించి కీని మళ్లీ దిగుమతి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ของคุณไม่ได้ถูกเก็บไว้เมื่อนำเข้ากระเป๋าเงินนี้ คุณยังมีมันอยู่ — หากต้องการจัดเก็บบน iPhone นี้ด้วย ให้ลบกระเป๋าเงินนี้แล้วนำเข้าคีย์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cüzdan içe aktarılırken anahtarınız saklanmadı. Hâlâ sizde — bu iPhone'da da saklamak için bu cüzdanı silin ve anahtarı yeniden içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ не зберігся під час імпорту цього гаманця. Він усе ще у вас — щоб зберегти його й на цьому iPhone, видаліть цей гаманець і імпортуйте ключ знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس والیٹ کی درآمد کے وقت آپ کی کلید محفوظ نہیں رکھی گئی۔ یہ اب بھی آپ کے پاس ہے — اسے اس آئی فون پر بھی رکھنے کے لیے، اس والیٹ کو حذف کر کے کلید دوبارہ درآمد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa của bạn không được giữ lại khi ví này được nhập vào. Bạn vẫn còn nó — để lưu nó trên iPhone này nữa, hãy xóa ví này và nhập lại khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入此钱包时未保留你的密钥。你仍持有它——若想也将其存储在此 iPhone 上，请删除此钱包并重新导入密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入此錢包時未保留你的密鑰。你仍持有它——若想也將其儲存在此 iPhone 上，請刪除此錢包並重新匯入密鑰。"
          }
        }
      }
    },
    "Your keys never leave your iPhone.": {
      "comment": "Slide 3 hero title.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou sleutels verlaat nooit jou iPhone nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيحك لا تغادر iPhone أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите ключове никога не напускат вашия iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কী কখনও আপনার iPhone ছেড়ে যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves claus mai surten del teu iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše klíče nikdy neopustí váš iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine nøgler forlader aldrig din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Schlüssel verlassen Ihr iPhone nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλειδιά σας δεν φεύγουν ποτέ από το iPhone σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your keys never leave your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus claves nunca salen de tu iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu võtmed ei lahku kunagi sinu iPhone'ist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیدهای شما هرگز از iPhone خارج نمی‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimesi eivät koskaan poistu iPhonestasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kailanman umaalis ang iyong mga key sa iyong iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos clés ne quittent jamais votre iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתחות שלך לעולם לא יוצאים מה-iPhone שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुंजियाँ कभी आपके iPhone से बाहर नहीं जातीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši ključevi nikada ne napuštaju vaš iPhone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsai soha nem hagyják el az iPhone-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
