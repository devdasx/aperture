    "This only stops watching the address. Nothing secret is stored, so nothing is lost.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit stop net om die adres dop te hou. Niks geheim word gestoor nie, dus gaan niks verlore nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يوقف فقط مراقبة العنوان. لا يُخزَّن شيء سري، لذا لا يُفقد شيء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това само спира наблюдението на адреса. Нищо тайно не се съхранява, така че нищо не се губи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি শুধু ঠিকানাটি দেখা বন্ধ করে। কোনো গোপন কিছু সংরক্ষিত নেই, তাই কিছুই হারায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això només deixa d'observar l'adreça. No s'hi guarda res secret, de manera que no es perd res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se pouze přestane sledovat adresa. Nic tajného není uloženo, takže se nic neztratí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette stopper kun overvågningen af adressen. Intet hemmeligt er gemt, så intet går tabt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das beendet nur die Beobachtung der Adresse. Es wird nichts Geheimes gespeichert, also geht nichts verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό απλώς σταματά την παρακολούθηση της διεύθυνσης. Δεν αποθηκεύεται τίποτα μυστικό, οπότε δεν χάνεται τίποτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo deja de observar la dirección. No se almacena nada secreto, así que no se pierde nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ainult lõpetab aadressi jälgimise. Midagi salajast ei salvestata, seega midagi ei lähe kaduma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فقط نظارت بر نشانی را متوقف می‌کند. هیچ راز محرمانه‌ای ذخیره نشده، بنابراین چیزی از دست نمی‌رود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vain lopettaa osoitteen seuraamisen. Mitään salaista ei ole tallennettu, joten mitään ei menetetä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinitigil lang nito ang pagbabantay sa address. Walang lihim na nakaimbak, kaya walang mawawala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci arrête seulement la surveillance de l'adresse. Rien de secret n'est stocké, donc rien n'est perdu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו רק מפסיקה לעקוב אחר הכתובת. שום דבר סודי אינו נשמר, ולכן דבר אינו אובד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल पते को देखना बंद करता है। कोई गुप्त चीज़ संग्रहीत नहीं है, इसलिए कुछ नहीं खोता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo samo zaustavlja praćenje adrese. Ništa tajno nije pohranjeno, pa se ništa ne gubi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez csak leállítja a cím figyelését. Semmi titkos nincs tárolva, így semmi nem vész el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya menghentikan pemantauan alamat. Tidak ada rahasia yang disimpan, jadi tidak ada yang hilang."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta hættir aðeins að fylgjast með vistfanginu. Ekkert leyndarmál er geymt, svo ekkert glatast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo interrompe solo l'osservazione dell'indirizzo. Non è memorizzato nulla di segreto, quindi nulla va perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはアドレスの監視を停止するだけです。秘密の情報は保存されていないため、何も失われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이는 주소 감시만 중단합니다. 비밀이 저장되지 않으므로 손실되는 것이 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai tik nustoja stebėti adresą. Nieko slapto nesaugoma, todėl niekas neprarandama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas tikai pārtrauc adreses novērošanu. Nekas slepens netiek glabāts, tāpēc nekas netiek zaudēts."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് വിലാസം നിരീക്ഷിക്കുന്നത് മാത്രം നിർത്തുന്നു. രഹസ്യമൊന്നും സംഭരിച്ചിട്ടില്ല, അതിനാൽ ഒന്നും നഷ്ടപ്പെടുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे फक्त पत्त्याचे निरीक्षण थांबवते. कोणतीही गुप्त गोष्ट संग्रहित नाही, त्यामुळे काहीही गमावले जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya berhenti memerhati alamat. Tiada rahsia disimpan, jadi tiada apa-apa yang hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette stopper bare å overvåke adressen. Ingenting hemmelig er lagret, så ingenting går tapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit stopt alleen met het volgen van het adres. Er wordt niets geheims opgeslagen, dus er gaat niets verloren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਿਰਫ਼ ਪਤੇ ਨੂੰ ਦੇਖਣਾ ਬੰਦ ਕਰਦਾ ਹੈ। ਕੋਈ ਗੁਪਤ ਚੀਜ਼ ਸਟੋਰ ਨਹੀਂ ਹੈ, ਇਸ ਲਈ ਕੁਝ ਨਹੀਂ ਗੁਆਚਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jedynie przerywa obserwowanie adresu. Nie przechowuje się żadnych tajemnic, więc nic nie zostaje utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apenas para de observar o endereço. Nada secreto está armazenado, então nada é perdido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta doar oprește urmărirea adresei. Nimic secret nu este stocat, așa că nimic nu se pierde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это лишь прекращает наблюдение за адресом. Ничего секретного не хранится, поэтому ничего не теряется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto len zastaví sledovanie adresy. Nič tajné nie je uložené, takže sa nič nestratí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To samo ustavi opazovanje naslova. Nič tajnega ni shranjenega, zato se nič ne izgubi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo samo prekida praćenje adrese. Ništa tajno nije sačuvano, pa se ništa ne gubi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta slutar bara bevaka adressen. Inget hemligt är lagrat, så inget går förlorat."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii husimamisha tu kutazama anwani. Hakuna siri iliyohifadhiwa, kwa hiyo hakuna kinachopotea."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது முகவரியைக் கண்காணிப்பதை மட்டுமே நிறுத்துகிறது. ரகசியம் எதுவும் சேமிக்கப்படவில்லை, எனவே எதுவும் இழக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది చిరునామాను గమనించడాన్ని మాత్రమే ఆపుతుంది. రహస్యం ఏదీ నిల్వ చేయబడలేదు, కాబట్టి ఏమీ పోదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่เพียงหยุดเฝ้าดูที่อยู่เท่านั้น ไม่มีข้อมูลลับที่จัดเก็บไว้ จึงไม่มีอะไรสูญหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnızca adresi izlemeyi durdurur. Gizli hiçbir şey saklanmadığından hiçbir şey kaybolmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це лише припиняє спостереження за адресою. Нічого секретного не зберігається, тому нічого не втрачається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ صرف ایڈریس کو دیکھنا بند کرتا ہے۔ کوئی خفیہ چیز محفوظ نہیں، اس لیے کچھ ضائع نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này chỉ dừng theo dõi địa chỉ. Không có gì bí mật được lưu, nên không mất gì cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作仅停止观察该地址。未存储任何机密内容，因此不会丢失任何内容。"
          }
