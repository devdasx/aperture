          }
        }
      }
    },
    "Aperture estimates the gas limit automatically. Only change this if you know the transaction needs more.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture skat die gaslimiet outomaties. Verander dit net as jy weet die transaksie het meer nodig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقدّر Aperture حد الغاز تلقائيًا. غيّر هذا فقط إذا كنت تعلم أن المعاملة تحتاج إلى المزيد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture изчислява лимита на газ автоматично. Променяйте това само ако знаете, че транзакцията се нуждае от повече."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture স্বয়ংক্রিয়ভাবে গ্যাস সীমা অনুমান করে। লেনদেনের আরও প্রয়োজন বলে আপনি জানলে তবেই এটি পরিবর্তন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture estima el límit de gas automàticament. Canvia-ho només si saps que la transacció en necessita més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture odhaduje limit gasu automaticky. Měňte jej jen tehdy, víte-li, že transakce potřebuje více."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture beregner gasgrænsen automatisk. Ændr kun dette, hvis du ved, at transaktionen kræver mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture schätzt das Gaslimit automatisch. Ändere dies nur, wenn du weißt, dass die Transaktion mehr benötigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Aperture υπολογίζει αυτόματα το όριο gas. Αλλάξτε το μόνο αν γνωρίζετε ότι η συναλλαγή χρειάζεται περισσότερο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture estima el límite de gas automáticamente. Cámbialo solo si sabes que la transacción necesita más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture hindab gaasilimiidi automaatselt. Muutke seda ainult siis, kui teate, et tehing vajab rohkem."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture سقف گس را به‌طور خودکار تخمین می‌زند. این را فقط در صورتی تغییر دهید که می‌دانید تراکنش به مقدار بیشتری نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture arvioi gas-rajan automaattisesti. Muuta tätä vain, jos tiedät tapahtuman tarvitsevan enemmän."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong tinatantya ng Aperture ang gas limit. Baguhin lang ito kung alam mong kailangan ng transaksyon ang mas marami."
