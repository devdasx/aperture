          "stringUnit": {
            "state": "translated",
            "value": "SVG בלבד · צורה פשוטה ובודדת מניבה את התוצאה הטובה ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल SVG · सरल और एकल आकृति वाली फ़ाइलें सबसे अच्छी रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo SVG · jednostavan i jednodijelan motiv izgleda najbolje."
