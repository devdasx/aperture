        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিকভারি ফ্রেজ লেখা থাকলে, পরে এটি ইম্পোর্ট করে এই ওয়ালেট পুনরুদ্ধার করতে পারবেন। না থাকলে অর্থ চলে যাবে।"
