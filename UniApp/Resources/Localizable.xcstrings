    "This removes every dApp from the Recent section.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يحذف كل تطبيقات dApp من قسم «الأخيرة»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি “সাম্প্রতিক” বিভাগ থেকে সব dApp মুছে ফেলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això elimina totes les dApps de la secció «Recents»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se ze sekce „Nedávné“ odstraní všechny dApp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner alle dApps fra afsnittet „Seneste“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle dApps aus dem Bereich „Letzte“ entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αφαιρεί όλα τα dApps από την ενότητα «Πρόσφατα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every dApp from the Recent section."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todas las dApps de la sección «Recientes»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار هر dApp را از بخش اخیر حذف می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki dAppit Viimeisimmät-osiosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire toutes les dApps de la section Récent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
