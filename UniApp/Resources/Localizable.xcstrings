    "Anyone who has your recovery phrase has full access to your wallet.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Enigiemand wat jou herstelfrase het, het volle toegang tot jou beursie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي شخص يمتلك عبارة الاسترداد الخاصة بك لديه وصول كامل إلى محفظتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки, който има вашата фраза за възстановяване, има пълен достъп до портфейла ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যার কাছে আপনার রিকভারি ফ্রেজ আছে, তার আপনার ওয়ালেটে পূর্ণ অ্যাক্সেস রয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsevol persona que tingui la teva frase de recuperació té accés total a la teva cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdokoli, kdo má vaši obnovovací frázi, má plný přístup k vaší peněžence."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhver, der har din gendannelsesfrase, har fuld adgang til din wallet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer Ihre Wiederherstellungsphrase hat, hat vollen Zugriff auf Ihr Wallet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όποιος έχει τη φράση ανάκτησής σας έχει πλήρη πρόσβαση στο πορτοφόλι σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who has your recovery phrase has full access to your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que tenga tu frase de recuperación tiene acceso total a tu billetera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igaühel, kellel on teie taastefraas, on teie rahakotile täielik juurdepääs."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هرکس عبارت بازیابی شما را داشته باشد، به کیف پولتان دسترسی کامل دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa, jolla on palautuslauseesi, pääsee lompakkoosi täysin käsiksi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung sino man ang may hawak ng inyong recovery phrase ay may buong access sa wallet ninyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque possède votre phrase de récupération a un accès complet à votre portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכל מי שיש לו את ביטוי השחזור שלך יש גישה מלאה לארנק שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस किसी के पास आपका रिकवरी फ़्रेज़ है, उसकी आपके वॉलेट तक पूरी पहुँच है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svatko tko ima vašu frazu za oporavak ima potpuni pristup vašem novčaniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bárki, akinél az Ön helyreállítási kifejezése van, teljes hozzáféréssel rendelkezik a tárcájához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun yang memiliki frasa pemulihan Anda memiliki akses penuh ke dompet Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver sem hefur endurheimtarsetninguna þína hefur fullan aðgang að veskinu þínu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque possieda la sua frase di recupero ha pieno accesso al suo portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元フレーズを持っている人は、あなたのウォレットに完全にアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 문구를 가진 사람은 누구나 지갑에 완전히 접근할 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bet kas, turintis jūsų atkūrimo frazę, turi visišką prieigą prie jūsų piniginės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikvienam, kuram ir jūsu atkopšanas frāze, ir pilna piekļuve jūsu maciņam."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റിക്കവറി വാക്യം കൈവശമുള്ള ആർക്കും നിങ്ങളുടെ വാലറ്റിലേക്ക് പൂർണ്ണ ആക്സസ് ഉണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्याच्याकडे तुमचा रिकव्हरी फ्रेज आहे, त्याला तुमच्या वॉलेटवर पूर्ण प्रवेश आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa yang memiliki frasa pemulihan anda mempunyai akses penuh kepada dompet anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle som har gjenopprettingsfrasen din har full tilgang til lommeboken din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen met je herstelzin heeft volledige toegang tot je portemonnee."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਸ ਕੋਲ ਵੀ ਤੁਹਾਡਾ ਰਿਕਵਰੀ ਫ਼ਰੇਜ਼ ਹੈ, ਉਸਨੂੰ ਤੁਹਾਡੇ ਵਾਲਿਟ ਤੱਕ ਪੂਰੀ ਪਹੁੰਚ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy, kto ma Twoją frazę odzyskiwania, ma pełny dostęp do portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com sua frase de recuperação tem acesso total à sua carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine are fraza ta de recuperare are acces complet la portofelul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У любого, у кого есть ваша фраза восстановления, есть полный доступ к вашему кошельку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktokoľvek, kto má vašu obnovovaciu frázu, má úplný prístup k vašej peňaženke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdor koli ima vašo obnovitveno frazo, ima poln dostop do vaše denarnice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Свако ко има вашу фразу за опоравак има пун приступ вашем новчанику."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som har din återställningsfras har full åtkomst till din plånbok."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeyote anayemiliki maneno yako ya kurejesha ana ufikiaji kamili wa pochi yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மீட்பு சொற்றொடரை வைத்திருக்கும் எவருக்கும் உங்கள் வாலெட்டிற்கு முழு அணுகல் இருக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రికవరీ పదబంధం ఉన్న ఎవరికైనా మీ వాలెట్‌కు పూర్తి యాక్సెస్ ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็ตามที่มีวลีกู้คืนของคุณจะเข้าถึงกระเป๋าของคุณได้เต็มที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma ifadenize sahip olan herkes cüzdanınıza tam erişim sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-хто, хто має вашу фразу відновлення, має повний доступ до вашого гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس کسی کے پاس آپ کا ریکوری فقرہ ہے، اسے آپ کے والیٹ تک مکمل رسائی حاصل ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai có cụm từ khôi phục của bạn đều có toàn quyền truy cập vào ví của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有你恢复短语的人都能完全访问你的钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
