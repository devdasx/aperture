    "Hidden assets and chains stay in your wallet — only the wallet-home display changes. Bring them back any time.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Versteekte bates en kettings bly in jou beursie — net die beursie-tuisskerm se vertoning verander. Bring hulle enige tyd terug."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأصول والسلاسل المخفية في محفظتك — يتغيّر فقط ما يظهر في الشاشة الرئيسية للمحفظة. يمكنك إعادة إظهارها في أي وقت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Скритите активи и вериги остават в портфейла Ви — променя се само изгледът на началния екран. Върнете ги по всяко време."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লুকানো সম্পদ এবং চেইন আপনার ওয়ালেটেই থাকে — কেবল ওয়ালেট-হোমের প্রদর্শন বদলায়। আপনি যেকোনো সময় সেগুলো ফিরিয়ে আনতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els actius i les cadenes ocults continuen a la vostra cartera — només canvia el que es mostra a la pantalla d’inici. Els podeu tornar a mostrar quan vulgueu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrytá aktiva a řetězce zůstávají ve vaší peněžence — mění se jen zobrazení na hlavní obrazovce. Můžete je kdykoli znovu zobrazit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte aktiver og kæder forbliver i din tegnebog — kun visningen på startsiden ændres. Du kan hente dem frem igen når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Assets und Chains bleiben in Ihrer Wallet — nur die Anzeige auf der Wallet-Startseite ändert sich. Sie können sie jederzeit wieder einblenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κρυφά στοιχεία και δίκτυα παραμένουν στο πορτοφόλι σας — αλλάζει μόνο η εμφάνιση στην αρχική. Μπορείτε να τα επαναφέρετε ανά πάσα στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden assets and chains stay in your wallet — only the wallet-home display changes. Bring them back any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los activos y cadenas ocultos permanecen en tu cartera — solo cambia lo que se muestra en el inicio. Vuelve a mostrarlos cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peidetud varad ja võrgud jäävad sinu rahakotti — muutub ainult avakuva. Too need igal ajal tagasi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دارایی‌ها و شبکه‌های پنهان‌شده در کیف پول شما باقی می‌مانند — فقط نمایش صفحه اصلی کیف پول تغییر می‌کند. هر زمان می‌توانید آن‌ها را بازگردانید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilotetut omaisuuserät ja ketjut säilyvät lompakossasi — vain aloitusnäkymä muuttuu. Voit tuoda ne takaisin milloin tahansa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili sa wallet mo ang mga itinagong asset at network — ang display lang ng wallet home ang nagbabago. Maibabalik mo ito anumang oras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actifs et chaînes masqués restent dans votre portefeuille — seul l’affichage de l’accueil change. Rétablissez-les à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נכסים ורשתות מוסתרים נשארים בארנק שלך — רק התצוגה במסך הבית של הארנק משתנה. אפשר להחזיר אותם בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छिपी हुई संपत्तियाँ और चेन आपके वॉलेट में बनी रहती हैं — केवल वॉलेट होम का प्रदर्शन बदलता है। आप उन्हें कभी भी वापस ला सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivena imovina i lanci ostaju u vašem novčaniku — mijenja se samo prikaz na početnom zaslonu. Možete ih vratiti u bilo kojem trenutku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elrejtett eszközök és láncok a tárcájában maradnak — csak a tárca kezdőképernyőjének megjelenése változik. Bármikor visszahozhatja őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aset dan jaringan yang disembunyikan tetap berada di dompet Anda — hanya tampilan beranda dompet yang berubah. Kembalikan kapan saja."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Faldar eignir og keðjur eru áfram í veskinu þínu — aðeins heimaskjárinn breytist. Sæktu þær aftur hvenær sem er."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risorse e le chain nascoste rimangono nel suo portafoglio — cambia solo la schermata principale. Può ripristinarle in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示にした資産とチェーンはウォレットに残ります — ウォレットホームでの表示だけが変わります。いつでも再表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 자산과 체인은 지갑에 그대로 남아 있어요. 지갑 홈 화면 표시만 바뀝니다. 언제든 다시 표시할 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paslėpti aktyvai ir tinklai lieka Jūsų piniginėje — keičiasi tik piniginės pradinio ekrano vaizdas. Bet kada galite juos grąžinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paslēptie aktīvi un tīkli paliek Jūsu makā — mainās tikai sākumekrāna izskats. Tos var atgriezt jebkurā laikā."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറച്ച ആസ്തികളും ശൃംഖലകളും നിങ്ങളുടെ വാലറ്റിൽ തുടരും — വാലറ്റ് ഹോം ഡിസ്‌പ്ലേ മാത്രമേ മാറുകയുള്ളൂ. എപ്പോൾ വേണമെങ്കിലും തിരികെ കൊണ്ടുവരാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लपवलेली मालमत्ता आणि नेटवर्क तुमच्या वॉलेटमध्येच राहतात — फक्त वॉलेट होमचे प्रदर्शन बदलते. कधीही परत आणा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aset dan rangkaian yang disembunyikan kekal dalam dompet anda — hanya paparan halaman utama dompet yang berubah. Kembalikan pada bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte aktiva og kjeder forblir i lommeboken din — bare visningen på startsiden endres. Du kan hente dem tilbake når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen activa en netwerken blijven in je wallet — alleen de weergave op het startscherm verandert. Breng ze terug wanneer je wilt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੁਕਾਈਆਂ ਜਾਇਦਾਦਾਂ ਅਤੇ ਚੇਨਾਂ ਤੁਹਾਡੇ ਵਾਲਿਟ ਵਿੱਚ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ — ਸਿਰਫ਼ ਵਾਲਿਟ ਹੋਮ ਦੀ ਡਿਸਪਲੇ ਬਦਲਦੀ ਹੈ। ਜਦ ਚਾਹੋ ਮੁੜ ਲੈ ਆਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte aktywa i sieci pozostają w portfelu — zmienia się tylko ekran główny. Można je przywrócić w dowolnej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ativos e redes ocultos continuam na sua carteira — só a exibição da tela inicial muda. Você pode trazê-los de volta a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activele și rețelele ascunse rămân în portofelul tău — se schimbă doar afișarea de pe ecranul principal. Le poți readuce oricând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытые активы и сети остаются в вашем кошельке — меняется только то, что показано на главном экране. Их можно вернуть в любой момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryté aktíva a reťazce zostávajú vo vašej peňaženke — mení sa len zobrazenie na hlavnej obrazovke. Kedykoľvek ich môžete znova zobraziť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrita sredstva in verige ostanejo v vaši denarnici — spremeni se le prikaz na začetni strani. Kadar koli jih lahko spet pokažete."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сакривена имовина и ланци остају у вашем новчанику — мења се само приказ на почетном екрану. Можете их вратити у било ком тренутку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolda tillgångar och kedjor finns kvar i din plånbok — endast visningen på startsidan ändras. Du kan ta fram dem igen när som helst."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali na mitandao iliyofichwa hubaki kwenye pochi yako — mwonekano wa ukurasa wa nyumbani pekee ndio unaobadilika. Rudisha wakati wowote."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மறைக்கப்பட்ட சொத்துக்களும் சங்கிலிகளும் உங்கள் வாலட்டில் தங்கி இருக்கும் — வாலட் முகப்புத் திரையின் காட்சி மட்டுமே மாறுகிறது. எப்போது வேண்டுமானாலும் திரும்பக் கொண்டுவாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాచిన ఆస్తులు, నెట్‌వర్క్‌లు మీ వాలెట్‌లోనే ఉంటాయి — వాలెట్ హోమ్ ప్రదర్శన మాత్రమే మారుతుంది. ఎప్పుడైనా తిరిగి తీసుకురావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สินทรัพย์และเชนที่ซ่อนไว้ยังอยู่ในกระเป๋าของคุณ มีเพียงการแสดงผลในหน้าหลักที่เปลี่ยนไป นำกลับมาเมื่อใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlenen varlıklar ve zincirler cüzdanınızda kalır — yalnızca cüzdan ana ekranındaki görünüm değişir. İstediğiniz zaman geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховані активи й мережі залишаються у вашому гаманці — змінюється лише вигляд головного екрана. Ви можете повернути їх будь-коли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چھپائی گئی اثاثے اور چینز آپ کے والیٹ میں موجود رہتی ہیں — صرف والیٹ ہوم کی ڈسپلے بدلتی ہے۔ جب چاہیں واپس لے آئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài sản và chuỗi đã ẩn vẫn còn trong ví — chỉ có hiển thị trên màn hình ví thay đổi. Bạn có thể hiện lại bất kỳ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏的资产和链仍在你的钱包里 — 只是钱包主页的显示有所变化。随时可以让它们重新出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已隱藏的資產和鏈仍在你的錢包裡 — 只是錢包主畫面的顯示有所改變。隨時可以讓它們重新出現。"
          }
        }
      }
    },
