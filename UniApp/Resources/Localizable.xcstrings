        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture गैस लिमिट का अनुमान स्वतः लगाता है। इसे केवल तभी बदलें जब आप जानते हों कि ट्रांज़ैक्शन को अधिक की आवश्यकता है।"
