        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Athugaðu upprunalegu setninguna sem þú skrifaðir niður — þetta orð gæti verið úr öðrum orðalista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la frase originale che hai annotato — questa parola potrebbe provenire da un elenco diverso."
