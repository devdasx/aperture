    "The network fee is displayed before you sign. No surprises after.": {
      "comment": "Slide 7 body.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die netwerkfooi word voor jy teken vertoon. Geen verrassings agterna nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض رسوم الشبكة قبل التوقيع. لا مفاجآت بعد ذلك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мрежовата такса се показва преди да подпишете. Без изненади след това."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সই করার আগেই নেটওয়ার্ক ফি দেখানো হয়। পরে কোনো চমক নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La comissió de xarxa es mostra abans de signar. Cap sorpresa després."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatek sítě se zobrazí ještě před podpisem. Žádná překvapení po něm."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværksgebyret vises, før du underskriver. Ingen overraskelser bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Netzwerkgebühr wird vor der Signatur angezeigt. Keine Überraschungen danach."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προμήθεια δικτύου εμφανίζεται πριν υπογράψετε. Καμία έκπληξη μετά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network fee is displayed before you sign. No surprises after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión de red se muestra antes de firmar. Sin sorpresas después."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrgutasu kuvatakse enne, kui sa allkirjastad. Pärast üllatusi pole."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارمزد شبکه پیش از امضا نمایش داده می‌شود. هیچ غافلگیری پس از آن نخواهد بود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkomaksu näkyy ennen allekirjoittamista. Ei yllätyksiä jälkikäteen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ang network fee bago ka mag-sign. Walang sorpresa pagkatapos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais de réseau s’affichent avant la signature. Aucune surprise ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמלת הרשת מוצגת לפני החתימה. בלי הפתעות אחרי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क शुल्क हस्ताक्षर से पहले दिखाया जाता है। बाद में कोई आश्चर्य नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naknada mreže prikazuje se prije potpisivanja. Bez iznenađenja poslije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hálózati díj a aláírás előtt látszik. Utána nincs meglepetés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya jaringan ditampilkan sebelum Anda menandatangani. Tidak ada kejutan setelahnya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Netgjaldið er sýnt áður en þú undirritar. Engar óvæntar upphæðir á eftir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La commissione di rete è mostrata prima della firma. Nessuna sorpresa dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク手数料は署名の前に表示されます。あとからの驚きはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 수수료는 서명 전에 표시됩니다. 뒤늦은 놀라움은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinklo mokestis rodomas prieš jums pasirašant. Jokių staigmenų po to."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tīkla maksa tiek parādīta pirms parakstīšanas. Pēc tam pārsteigumu nav."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഒപ്പിടുന്നതിന് മുമ്പ് നെറ്റ്‌വർക്ക് ഫീസ് കാണിക്കും. പിന്നീട് അത്ഭുതങ്ങളില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही साइन करण्याआधी नेटवर्क फी दाखवली जाते. नंतर कोणतीही नवलाई नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuran rangkaian dipaparkan sebelum anda menandatangani. Tiada kejutan selepas itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverksgebyret vises før du signerer. Ingen overraskelser etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De netwerkkosten zijn zichtbaar voordat je ondertekent. Geen verrassingen achteraf."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਦਸਤਖਤ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਨੈੱਟਵਰਕ ਫੀਸ ਦਿਖਾਈ ਜਾਂਦੀ ਹੈ। ਬਾਅਦ ਵਿੱਚ ਕੋਈ ਹੈਰਾਨੀ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłata sieciowa jest pokazywana przed podpisaniem. Później bez niespodzianek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de rede é exibida antes de você assinar. Nenhuma surpresa depois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comisionul rețelei e afișat înainte să semnezi. Fără surprize după."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия сети показывается до подписи. Никаких сюрпризов после."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieťový poplatok sa zobrazí pred podpisom. Žiadne prekvapenia potom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omrežna provizija je prikazana pred podpisom. Brez presenečenj pozneje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Накнада мреже приказује се пре потписивања. Без изненађења после."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätverksavgiften visas innan du signerar. Inga överraskningar efteråt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada ya mtandao huonyeshwa kabla ya kusaini. Hakuna mshangao baadaye."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் கையொப்பமிடும் முன் வலையமைப்பு கட்டணம் காண்பிக்கப்படும். பிறகு எந்த ஆச்சரியமும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సంతకం చేయడానికి ముందే నెట్‌వర్క్ ఫీజ్ చూపబడుతుంది. ఆ తర్వాత ఆశ్చర్యాలు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าธรรมเนียมเครือข่ายแสดงก่อนการลงนาม ไม่มีเซอร์ไพรส์ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ ücreti, imzadan önce gösterilir. Sonradan sürpriz olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісію мережі видно ще до підпису. Жодних сюрпризів після."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیٹ‌ورک کی فیس آپ کے دستخط سے پہلے دکھائی جاتی ہے۔ بعد میں کوئی حیرت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phí mạng được hiển thị trước khi bạn ký. Không có bất ngờ về sau."
