    "Could not decrypt the key. Try restarting Aperture.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon nie die sleutel ontsyfer nie. Probeer Aperture herbegin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فك تشفير المفتاح. جرّب إعادة تشغيل Aperture."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът не можа да бъде декриптиран. Опитайте да рестартирате Aperture."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী ডিক্রিপ্ট করা যায়নি। Aperture পুনরায় চালু করে দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut desxifrar la clau. Prova de reiniciar Aperture."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč se nepodařilo dešifrovat. Zkuste Aperture restartovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke dekryptere nøglen. Prøv at genstarte Aperture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel konnte nicht entschlüsselt werden. Starte Aperture neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποκρυπτογράφηση του κλειδιού. Δοκιμάστε να επανεκκινήσετε το Aperture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descifrar la clave. Prueba a reiniciar Aperture."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võtit ei õnnestunud dekrüpteerida. Proovige Aperture taaskäivitada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمزگشایی کلید ممکن نشد. Aperture را دوباره راه‌اندازی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avainta ei voitu purkaa. Kokeile käynnistää Aperture uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-decrypt ang key. Subukang i-restart ang Aperture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déchiffrer la clé. Essayez de redémarrer Aperture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפענח את המפתח. נסה להפעיל מחדש את Aperture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी डिक्रिप्ट नहीं हो सकी। Aperture को पुनः आरंभ करके देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ nije moguće dešifrirati. Pokušajte ponovno pokrenuti Aperture."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsot nem sikerült visszafejteni. Próbáld újraindítani az Aperture-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mendekripsi kunci. Coba mulai ulang Aperture."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að afkóða lykilinn. Reyndu að endurræsa Aperture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decifrare la chiave. Prova a riavviare Aperture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵を復号できませんでした。Aperture を再起動してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 복호화할 수 없습니다. Aperture를 다시 시작해 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko iššifruoti rakto. Bandykite paleisti Aperture iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās atšifrēt atslēgu. Mēģiniet restartēt Aperture."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കീ ഡീക്രിപ്റ്റ് ചെയ്യാനായില്ല. Aperture പുനരാരംഭിക്കാൻ ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "की डिक्रिप्ट करता आली नाही. Aperture पुन्हा सुरू करून पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyahsulit kunci. Cuba mulakan semula Aperture."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke dekryptere nøkkelen. Prøv å starte Aperture på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon de sleutel niet ontsleutelen. Probeer Aperture opnieuw te starten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁੰਜੀ ਡੀਕ੍ਰਿਪਟ ਨਹੀਂ ਹੋ ਸਕੀ। Aperture ਨੂੰ ਮੁੜ ਚਾਲੂ ਕਰਕੇ ਦੇਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odszyfrować klucza. Spróbuj ponownie uruchomić Aperture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível descriptografar a chave. Tente reiniciar o Aperture."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia nu a putut fi decriptată. Încearcă să repornești Aperture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось расшифровать ключ. Попробуйте перезапустить Aperture."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč sa nepodarilo dešifrovať. Skúste reštartovať Aperture."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključa ni bilo mogoče dešifrirati. Poskusite znova zagnati Aperture."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dešifrovanje ključa nije uspelo. Pokušajte da ponovo pokrenete Aperture."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte dekryptera nyckeln. Försök starta om Aperture."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuweza kufichua ufunguo. Jaribu kuanzisha upya Aperture."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விசையை மறைகுறியாக்க முடியவில்லை. Aperture ஐ மறுதொடக்கம் செய்ய முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కీని డీక్రిప్ట్ చేయలేకపోయింది. Apertureను పునఃప్రారంభించడానికి ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถถอดรหัสคีย์ได้ ลองเริ่ม Aperture ใหม่"
