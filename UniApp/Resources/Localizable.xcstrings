        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे मालमत्ता तपशीलासाठी प्रत्येक फिल्टर आणि क्रमवारी निवड साफ करते. सुरू ठेवायचे?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mengosongkan setiap penapis dan pilihan isihan untuk butiran aset. Teruskan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tømmer alle filtre og sorteringsvalg for ressursdetaljene. Fortsette?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wis je elke filter- en sorteerkeuze voor assetdetails. Doorgaan?"
