        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincsenek fiókok. Nincsenek szerverek. Nincs analitika, amely az egyenlegedet figyelné. Nincs ügyfélszolgálat, akinek a nevében át lehetne verni."
