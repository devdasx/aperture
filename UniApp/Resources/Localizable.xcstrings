    "Amount and recipient are the next step we'll build.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedrag en ontvanger is die volgende stap wat ons gaan bou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المبلغ والمستلم هما الخطوة التالية التي سنبنيها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумата и получателят са следващата стъпка, която ще изградим."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিমাণ ও প্রাপক হলো আমাদের পরবর্তী যে ধাপটি তৈরি করব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'import i el destinatari són el següent pas que construirem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka a příjemce jsou další krok, který připravíme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beløb og modtager er næste trin, vi bygger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrag und Empfänger sind der nächste Schritt, den wir bauen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ποσό και ο παραλήπτης είναι το επόμενο βήμα που θα δημιουργήσουμε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount and recipient are the next step we'll build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe y el destinatario son el próximo paso que vamos a crear."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Summa ja saaja on järgmine samm, mille loome."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مبلغ و گیرنده گام بعدی است که خواهیم ساخت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrä ja vastaanottaja ovat seuraava vaihe, jonka rakennamme."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang halaga at tatanggap ang susunod na hakbang na aming bubuuin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant et le destinataire sont la prochaine étape que nous développerons."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סכום ונמען הם השלב הבא שנבנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राशि और प्राप्तकर्ता अगला चरण है जिसे हम बनाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iznos i primatelj sljedeći su korak koji ćemo izgraditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összeg és a címzett a következő lépés, amelyet megépítünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah dan penerima adalah langkah berikutnya yang akan kami bangun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Upphæð og viðtakandi eru næsta skrefið sem við byggjum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importo e destinatario sono il prossimo passo che realizzeremo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額と受取人は次に作成する手順です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액과 받는 사람은 다음에 구축할 단계입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma ir gavėjas yra kitas žingsnis, kurį sukursime."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Summa un saņēmējs ir nākamais solis, ko izveidosim."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുകയും സ്വീകർത്താവും ഞങ്ങൾ നിർമ്മിക്കാൻ പോകുന്ന അടുത്ത ഘട്ടമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रक्कम आणि प्राप्तकर्ता ही पुढची पायरी आहे जी आम्ही तयार करू."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaun dan penerima ialah langkah seterusnya yang akan kami bina."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beløp og mottaker er neste steg vi bygger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedrag en ontvanger zijn de volgende stap die we bouwen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਕਮ ਅਤੇ ਪ੍ਰਾਪਤਕਰਤਾ ਅਗਲਾ ਪੜਾਅ ਹੈ ਜੋ ਅਸੀਂ ਬਣਾਵਾਂਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota i odbiorca to kolejny krok, który zbudujemy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor e destinatário são a próxima etapa que vamos criar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma și destinatarul sunt următorul pas pe care îl vom construi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма и получатель — следующий шаг, который мы создадим."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma a príjemca sú ďalší krok, ktorý vytvoríme."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znesek in prejemnik sta naslednji korak, ki ga bomo zgradili."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iznos i primalac su sledeći korak koji ćemo izgraditi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Belopp och mottagare är nästa steg vi bygger."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiasi na mpokeaji ndio hatua inayofuata tutakayoijenga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொகை மற்றும் பெறுநர் நாங்கள் உருவாக்கப் போகும் அடுத்த படி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొత్తం మరియు స్వీకర్త మేము నిర్మించబోయే తదుపరి దశ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเงินและผู้รับเป็นขั้นตอนถัดไปที่เราจะสร้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutar ve alıcı, oluşturacağımız bir sonraki adımdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума та одержувач — наступний крок, який ми реалізуємо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رقم اور وصول کنندہ اگلا مرحلہ ہیں جو ہم بنائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền và người nhận là bước tiếp theo chúng tôi sẽ xây dựng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额和收款人是我们接下来要构建的步骤。"
          }
        },
