        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sláðu inn mestu verðbreytingu sem þú sættir þig við. Lægra er öruggara; hærra uppfyllist oftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la variazione di prezzo massima che accetti. Più bassa è più sicura; più alta si esegue più spesso."
