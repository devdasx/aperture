          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-iimport ang Aperture ng mga key nang lokal. Walang umaalis sa iPhone na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture importe les clés localement. Rien ne quitte cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture מייבא מפתחות מקומית. שום דבר לא יוצא מה‑iPhone הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture कुंजियों को स्थानीय रूप से आयात करता है। कुछ भी इस iPhone से बाहर नहीं जाता।"
