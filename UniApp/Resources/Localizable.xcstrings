    "Sending a transaction is irreversible. Only confirm transactions you initiated and understand.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om 'n transaksie te stuur is onomkeerbaar. Bevestig slegs transaksies wat jy begin het en verstaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال المعاملة لا يمكن التراجع عنه. أكّد فقط المعاملات التي بدأتها وتفهمها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпращането на транзакция е необратимо. Потвърждавайте само транзакции, които сте инициирали и разбирате."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেন পাঠানো অপরিবর্তনীয়। শুধু সেই লেনদেনই নিশ্চিত করুন যেগুলো আপনি শুরু করেছেন এবং বুঝেছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar una transacció és irreversible. Confirma només les transaccions que has iniciat tu i que entens."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslání transakce je nevratné. Potvrzujte jen transakce, které jste sami zahájili a kterým rozumíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At sende en transaktion er uigenkaldeligt. Bekræft kun transaktioner, du selv har startet og forstår."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Transaktion zu senden ist unwiderruflich. Bestätige nur Transaktionen, die du selbst initiiert und verstanden hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποστολή συναλλαγής είναι μη αναστρέψιμη. Επιβεβαιώστε μόνο τις συναλλαγές που εσείς ξεκινήσατε και κατανοείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending a transaction is irreversible. Only confirm transactions you initiated and understand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar una transacción es irreversible. Confirma solo las transacciones que iniciaste y entiendes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehingu saatmine on pöördumatu. Kinnita ainult tehinguid, mille sina algatasid ja millest aru saad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسال تراکنش برگشت‌ناپذیر است. فقط تراکنش‌هایی را تأیید کنید که خودتان آغاز کرده و درک می‌کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtuman lähettämistä ei voi peruuttaa. Vahvista vain tapahtumat, jotka olet itse käynnistänyt ja ymmärrät."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na maibabalik ang pagpapadala ng transaksyon. Kumpirmahin lamang ang mga transaksyong sinimulan at naiintindihan mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer une transaction est irréversible. Ne confirmez que les transactions que vous avez initiées et comprenez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליחת עסקה היא בלתי הפיכה. יש לאשר רק עסקאות שיזמת ושאתה מבין/ה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेनदेन भेजना अपरिवर्तनीय है। केवल वही लेनदेन कन्फ़र्म करें जो आपने स्वयं शुरू किए हों और समझे हों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slanje transakcije je nepovratno. Potvrdite samo transakcije koje ste sami pokrenuli i koje razumijete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy tranzakció elküldése visszafordíthatatlan. Csak olyan tranzakciókat erősíts meg, amelyeket te indítottál el és értesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim transaksi tidak dapat dibatalkan. Hanya konfirmasi transaksi yang Anda mulai dan pahami."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending færslu er óafturkræf. Staðfestu aðeins færslur sem þú hófst og skilur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviare una transazione è irreversibile. Confermi solo le transazioni che ha avviato e che comprende."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションの送信は取り消せません。自分で開始し、内容を理解しているトランザクションだけを承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래 전송은 되돌릴 수 없어요. 직접 시작했고 이해하는 거래만 확인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijos siuntimas yra negrįžtamas. Patvirtinkite tik tas operacijas, kurias pradėjote patys ir suprantate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījuma sūtīšana ir neatgriezeniska. Apstipriniet tikai tos darījumus, kurus jūs uzsākāt un saprotat."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഇടപാട് അയയ്‌ക്കുന്നത് മാറ്റാനാവാത്തതാണ്. നിങ്ങൾ ആരംഭിക്കുകയും മനസ്സിലാക്കുകയും ചെയ്‌ത ഇടപാടുകൾ മാത്രം സ്ഥിരീകരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवहार पाठवणे अपरिवर्तनीय आहे. तुम्ही सुरू केलेले आणि समजलेले व्यवहारच पुष्टी करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar transaksi tidak boleh diubah balik. Hanya sahkan transaksi yang anda mulakan dan fahami."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sende en transaksjon kan ikke angres. Bekreft kun transaksjoner du selv har startet og forstår."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een transactie verzenden is onomkeerbaar. Bevestig alleen transacties die je zelf hebt gestart en begrijpt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੈਣ-ਦੇਣ ਭੇਜਣਾ ਅਟੱਲ ਹੈ। ਸਿਰਫ਼ ਉਹ ਲੈਣ-ਦੇਣ ਪੁਸ਼ਟ ਕਰੋ ਜੋ ਤੁਸੀਂ ਸ਼ੁਰੂ ਕੀਤੇ ਅਤੇ ਸਮਝਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłanie transakcji jest nieodwracalne. Potwierdzaj tylko transakcje, które sam zainicjowałeś i rozumiesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar uma transação é irreversível. Confirme apenas transações que você iniciou e entende."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiterea unei tranzacții este ireversibilă. Confirmă doar tranzacțiile pe care le-ai inițiat și le înțelegi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправку транзакции невозможно отменить. Подтверждайте только те транзакции, которые вы инициировали и понимаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odoslanie transakcie je nezvratné. Potvrdzujte len transakcie, ktoré ste začali a ktorým rozumiete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljanje transakcije je nepovratno. Potrdite le transakcije, ki ste jih sprožili in jih razumete."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слање трансакције је неповратно. Потврдите само трансакције које сте сами покренули и разумете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att skicka en transaktion är oåterkalleligt. Bekräfta endast transaktioner som du själv har initierat och förstår."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutuma muamala hakuwezi kutenduliwa. Thibitisha tu miamala uliyoianzisha na unayoelewa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனையை அனுப்புவது மீளமுடியாதது. நீங்கள் தொடங்கி, புரிந்துகொண்ட பரிவர்த்தனைகளை மட்டுமே உறுதிப்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లావాదేవీని పంపడం తిరిగి మార్చలేనిది. మీరు ప్రారంభించి, అర్థం చేసుకున్న లావాదేవీలను మాత్రమే నిర్ధారించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งธุรกรรมย้อนกลับไม่ได้ ยืนยันเฉพาะธุรกรรมที่คุณเริ่มและเข้าใจเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir işlem göndermek geri alınamaz. Yalnızca kendi başlattığınız ve anladığınız işlemleri onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання транзакції незворотне. Підтверджуйте лише ті транзакції, які ви ініціювали й розумієте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین بھیجنا ناقابلِ واپسی ہے۔ صرف وہی لین دین تصدیق کریں جو آپ نے شروع کیے اور سمجھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi một giao dịch là không thể đảo ngược. Chỉ xác nhận các giao dịch do bạn khởi tạo và hiểu rõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送交易不可撤销。只确认你自己发起且理解的交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送交易無法撤回。只確認你自己發起且理解的交易。"
          }
        }
      }
    },
