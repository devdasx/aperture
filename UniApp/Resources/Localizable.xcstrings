        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukea ei ole, salasanaa ei voi nollata, palautusta ei ole."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang support team, walang password reset, walang recovery."
