        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala sa mga entry ang na-validate para sa %@. I-tap ang balik at suriin ang bawat address o key."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna ingizo lililothibitishwa kwa %@. Gusa rudi nyuma na ukague kila anwani au ufunguo."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen van die inskrywings is vir %@ gevalideer nie. Tik terug en kontroleer elke adres of sleutel."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கான எந்த உள்ளீடும் சரிபார்க்கப்படவில்லை. பின்னால் தட்டி ஒவ்வொரு முகவரி அல்லது விசையையும் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కోసం ఏ ఎంట్రీలు ధృవీకరించబడలేదు. వెనక్కి నొక్కి ప్రతి చిరునామా లేదా కీని తనిఖీ చేయండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-നായി എൻട്രികളൊന്നും സാധൂകരിക്കപ്പെട്ടില്ല. തിരികെ ടാപ്പ് ചെയ്‌ത് ഓരോ വിലാസവും കീയും പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ साठी कोणतीही नोंद सत्यापित झाली नाही. मागे टॅप करा आणि प्रत्येक पत्ता किंवा की तपासा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਲਈ ਕੋਈ ਵੀ ਐਂਟਰੀ ਪ੍ਰਮਾਣਿਤ ਨਹੀਂ ਹੋਈ। ਵਾਪਸ ਟੈਪ ਕਰੋ ਅਤੇ ਹਰ ਪਤਾ ਜਾਂ ਕੁੰਜੀ ਜਾਂਚੋ।"
          }
        }
      }
    },
