        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Terms of Service haven't been written yet. Aperture is open source — the only thing governing your use of the app today is the MIT license in the repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
