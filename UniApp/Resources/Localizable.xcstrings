    "Your key never leaves this iPhone. Aperture does not send it anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou sleutel verlaat hierdie iPhone nooit nie. Aperture stuur dit nêrens heen nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاحك لا يغادر هذا الـ iPhone أبدًا. ولا يرسله Aperture إلى أي مكان."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът ви никога не напуска този iPhone. Aperture не го изпраща никъде."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কী কখনোই এই iPhone ছাড়ে না। Aperture এটি কোথাও পাঠায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva clau no surt mai d'aquest iPhone. L'Aperture no l'envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš klíč nikdy neopustí tento iPhone. Aperture jej nikam neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nøgle forlader aldrig denne iPhone. Aperture sender den ikke nogen steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel verlässt dieses iPhone nie. Aperture sendet ihn nirgendwohin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί σας δεν φεύγει ποτέ από αυτό το iPhone. Το Aperture δεν το στέλνει πουθενά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave nunca sale de este iPhone. Aperture no la envía a ninguna parte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie võti ei lahku kunagi sellest iPhone’ist. Aperture ei saada seda kuhugi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید شما هرگز از این iPhone خارج نمی‌شود. Aperture آن را به هیچ جا نمی‌فرستد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimesi ei poistu koskaan tältä iPhonelta. Aperture ei lähetä sitä mihinkään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi umaalis sa iPhone na ito ang iyong susi. Hindi ito ipinapadala ng Aperture saanman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé ne quitte jamais cet iPhone. Aperture ne l’envoie nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח שלך לא יוצא לעולם מה-iPhone הזה. Aperture אינו שולח אותו לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुंजी कभी इस iPhone से बाहर नहीं जाती। Aperture इसे कहीं नहीं भेजता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ nikada ne napušta ovaj iPhone. Aperture ga nikamo ne šalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsa soha nem hagyja el ezt az iPhone-t. Az Aperture sehova nem küldi el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci Anda tidak pernah meninggalkan iPhone ini. Aperture tidak mengirimkannya ke mana pun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykillinn þinn yfirgefur þennan iPhone aldrei. Aperture sendir hann ekki neitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave non lascia mai questo iPhone. Aperture non la invia da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの鍵がこの iPhone から出ることはありません。Aperture がそれをどこかへ送ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 키는 이 iPhone을 벗어나지 않습니다. Aperture는 그것을 어디에도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų raktas niekada nepalieka šio iPhone. Aperture jo niekur nesiunčia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu atslēga nekad neatstāj šo iPhone. Aperture to nekur nenosūta."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കീ ഈ iPhone വിട്ടുപോകില്ല. Aperture അത് എവിടെയും അയയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची की हा iPhone कधीही सोडत नाही. Aperture ती कुठेही पाठवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci anda tidak pernah meninggalkan iPhone ini. Aperture tidak menghantarnya ke mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelen din forlater aldri denne iPhone-en. Aperture sender den ikke noe sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sleutel verlaat deze iPhone nooit. Aperture stuurt hem nergens naartoe."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਕੀ ਕਦੇ ਵੀ ਇਸ iPhone ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦੀ। Aperture ਇਸ ਨੂੰ ਕਿਤੇ ਨਹੀਂ ਭੇਜਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój klucz nigdy nie opuszcza tego iPhone’a. Aperture nigdzie go nie wysyła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave nunca sai deste iPhone. O Aperture não a envia para lugar nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia ta nu părăsește niciodată acest iPhone. Aperture nu o trimite nicăieri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ никогда не покидает этот iPhone. Aperture никуда его не отправляет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš kľúč nikdy neopustí tento iPhone. Aperture ho nikam neodosiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ tega iPhona nikoli ne zapusti. Aperture ga nikamor ne pošilja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш кључ никада не напушта овај iPhone. Aperture га нигде не шаље."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nyckel lämnar aldrig den här iPhone-enheten. Aperture skickar den inte någonstans."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufunguo wako hauondoki kamwe kwenye iPhone hii. Aperture hautumi popote."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாவி இந்த iPhone-ஐ விட்டு வெளியேறுவதில்லை. Aperture அதை எங்கும் அனுப்புவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కీ ఈ iPhone-ను వదిలి వెళ్ళదు. Aperture దాన్ని ఎక్కడికీ పంపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ของคุณไม่ออกจาก iPhone เครื่องนี้ Aperture ไม่ส่งคีย์ไปที่ใดทั้งสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarınız bu iPhone’dan asla çıkmaz. Aperture onu hiçbir yere göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ ніколи не залишає цей iPhone. Aperture нікуди його не надсилає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کی کبھی اس iPhone سے باہر نہیں جاتی۔ Aperture اسے کہیں نہیں بھیجتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa của bạn không bao giờ rời khỏi chiếc iPhone này. Aperture không gửi nó đi đâu cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密钥不会离开这部 iPhone。Aperture 不会把它发送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的金鑰不會離開這部 iPhone。Aperture 不會把它傳送到任何地方。"
          }
        }
      }
    },
