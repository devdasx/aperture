    "Holdings worth less than the chosen amount are hidden from the wallet home until you change this back to Show all.": {
      "extractionState": "new",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Besittings met ’n waarde kleiner as die gekose bedrag word op die beursie se tuisblad versteek totdat jy dit terugskakel na Wys almal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخفى الأرصدة التي تقل قيمتها عن المبلغ المختار من الصفحة الرئيسية للمحفظة حتى تعيد التحديد إلى عرض الكل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активите със стойност, по-ниска от избраната сума, са скрити от началния екран на портфейла, докато не превключите обратно на Покажи всички."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত পরিমাণের কম মূল্যের হোল্ডিংগুলো ওয়ালেট হোম থেকে লুকানো থাকে যতক্ষণ না আপনি এটি সব দেখান-এ ফিরিয়ে আনেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els actius amb un valor inferior a la quantitat triada s'amaguen de la pantalla d'inici de la cartera fins que tornis a l'opció Mostra-ho tot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiva s hodnotou nižší než zvolená částka jsou na domovské stránce peněženky skryta, dokud nepřepnete zpět na Zobrazit vše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdninger, der er mindre værd end det valgte beløb, skjules fra wallets startskærm, indtil du skifter tilbage til Vis alle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestände unter dem gewählten Betrag werden auf der Wallet-Startseite ausgeblendet, bis du wieder auf Alle anzeigen wechselst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία με αξία μικρότερη από το επιλεγμένο ποσό κρύβονται από την αρχική του πορτοφολιού, μέχρι να το αλλάξεις ξανά σε Εμφάνιση όλων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los activos que valen menos del importe elegido se ocultan del inicio de la cartera hasta que vuelvas a elegir Mostrar todo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitud summast väiksema väärtusega varad on rahakoti avalehelt peidetud, kuni muudad selle uuesti olekuks Näita kõiki."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دارایی‌هایی که ارزششان از مبلغ انتخاب‌شده کمتر است، تا زمانی که گزینه را به نمایش همه برگردانید، از صفحهٔ اصلی کیف‌پول پنهان می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittua summaa pienempiarvoiset omistukset piilotetaan lompakon aloitusnäkymästä, kunnes vaihdat takaisin Näytä kaikki -asetukseen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinatago sa wallet home ang mga hawak na mas mababa ang halaga sa napiling halaga hanggang sa ibalik mo ito sa Show all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les avoirs d’une valeur inférieure au montant choisi sont masqués sur l’écran d’accueil du portefeuille jusqu’à ce que vous repassiez sur Tout afficher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזקות בשווי נמוך מהסכום שנבחר מוסתרות ממסך הבית של הארנק עד שתחזיר את ההגדרה ל\"הצג הכול\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई राशि से कम मूल्य की होल्डिंग्स वॉलेट होम से छिपी रहती हैं, जब तक आप इसे वापस सभी दिखाएँ पर नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imovina vrijednija manje od odabranog iznosa skrivena je s početnog zaslona novčanika dok ovo ne vratite na Prikaži sve."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választott összegnél kevesebbet érő eszközök rejtve maradnak a tárca főképernyőjén, amíg vissza nem váltja Összes megjelenítése értékre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aset bernilai lebih rendah dari jumlah yang dipilih disembunyikan dari beranda dompet hingga Anda mengubahnya kembali ke Tampilkan semua."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eignir með minna virði en valið magn eru faldar af heimaskjá veskisins þar til þú breytir aftur í Sýna allt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le posizioni di valore inferiore all’importo scelto sono nascoste dalla schermata iniziale del portafoglio finché non torni su Mostra tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した金額より価値が低い保有資産は、再度「すべて表示」に戻すまで、ウォレットホームから非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 금액보다 가치가 낮은 보유 자산은 모두 보기로 되돌릴 때까지 지갑 홈에서 숨겨져요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mažesnės nei pasirinkta suma vertės turtai paslepiami piniginės pradžios ekrane, kol vėl pasirinksite Rodyti viską."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktīvi, kuru vērtība ir mazāka par izvēlēto summu, ir paslēpti no maka sākumlapas, līdz pārslēgsi atpakaļ uz Rādīt visus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത തുകയേക്കാൾ കുറവ് മൂല്യമുള്ള ആസ്തികൾ, എല്ലാം കാണിക്കുക എന്നതിലേക്ക് മാറ്റുന്നതുവരെ വാലറ്റ് ഹോമിൽ നിന്ന് മറയ്ക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या रकमेपेक्षा कमी मूल्य असलेल्या मालमत्ता, तुम्ही पुन्हा सर्व दाखवा वर बदलेपर्यंत वॉलेट होमवरून लपवल्या जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegangan yang bernilai kurang daripada jumlah yang dipilih disembunyikan dari laman utama dompet sehingga anda tukar semula ke Tunjukkan semua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdninger som er verdt mindre enn det valgte beløpet, skjules på lommebokens startside til du endrer tilbake til Vis alle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezit met een waarde lager dan het gekozen bedrag is verborgen op de startpagina van je wallet totdat je dit terugzet op Alles tonen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੀ ਗਈ ਰਕਮ ਤੋਂ ਘੱਟ ਮੁੱਲ ਵਾਲੀਆਂ ਜਾਇਦਾਦਾਂ, ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਇਸਨੂੰ ਮੁੜ ਸਾਰੇ ਦਿਖਾਓ ਤੇ ਨਹੀਂ ਬਦਲਦੇ, ਵਾਲਿਟ ਹੋਮ ਤੋਂ ਛੁਪਾਈਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywa o wartości niższej niż wybrana kwota są ukryte na ekranie głównym portfela do czasu, aż zmienisz to z powrotem na Pokaż wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ativos que valem menos do que o valor escolhido ficam ocultos na tela inicial até você voltar para Mostrar todos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activele cu valoare sub suma aleasă sunt ascunse de pe ecranul principal al portofelului până când revii la Afișează tot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активы дешевле выбранной суммы скрыты на главном экране кошелька, пока вы не вернёте параметр на Показать все."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktíva s hodnotou nižšou než zvolená suma sú skryté na domovskej obrazovke peňaženky, kým toto nezmeníte späť na Zobraziť všetko."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sredstva, vredna manj od izbranega zneska, so skrita z začetnega zaslona denarnice, dokler tega ne preklopite nazaj na Prikaži vse."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Имовина чија је вредност мања од изабраног износа сакривена је са почетног екрана новчаника док ово не вратите на Прикажи све."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innehav som är värda mindre än det valda beloppet döljs på plånbokens startsida tills du ändrar tillbaka till Visa alla."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali zenye thamani chini ya kiasi kilichochaguliwa hufichwa kwenye ukurasa wa mwanzo wa pochi hadi utakapobadilisha tena kuwa Onyesha zote."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த தொகையை விட குறைந்த மதிப்புள்ள வைப்புகள், அதை மீண்டும் அனைத்தையும் காட்டு என மாற்றும் வரை வாலட் முகப்பில் இருந்து மறைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న మొత్తానికి తక్కువ విలువ ఉన్న హోల్డింగ్‌లు, మీరు దానిని తిరిగి అన్నీ చూపించు గా మార్చేవరకు వాలెట్ హోమ్ నుండి దాచబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่มีมูลค่าน้อยกว่ามูลค่าที่เลือกจะถูกซ่อนจากหน้าหลักของวอลเล็ต จนกว่าจะเปลี่ยนกลับเป็นแสดงทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen tutarın altındaki varlıklar, Tümünü göster seçeneğine geri dönene kadar cüzdan ana ekranında gizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активи, вартість яких менша за вибрану суму, приховані на головному екрані гаманця, доки ви не оберете Показати всі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب رقم سے کم قدر والے اثاثے والیٹ ہوم سے چھپا دیے جاتے ہیں، جب تک آپ اسے سب دکھائیں پر واپس نہ کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tài sản có giá trị thấp hơn mức đã chọn sẽ bị ẩn khỏi trang chính của ví cho đến khi bạn đổi lại thành Hiện tất cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价值低于所选金额的持仓将从钱包主页隐藏,直到你改回“显示全部”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價值低於所選金額的持倉將從錢包主頁隱藏,直到你改回「顯示全部」。"
          }
        }
      }
    },
    "Holdings worth less than this amount are hidden from the wallet screen. They're still in the local store — only the display is filtered.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Besittings minder werd as hierdie bedrag word op die beursie-skerm verberg. Hulle is steeds in die plaaslike stoor — slegs die vertoon word gefilter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخفى الحيازات التي تقلّ قيمتها عن هذا المبلغ من شاشة المحفظة. تبقى في التخزين المحلي — يُصفّى العرض فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активите със стойност под тази сума се скриват от екрана на портфейла. Те остават в локалното хранилище — само показването е филтрирано."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পরিমাণের চেয়ে কম মূল্যের হোল্ডিংসমূহ ওয়ালেট স্ক্রিন থেকে লুকিয়ে রাখা হয়। সেগুলো এখনও স্থানীয় স্টোরে আছে — কেবল প্রদর্শন ফিল্টার করা হয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posicions amb un valor inferior a aquest import s'amaguen de la pantalla de la cartera. Continuen a l'emmagatzematge local — només es filtra la visualització."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozice s hodnotou nižší než tato částka jsou na obrazovce peněženky skryty. Zůstávají v lokálním úložišti — pouze zobrazení je filtrované."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdninger med en værdi under dette beløb skjules på tegnebogsskærmen. De findes stadig i det lokale lager — kun visningen filtreres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestände mit einem Wert unter diesem Betrag werden auf dem Wallet-Bildschirm ausgeblendet. Sie verbleiben im lokalen Speicher — nur die Anzeige wird gefiltert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ποσά αξίας μικρότερης από αυτό το όριο αποκρύπτονται από την οθόνη του πορτοφολιού. Παραμένουν στον τοπικό χώρο αποθήκευσης — φιλτράρεται μόνο η εμφάνιση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdings worth less than this amount are hidden from the wallet screen. They're still in the local store — only the display is filtered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los activos por un valor inferior a este importe se ocultan de la pantalla del wallet. Siguen en el almacén local — solo se filtra la visualización."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest summast väiksema väärtusega varad on rahakoti ekraanil peidetud. Need on endiselt kohalikus salvestises — filtreeritakse ainult kuva."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دارایی‌هایی که ارزش آن‌ها کمتر از این مقدار است از صفحهٔ کیف پول پنهان می‌شوند. آن‌ها همچنان در حافظهٔ محلی هستند — فقط نمایش فیلتر می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän summan alittavat omistukset piilotetaan lompakkonäkymästä. Ne ovat edelleen paikallisessa muistissa — vain näyttö suodatetaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinatago ang mga holdings na mas mababa sa halagang ito mula sa wallet screen. Nasa local store pa rin sila — ang display lang ang nasa-filter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les avoirs valant moins que ce montant sont masqués sur l'écran du portefeuille. Ils restent dans le stockage local — seul l'affichage est filtré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזקות בשווי נמוך מסכום זה מוסתרות ממסך הארנק. הן עדיין באחסון המקומי — רק התצוגה מסוננת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस राशि से कम मूल्य की होल्डिंग्स वॉलेट स्क्रीन से छिप जाती हैं। वे अभी भी स्थानीय स्टोर में हैं — केवल डिस्प्ले फ़िल्टर हो रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke vrijednosti manje od ovog iznosa skrivaju se s ekrana novčanika. Ostaju u lokalnoj pohrani — samo je prikaz filtriran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ennél kisebb értékű állományok el vannak rejtve a tárca képernyőjéről. Továbbra is a helyi tárolóban vannak — csak a megjelenítés van szűrve."
