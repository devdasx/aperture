    },
    "There is no support team, no password reset, no recovery.": {
      "comment": "Create-wallet disclosure protection rule 4 detail.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Daar is geen ondersteuningspan, geen wagwoord-herstel, geen herwinning nie."
