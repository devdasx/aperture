        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانزلاق الأعلى قد يعني أنك تستلم أقل بشكل ملحوظ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По-високото приплъзване може да означава, че получавате значително по-малко."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেশি স্লিপেজ মানে আপনি লক্ষণীয়ভাবে কম পেতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
