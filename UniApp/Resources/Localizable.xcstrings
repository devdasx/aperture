    "SVG only · keep it simple and single-shape for best results.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Slegs SVG · hou dit eenvoudig en een vorm vir die beste resultate."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG فقط · أبقها بسيطة وذات شكل واحد للحصول على أفضل النتائج."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само SVG · просто и от една форма за най-добър резултат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু SVG · সরল ও একক আকৃতির ফাইলে সেরা ফল পাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només SVG · formes senzilles i d’una sola peça donen el millor resultat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze SVG · jednoduchý jednotvarý motiv vypadá nejlépe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun SVG · enkel og enkeltformet giver bedst resultat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur SVG · schlicht und einfarbig wirkt am besten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο SVG · απλά, με ένα σχήμα για το καλύτερο αποτέλεσμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo SVG · usa formas sencillas para mejores resultados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult SVG · parima tulemuse annab lihtne ühe kujundiga fail."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط SVG · ساده و تک‌شکل بهترین نتیجه را می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain SVG · yksinkertainen, yksimuotoinen toimii parhaiten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG lang · simple at iisang hugis para sa pinakamagandang resulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG uniquement · privilégier des formes simples pour de meilleurs résultats."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG בלבד · צורה פשוטה ובודדת מניבה את התוצאה הטובה ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल SVG · सरल और एकल आकृति वाली फ़ाइलें सबसे अच्छी रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo SVG · jednostavan i jednodijelan motiv izgleda najbolje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak SVG · az egyszerű, egyalakú forma a legjobb eredmény."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya SVG · jaga tetap sederhana dan satu bentuk untuk hasil terbaik."
