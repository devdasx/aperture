        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture husoma kile mkataba unachosema kuhusu wenyewe. Hatufanyi ukaguzi wa mikataba ya tokeni — thibitisha uaminifu kabla ya kushikilia."
