          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ERC-20 / SPL ٹوکن ان کا کنٹریکٹ یا mint ایڈریس پیسٹ کر کے شامل کریں۔ Aperture نام، علامت اور اعشاریے چین سے پڑھ لیتا ہے۔"
