    "Sending a transaction is irreversible. Only confirm transactions you initiated and understand.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال المعاملة لا يمكن التراجع عنه. أكّد فقط المعاملات التي بدأتها وتفهمها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেন পাঠানো অপরিবর্তনীয়। শুধু সেই লেনদেনই নিশ্চিত করুন যেগুলো আপনি শুরু করেছেন এবং বুঝেছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar una transacció és irreversible. Confirma només les transaccions que has iniciat tu i que entens."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslání transakce je nevratné. Potvrzujte jen transakce, které jste sami zahájili a kterým rozumíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At sende en transaktion er uigenkaldeligt. Bekræft kun transaktioner, du selv har startet og forstår."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Transaktion zu senden ist unwiderruflich. Bestätige nur Transaktionen, die du selbst initiiert und verstanden hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποστολή συναλλαγής είναι μη αναστρέψιμη. Επιβεβαιώστε μόνο τις συναλλαγές που εσείς ξεκινήσατε και κατανοείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending a transaction is irreversible. Only confirm transactions you initiated and understand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar una transacción es irreversible. Confirma solo las transacciones que iniciaste y entiendes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسال تراکنش برگشت‌ناپذیر است. فقط تراکنش‌هایی را تأیید کنید که خودتان آغاز کرده و درک می‌کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtuman lähettämistä ei voi peruuttaa. Vahvista vain tapahtumat, jotka olet itse käynnistänyt ja ymmärrät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer une transaction est irréversible. Ne confirmez que les transactions que vous avez initiées et comprenez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליחת עסקה היא בלתי הפיכה. יש לאשר רק עסקאות שיזמת ושאתה מבין/ה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेनदेन भेजना अपरिवर्तनीय है। केवल वही लेनदेन कन्फ़र्म करें जो आपने स्वयं शुरू किए हों और समझे हों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slanje transakcije je nepovratno. Potvrdite samo transakcije koje ste sami pokrenuli i koje razumijete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy tranzakció elküldése visszafordíthatatlan. Csak olyan tranzakciókat erősíts meg, amelyeket te indítottál el és értesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim transaksi tidak dapat dibatalkan. Hanya konfirmasi transaksi yang Anda mulai dan pahami."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviare una transazione è irreversibile. Confermi solo le transazioni che ha avviato e che comprende."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションの送信は取り消せません。自分で開始し、内容を理解しているトランザクションだけを承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래 전송은 되돌릴 수 없어요. 직접 시작했고 이해하는 거래만 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sende en transaksjon kan ikke angres. Bekreft kun transaksjoner du selv har startet og forstår."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een transactie verzenden is onomkeerbaar. Bevestig alleen transacties die je zelf hebt gestart en begrijpt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłanie transakcji jest nieodwracalne. Potwierdzaj tylko transakcje, które sam zainicjowałeś i rozumiesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar uma transação é irreversível. Confirme apenas transações que você iniciou e entende."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiterea unei tranzacții este ireversibilă. Confirmă doar tranzacțiile pe care le-ai inițiat și le înțelegi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправку транзакции невозможно отменить. Подтверждайте только те транзакции, которые вы инициировали и понимаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odoslanie transakcie je nezvratné. Potvrdzujte len transakcie, ktoré ste začali a ktorým rozumiete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljanje transakcije je nepovratno. Potrdite le transakcije, ki ste jih sprožili in jih razumete."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слање трансакције је неповратно. Потврдите само трансакције које сте сами покренули и разумете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att skicka en transaktion är oåterkalleligt. Bekräfta endast transaktioner som du själv har initierat och förstår."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งธุรกรรมย้อนกลับไม่ได้ ยืนยันเฉพาะธุรกรรมที่คุณเริ่มและเข้าใจเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir işlem göndermek geri alınamaz. Yalnızca kendi başlattığınız ve anladığınız işlemleri onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання транзакції незворотне. Підтверджуйте лише ті транзакції, які ви ініціювали й розумієте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi một giao dịch là không thể đảo ngược. Chỉ xác nhận các giao dịch do bạn khởi tạo và hiểu rõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送交易不可撤销。只确认你自己发起且理解的交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送交易無法撤回。只確認你自己發起且理解的交易。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین بھیجنا ناقابلِ واپسی ہے۔ صرف وہی لین دین تصدیق کریں جو آپ نے شروع کیے اور سمجھتے ہیں۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпращането на транзакция е необратимо. Потвърждавайте само транзакции, които сте инициирали и разбирате."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehingu saatmine on pöördumatu. Kinnita ainult tehinguid, mille sina algatasid ja millest aru saad."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijos siuntimas yra negrįžtamas. Patvirtinkite tik tas operacijas, kurias pradėjote patys ir suprantate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījuma sūtīšana ir neatgriezeniska. Apstipriniet tikai tos darījumus, kurus jūs uzsākāt un saprotat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending færslu er óafturkræf. Staðfestu aðeins færslur sem þú hófst og skilur."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar transaksi tidak boleh diubah balik. Hanya sahkan transaksi yang anda mulakan dan fahami."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na maibabalik ang pagpapadala ng transaksyon. Kumpirmahin lamang ang mga transaksyong sinimulan at naiintindihan mo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutuma muamala hakuwezi kutenduliwa. Thibitisha tu miamala uliyoianzisha na unayoelewa."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om 'n transaksie te stuur is onomkeerbaar. Bevestig slegs transaksies wat jy begin het en verstaan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவர்த்தனையை அனுப்புவது மீளமுடியாதது. நீங்கள் தொடங்கி, புரிந்துகொண்ட பரிவர்த்தனைகளை மட்டுமே உறுதிப்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లావాదేవీని పంపడం తిరిగి మార్చలేనిది. మీరు ప్రారంభించి, అర్థం చేసుకున్న లావాదేవీలను మాత్రమే నిర్ధారించండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഇടപാട് അയയ്‌ക്കുന്നത് മാറ്റാനാവാത്തതാണ്. നിങ്ങൾ ആരംഭിക്കുകയും മനസ്സിലാക്കുകയും ചെയ്‌ത ഇടപാടുകൾ മാത്രം സ്ഥിരീകരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवहार पाठवणे अपरिवर्तनीय आहे. तुम्ही सुरू केलेले आणि समजलेले व्यवहारच पुष्टी करा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੈਣ-ਦੇਣ ਭੇਜਣਾ ਅਟੱਲ ਹੈ। ਸਿਰਫ਼ ਉਹ ਲੈਣ-ਦੇਣ ਪੁਸ਼ਟ ਕਰੋ ਜੋ ਤੁਸੀਂ ਸ਼ੁਰੂ ਕੀਤੇ ਅਤੇ ਸਮਝਦੇ ਹੋ।"
          }
        }
      }
    },
    "Sending transactions from the browser isn't available in Aperture yet. The request will be returned to the dApp unsigned.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال المعاملات من المتصفّح غير متاح في Aperture بعد. سيُعاد الطلب إلى تطبيق dApp دون توقيع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-এ এখনও ব্রাউজার থেকে লেনদেন পাঠানো উপলব্ধ নেই। অনুরোধটি সাইন ছাড়াই dApp-এ ফেরত পাঠানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture encara no permet enviar transaccions des del navegador. La sol·licitud es retornarà a la dApp sense signar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílání transakcí z prohlížeče zatím v Aperture není dostupné. Požadavek bude vrácen dApp bez podpisu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At sende transaktioner fra browseren er endnu ikke muligt i Aperture. Anmodningen returneres til dAppen uden signatur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Senden von Transaktionen aus dem Browser ist in Aperture noch nicht verfügbar. Die Anfrage wird unsigniert an die dApp zurückgegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποστολή συναλλαγών από τον περιηγητή δεν είναι ακόμη διαθέσιμη στο Aperture. Το αίτημα θα επιστραφεί στο dApp χωρίς υπογραφή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture aún no permite enviar transacciones desde el navegador. La solicitud se devolverá a la dApp sin firmar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسال تراکنش از مرورگر هنوز در Aperture در دسترس نیست. درخواست بدون امضا به dApp بازگردانده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumien lähettäminen selaimesta ei ole vielä saatavilla Aperturessa. Pyyntö palautetaan dApp:lle allekirjoittamattomana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi de transactions depuis le navigateur n’est pas encore disponible dans Aperture. La demande sera renvoyée à la dApp non signée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליחת עסקאות מהדפדפן עדיין לא זמינה ב־Aperture. הבקשה תוחזר ל־dApp ללא חתימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture में अभी ब्राउज़र से लेनदेन भेजना उपलब्ध नहीं है। अनुरोध बिना साइन के dApp को लौटा दिया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slanje transakcija iz preglednika u Apertureu još nije dostupno. Zahtjev će biti vraćen dApp-u nepotpisan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A böngészőből történő tranzakcióküldés még nem érhető el az Aperture-ben. A kérést aláírás nélkül adjuk vissza a dApp-nak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim transaksi dari peramban belum tersedia di Aperture. Permintaan akan dikembalikan ke dApp tanpa ditandatangani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invio di transazioni dal browser non è ancora disponibile in Aperture. La richiesta verrà restituita alla dApp non firmata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture では、ブラウザからのトランザクション送信はまだ利用できません。リクエストは署名されないまま dApp に返却されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 거래를 전송하는 기능은 아직 Aperture에서 제공되지 않아요. 요청은 서명되지 않은 채 dApp으로 반환돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sende transaksjoner fra nettleseren er ennå ikke tilgjengelig i Aperture. Forespørselen returneres til dAppen usignert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties verzenden vanuit de browser is nog niet beschikbaar in Aperture. Het verzoek wordt zonder ondertekening teruggestuurd naar de dApp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłanie transakcji z przeglądarki nie jest jeszcze dostępne w Aperture. Żądanie zostanie zwrócone do dAppa bez podpisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar transações pelo navegador ainda não está disponível no Aperture. A solicitação será devolvida à dApp sem assinatura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiterea de tranzacții din browser nu este încă disponibilă în Aperture. Cererea va fi returnată dApp-ului nesemnată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Aperture отправка транзакций из браузера пока недоступна. Запрос будет возвращён в dApp без подписи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odosielanie transakcií z prehliadača zatiaľ nie je v Aperture dostupné. Žiadosť bude vrátená dApp bez podpisu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljanje transakcij iz brskalnika v Aperture še ni na voljo. Zahteva bo vrnjena dApp brez podpisa."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слање трансакција из прегледача још није доступно у Aperture-у. Захтев ће бити враћен dApp-у непотписан."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att skicka transaktioner från webbläsaren är ännu inte tillgängligt i Aperture. Begäran återlämnas till dAppen osignerad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งธุรกรรมจากเบราว์เซอร์ยังใช้ไม่ได้ใน Aperture คำขอจะถูกส่งกลับไปยัง dApp โดยไม่ลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıdan işlem gönderme henüz Aperture’da kullanılamıyor. İstek, imzalanmadan dApp’e geri döndürülecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання транзакцій із браузера в Aperture поки що недоступне. Запит буде повернуто в dApp без підпису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gửi giao dịch từ trình duyệt chưa khả dụng trong Aperture. Yêu cầu sẽ được trả lại cho dApp mà không được ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 暂不支持从浏览器发送交易。请求将以未签名状态返回给 dApp。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 尚未支援從瀏覽器傳送交易。請求將以未簽署狀態回傳給 dApp。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براؤزر سے لین دین بھیجنا Aperture میں ابھی دستیاب نہیں ہے۔ درخواست dApp کو بغیر دستخط کے واپس کر دی جائے گی۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпращането на транзакции от браузъра все още не е налично в Aperture. Заявката ще бъде върната на dApp неподписана."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehingute saatmine brauserist pole Aperture'is veel saadaval. Päring tagastatakse dAppile allkirjastamata."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacijų siuntimas iš naršyklės Aperture dar negalimas. Užklausa bus grąžinta į dApp nepasirašyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darījumu sūtīšana no pārlūka Aperture vēl nav pieejama. Pieprasījums tiks atgriezts dApp neparakstīts."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Að senda færslur úr vafranum er ekki enn í boði í Aperture. Beiðnin verður skilað óundirritaðri til dApp-sins."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar transaksi daripada pelayar belum tersedia dalam Aperture. Permintaan akan dikembalikan kepada dApp tanpa ditandatangani."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa available sa Aperture ang pagpapadala ng mga transaksyon mula sa browser. Ibabalik ang kahilingan sa dApp nang hindi naka-sign."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutuma miamala kutoka kwenye kivinjari bado hakupatikani katika Aperture. Ombi litarudishwa kwa dApp bila kutiwa saini."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om transaksies vanaf die blaaier te stuur is nog nie in Aperture beskikbaar nie. Die versoek sal ongeteken na die dApp teruggestuur word."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உலாவியிலிருந்து பரிவர்த்தனைகளை அனுப்புவது Aperture-இல் இன்னும் கிடைக்கவில்லை. கோரிக்கை கையொப்பமிடாமல் dApp-க்குத் திருப்பித் தரப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్రౌజర్ నుండి లావాదేవీలను పంపడం Aperture‌లో ఇంకా అందుబాటులో లేదు. అభ్యర్థన సంతకం లేకుండా dApp‌కు తిరిగి ఇవ్వబడుతుంది."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബ്രൗസറിൽ നിന്ന് ഇടപാടുകൾ അയയ്‌ക്കുന്നത് ഇതുവരെ Aperture-ൽ ലഭ്യമല്ല. അഭ്യർത്ഥന ഒപ്പിടാതെ dApp-ലേക്ക് തിരികെ നൽകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउझरवरून व्यवहार पाठवणे अद्याप Aperture मध्ये उपलब्ध नाही. विनंती स्वाक्षरीशिवाय dApp ला परत केली जाईल."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬ੍ਰਾਊਜ਼ਰ ਤੋਂ ਲੈਣ-ਦੇਣ ਭੇਜਣਾ ਅਜੇ Aperture ਵਿੱਚ ਉਪਲਬਧ ਨਹੀਂ ਹੈ। ਬੇਨਤੀ ਬਿਨਾਂ ਦਸਤਖਤ ਦੇ dApp ਨੂੰ ਵਾਪਸ ਕੀਤੀ ਜਾਵੇਗੀ।"
          }
        }
      }
    },
