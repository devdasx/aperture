    "Paste your key — Aperture never asks you to type it character by character.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak jou sleutel — Aperture vra jou nooit om dit karakter vir karakter in te tik nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق مفتاحك — لا يطلب منك Aperture أبدًا كتابته حرفًا حرفًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете ключа си — Aperture никога не иска от вас да го въвеждате символ по символ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কী পেস্ট করুন — Aperture কখনোই আপনাকে এটি অক্ষরে অক্ষরে টাইপ করতে বলে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enganxa la teva clau — l'Aperture no et demana mai que l'escriguis caràcter a caràcter."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte svůj klíč — Aperture nikdy nepožaduje, abyste jej psali znak po znaku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt din nøgle — Aperture beder dig aldrig skrive den ind tegn for tegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen Schlüssel ein – Aperture verlangt nie, ihn Zeichen für Zeichen einzutippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλήστε το κλειδί σας — το Aperture δεν σας ζητά ποτέ να το πληκτρολογήσετε χαρακτήρα προς χαρακτήρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega tu clave: Aperture nunca te pide que la escribas carácter a carácter."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleepige oma võti — Aperture ei palu kunagi seda märk märgi haaval kirjutada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید خود را بچسبانید — Aperture هرگز از شما نمی‌خواهد آن را کاراکتر به کاراکتر تایپ کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä avaimesi — Aperture ei koskaan pyydä kirjoittamaan sitä merkki kerrallaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-paste ang iyong susi — hindi ka kailanman hinihingian ng Aperture na i-type ito titik por titik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez votre clé — Aperture ne vous demande jamais de la saisir caractère par caractère."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק את המפתח שלך — Aperture לעולם לא יבקש ממך להקליד אותו תו אחר תו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कुंजी पेस्ट करें — Aperture कभी आपसे इसे एक-एक अक्षर लिखने को नहीं कहता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepite svoj ključ — Aperture nikad ne traži da ga upisujete znak po znak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illessze be a kulcsát — az Aperture soha nem kéri, hogy karakterenként beírja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempelkan kunci Anda — Aperture tidak pernah meminta Anda mengetiknya karakter demi karakter."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu lykilinn þinn inn — Aperture biður þig aldrei að slá hann inn staf fyrir staf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla la tua chiave — Aperture non ti chiede mai di digitarla un carattere alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵を貼り付けてください——Aperture が1文字ずつ入力するよう求めることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 붙여넣으세요 — Aperture는 키를 한 글자씩 입력하라고 요구하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijuokite savo raktą – Aperture niekada neprašo įvesti jo simbolis po simbolio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielīmējiet savu atslēgu — Aperture nekad nelūdz jums to ievadīt rakstzīmi pa rakstzīmei."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കീ പേസ്റ്റ് ചെയ്യുക — Aperture ഒരിക്കലും അത് അക്ഷരം അക്ഷരമായി ടൈപ്പ് ചെയ്യാൻ ആവശ്യപ്പെടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची की पेस्ट करा — Aperture कधीही तुम्हाला अक्षरशः टाइप करण्यास सांगत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal kunci anda — Aperture tidak pernah meminta anda menaipnya aksara demi aksara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn nøkkelen din — Aperture ber deg aldri skrive den inn tegn for tegn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak je sleutel — Aperture vraagt je nooit om hem teken voor teken in te typen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ ਕੀ ਪੇਸਟ ਕਰੋ — Aperture ਕਦੇ ਵੀ ਤੁਹਾਨੂੰ ਉਸ ਨੂੰ ਅੱਖਰ ਦਰ ਅੱਖਰ ਟਾਈਪ ਕਰਨ ਲਈ ਨਹੀਂ ਕਹਿੰਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej swój klucz — Aperture nigdy nie prosi o wpisywanie go znak po znaku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole sua chave — o Aperture nunca pede para você digitá-la caractere por caractere."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește cheia ta — Aperture nu îți cere niciodată să o introduci caracter cu caracter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ваш ключ — Aperture никогда не просит набирать его символ за символом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte svoj kľúč — Aperture od vás nikdy nežiada, aby ste ho zadávali znak po znaku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilepite svoj ključ — Aperture od vas nikoli ne zahteva, da ga vnašate znak za znakom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налепите свој кључ — Aperture никад не тражи да га куцате знак по знак."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in din nyckel — Aperture ber dig aldrig att skriva in den tecken för tecken."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandika ufunguo wako — Aperture haikuombi kamwe uuandike herufi kwa herufi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாவியை ஒட்டவும் — Aperture அதை எழுத்துக்கு எழுத்து தட்டச்சு செய்யுமாறு ஒருபோதும் கேட்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కీని పేస్ట్ చేయండి — Aperture మిమ్మల్ని దాన్ని అక్షరం వారీగా టైప్ చేయమని ఎప్పుడూ అడగదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางคีย์ของคุณ — Aperture จะไม่ขอให้คุณพิมพ์ทีละตัวอักษร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarınızı yapıştırın — Aperture sizden anahtarı karakter karakter yazmanızı asla istemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте ваш ключ — Aperture ніколи не просить вводити його символ за символом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی کی پیسٹ کریں — Aperture کبھی آپ سے اسے حرف بہ حرف ٹائپ کرنے کو نہیں کہتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dán khóa của bạn — Aperture không bao giờ yêu cầu bạn nhập từng ký tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你的密钥——Aperture 绝不会让你一个字符一个字符地输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你的金鑰——Aperture 絕不會要求你一個字元一個字元地輸入。"
          }
        }
      }
    },
