          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な EVM アドレスではありません — 0x の後に 16 進数 40 文字が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
