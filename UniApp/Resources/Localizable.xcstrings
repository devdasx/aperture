        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture की प्राइवेसी पॉलिसी छोटी है क्योंकि Aperture कोई डेटा नहीं इकट्ठा करता: न खाता, न ईमेल, न एनालिटिक्स, न टेलीमेट्री, न ही आपके वॉलेट गतिविधि के कोई सर्वर-साइड लॉग।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravila o privatnosti Apertura su kratka jer Aperture ne prikuplja podatke: nema računa, e-pošte, analitike, telemetrije ni poslužiteljskih zapisa o aktivnosti vašeg novčanika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Aperture adatvédelmi szabályzata rövid, mert az Aperture nem gyűjt adatokat: nincs fiók, e-mail, analitika, telemetria és nincsenek szerveroldali naplók a tárcaaktivitásáról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan privasi Aperture singkat karena Aperture tidak mengumpulkan data: tidak ada akun, tidak ada email, tidak ada analitik, tidak ada telemetri, tidak ada log sisi server atas aktivitas dompet Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Persónuverndarstefna Aperture er stutt vegna þess að Aperture safnar engum gögnum: enginn aðgangur, enginn tölvupóstur, engin greining, engin fjarmæling, engar netþjónaskráningar á veski-aðgerðum þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'informativa sulla privacy di Aperture è breve perché Aperture non raccoglie alcun dato: nessun account, nessuna e-mail, nessuna analitica, nessuna telemetria, nessun log lato server della tua attività con il portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture のプライバシーポリシーが短いのは、Aperture が一切のデータを収集しないからです。アカウントなし、メールアドレスなし、アナリティクスなし、テレメトリーなし、ウォレットの操作を記録するサーバーログもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture의 개인정보 처리방침은 짧습니다. Aperture는 어떤 데이터도 수집하지 않기 때문입니다. 계정도, 이메일도, 분석도, 텔레메트리도, 지갑 활동에 대한 서버 측 로그도 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aperture“ privatumo politika trumpa, nes „Aperture“ nerenka jokių duomenų: nėra paskyros, el. pašto, analitikos, telemetrijos ar serverio pusės jūsų piniginės veiklos žurnalų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture privātuma politika ir īsa, jo Aperture nevāc nekādus datus: nav konta, nav e-pasta, nav analītikas, nav telemetrijas, nav servera puses žurnālu par jūsu maka darbībām."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-ന്റെ സ്വകാര്യതാ നയം ഹ്രസ്വമാണ്, കാരണം Aperture ഒരു ഡാറ്റയും ശേഖരിക്കുന്നില്ല: അക്കൗണ്ടില്ല, ഇമെയിലില്ല, അനലിറ്റിക്സില്ല, ടെലിമെട്രിയില്ല, നിങ്ങളുടെ വാലറ്റ് പ്രവർത്തനത്തിന്റെ സെർവർ-സൈഡ് ലോഗുകളുമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture चे गोपनीयता धोरण लहान आहे कारण Aperture कोणताही डेटा गोळा करत नाही: कोणतेही खाते नाही, ईमेल नाही, विश्लेषण नाही, टेलिमेट्री नाही, तुमच्या वॉलेट क्रियाकलापाचे सर्व्हर-साइड लॉग्ज नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Polisi privasi Aperture pendek kerana Aperture tidak mengumpul sebarang data: tiada akaun, tiada e-mel, tiada analitik, tiada telemetri, tiada log sisi pelayan tentang aktiviti dompet anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture sin personvernerklæring er kort fordi Aperture ikke samler inn data: ingen konto, ingen e-post, ingen analyse, ingen telemetri og ingen serverlogger over lommebokaktiviteten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het privacybeleid van Aperture is kort omdat Aperture geen gegevens verzamelt: geen account, geen e-mail, geen analytics, geen telemetrie, geen serverlogs van je portemonnee-activiteit."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture ਦੀ ਪਰਾਈਵੇਸੀ ਪਾਲਿਸੀ ਛੋਟੀ ਹੈ ਕਿਉਂਕਿ Aperture ਕੋਈ ਡਾਟਾ ਨਹੀਂ ਇਕੱਠਾ ਕਰਦਾ: ਕੋਈ ਖਾਤਾ ਨਹੀਂ, ਕੋਈ ਈਮੇਲ ਨਹੀਂ, ਕੋਈ ਐਨਾਲਿਟਿਕਸ ਨਹੀਂ, ਕੋਈ ਟੈਲੀਮੈਟਰੀ ਨਹੀਂ, ਤੁਹਾਡੀ ਵਾਲਿਟ ਸਰਗਰਮੀ ਦੇ ਸਰਵਰ-ਸਾਈਡ ਲਾਗ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polityka prywatności Aperture jest krótka, ponieważ Aperture nie zbiera żadnych danych: brak konta, brak e-maila, brak analityki, brak telemetrii, brak dzienników serwerowych Twojej aktywności portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A política de privacidade do Aperture é curta porque o Aperture não coleta dados: nem conta, nem e-mail, nem analytics, nem telemetria, nem logs do lado do servidor sobre a atividade da sua carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Politica de confidențialitate a Aperture este scurtă pentru că Aperture nu colectează date: fără cont, fără e-mail, fără analize, fără telemetrie, fără jurnale pe server ale activității din portofel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика конфиденциальности Aperture короткая, потому что Aperture не собирает данные: ни аккаунта, ни email, ни аналитики, ни телеметрии, ни серверных логов вашей активности в кошельке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásady ochrany súkromia v Aperture sú krátke, pretože Aperture nezbiera žiadne údaje: žiadny účet, e-mail, analytika, telemetria ani serverové záznamy o vašej aktivite v peňaženke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravilnik o zasebnosti Aperture je kratek, ker Aperture ne zbira podatkov: brez računa, e-pošte, analitike, telemetrije in strežniških dnevnikov o dejavnosti vaše denarnice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика приватности Aperture-а је кратка јер Aperture не прикупља податке: без налога, имејла, аналитике, телеметрије и серверских записа активности вашег новчаника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture's integritetspolicy är kort eftersom Aperture inte samlar in några data: inget konto, ingen e-post, ingen analys, ingen telemetri, inga serverloggar över din plånboksaktivitet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sera ya faragha ya Aperture ni fupi kwa sababu Aperture haikusanyi data yoyote: hakuna akaunti, hakuna barua pepe, hakuna uchanganuzi, hakuna telemetria, hakuna kumbukumbu za upande wa seva za shughuli za pochi yako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture-இன் தனியுரிமை கொள்கை குறுகியது, ஏனெனில் Aperture எந்த தரவையும் சேகரிக்கவில்லை: கணக்கு இல்லை, மின்னஞ்சல் இல்லை, பகுப்பாய்வுகள் இல்லை, தொலைஅளவீடு இல்லை, உங்கள் வாலட் செயல்பாட்டின் சேவையக-பக்க பதிவுகள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture యొక్క గోప్యతా విధానం చిన్నది ఎందుకంటే Aperture ఎటువంటి డేటాను సేకరించదు: ఖాతా లేదు, ఇమెయిల్ లేదు, విశ్లేషణలు లేవు, టెలిమెట్రీ లేదు, మీ వాలెట్ కార్యకలాపాల సర్వర్-సైడ్ లాగ్‌లు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นโยบายความเป็นส่วนตัวของ Aperture สั้น เพราะ Aperture ไม่เก็บข้อมูลใด ๆ: ไม่มีบัญชี ไม่มีอีเมล ไม่มีการวิเคราะห์ ไม่มีเทเลเมตรี ไม่มีบันทึกฝั่งเซิร์ฟเวอร์ของกิจกรรมกระเป๋าสตางค์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture'ın gizlilik politikası kısadır çünkü Aperture hiçbir veri toplamaz: hesap yok, e-posta yok, analitik yok, telemetri yok, cüzdan etkinliğinize ait sunucu tarafı günlüğü yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Політика конфіденційності Aperture коротка, бо Aperture не збирає даних: ні облікового запису, ні електронної пошти, ні аналітики, ні телеметрії, ні серверних журналів вашої активності в гаманці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture کی پرائیویسی پالیسی مختصر ہے کیونکہ Aperture کوئی ڈیٹا اکٹھا نہیں کرتا: نہ کوئی اکاؤنٹ، نہ ای میل، نہ اینالٹکس، نہ ٹیلی میٹری، نہ آپ کی والٹ سرگرمی کا سرور-سائیڈ لاگ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính sách quyền riêng tư của Aperture rất ngắn vì Aperture không thu thập dữ liệu nào: không tài khoản, không email, không phân tích, không đo từ xa, không có nhật ký ở phía máy chủ về hoạt động ví của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 的隐私政策很短,因为 Aperture 不收集任何数据:不需要账户、不需要邮箱、没有分析、没有遥测、也没有任何记录你钱包活动的服务器日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperture 的隱私政策很短,因為 Aperture 不收集任何資料:不需要帳號、不需要電子郵件、沒有分析、沒有遙測,也沒有任何記錄你錢包活動的伺服器日誌。"
          }
        }
      }
    },
