    "Scanning every chain against curated public addresses.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skandeer elke chain teen 'n versorgde lys van openbare adresse."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏يتم فحص كل سلسلة مقابل عناوين عامة منتقاة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканиране на всяка верига спрямо подбрани публични адреси."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি চেইন বাছাই করা পাবলিক ঠিকানার বিপরীতে স্ক্যান করা হচ্ছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'escaneja cada cadena amb adreces públiques seleccionades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenujeme každý řetězec proti pečlivě vybraným veřejným adresám."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner hver kæde mod udvalgte offentlige adresser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Chain wird mit kuratierten öffentlichen Adressen abgeglichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σάρωση κάθε αλυσίδας έναντι επιμελημένων δημόσιων διευθύνσεων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning every chain against curated public addresses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizando cada cadena con direcciones públicas seleccionadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga ahela skannimine valitud avalike aadresside vastu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏در حال اسکن کردن هر شبکه در برابر آدرس‌های عمومی منتخب."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistetaan jokainen ketju valikoituihin julkisiin osoitteisiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sini-scan ang bawat chain laban sa mga curated na pampublikong address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse de chaque chaîne par rapport à des adresses publiques sélectionnées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏סורקים כל רשת מול כתובות ציבוריות נבחרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चेन को चुनिंदा सार्वजनिक पतों के विरुद्ध स्कैन किया जा रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretražuje se svaki lanac u odnosu na pomno odabrane javne adrese."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden lánc ellenőrzése válogatott nyilvános címekkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindai setiap chain terhadap alamat publik yang dipilih."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannar hverja keðju gegn völdum opinberum vistföngum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansione di ogni chain a confronto con indirizzi pubblici selezionati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳選した公開アドレスに対して各チェーンをスキャンしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선별된 공개 주소를 기준으로 모든 체인을 검사하고 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekviena grandinė skenuojama pagal atrinktus viešus adresus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katras ķēdes skenēšana pret atlasītām publiskām adresēm."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത പൊതു വിലാസങ്ങൾക്കെതിരെ ഓരോ chain-ഉം സ്കാൻ ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्युरेट केलेल्या सार्वजनिक पत्त्यांच्या तुलनेत प्रत्येक chain स्कॅन केली जात आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengimbas setiap chain berdasarkan alamat awam yang dipilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanner hver kjede mot utvalgte offentlige adresser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke chain wordt gescand tegen geselecteerde openbare adressen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੇ ਹੋਏ ਜਨਤਕ ਪਤਿਆਂ ਦੇ ਮੁਕਾਬਲੇ ਹਰੇਕ chain ਨੂੰ ਸਕੈਨ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie każdej sieci względem wyselekcjonowanych publicznych adresów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando cada rede em relação a endereços públicos selecionados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se scanează fiecare rețea cu adrese publice selectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяем каждую сеть по подобранным публичным адресам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenuje sa každý reťazec voči vybraným verejným adresám."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverja se vsaka veriga glede na izbrane javne naslove."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Скенира се сваки ланац у односу на пажљиво одабране јавне адресе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannar varje kedja mot kurerade offentliga adresser."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunachunguza kila chain dhidi ya anwani za umma zilizoteuliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுக்கப்பட்ட பொது முகவரிகளுக்கு எதிராக ஒவ்வொரு chain-ஐயும் ஸ்கேன் செய்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంపిక చేసిన పబ్లిక్ చిరునామాల ఆధారంగా ప్రతి chain ను స్కాన్ చేస్తోంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังสแกนทุก chain เทียบกับที่อยู่สาธารณะที่คัดสรร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm zincirler seçilmiş genel adreslere göre taranıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряємо кожну мережу за відібраними публічними адресами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "‏منتخب پبلک پتوں کے مقابلے میں ہر chain کو اسکین کیا جا رہا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang quét mọi chain dựa trên các địa chỉ công khai đã chọn lọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在对照精选的公开地址扫描每条链。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在對照精選的公開地址掃描每條鏈。"
          }
        }
      }
