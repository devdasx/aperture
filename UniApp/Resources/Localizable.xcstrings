        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فقدتها، تذهب الأموال."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако я загубите, средствата изчезват."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি হারালে, টাকাও চলে যায়।"
