    "This deletes \\(walletName) from this iPhone, including its encrypted seed and any cached balances and transactions.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwyder \\(walletName) van hierdie iPhone, insluitend die geënkripteerde saad en enige gekagde saldi en transaksies."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى حذف \\(walletName) من هذا الـ iPhone، بما في ذلك بذرتها المشفّرة وأي أرصدة ومعاملات مخزّنة مؤقتًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това изтрива \\(walletName) от този iPhone, включително криптираното seed и кешираните салда и транзакции."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এই iPhone থেকে \\(walletName) মুছে ফেলে, এর এনক্রিপ্টেড সিড এবং ক্যাশ করা যেকোনো ব্যালেন্স ও লেনদেন সহ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això elimina \\(walletName) d’aquest iPhone, incloent-hi la llavor xifrada i qualsevol saldo o transacció a la memòria cau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se ze tohoto iPhonu odstraní \\(walletName) včetně šifrovaného semínka a všech uložených zůstatků a transakcí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter \\(walletName) fra denne iPhone, herunder dens krypterede seed og eventuelle gemte saldi og transaktioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird \\(walletName) von diesem iPhone entfernt, einschließlich des verschlüsselten Seeds sowie aller zwischengespeicherten Salden und Transaktionen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αυτή την ενέργεια διαγράφεται το \\(walletName) από αυτό το iPhone, μαζί με τον κρυπτογραφημένο seed και τα αποθηκευμένα υπόλοιπα και τις συναλλαγές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes \\(walletName) from this iPhone, including its encrypted seed and any cached balances and transactions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina \\(walletName) de este iPhone, incluida su semilla cifrada y cualquier saldo o transacción guardados en caché."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kustutab \\(walletName) sellest iPhone'ist, sealhulgas selle krüpteeritud seemne ja vahemällu salvestatud saldod ja tehingud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار \\(walletName) را از این iPhone حذف می‌کند، شامل seed رمزگذاری‌شده و هر موجودی و تراکنش کش‌شده."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
