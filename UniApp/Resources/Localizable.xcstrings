        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒറ്റ ഫ്ലോയിൽ ചെയിനുകൾക്കിടയിൽ സ്വാപ്പ് ചെയ്യുക."
          }
