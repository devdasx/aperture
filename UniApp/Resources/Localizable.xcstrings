    "Connect a dApp via WalletConnect or the in-app browser to see active sessions here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتّصل بتطبيق dApp عبر WalletConnect أو المتصفّح المدمج لرؤية الجلسات النشطة هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "WalletConnect বা ইন-অ্যাপ ব্রাউজারের মাধ্যমে একটি dApp সংযোগ করুন; সক্রিয় সেশন এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecta una dApp amb WalletConnect o amb el navegador integrat per veure-hi les sessions actives."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte dApp přes WalletConnect nebo vestavěný prohlížeč a aktivní relace se zobrazí tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilslut en dApp via WalletConnect eller den indbyggede browser for at se aktive sessioner her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde eine dApp über WalletConnect oder den integrierten Browser, um hier aktive Sitzungen zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέστε ένα dApp μέσω WalletConnect ή του ενσωματωμένου περιηγητή για να δείτε εδώ ενεργές συνεδρίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a dApp via WalletConnect or the in-app browser to see active sessions here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una dApp con WalletConnect o el navegador integrado para ver aquí las sesiones activas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک dApp را از طریق وال‌کانکت یا مرورگر درون‌برنامه‌ای متصل کنید تا نشست‌های فعال را اینجا ببینید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä dApp WalletConnectin tai sovelluksen sisäisen selaimen kautta nähdäksesi aktiiviset istunnot tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez une dApp via WalletConnect ou le navigateur intégré pour voir les sessions actives ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להתחבר ל־dApp דרך WalletConnect או הדפדפן הפנימי כדי לראות כאן את הסשנים הפעילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WalletConnect या इन-ऐप ब्राउज़र से किसी dApp को कनेक्ट करें ताकि यहाँ सक्रिय सेशन दिखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite dApp putem WalletConnecta ili ugrađenog preglednika kako biste ovdje vidjeli aktivne sesije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakoztass egy dApp-ot WalletConnect-en vagy a beépített böngészőn keresztül, hogy itt lásd az aktív munkameneteket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan dApp melalui WalletConnect atau peramban dalam aplikasi untuk melihat sesi aktif di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetta una dApp tramite WalletConnect o il browser integrato per vedere qui le sessioni attive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WalletConnect またはアプリ内ブラウザから dApp に接続すると、アクティブなセッションがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WalletConnect 또는 앱 내 브라우저로 dApp을 연결하면 활성 세션이 여기에 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til en dApp via WalletConnect eller den innebygde nettleseren for å se aktive økter her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind een dApp via WalletConnect of de in-app browser om hier actieve sessies te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz dAppa przez WalletConnect lub przeglądarkę w aplikacji, aby zobaczyć tutaj aktywne sesje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte uma dApp via WalletConnect ou pelo navegador do app para ver as sessões ativas aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează un dApp prin WalletConnect sau prin browserul integrat pentru a vedea aici sesiunile active."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите dApp через WalletConnect или встроенный браузер, чтобы увидеть активные сессии здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte dApp cez WalletConnect alebo zabudovaný prehliadač a aktívne relácie sa tu zobrazia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite dApp prek WalletConnect ali vgrajenega brskalnika, da si tukaj ogledate aktivne seje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Повежите dApp преко WalletConnect-а или уграђеног прегледача да бисте овде видели активне сесије."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut en dApp via WalletConnect eller den inbyggda webbläsaren för att se aktiva sessioner här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ dApp ผ่าน WalletConnect หรือเบราว์เซอร์ในแอปเพื่อดูเซสชันที่ใช้งานอยู่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin oturumları burada görmek için WalletConnect veya uygulama içi tarayıcı aracılığıyla bir dApp bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть dApp через WalletConnect або вбудований браузер, щоб побачити тут активні сесії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối một dApp qua WalletConnect hoặc trình duyệt trong ứng dụng để xem các phiên đang hoạt động tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 WalletConnect 或内置浏览器连接一个 dApp,即可在此查看活动会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 WalletConnect 或內建瀏覽器連接 dApp,即可在此檢視作用中的工作階段。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں فعال سیشن دیکھنے کے لیے WalletConnect یا ان-ایپ براؤزر کے ذریعے کسی dApp سے منسلک ہوں۔"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържете dApp чрез WalletConnect или вградения браузър, за да видите активните сесии тук."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühenda dApp WalletConnecti või rakendusesisese brauseri kaudu, et näha siin aktiivseid seansse."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijunkite dApp per WalletConnect arba programėlės naršyklę, kad čia matytumėte aktyvius seansus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienojiet dApp, izmantojot WalletConnect vai lietotnes pārlūku, lai šeit redzētu aktīvās sesijas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengdu dApp með WalletConnect eða vafranum í forritinu til að sjá virkar lotur hér."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan dApp melalui WalletConnect atau pelayar dalam aplikasi untuk melihat sesi aktif di sini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumonekta sa isang dApp sa pamamagitan ng WalletConnect o ng in-app browser para makita ang mga aktibong session dito."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unganisha dApp kupitia WalletConnect au kivinjari cha ndani ya programu ili kuona vipindi vinavyoendelea hapa."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel 'n dApp via WalletConnect of die ingeboude blaaier om aktiewe sessies hier te sien."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலில் உள்ள அமர்வுகளை இங்கே காண WalletConnect அல்லது செயலி உலாவி வழியாக ஒரு dApp-ஐ இணைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడ క్రియాశీల సెషన్‌లను చూడటానికి WalletConnect లేదా యాప్‌లోని బ్రౌజర్ ద్వారా ఒక dApp‌ను కనెక్ట్ చేయండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സജീവ സെഷനുകൾ ഇവിടെ കാണാൻ WalletConnect അല്ലെങ്കിൽ ഇൻ-ആപ്പ് ബ്രൗസർ വഴി ഒരു dApp കണക്റ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "येथे सक्रिय सत्रे पाहण्यासाठी WalletConnect किंवा अॅप-अंतर्गत ब्राउझरद्वारे dApp कनेक्ट करा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਥੇ ਸਰਗਰਮ ਸੈਸ਼ਨ ਦੇਖਣ ਲਈ WalletConnect ਜਾਂ ਐਪ-ਅੰਦਰਲੇ ਬ੍ਰਾਊਜ਼ਰ ਰਾਹੀਂ ਇੱਕ dApp ਕਨੈਕਟ ਕਰੋ।"
          }
        }
      }
    },
