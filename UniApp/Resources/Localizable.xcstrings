            "state": "translated",
            "value": "Tego portfela już nie ma w lokalnym magazynie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carteira não está mais no armazenamento local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest portofel nu mai există în stocarea locală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого кошелька больше нет в локальном хранилище."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto peňaženka už nie je v lokálnom úložisku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te denarnice ni več v lokalni shrambi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Овај новчаник више није у локалној похрани."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna plånbok finns inte längre i den lokala lagringen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi hii haiko tena kwenye hifadhi ya ndani."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வாலட் இனி உள்ளூர் சேமிப்பகத்தில் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వాలెట్ ఇకపై స్థానిక స్టోర్‌లో లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าสตางค์นี้ไม่อยู่ในที่จัดเก็บภายในเครื่องอีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cüzdan artık yerel depolamada yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього гаманця більше немає в локальному сховищі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ والٹ مقامی اسٹور میں اب موجود نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví này không còn trong kho lưu trữ cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此钱包已不在本地存储中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此錢包已不在本機儲存中。"
          }
        }
      }
    },
    "This wallet was imported from a private key. There is no recovery phrase to show.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie beursie is vanaf 'n privaat sleutel ingevoer. Daar is geen herstelfrase om te wys nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استيراد هذه المحفظة من مفتاح خاص. لا توجد عبارة استرداد لعرضها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този портфейл е импортиран от частен ключ. Няма фраза за възстановяване, която да се покаже."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ওয়ালেটটি একটি প্রাইভেট কী থেকে ইমপোর্ট করা হয়েছিল। দেখানোর জন্য কোনো রিকভারি ফ্রেজ নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta cartera es va importar des d'una clau privada. No hi ha cap frase de recuperació per mostrar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato peněženka byla importována ze soukromého klíče. Není zde žádná obnovovací fráze k zobrazení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne wallet blev importeret fra en privat nøgle. Der er ingen gendannelsesfrase at vise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Wallet wurde aus einem privaten Schlüssel importiert. Es gibt keine Wiederherstellungsphrase, die angezeigt werden kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το πορτοφόλι εισήχθη από ιδιωτικό κλειδί. Δεν υπάρχει φράση ανάκτησης για εμφάνιση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta billetera se importó desde una clave privada. No hay frase de recuperación que mostrar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See rahakott imporditi privaatvõtmest. Pole taastefraasi, mida kuvada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کیف پول از یک کلید خصوصی وارد شده است. عبارت بازیابی‌ای برای نمایش وجود ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lompakko tuotiin yksityisestä avaimesta. Näytettävää palautuslausetta ei ole."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang wallet na ito ay na-import mula sa private key. Walang recovery phrase na maipapakita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce portefeuille a été importé depuis une clé privée. Il n'y a pas de phrase de récupération à afficher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק הזה יובא ממפתח פרטי. אין ביטוי שחזור להצגה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वॉलेट निजी कुंजी से इम्पोर्ट किया गया था। दिखाने के लिए कोई रिकवरी फ़्रेज़ नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj novčanik uvezen je iz privatnog ključa. Nema fraze za oporavak za prikaz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a tárcát privát kulcsból importálták. Nincs megjeleníthető helyreállítási kifejezés."
