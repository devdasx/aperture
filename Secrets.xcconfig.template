// Secrets.xcconfig.template — committed documentation of the API keys
// Aperture needs. The REAL values live in `Secrets.xcconfig` (gitignored,
// local only). To set up: copy this file to `Secrets.xcconfig` and fill in
// the values. NEVER commit `Secrets.xcconfig`.
//
// project.yml wires `Secrets.xcconfig` as the target's configFile and
// injects these into the app's Info.plist; `Secrets.swift` reads them at
// runtime via `Bundle.main.object(forInfoDictionaryKey:)`.

// Li.Fi — swap + cross-chain bridge aggregator (EVM + Solana). REQUIRED for Swap.
// https://docs.li.fi/  (API base: https://li.quest/v1)
LIFI_API_KEY =

// ANKR Advanced RPC — higher-reliability multi-chain RPC. Optional.
// https://www.ankr.com/rpc/
ANKR_API_TOKEN =

// 0x swap API — optional alternate EVM swap aggregator.
// https://0x.org/docs
ZEROX_API_KEY =

// 1inch swap API — optional alternate EVM swap aggregator.
// https://portal.1inch.dev/
ONEINCH_API_KEY =

// 1rpc.io — authenticated multi-chain RPC. Optional but recommended: the
// public tier rate-limits ("usage limit reached") under swap/refresh load;
// a key raises the limits. Keyed path: https://1rpc.io/<KEY>/<chain>
// https://www.1rpc.io/#pricing
ONERPC_API_KEY =
