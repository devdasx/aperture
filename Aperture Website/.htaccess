DirectoryIndex index.html
Options -Indexes
RewriteEngine On

# Canonical domain and protocol.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.aperturex\.io$ [NC]
RewriteRule ^ https://aperturex.io%{REQUEST_URI} [R=301,L]

# Keep public URLs clean and redirect the old generated filenames.
RewriteCond %{THE_REQUEST} \s/+Aperture%20Landing\.dc\.html[\s?] [NC]
RewriteRule ^Aperture\ Landing\.dc\.html$ / [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+Aperture%20Security\.dc\.html[\s?] [NC]
RewriteRule ^Aperture\ Security\.dc\.html$ /security [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+Aperture%20Open%20Source\.dc\.html[\s?] [NC]
RewriteRule ^Aperture\ Open\ Source\.dc\.html$ /open-source [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+Aperture%20FAQ\.dc\.html[\s?] [NC]
RewriteRule ^Aperture\ FAQ\.dc\.html$ /faq [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+Aperture%20Contact\.dc\.html[\s?] [NC]
RewriteRule ^Aperture\ Contact\.dc\.html$ /contact [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+Aperture%20Privacy\.dc\.html[\s?] [NC]
RewriteRule ^Aperture\ Privacy\.dc\.html$ /privacy [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+Aperture%20Terms\.dc\.html[\s?] [NC]
RewriteRule ^Aperture\ Terms\.dc\.html$ /terms [R=301,L,NE]

# Canonical clean URLs have no trailing slash, except the homepage.
RewriteRule ^(security|open-source|faq|contact|privacy|privacy-choices|terms)/$ /$1 [R=301,L]

# Serve clean routes from the generated static files.
RewriteRule ^security$ Aperture\ Security.dc.html [L]
RewriteRule ^open-source$ Aperture\ Open\ Source.dc.html [L]
RewriteRule ^faq$ Aperture\ FAQ.dc.html [L]
RewriteRule ^contact$ Aperture\ Contact.dc.html [L]
RewriteRule ^privacy$ Aperture\ Privacy.dc.html [L]
RewriteRule ^privacy-choices$ Aperture\ Privacy\ Choices.dc.html [L]
RewriteRule ^terms$ Aperture\ Terms.dc.html [L]

AddType application/manifest+json .webmanifest
AddType application/xml .xml
AddType text/plain .txt
AddType font/woff2 .woff2

ErrorDocument 404 /404.html
